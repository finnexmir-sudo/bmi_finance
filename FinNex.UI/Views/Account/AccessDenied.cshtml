@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "İcazə yoxdur";
}

<div class="auth-card text-center">

    <div style="font-size:64px;color:#dc3545;">
        <i class="bi bi-shield-lock"></i>
    </div>

    <h3 class="mt-3">İcazə yoxdur</h3>

    <p class="text-muted mt-2">
        Bu səhifəyə giriş üçün səlahiyyətiniz yoxdur.
    </p>

    <div class="alert alert-warning mt-3">
        Əgər bu səhifəyə girişiniz olmalı olduğunu düşünürsünüzsə,
        administratorla əlaqə saxlayın.
    </div>

    <div class="d-grid gap-2 mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            Ana səhifəyə qayıt
        </a>

        <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
            Çıxış et
        </a>
    </div>
</div>
