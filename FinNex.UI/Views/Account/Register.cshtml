@using FinNex.Application.DTOs.Auth
@model ChangePasswordDto
@{
    ViewData["Title"] = "Sifreni Deyis";
}

@{
    Layout = "_AuthLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/change-password.css" asp-append-version="true" />
}

<div class="cp-page">
    <div class="cp-card">

        <div class="cp-logo">
            <img src="~/images/Logobank.jpg" alt="BMI Finance" />
        </div>
        <div class="cp-brand">BMI Finance</div>
        <div class="cp-heading">Sifreni deyis</div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="cp-alert cp-alert--ok">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="cp-alert cp-alert--err">
                <i class="bi bi-exclamation-circle-fill"></i>
                @TempData["ErrorMessage"]
            </div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="cp-alert cp-alert--err">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ChangePassword" asp-controller="Account"
              method="post" id="cpForm" autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="cp-group">
                <div class="cp-field">
                    <span class="cp-icon"><i class="bi bi-lock"></i></span>
                    <input asp-for="CurrentPassword" type="password"
                           class="cp-input" placeholder="Cari sifre"
                           id="inp-current" autocomplete="current-password" />
                    <button type="button" class="cp-eye" data-target="inp-current">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="cp-sep"></div>

            <div class="cp-group">
                <div class="cp-field">
                    <span class="cp-icon"><i class="bi bi-key"></i></span>
                    <input asp-for="NewPassword" type="password"
                           class="cp-input" placeholder="Yeni sifre"
                           id="inp-new" autocomplete="new-password" />
                    <button type="button" class="cp-eye" data-target="inp-new">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <div class="cp-strength-wrap">
                    <div class="cp-strength-track">
                        <div class="cp-strength-fill" id="strengthFill"></div>
                    </div>
                    <span class="cp-strength-lbl" id="strengthLabel"></span>
                </div>
                <ul class="cp-rules">
                    <li class="cp-rule" id="rule-length"><span>&#9675;</span> Min. 8 simvol</li>
                    <li class="cp-rule" id="rule-upper"><span>&#9675;</span> Boyuk herf</li>
                    <li class="cp-rule" id="rule-number"><span>&#9675;</span> Reqem</li>
                    <li class="cp-rule" id="rule-special"><span>&#9675;</span> Xususi simvol</li>
                </ul>
            </div>

            <div class="cp-group">
                <div class="cp-field">
                    <span class="cp-icon"><i class="bi bi-key-fill"></i></span>
                    <input asp-for="ConfirmNewPassword" type="password"
                           class="cp-input" placeholder="Yeni sifreni tesdiqle"
                           id="inp-confirm" autocomplete="new-password" />
                    <button type="button" class="cp-eye" data-target="inp-confirm">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <p class="cp-match" id="matchMsg"></p>
            </div>

            <button type="submit" class="cp-btn" id="cpBtn">
                <span id="cpBtnText">Sifreni yenile</span>
                <span id="cpBtnSpinner" class="spinner-border spinner-border-sm d-none"></span>
            </button>
        </form>

        <div class="cp-footer">
            <span>Girise qayit.</span>
            <a asp-controller="Account" asp-action="Login">Giris sehifesi</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/change-password.js" asp-append-version="true"></script>
}
