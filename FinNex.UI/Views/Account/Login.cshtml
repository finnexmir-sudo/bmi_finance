@model FinNex.UI.DTO.LoginDto
@inject Microsoft.Extensions.Configuration.IConfiguration _cfg

@{
    Layout = "_AuthLayout";

    // Müştərinin adı/loqosu appsettings → Brend blokundan (başlıq zolağı ilə
    // eyni mənbə). FinNex isə aşağıda SABİTDİR — məhsulun adıdır.
    var brendQisa = _cfg["Brend:SirketQisa"] ?? "BMI";
    var brendAd = _cfg["Brend:SirketAdi"] ?? "Finance";
    var brendLogo = _cfg["Brend:Logo"] ?? "/images/Logobank.jpg";
}

<div class="auth-card">

    <div class="auth-logo">
        <img src="@Url.Content(brendLogo)" alt="@brendQisa @brendAd" />
    </div>

    <div class="auth-title">@brendQisa @brendAd</div>
    <div class="auth-subtitle">Təhlükəsiz giriş</div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Login" method="post" id="loginForm" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="mb-3 input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input asp-for="UserName" class="form-control" placeholder="İstifadəçi adı" autocomplete="username-new" />
        </div>

        <div class="mb-3 input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input asp-for="Password" value="" type="password" class="form-control" placeholder="Şifrə" autocomplete="new-password" />
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-auth" id="loginBtn">
            <span id="btnText">Giriş et</span>
            <span id="btnSpinner" class="spinner-border spinner-border-sm d-none"></span>
        </button>
    </form>
    <div class="auth-footer">
        <span>Şifrəni dəyiş.</span>
        <a asp-controller="Account" asp-action="ChangePassword">
            Şifrəni dəyiş
        </a>
    </div>

    @* Məhsul imzası — SABİTDİR, konfiqurasiyadan oxunmur. *@
    <div class="auth-brand">
        <img src="~/images/finnex-mark.png" alt="FinNex" />
        <span class="auth-brand-text">powered by <b>FinNex</b></span>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("loginForm").addEventListener("submit", function () {
            document.getElementById("loginBtn").disabled = true;
            document.getElementById("btnText").classList.add("d-none");
            document.getElementById("btnSpinner").classList.remove("d-none");
        });
    </script>
}
