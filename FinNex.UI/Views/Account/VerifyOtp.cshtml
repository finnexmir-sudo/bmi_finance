@model string
@{
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <div class="auth-title">OTP Təsdiqi</div>
    <div class="auth-subtitle">6 rəqəmli kodu daxil edin</div>

    <form asp-action="VerifyOtp" method="post">
        @Html.AntiForgeryToken()

        <input name="otp"
               class="form-control text-center fs-4 mb-3"
               maxlength="6"
               placeholder="------" />

        <button class="btn btn-success w-100 btn-auth">
            Təsdiqlə
        </button>
    </form>

</div>
