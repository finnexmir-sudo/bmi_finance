    @model FinNex.UI.ViewModels.PR_Odenis_Tapsirigi.OdenisTapsirigiCreateVM

    <div class="payment-page">

        <!-- PAGE HEADER -->
        <div class="payment-header">
            <div class="payment-title">
                <h2>"A" formatli odenis tapshirigi</h2>
                <span>A-format · Daxili bank kocurmesi</span>
            </div>

            <div class="payment-meta">
                <a asp-action="Index" class="meta-chip meta-chip-link">
                    <i class="bi bi-arrow-left me-1"></i> Geri
                </a>
                <span class="meta-chip">Tehlukesiz emeliyyat</span>
                <span class="meta-chip">Bank sistemi</span>
            </div>
        </div>

        <form method="post" class="payment-form">

            <!-- Hidden bank ID-leri -->
            <input type="hidden" asp-for="Odenis.OduyenBankId" id="OduyenBankIdHidden" />
            <input type="hidden" asp-for="Odenis.AlanBankId" id="AlanBankIdHidden" />

            <!-- BANKLAR -->
            <section class="payment-section">
                <header class="section-header">
                    <i class="bi bi-bank"></i>
                    <span>Bank melumatları</span>
                </header>

                <div class="section-body two-column">

                    <!-- A1 - ODUYUN BANK -->
                <div class="form-group-box">
                    <div class="group-title">
                        <span>Oduyun bank</span>
                        <small>A1</small>
                    </div>

                    <div class="d-flex gap-2 align-items-center">
                        <select class="form-control flex-grow-1"
                                asp-for="Odenis.OduyenHesabId">
                        </select>

                        <!-- bosh yer -->
                        <div class="btn-placeholder"></div>
                    </div>

                    <div class="grid-2">
                        <input class="form-control" id="OduyenBankKod" placeholder="Kod" readonly>
                        <input class="form-control" id="OduyenBankVoen" placeholder="VOEN" readonly>
                    </div>

                    <input class="form-control" id="OduyenBankMuxbirHesab" placeholder="Muxbir hesab" readonly>
                    <input class="form-control" id="OduyenBankSwift" placeholder="SWIFT" readonly>
                </div>


                    <!-- B1 - ALAN BANK -->
                <div class="form-group-box">
                    <div class="group-title">
                        <span>Alan bank (Benefisiar)</span>
                        <small>B1</small>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <input type="text"
                               class="form-control voen-input"
                               id="AlanBankVoen"
                               placeholder="VOEN">

                        <button type="button"
                                class="btn btn-outline-primary btn-bank">
                            + Bank
                        </button>
                    </div>


                    <input class="form-control" id="AlanBankAd" placeholder="Bankın adı" readonly>
                    <input class="form-control" id="AlanBankKod" placeholder="Kod" readonly>
                    <input class="form-control" id="AlanBankMuxbirHesab" placeholder="Muxbir hesab" readonly>
                    <input class="form-control" id="AlanBankSwift" placeholder="SWIFT" readonly>
                </div>


                    <div class="modal fade" id="newBankModal" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">

                                <div class="modal-header">
                                    <h5 class="modal-title">Yeni bank elave et</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body">

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <input class="form-control" id="NewBankName" placeholder="Bankın adı">
                                        </div>

                                        <div class="col-md-3">
                                            <input class="form-control" id="NewBankCode" placeholder="Kod">
                                        </div>

                                        <div class="col-md-3">
                                            <input class="form-control" id="NewBankVoen" placeholder="VOEN">
                                        </div>

                                        <div class="col-md-6">
                                            <input class="form-control" id="NewBankSwift" placeholder="SWIFT">
                                        </div>

                                        <div class="col-md-6">
                                            <input class="form-control" id="NewBankCorr" placeholder="Muxbir hesab">
                                        </div>

                                        <div class="col-12">
                                            <input class="form-control" id="NewBankAgent" placeholder="Vasitechi bank (istəyə gorə)">
                                        </div>
                                    </div>

                                </div>

                                <div class="modal-footer">
                                    <button class="btn btn-secondary" data-bs-dismiss="modal">Bagla</button>
                                    <button class="btn btn-primary" id="saveNewBank">
                                        Yadda saxla
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- MUSHTERILER -->
            <section class="payment-section">
                <header class="section-header">
                    <i class="bi bi-people"></i>
                    <span>Mushteriler</span>
                </header>

                <div class="section-body two-column">

                    <div class="form-group-box">
                        <div class="group-title">
                            <span>Oduyun mushteri</span>
                            <small>A2</small>
                        </div>

                        <select class="form-control" asp-for="Odenis.OduyenMusteriId"></select>
                        <input class="form-control" id="OduyenMusteriHesab" placeholder="Hesab №" readonly>
                        <input class="form-control" id="OduyenMusteriVoen" placeholder="VOEN" readonly>
                    </div>

                    <div class="form-group-box">
                        <div class="group-title">
                            <span>Alan mushteri</span>
                            <small>B2</small>
                        </div>

                        <!-- 1) Bazadan sechim -->
                        <label class="form-label">Bazadan sech</label>
                        <select class="form-control"
                                asp-for="Odenis.AlanMusteriId">
                            <option value="">— Bazadan sech (eger varsa) —</option>
                        </select>

                        <!-- 2) El ile daxil etme -->
                        <label class="form-label mt-2">El ile daxil et</label>
                        <input class="form-control"
                               name="ManualAlanMusteriAd"
                               placeholder="Alan mushterinin adı" />

                        <input class="form-control mt-2"
                               name="ManualAlanHesab"
                               placeholder="Hesab №" />

                        <input class="form-control mt-2"
                               name="ManualAlanVoen"
                               placeholder="VOEN" />

                        <div class="mt-2">
                            <button type="button"
                                class="btn btn-outline-primary btn-bank">
                                Bu mushterini bazaya elave et
                            </button>
                        </div>
                    </div>


                </div>
            </section>

            <!-- MEBLEG -->
            <section class="payment-section">
                <header class="section-header">
                    <i class="bi bi-currency-exchange"></i>
                    <span>Mebleg</span>
                </header>

                <div class="section-body amount-row">

                    <div>
                        <label>C1. Valyuta novu</label>
                        <select class="form-control" asp-for="Odenis.Valyuta">
                            <option>AZN</option>
                            <option>USD</option>
                            <option>EUR</option>
                        </select>
                    </div>

                    <div>
                        <label>C2. Mebleg (reqemle)</label>
                        <input class="form-control amount-input"
                               asp-for="Odenis.Mebleg"
                               value="0.00">
                    </div>

                    <div>
                        <label>C2. Mebleg (yazı ile)</label>
                        <input class="form-control"
                               asp-for="Odenis.MeblegYazi"
                               placeholder="Otuz dord manat 31 qep.">
                    </div>

                </div>
            </section>

            <!-- TEYINAT -->
            <section class="payment-section">
                <header class="section-header">
                    <i class="bi bi-chat-left-text"></i>
                    <span>Odenish teyinatı</span>
                </header>

                <div class="section-body">
                    <label>D1. Odenishin teyinatı ve esası</label>
                    <textarea class="form-control"
                              rows="3"
                              asp-for="Odenis.Teyinat"
                              placeholder="Odenishin teyinatı"></textarea>

                    <label class="mt-2">D2. Odenishle elaqedar elave informasiya</label>
                    <input class="form-control"
                           asp-for="Odenis.ElaveInformasiya"
                           placeholder="Elave informasiya">

                    <div class="grid-2 mt-2">
                        <div>
                            <label>D3. Budce tesnifatının kodu</label>
                            <input class="form-control"
                                   asp-for="Odenis.BudceTesnifatininKodu"
                                   placeholder="111254">
                        </div>
                        <div>
                            <label>D4. Budce seviyyesinin kodu</label>
                            <input class="form-control"
                                   asp-for="Odenis.BudceSeviyyesininKodu"
                                   placeholder="1">
                        </div>
                    </div>
                </div>
            </section>

            <!-- ACTIONS -->
            <div class="form-actions">
                <button type="button" class="btn btn-primary" id="btnGenerateWord">
                    <i class="bi bi-file-earmark-word"></i>
                    Yadda saxla
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Legv et
                </a>
            </div>

        </form>
    </div>
@section Styles {
    <link rel="stylesheet" href="~/css/PR_Odenis_Tapsirigi/payment-create.css" />
}

@section Scripts {
    <script src="~/js/PR_Odenis_Tapsirigi/payment-bank.js"></script>
    <script src="~/js/PR_Odenis_Tapsirigi/payment-word.js"></script>
}
