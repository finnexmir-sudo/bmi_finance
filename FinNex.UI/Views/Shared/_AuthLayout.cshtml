@{
    // Giriş səhifəsi ViewData["Title"] təyin etmir → sadəcə «— FinNex»
    // yazılırdı, öndə asılı tire ilə. Ayırıcı yalnız başlıq VARSA qoyulur.
    var sehifeBasligi = ViewData["Title"] as string;
    var tabBasligi = string.IsNullOrWhiteSpace(sehifeBasligi)
        ? "FinNex"
        : $"{sehifeBasligi} — FinNex";
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    @* Brauzer tabı MƏHSULUN adını daşıyır — _UserLayout ilə eyni qayda
       («Dashboard — FinNex»). Əvvəl burada «- BMI Finance» yazılırdı və
       giriş səhifəsi digər səhifələrdən fərqli görünürdü.
       QEYD: aşağıdakı `application-name` / `apple-mobile-web-app-title`
       (PWA adı) və favicon QƏSDƏN toxunulmadı — onlar telefon ekranında
       görünür, istifadəçi təsdiqi gözləyir. *@
    <title>@tabBasligi</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2332" />
    <meta name="application-name" content="BMI Finance" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="BMI Finance" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>

<body class="auth-body">

    <main class="auth-wrapper">
        @RenderBody()
    </main>
    @RenderSection("Scripts", required: false)

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function () { });
            });
        }
    </script>
</body>
</html>
