@model FinNex.Application.DTOs.Yardim.YardimPanelDto
@{
    ViewData["Title"] = Model.Basliq;
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}
<div class="container-fluid" style="max-width:860px">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.Modul))
            {
                <div class="text-uppercase fw-bold text-muted small">@Model.Modul</div>
            }
            <h3 class="fw-bold mb-0">@Model.Basliq</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Xulase))
            {
                <small class="text-muted">@Model.Xulase</small>
            }
        </div>
        <div class="d-flex gap-2">
            @if (isAdmin)
            {
                <a href="/Admin/Yardim/Redakte/@Model.Id" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i>Redaktə
                </a>
            }
            <a href="/Yardim" class="btn btn-outline-secondary btn-sm">Bütün təlimatlar</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4" style="line-height:1.7">
            @if (Model.Hazirlanir)
            {
                <div class="alert alert-warning mb-0">
                    Bu bölmə hazırlanır — təlimat tezliklə əlavə olunacaq.
                </div>
            }
            else
            {
                @* Mətni YALNIZ Admin yazır (redaktor Admin roluna bağlıdır),
                   ona görə HTML olduğu kimi göstərilir. Redaktor başqa rola
                   açılarsa BURADA təmizləmə (sanitize) lazım olacaq. *@
                @Html.Raw(Model.Metn)
            }
            @if (Model.Yenilenme.HasValue)
            {
                <div class="border-top mt-4 pt-2 small text-muted">
                    Yenilənib: @Model.Yenilenme.Value.ToString("dd.MM.yyyy")
                </div>
            }
        </div>
    </div>
</div>
