@model IReadOnlyList<FinNex.Application.DTOs.Yardim.YardimListDto>
@{
    ViewData["Title"] = "Təlimatlar";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
    var qruplar = Model.GroupBy(x => string.IsNullOrWhiteSpace(x.Modul) ? "Digər" : x.Modul!)
                       .OrderBy(g => g.Key);
}
@* Kök _Layout yalnız Bootstrap + site.css yükləyir — `fn-*` class-ları
   modul CSS fayllarındadır və BURADA YOXDUR. Ona görə Bootstrap işlədilir. *@
<div class="container-fluid" style="max-width:960px">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-question-circle me-2 text-primary"></i>Təlimatlar
            </h3>
            <small class="text-muted">Səhifələrin necə işlədiyi — modul üzrə</small>
        </div>
        @if (isAdmin)
        {
            <a href="/Admin/Yardim" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-pencil me-1"></i>Redaktə
            </a>
        }
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col">
                    <input type="text" name="q" value="@ViewBag.Axtaris" class="form-control"
                           placeholder="Başlıq, modul və ya açıqlama üzrə axtar…" />
                </div>
                <div class="col-auto"><button type="submit" class="btn btn-primary">Axtar</button></div>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Axtaris as string))
                {
                    <div class="col-auto"><a href="/Yardim" class="btn btn-outline-secondary">Sıfırla</a></div>
                }
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center text-muted py-5">Təlimat tapılmadı.</div>
        </div>
    }
    else
    {
        foreach (var q in qruplar)
        {
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body">
                    <div class="text-uppercase fw-bold text-muted small mb-2">@q.Key</div>
                    <div class="list-group list-group-flush">
                        @foreach (var s in q.OrderBy(x => x.Basliq))
                        {
                            <a href="/Yardim/Sehife/@s.Slug" class="list-group-item list-group-item-action px-0">
                                <span class="fw-semibold">@s.Basliq</span>
                                @if (s.Hazirlanir)
                                {
                                    <span class="badge text-bg-warning ms-2">hazırlanır</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(s.Xulase))
                                {
                                    <div class="small text-muted">@s.Xulase</div>
                                }
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
