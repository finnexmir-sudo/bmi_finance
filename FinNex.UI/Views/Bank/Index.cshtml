@model IEnumerable<FinNex.Domain.Entities.PR_Odenis_Tapsirigi.Bank>

<div class="bank-page">

    <!-- HEADER -->
    <div class="bank-header">
        <div class="bank-header-content">
            <div class="bank-header-icon">
                <i class="bi bi-bank"></i>
            </div>
            <div>
                <h3>Banklar</h3>
                <p>Sistemde olan butun banklarin siyahisi</p>
            </div>
        </div>
    </div>

    <!-- ACTIONS BAR -->
    <div class="bank-actions-bar">
        <a asp-action="Yarat" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Bank
        </a>
        <a asp-controller="OdenisTapsirigi" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Odenis Tapsirigi
        </a>
    </div>

    <!-- TABLE -->
    <div class="bank-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Bankin Adi</th>
                        <th>SWIFT / Kod</th>
                        <th>VOEN</th>
                        <th>Status</th>
                        <th class="text-center">Emeliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var bank in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@bank.Ad</td>
                                <td><span class="badge bg-light text-dark border">@bank.Kod</span></td>
                                <td>@bank.Voen</td>
                                <td><span class="badge bg-success">Aktiv</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary action-btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger action-btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-bank fs-1 d-block mb-2 opacity-50"></i>
                                Hele bank elave olunmayib
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/bank-index.css" asp-append-version="true" />
}
