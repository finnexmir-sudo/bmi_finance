@model FinNex.Application.DTOs.Kredit.KreditFaizDerecesiCreateDto
@{
    ViewData["Title"] = "Yeni kredit faiz dərəcəsi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var valyutalar = ViewBag.Valyutalar as IList<FinNex.Application.DTOs.Kurval.BmiValyutaDto>
                     ?? new List<FinNex.Application.DTOs.Kurval.BmiValyutaDto>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/guzest.css" asp-append-version="true" />
}

<div class="gz-form-page">
    <div class="gz-form-head">
        <a asp-action="Index" class="gz-back"><i class="bi bi-arrow-left"></i> Geri</a>
        <div class="gz-title">Yeni bazar faiz dərəcəsi</div>
    </div>

    <div class="gz-form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="gz-form-group">
                <label asp-for="Tarix" class="gz-label">Qüvvəyə minmə tarixi <span class="gz-req">*</span></label>
                <input asp-for="Tarix" type="date" class="gz-input" />
                <span class="gz-hint">
                    Bu tarixdən etibarən (bu gün daxil) tətbiq olunur. Bundan əvvəlki
                    dövrlər köhnə dərəcə ilə hesablanmağa davam edir.
                </span>
                <span asp-validation-for="Tarix" class="gz-err"></span>
            </div>

            <div class="gz-form-group">
                <label asp-for="ValyutaKodu" class="gz-label">Valyuta <span class="gz-req">*</span></label>
                <select asp-for="ValyutaKodu" class="gz-input">
                    <option value="00">00 — AZN (manat)</option>
                    @foreach (var v in valyutalar.Where(v => v.Kod != "00"))
                    {
                        <option value="@v.Kod">@v.Goster</option>
                    }
                </select>
                <span class="gz-hint">
                    AZN və valyuta üçün dərəcələr ayrıdır. Bu gün valyutalı işçi krediti
                    yoxdur — valyuta sətri yalnız belə kredit yaranarsa lazım olacaq.
                </span>
            </div>

            <div class="gz-form-group">
                <label asp-for="Derece" class="gz-label">Dərəcə (%) <span class="gz-req">*</span></label>
                <input asp-for="Derece" type="number" step="0.0001" min="0.0001" class="gz-input"
                       placeholder="9.25" />
                <span class="gz-hint">
                    İllik faiz. Mühasibin cədvəlində «Banklararası kredit dərəcəsi»
                    adlanır (cari dəyər: 9,25).
                </span>
                <span asp-validation-for="Derece" class="gz-err"></span>
            </div>

            <div class="gz-form-group">
                <label asp-for="Qeyd" class="gz-label">Qeyd <span class="gz-hint">(istəyə bağlı)</span></label>
                <input asp-for="Qeyd" class="gz-input" placeholder="Məs: MB qərarı 25.07.2026" />
                <span asp-validation-for="Qeyd" class="gz-err"></span>
            </div>

            <div class="gz-form-actions">
                <a asp-action="Index" class="gz-btn gz-btn--outline">Ləğv et</a>
                <button type="submit" class="gz-btn gz-btn--primary">
                    <i class="bi bi-check2"></i> Yadda saxla
                </button>
            </div>
        </form>
    </div>
</div>
