@model IList<FinNex.Domain.Entities.HR.Isci>
@using FinNex.Application.Services.HR
@{
    ViewData["Title"] = "İşçi Stajı";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var axtaris = ViewBag.Axtaris as string;
    var bugun = DateTime.Today;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
    <style>
        .tr-group-head {
            background: #eef2ff !important;
            color: #3730a3 !important;
            border-left: 2px solid #c7d2fe !important;
            border-right: 2px solid #c7d2fe !important;
            text-align: center !important;
        }
        .tr-sub-head {
            background: #f5f3ff !important;
            color: #4338ca !important;
            font-size: 10px !important;
            text-align: center !important;
            padding: 5px 8px !important;
            border-bottom: 2px solid #c7d2fe !important;
        }
        .tr-val {
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            color: #3730a3;
        }
        .tr-val.empty { color: #cbd5e1; font-weight: 400; font-size: 12px; }
        .tr-val-l { border-left: 2px solid #e0e7ff !important; }
        .tr-val-r { border-right: 2px solid #e0e7ff !important; }

        .tr-open-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            background: #fff;
            border: 1px solid #c7d2fe;
            border-radius: 6px;
            color: #4338ca;
            font-size: 11.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s;
            white-space: nowrap;
            margin-left: 6px;
        }
        .tr-open-btn:hover { background: #eef2ff; border-color: #818cf8; }
        .tr-open-btn.has-data { background: #eef2ff; border-color: #818cf8; }

        /* ── Modal ── */
        .tr-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,.55);
            z-index: 9000;
            align-items: center;
            justify-content: center;
        }
        .tr-overlay.active { display: flex; }

        .tr-modal {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            width: 600px;
            max-width: 96vw;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(15,23,42,.2);
            overflow: hidden;
        }
        .tr-modal-head {
            padding: 20px 24px 16px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            background: #f8f9fb;
        }
        .tr-modal-title { font-size: 15px; font-weight: 700; color: #1a2332; }
        .tr-modal-sub   { font-size: 12px; color: #64748b; margin-top: 3px; }
        .tr-modal-close {
            background: none;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            color: #94a3b8;
            font-size: 16px;
            cursor: pointer;
            padding: 2px 8px;
            line-height: 1.4;
            flex-shrink: 0;
        }
        .tr-modal-close:hover { background: #fee2e2; border-color: #fca5a5; color: #dc2626; }

        .tr-modal-body { padding: 20px 24px; overflow-y: auto; flex: 1; }

        .tr-periods { display: flex; flex-direction: column; gap: 8px; }

        .tr-period-row {
            display: grid;
            grid-template-columns: 1fr 20px 1fr 1fr 28px;
            align-items: end;
            gap: 8px;
            background: #f8f9fb;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px 14px;
        }
        .tr-period-arrow { color: #94a3b8; font-size: 15px; text-align: center; padding-bottom: 6px; }
        .tr-period-result { font-size: 12px; font-weight: 600; color: #94a3b8; padding-bottom: 6px; white-space: nowrap; }
        .tr-period-result.filled { color: #4338ca; }
        .tr-period-del {
            background: none; border: 1px solid #e2e8f0; color: #94a3b8;
            border-radius: 6px; width: 28px; height: 28px; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; transition: all .15s;
        }
        .tr-period-del:hover { background: #fee2e2; border-color: #fca5a5; color: #dc2626; }

        .tr-field { display: flex; flex-direction: column; gap: 4px; }
        .tr-date-label { font-size: 10.5px; color: #64748b; font-weight: 500; }
        .tr-date-input {
            width: 100%; background: #fff; border: 1px solid #d1d5db; border-radius: 7px;
            color: #1a2332; font-size: 12.5px; padding: 6px 10px; outline: none;
            transition: border-color .15s; box-sizing: border-box;
        }
        .tr-date-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.08); }

        .tr-add-btn {
            display: flex; align-items: center; gap: 6px; background: none;
            border: 1px dashed #c7d2fe; border-radius: 8px; color: #6366f1;
            font-size: 12.5px; font-weight: 500; padding: 9px 14px;
            cursor: pointer; width: 100%; margin-top: 8px; transition: all .15s;
        }
        .tr-add-btn:hover { background: #eef2ff; border-color: #818cf8; color: #4338ca; }

        .tr-total {
            background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 10px;
            padding: 14px 20px; margin-top: 16px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .tr-total-label { font-size: 12px; color: #4338ca; font-weight: 600; }
        .tr-total-val { font-size: 18px; font-weight: 800; color: #3730a3; }
        .tr-total-val span { font-size: 12px; font-weight: 500; color: #6366f1; margin-left: 1px; }

        .tr-modal-foot {
            padding: 14px 24px; border-top: 1px solid #f1f5f9;
            display: flex; gap: 8px; justify-content: flex-end; background: #f8f9fb;
        }
        .tr-btn { padding: 9px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .15s; }
        .tr-btn--ghost { background: #fff; border: 1px solid #e2e8f0; color: #64748b; }
        .tr-btn--ghost:hover { background: #f1f5f9; color: #1a2332; }
        .tr-btn--apply { background: #4338ca; border: none; color: #fff; }
        .tr-btn--apply:hover { background: #3730a3; box-shadow: 0 4px 12px rgba(67,56,202,.3); }
    </style>
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İşçi Stajı</div>
            <div class="fn-page-sub">
                Ümumi iş stajı = <strong>bu bankda staj</strong> (işə gəlmə tarixindən bu günə)
                + <strong>əmək kitabçası</strong> (əvvəlki iş dövrləri).
                <strong>Ə/K</strong> düyməsi ilə əvvəlki dövrləri daxil edin və "Tətbiq et" deyin —
                avtomatik DB-də saxlanılır.
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="fn-alert fn-alert--success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div> }

    <form method="get" asp-action="Index" style="display:flex;gap:8px;margin-bottom:16px">
        <input type="text" name="axtaris" value="@axtaris" placeholder="İşçi adı, soyadı və ya FİN..."
               style="flex:1;max-width:420px;padding:9px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:13px" />
        <button type="submit" style="padding:9px 16px;background:#1a2332;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">
            <i class="bi bi-search"></i> Axtar
        </button>
        @if (!string.IsNullOrWhiteSpace(axtaris))
        {
            <a asp-action="Index" style="padding:9px 14px;font-size:13px;color:#64748b;text-decoration:none;display:flex;align-items:center">Təmizlə</a>
        }
    </form>

    <div style="padding:12px 14px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;margin-bottom:12px;font-size:12px;color:#1e40af">
        <strong>Staj faizi qaydası:</strong>
        <span>&lt; 8 il → 60%</span> ·
        <span>8 – 12 il → 80%</span> ·
        <span>≥ 12 il → 100%</span>
        &nbsp;&nbsp;·&nbsp;&nbsp;
        <strong style="color:#3730a3">Ə/K</strong> düyməsi ilə əvvəlki iş dövrlərini daxil edin —
        ümumi staj avtomatik (bank + kitabçə) hesablanıb saxlanılır.
    </div>

    <div class="fn-card" style="padding:0;overflow:hidden">
        <table class="km-table" style="table-layout:auto">
            <thead>
                <tr>
                    <th style="min-width:200px">İşçi</th>
                    <th>Departament</th>
                    <th style="width:130px">Bu bankda işə gəlmə</th>
                    <th style="width:160px">Ümumi staj</th>
                    <th colspan="4" class="tr-group-head" style="width:200px">Əmək Kitabçası</th>
                    <th style="width:80px">Faiz</th>
                </tr>
                <tr>
                    <th colspan="4" style="background:#f8f9fb;padding:0;border:none;height:0"></th>
                    <th class="tr-sub-head tr-val-l" style="width:45px">İL</th>
                    <th class="tr-sub-head" style="width:45px">AY</th>
                    <th class="tr-sub-head" style="width:45px">GÜN</th>
                    <th class="tr-sub-head tr-val-r" style="width:65px"></th>
                    <th style="background:#f8f9fb;padding:0;border:none;height:0"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    var staj = IsciStajHelper.Hesabla(i, bugun);
                    var teyinat = i.IsciTeyinatlari?.FirstOrDefault(t => t.BitmeTarixi == null);
                    var deptAd = teyinat?.Departament?.Ad ?? "—";
                    var hasKitabce = !string.IsNullOrWhiteSpace(i.EvvelkiStajPeriodlari);
                    <tr class="km-row" data-isci-id="@i.Id" data-tr-periods="@(i.EvvelkiStajPeriodlari ?? "")">
                        <td class="km-td-name">
                            <div style="font-weight:600">@i.Ad @i.Soyad</div>
                            <div style="font-size:10.5px;color:#94a3b8">FİN: @i.FIN</div>
                        </td>
                        <td><span style="font-size:12px;color:#475569">@deptAd</span></td>
                        <td style="font-size:12px">@i.IsheQebulTarixi.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="cari-staj" style="font-weight:700;color:#0f172a;font-size:13px">
                                @staj.Il il @staj.Ay ay @staj.Gun gün
                            </span>
                            <div style="font-size:10px;color:#94a3b8">
                                bank: <span class="staj-bank">@staj.BankIl il @staj.BankAy ay</span>
                                @if (hasKitabce)
                                {
                                    <span> + kitabçə: <span class="staj-evvelki">@staj.EvvelkiIl il @staj.EvvelkiAy ay</span></span>
                                }
                            </div>
                        </td>
                        <td class="tr-val tr-val-l @(hasKitabce ? "" : "empty") tr-il">@(hasKitabce ? staj.EvvelkiIl.ToString() : "—")</td>
                        <td class="tr-val @(hasKitabce ? "" : "empty") tr-ay">@(hasKitabce ? staj.EvvelkiAy.ToString() : "—")</td>
                        <td class="tr-val @(hasKitabce ? "" : "empty") tr-gun">@(hasKitabce ? staj.EvvelkiGun.ToString() : "—")</td>
                        <td class="tr-val tr-val-r" style="padding:8px 10px">
                            <button type="button" class="tr-open-btn @(hasKitabce ? "has-data" : "")" data-isci-id="@i.Id" data-isci-ad="@i.Ad @i.Soyad">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <rect x="1" y="1" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.3"/>
                                    <path d="M3 4h6M3 6h6M3 8h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                                </svg>
                                Ə/K
                            </button>
                        </td>
                        <td>
                            <span class="cari-faiz" style="display:inline-block;padding:3px 10px;border-radius:10px;font-size:12px;font-weight:700;
                                  background:@(staj.Faiz==100?"#dcfce7":staj.Faiz==80?"#fef3c7":"#fee2e2");
                                  color:@(staj.Faiz==100?"#166534":staj.Faiz==80?"#92400e":"#991b1b")">
                                @staj.Faiz%
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="tr-overlay" id="trOverlay">
    <div class="tr-modal">
        <div class="tr-modal-head">
            <div>
                <div class="tr-modal-title" id="trModalTitle">Əmək Kitabçası — Staj Hesablaması</div>
                <div class="tr-modal-sub">Hər dövr üçün başlanğıc və bitmə tarixini daxil edin</div>
            </div>
            <button class="tr-modal-close" id="trClose">✕</button>
        </div>
        <div class="tr-modal-body">
            <div class="tr-periods" id="trPeriods"></div>
            <button class="tr-add-btn" id="trAddBtn" type="button">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M6.5 2v9M2 6.5h9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Dövr əlavə et
            </button>
            <div class="tr-total">
                <div class="tr-total-label">Ümumi trudovoy staj</div>
                <div class="tr-total-val" id="trTotalVal"><span>—</span></div>
            </div>
        </div>
        <div class="tr-modal-foot">
            <button class="tr-btn tr-btn--ghost" id="trCancelBtn" type="button">İmtina</button>
            <button class="tr-btn tr-btn--apply" id="trApplyBtn" type="button">Tətbiq et</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function dateDiff(s, e) {
        if (!s || !e) return null;
        var sd = new Date(s), ed = new Date(e);
        if (isNaN(sd) || isNaN(ed) || ed <= sd) return null;
        var y = ed.getFullYear()-sd.getFullYear(), m = ed.getMonth()-sd.getMonth(), d = ed.getDate()-sd.getDate();
        if (d < 0) { m--; d += new Date(ed.getFullYear(), ed.getMonth(), 0).getDate(); }
        if (m < 0) { y--; m += 12; }
        return { y:y, m:m, d:d };
    }
    function sumAll(diffs) {
        var ty=0,tm=0,td=0;
        diffs.forEach(function(r){if(r){ty+=r.y;tm+=r.m;td+=r.d;}});
        tm+=Math.floor(td/30); td%=30; ty+=Math.floor(tm/12); tm%=12;
        return {y:ty,m:tm,d:td};
    }
    function fmt(r) {
        if(!r) return null;
        var p=[];
        if(r.y) p.push(r.y+' il');
        if(r.m) p.push(r.m+' ay');
        p.push(r.d+' gün');
        return p.join(' ');
    }
    function todayStr(){ return new Date().toISOString().slice(0,10); }

    var currentRow=null, periods=[];
    var overlay=document.getElementById('trOverlay');
    var periodsEl=document.getElementById('trPeriods');
    var totalValEl=document.getElementById('trTotalVal');

    function openModal(row, name) {
        currentRow=row;
        document.getElementById('trModalTitle').textContent=name+' — Əmək Kitabçası';
        periods=row.dataset.trPeriods?JSON.parse(row.dataset.trPeriods):[{s:'',e:''}];
        render(); recalc();
        overlay.classList.add('active');
        document.body.style.overflow='hidden';
    }
    function closeModal() {
        overlay.classList.remove('active');
        document.body.style.overflow='';
        currentRow=null;
    }

    function render() {
        periodsEl.innerHTML='';
        periods.forEach(function(p,idx){
            var diff=dateDiff(p.s,p.e);
            var div=document.createElement('div');
            div.className='tr-period-row';
            div.innerHTML=
                '<div class="tr-field"><div class="tr-date-label">Başlanğıc tarixi</div>'+
                '<input type="date" class="tr-date-input tr-s" data-idx="'+idx+'" value="'+(p.s||'')+'" max="'+todayStr()+'"></div>'+
                '<div class="tr-period-arrow">→</div>'+
                '<div class="tr-field"><div class="tr-date-label">Bitmə tarixi</div>'+
                '<input type="date" class="tr-date-input tr-e" data-idx="'+idx+'" value="'+(p.e||'')+'" max="'+todayStr()+'"></div>'+
                '<div class="tr-period-result'+(diff?' filled':'')+' tr-res" data-idx="'+idx+'">'+(diff?fmt(diff):'—')+'</div>'+
                '<button type="button" class="tr-period-del" data-idx="'+idx+'">'+
                '<svg width="11" height="11" viewBox="0 0 11 11" fill="none"><path d="M1.5 1.5l8 8M9.5 1.5l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>';
            div.querySelectorAll('.tr-s,.tr-e').forEach(function(inp){
                inp.addEventListener('input',function(){
                    var i=+inp.dataset.idx;
                    inp.classList.contains('tr-s')?periods[i].s=inp.value:periods[i].e=inp.value;
                    var d2=dateDiff(periods[i].s,periods[i].e);
                    var el=periodsEl.querySelector('.tr-res[data-idx="'+i+'"]');
                    if(el){el.textContent=d2?fmt(d2):'—';el.className='tr-period-result'+(d2?' filled':'')+' tr-res';el.dataset.idx=i;}
                    recalc();
                });
            });
            div.querySelector('.tr-period-del').addEventListener('click',function(){
                var i=+this.dataset.idx;
                if(periods.length===1){periods[0]={s:'',e:''};render();recalc();return;}
                periods.splice(i,1);render();recalc();
            });
            periodsEl.appendChild(div);
        });
    }

    function recalc() {
        var valid=periods.map(function(p){return dateDiff(p.s,p.e);}).filter(Boolean);
        if(!valid.length){totalValEl.innerHTML='<span>—</span>';return;}
        var t=sumAll(valid);
        totalValEl.innerHTML=(t.y?'<strong>'+t.y+'</strong><span> il</span> ':'')+
            (t.m?'<strong>'+t.m+'</strong><span> ay</span> ':'')+
            '<strong>'+t.d+'</strong><span> gün</span>';
    }

    function showToast(msg,ok){
        var t=document.createElement('div');
        t.style.cssText='position:fixed;top:20px;right:20px;padding:12px 18px;border-radius:8px;font-size:13px;font-weight:600;z-index:9999;box-shadow:0 4px 16px rgba(0,0,0,.15);'+(ok?'background:#16a34a;color:#fff':'background:#dc2626;color:#fff');
        t.textContent=msg; document.body.appendChild(t); setTimeout(function(){t.remove();},3000);
    }

    document.getElementById('trApplyBtn').addEventListener('click',function(){
        if(!currentRow) return;
        var btn=this;
        var valid=periods.filter(function(p){return dateDiff(p.s,p.e);});
        var payload=valid.length?JSON.stringify(valid):'';

        var fd=new FormData();
        fd.append('isciId',currentRow.dataset.isciId);
        if(payload) fd.append('periodlar',payload);
        var csrf=document.querySelector('input[name="__RequestVerificationToken"]');
        if(csrf) fd.append('__RequestVerificationToken',csrf.value);

        btn.disabled=true;
        fetch('/HR/IsciStaji/Update',{method:'POST',body:fd})
            .then(function(r){return r.json();})
            .then(function(d){
                if(!d.success){showToast(d.message||'Xəta',false);return;}

                // DB-də saxlandı, sıralarını yenilə
                currentRow.dataset.trPeriods=payload;
                function setCol(cls,val,hasData){
                    var el=currentRow.querySelector(cls);
                    el.textContent=hasData?val:'—';
                    el.className=el.className.replace(' empty','')+(hasData?'':' empty');
                }
                var hasKitabce=!!payload;
                setCol('.tr-il',d.evvelkiIl,hasKitabce);
                setCol('.tr-ay',d.evvelkiAy,hasKitabce);
                setCol('.tr-gun',d.evvelkiGun,hasKitabce);

                var openBtn=currentRow.querySelector('.tr-open-btn');
                if(hasKitabce) openBtn.classList.add('has-data'); else openBtn.classList.remove('has-data');

                currentRow.querySelector('.cari-staj').textContent=d.stajIl+' il '+d.stajAy+' ay '+d.stajGun+' gün';

                // Faiz badge
                var fs=currentRow.querySelector('.cari-faiz');
                fs.textContent=d.faiz+'%';
                fs.style.background=d.faiz===100?'#dcfce7':d.faiz===80?'#fef3c7':'#fee2e2';
                fs.style.color=d.faiz===100?'#166534':d.faiz===80?'#92400e':'#991b1b';

                showToast(d.message||'Saxlandı',true);
                closeModal();
            })
            .catch(function(){showToast('Server xətası.',false);})
            .finally(function(){btn.disabled=false;});
    });
    document.getElementById('trAddBtn').addEventListener('click',function(){periods.push({s:'',e:''});render();});
    document.getElementById('trClose').addEventListener('click',closeModal);
    document.getElementById('trCancelBtn').addEventListener('click',closeModal);
    overlay.addEventListener('click',function(e){if(e.target===overlay)closeModal();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeModal();});

    document.querySelectorAll('.tr-open-btn').forEach(function(btn){
        btn.addEventListener('click',function(){
            var row=document.querySelector('tr[data-isci-id="'+btn.dataset.isciId+'"]');
            openModal(row,btn.dataset.isciAd);
        });
    });

})();
</script>
@Html.AntiForgeryToken()
}
