@model IList<FinNex.Domain.Entities.HR.Isci>
@using FinNex.Domain.Entities.HR
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Məzuniyyət Balansı İdarəetməsi";

    var secilmisIl = (int)ViewBag.SecilmisIl;
    var iller = (List<int>)ViewBag.Iller;
    var illerUzreQaliq = ViewBag.IllerUzreQaliq as Dictionary<int, List<(int Il, int Qaliq, bool Cari)>>
                       ?? new Dictionary<int, List<(int Il, int Qaliq, bool Cari)>>();
    var standartGun = (int)(ViewBag.StandartIllikGun ?? 21);
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet-balans.css" asp-append-version="true" />
    <style>
        /* ── Sakit və oxunaqlı dizayn ── */
        .mb-table tbody td { vertical-align: middle; padding: 16px 14px }
        .mb-table thead th { padding: 12px 14px; font-size: 11px; letter-spacing: .4px }

        .mb-isci-ad { font-weight: 600; color: #0f172a; font-size: 13.5px }
        .mb-dept { font-size: 12.5px; color: #64748b }

        /* İllik balansı — qalıq mərkəzdə, istifadə altda */
        .mb-balance-block { display:flex; flex-direction:column; gap:6px; min-width:180px; max-width:240px }
        .mb-qaliq-row {
            display:flex; align-items:baseline; gap:6px;
        }
        .mb-qaliq-big {
            font-size:22px; font-weight:800; color:#0f172a; line-height:1
        }
        .mb-qaliq-unit { font-size:12px; color:#64748b; font-weight:500 }
        .mb-toplam-badge {
            font-size:11px; color:#475569; font-weight:600;
            padding:2px 8px; background:#f1f5f9; border-radius:8px;
            border:1px solid #e2e8f0; margin-left:4px
        }
        .mb-istifade-info {
            font-size:11.5px; color:#94a3b8; font-weight:500
        }
        .mb-istifade-info strong { color:#0f172a; font-weight:600 }

        .mb-prog {
            height:6px; background:#f1f5f9; border-radius:3px; overflow:hidden
        }
        .mb-prog__bar { height:100%; border-radius:3px; transition:width .3s }
        .mb-prog__bar--green  { background:linear-gradient(90deg,#16a34a,#22c55e) }
        .mb-prog__bar--yellow { background:linear-gradient(90deg,#f59e0b,#fbbf24) }
        .mb-prog__bar--red    { background:linear-gradient(90deg,#dc2626,#ef4444) }

        /* Əvvəlki illər siyahısı */
        .mb-prev-years { display:flex; flex-direction:column; gap:5px; min-width:130px; max-width:180px }
        .mb-prev-year-row {
            display:flex; justify-content:space-between; align-items:center;
            font-size:12px; padding:5px 11px; background:#f8fafc;
            border-radius:6px; border:1px solid #e2e8f0
        }
        .mb-prev-year-row .il { color:#64748b; font-weight:600 }
        .mb-prev-year-row .gun { color:#0f172a; font-weight:700 }
        .mb-prev-year-row .gun-missing { color:#94a3b8; font-style:italic; font-size:11px; font-weight:500 }
        .mb-year-current { background:#eff6ff !important; border-color:#bfdbfe !important }
        .mb-year-current .il { color:#1e40af }
        .mb-year-missing { background:#fef2f2 !important; border-color:#fecaca !important }
        .mb-year-missing .il { color:#991b1b }
        .mb-no-balance {
            font-size:12px; color:#991b1b; background:#fef2f2; border:1px solid #fecaca;
            padding:8px 12px; border-radius:8px; display:inline-flex; align-items:center; gap:6px;
            font-weight:600
        }
        .mb-prev-empty { font-size:12px; color:#cbd5e1; font-style:italic }
        .mb-prev-cemi {
            font-size:11px; color:#1e40af; font-weight:700; margin-top:4px;
            padding:3px 10px; background:#eff6ff; border-radius:10px; display:inline-block;
            border:1px solid #dbeafe
        }

        /* Xəstəlik / Ezamiyyət — minimalist */
        .mb-used-cell { text-align:center }
        .mb-used-num { font-size:16px; font-weight:700; color:#0f172a; line-height:1 }
        .mb-used-lbl { font-size:10.5px; color:#94a3b8; margin-top:3px }
        .mb-used-empty { color:#cbd5e1; font-size:12px; font-style:italic }

        /* Əməliyyat sütunu — daha aydın düymə */
        .mb-btn-edit {
            display:inline-flex; align-items:center; gap:5px;
            padding:7px 14px; background:#fff; border:1px solid #cbd5e1;
            border-radius:7px; cursor:pointer; font-size:12.5px; font-weight:600;
            color:#0f172a; transition:all .15s;
            white-space:nowrap
        }
        .mb-btn-edit:hover { background:#f1f5f9; border-color:#94a3b8 }
        .mb-btn-edit i { font-size:13px }
    </style>
}

<div class="mb-page">
    <!-- Header -->
    <div class="mb-header">
        <div>
            <h2 style="margin-bottom:4px">Məzuniyyət Balansı</h2>
            <div style="font-size:13px;color:#64748b">
                @secilmisIl-ci il üçün işçilərin məzuniyyət balansları
            </div>
        </div>
        <div class="mb-controls">
            <select id="mbYearSelect" class="mb-year-select">
                @foreach (var il in iller)
                {
                    <option value="@il" selected="@(il == secilmisIl)">@il</option>
                }
            </select>
        </div>
    </div>

    <!-- Table Card -->
    <div class="mb-card">
        <div class="mb-card__header">
            <h3 class="mb-card__title">İşçilər (<span id="mbVisibleCount">@Model.Count</span> nəfər)</h3>
            <span class="mb-card__badge">@secilmisIl</span>
        </div>

        @* ── Axtarış + departament filtri ── *@
        <div style="padding:12px 16px 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <div style="flex:1;min-width:260px;position:relative">
                <i class="bi bi-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px"></i>
                <input type="text" id="mbSearch" placeholder="İşçi adı, FİN, departament və ya vəzifə ilə axtar..."
                       style="width:100%;padding:9px 14px 9px 38px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;outline:none" />
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="mb-table-wrap">
                <table class="mb-table" id="mbTable">
                    <thead>
                        <tr>
                            <th style="min-width:200px">İşçi</th>
                            <th>Departament</th>
                            <th style="min-width:240px">Qalıq məzuniyyət (@secilmisIl)</th>
                            <th style="min-width:200px">İllər üzrə qalıq</th>
                            <th class="mb-used-cell">Xəstəlik</th>
                            <th class="mb-used-cell">Ezamiyyət</th>
                            <th style="width:110px">Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var isci in Model)
                        {
                            var teyinat = isci.IsciTeyinatlari?.FirstOrDefault();
                            var deptAd = teyinat?.Departament?.Ad ?? "—";
                            var balanslar = isci.MezuniyyetBalanslari?.ToList() ?? new List<MezuniyyetBalans>();

                            var illik = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Illik);
                            var xestelik = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Xestelik);
                            var ezamiyyet = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Ezamiyyet);

                            var balansJson = System.Text.Json.JsonSerializer.Serialize(balanslar.Select(b => new
                            {
                                id = b.Id,
                                nov = (int)b.Nov,
                                toplamGun = b.ToplamGun,
                                istifade = b.IstifadeOlunanGun,
                                qaliq = b.QaliqGun
                            }));

                            // İllər üzrə qalıq (cari il də daxil)
                            var illerList = illerUzreQaliq.TryGetValue(isci.Id, out var list) ? list : null;
                            var umumiQaliq = (illerList?.Sum(x => x.Qaliq) ?? 0) + (illik == null ? 0 : 0);

                            <tr>
                                <td>
                                    <div class="mb-isci-ad">@isci.Ad @isci.Soyad</div>
                                    @if (!string.IsNullOrEmpty(isci.FIN))
                                    {
                                        <div style="font-size:10px;color:#94a3b8;margin-top:2px">FİN: @isci.FIN</div>
                                    }
                                </td>
                                <td>
                                    <span class="mb-dept">@deptAd</span>
                                </td>

                                @* ═══ Qalıq məzuniyyət (cari il əsas göstəriş) ═══ *@
                                <td>
                                    @if (illik == null)
                                    {
                                        <div class="mb-no-balance">
                                            <i class="bi bi-info-circle"></i> hələ verilməyib
                                        </div>
                                    }
                                    else
                                    {
                                        var pct = illik.ToplamGun > 0
                                            ? (int)Math.Round((double)illik.QaliqGun / illik.ToplamGun * 100)
                                            : 0;
                                        var cls = pct > 50 ? "green" : (pct >= 20 ? "yellow" : "red");

                                        <div class="mb-balance-block">
                                            <div class="mb-qaliq-row">
                                                <span class="mb-qaliq-big">@illik.QaliqGun</span>
                                                <span class="mb-qaliq-unit">gün qalır</span>
                                            </div>
                                            <div class="mb-prog">
                                                <div class="mb-prog__bar mb-prog__bar--@cls" style="width:@(pct)%"></div>
                                            </div>
                                            <div class="mb-istifade-info">
                                                @if (illik.IstifadeOlunanGun > 0)
                                                {
                                                    <span><strong>@illik.IstifadeOlunanGun</strong> gün istifadə edilib · @illik.ToplamGun toplam</span>
                                                }
                                                else
                                                {
                                                    <span>@illik.ToplamGun gün verilib · istifadə olunmayıb</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </td>

                                @* ═══ İllər üzrə qalıq (hər il ayrıca) ═══ *@
                                <td>
                                    @{
                                        var cariIlBalansVar = illerList != null && illerList.Any(x => x.Cari);
                                        var gostersilecekIller = illerList?.Where(x => x.Cari || x.Qaliq > 0).OrderByDescending(x => x.Il).ToList() ?? new();
                                    }
                                    @if (!gostersilecekIller.Any() && !cariIlBalansVar)
                                    {
                                        <div class="mb-prev-years">
                                            <div class="mb-prev-year-row mb-year-missing">
                                                <span class="il">@secilmisIl</span>
                                                <span class="gun-missing">hələ verilməyib</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var cemQaliq = gostersilecekIller.Sum(y => y.Qaliq);
                                        <div class="mb-prev-years">
                                            @foreach (var y in gostersilecekIller)
                                            {
                                                <div class="mb-prev-year-row @(y.Cari ? "mb-year-current" : "")">
                                                    <span class="il">@y.Il @(y.Cari ? "(cari)" : "")</span>
                                                    <span class="gun">@y.Qaliq gün</span>
                                                </div>
                                            }
                                            @if (!cariIlBalansVar)
                                            {
                                                <div class="mb-prev-year-row mb-year-missing">
                                                    <span class="il">@secilmisIl (cari)</span>
                                                    <span class="gun-missing">hələ verilməyib</span>
                                                </div>
                                            }
                                        </div>
                                        @if (gostersilecekIller.Count >= 2)
                                        {
                                            <span class="mb-prev-cemi">
                                                Cəm: @cemQaliq gün
                                            </span>
                                        }
                                    }
                                </td>

                                @* ═══ Xəstəlik / Ezamiyyət — yalnız istifadə olunduqda göstər ═══ *@
                                <td class="mb-used-cell">
                                    @if (xestelik == null || xestelik.IstifadeOlunanGun == 0)
                                    {
                                        <span class="mb-used-empty">—</span>
                                    }
                                    else
                                    {
                                        <div class="mb-used-num">@xestelik.IstifadeOlunanGun</div>
                                        <div class="mb-used-lbl">gün</div>
                                    }
                                </td>
                                <td class="mb-used-cell">
                                    @if (ezamiyyet == null || ezamiyyet.IstifadeOlunanGun == 0)
                                    {
                                        <span class="mb-used-empty">—</span>
                                    }
                                    else
                                    {
                                        <div class="mb-used-num">@ezamiyyet.IstifadeOlunanGun</div>
                                        <div class="mb-used-lbl">gün</div>
                                    }
                                </td>

                                <td>
                                    <button class="mb-btn-edit"
                                            data-isci-id="@isci.Id"
                                            data-isci-ad="@isci.Ad @isci.Soyad"
                                            data-il="@secilmisIl"
                                            data-balanslar="@Html.Raw(System.Net.WebUtility.HtmlEncode(balansJson))"
                                            title="İşçinin məzuniyyət balansını illərə görə redaktə et və ya yeni il üçün gün əlavə et">
                                        <i class="bi bi-sliders"></i> Balansı dəyiş
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mb-empty">
                <i class="bi bi-calendar-x"></i>
                <p>@secilmisIl-ci il üçün heç bir məlumat tapılmadı.</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal — illərə görə redaktə + yeni il əlavə etmə -->
<div id="mbModalOverlay" class="mb-modal-overlay">
    <div class="mb-modal" style="max-width:700px">
        <div class="mb-modal__header">
            <h3>Balans Redaktəsi</h3>
            <button id="mbModalClose" class="mb-modal__close">&times;</button>
        </div>
        <div class="mb-modal__body">
            <div id="mbModalIsciAd" class="mb-modal__isci-info"></div>

            @* İllik məzuniyyət — illərə görə *@
            <div style="margin-bottom:16px">
                <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
                    <span>İllik məzuniyyət — illərə görə</span>
                    <span id="mbLoadingIndicator" style="font-size:11px;color:#94a3b8;display:none">Yüklənir...</span>
                </div>
                <table class="mb-edit-table" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:80px">İl</th>
                            <th>Toplam</th>
                            <th>İstifadə</th>
                            <th>Qalıq</th>
                            <th style="width:90px">Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody id="mbIllikTbody">
                        <tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:20px">— yüklənir —</td></tr>
                    </tbody>
                </table>
            </div>

            @* Yeni il əlavə et *@
            <div style="padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;margin-bottom:16px">
                <div style="font-size:12px;font-weight:700;color:#1e40af;margin-bottom:8px">
                    <i class="bi bi-plus-circle"></i> Yeni il üçün İllik balans əlavə et
                </div>
                <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
                    <div style="flex:1;min-width:90px">
                        <label style="font-size:10px;color:#64748b;display:block;margin-bottom:3px">İl</label>
                        <input type="number" id="mbYeniIl" class="mb-edit-input" placeholder="Məs. 2023" min="2000" max="2030" style="width:100%" />
                    </div>
                    <div style="flex:2;min-width:120px">
                        <label style="font-size:10px;color:#64748b;display:block;margin-bottom:3px">Toplam gün</label>
                        <input type="number" id="mbYeniToplam" class="mb-edit-input" placeholder="Məs. 5" min="1" max="365" style="width:100%" />
                    </div>
                    <button id="mbYeniIlElaveEt" class="mb-btn-save" style="min-width:110px">Əlavə et</button>
                </div>
                <div style="font-size:10px;color:#94a3b8;margin-top:6px">
                    Əgər həmin il üçün artıq balans varsa — günlər üstə gəlinəcək.
                </div>
            </div>

            @* Cari ilin Xəstəlik / Ezamiyyət balansı *@
            <div>
                <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:8px">
                    Cari il (<span id="mbCariIlMetn">—</span>) — digər növlər
                </div>
                <table class="mb-edit-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>Növ</th>
                            <th>Toplam gün</th>
                            <th>İstifadə</th>
                            <th>Qalıq</th>
                            <th style="width:90px">Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody id="mbDigerTbody"></tbody>
                </table>
            </div>
        </div>
        <div class="mb-modal__footer">
            <button id="mbModalCancel" class="mb-btn-cancel">Bağla</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="mbToast" class="mb-toast"></div>

@section Scripts {
    <script src="~/js/hr/mezuniyyet-balans.js" asp-append-version="true"></script>
}
