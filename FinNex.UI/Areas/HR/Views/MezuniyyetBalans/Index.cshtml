@model IList<FinNex.Domain.Entities.HR.Isci>
@using FinNex.Domain.Entities.HR
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Məzuniyyət Balansı İdarəetməsi";

    var secilmisIl = (int)ViewBag.SecilmisIl;
    var iller = (List<int>)ViewBag.Iller;
    var illerUzreQaliq = ViewBag.IllerUzreQaliq as Dictionary<int, List<(int Il, int Qaliq, bool Cari)>>
                       ?? new Dictionary<int, List<(int Il, int Qaliq, bool Cari)>>();
    var standartGun = (int)(ViewBag.StandartIllikGun ?? 21);

    // «Limit 14 gün» — Ə.M. md.137. { isciId: { iş ili } } — həmin iş ilində
    // birdəfəlik ≥14 günlük məzuniyyət götürülüb (controller hesablayır).
    var onDordGunVar = ViewBag.OnDordGunVar as Dictionary<int, HashSet<int>>
                     ?? new Dictionary<int, HashSet<int>>();
    var minBirdefelik = (int)(ViewBag.MinBirdefelikGun ?? 14);
}

@functions {
    // Ən son keçmiş işə qəbul ildönümü = cari məzuniyyət dövrünün başlanğıcı.
    // Yenilənmə tsikli audit tarixinə yox, işçinin işə qəbul ildönümünə bağlıdır.
    // 29 fevral kimi hüdud hallarını ayın son gününə clamp edir.
    static DateTime SonIldonum(DateTime iseQebul, DateTime bugun)
    {
        int il = bugun.Year;
        int ay = iseQebul.Month;
        int gun = Math.Min(iseQebul.Day, DateTime.DaysInMonth(il, ay));
        var buIl = new DateTime(il, ay, gun);
        if (buIl > bugun)
        {
            il--;
            gun = Math.Min(iseQebul.Day, DateTime.DaysInMonth(il, ay));
            return new DateTime(il, ay, gun);
        }
        return buIl;
    }

    // İş ili tək təqvim ilini yox, işə qəbul dönümündən növbəti ilə keçən dövrü
    // əhatə edir — ona görə "2026" yox, "2026–2027" göstərilir.
    static string IlAralik(int il) => $"{il}–{il + 1}";

    // «Limit 14 gün» — bir iş ilinin sərbəst (bölünə bilən) hissəsi.
    // Ə.M. md.137: əsas məzuniyyətin hissələrindən biri ən azı 14 gün olmalıdır.
    //   onDordVar = true  → tələb artıq ödənilib, bütün qalıq sərbəstdir
    //   onDordVar = false → qalıqdan 14 gün ehtiyat saxlanılır
    // MƏNFİ RƏQƏM VERİLMİR (istifadəçi qərarı) — qalıq 14-dən azdırsa nəticə 0-dır
    // və bu, «14 günlük hissə üçün qalıq çatmır» deməkdir.
    static int Serbest(bool onDordVar, int qaliq, int min)
        => onDordVar ? Math.Max(0, qaliq) : Math.Max(0, qaliq - min);
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet-balans.css" asp-append-version="true" />
    <style>
        /* ══ KOMPAKT CƏDVƏL (09.09.2026) ═══════════════════════════════════
           Əvvəl hər işçi 4 sətir hündürlükdə blok idi: qalıq bloku, illər
           siyahısı, yenilənmə qutusu, limit nişanları — hamısı eyni anda.
           26 işçi 5 ekran tuturdu və rəqəmlər bir-birinə qarışırdı.

           İndi: bir işçi = BİR sətir (yalnız rəqəmlər). Sətrə klikləyəndə
           altında detal açılır (illər üzrə bölgü + cari dövr). Beləcə icmal
           bir ekrana sığır, detal isə lazım olanda görünür. */

        .mbk-wrap { overflow-x: auto; border-top: 1px solid #e2e8f0 }

        .mbk-table { width: 100%; border-collapse: collapse; font-size: 13px }
        .mbk-table thead th {
            background: #f8fafc; color: #64748b; font-size: 10.5px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .4px; text-align: left;
            padding: 10px 10px; border-bottom: 1px solid #e2e8f0; white-space: nowrap;
            position: sticky; top: 0; z-index: 2;
        }
        .mbk-table thead th.num { text-align: center }

        .mbk-row > td { padding: 10px; border-bottom: 1px solid #f1f5f9; vertical-align: middle }
        .mbk-row { cursor: pointer; transition: background .12s }
        .mbk-row:hover { background: #f8fafc }
        .mbk-row.acilib { background: #eff6ff }
        .mbk-row.acilib > td { border-bottom-color: #bfdbfe }

        .mbk-sira { text-align: center; color: #94a3b8; font-size: 12px; width: 34px }

        .mbk-ad { font-weight: 600; color: #0f172a; font-size: 13px; line-height: 1.3 }
        .mbk-fin { font-size: 10px; color: #94a3b8; font-family: ui-monospace, monospace; margin-top: 1px }
        .mbk-dept { font-size: 12px; color: #475569 }
        .mbk-tarix { font-size: 12px; color: #475569; white-space: nowrap }

        /* Rəqəm xanaları — hamısı eyni cür oxunsun */
        .mbk-n { text-align: center; font-variant-numeric: tabular-nums; white-space: nowrap }
        .mbk-n b { font-size: 14px; font-weight: 700; color: #0f172a }
        .mbk-n .vahid { font-size: 10px; color: #94a3b8; margin-left: 2px }
        .mbk-bos { color: #cbd5e1 }

        .mbk-cem b { font-size: 17px; color: #1e40af }
        .mbk-serbest b { font-size: 15px; color: #047857 }
        .mbk-serbest.sifir b { color: #b45309 }

        /* «Təyin edilməyib» — xəta deyil, sadəcə boşluq */
        .mbk-teyinsiz {
            display: inline-flex; align-items: center; gap: 4px;
            font-size: 10.5px; color: #94a3b8; font-weight: 500; white-space: nowrap;
        }

        .mbk-emeliyyat { text-align: right; white-space: nowrap }
        .mbk-detal-btn {
            display: inline-flex; align-items: center; justify-content: center;
            width: 26px; height: 26px; border: 1px solid #cbd5e1; background: #fff;
            border-radius: 6px; color: #475569; font-size: 12px; cursor: pointer;
            transition: transform .15s, background .12s; vertical-align: middle;
        }
        .mbk-detal-btn:hover { background: #f1f5f9 }
        .mbk-row.acilib .mbk-detal-btn { transform: rotate(180deg); background: #dbeafe; border-color: #93c5fd }

        .mbk-duzelt {
            display: inline-flex; align-items: center; gap: 5px; margin-left: 6px;
            padding: 5px 11px; background: #fff; border: 1px solid #cbd5e1;
            border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600;
            color: #0f172a; vertical-align: middle;
        }
        .mbk-duzelt:hover { background: #f1f5f9; border-color: #94a3b8 }

        /* ── Detal sətri ────────────────────────────────────────────── */
        .mbk-detal > td { padding: 0; border-bottom: 1px solid #e2e8f0; background: #f8fafc }
        .mbk-detal-ic {
            display: grid; grid-template-columns: minmax(300px, 1.4fr) minmax(240px, 1fr);
            gap: 18px; padding: 14px 16px 16px;
        }
        @@media (max-width: 900px) { .mbk-detal-ic { grid-template-columns: 1fr } }

        .mbk-blok-basliq {
            font-size: 10.5px; font-weight: 700; color: #64748b; text-transform: uppercase;
            letter-spacing: .4px; margin-bottom: 7px;
        }

        .mbk-iller { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; overflow: hidden }
        .mbk-iller th {
            background: #f1f5f9; font-size: 10px; color: #64748b; font-weight: 700;
            text-transform: uppercase; padding: 6px 9px; text-align: left;
        }
        .mbk-iller td { padding: 7px 9px; border-top: 1px solid #f1f5f9; font-size: 12px }
        .mbk-iller tr.cari td { background: #eff6ff; font-weight: 600 }
        .mbk-iller .g { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; width: 70px }

        .mbk-nisan { font-size: 11px; font-weight: 600; white-space: nowrap }
        .mbk-nisan.ok   { color: #047857 }
        .mbk-nisan.gz   { color: #b45309 }
        .mbk-nisan.yox  { color: #b91c1c }

        .mbk-kart { background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 11px 13px }
        .mbk-setir { display: flex; justify-content: space-between; gap: 12px; font-size: 12px; padding: 3px 0 }
        .mbk-setir span:first-child { color: #64748b }
        .mbk-setir span:last-child { font-weight: 600; color: #0f172a; font-variant-numeric: tabular-nums }
        .mbk-bar { height: 4px; background: #e2e8f0; border-radius: 2px; margin-top: 7px; overflow: hidden }
        .mbk-bar i { display: block; height: 100%; background: #6366f1; border-radius: 2px }
        .mbk-qeyd { font-size: 10.5px; color: #94a3b8; margin-top: 8px; line-height: 1.5 }
    </style>
}

<div class="mb-page">
    <!-- Header -->
    <div class="mb-header">
        <div>
            <h2 style="margin-bottom:4px">Məzuniyyət Balansı</h2>
            <div style="font-size:13px;color:#64748b">
                @IlAralik(secilmisIl) iş ili üçün işçilərin məzuniyyət balansları
            </div>
        </div>
        <div class="mb-controls">
            <a asp-action="Yoxlama" class="fn-btn fn-btn--outline" title="Sistemin avtomatik hesabladığı illik hüquq (yalnız oxuma)">
                <i class="bi bi-calculator"></i> Avtomatik hesablama (yoxlama)
            </a>
            <select id="mbYearSelect" class="mb-year-select">
                @foreach (var il in iller)
                {
                    <option value="@il" selected="@(il == secilmisIl)">@IlAralik(il)</option>
                }
            </select>
        </div>
    </div>

    <!-- Table Card -->
    <div class="mb-card">
        <div class="mb-card__header">
            <h3 class="mb-card__title">İşçilər (<span id="mbVisibleCount">@Model.Count</span> nəfər)</h3>
            <span class="mb-card__badge">@IlAralik(secilmisIl)</span>
        </div>

        @* ── Axtarış ── *@
        <div style="padding:12px 16px;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <div style="flex:1;min-width:260px;position:relative">
                <i class="bi bi-search" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:13px"></i>
                <input type="text" id="mbSearch" placeholder="İşçi adı, FİN, departament və ya vəzifə ilə axtar..."
                       style="width:100%;padding:9px 14px 9px 38px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;outline:none" />
            </div>
            <span style="font-size:11px;color:#94a3b8;white-space:nowrap">
                <i class="bi bi-info-circle"></i> Sətrə klikləyin — illər üzrə detal açılır
            </span>
        </div>

        @if (Model.Any())
        {
            <div class="mbk-wrap">
                <table class="mbk-table" id="mbTable">
                    <thead>
                        <tr>
                            <th class="num">№</th>
                            <th style="min-width:180px">İşçi</th>
                            <th style="min-width:130px">Departament</th>
                            <th style="width:92px">İşə qəbul</th>
                            <th class="num" style="width:74px" title="Bu iş ili üçün təyin edilmiş illik məzuniyyət hüququ (Excel: «MH»)">İllik hüquq</th>
                            <th class="num" style="width:74px">Cari il</th>
                            <th class="num" style="width:80px">Keçmiş illər</th>
                            <th class="num" style="width:82px">Cəmi qalıq</th>
                            <th class="num" style="width:92px" title="Ə.M. md.137 — bir hissə ən azı 14 gün olmalıdır. Bu, yalnız göstərişdir: balansdan heç nə çıxılmır.">Sərbəst</th>
                            <th style="width:150px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int sira = 0; }
                        @foreach (var isci in Model)
                        {
                            sira++;
                            var teyinat = isci.IsciTeyinatlari?.FirstOrDefault();
                            var deptAd = teyinat?.Departament?.Ad ?? "—";
                            var balanslar = isci.MezuniyyetBalanslari?.ToList() ?? new List<MezuniyyetBalans>();

                            // DİQQƏT: b.Il == secilmisIl filtri MÜTLƏQDİR. Yoxsa naviqasiyaya
                            // əvvəlki illərin balansı düşərsə (EF fixup), əvvəlki ilin balansı
                            // cari il kimi göstərilə bilər.
                            var illik = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Illik && b.Il == secilmisIl);

                            // Yenilənmə tsikli işə qəbul ildönümünə bağlıdır.
                            var bugun = DateTime.Now.Date;
                            var sonYenilenme = SonIldonum(isci.IsheQebulTarixi.Date, bugun);
                            var novbetiYenilenme = sonYenilenme.AddYears(1);

                            int haqqGun = 0, gecenGun = 0;
                            int daysInYear = DateTime.IsLeapYear(secilmisIl) ? 366 : 365;
                            if (illik != null)
                            {
                                gecenGun = Math.Max(0, Math.Min((bugun - sonYenilenme).Days, daysInYear));
                                haqqGun = (int)Math.Round((double)gecenGun / daysInYear * illik.ToplamGun);
                            }

                            var balansJson = System.Text.Json.JsonSerializer.Serialize(balanslar.Select(b => new
                            {
                                id = b.Id,
                                nov = (int)b.Nov,
                                toplamGun = b.ToplamGun,
                                istifade = b.IstifadeOlunanGun,
                                qaliq = b.QaliqGun
                            }));

                            var illerList = illerUzreQaliq.TryGetValue(isci.Id, out var list) ? list : null;
                            var kecmisIller = illerList?
                                .Where(x => !x.Cari && x.Qaliq > 0)
                                .OrderByDescending(x => x.Il)
                                .ToList() ?? new();
                            var kecmisQaliqSum = kecmisIller.Sum(x => x.Qaliq);
                            var cariQaliq = illik?.QaliqGun ?? 0;
                            var umumiQaliq = cariQaliq + kecmisQaliqSum;

                            // «Limit 14 gün» — hansı iş illərində birdəfəlik ≥14 gün alınıb.
                            var isciOnDord = onDordGunVar.TryGetValue(isci.Id, out var odSet) ? odSet : null;
                            var cariOnDordVar = isciOnDord != null && isciOnDord.Contains(secilmisIl);
                            var cariSerbest = Serbest(cariOnDordVar, cariQaliq, minBirdefelik);

                            // Yekun: HƏR iş ili öz qalığından öz limitini çıxır, sonra toplanır.
                            // «Bütöv qalıqdan bir dəfə 14 çıxmaq» SƏHV olardı — tələb hər iş
                            // ili üçün ayrıca qüvvədədir.
                            var umumiSerbest = cariSerbest + kecmisIller.Sum(y =>
                                Serbest(isciOnDord != null && isciOnDord.Contains(y.Il), y.Qaliq, minBirdefelik));
                            var ehtiyat = umumiQaliq - umumiSerbest;

                            <tr class="mbk-row" data-detal="mbd-@isci.Id">
                                <td class="mbk-sira">@sira</td>
                                <td>
                                    <div class="mbk-ad">@isci.Ad @isci.Soyad</div>
                                    @if (!string.IsNullOrEmpty(isci.FIN))
                                    {
                                        <div class="mbk-fin">@isci.FIN</div>
                                    }
                                </td>
                                <td><span class="mbk-dept">@deptAd</span></td>
                                <td><span class="mbk-tarix">@isci.IsheQebulTarixi.ToString("dd.MM.yyyy")</span></td>

                                @* İllik hüquq (Excel «MH») *@
                                <td class="mbk-n">
                                    @if (illik != null)
                                    {
                                        <b>@illik.ToplamGun</b><span class="vahid">gün</span>
                                    }
                                    else
                                    {
                                        <span class="mbk-bos">—</span>
                                    }
                                </td>

                                @* Cari iş ilinin qalığı *@
                                <td class="mbk-n">
                                    @if (illik != null)
                                    {
                                        <b>@cariQaliq</b>
                                    }
                                    else
                                    {
                                        <span class="mbk-teyinsiz" title="@IlAralik(secilmisIl) iş ili üçün balans hələ təyin edilməyib">
                                            <i class="bi bi-hourglass-split"></i> təyin edilməyib
                                        </span>
                                    }
                                </td>

                                @* Keçmiş illərdən qalan *@
                                <td class="mbk-n">
                                    @if (kecmisQaliqSum > 0)
                                    {
                                        <b>@kecmisQaliqSum</b>
                                    }
                                    else
                                    {
                                        <span class="mbk-bos">—</span>
                                    }
                                </td>

                                @* Cəmi qalıq — səhifənin əsas rəqəmi *@
                                <td class="mbk-n mbk-cem"><b>@umumiQaliq</b></td>

                                @* Sərbəst (14 gün limitindən sonra) *@
                                <td class="mbk-n mbk-serbest @(umumiSerbest > 0 ? "" : "sifir")">
                                    @if (umumiQaliq <= 0)
                                    {
                                        <span class="mbk-bos">—</span>
                                    }
                                    else
                                    {
                                        <b>@umumiSerbest</b>
                                    }
                                </td>

                                <td class="mbk-emeliyyat">
                                    <button type="button" class="mbk-detal-btn" title="İllər üzrə detalı aç">
                                        <i class="bi bi-chevron-down"></i>
                                    </button>
                                    <button type="button" class="mbk-duzelt mb-btn-edit"
                                            data-isci-id="@isci.Id"
                                            data-isci-ad="@isci.Ad @isci.Soyad"
                                            data-il="@secilmisIl"
                                            data-balanslar="@Html.Raw(System.Net.WebUtility.HtmlEncode(balansJson))"
                                            title="İşçinin məzuniyyət balansını illərə görə redaktə et və ya yeni il üçün gün əlavə et">
                                        <i class="bi bi-sliders"></i> Dəyiş
                                    </button>
                                </td>
                            </tr>

                            @* ── DETAL SƏTRİ — klikləyəndə açılır ────────────────── *@
                            <tr class="mbk-detal" id="mbd-@isci.Id" hidden>
                                <td colspan="10">
                                    <div class="mbk-detal-ic">

                                        <div>
                                            <div class="mbk-blok-basliq">İllər üzrə qalıq</div>
                                            <table class="mbk-iller">
                                                <thead>
                                                    <tr>
                                                        <th>İş ili</th>
                                                        <th class="g">Qalıq</th>
                                                        <th>14 günlük hissə</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr class="cari">
                                                        <td>@IlAralik(secilmisIl) <span style="color:#3b82f6;font-size:10px">(cari)</span></td>
                                                        <td class="g">
                                                            @if (illik != null)
                                                            {
                                                                <text>@cariQaliq gün</text>
                                                            }
                                                            else
                                                            {
                                                                <span class="mbk-bos">—</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (illik == null)
                                                            {
                                                                <span class="mbk-bos" style="font-size:11px">balans təyin edilməyib</span>
                                                            }
                                                            else if (cariOnDordVar)
                                                            {
                                                                <span class="mbk-nisan ok"><i class="bi bi-check-circle-fill"></i> alınıb — qalıq sərbəst</span>
                                                            }
                                                            else if (cariSerbest > 0)
                                                            {
                                                                <span class="mbk-nisan gz">sərbəst @cariSerbest gün (@cariQaliq − @minBirdefelik)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="mbk-nisan yox">qalıq @minBirdefelik günə çatmır</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                    @foreach (var y in kecmisIller)
                                                    {
                                                        var yOnDord = isciOnDord != null && isciOnDord.Contains(y.Il);
                                                        var ySerbest = Serbest(yOnDord, y.Qaliq, minBirdefelik);
                                                        <tr>
                                                            <td>@IlAralik(y.Il)</td>
                                                            <td class="g">@y.Qaliq gün</td>
                                                            <td>
                                                                @if (yOnDord)
                                                                {
                                                                    <span class="mbk-nisan ok"><i class="bi bi-check-circle-fill"></i> alınıb — qalıq sərbəst</span>
                                                                }
                                                                else if (ySerbest > 0)
                                                                {
                                                                    <span class="mbk-nisan gz">sərbəst @ySerbest gün (@y.Qaliq − @minBirdefelik)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="mbk-nisan yox">qalıq @minBirdefelik günə çatmır</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <div class="mbk-qeyd">
                                                «Sərbəst» — bölünə bilən gün sayı. Ə.M. md.137: əsas məzuniyyətin
                                                hissələrindən biri ən azı @minBirdefelik gün olmalıdır, ona görə həmin
                                                qədər gün ehtiyatda saxlanılır. <b>Bu, yalnız göstərişdir</b> —
                                                balansdan heç nə çıxılmır və heç bir müraciət bloklanmır.
                                            </div>
                                        </div>

                                        <div>
                                            <div class="mbk-blok-basliq">Cari dövr</div>
                                            <div class="mbk-kart">
                                                <div class="mbk-setir">
                                                    <span>İşə qəbul</span>
                                                    <span>@isci.IsheQebulTarixi.ToString("dd.MM.yyyy")</span>
                                                </div>
                                                <div class="mbk-setir">
                                                    <span>Dövrün başlanğıcı</span>
                                                    <span>@sonYenilenme.ToString("dd.MM.yyyy")</span>
                                                </div>
                                                <div class="mbk-setir">
                                                    <span>Növbəti yenilənmə</span>
                                                    <span>@novbetiYenilenme.ToString("dd.MM.yyyy")</span>
                                                </div>
                                                @if (illik != null)
                                                {
                                                    <div class="mbk-setir">
                                                        <span>Haqq qazanılmış</span>
                                                        <span>@haqqGun / @illik.ToplamGun gün</span>
                                                    </div>
                                                    var haqqPct = illik.ToplamGun > 0
                                                        ? (int)Math.Round((double)haqqGun / illik.ToplamGun * 100)
                                                        : 0;
                                                    <div class="mbk-bar"><i style="width:@(haqqPct)%"></i></div>
                                                    <div class="mbk-qeyd">
                                                        Dövrün @gecenGun / @daysInYear günü keçib.
                                                        «Haqq qazanılmış» — bu günə qədər qazanılmış hissə;
                                                        balans il əvvəlində tam verilir.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="mbk-qeyd">
                                                        @IlAralik(secilmisIl) iş ili üçün balans hələ təyin edilməyib —
                                                        «Dəyiş» düyməsi ilə əlavə edin.
                                                    </div>
                                                }
                                            </div>

                                            @if (ehtiyat > 0)
                                            {
                                                <div class="mbk-kart" style="margin-top:10px;border-color:#fde68a;background:#fffbeb">
                                                    <div class="mbk-setir">
                                                        <span style="color:#b45309">@minBirdefelik günlük hissə üçün saxlanılır</span>
                                                        <span style="color:#b45309">@ehtiyat gün</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mb-empty">
                <i class="bi bi-calendar-x"></i>
                <p>@IlAralik(secilmisIl) iş ili üçün heç bir məlumat tapılmadı.</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal — illərə görə redaktə + yeni il əlavə etmə -->
<div id="mbModalOverlay" class="mb-modal-overlay">
    <div class="mb-modal" style="max-width:700px">
        <div class="mb-modal__header">
            <h3>Balans Redaktəsi</h3>
            <button id="mbModalClose" class="mb-modal__close">&times;</button>
        </div>
        <div class="mb-modal__body">
            <div id="mbModalIsciAd" class="mb-modal__isci-info"></div>

            @* Əmək məzuniyyəti — illərə görə *@
            <div style="margin-bottom:16px">
                <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">
                    <span>Əmək məzuniyyəti — illərə görə</span>
                    <span id="mbLoadingIndicator" style="font-size:11px;color:#94a3b8;display:none">Yüklənir...</span>
                </div>
                <table class="mb-edit-table" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:80px">İl</th>
                            <th>Toplam</th>
                            <th>İstifadə</th>
                            <th>Qalıq</th>
                            <th style="width:90px">Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody id="mbIllikTbody">
                        <tr><td colspan="5" style="text-align:center;color:#94a3b8;padding:20px">— yüklənir —</td></tr>
                    </tbody>
                </table>
            </div>

            @* Yeni il əlavə et *@
            <div style="padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;margin-bottom:16px">
                <div style="font-size:12px;font-weight:700;color:#1e40af;margin-bottom:8px">
                    <i class="bi bi-plus-circle"></i> Yeni il üçün Əmək məzuniyyəti balansı əlavə et
                </div>
                <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">
                    <div style="flex:1;min-width:90px">
                        <label style="font-size:10px;color:#64748b;display:block;margin-bottom:3px">İl</label>
                        <input type="number" id="mbYeniIl" class="mb-edit-input" placeholder="Məs. 2023" min="2000" max="2030" style="width:100%" />
                    </div>
                    <div style="flex:2;min-width:120px">
                        <label style="font-size:10px;color:#64748b;display:block;margin-bottom:3px">Toplam gün</label>
                        <input type="number" id="mbYeniToplam" class="mb-edit-input" placeholder="Məs. 5" min="1" max="365" style="width:100%" />
                    </div>
                    <button id="mbYeniIlElaveEt" class="mb-btn-save" style="min-width:110px">Əlavə et</button>
                </div>
                <div style="font-size:10px;color:#94a3b8;margin-top:6px">
                    Əgər həmin il üçün artıq balans varsa — günlər üstə gəlinəcək.
                </div>
            </div>

            @* Cari ilin Xəstəlik / Ezamiyyət balansı *@
            <div>
                <div style="font-size:13px;font-weight:700;color:#0f172a;margin-bottom:8px">
                    Cari il (<span id="mbCariIlMetn">—</span>) — digər növlər
                </div>
                <table class="mb-edit-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>Növ</th>
                            <th>Toplam gün</th>
                            <th>İstifadə</th>
                            <th>Qalıq</th>
                            <th style="width:90px">Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody id="mbDigerTbody"></tbody>
                </table>
            </div>
        </div>
        <div class="mb-modal__footer">
            <button id="mbModalCancel" class="mb-btn-cancel">Bağla</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="mbToast" class="mb-toast"></div>

@section Scripts {
    <script src="~/js/hr/mezuniyyet-balans.js" asp-append-version="true"></script>
}
