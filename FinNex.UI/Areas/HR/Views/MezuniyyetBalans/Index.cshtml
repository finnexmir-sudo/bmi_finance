@model IList<FinNex.Domain.Entities.HR.Isci>
@using FinNex.Domain.Entities.HR
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Məzuniyyət Balansı İdarəetməsi";

    var secilmisIl = (int)ViewBag.SecilmisIl;
    var iller = (List<int>)ViewBag.Iller;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet-balans.css" asp-append-version="true" />
}

<div class="mb-page">
    <!-- Header -->
    <div class="mb-header">
        <h2>Məzuniyyət Balansı İdarəetməsi</h2>
        <div class="mb-controls">
            <select id="mbYearSelect" class="mb-year-select">
                @foreach (var il in iller)
                {
                    <option value="@il" selected="@(il == secilmisIl)">@il</option>
                }
            </select>
            <button id="mbCreateYearBtn" class="mb-btn-create mb-btn-create--success">
                <i class="bi bi-plus-circle"></i> Yeni il balansı yarat
            </button>
        </div>
    </div>

    <!-- Table Card -->
    <div class="mb-card">
        <div class="mb-card__header">
            <h3 class="mb-card__title">@secilmisIl-ci il balansları</h3>
            <span class="mb-card__badge">@Model.Count işçi</span>
        </div>

        @if (Model.Any())
        {
            <div class="mb-table-wrap">
                <table class="mb-table">
                    <thead>
                        <tr>
                            <th>İşçi</th>
                            <th>Departament</th>
                            <th class="mb-table__th-center">İllik (T/İ/Q)</th>
                            <th class="mb-table__th-center">Xəstəlik (gün)</th>
                            <th class="mb-table__th-center">Ezamiyyət (gün)</th>
                            <th>Əməliyyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var isci in Model)
                        {
                            var teyinat = isci.IsciTeyinatlari?.FirstOrDefault();
                            var deptAd = teyinat?.Departament?.Ad ?? "—";
                            var balanslar = isci.MezuniyyetBalanslari?.ToList() ?? new List<MezuniyyetBalans>();

                            var illik = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Illik);
                            var xestelik = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Xestelik);
                            var ezamiyyet = balanslar.FirstOrDefault(b => b.Nov == MezuniyyetNovu.Ezamiyyet);

                            // JSON for edit modal
                            var balansJson = System.Text.Json.JsonSerializer.Serialize(balanslar.Select(b => new
                            {
                                id = b.Id,
                                nov = (int)b.Nov,
                                toplamGun = b.ToplamGun,
                                istifade = b.IstifadeOlunanGun,
                                qaliq = b.QaliqGun
                            }));

                            <tr>
                                <td>
                                    <div class="mb-isci-ad">@isci.Ad @isci.Soyad</div>
                                </td>
                                <td>
                                    <span class="mb-dept">@deptAd</span>
                                </td>

                                @{ await RenderBalanceCell(illik); }
                                @{ await RenderUsedOnlyCell(xestelik); }
                                @{ await RenderUsedOnlyCell(ezamiyyet); }

                                <td>
                                    <button class="mb-btn-edit"
                                            data-isci-id="@isci.Id"
                                            data-isci-ad="@isci.Ad @isci.Soyad"
                                            data-il="@secilmisIl"
                                            data-balanslar="@Html.Raw(System.Net.WebUtility.HtmlEncode(balansJson))">
                                        <i class="bi bi-pencil"></i> Redaktə
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mb-empty">
                <i class="bi bi-calendar-x"></i>
                <p>@secilmisIl-ci il üçün heç bir məlumat tapılmadı.</p>
            </div>
        }
    </div>
</div>

<!-- Edit Modal -->
<div id="mbModalOverlay" class="mb-modal-overlay">
    <div class="mb-modal">
        <div class="mb-modal__header">
            <h3>Balans Redaktəsi</h3>
            <button id="mbModalClose" class="mb-modal__close">&times;</button>
        </div>
        <div class="mb-modal__body">
            <div id="mbModalIsciAd" class="mb-modal__isci-info"></div>
            <table class="mb-edit-table">
                <thead>
                    <tr>
                        <th>Məzuniyyət növü</th>
                        <th>Toplam gün</th>
                        <th>İstifadə</th>
                        <th>Qalıq</th>
                    </tr>
                </thead>
                <tbody id="mbEditTableBody"></tbody>
            </table>
        </div>
        <div class="mb-modal__footer">
            <button id="mbModalCancel" class="mb-btn-cancel">Ləğv et</button>
            <button id="mbModalSave" class="mb-btn-save">Yadda saxla</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="mbToast" class="mb-toast"></div>

@section Scripts {
    <script src="~/js/hr/mezuniyyet-balans.js" asp-append-version="true"></script>
}

@functions {
    async Task RenderUsedOnlyCell(MezuniyyetBalans? b)
    {
        if (b == null)
        {
            WriteLiteral("<td class=\"mb-balance-cell\"><span class=\"mb-dept\">—</span></td>");
            return;
        }

        var istifade = b.IstifadeOlunanGun;
        WriteLiteral($@"<td class=""mb-balance-cell"">
            <div class=""mb-balance-nums"">
                <span class=""mb-qaliq mb-qaliq--green"">{istifade} gün</span>
            </div>
        </td>");
    }

    async Task RenderBalanceCell(MezuniyyetBalans? b)
    {
        if (b == null)
        {
            WriteLiteral("<td class=\"mb-balance-cell\"><span class=\"mb-dept\">—</span></td>");
            return;
        }

        var toplam = b.ToplamGun;
        var istifade = b.IstifadeOlunanGun;
        var qaliq = b.QaliqGun;
        var pct = toplam > 0 ? (int)Math.Round((double)qaliq / toplam * 100) : 0;

        string colorClass;
        if (toplam == 0) colorClass = "green";
        else if (pct > 50) colorClass = "green";
        else if (pct >= 20) colorClass = "yellow";
        else colorClass = "red";

        WriteLiteral($@"<td class=""mb-balance-cell"">
            <div class=""mb-balance-nums"">
                <span class=""mb-toplam"">{toplam}</span>
                <span class=""mb-istifade"">{istifade}</span>
                <span class=""mb-qaliq mb-qaliq--{colorClass}"" data-qaliq=""{qaliq}"" data-toplam=""{toplam}"">{qaliq}</span>
            </div>
            <div class=""mb-progress"">
                <div class=""mb-progress__bar mb-progress__bar--{colorClass}"" data-qaliq=""{qaliq}"" data-toplam=""{toplam}"" style=""width:{pct}%""></div>
            </div>
        </td>");
    }
}
