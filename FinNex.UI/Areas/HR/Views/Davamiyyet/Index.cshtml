@using FinNex.Application.DTOs.HR.Davamiyyet
@using FinNex.Domain.Entities.HR
@model IEnumerable<DavamiyyetListDto>
@{
    ViewData["Title"] = "Davamiyyət";
    Layout = "~/Areas/HR/Views/Shared/_HRLayout.cshtml";
}

<div class="page-container">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Davamiyyət İdarəetməsi</h1>
            <p class="page-subtitle">İşçilərin davamiyyət qeydləri</p>
        </div>
        <div class="header-actions">
            <input type="date" id="dateFilter" class="filter-date" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <select id="statusFilter" class="filter-select">
                <option value="">Bütün statuslar</option>
                <option value="0">İşdə</option>
                <option value="1">Gecikmə</option>
                <option value="2">Qayıb</option>
                <option value="3">Məzuniyyət</option>
                <option value="4">Xəstəlik</option>
            </select>
            <a asp-action="Create" class="btn-add">
                <i class="bi bi-plus-lg"></i> Yeni Qeyd
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon stat-green">

                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">İşdə</div>
                <div class="stat-value">@ViewBag.IsdeSayi</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-orange">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Gecikmə</div>
                <div class="stat-value">@ViewBag.GecikmeliSayi</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-red">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Qayıb</div>
                <div class="stat-value">@ViewBag.QayibSayi</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-purple">
                <i class="bi bi-card-checklist"></i>
            </div>
            <div class="stat-content">
                <div class="stat-label">Ümumi Qeyd</div>
                <div class="stat-value">@Model?.Count() ?? 0</div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>İşçi</th>
                    <th>Tarix</th>
                    <th>Giriş</th>
                    <th>Çıxış</th>
                    <th>İş Saatı</th>
                    <th>Status</th>
                    <th class="text-end">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="employee-cell">
                                    <div class="employee-avatar">@item.IsciTamAd.Substring(0, 2).ToUpper()</div>
                                    <div class="cell-main">@item.IsciTamAd</div>
                                </div>
                            </td>
                            <td>
                                <span class="date-text">@item.Tarix.ToString("dd.MM.yyyy")</span>
                            </td>
                            <td>
                                @if (item.GirisVaxti.HasValue)
                                {
                                    <span class="time-text">@item.GirisVaxti.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="no-data">--:--</span>
                                }
                            </td>
                            <td>
                                @if (item.CixisVaxti.HasValue)
                                {
                                    <span class="time-text">@item.CixisVaxti.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="no-data">--:--</span>
                                }
                            </td>
                            <td>
                                @if (item.GirisVaxti.HasValue && item.CixisVaxti.HasValue)
                                {
                                    var duration = item.CixisVaxti.Value - item.GirisVaxti.Value;
                                    <span class="duration-text">@duration.Hours saat @duration.Minutes dəq</span>
                                }
                                else
                                {
                                    <span class="no-data">---</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case DavamiyyetStatus.Isde:
                                        <span class="badge-success">İşdə</span>
                                        break;
                                    case DavamiyyetStatus.Gecikme:
                                        <span class="badge-warning">Gecikmə</span>
                                        break;
                                    case DavamiyyetStatus.Qayib:
                                        <span class="badge-danger">Qayıb</span>
                                        break;
                                    @* case DavamiyyetStatus.Mezuniyyet:
                                        <span class="badge-info">Məzuniyyət</span>
                                        break;
                                    case DavamiyyetStatus.Xestelik:
                                        <span class="badge-secondary">Xəstəlik</span>
                                        break; *@
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btns">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Bax">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Redaktə">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn-icon btn-delete" onclick="deleteDavamiyyet(@item.Id)" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>Heç bir davamiyyət qeydi tapılmadı</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/davamiyyet-list.css" />
}

@section Scripts {
    <script src="~/js/hr/davamiyyet-list.js"></script>
}