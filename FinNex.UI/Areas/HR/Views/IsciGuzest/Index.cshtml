@model List<FinNex.Domain.Entities.HR.IsciGuzest>
@{
    ViewData["Title"] = "İşçi güzəştləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var isciler = (List<FinNex.Domain.Entities.HR.Isci>)ViewBag.Isciler;
    var selectedIsciId = (int?)ViewBag.IsciId;
    var today = DateTime.Today;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="ig-page">
    <div class="ig-head">
        <div>
            <div class="ig-title">İşçi güzəştləri</div>
            <div class="ig-sub">Hər işçi üçün aktiv dövrü olan güzəştlərin ən böyüyü hesablamada istifadə olunur</div>
        </div>
        <a asp-action="Create" asp-route-isciId="@selectedIsciId" class="ig-btn ig-btn--primary">
            <i class="bi bi-plus-lg"></i> Yeni təyinat
        </a>
    </div>

    <form method="get" class="ig-filter">
        <label class="ig-filter-lbl">İşçi:</label>
        <select name="isciId" class="ig-select" onchange="this.form.submit()">
            <option value="">— Hamısı —</option>
            @foreach (var i in isciler)
            {
                <option value="@i.Id" selected="@(selectedIsciId == i.Id)">@i.TamAd</option>
            }
        </select>
    </form>

    <div class="ig-card">
        @if (!Model.Any())
        {
            <div class="ig-empty">
                <i class="bi bi-inbox"></i>
                <p>Təyinat tapılmadı</p>
            </div>
        }
        else
        {
            <table class="ig-table">
                <thead>
                    <tr>
                        <th>İşçi</th>
                        <th>Güzəşt</th>
                        <th class="ig-num">Məbləğ</th>
                        <th>Başlama</th>
                        <th>Bitmə</th>
                        <th>Status</th>
                        <th>Qeyd</th>
                        <th class="ig-act"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in Model)
                    {
                        bool aktivDovr = x.BaslamaTarixi <= today && (x.BitmeTarixi == null || x.BitmeTarixi >= today);
                        <tr>
                            <td><strong>@(x.Isci?.TamAd ?? "#" + x.IsciId)</strong></td>
                            <td>@(x.Guzest?.Ad ?? "#" + x.GuzestId)</td>
                            <td class="ig-num">@((x.Guzest?.Mebleg ?? 0).ToString("N2")) ₼</td>
                            <td>@x.BaslamaTarixi.ToString("dd.MM.yyyy")</td>
                            <td>@(x.BitmeTarixi?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>
                                @if (aktivDovr)
                                {
                                    <span class="ig-status ig-status--ok">Aktiv</span>
                                }
                                else if (x.BaslamaTarixi > today)
                                {
                                    <span class="ig-status ig-status--pending">Gözləyir</span>
                                }
                                else
                                {
                                    <span class="ig-status">Bitib</span>
                                }
                            </td>
                            <td class="ig-note">@(x.Qeyd ?? "—")</td>
                            <td class="ig-act">
                                <form asp-action="Delete" asp-route-id="@x.Id" method="post"
                                      style="display:inline" onsubmit="return confirm('Təyinatı silmək istəyirsiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ig-btn ig-btn--danger ig-btn--sm">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .ig-page { padding: 24px 28px; max-width: 1300px; margin: 0 auto; }
    .ig-head {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 18px;
    }
    .ig-title { font-size: 1.35rem; font-weight: 800; color: #1a1d29; }
    .ig-sub { font-size: 0.85rem; color: #8a93a8; margin-top: 2px; }

    .ig-filter {
        display: flex; gap: 10px; align-items: center;
        margin-bottom: 14px;
    }
    .ig-filter-lbl { font-size: 12px; font-weight: 700; color: #5a647a; }
    .ig-select {
        padding: 8px 12px; border: 1px solid #e2e6ef;
        border-radius: 8px; background: #fff;
        font-size: 13px; font-family: inherit;
        min-width: 260px;
    }

    .ig-card {
        background: #fff; border-radius: 14px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 18px rgba(15, 26, 46, .04);
        overflow-x: auto;
    }
    .ig-empty { padding: 50px; text-align: center; color: #8a93a8; }
    .ig-empty i { font-size: 48px; display: block; margin-bottom: 10px; }

    .ig-table { width: 100%; border-collapse: collapse; }
    .ig-table thead th {
        background: #f7f9fc; padding: 12px 16px;
        font-size: 11px; font-weight: 800;
        text-transform: uppercase;
        color: #5a647a; letter-spacing: .4px;
        border-bottom: 1px solid #eef0f5;
        text-align: left;
    }
    .ig-table td {
        padding: 12px 16px;
        border-bottom: 1px solid #f1f3f7;
        font-size: 13px; color: #1a2332;
    }
    .ig-table tbody tr:last-child td { border-bottom: none; }
    .ig-table .ig-num { text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
    .ig-table .ig-act { text-align: right; width: 60px; }
    .ig-table .ig-note { color: #5a647a; font-size: 12px; }

    .ig-status {
        display: inline-block; padding: 4px 10px;
        border-radius: 999px; font-size: 11px; font-weight: 700;
        background: #eef0f5; color: #5a647a;
    }
    .ig-status--ok { background: #d1fae5; color: #065f46; }
    .ig-status--pending { background: #fef3c7; color: #92400e; }

    .ig-btn {
        display: inline-flex; gap: 5px; align-items: center;
        padding: 9px 16px; border-radius: 9px;
        font-size: 13px; font-weight: 700;
        text-decoration: none; border: none; cursor: pointer;
        transition: all .15s; font-family: inherit;
    }
    .ig-btn--sm { padding: 6px 10px; font-size: 12px; }
    .ig-btn--primary { background: #7c3aed; color: #fff; }
    .ig-btn--primary:hover { background: #6b21a8; }
    .ig-btn--danger { background: #fff; color: #dc2626; border: 1px solid #fecaca; }
    .ig-btn--danger:hover { background: #fef2f2; }
</style>
