@{
    ViewData["Title"] = "HR Analitika";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/analytics.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">HR Analitika</div>
            <div class="fn-page-sub">İşçi statistikası və HR analitika paneli</div>
        </div>
    </div>

    <div id="anlLoading" class="anl-loading">
        <div class="anl-loading-spinner"></div>
        Məlumatlar yüklənir...
    </div>

    @* ── KPI Kartlari ─────────────────────────────────────── *@
    <div class="anl-kpi-grid" id="anlKpiGrid" style="display:none;">
        <div class="anl-kpi anl-kpi--blue">
            <div class="anl-kpi-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M3 18c0-4 3-6 7-6s7 2 7 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="anl-kpi-data">
                <div class="anl-kpi-value" id="kpiAktiv">0</div>
                <div class="anl-kpi-label">Aktiv İşçi</div>
            </div>
            <div class="anl-kpi-sub" id="kpiPassiv">0 passiv</div>
        </div>
        <div class="anl-kpi anl-kpi--purple">
            <div class="anl-kpi-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.2"/>
                    <circle cx="13" cy="7" r="3" stroke="currentColor" stroke-width="1.2"/>
                    <path d="M1 17c0-3 2.5-5 6-5s6 2 6 5M8 17c0-3 2.5-5 6-5s5 2 5 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="anl-kpi-data">
                <div class="anl-kpi-value" id="kpiGender">0 / 0</div>
                <div class="anl-kpi-label">Kişi / Qadın</div>
            </div>
            <div class="anl-kpi-sub" id="kpiGenderPct">0%</div>
        </div>
        <div class="anl-kpi anl-kpi--green">
            <div class="anl-kpi-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M10 6v4.5l3 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
            </div>
            <div class="anl-kpi-data">
                <div class="anl-kpi-value" id="kpiOrtaMuddet">0</div>
                <div class="anl-kpi-label">Orta İş Müddəti (ay)</div>
            </div>
            <div class="anl-kpi-sub">Aktiv işçilər üzrə</div>
        </div>
        <div class="anl-kpi anl-kpi--orange">
            <div class="anl-kpi-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M10 3l2.5 5 5.5.8-4 3.9.9 5.3-4.9-2.6L5.1 18l.9-5.3-4-3.9 5.5-.8L10 3z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="anl-kpi-data">
                <div class="anl-kpi-value" id="kpiDonusum">0%</div>
                <div class="anl-kpi-label">İşçi Dönüşüm Faizi</div>
            </div>
            <div class="anl-kpi-sub" id="kpiCixanlar">Son 12 ayda 0 çıxış</div>
        </div>
    </div>

    @* ── Charts ───────────────────────────────────────────── *@
    <div class="anl-charts" id="anlCharts" style="display:none;">
        <div class="fn-card anl-chart-card">
            <div class="fn-card-title">Departament üzrə İşçi Sayı</div>
            <canvas id="chartDepartament" height="280"></canvas>
        </div>
        <div class="fn-card anl-chart-card">
            <div class="fn-card-title">Gender Bölgüsü</div>
            <canvas id="chartGender" height="280"></canvas>
        </div>
    </div>

    <div class="anl-charts-full" id="anlChartsFull" style="display:none;">
        <div class="fn-card anl-chart-card">
            <div class="fn-card-title">Aylıq İşə Qəbul / Çıxış Trendi (Son 12 Ay)</div>
            <canvas id="chartTrend" height="300"></canvas>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        var analyticsDataUrl = '@Url.Action("GetAnalyticsData", "Analytics", new { area = "HR" })';
    </script>
    <script src="~/js/hr/analytics.js" asp-append-version="true"></script>
}
