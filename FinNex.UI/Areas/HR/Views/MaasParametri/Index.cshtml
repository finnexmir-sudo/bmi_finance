@model IEnumerable<FinNex.Domain.Entities.HR.MaasParametri>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Əmək haqqı parametrləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var all = Model.ToList();
    var pilleler = (ViewBag.VergiPilleleri as List<VergiPille>) ?? new List<VergiPille>();

    // Flat parametrlər (pilləli olmayan — yalnız İşsizlik və güzəştlər)
    MaasParametri? Flat(MaasParametrNovu n) => all.FirstOrDefault(x => x.Nov == n && x.Aktivdir);

    var issizlikIsci = Flat(MaasParametrNovu.IssizlikSigortasiFaizi);
    var issizlikIsv  = Flat(MaasParametrNovu.IssizlikIsegoturenFaizi);
    var minEmek      = Flat(MaasParametrNovu.MinimumEmekHaqqi);
    var vergiGuz     = Flat(MaasParametrNovu.VergiGuzestiMeblegi);
    var hysIsvFaiz   = Flat(MaasParametrNovu.HysIsegoturenFaizi);
    var hysMaxFaiz   = Flat(MaasParametrNovu.HysMaxMaasFaizi);
    var xstStaj8     = Flat(MaasParametrNovu.XestelikStaj8YasagidaFaizi);
    var xstStaj812   = Flat(MaasParametrNovu.XestelikStaj8_12IlFaizi);
    var xstStaj12    = Flat(MaasParametrNovu.XestelikStaj12YuxariFaizi);
    var xstDsmfEmsal = Flat(MaasParametrNovu.XestelikDsmfEmsali);

    List<VergiPille> Pilleler(MaasParametrNovu n) =>
        pilleler.Where(x => x.Nov == n && x.Aktivdir).OrderBy(x => x.Sira).ToList();

    string NovAd(MaasParametrNovu n) => n switch
    {
        MaasParametrNovu.GelirVergisiFaizi => "Gəlir Vergisi",
        MaasParametrNovu.DsmfFaizi => "DSMF",
        MaasParametrNovu.IssizlikSigortasiFaizi => "İşsizlik Sığortası",
        MaasParametrNovu.IcbariTibbiSigortaFaizi => "İcbari Tibbi Sığorta (İTSS)",
        MaasParametrNovu.MinimumEmekHaqqi => "Minimum Əmək Haqqı",
        MaasParametrNovu.VergiGuzestiMeblegi => "Vergi Güzəşti",
        MaasParametrNovu.DsmfIsegoturenFaizi => "DSMF",
        MaasParametrNovu.IssizlikIsegoturenFaizi => "İşsizlik Sığortası",
        MaasParametrNovu.IcbariTibbiSigortaIsegoturenFaizi => "İcbari Tibbi Sığorta (İTSS)",
        MaasParametrNovu.HysIsegoturenFaizi => "HYS İşəgötürən Faizi",
        MaasParametrNovu.HysMaxMaasFaizi => "HYS Max Maaş Faizi",
        MaasParametrNovu.XestelikStaj8YasagidaFaizi => "Xəstəlik: Staj < 8 il faizi",
        MaasParametrNovu.XestelikStaj8_12IlFaizi => "Xəstəlik: Staj 8–12 il faizi",
        MaasParametrNovu.XestelikStaj12YuxariFaizi => "Xəstəlik: Staj ≥ 12 il faizi",
        MaasParametrNovu.XestelikDsmfEmsali => "Xəstəlik: DSMF Əmsalı",
        _ => n.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/maas-parametri.css" asp-append-version="true" />
}

<div class="mp-page">
    @Html.AntiForgeryToken()

    @* ── Başlıq ─────────────────────────────────────────────── *@
    <div class="mp-header">
        <div>
            <h1 class="mp-title">Əmək haqqı parametrləri</h1>
            <p class="mp-subtitle">Vergi dərəcələri, sığorta faizləri, güzəştlər və HYS parametrləri</p>
        </div>
    </div>

    @* ── Bələdçi ──────────────────────────────────────────── *@
    <div class="mp-guide">
        <i class="bi bi-info-circle"></i>
        <div>
            <strong>Bu səhifədə 4 bölmə var:</strong>
            İşçidən tutulan vergilər, işəgötürən ödədikləri, güzəştlər və HYS.
            Pilləli vergilər üçün "Pillə", flat parametrlər üçün "Redaktə" düyməsini istifadə edin.
        </div>
    </div>

    @* ── Hesablama Mexanizmi (mərcəyi izahatı) ─────────────── *@
    <details class="mp-mexanizm">
        <summary class="mp-mexanizm-head">
            <i class="bi bi-diagram-3"></i>
            <span>Hesablama Mexanizmi — bütün düsturlar bir baxışda</span>
            <span class="mp-mexanizm-hint">(klik açmaq üçün)</span>
            <i class="bi bi-chevron-down mp-mexanizm-chevron"></i>
        </summary>
        <div class="mp-mexanizm-body">

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">1</span> Əsas Brüt (təbii brüt)</div>
                <div class="mp-mex-formula">
                    Əsas Brüt = Əsas maaş − Məz. kəsintisi + Məz. ödənişi + Xst. ödənişi − Xst. kəsintisi − Qayıb kəsintisi + Bonus + Fərqli gəlir − Cərimə
                </div>
                <div class="mp-mex-note">İşəgötürən HYS payı bura DAXİL DEYİL — yalnız bütün vergi bazaları hesablandıqdan sonra göstərilən "Brüt"-ə əlavə olunur.</div>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">2</span> Vergi bazaları (3 ayrı baza)</div>
                <table class="mp-mex-table">
                    <thead>
                        <tr><th>Tutulma</th><th>Baza düsturu</th><th>HYS işçi</th><th>HYS işəgötürən</th><th>Xəstəlik</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Gəlir vergisi</td>
                            <td><code>esasBrut − HYSişçi</code></td>
                            <td class="mp-mex-cross">azad</td>
                            <td class="mp-mex-cross">azad (yox)</td>
                            <td class="mp-mex-check">daxil</td>
                        </tr>
                        <tr>
                            <td>DSMF (işçi + işəgötürən)</td>
                            <td><code>esasBrut − HYSişçi − Xəstəlik</code></td>
                            <td class="mp-mex-cross">azad</td>
                            <td class="mp-mex-cross">azad (yox)</td>
                            <td class="mp-mex-cross">azad</td>
                        </tr>
                        <tr>
                            <td>İşsizlik (işçi + işəgötürən)</td>
                            <td><code>esasBrut + HYSişv − Xəstəlik</code></td>
                            <td class="mp-mex-check">daxil</td>
                            <td class="mp-mex-check">daxil</td>
                            <td class="mp-mex-cross">azad</td>
                        </tr>
                        <tr>
                            <td>İTSS (işçi + işəgötürən)</td>
                            <td><code>esasBrut + HYSişv − Xəstəlik</code></td>
                            <td class="mp-mex-check">daxil</td>
                            <td class="mp-mex-check">daxil</td>
                            <td class="mp-mex-cross">azad</td>
                        </tr>
                    </tbody>
                </table>
                <div class="mp-mex-note">
                    Standart 200 AZN güzəşti yalnız <strong>brüt birinci pillədə</strong> (≤ 2.500 AZN) tətbiq olunur. İşçi güzəşti də (varsa) gəlir vergisi bazasından çıxılır.
                </div>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">3</span> Məzuniyyət Ödənişi (per-gün dərəcəsi)</div>
                <div class="mp-mex-formula">
                    günlükMaaş = CariMaaş ÷ AyİşGün <br />
                    günlükMezPul = S(12 ay düzəlmiş) ÷ 12 ÷ 30.4 <br />
                    <strong>Ödəniş = MAX(günlükMaaş, günlükMezPul) × İGS</strong>
                </div>
                <div class="mp-mex-note">
                    İGS — məzuniyyətin iş günü sayı (PR #352 ilə həftəsonu daxil; yalnız MezuniyyetdeHesablanir=false olan bayramlar skip).
                    Kəsinti yalnız faktiki iş günü üzrə tutulur (həftəsonu skip), beləliklə işçi məzuniyyət üçün əlavə pul itirmir.
                </div>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">4</span> Xəstəlik Ödənişi (S − X) / (D − Y) düsturu</div>
                <div class="mp-mex-formula">
                    Bir gün = (S − X) ÷ (D − Y) × stajFaizi <br />
                    Şirkət ödənişi = Bir gün × min(bülletən_iş_günü, 14) <br />
                    DSMF ödənişi = Bir gün × qalan günlər
                </div>
                <div class="mp-mex-note">
                    S = son 12 ay qazancı, X = son 12 ay xəstəlik ödənişi, D = son 12 ay iş günü, Y = son 12 ay xəstəlik günü.
                    Staj faizi: aşağıdakı "Xəstəlik Ödənişi — Staj Faizləri" bölməsindən idarə olunur (default &lt;8 il→60%, 8–12 il→80%, ≥12 il→100%). Hər bülletən üçün max 14 iş günü şirkət ödəyir, qalanı DSMF.
                </div>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">5</span> Pilləli Tutulma Düsturu (DSMF, İTSS, Gəlir vergisi)</div>
                <div class="mp-mex-formula">
                    Tutulma = SabitMəbləğ + (məbləğ − AşağıHədd) × Faiz%
                </div>
                <div class="mp-mex-note">
                    Misal — DSMF: 0–200 AZN için 3%, 200+ üçün 6 + 10% × (məbləğ − 200).
                    Pillə cədvəlləri yuxarıdakı bölmələrdə "Pillə" düyməsi ilə idarə olunur.
                </div>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">6</span> Əlavə Gəlir Növləri</div>
                <ul class="mp-mex-list">
                    <li><strong>Bonus / Mükafat</strong> — brüt-ə daxil, tam vergiyə cəlb olunur (gəlir + DSMF + İşsizlik + İTSS)</li>
                    <li><strong>Fərqli Gəlir</strong> — bonus kimi davranır, ayrıca xəttdə uçotlanır</li>
                    <li><strong>Avans</strong> — brüt-ə daxil DEYİL, NET-dən çıxılır (artıq aldığı pul)</li>
                </ul>
            </div>

            <div class="mp-mex-section">
                <div class="mp-mex-title"><span class="mp-mex-num">7</span> NET Maaş</div>
                <div class="mp-mex-formula">
                    NET = Brüt − (Gəlir vergisi + DSMF işçi + İşsizlik işçi + İTSS işçi + HYS işçi + HYS işəgötürən + Avans)
                </div>
                <div class="mp-mex-note">HYS işəgötürən payı brüt-ə daxil edilib, sonra NET-dən çıxılır — beləliklə işçinin əlinə yatan məbləğ dəyişməz qalır, sadəcə HYS hesabına yönləndirilir.</div>
            </div>

        </div>
    </details>

    @{
        // Tax row helper — pilləli və flat növlər üçün universal renderer
        void RenderTaxRow(
            string ad,
            string icon,
            string colorClass,
            MaasParametrNovu nov,
            List<VergiPille> rowPilleler,
            MaasParametri? flatParam)
        {
            var isPilleli = rowPilleler.Any();

            <div class="mp-tax-row mp-tax-row--@colorClass">
                <div class="mp-tax-head">
                    <div class="mp-tax-icon"><i class="bi @icon"></i></div>
                    <div class="mp-tax-name">
                        <div class="mp-tax-name-text">@ad</div>
                        @if (isPilleli)
                        {
                            <span class="mp-tax-type mp-tax-type--pilleli">Pilləli</span>
                        }
                        else if (flatParam != null)
                        {
                            <span class="mp-tax-type mp-tax-type--flat">Flat</span>
                        }
                        else
                        {
                            <span class="mp-tax-type mp-tax-type--none">Konfiqurasiya yoxdur</span>
                        }
                    </div>
                    <div class="mp-tax-action">
                        @if (isPilleli)
                        {
                            <button class="mp-btn-mini" data-add-pille-nov="@((int)nov)">
                                <i class="bi bi-plus-lg"></i> Pillə
                            </button>
                        }
                        else if (flatParam != null)
                        {
                            <button class="mp-btn-mini" data-edit-id="@flatParam.Id">
                                <i class="bi bi-pencil-square"></i> Redaktə
                            </button>
                        }
                    </div>
                </div>

                <div class="mp-tax-body">
                    @if (isPilleli)
                    {
                        <table class="mp-bracket-table">
                            <thead>
                                <tr>
                                    <th style="width:36px;">#</th>
                                    <th>İnterval (₼)</th>
                                    <th>Düstur</th>
                                    <th style="width:80px;" class="mp-center">Status</th>
                                    <th style="width:80px;" class="mp-right"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in rowPilleler)
                                {
                                    var araliq = p.YuxariHedd.HasValue
                                        ? $"{p.AsagiHedd:N0} – {p.YuxariHedd:N0}"
                                        : $"{p.AsagiHedd:N0}+";
                                    <tr data-pille-id="@p.Id">
                                        <td class="mp-sira">@p.Sira</td>
                                        <td class="mp-araliq">@araliq</td>
                                        <td class="mp-formula">
                                            @if (p.SabitMebleg > 0)
                                            {
                                                <span class="mp-f-sabit">@p.SabitMebleg.ToString("N0") ₼</span>
                                                <span class="mp-f-plus">+</span>
                                            }
                                            <span class="mp-f-faiz">@p.Faiz.ToString("G29")%</span>
                                            @if (p.SabitMebleg > 0)
                                            {
                                                <span class="mp-f-note">(artan hissəyə)</span>
                                            }
                                        </td>
                                        <td class="mp-center">
                                            @if (p.Aktivdir)
                                            {
                                                <span class="mp-badge mp-badge--aktiv">Aktiv</span>
                                            }
                                            else
                                            {
                                                <span class="mp-badge mp-badge--deaktiv">Deaktiv</span>
                                            }
                                        </td>
                                        <td class="mp-right">
                                            <button class="mp-card-btn mp-card-btn--edit" data-edit-pille-id="@p.Id" title="Redaktə et">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="mp-card-btn mp-card-btn--delete" data-delete-pille-id="@p.Id" title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (flatParam != null)
                    {
                        <div class="mp-flat-value">
                            <span class="mp-flat-num">@flatParam.Deyer.ToString("G29")</span>
                            <span class="mp-flat-suffix">@(flatParam.Tip == MaasParametrTipi.Faiz ? "%" : "₼")</span>
                            <span class="mp-flat-note">bütün məbləğə</span>
                        </div>
                    }
                    else
                    {
                        <div class="mp-no-config">
                            <i class="bi bi-exclamation-triangle"></i>
                            Parametr təyin edilməyib — yeni pillə əlavə edin
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* ═══════════ BÖLMƏ 1: İŞÇİDƏN TUTULAN VERGİLƏR ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-person-dash"></i>
            <h2>İşçidən tutulan vergilər</h2>
            <span class="mp-section-sub">Bu məbləğlər işçinin gross maaşından tutulur</span>
        </div>

        @{
            RenderTaxRow(
                "Gəlir Vergisi",
                "bi-cash-stack",
                "green",
                MaasParametrNovu.GelirVergisiFaizi,
                Pilleler(MaasParametrNovu.GelirVergisiFaizi),
                null);

            RenderTaxRow(
                "DSMF (Sosial Sığorta)",
                "bi-shield-check",
                "blue",
                MaasParametrNovu.DsmfFaizi,
                Pilleler(MaasParametrNovu.DsmfFaizi),
                null);

            RenderTaxRow(
                "İcbari Tibbi Sığorta (İTSS)",
                "bi-heart-pulse",
                "teal",
                MaasParametrNovu.IcbariTibbiSigortaFaizi,
                Pilleler(MaasParametrNovu.IcbariTibbiSigortaFaizi),
                null);

            RenderTaxRow(
                "İşsizlikdən Sığorta",
                "bi-umbrella",
                "indigo",
                MaasParametrNovu.IssizlikSigortasiFaizi,
                Pilleler(MaasParametrNovu.IssizlikSigortasiFaizi),
                issizlikIsci);
        }
    </div>

    @* ═══════════ BÖLMƏ 2: İŞƏGÖTÜRƏN ÖDƏDİKLƏRİ ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-building"></i>
            <h2>Şirkət tərəfindən ödənilir</h2>
            <span class="mp-section-sub">İşçinin maaşından tutulmur, şirkətin xərcidir</span>
        </div>

        @{
            RenderTaxRow(
                "DSMF (Sosial Sığorta)",
                "bi-shield-check",
                "purple",
                MaasParametrNovu.DsmfIsegoturenFaizi,
                Pilleler(MaasParametrNovu.DsmfIsegoturenFaizi),
                null);

            RenderTaxRow(
                "İcbari Tibbi Sığorta (İTSS)",
                "bi-heart-pulse",
                "orange",
                MaasParametrNovu.IcbariTibbiSigortaIsegoturenFaizi,
                Pilleler(MaasParametrNovu.IcbariTibbiSigortaIsegoturenFaizi),
                null);

            RenderTaxRow(
                "İşsizlikdən Sığorta",
                "bi-umbrella",
                "gray",
                MaasParametrNovu.IssizlikIsegoturenFaizi,
                Pilleler(MaasParametrNovu.IssizlikIsegoturenFaizi),
                issizlikIsv);
        }
    </div>

    @* ═══════════ BÖLMƏ 3: GÜZƏŞTLƏR VƏ ƏN AZ MAAŞ ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-gift"></i>
            <h2>Güzəştlər və minimum dəyərlər</h2>
            <span class="mp-section-sub">Vergi hesablanmadan əvvəl çıxılan güzəşt və dövlət minimum maaşı</span>
        </div>

        <div class="mp-guzesht-grid">
            @if (minEmek != null)
            {
                <div class="mp-guzesht-card">
                    <div class="mp-guzesht-head">
                        <i class="bi bi-currency-exchange"></i>
                        <div>
                            <div class="mp-guzesht-name">Minimum Əmək Haqqı</div>
                            <div class="mp-guzesht-desc">Dövlət tərəfindən təyin olunmuş minimum</div>
                        </div>
                        <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@minEmek.Id">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>
                    <div class="mp-guzesht-value">
                        <span class="mp-guzesht-num">@minEmek.Deyer.ToString("N0")</span>
                        <span class="mp-guzesht-suffix">₼</span>
                    </div>
                </div>
            }
            @if (vergiGuz != null)
            {
                <div class="mp-guzesht-card">
                    <div class="mp-guzesht-head">
                        <i class="bi bi-percent"></i>
                        <div>
                            <div class="mp-guzesht-name">Vergi Güzəşti</div>
                            <div class="mp-guzesht-desc">Gross məbləğdən vergi hesablanmadan çıxılır</div>
                        </div>
                        <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@vergiGuz.Id">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>
                    <div class="mp-guzesht-value">
                        <span class="mp-guzesht-num">@vergiGuz.Deyer.ToString("N0")</span>
                        <span class="mp-guzesht-suffix">₼</span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ═══════════ BÖLMƏ 4: HYS PARAMETRLƏRİ ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-shield-plus"></i>
            <h2>Həyat Yığım Sığortası (HYS)</h2>
            <span class="mp-section-sub">İşəgötürən payı və maaşdan max tutulma faizi</span>
        </div>

        <div class="mp-guzesht-grid">
            @if (hysIsvFaiz != null)
            {
                <div class="mp-guzesht-card">
                    <div class="mp-guzesht-head">
                        <i class="bi bi-building"></i>
                        <div>
                            <div class="mp-guzesht-name">İşəgötürən HYS Faizi</div>
                            <div class="mp-guzesht-desc">İşçinin HYS məbləğinin neçə %-ni şirkət ödəyir</div>
                        </div>
                        <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@hysIsvFaiz.Id">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>
                    <div class="mp-guzesht-value">
                        <span class="mp-guzesht-num">@hysIsvFaiz.Deyer.ToString("G29")</span>
                        <span class="mp-guzesht-suffix">%</span>
                    </div>
                </div>
            }
            @if (hysMaxFaiz != null)
            {
                <div class="mp-guzesht-card">
                    <div class="mp-guzesht-head">
                        <i class="bi bi-sliders2"></i>
                        <div>
                            <div class="mp-guzesht-name">Max HYS / Maaş Faizi</div>
                            <div class="mp-guzesht-desc">Maaşın max neçə %-i HYS ola bilər</div>
                        </div>
                        <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@hysMaxFaiz.Id">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    </div>
                    <div class="mp-guzesht-value">
                        <span class="mp-guzesht-num">@hysMaxFaiz.Deyer.ToString("G29")</span>
                        <span class="mp-guzesht-suffix">%</span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ═══════════ BÖLMƏ 5: XƏSTƏLİK STAJ FAİZLƏRİ ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-bandaid"></i>
            <h2>Xəstəlik Ödənişi — Staj Faizləri</h2>
            <span class="mp-section-sub">Xəstəlik bülletənində bir günlük ödənişin staja görə neçə faizi şirkət ödəyir</span>
        </div>

        <div class="mp-guzesht-grid">
            @{
                void RenderStajCard(string ad, string desc, MaasParametri? p, MaasParametrNovu nov, decimal defaultFaiz)
                {
                    <div class="mp-guzesht-card">
                        <div class="mp-guzesht-head">
                            <i class="bi bi-percent"></i>
                            <div>
                                <div class="mp-guzesht-name">@ad</div>
                                <div class="mp-guzesht-desc">@desc</div>
                            </div>
                            @if (p != null)
                            {
                                <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@p.Id">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                            else
                            {
                                <button class="mp-card-btn mp-card-btn--edit"
                                        data-create-nov="@((int)nov)"
                                        data-create-deyer="@defaultFaiz.ToString("G29")"
                                        title="Yarat">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            }
                        </div>
                        <div class="mp-guzesht-value">
                            <span class="mp-guzesht-num">@(p?.Deyer.ToString("G29") ?? defaultFaiz.ToString("G29"))</span>
                            <span class="mp-guzesht-suffix">%</span>
                        </div>
                        @if (p == null)
                        {
                            <div class="mp-guzesht-desc" style="margin-top:8px;color:#999;font-size:11px;">
                                (default — DB-də qeyd yoxdur)
                            </div>
                        }
                    </div>
                }

                RenderStajCard("Staj &lt; 8 il", "8 ildən az iş stajı olan işçi üçün", xstStaj8, MaasParametrNovu.XestelikStaj8YasagidaFaizi, 60m);
                RenderStajCard("Staj 8 – 12 il", "8 il (daxil) – 12 il (xaric) stajı olan işçi üçün", xstStaj812, MaasParametrNovu.XestelikStaj8_12IlFaizi, 80m);
                RenderStajCard("Staj ≥ 12 il", "12 il və daha çox stajı olan işçi üçün", xstStaj12, MaasParametrNovu.XestelikStaj12YuxariFaizi, 100m);
            }
        </div>
    </div>

    @* ═══════════ BÖLMƏ 6: XƏSTƏLİK ÖDƏNİŞ DÜSTURU (DSMF ƏMSALI) ═══════════ *@
    <div class="mp-section">
        <div class="mp-section-head">
            <i class="bi bi-calculator"></i>
            <h2>Xəstəlik Ödənişi — DSMF Əmsalı</h2>
            <span class="mp-section-sub">Yeni düstur (May 2026+): GünlükPul = ((Σ DSMF işçi + Σ DSMF şirkət) × Əmsal) ÷ (son 12 ay təqvim günü − xəstəlik təqvim günü)</span>
        </div>

        <div class="mp-guzesht-grid">
            <div class="mp-guzesht-card">
                <div class="mp-guzesht-head">
                    <i class="bi bi-asterisk"></i>
                    <div>
                        <div class="mp-guzesht-name">DSMF Əmsalı</div>
                        <div class="mp-guzesht-desc">Son 12 ay DSMF cəmi neçə dəfəyə vurulur (default 4)</div>
                    </div>
                    @if (xstDsmfEmsal != null)
                    {
                        <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@xstDsmfEmsal.Id">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                    }
                    else
                    {
                        <button class="mp-card-btn mp-card-btn--edit"
                                data-create-nov="@((int)MaasParametrNovu.XestelikDsmfEmsali)"
                                data-create-deyer="4"
                                title="Yarat">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    }
                </div>
                <div class="mp-guzesht-value">
                    <span class="mp-guzesht-num">@(xstDsmfEmsal?.Deyer.ToString("G29") ?? "4")</span>
                    <span class="mp-guzesht-suffix">×</span>
                </div>
                @if (xstDsmfEmsal == null)
                {
                    <div class="mp-guzesht-desc" style="margin-top:8px;color:#999;font-size:11px;">
                        (default — DB-də qeyd yoxdur)
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Flat parametr modal ── *@
    <div id="mpModalOverlay" class="mp-modal-overlay">
        <div class="mp-modal">
            <div class="mp-modal-header">
                <h3 id="mpModalTitle">Parametri Redaktə Et</h3>
                <button class="mp-modal-close" id="mpCloseBtn">&times;</button>
            </div>
            <div class="mp-modal-body">
                <form id="mpForm">
                    <input type="hidden" id="mpId" />

                    <div class="mp-form-group">
                        <label for="mpNov">Parametr Növü</label>
                        <select id="mpNov" class="mp-form-control">
                            <option value="3">İşsizlik Sığortası (İşçi)</option>
                            <option value="5">Minimum Əmək Haqqı</option>
                            <option value="6">Vergi Güzəşti Məbləği</option>
                            <option value="8">İşsizlik Sığortası (İşəgötürən)</option>
                            <option value="10">HYS İşəgötürən Faizi</option>
                            <option value="11">HYS Max Maaş Faizi</option>
                            <option value="14">Xəstəlik: Staj &lt; 8 il faizi</option>
                            <option value="15">Xəstəlik: Staj 8–12 il faizi</option>
                            <option value="16">Xəstəlik: Staj ≥ 12 il faizi</option>
                            <option value="17">Xəstəlik: DSMF Əmsalı</option>
                        </select>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpDeyer">Dəyər</label>
                            <div class="mp-value-input-wrap">
                                <input type="number" id="mpDeyer" class="mp-form-control" step="0.01" min="0.01" placeholder="0.00" />
                                <span id="mpDeyerSuffix" class="mp-value-suffix">%</span>
                            </div>
                        </div>
                        <div class="mp-form-group">
                            <label for="mpTip">Tip</label>
                            <select id="mpTip" class="mp-form-control">
                                <option value="1">Faiz (%)</option>
                                <option value="2">Məbləğ (&#x20BC;)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpBaslamaTarixi">Başlama Tarixi</label>
                            <input type="date" id="mpBaslamaTarixi" class="mp-form-control" />
                        </div>
                        <div class="mp-form-group">
                            <label for="mpBitmeTarixi">Bitmə Tarixi</label>
                            <input type="date" id="mpBitmeTarixi" class="mp-form-control" />
                        </div>
                    </div>

                    <div class="mp-form-group">
                        <label for="mpAciqlama">Açıqlama</label>
                        <input type="text" id="mpAciqlama" class="mp-form-control" placeholder="Əlavə qeyd..." />
                    </div>

                    <div id="mpAktivdirWrap" class="mp-form-group mp-form-check" style="display:none;">
                        <input type="checkbox" id="mpAktivdir" checked />
                        <label for="mpAktivdir">Aktivdir</label>
                    </div>
                </form>
            </div>
            <div class="mp-modal-footer">
                <button class="mp-btn-secondary" id="mpCancelBtn">Ləğv et</button>
                <button id="mpSaveBtn" class="mp-btn-save">
                    <i class="bi bi-check-lg"></i> Yadda saxla
                </button>
            </div>
        </div>
    </div>

    @* ── Pillə modal ── *@
    <div id="mpPilleModalOverlay" class="mp-modal-overlay">
        <div class="mp-modal">
            <div class="mp-modal-header">
                <h3 id="mpPilleModalTitle">Yeni Pillə</h3>
                <button class="mp-modal-close" id="mpPilleCloseBtn">&times;</button>
            </div>
            <div class="mp-modal-body">
                <form id="mpPilleForm">
                    <input type="hidden" id="mpPilleId" />

                    <div class="mp-form-group">
                        <label for="mpPilleNov">Vergi Növü</label>
                        <select id="mpPilleNov" class="mp-form-control">
                            <option value="1">Gəlir Vergisi</option>
                            <option value="2">DSMF (İşçi)</option>
                            <option value="4">İTSS (İşçi)</option>
                            <option value="7">DSMF (İşəgötürən)</option>
                            <option value="9">İTSS (İşəgötürən)</option>
                        </select>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpPilleSira">Sıra nömrəsi <span class="mp-label-hint">(1-dən başlayır)</span></label>
                            <input type="number" id="mpPilleSira" class="mp-form-control" min="1" value="1" />
                        </div>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpPilleAsagi">Aşağı hədd (₼)</label>
                            <input type="number" id="mpPilleAsagi" class="mp-form-control" step="0.01" min="0" placeholder="0" />
                        </div>
                        <div class="mp-form-group">
                            <label for="mpPilleYuxari">Yuxarı hədd (₼) <span class="mp-label-hint">(boş = sonsuz)</span></label>
                            <input type="number" id="mpPilleYuxari" class="mp-form-control" step="0.01" min="0" placeholder="sonsuz" />
                        </div>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpPilleSabit">Sabit məbləğ (₼) <span class="mp-label-hint">(əvvəlki pillələrdən)</span></label>
                            <input type="number" id="mpPilleSabit" class="mp-form-control" step="0.01" min="0" value="0" />
                        </div>
                        <div class="mp-form-group">
                            <label for="mpPilleFaiz">Faiz (%)</label>
                            <input type="number" id="mpPilleFaiz" class="mp-form-control" step="0.01" min="0" placeholder="0" />
                        </div>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpPilleBaslama">Başlama Tarixi</label>
                            <input type="date" id="mpPilleBaslama" class="mp-form-control" />
                        </div>
                        <div class="mp-form-group">
                            <label for="mpPilleBitme">Bitmə Tarixi <span class="mp-label-hint">(istəğə bağlı)</span></label>
                            <input type="date" id="mpPilleBitme" class="mp-form-control" />
                        </div>
                    </div>

                    <div class="mp-form-group">
                        <label for="mpPilleAciqlama">Açıqlama</label>
                        <input type="text" id="mpPilleAciqlama" class="mp-form-control" placeholder="məs: 2027 yeni qayda" />
                    </div>

                    <div id="mpPilleAktivdirWrap" class="mp-form-group mp-form-check" style="display:none;">
                        <input type="checkbox" id="mpPilleAktivdir" checked />
                        <label for="mpPilleAktivdir">Aktivdir</label>
                    </div>
                </form>
            </div>
            <div class="mp-modal-footer">
                <button class="mp-btn-secondary" id="mpPilleCancelBtn">Ləğv et</button>
                <button id="mpPilleSaveBtn" class="mp-btn-save">
                    <i class="bi bi-check-lg"></i> Yadda saxla
                </button>
            </div>
        </div>
    </div>

    <div class="mp-toast" id="mpToast"><span id="mpToastMsg"></span></div>
</div>

@section Scripts {
    <script src="~/js/hr/maas-parametri.js" asp-append-version="true"></script>
}
