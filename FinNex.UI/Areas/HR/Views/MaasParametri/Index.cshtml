@model IEnumerable<FinNex.Domain.Entities.HR.MaasParametri>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Əmək haqqı parametrləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var all = Model.ToList();

    var tutulmalar = all.Where(x =>
        x.Nov == MaasParametrNovu.GelirVergisiFaizi ||
        x.Nov == MaasParametrNovu.DsmfFaizi ||
        x.Nov == MaasParametrNovu.IssizlikSigortasiFaizi ||
        x.Nov == MaasParametrNovu.IcbariTibbiSigortaFaizi).ToList();

    var guzeshtler = all.Where(x =>
        x.Nov == MaasParametrNovu.VergiGuzestiMeblegi ||
        x.Nov == MaasParametrNovu.MinimumEmekHaqqi).ToList();

    var isegoturenler = all.Where(x =>
        x.Nov == MaasParametrNovu.DsmfIsegoturenFaizi ||
        x.Nov == MaasParametrNovu.IssizlikIsegoturenFaizi).ToList();

    string NovAd(MaasParametrNovu n) => n switch
    {
        MaasParametrNovu.GelirVergisiFaizi => "Gəlir Vergisi",
        MaasParametrNovu.DsmfFaizi => "DSMF (İşçi)",
        MaasParametrNovu.IssizlikSigortasiFaizi => "İşsizlik Sığortası (İşçi)",
        MaasParametrNovu.IcbariTibbiSigortaFaizi => "İTSS",
        MaasParametrNovu.MinimumEmekHaqqi => "Minimum Əmək Haqqı",
        MaasParametrNovu.VergiGuzestiMeblegi => "Vergi Güzəşti",
        MaasParametrNovu.DsmfIsegoturenFaizi => "DSMF (İşəgötürən)",
        MaasParametrNovu.IssizlikIsegoturenFaizi => "İşsizlik (İşəgötürən)",
        _ => n.ToString()
    };

    string DeyerFormat(MaasParametri p) =>
        p.Tip == MaasParametrTipi.Faiz ? $"{p.Deyer:G29}" : $"{p.Deyer:N2}";

    string Suffix(MaasParametri p) =>
        p.Tip == MaasParametrTipi.Faiz ? "%" : "\u20BC";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/maas-parametri.css" asp-append-version="true" />
}

<div class="mp-page">
    @Html.AntiForgeryToken()

    <div class="mp-header">
        <div>
            <h1 class="mp-title">Əmək haqqı parametrləri</h1>
            <p class="mp-subtitle">Vergi, sığorta və güzəşt dərəcələrinin idarəsi</p>
        </div>
        <button class="mp-btn-primary" id="mpOpenCreate">
            <i class="bi bi-plus-lg"></i> Yeni parametr
        </button>
    </div>

    @{
        void RenderGroup(string title, string icon, string colorClass, List<MaasParametri> items)
        {
            <div class="mp-group mp-group--@colorClass">
                <div class="mp-group-header">
                    <i class="bi @icon"></i>
                    <h2>@title</h2>
                    <span class="mp-group-count">@items.Count parametr</span>
                </div>
                <div class="mp-cards">
                    @if (!items.Any())
                    {
                        <div class="mp-empty"><i class="bi bi-inbox"></i> Bu qrupda parametr yoxdur.</div>
                    }
                    @foreach (var p in items)
                    {
                        <div class="mp-card" data-id="@p.Id">
                            <div class="mp-card-top">
                                <div class="mp-card-name">@NovAd(p.Nov)</div>
                                <div class="mp-card-actions">
                                    <button class="mp-card-btn mp-card-btn--edit" data-edit-id="@p.Id" title="Redaktə et">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="mp-card-btn mp-card-btn--delete" data-delete-id="@p.Id" title="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="mp-card-value">
                                <span class="mp-card-num">@DeyerFormat(p)</span>
                                <span class="mp-card-suffix">@Suffix(p)</span>
                            </div>
                            <div class="mp-card-meta">
                                <span><i class="bi bi-calendar3"></i> @p.BaslamaTarixi.ToString("dd.MM.yyyy")</span>
                                @if (p.Aktivdir)
                                {
                                    <span class="mp-badge mp-badge--aktiv">Aktiv</span>
                                }
                                else
                                {
                                    <span class="mp-badge mp-badge--deaktiv">Deaktiv</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Aciqlama))
                            {
                                <div class="mp-card-desc">@p.Aciqlama</div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        RenderGroup("İşçi Tutulmaları", "bi-person-dash", "blue", tutulmalar);
        RenderGroup("Güzəştlər", "bi-gift", "gold", guzeshtler);
        RenderGroup("İşəgötürən Payı", "bi-building", "purple", isegoturenler);
    }

    <!-- Modal -->
    <div id="mpModalOverlay" class="mp-modal-overlay">
        <div class="mp-modal">
            <div class="mp-modal-header">
                <h3 id="mpModalTitle">Yeni Parametr</h3>
                <button class="mp-modal-close" id="mpCloseBtn">&times;</button>
            </div>
            <div class="mp-modal-body">
                <form id="mpForm">
                    <input type="hidden" id="mpId" />

                    <div class="mp-form-group">
                        <label for="mpNov">Parametr Növü</label>
                        <select id="mpNov" class="mp-form-control">
                            <option value="0" disabled selected>-- Seçin --</option>
                            <option value="1">Gəlir Vergisi Faizi</option>
                            <option value="2">DSMF Faizi (İşçi)</option>
                            <option value="3">İşsizlik Sığortası Faizi (İşçi)</option>
                            <option value="4">İTSS Faizi</option>
                            <option value="5">Minimum Əmək Haqqı</option>
                            <option value="6">Vergi Güzəşti Məbləği</option>
                            <option value="7">DSMF Faizi (İşəgötürən)</option>
                            <option value="8">İşsizlik Sığortası Faizi (İşəgötürən)</option>
                        </select>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpDeyer">Dəyər</label>
                            <div class="mp-value-input-wrap">
                                <input type="number" id="mpDeyer" class="mp-form-control" step="0.01" min="0.01" placeholder="0.00" />
                                <span id="mpDeyerSuffix" class="mp-value-suffix">%</span>
                            </div>
                        </div>
                        <div class="mp-form-group">
                            <label for="mpTip">Tip</label>
                            <select id="mpTip" class="mp-form-control">
                                <option value="1">Faiz (%)</option>
                                <option value="2">Məbləğ (&#x20BC;)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mp-form-row">
                        <div class="mp-form-group">
                            <label for="mpBaslamaTarixi">Başlama Tarixi</label>
                            <input type="date" id="mpBaslamaTarixi" class="mp-form-control" />
                        </div>
                        <div class="mp-form-group">
                            <label for="mpBitmeTarixi">Bitmə Tarixi</label>
                            <input type="date" id="mpBitmeTarixi" class="mp-form-control" />
                        </div>
                    </div>

                    <div class="mp-form-group">
                        <label for="mpAciqlama">Açıqlama</label>
                        <input type="text" id="mpAciqlama" class="mp-form-control" placeholder="Əlavə qeyd..." />
                    </div>

                    <div id="mpAktivdirWrap" class="mp-form-group mp-form-check" style="display:none;">
                        <input type="checkbox" id="mpAktivdir" checked />
                        <label for="mpAktivdir">Aktivdir</label>
                    </div>
                </form>
            </div>
            <div class="mp-modal-footer">
                <button class="mp-btn-secondary" id="mpCancelBtn">Ləğv et</button>
                <button id="mpSaveBtn" class="mp-btn-save">
                    <i class="bi bi-check-lg"></i> Yadda saxla
                </button>
            </div>
        </div>
    </div>

    <div class="mp-toast" id="mpToast"><span id="mpToastMsg"></span></div>
</div>

@section Scripts {
    <script src="~/js/hr/maas-parametri.js" asp-append-version="true"></script>
}
