@model List<FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetListDto>
@using FinNex.Domain.Entities.HR
@using FinNex.Application.Common.Extensions
@{
    ViewData["Title"] = "Aktiv Məzuniyyətlər";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var qabaqcaGun = (int)(ViewBag.QabaqcaGun ?? 30);
    var bugun = DateTime.Today;

    var hazirda = Model.Count(x => x.BaslamaTarixi.Date <= bugun && x.BitmeTarixi.Date >= bugun);
    var buHefte = Model.Count(x => x.BaslamaTarixi.Date > bugun && x.BaslamaTarixi.Date <= bugun.AddDays(7));
    var yaxinlarda = Model.Count(x => x.BaslamaTarixi.Date > bugun.AddDays(7));

    string NovRengi(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "#1e9b6b",
        MezuniyyetNovu.Xestelik => "#a855f7",
        MezuniyyetNovu.Ezamiyyet => "#f97316",
        _ => "#64748b"
    };
    string NovBg(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "#f0fdf4",
        MezuniyyetNovu.Xestelik => "#faf5ff",
        MezuniyyetNovu.Ezamiyyet => "#fff7ed",
        _ => "#f1f5f9"
    };
    string NovText(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "Əmək məzuniyyəti",
        MezuniyyetNovu.Xestelik => "Xəstəlik",
        MezuniyyetNovu.Ezamiyyet => "Ezamiyyət",
        _ => n.Adi()
    };

    int GunHesabla(DateTime from, DateTime to) => Math.Max(0, (to.Date - from.Date).Days);

    (string text, string reng, string bg) VeziyyetBadge(DateTime bas, DateTime bit)
    {
        if (bas.Date <= bugun && bit.Date >= bugun)
        {
            var qalan = GunHesabla(bugun, bit);
            if (qalan == 0) return ("Bu gün bitir", "#dc2626", "#fef2f2");
            if (qalan <= 2) return ($"{qalan} gün qalıb", "#dc2626", "#fef2f2");
            return ("Məzuniyyətdə", "#2563eb", "#eff6ff");
        }
        var qalanGun = GunHesabla(bugun, bas);
        if (qalanGun == 1) return ("Sabah", "#f59e0b", "#fffbeb");
        if (qalanGun <= 7) return ($"{qalanGun} gün", "#f59e0b", "#fffbeb");
        return ($"{qalanGun} gün", "#64748b", "#f1f5f9");
    }
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Aktiv Məzuniyyətlər</div>
            <div class="fn-page-sub">Hazırda məzuniyyətdə olan və yaxın günlərdə başlayacaq işçilər</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a asp-action="Aktiv" asp-route-qabaqcaGun="7"
               class="fn-btn @(qabaqcaGun == 7 ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">Bu həftə</a>
            <a asp-action="Aktiv" asp-route-qabaqcaGun="30"
               class="fn-btn @(qabaqcaGun == 30 ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">30 gün</a>
            <a asp-action="Aktiv" asp-route-qabaqcaGun="90"
               class="fn-btn @(qabaqcaGun == 90 ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">90 gün</a>
            <a asp-action="Hr" class="fn-btn fn-btn--outline">← Müraciətlər</a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="fn-alert fn-alert--success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div> }

    @* ═══════ Statistika — kompakt zolaq ═══════ *@
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px">
        <div class="fn-card" style="padding:12px 14px;border-left:3px solid #2563eb">
            <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:.5px">Hazırda məzuniyyətdə</div>
            <div style="font-size:22px;font-weight:800;color:#0f172a;margin-top:2px">@hazirda</div>
        </div>
        <div class="fn-card" style="padding:12px 14px;border-left:3px solid #f59e0b">
            <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:.5px">Bu həftə başlayacaq</div>
            <div style="font-size:22px;font-weight:800;color:#0f172a;margin-top:2px">@buHefte</div>
        </div>
        <div class="fn-card" style="padding:12px 14px;border-left:3px solid #64748b">
            <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:.5px">Yaxın @qabaqcaGun gündə</div>
            <div style="font-size:22px;font-weight:800;color:#0f172a;margin-top:2px">@yaxinlarda</div>
        </div>
        <div class="fn-card" style="padding:12px 14px;border-left:3px solid #16a34a">
            <div style="font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:.5px">Cəmi izlənilir</div>
            <div style="font-size:22px;font-weight:800;color:#0f172a;margin-top:2px">@Model.Count</div>
        </div>
    </div>

    @* Axtarış + növ filtri *@
    <div style="display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap">
        <div style="flex:1;min-width:240px">
            <input type="text" id="mezSearch" class="fn-input" placeholder="İşçi, şöbə və ya vəzifə ilə axtar..." />
        </div>
        <select id="novFilter" class="fn-input" style="max-width:180px">
            <option value="">Bütün növlər</option>
            <option value="@((int)MezuniyyetNovu.Illik)">Əmək məzuniyyəti</option>
            <option value="@((int)MezuniyyetNovu.Xestelik)">Xəstəlik</option>
            <option value="@((int)MezuniyyetNovu.Ezamiyyet)">Ezamiyyət</option>
        </select>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Aktiv məzuniyyət yoxdur</div>
            <div class="fn-empty-sub">Hazırda heç kim məzuniyyətdə deyil və yaxın @qabaqcaGun gündə də başlayacaq yoxdur</div>
        </div>
    }
    else
    {
        @* ═══════ TƏK DATAGRID ═══════ *@
        <div class="fn-card" style="padding:0;overflow:hidden">
            <table class="km-table" id="aktivGrid">
                <thead>
                    <tr>
                        <th style="width:130px">Vəziyyət</th>
                        <th>İşçi</th>
                        <th>Şöbə / Vəzifə</th>
                        <th style="width:90px">Növ</th>
                        <th style="width:180px">Məzuniyyət dövrü</th>
                        <th style="width:70px;text-align:center">Gün</th>
                        <th style="width:100px">Əmr №</th>
                        <th style="width:160px">Əvəzedici</th>
                        <th style="width:70px;text-align:right"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.OrderBy(x => x.BaslamaTarixi))
                    {
                        var v = VeziyyetBadge(m.BaslamaTarixi, m.BitmeTarixi);
                        var aktiv = m.BaslamaTarixi.Date <= bugun && m.BitmeTarixi.Date >= bugun;
                        <tr class="km-row" data-nov="@((int)m.Nov)" data-search="@(m.IsciAdSoyad) @(m.SobeAdi) @(m.VezifeAdi)">
                            <td>
                                <span style="display:inline-block;padding:3px 10px;border-radius:10px;background:@v.bg;color:@v.reng;font-size:11px;font-weight:700;white-space:nowrap">
                                    @v.text
                                </span>
                            </td>
                            <td class="km-td-name">@m.IsciAdSoyad</td>
                            <td>
                                <div style="font-size:12px;color:#0f172a">@m.SobeAdi</div>
                                <div style="font-size:10px;color:#94a3b8">@m.VezifeAdi</div>
                            </td>
                            <td>
                                <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:@NovBg(m.Nov);color:@NovRengi(m.Nov)">@NovText(m.Nov)</span>
                            </td>
                            <td style="font-size:12px;color:#475569">
                                @m.BaslamaTarixi.ToString("dd.MM.yyyy") – @m.BitmeTarixi.ToString("dd.MM.yyyy")
                                @if (aktiv)
                                {
                                    var umumi = GunHesabla(m.BaslamaTarixi, m.BitmeTarixi);
                                    var qalan = GunHesabla(bugun, m.BitmeTarixi);
                                    var progres = umumi > 0 ? Math.Clamp((int)Math.Round((double)(umumi - qalan) / umumi * 100), 0, 100) : 0;
                                    <div style="height:3px;background:#f1f5f9;border-radius:2px;margin-top:4px;overflow:hidden">
                                        <div style="height:100%;background:@NovRengi(m.Nov);width:@(progres)%"></div>
                                    </div>
                                }
                            </td>
                            <td style="text-align:center;font-weight:700;color:#0f172a">@m.IsGunlerininSayi</td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.EmrNomresi))
                                {
                                    <span style="font-family:monospace;font-size:11px;font-weight:700;color:#1e40af;background:#eff6ff;padding:2px 6px;border-radius:4px">@m.EmrNomresi</span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1;font-size:11px">—</span>
                                }
                            </td>
                            <td style="font-size:11px;color:#475569">@(m.EvezEdenIsciAdSoyad ?? "—")</td>
                            <td style="text-align:right">
                                <a asp-action="Detal" asp-route-id="@m.Id" asp-route-returnAction="Aktiv" class="km-detail-btn">Bax</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}

@section Scripts {
<script>
    (function () {
        var search = document.getElementById('mezSearch');
        var novFilter = document.getElementById('novFilter');
        var rows = document.querySelectorAll('#aktivGrid tbody tr');

        function tetbiq() {
            var t = (search.value || '').toLowerCase();
            var n = novFilter.value;
            rows.forEach(function (r) {
                var txtMatch = !t || (r.getAttribute('data-search') || '').toLowerCase().indexOf(t) >= 0;
                var novMatch = !n || r.getAttribute('data-nov') === n;
                r.style.display = (txtMatch && novMatch) ? '' : 'none';
            });
        }

        search && search.addEventListener('input', tetbiq);
        novFilter && novFilter.addEventListener('change', tetbiq);
    })();
</script>
}
