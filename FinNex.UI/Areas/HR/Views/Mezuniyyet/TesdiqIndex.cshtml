@model FinNex.UI.Areas.HR.ViewModels.Mezuniyyet.HrMezuniyyetIndexVM
@using FinNex.Domain.Entities.HR
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var showTabs = currentAction == "Hr";
    var showGeriyeBtn = currentAction == "Hr";

    string ProsesStatusText(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.SobeReisiTesdiqinde => "Şöbə rəisi təsdiqində",
        MezuniyyetStatus.RehberTesdiqinde => "Rəhbər təsdiqində",
        MezuniyyetStatus.HrTesdiqinde => "HR təsdiqində",
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.ImtinaEdildi => "İmtina edildi",
        MezuniyyetStatus.Gozlemede => "Gözləmədə",
        _ => "Gözləyir"
    };

    string ProsesStatusColor(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.SobeReisiTesdiqinde => "#2d6cdf",
        MezuniyyetStatus.RehberTesdiqinde => "#c9900a",
        MezuniyyetStatus.HrTesdiqinde => "#7c3aed",
        MezuniyyetStatus.Tesdiqlenib => "#1e9b6b",
        MezuniyyetStatus.ImtinaEdildi => "#c0392b",
        _ => "#8a93a8"
    };

    string NovBadgeStyle(MezuniyyetNovu n)
    {
        var (color, ad, icon) = n switch
        {
            MezuniyyetNovu.Xestelik               => ("#a855f7", "Xəstəlik",        "bi-hospital"),
            MezuniyyetNovu.Ezamiyyet               => ("#f97316", "Ezamiyyət",       "bi-briefcase"),
            MezuniyyetNovu.DovletVezifelerininIcrasi => ("#b45309", "Dövlət Vəzifəsi", "bi-shield-check"),
            _                                      => ("#2d6cdf", "Əmək məzuniyyəti", "bi-calendar-check")
        };
        return $"display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:{color}1a;color:{color};";
    }

    string NovText(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Xestelik               => "Xəstəlik",
        MezuniyyetNovu.Ezamiyyet               => "Ezamiyyət",
        MezuniyyetNovu.DovletVezifelerininIcrasi => "Dövlət Vəzifəsi",
        _                                      => "Əmək məzuniyyəti"
    };

    string NovIcon(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Xestelik               => "bi-hospital",
        MezuniyyetNovu.Ezamiyyet               => "bi-briefcase",
        MezuniyyetNovu.DovletVezifelerininIcrasi => "bi-shield-check",
        _                                      => "bi-calendar-check"
    };
}

@* Success/Error alert-ləri _UserLayout-da mərkəzləşdirilib — burda dublikat lazım deyil *@

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.PageTitle</div>
            <div class="fn-page-sub">
                @if (Model.YalnizIzleme)
                {
                    <span>Şöbə rəisi və Rəhbər təsdiqində olan müraciətləri izləyin</span>
                }
                else
                {
                    <span>HR-ın qərarını gözləyən müraciətlər</span>
                }
            </div>
        </div>
        @if (showGeriyeBtn)
        {
            <a asp-action="GeriyeQeyd" class="fn-btn fn-btn--primary"
               style="background:#c9900a;border-color:#c9900a;">
                <i class="bi bi-clock-history me-1"></i>
                Geriyə qeyd et
            </a>
        }
    </div>

    @* ── Tablar ── *@
    @if (showTabs)
    {
        <div style="display:flex;gap:6px;border-bottom:1px solid #e4e8f0;margin-bottom:14px;">
            <a asp-action="Hr" asp-route-tab="tesdiq"
               style="padding:10px 16px;font-size:13px;font-weight:@(Model.AktivTab == "tesdiq" ? "700" : "500");color:@(Model.AktivTab == "tesdiq" ? "#1a2332" : "#8a93a8");text-decoration:none;border-bottom:2px solid @(Model.AktivTab == "tesdiq" ? "#e8b84b" : "transparent");display:inline-flex;align-items:center;gap:6px;transition:all .15s;">
                <i class="bi bi-check2-circle"></i>
                HR təsdiqində
                <span style="background:@(Model.AktivTab == "tesdiq" ? "#e8b84b" : "#dde1ea");color:@(Model.AktivTab == "tesdiq" ? "#fff" : "#5a647a");padding:2px 7px;border-radius:10px;font-size:11px;font-weight:700;">@Model.TesdiqSayi</span>
            </a>
            <a asp-action="Hr" asp-route-tab="proses"
               style="padding:10px 16px;font-size:13px;font-weight:@(Model.AktivTab == "proses" ? "700" : "500");color:@(Model.AktivTab == "proses" ? "#1a2332" : "#8a93a8");text-decoration:none;border-bottom:2px solid @(Model.AktivTab == "proses" ? "#e8b84b" : "transparent");display:inline-flex;align-items:center;gap:6px;transition:all .15s;">
                <i class="bi bi-hourglass-split"></i>
                Prosesdə
                <span style="background:@(Model.AktivTab == "proses" ? "#e8b84b" : "#dde1ea");color:@(Model.AktivTab == "proses" ? "#fff" : "#5a647a");padding:2px 7px;border-radius:10px;font-size:11px;font-weight:700;">@Model.ProsesSayi</span>
            </a>
            <a asp-action="Hr" asp-route-tab="tarixce"
               style="padding:10px 16px;font-size:13px;font-weight:@(Model.AktivTab == "tarixce" ? "700" : "500");color:@(Model.AktivTab == "tarixce" ? "#1a2332" : "#8a93a8");text-decoration:none;border-bottom:2px solid @(Model.AktivTab == "tarixce" ? "#e8b84b" : "transparent");display:inline-flex;align-items:center;gap:6px;transition:all .15s;">
                <i class="bi bi-clock-history"></i>
                Tarixçə
                <span style="background:@(Model.AktivTab == "tarixce" ? "#e8b84b" : "#dde1ea");color:@(Model.AktivTab == "tarixce" ? "#fff" : "#5a647a");padding:2px 7px;border-radius:10px;font-size:11px;font-weight:700;">@Model.TarixceSayi</span>
            </a>
        </div>

        @* ── Axtarış: yalnız tarixçə tabında ── *@
        @if (Model.AktivTab == "tarixce")
        {
            <form method="get" asp-action="Hr" style="margin-bottom:14px;display:flex;gap:8px;align-items:center;">
                <input type="hidden" name="tab" value="tarixce" />
                <input type="text" name="axtaris" value="@Model.Axtaris" placeholder="İşçi adı, soyadı və ya FİN ilə axtar..."
                       style="flex:1;max-width:420px;padding:9px 14px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;outline:none" />
                <button type="submit" style="padding:9px 16px;background:#1a2332;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">
                    <i class="bi bi-search"></i> Axtar
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Axtaris))
                {
                    <a asp-action="Hr" asp-route-tab="tarixce"
                       style="padding:9px 14px;font-size:13px;color:#64748b;text-decoration:none">Təmizlə</a>
                }
            </form>
        }
    }

    @* ── Statistika / info rozetka ── *@
    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:8px;padding:6px 12px;background:#fff;border:1px solid #e4e8f0;border-radius:8px;">
            <span style="font-size:15px;font-weight:700;color:#1a2332;">@Model.Mezuniyyetler.Count</span>
            <span style="font-size:11.5px;color:#8a93a8;">müraciət</span>
        </div>
        @if (Model.YalnizIzleme)
        {
            <div style="display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(45,108,223,.1);color:#2d6cdf;">
                <i class="bi bi-eye"></i> Yalnız izləmə
            </div>
        }
    </div>

    @* ── Boş vəziyyət ── *@
    @if (!Model.Mezuniyyetler.Any())
    {
        <div class="fn-card" style="text-align:center;padding:40px 20px;">
            <div style="font-size:32px;color:#dde1ea;margin-bottom:8px;">
                <i class="bi bi-inbox"></i>
            </div>
            <div style="font-size:13px;color:#8a93a8;">
                @(Model.YalnizIzleme ? "Prosesdə olan müraciət yoxdur." : "HR təsdiqi gözləyən müraciət yoxdur.")
            </div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr style="background:#f8f9fb;border-bottom:1px solid #e4e8f0;">
                        <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;letter-spacing:0.04em;">İşçi</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Növ</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Başlama</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Bitmə</th>
                        <th style="padding:10px 14px;text-align:center;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Gün</th>
                        <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Status</th>
                        <th style="padding:10px 14px;text-align:right;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Mezuniyyetler)
                    {
                        <tr style="border-bottom:1px solid #f0f2f7;">
                            <td style="padding:11px 14px;">
                                <div style="font-weight:500;color:#1a2332;">@m.IsciAdSoyad</div>
                                <div style="font-size:11px;color:#8a93a8;">@m.SobeAdi · @m.VezifeAdi</div>
                            </td>
                            <td style="padding:11px 14px;">
                                <span style="@NovBadgeStyle(m.Nov)">
                                    <i class="bi @NovIcon(m.Nov)" style="font-size:10px;"></i>
                                    @NovText(m.Nov)
                                </span>
                            </td>
                            <td style="padding:11px 14px;color:#3d4557;">@m.BaslamaTarixi.ToString("dd.MM.yyyy")</td>
                            <td style="padding:11px 14px;color:#3d4557;">@m.BitmeTarixi.ToString("dd.MM.yyyy")</td>
                            <td style="padding:11px 14px;text-align:center;font-weight:600;color:#1a2332;">@m.IsGunlerininSayi</td>
                            <td style="padding:11px 14px;">
                                @if (Model.AktivTab == "tarixce")
                                {
                                    // Tarixcə tabı — təsdiq/imtina statusu + təsdiq tarixi
                                    var statusColor = ProsesStatusColor(m.Status);
                                    <div style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@(statusColor)1a;color:@(statusColor);">
                                        <span style="width:6px;height:6px;border-radius:50%;background:@(statusColor);"></span>
                                        @ProsesStatusText(m.Status)
                                    </div>
                                    @if (m.HrTesdiqTarixi.HasValue)
                                    {
                                        <div style="margin-top:4px;font-size:10.5px;color:#8a93a8">
                                            @m.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")
                                        </div>
                                    }
                                }
                                else if (Model.YalnizIzleme)
                                {
                                    // Prosesdə tabı — neçə gün gözlədiyini göstər
                                    var waitDays = (DateTime.Now - m.YaradilmaTarixi).Days;
                                    var waitColor = waitDays >= 3 ? "#c0392b" : waitDays >= 1 ? "#c9900a" : "#8a93a8";
                                    var waitBg = waitDays >= 3 ? "rgba(192,57,43,.1)" : waitDays >= 1 ? "rgba(201,144,10,.1)" : "rgba(138,147,168,.1)";
                                    var statusColor = ProsesStatusColor(m.Status);
                                    <div style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:@(statusColor)1a;color:@(statusColor);">
                                        <span style="width:6px;height:6px;border-radius:50%;background:@(statusColor);"></span>
                                        @ProsesStatusText(m.Status)
                                    </div>
                                    <div style="margin-top:4px;">
                                        <span style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:20px;font-size:10.5px;font-weight:600;background:@waitBg;color:@waitColor;">
                                            <i class="bi bi-clock"></i> @waitDays gün gözləyir
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <span style="display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(201,144,10,.1);color:#c9900a;">
                                        <span style="width:6px;height:6px;border-radius:50%;background:#c9900a;"></span>
                                        Gözləyir
                                    </span>
                                }
                            </td>
                            <td style="padding:11px 14px;text-align:right;">
                                <div style="display:flex;gap:4px;justify-content:flex-end;">
                                    <a asp-action="Detal"
                                       asp-route-id="@m.Id"
                                       asp-route-returnAction="@Model.TesdiqAction"
                                       style="padding:4px 9px;border:1px solid #e4e8f0;border-radius:6px;font-size:12px;color:#5a647a;text-decoration:none;display:inline-flex;align-items:center;"
                                       title="Detala bax">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (!string.IsNullOrEmpty(Model.TesdiqAction))
                                    {
                                        <form asp-action="@Model.TesdiqAction" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@m.Id" />
                                            <input type="hidden" name="status" value="true" />
                                            <button type="submit"
                                                    style="padding:4px 9px;border:1px solid #bbf7d0;background:rgba(30,155,107,.08);color:#15803d;border-radius:6px;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;"
                                                    title="Təsdiq et"
                                                    onclick="return confirm('Müraciəti təsdiq etmək istəyirsiniz?')">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>

                                        <button type="button"
                                                style="padding:4px 9px;border:1px solid #fecaca;background:rgba(192,57,43,.08);color:#b91c1c;border-radius:6px;font-size:12px;cursor:pointer;display:inline-flex;align-items:center;"
                                                title="İmtina et"
                                                data-bs-toggle="modal"
                                                data-bs-target="#imtinaModal"
                                                data-id="@m.Id"
                                                data-action="@Model.TesdiqAction">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@* İmtina Modal *@
<div class="modal fade" id="imtinaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border:none;border-radius:12px;">
            <form id="imtinaForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="imtinaId" />
                <input type="hidden" name="status" value="false" />
                <div class="modal-header" style="border-bottom:1px solid #e4e8f0;">
                    <h5 class="modal-title" style="font-size:15px;font-weight:700;color:#1a2332;">
                        <i class="bi bi-x-circle me-2" style="color:#c0392b;"></i>İmtina səbəbi
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label style="font-size:12px;font-weight:600;color:#5a647a;margin-bottom:6px;display:block;">
                        Səbəb <span style="color:#c0392b;">*</span>
                    </label>
                    <textarea name="qeyd" rows="3" required
                              style="width:100%;border:1px solid #e4e8f0;border-radius:8px;padding:8px 10px;font-size:13px;font-family:inherit;resize:vertical;"
                              placeholder="İmtina səbəbini qeyd edin..."></textarea>
                </div>
                <div class="modal-footer" style="border-top:1px solid #e4e8f0;">
                    <button type="button" class="fn-btn fn-btn--outline" data-bs-dismiss="modal">Ləğv et</button>
                    <button type="submit" class="fn-btn fn-btn--primary"
                            style="background:#c0392b;border-color:#c0392b;">
                        <i class="bi bi-x-lg me-1"></i>İmtina et
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imtinaModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            const id = btn.getAttribute('data-id');
            const action = btn.getAttribute('data-action');
            document.getElementById('imtinaId').value = id;
            document.getElementById('imtinaForm').action = '@Url.Action("__placeholder__", "Mezuniyyet", new { area = "HR" })'.replace('__placeholder__', action);
        });
    </script>
}
