@using FinNex.UI.Areas.HR.ViewModels
@using FinNex.Domain.Entities.HR
@model MezuniyyetEditVM
@{
    ViewData["Title"] = "Məzuniyyəti Redaktə Et";
    Layout = "~/Areas/HR/Views/Shared/_HRLayout.cshtml";
}

<div class="mod-form-wrapper">

    <!-- Back -->
    <a asp-action="Index" class="mod-back-link">
        <i class="bi bi-arrow-left"></i> Məzuniyyət siyahısına qayıt
    </a>

    <div class="mod-form-card">

        <!-- Header -->
        <div class="mod-form-card-header">
            <div class="mod-form-ico mod-ico-amber">
                <i class="bi bi-pencil-fill"></i>
            </div>
            <div>
                <h2 class="mod-form-title">Məzuniyyəti Redaktə Et</h2>
                <p class="mod-form-subtitle">
                    <i class="bi bi-person-fill"></i> @Model.IsciTamAd —
                    @{
                        ViewData["Badge_Type"]  = "mezuniyyet-nov";
                        ViewData["Badge_Value"] = Model.Nov.ToString();
                    }
                    <partial name="_StatusBadge" />
                </p>
            </div>
        </div>

        <!-- Info banner -->
        <div class="mod-edit-info-banner">
            <div class="mod-edit-info-item">
                <i class="bi bi-person-fill"></i>
                <span>@Model.IsciTamAd</span>
            </div>
            <div class="mod-edit-info-sep"></div>
            <div class="mod-edit-info-item">
                <i class="bi bi-building"></i>
                <span>@Model.Sobe</span>
            </div>
        </div>

        <form asp-action="Edit" method="post" id="editForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="mod-alert-danger"></div>

            <!-- Section: Tarixlər -->
            <div class="mod-form-section">
                <div class="mod-section-title">
                    <i class="bi bi-calendar-range"></i> Tarix Aralığı
                </div>
                <div class="mod-form-grid mod-grid-3">

                    <div class="mod-form-field">
                        <label asp-for="BaslamaTarixi" class="mod-label">
                            Başlama Tarixi <span class="mod-req">*</span>
                        </label>
                        <div class="mod-input-wrap">
                            <i class="bi bi-calendar3 mod-input-ico"></i>
                            <input asp-for="BaslamaTarixi" type="date" class="mod-input" id="basTarix" />
                        </div>
                        <span asp-validation-for="BaslamaTarixi" class="mod-error"></span>
                    </div>

                    <div class="mod-form-field">
                        <label asp-for="BitmeTarixi" class="mod-label">
                            Bitmə Tarixi <span class="mod-req">*</span>
                        </label>
                        <div class="mod-input-wrap">
                            <i class="bi bi-calendar3 mod-input-ico"></i>
                            <input asp-for="BitmeTarixi" type="date" class="mod-input" id="sonTarix" />
                        </div>
                        <span asp-validation-for="BitmeTarixi" class="mod-error"></span>
                    </div>

                    <div class="mod-form-field">
                        <label class="mod-label">Müddət</label>
                        <div class="duration-preview" id="dayPreview">
                            <i class="bi bi-calendar-week"></i>
                            <span id="dayCount">—</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Section: Qeyd -->
            <div class="mod-form-section">
                <div class="mod-section-title">
                    <i class="bi bi-chat-text"></i> Qeyd
                </div>
                <div class="mod-form-grid mod-grid-1">
                    <div class="mod-form-field">
                        <label asp-for="Qeyd" class="mod-label">Qeyd (istəyə görə)</label>
                        <textarea asp-for="Qeyd" class="mod-textarea" rows="4"
                                  placeholder="Məzuniyyət haqqında əlavə məlumat..."></textarea>
                        <span asp-validation-for="Qeyd" class="mod-error"></span>
                    </div>
                </div>
            </div>

            <!-- Section: Status -->
            <div class="mod-form-section">
                <div class="mod-section-title">
                    <i class="bi bi-flag-fill"></i> Status
                </div>
                <div class="mod-form-grid mod-grid-3">
                    <div class="mod-form-field mod-field-full">
                        <div class="mod-status-picker">
                            <label class="mod-status-opt mod-opt-orange @(Model.Status == MezuniyyetStatus.Gozlemede ? "checked" : "")">
                                <input type="radio" asp-for="Status" value="@((int)MezuniyyetStatus.Gozlemede)" />
                                <i class="bi bi-hourglass-split"></i> Gözləmədə
                            </label>
                            <label class="mod-status-opt mod-opt-green @(Model.Status == MezuniyyetStatus.Tesdiqlenib ? "checked" : "")">
                                <input type="radio" asp-for="Status" value="@((int)MezuniyyetStatus.Tesdiqlenib)" />
                                <i class="bi bi-check-circle-fill"></i> Təsdiqlənilib
                            </label>
                            <label class="mod-status-opt mod-opt-red @(Model.Status == MezuniyyetStatus.ImtinaEdilib ? "checked" : "")">
                                <input type="radio" asp-for="Status" value="@((int)MezuniyyetStatus.ImtinaEdilib)" />
                                <i class="bi bi-x-circle-fill"></i> İmtina Edilib
                            </label>
                        </div>
                        <span asp-validation-for="Status" class="mod-error"></span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mod-form-actions">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-mod-secondary">
                    <i class="bi bi-eye"></i> Detallara Qayıt
                </a>
                <button type="submit" class="btn-mod-primary">
                    <i class="bi bi-check-lg"></i> Dəyişiklikləri Saxla
                </button>
            </div>

        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/hr-modules.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hr/hr-modules.js" asp-append-version="true"></script>
    <script>
        const bas  = document.getElementById('basTarix');
        const son  = document.getElementById('sonTarix');
        const cnt  = document.getElementById('dayCount');

        function calcDays() {
            if (!bas.value || !son.value) { cnt.textContent = '—'; return; }
            const d = (new Date(son.value) - new Date(bas.value)) / 86400000 + 1;
            cnt.textContent = d > 0 ? d + ' gün' : 'Yanlış aralıq';
        }

        bas.addEventListener('change', calcDays);
        son.addEventListener('change', calcDays);
        calcDays();

        document.querySelectorAll('.mod-status-opt input[type="radio"]').forEach(r => {
            r.addEventListener('change', () => {
                document.querySelectorAll('.mod-status-opt').forEach(l => l.classList.remove('checked'));
                r.closest('.mod-status-opt').classList.add('checked');
            });
        });
    </script>
}
