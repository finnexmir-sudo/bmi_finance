@model FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetUpdateDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Məzuniyyəti Redaktə Et";
    Layout = "~/Views/Shared/_Layout.cshtml";

    static string StatusLabel(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "Gözləmədə",
        MezuniyyetStatus.SobeReisiTesdiqinde => "Şöbə Rəisi Təsdiqi",
        MezuniyyetStatus.RehberTesdiqinde => "Rəhbər Təsdiqi",
        MezuniyyetStatus.HrTesdiqinde => "HR Təsdiqi",
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.ImtinaEdildi => "İmtina Edildi",
        _ => s.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet.css asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mez-page-header d-flex align-items-center gap-3 mez-animate">
        <div class="header-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div class="flex-grow-1">
            <h1 class="page-title">Məzuniyyəti Redaktə Et</h1>
            <p class="page-subtitle">Müraciət #@Model?.Id · Status: @StatusLabel(Model?.Status ?? MezuniyyetStatus.Gozlemede)</p>
        </div>
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index" class="btn-mez-secondary">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8 mez-animate mez-animate-delay-1">
            <form asp-area="HR" asp-controller="Mezuniyyet" asp-action="Edit"
                  method="post" class="mez-validated-form" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <!-- Leave Type -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-tag text-primary"></i>
                        <h5 class="card-header-title">Məzuniyyət Növü</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="mez-type-selector">
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-illik"
                                       value="@((int)MezuniyyetNovu.Illik)" />
                                <label class="mez-type-label" for="type-illik">
                                    <span class="type-icon">☀️</span>
                                    <span class="type-name">İllik Məzuniyyət</span>
                                </label>
                            </div>
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-xestelik"
                                       value="@((int)MezuniyyetNovu.Xestelik)" />
                                <label class="mez-type-label" for="type-xestelik">
                                    <span class="type-icon">💊</span>
                                    <span class="type-name">Xəstəlik</span>
                                </label>
                            </div>
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-ezamiyyet"
                                       value="@((int)MezuniyyetNovu.Ezamiyyet)" />
                                <label class="mez-type-label" for="type-ezamiyyet">
                                    <span class="type-icon">✈️</span>
                                    <span class="type-name">Ezamiyyət</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Nov" class="invalid-feedback d-block mt-2"></span>
                    </div>
                </div>

                <!-- Dates -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-calendar-range text-primary"></i>
                        <h5 class="card-header-title">Tarix Aralığı</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="date-range-row">
                            <div class="mez-form-group mb-0">
                                <label asp-for="BaslamaTarixi" class="mez-form-label">
                                    Başlama Tarixi <span class="required">*</span>
                                </label>
                                <input asp-for="BaslamaTarixi"
                                       id="BaslamaTarixi"
                                       type="date"
                                       class="mez-form-control"
                                       required />
                                <span asp-validation-for="BaslamaTarixi" class="invalid-feedback"></span>
                            </div>

                            <div class="date-range-separator">
                                <i class="bi bi-arrow-right"></i>
                            </div>

                            <div class="mez-form-group mb-0">
                                <label asp-for="BitmeTarixi" class="mez-form-label">
                                    Bitmə Tarixi <span class="required">*</span>
                                </label>
                                <input asp-for="BitmeTarixi"
                                       id="BitmeTarixi"
                                       type="date"
                                       class="mez-form-control"
                                       required />
                                <span asp-validation-for="BitmeTarixi" class="invalid-feedback"></span>
                                <span id="date-range-error" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-3 pt-3"
                             style="border-top:1px dashed var(--gray-200);">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span style="font-size:0.82rem; color:var(--gray-500);">Hesablanmış iş günü:</span>
                            <span id="mez-day-count"
                                  style="font-family:var(--font-mono); font-weight:700; font-size:0.9rem; color:var(--primary-light);">
                                —
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Substitute & Status -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-people text-primary"></i>
                        <h5 class="card-header-title">Əvəzedici və Status</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mez-form-group">
                                    <label asp-for="EvezEdenIsciId" class="mez-form-label">Əvəzedici İşçi</label>
                                    <select asp-for="EvezEdenIsciId"
                                            asp-items="ViewBag.EvezEdenIsciList"
                                            class="mez-form-control">
                                        <option value="">— Seçin (könüllü) —</option>
                                    </select>
                                    <span asp-validation-for="EvezEdenIsciId" class="invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mez-form-group">
                                    <label asp-for="Status" class="mez-form-label">Status <span class="required">*</span></label>
                                    <select asp-for="Status"
                                            asp-items="Html.GetEnumSelectList<MezuniyyetStatus>()"
                                            class="mez-form-control"
                                            required>
                                    </select>
                                    <span asp-validation-for="Status" class="invalid-feedback"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mez-form-group mb-0" id="imtina-group"
                             style="@(Model?.Status == MezuniyyetStatus.ImtinaEdildi ? "" : "display:none;")">
                            <label asp-for="ImtinaSebebi" class="mez-form-label">
                                İmtina Səbəbi <span class="required">*</span>
                            </label>
                            <textarea asp-for="ImtinaSebebi"
                                      class="mez-form-control"
                                      rows="2"
                                      placeholder="Rədd etmə səbəbini qeyd edin..."></textarea>
                            <span asp-validation-for="ImtinaSebebi" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-chat-text text-primary"></i>
                        <h5 class="card-header-title">Qeyd</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="mez-form-group mb-0">
                            <label asp-for="Qeyd" class="mez-form-label">Əlavə Məlumat</label>
                            <textarea asp-for="Qeyd"
                                      class="mez-form-control"
                                      rows="3"
                                      placeholder="Müraciətlə bağlı qeydlər..."></textarea>
                            <span asp-validation-for="Qeyd" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index"
                       class="btn-mez-secondary">
                        <i class="bi bi-x-lg"></i> Ləğv Et
                    </a>
                    <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Detail" asp-route-id="@Model?.Id"
                       class="btn-mez-secondary">
                        <i class="bi bi-eye"></i> Bax
                    </a>
                    <button type="submit" class="btn-mez-primary">
                        <i class="bi bi-floppy"></i> Yadda Saxla
                    </button>
                </div>
            </form>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4 mez-animate mez-animate-delay-2">
            <div class="mez-card">
                <div class="mez-card-header">
                    <i class="bi bi-shield-exclamation text-warning"></i>
                    <h5 class="card-header-title">Diqqət</h5>
                </div>
                <div class="mez-card-body">
                    <p style="font-size:0.85rem; color:var(--gray-600); line-height:1.7; margin:0;">
                        Statusu <strong>Təsdiqlənib</strong> olaraq dəyişdirdikdə məzuniyyət balansı avtomatik yenilənəcəkdir.
                        <br><br>
                        <strong>İmtina</strong> statusu seçildikdə səbəb qeyd etmək məcburidir.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/mezuniyyet.js" asp-append-version="true"></script>
    <script>
        // Show/hide imtina field
        document.addEventListener('DOMContentLoaded', function () {
            var statusSel = document.querySelector('select[name="Status"]');
            var imtinaGroup = document.getElementById('imtina-group');
            if (!statusSel || !imtinaGroup) return;
            statusSel.addEventListener('change', function () {
                imtinaGroup.style.display = this.value === '6' ? '' : 'none';
            });
        });
    </script>
}
