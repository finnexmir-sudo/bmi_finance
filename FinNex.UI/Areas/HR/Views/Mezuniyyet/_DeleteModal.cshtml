@*
    _DeleteModal.cshtml
    Partial view – Delete Confirmation Modal
    Usage: @await Html.PartialAsync("_DeleteModal")
    Trigger via: data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="{id}" data-name="{name}"
*@

<div class="modal fade mez-modal"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Silmə Təsdiqi
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Bağla"></button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <div class="delete-confirm-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <p class="delete-confirm-text">
                    <span class="delete-confirm-name" id="deleteEmployeeName"></span>
                    adlı işçinin məzuniyyət müraciətini silmək istədiyinizdən əminsiniz?
                    <br><br>
                    <span style="font-size:0.8rem; color:var(--gray-400);">Bu əməliyyat geri qaytarıla bilməz.</span>
                </p>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button"
                        class="btn-mez-secondary"
                        data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Ləğv Et
                </button>
                <form id="deleteForm"
                      method="post"
                      data-base-url="@Url.Action("Delete", "Mezuniyyet", new { area = "HR" })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-mez-danger">
                        <i class="bi bi-trash3"></i> Sil
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
