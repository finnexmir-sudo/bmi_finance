@model IEnumerable<FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetListDto>
@{
    ViewData["Title"] = "Ləğv Müraciətləri";
}

<div style="padding:20px 4px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
        <div>
            <h4 style="margin:0;font-weight:700;color:#0f172a;">Ləğv Müraciətləri</h4>
            <div style="font-size:12.5px;color:#64748b;margin-top:2px;">
                İşçilərin təsdiqlənmiş məzuniyyətlərini ləğv etmək üçün göndərdiyi, HR təsdiqini gözləyən müraciətlər
            </div>
        </div>
        <span style="background:#eef2ff;color:#3730a3;border-radius:20px;padding:6px 14px;font-size:13px;font-weight:700;">
            @Model.Count() müraciət
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:14px;">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;border-radius:8px;padding:10px 14px;font-size:13px;margin-bottom:14px;">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:12px;padding:40px;text-align:center;color:#64748b;font-size:13.5px;">
            <i class="bi bi-inbox" style="font-size:26px;display:block;margin-bottom:8px;opacity:.6;"></i>
            Gözləyən ləğv müraciəti yoxdur.
        </div>
    }
    else
    {
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden;">
            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr style="background:#f8fafc;color:#475569;text-align:left;">
                        <th style="padding:11px 14px;font-weight:600;">İşçi</th>
                        <th style="padding:11px 14px;font-weight:600;">Şöbə / Vəzifə</th>
                        <th style="padding:11px 14px;font-weight:600;">Məzuniyyət dövrü</th>
                        <th style="padding:11px 14px;font-weight:600;text-align:center;">Gün</th>
                        <th style="padding:11px 14px;font-weight:600;">Ləğv səbəbi</th>
                        <th style="padding:11px 14px;font-weight:600;">Müraciət tarixi</th>
                        <th style="padding:11px 14px;font-weight:600;text-align:right;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr style="border-top:1px solid #eef2f7;">
                            <td style="padding:10px 14px;font-weight:600;color:#1e293b;">@m.IsciAdSoyad</td>
                            <td style="padding:10px 14px;color:#475569;">
                                @m.SobeAdi<br /><span style="font-size:11.5px;color:#94a3b8;">@m.VezifeAdi</span>
                            </td>
                            <td style="padding:10px 14px;color:#334155;white-space:nowrap;">
                                @m.BaslamaTarixi.ToString("dd.MM.yyyy") – @m.BitmeTarixi.ToString("dd.MM.yyyy")
                            </td>
                            <td style="padding:10px 14px;text-align:center;color:#334155;">@m.IsGunlerininSayi</td>
                            <td style="padding:10px 14px;color:#7c2d12;max-width:260px;">@(string.IsNullOrWhiteSpace(m.LegvTelebSebebi) ? "—" : m.LegvTelebSebebi)</td>
                            <td style="padding:10px 14px;color:#64748b;white-space:nowrap;">
                                @(m.LegvTelebTarixi.HasValue ? m.LegvTelebTarixi.Value.ToString("dd.MM.yyyy HH:mm") : "—")
                            </td>
                            <td style="padding:10px 14px;text-align:right;">
                                <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Detal"
                                   asp-route-id="@m.Id" asp-route-returnAction="LegvTelebleri"
                                   style="display:inline-flex;align-items:center;gap:5px;padding:6px 14px;border-radius:8px;border:1.5px solid #6366f1;background:#eef2ff;color:#4338ca;font-size:12.5px;font-weight:600;text-decoration:none;white-space:nowrap;">
                                    <i class="bi bi-eye"></i> Bax / Təsdiq
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
