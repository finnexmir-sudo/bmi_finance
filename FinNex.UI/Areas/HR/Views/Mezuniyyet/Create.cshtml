@model FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetCreateDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Yeni Məzuniyyət Müraciəti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mez-page-header d-flex align-items-center gap-3 mez-animate">
        <div class="header-icon">
            <i class="bi bi-calendar-plus-fill"></i>
        </div>
        <div class="flex-grow-1">
            <h1 class="page-title">Yeni Məzuniyyət Müraciəti</h1>
            <p class="page-subtitle">Müraciəti doldurun və iş axınını başladın</p>
        </div>
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index" class="btn-mez-secondary">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>

    <div class="row g-4">

        <!-- Form Column -->
        <div class="col-lg-8 mez-animate mez-animate-delay-1">
            <form asp-area="HR" asp-controller="Mezuniyyet" asp-action="Create"
                  method="post" class="mez-validated-form" novalidate>
                @Html.AntiForgeryToken()

                <!-- Employee Info -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-person-badge text-primary"></i>
                        <h5 class="card-header-title">İşçi Məlumatları</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mez-form-group">
                                    <label asp-for="IsciId" class="mez-form-label">
                                        İşçi <span class="required">*</span>
                                    </label>
                                    <select asp-for="IsciId"
                                            asp-items="ViewBag.IsciList"
                                            class="mez-form-control"
                                            required>
                                        <option value="">— İşçi seçin —</option>
                                    </select>
                                    <span asp-validation-for="IsciId" class="invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mez-form-group">
                                    <label asp-for="EvezEdenIsciId" class="mez-form-label">
                                        Əvəzedici İşçi
                                        <span class="mez-form-hint d-inline">(tövsiyə olunur)</span>
                                    </label>
                                    <select asp-for="EvezEdenIsciId"
                                            asp-items="ViewBag.EvezEdenIsciList"
                                            class="mez-form-control">
                                        <option value="">— Seçin (könüllü) —</option>
                                    </select>
                                    <span asp-validation-for="EvezEdenIsciId" class="invalid-feedback"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Leave Type -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-tag text-primary"></i>
                        <h5 class="card-header-title">Məzuniyyət Növü</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="mez-type-selector">
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-illik"
                                       value="@((int)MezuniyyetNovu.Illik)" />
                                <label class="mez-type-label" for="type-illik">
                                    <span class="type-icon">☀️</span>
                                    <span class="type-name">İllik Məzuniyyət</span>
                                </label>
                            </div>
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-xestelik"
                                       value="@((int)MezuniyyetNovu.Xestelik)" />
                                <label class="mez-type-label" for="type-xestelik">
                                    <span class="type-icon">💊</span>
                                    <span class="type-name">Xəstəlik</span>
                                </label>
                            </div>
                            <div class="mez-type-option">
                                <input type="radio"
                                       asp-for="Nov"
                                       id="type-ezamiyyet"
                                       value="@((int)MezuniyyetNovu.Ezamiyyet)" />
                                <label class="mez-type-label" for="type-ezamiyyet">
                                    <span class="type-icon">✈️</span>
                                    <span class="type-name">Ezamiyyət</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Nov" class="invalid-feedback d-block mt-2"></span>
                    </div>
                </div>

                <!-- Dates -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-calendar-range text-primary"></i>
                        <h5 class="card-header-title">Tarix Aralığı</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="date-range-row">
                            <div class="mez-form-group mb-0">
                                <label asp-for="BaslamaTarixi" class="mez-form-label">
                                    Başlama Tarixi <span class="required">*</span>
                                </label>
                                <input asp-for="BaslamaTarixi"
                                       id="BaslamaTarixi"
                                       type="date"
                                       class="mez-form-control"
                                       required />
                                <span asp-validation-for="BaslamaTarixi" class="invalid-feedback"></span>
                            </div>

                            <div class="date-range-separator">
                                <i class="bi bi-arrow-right"></i>
                            </div>

                            <div class="mez-form-group mb-0">
                                <label asp-for="BitmeTarixi" class="mez-form-label">
                                    Bitmə Tarixi <span class="required">*</span>
                                </label>
                                <input asp-for="BitmeTarixi"
                                       id="BitmeTarixi"
                                       type="date"
                                       class="mez-form-control"
                                       required />
                                <span asp-validation-for="BitmeTarixi" class="invalid-feedback"></span>
                                <span id="date-range-error" class="invalid-feedback"></span>
                            </div>
                        </div>

                        <!-- Day Count Preview -->
                        <div class="d-flex align-items-center gap-2 mt-3 pt-3"
                             style="border-top: 1px dashed var(--gray-200);">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span style="font-size:0.82rem; color:var(--gray-500);">Hesablanmış iş günü:</span>
                            <span id="mez-day-count"
                                  style="font-family:var(--font-mono); font-weight:700; font-size:0.9rem; color:var(--primary-light);">
                                —
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Notes -->
                <div class="mez-card mb-4">
                    <div class="mez-card-header">
                        <i class="bi bi-chat-text text-primary"></i>
                        <h5 class="card-header-title">Qeyd</h5>
                    </div>
                    <div class="mez-card-body">
                        <div class="mez-form-group mb-0">
                            <label asp-for="Qeyd" class="mez-form-label">Əlavə Məlumat (könüllü)</label>
                            <textarea asp-for="Qeyd"
                                      class="mez-form-control"
                                      rows="3"
                                      placeholder="Müraciətlə bağlı əlavə qeydlərinizi yazın..."></textarea>
                            <span asp-validation-for="Qeyd" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-3 justify-content-end">
                    <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index"
                       class="btn-mez-secondary">
                        <i class="bi bi-x-lg"></i> Ləğv Et
                    </a>
                    <button type="submit" class="btn-mez-primary">
                        <i class="bi bi-send"></i> Müraciəti Göndər
                    </button>
                </div>
            </form>
        </div>

        <!-- Info Sidebar -->
        <div class="col-lg-4 mez-animate mez-animate-delay-2">

            <!-- Process Card -->
            <div class="mez-card mb-4">
                <div class="mez-card-header">
                    <i class="bi bi-diagram-3 text-primary"></i>
                    <h5 class="card-header-title">Təsdiq Axını</h5>
                </div>
                <div class="mez-card-body">
                    <div class="workflow-timeline">
                        <div class="workflow-step step-pending">
                            <div class="step-title"><i class="bi bi-person-check me-2 text-primary"></i>Şöbə Rəisi</div>
                            <div class="step-meta">İlk baxış mərhələsi</div>
                        </div>
                        <div class="workflow-step">
                            <div class="step-title"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Rəhbərlik</div>
                            <div class="step-meta">Departament müdiri təsdiqi</div>
                        </div>
                        <div class="workflow-step">
                            <div class="step-title"><i class="bi bi-shield-check me-2 text-primary"></i>HR Şöbəsi</div>
                            <div class="step-meta">Son sənədləşmə</div>
                        </div>
                        <div class="workflow-step">
                            <div class="step-title"><i class="bi bi-check-circle-fill me-2 text-success"></i>Təsdiqləndi</div>
                            <div class="step-meta">Proses tamamlandı</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="mez-card">
                <div class="mez-card-header">
                    <i class="bi bi-lightbulb text-warning"></i>
                    <h5 class="card-header-title">Məlumat</h5>
                </div>
                <div class="mez-card-body">
                    <ul style="font-size:0.82rem; color:var(--gray-600); padding-left:1.2rem; line-height:1.8;">
                        <li>Həftəsonu günlər iş günü sayılmır</li>
                        <li>Bayram günləri avtomatik çıxılır</li>
                        <li>Əvəzedici şəxs bankda mütləqdir</li>
                        <li>Müraciəti göndərdikdən sonra dəyişiklik edə bilərsiniz</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/hr/mezuniyyet.js" asp-append-version="true"></script>
}
