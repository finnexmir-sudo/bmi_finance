@model FinNex.UI.Areas.HR.ViewModels.Mezuniyyet.GeriyeQeydVM
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Geriyə Məzuniyyət Qeyd et";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var minTarix = DateTime.Today.AddDays(-Model.MaksimumKohneGun).ToString("yyyy-MM-dd");
    var maxTarix = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");

    // Radio seçim üçün bool dəyişənlər (Razor-da checked="@bool" düzgün render edir;
    // asp-for ilə inline @() yazmaq RZ1031 xətası verir).
    var cIllik = Model.Nov == MezuniyyetNovu.Illik;
    var cXestelik = Model.Nov == MezuniyyetNovu.Xestelik;
    var cEzamiyyet = Model.Nov == MezuniyyetNovu.Ezamiyyet;
}

<div class="fn-page fn-mez-create">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Geriyə Qeyd et</div>
            <div class="fn-page-sub">İşçi işə gəlməyib və "Qayıb" kimi qeyd olunubsa — HR sonradan illik məzuniyyət / xəstəlik / ezamiyyət yaza və Qayıbları avtomatik uyğun statusa çevirə bilər</div>
        </div>
        <a asp-action="Hr" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
    }

    <div class="fn-create-layout">

        @* ── Forma ── *@
        <div class="fn-form-wrap fn-form-wrap--wide">
            <form asp-action="GeriyeQeyd" method="post">
                @Html.AntiForgeryToken()

                <div class="fn-card fn-card--form">

                    @* Xəbərdarlıq *@
                    <div style="display:flex;gap:10px;padding:12px 14px;background:#fffbea;border:1px solid #fde68a;border-left:4px solid #c9900a;border-radius:8px;margin-bottom:18px">
                        <div style="font-size:18px;line-height:1">⚠</div>
                        <div style="font-size:12.5px;color:#7a5a10;line-height:1.55">
                            <strong>Diqqət:</strong> Bu səhifə təsdiq axınını atlayır — müraciət dərhal
                            <strong>"Təsdiqlənib"</strong> statusunda yaranır. Maksimum
                            <strong>@Model.MaksimumKohneGun gün</strong> əvvələ qədər keçmiş tarix üçün
                            qeyd etmək olar. İşçinin davamiyyətindəki <strong>"Qayıb"</strong> qeydləri
                            seçilən növə uyğun olaraq <strong>"İcazəli"</strong> (illik),
                            <strong>"Xəstəlik"</strong> və ya <strong>"Ezamiyyət"</strong>-ə avtomatik
                            çevriləcək. İllik məzuniyyət halında balans azalır (xəstəlik / ezamiyyətdə
                            balansa toxunulmur).
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="fn-val-msg" style="display:block;margin-bottom:10px"></div>

                    @* ── İşçi seçimi ── *@
                    <div class="fn-form-group">
                        <label asp-for="IsciId" class="fn-label">
                            İşçi <span class="fn-required">*</span>
                        </label>
                        <select asp-for="IsciId" asp-items="Model.Isciler" class="fn-select" required>
                            <option value="">— İşçi seçin —</option>
                        </select>
                        <span asp-validation-for="IsciId" class="fn-val-msg"></span>
                    </div>

                    @* ── Növ seçimi (kart radio-lar) ── *@
                    <div class="fn-form-group">
                        <label class="fn-label">Növ <span class="fn-required">*</span></label>
                        <div class="fn-nov-grid" style="grid-template-columns:repeat(3,1fr)">
                            <label class="fn-nov-card">
                                <input type="radio" name="Nov" value="@((int)MezuniyyetNovu.Illik)"
                                       class="fn-nov-radio" checked="@cIllik" />
                                <i class="bi bi-sun" style="font-size:20px;color:#1e9b6b"></i>
                                İllik məzuniyyət
                                <small>Qayıb → İcazəli</small>
                            </label>
                            <label class="fn-nov-card">
                                <input type="radio" name="Nov" value="@((int)MezuniyyetNovu.Xestelik)"
                                       class="fn-nov-radio" checked="@cXestelik" />
                                <i class="bi bi-hospital" style="font-size:20px;color:#a855f7"></i>
                                Xəstəlik
                                <small>Qayıb → Xəstəlik</small>
                            </label>
                            <label class="fn-nov-card">
                                <input type="radio" name="Nov" value="@((int)MezuniyyetNovu.Ezamiyyet)"
                                       class="fn-nov-radio" checked="@cEzamiyyet" />
                                <i class="bi bi-briefcase" style="font-size:20px;color:#f97316"></i>
                                Ezamiyyət
                                <small>Qayıb → Ezamiyyət</small>
                            </label>
                        </div>
                    </div>

                    @* ── Tarixlər ── *@
                    <div class="fn-form-row">
                        <div class="fn-form-group">
                            <label asp-for="BaslamaTarixi" class="fn-label">
                                Başlama tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BaslamaTarixi" type="date" class="fn-input"
                                   min="@minTarix" max="@maxTarix"
                                   value="@Model.BaslamaTarixi.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="BaslamaTarixi" class="fn-val-msg"></span>
                        </div>
                        <div class="fn-form-group">
                            <label asp-for="BitmeTarixi" class="fn-label">
                                Bitmə tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BitmeTarixi" type="date" class="fn-input"
                                   min="@minTarix" max="@maxTarix"
                                   value="@Model.BitmeTarixi.ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="BitmeTarixi" class="fn-val-msg"></span>
                        </div>
                    </div>

                    @* ── Səbəb ── *@
                    <div class="fn-form-group">
                        <label asp-for="Sebeb" class="fn-label">
                            Səbəb <span class="fn-label-hint">(ixtiyari)</span>
                        </label>
                        <textarea asp-for="Sebeb" rows="3" class="fn-textarea"
                                  placeholder="Nəyə görə geriyə qeyd olunur? (məs: 'işçi xəstə idi, sənədləri sonradan gətirdi')"></textarea>
                        <span asp-validation-for="Sebeb" class="fn-val-msg"></span>
                        <small style="font-size:11px;color:#94a3b8;margin-top:4px;display:block">Verilərsə, audit üçün qeydə alınır</small>
                    </div>

                    @* ── Düymələr ── *@
                    <div class="fn-form-actions">
                        <a asp-action="Hr" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary"
                                onclick="return confirm('Bu əməliyyat təsdiq axınını atlayır və dərhal təsdiqlənmiş kimi qeyd olunur. Davam edilsin?');">
                            Qeyd et
                        </button>
                    </div>
                </div>
            </form>
        </div>

        @* ── Sağ panel: məlumat ── *@
        <div class="fn-side-info">
            <div class="fn-card">
                <div class="fn-card-title" style="margin-bottom:10px">Məlumat</div>
                <div class="fn-workflow-info">
                    <div class="fn-wi-step">
                        <div class="fn-wi-num"><i class="bi bi-exclamation" style="font-size:11px"></i></div>
                        <div class="fn-wi-text">
                            <strong>Təsdiq atlanır</strong>
                            <span>Müraciət dərhal "Təsdiqlənib" statusunda yaranır</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num"><i class="bi bi-calendar-x" style="font-size:11px"></i></div>
                        <div class="fn-wi-text">
                            <strong>Maks @Model.MaksimumKohneGun gün</strong>
                            <span>Daha əvvələ qeyd etmək olmur</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num"><i class="bi bi-arrow-repeat" style="font-size:11px"></i></div>
                        <div class="fn-wi-text">
                            <strong>Qayıb avtomatik çevrilir</strong>
                            <span>Seçilən növə uyğun İcazəli / Xəstəlik / Ezamiyyət statusuna</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num"><i class="bi bi-piggy-bank" style="font-size:11px"></i></div>
                        <div class="fn-wi-text">
                            <strong>Balans yalnız illikdə</strong>
                            <span>İllik məzuniyyətdə balans azalır; xəstəlik / ezamiyyətdə toxunulmur</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num"><i class="bi bi-file-earmark-text" style="font-size:11px"></i></div>
                        <div class="fn-wi-text">
                            <strong>Audit</strong>
                            <span>Bütün geriyə qeydlər log-a düşür</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
