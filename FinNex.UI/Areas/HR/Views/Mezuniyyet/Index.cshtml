@model IEnumerable<FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetListDto>
@using FinNex.Application.DTOs.HR.Mezuniyyet
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Məzuniyyət İdarəetməsi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    static string StatusBadgeClass(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "mez-badge-gozlemede",
        MezuniyyetStatus.SobeReisiTesdiqinde => "mez-badge-sobe",
        MezuniyyetStatus.RehberTesdiqinde => "mez-badge-rehber",
        MezuniyyetStatus.HrTesdiqinde => "mez-badge-hr",
        MezuniyyetStatus.Tesdiqlenib => "mez-badge-tesdiq",
        MezuniyyetStatus.ImtinaEdildi => "mez-badge-imtina",
        _ => ""
    };

    static string StatusIcon(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "bi-clock",
        MezuniyyetStatus.SobeReisiTesdiqinde => "bi-person-check",
        MezuniyyetStatus.RehberTesdiqinde => "bi-person-lines-fill",
        MezuniyyetStatus.HrTesdiqinde => "bi-shield-check",
        MezuniyyetStatus.Tesdiqlenib => "bi-check-circle-fill",
        MezuniyyetStatus.ImtinaEdildi => "bi-x-circle-fill",
        _ => "bi-circle"
    };

    static string StatusText(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "Gözləmədə",
        MezuniyyetStatus.SobeReisiTesdiqinde => "Şöbə Rəisi",
        MezuniyyetStatus.RehberTesdiqinde => "Rəhbər",
        MezuniyyetStatus.HrTesdiqinde => "HR Təsdiqi",
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.ImtinaEdildi => "İmtina",
        _ => s.ToString()
    };

    static string TypeClass(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "type-illik",
        MezuniyyetNovu.Xestelik => "type-xestelik",
        MezuniyyetNovu.Ezamiyyet => "type-ezamiyyet",
        _ => ""
    };

    static string TypeIcon(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "bi-sun",
        MezuniyyetNovu.Xestelik => "bi-heart-pulse",
        MezuniyyetNovu.Ezamiyyet => "bi-airplane",
        _ => "bi-calendar"
    };

    var list = Model?.ToList() ?? new List<MezuniyyetListDto>();
    var total = list.Count;
    var pending = list.Count(x => x.Status == MezuniyyetStatus.Gozlemede || x.Status == MezuniyyetStatus.SobeReisiTesdiqinde || x.Status == MezuniyyetStatus.RehberTesdiqinde || x.Status == MezuniyyetStatus.HrTesdiqinde);
    var approved = list.Count(x => x.Status == MezuniyyetStatus.Tesdiqlenib);
    var rejected = list.Count(x => x.Status == MezuniyyetStatus.ImtinaEdildi);
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="mez-page-header d-flex align-items-center gap-3 mez-animate">
        <div class="header-icon">
            <i class="bi bi-calendar2-week-fill"></i>
        </div>
        <div class="flex-grow-1">
            <h1 class="page-title">Məzuniyyət İdarəetməsi</h1>
            <p class="page-subtitle">Bütün işçi məzuniyyət müraciətlərini idarə edin</p>
        </div>
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Create" class="btn-mez-primary">
            <i class="bi bi-plus-lg"></i> Yeni Müraciət
        </a>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3 mez-animate mez-animate-delay-1">
            <div class="mez-stat-card">
                <div class="stat-icon stat-icon-primary"><i class="bi bi-calendar3"></i></div>
                <div class="stat-value">@total</div>
                <div class="stat-label">Ümumi Müraciət</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mez-animate mez-animate-delay-2">
            <div class="mez-stat-card">
                <div class="stat-icon stat-icon-warning"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-value">@pending</div>
                <div class="stat-label">Gözləyən</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mez-animate mez-animate-delay-3">
            <div class="mez-stat-card">
                <div class="stat-icon stat-icon-success"><i class="bi bi-check-circle"></i></div>
                <div class="stat-value">@approved</div>
                <div class="stat-label">Təsdiqlənmiş</div>
            </div>
        </div>
        <div class="col-6 col-lg-3 mez-animate mez-animate-delay-4">
            <div class="mez-stat-card">
                <div class="stat-icon stat-icon-danger"><i class="bi bi-x-circle"></i></div>
                <div class="stat-value">@rejected</div>
                <div class="stat-label">İmtina Edilmiş</div>
            </div>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="mez-card mez-animate">

        <!-- Filter Bar -->
        <div class="mez-filter-bar">
            <div class="mez-search-wrap">
                <i class="bi bi-search search-icon"></i>
                <input type="text"
                       id="mez-search"
                       class="mez-search-input"
                       placeholder="İşçi adı, şöbə axtar..." />
            </div>

            <select id="mez-filter-status" class="mez-filter-select">
                <option value="">Bütün Statuslar</option>
                <option value="1">Gözləmədə</option>
                <option value="2">Şöbə Rəisi</option>
                <option value="3">Rəhbər</option>
                <option value="4">HR Təsdiqi</option>
                <option value="5">Təsdiqlənib</option>
                <option value="6">İmtina</option>
            </select>

            <select id="mez-filter-type" class="mez-filter-select">
                <option value="">Bütün Növlər</option>
                <option value="1">İllik</option>
                <option value="2">Xəstəlik</option>
                <option value="3">Ezamiyyət</option>
            </select>

            <span class="ms-auto text-muted" style="font-size:0.8rem;" id="mez-row-count">@list.Count nəticə</span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="mez-table">
                <thead>
                    <tr>
                        <th data-sort="employee">İşçi <i class="bi bi-arrow-down-up ms-1 opacity-50"></i></th>
                        <th>Şöbə / Vəzifə</th>
                        <th data-sort="type">Növ</th>
                        <th data-sort="start">Tarix Aralığı</th>
                        <th>İş Günü</th>
                        <th>Əmr №</th>
                        <th data-sort="status">Status</th>
                        <th style="width:100px;">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody id="mez-table-body">
                    @if (!list.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="mez-empty">
                                    <div class="mez-empty-icon"><i class="bi bi-calendar-x"></i></div>
                                    <div class="mez-empty-title">Heç bir məzuniyyət tapılmadı</div>
                                    <div class="mez-empty-desc">Hələlik məzuniyyət müraciəti yoxdur.</div>
                                    <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Create" class="btn-mez-primary">
                                        <i class="bi bi-plus-lg"></i> İlk Müraciəti Yarat
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in list)
                        {
                            <tr data-row
                                data-employee="@item.IsciAdSoyad"
                                data-status="@((int)item.Status)"
                                data-type="@((int)item.Nov)"
                                data-start="@item.BaslamaTarixi.ToString("yyyy-MM-dd")">
                                <td>
                                    <div class="employee-cell">
                                        <div class="employee-avatar" data-name="@item.IsciAdSoyad"></div>
                                        <div>
                                            <div class="employee-name">@item.IsciAdSoyad</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="font-size:0.85rem; font-weight:600; color:var(--gray-800);">@item.SobeAdi</div>
                                    <div style="font-size:0.75rem; color:var(--gray-400);">@item.VezifeAdi</div>
                                </td>
                                <td>
                                    <span class="mez-type-pill @TypeClass(item.Nov)">
                                        <i class="bi @TypeIcon(item.Nov)"></i>
                                        @item.NovText
                                    </span>
                                </td>
                                <td>
                                    <div class="date-range">
                                        <span>@item.BaslamaTarixi.ToString("dd.MM.yyyy")</span>
                                        <i class="bi bi-arrow-right date-arrow"></i>
                                        <span>@item.BitmeTarixi.ToString("dd.MM.yyyy")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="days-pill">@item.IsGunlerininSayi g</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.EmrNomresi))
                                    {
                                        <span style="font-family:monospace;font-weight:700;color:#0f172a;background:#f1f5f9;padding:3px 8px;border-radius:4px;font-size:12px">@item.EmrNomresi</span>
                                        @if (item.EmrIl.HasValue)
                                        {
                                            <div style="font-size:10px;color:#94a3b8;margin-top:2px">@item.EmrIl</div>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:#cbd5e1;font-size:12px">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="mez-badge @StatusBadgeClass(item.Status)">
                                        <i class="bi @StatusIcon(item.Status)"></i>
                                        @StatusText(item.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Detail" asp-route-id="@item.Id"
                                           class="mez-action-btn view-btn"
                                           data-bs-toggle="tooltip" title="Bax">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Edit" asp-route-id="@item.Id"
                                           class="mez-action-btn edit-btn"
                                           data-bs-toggle="tooltip" title="Redaktə">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="mez-action-btn del-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@item.Id"
                                                data-name="@item.IsciAdSoyad"
                                                title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!list.Any()) { }
        else
        {
            <div id="mez-empty-state" style="display:none;">
                <div class="mez-empty">
                    <div class="mez-empty-icon"><i class="bi bi-search"></i></div>
                    <div class="mez-empty-title">Nəticə tapılmadı</div>
                    <div class="mez-empty-desc">Axtarış kriteriyalarınıza uyğun məlumat yoxdur.</div>
                </div>
            </div>
        }

        <!-- Pagination placeholder -->
        <div class="mez-pagination">
            <span class="pagination-info">Cəmi <strong>@list.Count</strong> müraciət</span>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item disabled"><a class="page-link" href="#">«</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item disabled"><a class="page-link" href="#">»</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script src="~/js/hr/mezuniyyet.js" asp-append-version="true"></script>
}
