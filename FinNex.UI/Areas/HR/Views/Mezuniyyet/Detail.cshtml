@model FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Məzuniyyət Təfərrüatı";
    Layout = "~/Views/Shared/_Layout.cshtml";

    static string StatusBadgeClass(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "mez-badge-gozlemede",
        MezuniyyetStatus.SobeReisiTesdiqinde => "mez-badge-sobe",
        MezuniyyetStatus.RehberTesdiqinde => "mez-badge-rehber",
        MezuniyyetStatus.HrTesdiqinde => "mez-badge-hr",
        MezuniyyetStatus.Tesdiqlenib => "mez-badge-tesdiq",
        MezuniyyetStatus.ImtinaEdildi => "mez-badge-imtina",
        _ => ""
    };

    static string StatusText(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "Gözləmədə",
        MezuniyyetStatus.SobeReisiTesdiqinde => "Şöbə Rəisi Təsdiqi",
        MezuniyyetStatus.RehberTesdiqinde => "Rəhbər Təsdiqi",
        MezuniyyetStatus.HrTesdiqinde => "HR Təsdiqi",
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.ImtinaEdildi => "İmtina Edildi",
        _ => s.ToString()
    };

    static string TypeClass(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "type-illik",
        MezuniyyetNovu.Xestelik => "type-xestelik",
        MezuniyyetNovu.Ezamiyyet => "type-ezamiyyet",
        _ => ""
    };

    static string TypeIcon(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Illik => "bi-sun",
        MezuniyyetNovu.Xestelik => "bi-heart-pulse",
        MezuniyyetNovu.Ezamiyyet => "bi-airplane",
        _ => "bi-calendar"
    };

    static string WorkflowStepClass(bool? approved) =>
        approved == true ? "step-approved" : approved == false ? "step-rejected" : "";

    static string WorkflowIcon(bool? approved) =>
        approved == true ? "bi-check-circle-fill text-success" : approved == false ? "bi-x-circle-fill text-danger" : "bi-clock text-warning";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/mezuniyyet.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb" style="font-size:0.8rem;">
            <li class="breadcrumb-item">
                <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index"
                   style="color:var(--primary-light); text-decoration:none;">Məzuniyyətlər</a>
            </li>
            <li class="breadcrumb-item active">Müraciət #@Model?.Id</li>
        </ol>
    </nav>

    <!-- Detail Header -->
    <div class="mez-detail-header mez-animate">
        <div class="detail-status-row">
            <span class="mez-type-pill @TypeClass(Model?.Nov ?? MezuniyyetNovu.Illik)"
                  style="background:rgba(255,255,255,0.18); color:#fff; border:1px solid rgba(255,255,255,0.3);">
                <i class="bi @TypeIcon(Model?.Nov ?? MezuniyyetNovu.Illik)"></i>
                @(Model?.Nov.ToString() ?? "—")
            </span>
            <span class="mez-badge @StatusBadgeClass(Model?.Status ?? MezuniyyetStatus.Gozlemede)"
                  style="padding: 0.4rem 1rem; font-size:0.8rem;">
                @StatusText(Model?.Status ?? MezuniyyetStatus.Gozlemede)
            </span>
        </div>

        <div class="detail-employee-info">
            <h2>@Model?.IsciAdSoyad</h2>
            <p><i class="bi bi-building me-1"></i>@Model?.SobeAdi &nbsp;·&nbsp; <i class="bi bi-briefcase me-1"></i>@Model?.VezifeAdi</p>
        </div>

        <div class="detail-dates-banner">
            <div class="detail-date-item">
                <div class="label">Başlama</div>
                <div class="value">@Model?.BaslamaTarixi.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="detail-date-divider">→</div>
            <div class="detail-date-item">
                <div class="label">Bitmə</div>
                <div class="value">@Model?.BitmeTarixi.ToString("dd MMMM yyyy")</div>
            </div>
            <div class="detail-date-divider">·</div>
            <div class="detail-date-item">
                <div class="label">İş Günü</div>
                <div class="value" style="font-family:var(--font-mono);">@Model?.IsGunlerininSayi gün</div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex gap-2 mb-4 mez-animate mez-animate-delay-1">
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index" class="btn-mez-secondary">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Edit" asp-route-id="@Model?.Id"
           class="btn-mez-primary">
            <i class="bi bi-pencil"></i> Redaktə Et
        </a>
        <button class="btn-mez-danger ms-auto"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-id="@Model?.Id"
                data-name="@Model?.IsciAdSoyad">
            <i class="bi bi-trash3"></i> Sil
        </button>
    </div>

    <div class="row g-4">

        <!-- Left Column -->
        <div class="col-lg-7 mez-animate mez-animate-delay-1">

            <!-- Leave Details -->
            <div class="mez-card mb-4">
                <div class="mez-card-header">
                    <i class="bi bi-info-circle text-primary"></i>
                    <h5 class="card-header-title">Müraciət Məlumatları</h5>
                </div>
                <div class="mez-card-body">
                    <div class="mez-info-grid">
                        <div class="mez-info-item">
                            <div class="info-label">Müraciət ID</div>
                            <div class="info-value" style="font-family:var(--font-mono);">#@Model?.Id</div>
                        </div>
                        <div class="mez-info-item">
                            <div class="info-label">Məzuniyyət Növü</div>
                            <div class="info-value">
                                <span class="mez-type-pill @TypeClass(Model?.Nov ?? MezuniyyetNovu.Illik)">
                                    <i class="bi @TypeIcon(Model?.Nov ?? MezuniyyetNovu.Illik)"></i>
                                    @(Model?.Nov.ToString() ?? "—")
                                </span>
                            </div>
                        </div>
                        <div class="mez-info-item">
                            <div class="info-label">İşçi</div>
                            <div class="info-value">@Model?.IsciAdSoyad</div>
                        </div>
                        <div class="mez-info-item">
                            <div class="info-label">Əvəzedici</div>
                            <div class="info-value">
                                @(string.IsNullOrEmpty(Model?.EvezEdenIsciAdSoyad) ? "—" : Model.EvezEdenIsciAdSoyad)
                            </div>
                        </div>
                        <div class="mez-info-item">
                            <div class="info-label">Şöbə</div>
                            <div class="info-value">@Model?.SobeAdi</div>
                        </div>
                        <div class="mez-info-item">
                            <div class="info-label">Vəzifə</div>
                            <div class="info-value">@Model?.VezifeAdi</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.Qeyd))
                    {
                        <div class="mt-3 pt-3" style="border-top:1px dashed var(--gray-200);">
                            <div class="info-label mb-2" style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; color:var(--gray-400);">Qeyd</div>
                            <p style="font-size:0.875rem; color:var(--gray-700); margin:0; line-height:1.6;">@Model.Qeyd</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model?.ImtinaSebebi))
                    {
                        <div class="mt-3 p-3 rounded" style="background:var(--danger-pale); border:1px solid #fecaca;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-exclamation-triangle-fill" style="color:var(--danger);"></i>
                                <span style="font-size:0.75rem; font-weight:700; text-transform:uppercase; color:var(--danger);">İmtina Səbəbi</span>
                            </div>
                            <p style="font-size:0.875rem; color:#991b1b; margin:0; line-height:1.6;">@Model.ImtinaSebebi</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Workflow -->
        <div class="col-lg-5 mez-animate mez-animate-delay-2">
            <div class="mez-card">
                <div class="mez-card-header">
                    <i class="bi bi-diagram-3 text-primary"></i>
                    <h5 class="card-header-title">Təsdiq Tarixçəsi</h5>
                </div>
                <div class="mez-card-body">
                    <div class="workflow-timeline">

                        <!-- Step 1: Şöbə Rəisi -->
                        <div class="workflow-step @WorkflowStepClass(Model?.SobeReisiTesdiq)">
                            <div class="step-title">
                                <i class="bi @WorkflowIcon(Model?.SobeReisiTesdiq) me-2"></i>
                                Şöbə Rəisi
                            </div>
                            @if (Model?.SobeReisiTesdiqTarixi.HasValue == true)
                            {
                                <div class="step-meta">@Model.SobeReisiTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            else
                            {
                                <div class="step-meta">Gözlənilir...</div>
                            }
                        </div>

                        <!-- Step 2: Rəhbər -->
                        <div class="workflow-step @WorkflowStepClass(Model?.RehberTesdiq)">
                            <div class="step-title">
                                <i class="bi @WorkflowIcon(Model?.RehberTesdiq) me-2"></i>
                                Rəhbərlik
                            </div>
                            @if (Model?.RehberTesdiqTarixi.HasValue == true)
                            {
                                <div class="step-meta">@Model.RehberTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            else
                            {
                                <div class="step-meta">Gözlənilir...</div>
                            }
                        </div>

                        <!-- Step 3: HR -->
                        <div class="workflow-step @WorkflowStepClass(Model?.HrTesdiq)">
                            <div class="step-title">
                                <i class="bi @WorkflowIcon(Model?.HrTesdiq) me-2"></i>
                                HR Şöbəsi
                            </div>
                            @if (Model?.HrTesdiqTarixi.HasValue == true)
                            {
                                <div class="step-meta">@Model.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            else
                            {
                                <div class="step-meta">Gözlənilir...</div>
                            }
                        </div>

                        <!-- Final -->
                        <div class="workflow-step @(Model?.Status == MezuniyyetStatus.Tesdiqlenib ? "step-approved" : Model?.Status == MezuniyyetStatus.ImtinaEdildi ? "step-rejected" : "")">
                            <div class="step-title">
                                <i class="bi @(Model?.Status == MezuniyyetStatus.Tesdiqlenib ? "bi-check-circle-fill text-success" : Model?.Status == MezuniyyetStatus.ImtinaEdildi ? "bi-x-circle-fill text-danger" : "bi-circle text-muted") me-2"></i>
                                Nəticə
                            </div>
                            <div class="step-meta">
                                <span class="mez-badge @StatusBadgeClass(Model?.Status ?? MezuniyyetStatus.Gozlemede)">
                                    @StatusText(Model?.Status ?? MezuniyyetStatus.Gozlemede)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <script src="~/js/hr/mezuniyyet.js" asp-append-version="true"></script>
}
