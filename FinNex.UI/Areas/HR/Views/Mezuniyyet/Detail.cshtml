@model FinNex.UI.Areas.HR.ViewModels.Mezuniyyet.HrMezuniyyetDetalVM
@using FinNex.Domain.Entities.HR
@using FinNex.Domain
@using FinNex.Application.Common.Extensions
@{
    ViewData["Title"] = "Qeyd Detalı";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var m = Model.Mezuniyyet;

    static string StatusText(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.ImtinaEdildi => "İmtina Edildi",
        MezuniyyetStatus.Gozlemede => "Gözləmədə",
        _ => s.ToString()
    };

    static string StatusColor(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Tesdiqlenib => "#1e9b6b",
        MezuniyyetStatus.ImtinaEdildi => "#c0392b",
        _ => "#e8b84b"
    };

    static string NovText(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Xestelik => "Xəstəlik",
        MezuniyyetNovu.Ezamiyyet => "Ezamiyyət",
        MezuniyyetNovu.Illik => "Əmək məzuniyyəti",
        MezuniyyetNovu.DovletVezifelerininIcrasi => "Dövlət Vəzifəsi",
        _ => n.Adi()
    };

    static string NovColor(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Xestelik => "#a855f7",
        MezuniyyetNovu.Ezamiyyet => "#f97316",
        _ => "#2d6cdf"
    };

    static string OdenisTipiText(MezuniyyetOdenisTipi t) => t switch
    {
        MezuniyyetOdenisTipi.QabaqcadanOdenis => "Qabaqcadan ödəniş",
        _ => "Ay sonu ödəniş"
    };

    static string OdenisStatusText(MezuniyyetOdenisStatus s) => s switch
    {
        MezuniyyetOdenisStatus.Gozleyir => "Mühasib gözləyir",
        MezuniyyetOdenisStatus.Odenilib => "Ödənilib",
        MezuniyyetOdenisStatus.PlanliOdenis => "Planlı ödəniş",
        _ => "Tətbiq edilmir"
    };
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Qeyd #@m.Id</div>
            <div class="fn-page-sub">@m.IsciAdSoyad · @NovText(m.Nov)</div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            @if (m.Status == MezuniyyetStatus.Tesdiqlenib && m.Nov == MezuniyyetNovu.Illik)
            {
                <button type="button" onclick="korreksiyaModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px solid #e8b84b;background:#fffbea;color:#b45309;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-shield-check"></i> Dövlət Vəzifəsi Korreksiyası
                </button>
            }
            @* HR ləğvi YALNIZ işçinin ləğv müraciəti əsasında — müraciət yoxdursa düymə görünmür *@
            @if ((User.IsInRole(RoleNames.HR) || User.IsInRole(RoleNames.Admin))
                 && m.Status == MezuniyyetStatus.Tesdiqlenib
                 && m.BaslamaTarixi.Date > DateTime.Today
                 && m.OdenisStatus != MezuniyyetOdenisStatus.Odenilib
                 && m.OdenisStatus != MezuniyyetOdenisStatus.PlanliOdenis
                 && m.LegvTelebEdilib)
            {
                <button type="button" onclick="legvModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px solid #ef4444;background:#fef2f2;color:#b91c1c;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-check-circle"></i> Ləğvi təsdiqlə
                </button>
                <button type="button" onclick="legvRedModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px solid #e8b84b;background:#fffbea;color:#b45309;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-x-circle"></i> Ləğvi rədd et
                </button>
            }
            @if ((User.IsInRole(RoleNames.HR) || User.IsInRole(RoleNames.Admin))
                 && m.Status == MezuniyyetStatus.Tesdiqlenib
                 && m.BaslamaTarixi.Date > DateTime.Today
                 && m.OdenisStatus != MezuniyyetOdenisStatus.Odenilib
                 && m.OdenisStatus != MezuniyyetOdenisStatus.PlanliOdenis)
            {
                <button type="button" onclick="tarixModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px solid #6366f1;background:#eef2ff;color:#4338ca;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-calendar-event"></i> Tarix dəyiş
                </button>
            }
            @* ADMIN: başlayıb/keçmiş məzuniyyət üçün tarix düzəlişi (HR-in edə bilmədiyi hal) *@
            @if (User.IsInRole(RoleNames.Admin)
                 && m.Status == MezuniyyetStatus.Tesdiqlenib
                 && m.BaslamaTarixi.Date <= DateTime.Today
                 && m.OdenisStatus != MezuniyyetOdenisStatus.Odenilib
                 && m.OdenisStatus != MezuniyyetOdenisStatus.PlanliOdenis)
            {
                <button type="button" onclick="adminTarixModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:8px;border:1.5px solid #b45309;background:#fff7ed;color:#9a3412;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-shield-lock"></i> Tarix düzəlt (admin)
                </button>
            }
            @{
                var backAction = string.IsNullOrEmpty(Model.ReturnAction) ? "Hr" : Model.ReturnAction;
                var backActionMapped = backAction switch
                {
                    "HrTesdiq" => "Hr",
                    "RehberTesdiq" => "Rehber",
                    "SobeReisiTesdiq" => "Hr",
                    _ => backAction
                };
            }
            <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="@backActionMapped"
               class="fn-btn fn-btn--outline">← Geri</a>
        </div>
    </div>

    <div style="display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
        <span style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;background:@(StatusColor(m.Status))1a;color:@(StatusColor(m.Status));">
            <span style="width:7px;height:7px;border-radius:50%;background:@(StatusColor(m.Status));"></span>
            @StatusText(m.Status)
        </span>
        <span style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;background:@(NovColor(m.Nov))1a;color:@(NovColor(m.Nov));">
            @NovText(m.Nov)
        </span>
        @if (!string.IsNullOrEmpty(m.EmrNomresi))
        {
            <span style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:700;background:#eff6ff;color:#1e40af;font-family:monospace">
                📄 @m.EmrNomresi @(m.EmrIl.HasValue ? $"· {m.EmrIl}" : "")
            </span>
        }
    </div>

    @* ── İşçinin ləğv müraciəti — görünən banner ── *@
    @if (m.LegvTelebEdilib)
    {
        <div class="fn-card" style="max-width:860px;border-left:4px solid #ef4444;background:#fff7ed;margin-bottom:14px;">
            <div style="display:flex;align-items:flex-start;gap:12px;">
                <i class="bi bi-exclamation-octagon-fill" style="font-size:22px;color:#dc2626;"></i>
                <div style="flex:1;">
                    <div style="font-weight:700;color:#9a3412;font-size:14.5px;margin-bottom:4px;">
                        İşçi bu məzuniyyətin LƏĞVİNİ istəyir
                        @if (m.LegvTelebTarixi.HasValue)
                        {
                            <span style="font-weight:500;color:#c2712c;font-size:12.5px;"> · @m.LegvTelebTarixi.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </div>
                    <div style="font-size:13px;color:#7c2d12;line-height:1.6;">
                        <b>Səbəb:</b> @(string.IsNullOrWhiteSpace(m.LegvTelebSebebi) ? "—" : m.LegvTelebSebebi)
                    </div>
                    <div style="font-size:12px;color:#9a6a10;margin-top:8px;">
                        Yuxarıdakı <b>"Ləğvi təsdiqlə"</b> (məzuniyyət ləğv olunur, balans geri qaytarılır) və ya
                        <b>"Ləğvi rədd et"</b> (məzuniyyət qüvvədə qalır) düymələri ilə cavablandırın.
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="fn-card" style="max-width:860px;">
        <div class="fn-card-title" style="margin-bottom:14px;">Qeyd məlumatları</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div class="fn-form-group">
                <div class="fn-sbi-label">İşçi</div>
                <div style="font-size:13px;color:#1a2332;font-weight:500;">@m.IsciAdSoyad</div>
            </div>
            <div class="fn-form-group">
                <div class="fn-sbi-label">Şöbə / Vəzifə</div>
                <div style="font-size:13px;color:#1a2332;">@m.SobeAdi · @m.VezifeAdi</div>
            </div>
            <div class="fn-form-group">
                <div class="fn-sbi-label">Başlama tarixi</div>
                <div style="font-size:13px;color:#1a2332;font-weight:500;">@m.BaslamaTarixi.ToString("dd.MM.yyyy")</div>
            </div>
            <div class="fn-form-group">
                <div class="fn-sbi-label">Bitmə tarixi</div>
                <div style="font-size:13px;color:#1a2332;font-weight:500;">@m.BitmeTarixi.ToString("dd.MM.yyyy")</div>
            </div>
            <div class="fn-form-group">
                <div class="fn-sbi-label">İş günü</div>
                <div style="font-size:13px;color:#1a2332;font-weight:600;">@m.IsGunlerininSayi gün</div>
            </div>
            <div class="fn-form-group">
                <div class="fn-sbi-label">ƌvəzedici</div>
                <div style="font-size:13px;color:#1a2332;">@(string.IsNullOrEmpty(m.EvezEdenIsciAdSoyad) ? "—" : m.EvezEdenIsciAdSoyad)</div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(m.Qeyd))
        {
            <div style="margin-top:14px;padding-top:14px;border-top:1px solid #e4e8f0;">
                <div class="fn-sbi-label">Qeyd</div>
                <div style="font-size:13px;color:#3d4557;margin-top:4px;line-height:1.6;">@m.Qeyd</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(m.ImtinaSebebi))
        {
            <div style="margin-top:14px;padding:10px 12px;background:#fef0f0;border:1px solid #f5c0c0;border-radius:8px;">
                <div style="font-size:11px;font-weight:600;color:#c0392b;margin-bottom:4px;">İmtina səbəbi</div>
                <div style="font-size:13px;color:#991b1b;line-height:1.5;">@m.ImtinaSebebi</div>
            </div>
        }

        @if (m.HrTesdiqTarixi.HasValue)
        {
            <div style="margin-top:14px;padding-top:14px;border-top:1px solid #e4e8f0;">
                <div class="fn-sbi-label">Təsdiq tarixi</div>
                <div style="font-size:13px;color:#1a2332;">@m.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
        }
    </div>

    @* ── Ödəniş tipi (HR düzəliş — yalnız təsdiqlənmiş məzuniyyətdə) ────────── *@
    @if ((User.IsInRole(RoleNames.HR) || User.IsInRole(RoleNames.Admin)) && m.Status == MezuniyyetStatus.Tesdiqlenib)
    {
        var avansIcraOlunub = m.OdenisStatus == MezuniyyetOdenisStatus.Odenilib
                           || m.OdenisStatus == MezuniyyetOdenisStatus.PlanliOdenis;
        var baslamaKecib = m.BaslamaTarixi.Date <= DateTime.Today;
        var deyiseBiler = !avansIcraOlunub && !baslamaKecib;
        var isQabaqcadan = m.OdenisTipi == MezuniyyetOdenisTipi.QabaqcadanOdenis;
        var hedefTipi = isQabaqcadan
            ? MezuniyyetOdenisTipi.AySonuOdenis
            : MezuniyyetOdenisTipi.QabaqcadanOdenis;

        <div class="fn-card" style="max-width:860px;margin-top:14px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-cash-coin" style="margin-right:6px;color:#1e9b6b;"></i>
                Ödəniş tipi
            </div>

            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
                <span style="display:inline-flex;align-items:center;gap:5px;padding:5px 12px;border-radius:20px;font-size:12px;font-weight:600;background:@(isQabaqcadan ? "#ecfdf5" : "#eff6ff");color:@(isQabaqcadan ? "#047857" : "#1e40af");">
                    @OdenisTipiText(m.OdenisTipi)
                </span>
                @if (isQabaqcadan)
                {
                    <span style="font-size:12px;color:#6b7280;">
                        Status: <b style="color:#374151;">@OdenisStatusText(m.OdenisStatus)</b>
                        @if (m.OdenenMebleg.HasValue)
                        {
                            <text> · Məbləğ: <b style="color:#374151;">@m.OdenenMebleg.Value.ToString("N2") ₼</b></text>
                        }
                        @if (m.PlanliOdenisTarixi.HasValue)
                        {
                            <text> · Plan: <b style="color:#374151;">@m.PlanliOdenisTarixi.Value.ToString("dd.MM.yyyy")</b></text>
                        }
                    </span>
                }
            </div>

            @if (deyiseBiler)
            {
                <div style="font-size:12px;color:#6b7280;margin-bottom:12px;line-height:1.6;">
                    @(isQabaqcadan
                        ? "Qabaqcadan ödənişi ləğv edib ay-sonu ödənişə qaytara bilərsiniz (avans hələ icra olunmayıb)."
                        : "Bu məzuniyyəti qabaqcadan (avans) ödənişə keçirə bilərsiniz — məbləğ hesablanıb Mühasibə göndəriləcək.")
                </div>
                <button type="button" onclick="odenisTipiModalAc()"
                        style="display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;border:none;background:@(isQabaqcadan ? "#6b7280" : "#1e9b6b");color:#fff;font-size:13px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-arrow-left-right"></i>
                    @(isQabaqcadan ? "Ay sonu ödənişə qaytar" : "Qabaqcadan ödənişə keçir")
                </button>
            }
            else
            {
                <div style="font-size:12px;color:#9a6a10;background:#fffbea;border:1px solid #fde68a;border-radius:8px;padding:10px 12px;line-height:1.6;">
                    <i class="bi bi-lock" style="margin-right:5px;"></i>
                    @(baslamaKecib
                        ? "Məzuniyyət başlayıb (və ya bu gün başlayır) — ödəniş tipi dəyişdirilə bilməz."
                        : "Qabaqcadan ödəniş artıq icra olunub/planlanıb — dəyişiklik mümkün deyil. Pulun geri-alınması əl ilə həll olunmalıdır.")
                </div>
            }
        </div>

        @* Ödəniş tipi dəyişmə — təsdiq modalı *@
        <div id="odenisTipiModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
            <div style="background:#fff;border-radius:12px;width:100%;max-width:460px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                    <div style="font-size:15px;font-weight:700;color:#1a2332;">
                        <i class="bi bi-arrow-left-right" style="margin-right:6px;color:#1e9b6b;"></i>
                        Ödəniş tipini dəyiş
                    </div>
                    <button type="button" onclick="odenisTipiModalBag()" style="background:none;border:none;font-size:18px;color:#6b7280;cursor:pointer;line-height:1;">×</button>
                </div>
                <form asp-area="HR" asp-controller="Mezuniyyet" asp-action="HrOdenisTipiDeyis" method="post">
                    <input type="hidden" name="id" value="@m.Id" />
                    <input type="hidden" name="yeniTipi" value="@((int)hedefTipi)" />
                    <div style="padding:20px;font-size:13px;color:#374151;line-height:1.7;">
                        <b>@m.IsciAdSoyad</b> üçün ödəniş tipi
                        <b>@OdenisTipiText(m.OdenisTipi)</b> → <b>@OdenisTipiText(hedefTipi)</b> olaraq dəyişdiriləcək.
                        @if (hedefTipi == MezuniyyetOdenisTipi.QabaqcadanOdenis)
                        {
                            <div style="margin-top:10px;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:8px;padding:10px 12px;color:#065f46;">
                                Avans məbləği hesablanacaq, status «Mühasib gözləyir» olacaq və Mühasibə bildiriş göndəriləcək.
                            </div>
                        }
                        else
                        {
                            <div style="margin-top:10px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:10px 12px;color:#1e40af;">
                                Avans qeydləri sıfırlanacaq və ödəniş maaşla birlikdə ay sonunda hesablanacaq.
                            </div>
                        }
                    </div>
                    <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid #e4e8f0;">
                        <button type="button" onclick="odenisTipiModalBag()" style="padding:8px 18px;border-radius:8px;border:1.5px solid #d1d5db;background:#fff;color:#374151;font-size:13px;font-weight:600;cursor:pointer;">Ləğv et</button>
                        <button type="submit" style="padding:8px 18px;border-radius:8px;border:none;background:#1e9b6b;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">Təsdiq et</button>
                    </div>
                </form>
            </div>
        </div>

        <script>
            function odenisTipiModalAc() { document.getElementById('odenisTipiModal').style.display = 'flex'; }
            function odenisTipiModalBag() { document.getElementById('odenisTipiModal').style.display = 'none'; }
        </script>
    }

    @* ── HR Ləğv — təsdiq modalı (yalnız təsdiqlənmiş, başlanğıc keçməyib, avans icra olunmayıb) ── *@
    @if ((User.IsInRole(RoleNames.HR) || User.IsInRole(RoleNames.Admin))
         && m.Status == MezuniyyetStatus.Tesdiqlenib
         && m.BaslamaTarixi.Date > DateTime.Today
         && m.OdenisStatus != MezuniyyetOdenisStatus.Odenilib
         && m.OdenisStatus != MezuniyyetOdenisStatus.PlanliOdenis
         && m.LegvTelebEdilib)
    {
        var qabaqcadanGozleyir = m.OdenisTipi == MezuniyyetOdenisTipi.QabaqcadanOdenis
                              && m.OdenisStatus == MezuniyyetOdenisStatus.Gozleyir;

        <div id="legvModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
            <div style="background:#fff;border-radius:12px;width:100%;max-width:460px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                    <div style="font-size:15px;font-weight:700;color:#b91c1c;">
                        <i class="bi bi-check-circle" style="margin-right:6px;"></i>
                        İşçinin ləğv müraciətini təsdiqlə
                    </div>
                    <button type="button" onclick="legvModalBag()" style="background:none;border:none;font-size:18px;color:#6b7280;cursor:pointer;line-height:1;">×</button>
                </div>
                <form asp-area="HR" asp-controller="Mezuniyyet" asp-action="HrLegvEt" method="post">
                    <input type="hidden" name="id" value="@m.Id" />
                    <div style="padding:20px;">
                        <div style="margin-bottom:14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 12px;font-size:12.5px;color:#9a3412;line-height:1.7;">
                            <i class="bi bi-person-exclamation" style="margin-right:5px;"></i>
                            <b>İşçinin ləğv müraciəti</b>@(m.LegvTelebTarixi.HasValue ? $" ({m.LegvTelebTarixi:dd.MM.yyyy HH:mm})" : "")<br />
                            <span style="color:#7c2d12;">Səbəb:</span> @(string.IsNullOrWhiteSpace(m.LegvTelebSebebi) ? "—" : m.LegvTelebSebebi)
                        </div>
                        <div style="font-size:13px;color:#374151;line-height:1.7;margin-bottom:14px;">
                            <b>@m.IsciAdSoyad</b> üçün <b>@m.BaslamaTarixi.ToString("dd.MM.yyyy") – @m.BitmeTarixi.ToString("dd.MM.yyyy")</b>
                            təsdiqlənmiş məzuniyyət ləğv ediləcək. Balans geri qaytarılacaq, davamiyyət qeydləri silinəcək.
                        </div>
                        @if (qabaqcadanGozleyir)
                        {
                            <div style="margin-bottom:14px;background:#fffbea;border:1px solid #fde68a;border-radius:8px;padding:10px 12px;font-size:12px;color:#9a6a10;line-height:1.6;">
                                <i class="bi bi-exclamation-triangle" style="margin-right:5px;"></i>
                                Bu məzuniyyətin <b>gözləyən qabaqcadan ödənişi</b> var — sıfırlanacaq və Mühasibə bildiriş göndəriləcək.
                            </div>
                        }
                        <label class="fn-sbi-label">HR qeydi (opsional)</label>
                        <textarea name="sebeb" class="fn-input" rows="2" placeholder="Qeyd (opsional)..."></textarea>
                    </div>
