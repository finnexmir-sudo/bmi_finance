        <div id="tarixModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
            <div style="background:#fff;border-radius:12px;width:100%;max-width:480px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
                <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                    <div style="font-size:15px;font-weight:700;color:#1a2332;">
