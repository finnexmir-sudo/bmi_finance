    @* ── Dövlət Vəzifəsi — sənədlər + sonradan əlavə ───────────────────────── *@
    @if (m.Nov == MezuniyyetNovu.DovletVezifelerininIcrasi)
    {
        <div class="fn-card" style="max-width:860px;margin-top:14px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <div class="fn-card-title" style="margin:0;">
                    <i class="bi bi-paperclip" style="margin-right:6px;color:#6b7280;"></i>
                    Sənədlər
                </div>
                <button type="button" onclick="senedElavetModalAc()"
                        style="display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:7px;border:1.5px solid #2d6cdf;background:#eff6ff;color:#1e40af;font-size:12px;font-weight:600;cursor:pointer;">
                    <i class="bi bi-plus-lg"></i> Sənəd əlavə et
                </button>
            </div>

            @if (m.SenedYollari.Count == 0)
            {
                <div style="font-size:13px;color:#9ca3af;padding:8px 0;">
                    Sənəd əlavə edilməyib.
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:6px;">
                    @for (int si = 0; si < m.SenedYollari.Count; si++)
                    {
                        var yol = m.SenedYollari[si];
                        var ext = System.IO.Path.GetExtension(yol).ToLowerInvariant();
                        var icon = ext == ".pdf" ? "bi-file-earmark-pdf" : "bi-file-earmark-image";
                        var iconColor = ext == ".pdf" ? "#ef4444" : "#6366f1";
                        <div style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:7px;">
                            <i class="bi @icon" style="color:@iconColor;font-size:16px;"></i>
                            <a href="@yol" target="_blank"
                               style="font-size:13px;color:#1e40af;text-decoration:none;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                Sənəd @(si + 1)@ext
                            </a>
                            <span style="font-size:11px;color:#9ca3af;">@ext.TrimStart('.')</span>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Bu dövrdə həmkarları ────────────────────────────────────── *@
    @if (Model.OverlapMezuniyyetler.Any())
    {
        <div class="fn-card" style="max-width:860px;margin-top:14px;">
            <div class="fn-card-title" style="margin-bottom:10px;">
                Bu dövrdə məzuniyyətdə olan/olacaq həmkarları (@Model.OverlapMezuniyyetler.Count)
            </div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:10px;">
                Aşağıdakı işçilər sizin baxdığınız dövrdə məzuniyyətdədir və ya təsdiq
                gözləyir. Paralel məzuniyyətlər şöbənin iş yükünü təsir edə bilər.
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;">
                @foreach (var o in Model.OverlapMezuniyyetler)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 12px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
                        <div>
                            <div style="font-size:13px;font-weight:600;color:#1a2332;">
                                @o.IsciAdSoyad
                                @if (o.EyniSobe)
                                {
                                    <span style="margin-left:6px;font-size:10.5px;padding:2px 7px;border-radius:10px;background:#fee2e2;color:#b91c1c;font-weight:600;">Eyni şöbə</span>
                                }
                            </div>
                            <div style="font-size:11.5px;color:#6b7280;margin-top:2px;">
                                @o.SobeAdi · @o.VezifeAdi · @NovText(o.Nov)
                            </div>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size:12px;color:#1a2332;font-weight:500;">
                                @o.BaslamaTarixi.ToString("dd.MM") – @o.BitmeTarixi.ToString("dd.MM.yyyy")
                            </div>
                            <div style="font-size:11px;color:@StatusColor(o.Status);margin-top:2px;">
                                @StatusText(o.Status) · @o.IsGunlerininSayi gün
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

</div>

@if (m.Status == MezuniyyetStatus.Tesdiqlenib && m.Nov == MezuniyyetNovu.Illik)
{
    @Html.AntiForgeryToken()

    <div id="korreksiyaModal"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:12px;width:100%;max-width:480px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                <div style="font-size:15px;font-weight:700;color:#1a2332;">
                    <i class="bi bi-shield-check" style="color:#e8b84b;margin-right:6px;"></i>
                    Dövlət Vəzifəsi Korreksiyası
                </div>
                <button type="button" onclick="korreksiyaModalBag()"
                        style="background:none;border:none;font-size:18px;color:#6b7280;cursor:pointer;line-height:1;">×</button>
            </div>
            <div style="padding:20px;">
                <div style="font-size:12px;color:#6b7280;margin-bottom:16px;line-height:1.6;background:#fffbea;border:1px solid #fde68a;border-radius:8px;padding:10px 12px;">
                    Əmək Məcəlləsi Maddə 173. Həmin günlər illik balansa geri qaytarılır və
                    dövlət vəzifəsi kimi ayrıca qeyd olunur.
                </div>

                <input type="hidden" id="kor_MezuniyyetId" value="@m.Id" />
                <input type="hidden" id="kor_IsciId" value="@m.IsciId" />

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
                    <div>
                        <label class="fn-sbi-label">Başlama tarixi</label>
                        <input type="date" id="kor_Baslama" class="fn-input"
                               min="@m.BaslamaTarixi.ToString("yyyy-MM-dd")"
                               max="@m.BitmeTarixi.ToString("yyyy-MM-dd")"
                               onchange="hesablaKorGun()" />
                    </div>
                    <div>
                        <label class="fn-sbi-label">Bitmə tarixi</label>
                        <input type="date" id="kor_Bitme" class="fn-input"
                               min="@m.BaslamaTarixi.ToString("yyyy-MM-dd")"
                               max="@m.BitmeTarixi.ToString("yyyy-MM-dd")"
                               onchange="hesablaKorGun()" />
                    </div>
                </div>

                <div style="margin-bottom:12px;">
                    <label class="fn-sbi-label">Korreksiya günü (iş günü)</label>
                    <input type="number" id="kor_GunSayi" class="fn-input" min="1" max="@m.IsGunlerininSayi"
                           placeholder="Tarix seçild ikdə avtomatik hesablanır" readonly
                           style="background:#f5f7fa;" />
                </div>

                <div style="margin-bottom:12px;">
                    <label class="fn-sbi-label">Qeyd / Səbəb</label>
                    <textarea id="kor_Qeyd" class="fn-input" rows="2"
                              placeholder="Hərbi çağırış, məhkəmə şahidliyi və s."></textarea>
                </div>

                <div style="margin-bottom:4px;">
                    <label class="fn-sbi-label">Sənəd(lər) (icazəli: pdf, jpg, jpeg, png)</label>
                    <input type="file" id="kor_Sened" class="fn-input"
                           accept=".pdf,.jpg,.jpeg,.png" multiple />
                    <div id="kor_SenedInfo" style="font-size:11px;color:#6b7280;margin-top:4px;"></div>
                </div>
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid #e4e8f0;">
                <button type="button" onclick="korreksiyaModalBag()"
                        style="padding:8px 18px;border-radius:8px;border:1.5px solid #d1d5db;background:#fff;color:#374151;font-size:13px;font-weight:600;cursor:pointer;">
                    Ləğv et
                </button>
                <button type="button" onclick="korreksiyaGonder()" id="kor_SendBtn"
                        style="padding:8px 18px;border-radius:8px;border:none;background:#e8b84b;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">
                    Tətbiq et
                </button>
            </div>
        </div>
    </div>

    <script>
        function korreksiyaModalAc() {
            document.getElementById('korreksiyaModal').style.display = 'flex';
        }
        function korreksiyaModalBag() {
            document.getElementById('korreksiyaModal').style.display = 'none';
        }

        document.getElementById('kor_Sened').addEventListener('change', function () {
            var info = document.getElementById('kor_SenedInfo');
            info.textContent = this.files.length > 0
                ? this.files.length + ' fayl seçildi'
                : '';
        });

        function hesablaKorGun() {
            var b = document.getElementById('kor_Baslama').value;
            var e = document.getElementById('kor_Bitme').value;
            if (!b || !e) return;
            var start = new Date(b), end = new Date(e);
            if (end < start) { document.getElementById('kor_GunSayi').value = ''; return; }
            var count = 0;
            var cur = new Date(start);
            while (cur <= end) {
                var day = cur.getDay();
                if (day !== 0 && day !== 6) count++;
                cur.setDate(cur.getDate() + 1);
            }
            document.getElementById('kor_GunSayi').value = count;
        }

        async function korreksiyaGonder() {
            var gun = parseInt(document.getElementById('kor_GunSayi').value);
            if (!gun || gun < 1) { alert('Tarix aralığı seçin.'); return; }

            var fd = new FormData();
            fd.append('MezuniyyetId', document.getElementById('kor_MezuniyyetId').value);
            fd.append('IsciId', document.getElementById('kor_IsciId').value);
            fd.append('BaslamaTarixi', document.getElementById('kor_Baslama').value);
            fd.append('BitmeTarixi', document.getElementById('kor_Bitme').value);
            fd.append('KorreksiyaGunSayi', gun);
            fd.append('Qeyd', document.getElementById('kor_Qeyd').value);

            var senedEl = document.getElementById('kor_Sened');
            for (var i = 0; i < senedEl.files.length; i++) {
                fd.append('Senedler', senedEl.files[i]);
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) fd.append('__RequestVerificationToken', token.value);

            var btn = document.getElementById('kor_SendBtn');
            btn.disabled = true; btn.textContent = 'Göndərilir...';

            try {
                var resp = await fetch('@Url.Action("Korreksiya", "Mezuniyyet", new { area = "HR" })', {
                    method: 'POST', body: fd
                });
                var json = await resp.json();
                if (json.ok) {
                    location.reload();
                } else {
                    alert(json.xeta || 'Xəta baş verdi.');
                    btn.disabled = false; btn.textContent = 'Tətbiq et';
                }
            } catch (e) {
                alert('Şəbəkə xətası.');
                btn.disabled = false; btn.textContent = 'Tətbiq et';
            }
        }
    </script>
}

@* ── Sonradan sənəd əlavə etmə modali (DovletVezife qeydlərindən açılır) *@
@if (m.Nov == MezuniyyetNovu.DovletVezifelerininIcrasi)
{
    @Html.AntiForgeryToken()

    <div id="senedElavetModal"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
        <div style="background:#fff;border-radius:12px;width:100%;max-width:420px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
            <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                <div style="font-size:15px;font-weight:700;color:#1a2332;">
                    <i class="bi bi-paperclip" style="color:#2d6cdf;margin-right:6px;"></i>
                    Sənəd Əlavə Et
                </div>
                <button type="button" onclick="senedElavetModalBag()"
                        style="background:none;border:none;font-size:18px;color:#6b7280;cursor:pointer;line-height:1;">×</button>
            </div>
            <div style="padding:20px;">
                <div style="font-size:12px;color:#6b7280;margin-bottom:14px;line-height:1.6;background:#eff6ff;border:1px solid #bfdbfe;border-radius:8px;padding:10px 12px;">
                    Mövcud sənədlər silinmir — yeni sənəd(lər) üstünə əlavə olunur.
                </div>
                <div>
                    <label class="fn-sbi-label">Sənəd(lər) seçin (pdf, jpg, jpeg, png)</label>
                    <input type="file" id="se_Sened" class="fn-input"
                           accept=".pdf,.jpg,.jpeg,.png" multiple />
                    <div id="se_SenedInfo" style="font-size:11px;color:#6b7280;margin-top:4px;"></div>
                </div>
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid #e4e8f0;">
                <button type="button" onclick="senedElavetModalBag()"
                        style="padding:8px 18px;border-radius:8px;border:1.5px solid #d1d5db;background:#fff;color:#374151;font-size:13px;font-weight:600;cursor:pointer;">
                    Ləğv et
                </button>
                <button type="button" onclick="senedElavetGonder()" id="se_SendBtn"
                        style="padding:8px 18px;border-radius:8px;border:none;background:#2d6cdf;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">
                    Yüklə
                </button>
            </div>
        </div>
    </div>

    <script>
        function senedElavetModalAc() {
            document.getElementById('se_Sened').value = '';
            document.getElementById('se_SenedInfo').textContent = '';
            document.getElementById('senedElavetModal').style.display = 'flex';
        }
        function senedElavetModalBag() {
            document.getElementById('senedElavetModal').style.display = 'none';
        }

        document.getElementById('se_Sened').addEventListener('change', function () {
            var info = document.getElementById('se_SenedInfo');
            info.textContent = this.files.length > 0
                ? this.files.length + ' fayl seçildi'
                : '';
        });

        async function senedElavetGonder() {
            var senedEl = document.getElementById('se_Sened');
            if (!senedEl.files.length) { alert('Ən azı bir fayl seçin.'); return; }

            var fd = new FormData();
            fd.append('mezuniyyetId', '@m.Id');
            for (var i = 0; i < senedEl.files.length; i++) {
                fd.append('senedler', senedEl.files[i]);
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) fd.append('__RequestVerificationToken', token.value);

            var btn = document.getElementById('se_SendBtn');
            btn.disabled = true; btn.textContent = 'Yüklənir...';

            try {
                var resp = await fetch('@Url.Action("KorreksiyaSenedElave", "Mezuniyyet", new { area = "HR" })', {
                    method: 'POST', body: fd
                });
                var json = await resp.json();
                if (json.ok) {
                    location.reload();
                } else {
                    alert(json.xeta || 'Xəta baş verdi.');
                    btn.disabled = false; btn.textContent = 'Yüklə';
                }
            } catch (e) {
                alert('Şəbəkə xətası.');
                btn.disabled = false; btn.textContent = 'Yüklə';
            }
        }
    </script>
}