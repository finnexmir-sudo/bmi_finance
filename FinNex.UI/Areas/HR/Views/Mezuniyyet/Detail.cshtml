                    <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid #e4e8f0;">
                        <button type="button" onclick="adminTarixModalBag()" style="padding:8px 18px;border-radius:8px;border:1.5px solid #d1d5db;background:#fff;color:#374151;font-size:13px;font-weight:600;cursor:pointer;">İmtina</button>
                        <button type="submit" style="padding:8px 18px;border-radius:8px;border:none;background:#9a3412;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">Düzəlt</button>
                    </div>
