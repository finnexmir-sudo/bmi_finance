@model FinNex.UI.Areas.HR.ViewModels.RehberDashboardVM
@{
    ViewData["Title"] = "Rehber Dashboard";
    Layout = "~/Areas/HR/Views/Shared/_HRLayout.cshtml";

    var faiz = Model.DavamiyyetFaizi;
    var faizCls = faiz >= 90 ? "#16a34a" : faiz >= 75 ? "#d97706" : "#dc2626";
    var kisiPct = Model.UmumiIsciSayi > 0 ? (int)((double)Model.KisiSayi / Model.UmumiIsciSayi * 100) : 0;
    var qadinPct = 100 - kisiPct;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/rehber-dashboard.css" asp-append-version="true" />
}

<div class="rd">

    <!-- ── Top Bar ── -->
    <div class="rd-topbar">
        <div class="rd-topbar-left">
            <h1>Rehber Dashboard</h1>
            <p>@DateTime.Today.ToString("dd MMMM yyyy") · Idareetme paneli</p>
        </div>
        <div class="rd-topbar-right">
            @if (Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi > 0)
            {
                <span class="rd-alert-badge">
                    <i class="bi bi-bell-fill"></i>
                    @(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi) tesdiq gozleyir
                </span>
            }
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 1. KPI KARTLAR — 5 sutun                         -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="rd-kpi-row">

        <div class="rd-kpi k-total">
            <div class="rd-kpi-ico"><i class="bi bi-people-fill"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-lbl">Umumi isci</div>
                <div class="rd-kpi-num">@Model.UmumiIsciSayi</div>
                <div class="rd-kpi-sub">@Model.AktivIsciSayi aktiv</div>
            </div>
        </div>

        <div class="rd-kpi k-gender">
            <div class="rd-kpi-ico"><i class="bi bi-gender-ambiguous"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-lbl">Kisi / Qadin</div>
                <div class="rd-kpi-num">@Model.KisiSayi / @Model.QadinSayi</div>
                <div class="rd-kpi-sub">@kisiPct% / @qadinPct%</div>
            </div>
        </div>

        <div class="rd-kpi k-hire">
            <div class="rd-kpi-ico"><i class="bi bi-person-plus-fill"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-lbl">Bu ay ise qebul</div>
                <div class="rd-kpi-num">@Model.BuAyIsheQebulSayi</div>
                <div class="rd-kpi-sub">@Model.BuAyIshdenAyrilanSayi ayrildi</div>
            </div>
        </div>

        <div class="rd-kpi k-pending">
            <div class="rd-kpi-ico"><i class="bi bi-hourglass-split"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-lbl">Gozleyen tesdiqler</div>
                <div class="rd-kpi-num">@(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi)</div>
                <div class="rd-kpi-sub">@Model.GozleyenMezuniyyetTesdiqi mez. · @Model.GozleyenIcazeTesdiqi icaze</div>
            </div>
        </div>

        <div class="rd-kpi k-attend">
            <div class="rd-kpi-ico"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-lbl">Davamiyyet faizi</div>
                <div class="rd-kpi-num">@faiz<sup>%</sup></div>
                <div class="rd-kpi-bar">
                    <div class="rd-kpi-bar-fill" style="width:@faiz%; background:@faizCls"></div>
                </div>
            </div>
        </div>

    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 2. BUGUNUN DAVAMIYYETI                           -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="rd-section-label">
        <span class="rd-live-dot"></span>
        Bu gunun davamiyyeti
    </div>

    <div class="rd-today-row">
        <div class="rd-td t-green">
            <div class="rd-td-num">@Model.BugunIshde</div>
            <div class="rd-td-lbl">Isde</div>
        </div>
        <div class="rd-td t-orange">
            <div class="rd-td-num">@Model.BugunGeciken</div>
            <div class="rd-td-lbl">Gecikenler</div>
        </div>
        <div class="rd-td t-red">
            <div class="rd-td-num">@Model.BugunQayib</div>
            <div class="rd-td-lbl">Qayib</div>
        </div>
        <div class="rd-td t-blue">
            <div class="rd-td-num">@Model.BugunMezuniyyetde</div>
            <div class="rd-td-lbl">Mezuniyyetde</div>
        </div>
        <div class="rd-td t-purple">
            <div class="rd-td-num">@Model.BugunIcazeli</div>
            <div class="rd-td-lbl">Icazeli</div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 3. ORTA BOLME — 3 sutun                          -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="rd-grid-3">

        <!-- SOL: Gozleyen Tesdiqler -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title"><i class="bi bi-clock-history"></i> Gozleyen tesdiqler</span>
                <span class="rd-badge-count">@(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi)</span>
            </div>
            <div class="rd-card-body">
                @if (Model.GozleyenMezuniyyetler.Any())
                {
                    <div class="rd-sub-title">Mezuniyyet sorqulari</div>
                    @foreach (var m in Model.GozleyenMezuniyyetler)
                    {
                        <div class="rd-approval-item">
                            <div class="rd-approval-av">@m.AdSoyad[0]</div>
                            <div class="rd-approval-body">
                                <div class="rd-approval-name">@m.AdSoyad</div>
                                <div class="rd-approval-meta">@m.Departament · @m.Tarix</div>
                            </div>
                            <span class="rd-chip chip-mez">Mez.</span>
                        </div>
                    }
                }
                @if (Model.GozleyenIcazeler.Any())
                {
                    <div class="rd-sub-title" style="margin-top:12px">Icaze sorqulari</div>
                    @foreach (var ic in Model.GozleyenIcazeler)
                    {
                        <div class="rd-approval-item">
                            <div class="rd-approval-av">@ic.AdSoyad[0]</div>
                            <div class="rd-approval-body">
                                <div class="rd-approval-name">@ic.AdSoyad</div>
                                <div class="rd-approval-meta">@ic.Departament · @ic.Tarix</div>
                            </div>
                            <span class="rd-chip chip-icaze">Icaze</span>
                        </div>
                    }
                }
                @if (!Model.GozleyenMezuniyyetler.Any() && !Model.GozleyenIcazeler.Any())
                {
                    <div class="rd-empty">Gozleyen tesdiq yoxdur</div>
                }
            </div>
        </div>

        <!-- ORTA: Mezuniyyetde olanlar -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title"><i class="bi bi-calendar2-week"></i> Mezuniyyetde olanlar</span>
                <span class="rd-badge-count">@Model.HazirdaMezuniyyetde</span>
            </div>
            <div class="rd-card-body">
                @if (Model.MezuniyyetdeOlanlar.Any())
                {
                    @foreach (var m in Model.MezuniyyetdeOlanlar)
                    {
                        <div class="rd-mez-item">
                            <div class="rd-mez-av">@m.AdSoyad[0]</div>
                            <div class="rd-mez-body">
                                <div class="rd-mez-name">@m.AdSoyad</div>
                                <div class="rd-mez-meta">@m.Departament · @m.Nov</div>
                            </div>
                            <div class="rd-mez-date">@m.BitmeTarixi.ToString("dd.MM")-de bitir</div>
                        </div>
                    }
                }
                else
                {
                    <div class="rd-empty">Hal-hazirda mezuniyyetde olan yoxdur</div>
                }

                <div class="rd-mez-summary">
                    <div class="rd-mez-row">
                        <span>Bu hefte biten</span>
                        <strong>@Model.BuHefteBitenMezuniyyet</strong>
                    </div>
                    <div class="rd-mez-row">
                        <span>Illik</span>
                        <strong>@Model.IllikMezuniyyetSayi</strong>
                    </div>
                    <div class="rd-mez-row">
                        <span>Xestelik</span>
                        <strong>@Model.XestelikMezuniyyetSayi</strong>
                    </div>
                    <div class="rd-mez-row">
                        <span>Ezamiyyet</span>
                        <strong>@Model.EzamiyyetSayi</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAG: Son girisler -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title"><i class="bi bi-door-open"></i> Son girisler</span>
            </div>
            <div class="rd-card-body rd-scroll">
                @if (Model.SonGirisler.Any())
                {
                    @foreach (var g in Model.SonGirisler)
                    {
                        var chipCls = g.Status == 1 ? "c-isde" :
                                      g.Status == 2 ? "c-gecikme" :
                                      g.Status == 3 ? "c-qayib" : "c-icazeli";
                        var chipAd = g.Status == 1 ? "Isde" :
                                     g.Status == 2 ? "Gecikdi" :
                                     g.Status == 3 ? "Qayib" : "Icazeli";
                        <div class="rd-giris-item">
                            <div class="rd-giris-av">@g.Ad[0]</div>
                            <div class="rd-giris-body">
                                <div class="rd-giris-name">@g.Ad</div>
                                <div class="rd-giris-dept">@g.Departament</div>
                            </div>
                            <div class="rd-giris-times">
                                @if (g.GirisVaxti != null)
                                {
                                    <span class="rd-time-in">@g.GirisVaxti</span>
                                }
                                @if (g.CixisVaxti != null)
                                {
                                    <span class="rd-time-out">@g.CixisVaxti</span>
                                }
                            </div>
                            <span class="rd-chip @chipCls">@chipAd</span>
                        </div>
                    }
                }
                else
                {
                    <div class="rd-empty">Bugun hele qeyd yoxdur</div>
                }
            </div>
        </div>

    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 4. ANALİTİKA — Qrafikler + Maliyye              -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="rd-section-label">
        <i class="bi bi-bar-chart-line"></i>
        Analitika
    </div>

    <div class="rd-grid-3">

        <!-- Departament uzre isci sayi -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title">Departament uzre isciler</span>
            </div>
            <div class="rd-card-body rd-chart-body">
                <canvas id="chartDepartament"></canvas>
            </div>
        </div>

        <!-- Kisi / Qadin + Yas qruplari -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title">Kisi / Qadin nisbeti</span>
            </div>
            <div class="rd-card-body rd-chart-body">
                <canvas id="chartGender"></canvas>
            </div>
            <div class="rd-card-head" style="border-top:1px solid #f3f4f8">
                <span class="rd-card-title">Yas qruplari</span>
            </div>
            <div class="rd-card-body rd-chart-body">
                <canvas id="chartYas"></canvas>
            </div>
        </div>

        <!-- Staj + Vezife -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title">Staj qruplari</span>
            </div>
            <div class="rd-card-body rd-chart-body">
                <canvas id="chartStaj"></canvas>
            </div>
            <div class="rd-card-head" style="border-top:1px solid #f3f4f8">
                <span class="rd-card-title">Vezife paylasi (Top 10)</span>
            </div>
            <div class="rd-card-body rd-chart-body">
                <canvas id="chartVezife"></canvas>
            </div>
        </div>

    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 5. MALIYYE                                        -->
    <!-- ══════════════════════════════════════════════════ -->
    <div class="rd-section-label">
        <i class="bi bi-cash-stack"></i>
        Maas / Maliyye
    </div>

    <div class="rd-grid-2">

        <!-- Maas kartlari -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title">Bu ayin maas fondu</span>
            </div>
            <div class="rd-card-body">
                <div class="rd-finance-grid">
                    <div class="rd-fin-item">
                        <div class="rd-fin-lbl">Brut fond</div>
                        <div class="rd-fin-val">@Model.UmumiBrutMaas.ToString("N0") AZN</div>
                    </div>
                    <div class="rd-fin-item">
                        <div class="rd-fin-lbl">Net fond</div>
                        <div class="rd-fin-val">@Model.UmumiNetMaas.ToString("N0") AZN</div>
                    </div>
                    <div class="rd-fin-item">
                        <div class="rd-fin-lbl">Orta maas</div>
                        <div class="rd-fin-val">@Model.OrtaMaas.ToString("N0") AZN</div>
                    </div>
                </div>

                <div class="rd-maas-status">
                    <div class="rd-maas-s-item">
                        <span class="rd-dot dot-draft"></span>
                        Layihe: <strong>@Model.MaasLayihe</strong>
                    </div>
                    <div class="rd-maas-s-item">
                        <span class="rd-dot dot-approved"></span>
                        Tesdiqlenib: <strong>@Model.MaasTesdiqlendi</strong>
                    </div>
                    <div class="rd-maas-s-item">
                        <span class="rd-dot dot-paid"></span>
                        Odenildi: <strong>@Model.MaasOdenildi</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Son maas deyisiklikleri -->
        <div class="rd-card">
            <div class="rd-card-head">
                <span class="rd-card-title">Son maas deyisiklikleri</span>
            </div>
            <div class="rd-card-body rd-scroll">
                @if (Model.SonMaasDeyisiklikleri.Any())
                {
                    <table class="rd-table">
                        <thead>
                            <tr>
                                <th>Isci</th>
                                <th>Kohne</th>
                                <th>Yeni</th>
                                <th>Tarix</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.SonMaasDeyisiklikleri)
                            {
                                var diff = d.YeniMaas - d.KohneMaas;
                                var cls = diff > 0 ? "change-up" : diff < 0 ? "change-down" : "";
                                <tr>
                                    <td class="rd-t-name">@d.AdSoyad</td>
                                    <td>@d.KohneMaas.ToString("N0")</td>
                                    <td class="@cls">@d.YeniMaas.ToString("N0")</td>
                                    <td class="rd-t-date">@d.Tarix.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="rd-empty">Maas deyisikliyi yoxdur</div>
                }
            </div>
        </div>

    </div>

    <!-- ══════════════════════════════════════════════════ -->
    <!-- 6. DEPARTAMENT DETALLI CEDVEL                    -->
    <!-- ══════════════════════════════════════════════════ -->
    @if (Model.DepartamentStat.Any())
    {
        <div class="rd-section-label">
            <i class="bi bi-diagram-3"></i>
            Departament detallari
        </div>

        <div class="rd-card">
            <div class="rd-card-body">
                <table class="rd-table rd-table-dept">
                    <thead>
                        <tr>
                            <th>Departament</th>
                            <th>Umumi</th>
                            <th>Kisi</th>
                            <th>Qadin</th>
                            <th>Nisbet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.DepartamentStat)
                        {
                            var pct = d.IsciSayi > 0 ? (int)((double)d.KisiSayi / d.IsciSayi * 100) : 0;
                            <tr>
                                <td class="rd-t-name">@d.Ad</td>
                                <td><strong>@d.IsciSayi</strong></td>
                                <td>@d.KisiSayi</td>
                                <td>@d.QadinSayi</td>
                                <td>
                                    <div class="rd-ratio-bar">
                                        <div class="rd-ratio-male" style="width:@pct%"></div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ── Rəng paleti ──
        const colors = ['#0f1623','#2563eb','#16a34a','#d97706','#dc2626','#7c3aed','#0ea5e9','#ec4899','#f59e0b','#6366f1'];
        const bgColors = ['#0f162320','#2563eb20','#16a34a20','#d9770620','#dc262620','#7c3aed20','#0ea5e920','#ec489920','#f59e0b20','#6366f120'];

        // Ümumi chart konfiqurasiyası
        Chart.defaults.font.family = "'DM Sans', sans-serif";
        Chart.defaults.font.size = 11;
        Chart.defaults.plugins.legend.display = false;

        // ── 1. Departament Bar Chart ──
        new Chart(document.getElementById('chartDepartament'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.Ad))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.IsciSayi))),
                    backgroundColor: colors.slice(0, @Model.DepartamentStat.Count),
                    borderRadius: 6,
                    barThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { precision: 0 } },
                    y: { grid: { display: false } }
                }
            }
        });

        // ── 2. Gender Doughnut ──
        new Chart(document.getElementById('chartGender'), {
            type: 'doughnut',
            data: {
                labels: ['Kisi', 'Qadin'],
                datasets: [{
                    data: [@Model.KisiSayi, @Model.QadinSayi],
                    backgroundColor: ['#2563eb', '#ec4899'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 12 }
                    }
                }
            }
        });

        // ── 3. Yaş Doughnut ──
        new Chart(document.getElementById('chartYas'), {
            type: 'doughnut',
            data: {
                labels: ['20-30', '30-40', '40-50', '50+'],
                datasets: [{
                    data: [@Model.Yas20_30, @Model.Yas30_40, @Model.Yas40_50, @Model.Yas50Plus],
                    backgroundColor: ['#16a34a', '#2563eb', '#d97706', '#dc2626'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { boxWidth: 12, padding: 12 }
                    }
                }
            }
        });

        // ── 4. Staj Bar ──
        new Chart(document.getElementById('chartStaj'), {
            type: 'bar',
            data: {
                labels: ['0-1 il', '1-3 il', '3-5 il', '5+ il'],
                datasets: [{
                    data: [@Model.Staj0_1, @Model.Staj1_3, @Model.Staj3_5, @Model.Staj5Plus],
                    backgroundColor: ['#0ea5e9', '#2563eb', '#7c3aed', '#0f1623'],
                    borderRadius: 6,
                    barThickness: 32
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false } },
                    y: { grid: { color: '#f3f4f8' }, ticks: { precision: 0 } }
                }
            }
        });

        // ── 5. Vəzifə Bar ──
        new Chart(document.getElementById('chartVezife'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.Ad))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.IsciSayi))),
                    backgroundColor: colors.slice(0, @Model.VezifeStat.Count),
                    borderRadius: 6,
                    barThickness: 28
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { precision: 0 } },
                    y: { grid: { display: false } }
                }
            }
        });
    </script>
}
