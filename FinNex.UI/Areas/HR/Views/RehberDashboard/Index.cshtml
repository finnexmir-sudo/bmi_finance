@model FinNex.UI.Areas.HR.ViewModels.RehberDashboardVM
@{
    ViewData["Title"] = "Rəhbər Dashboard";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var faiz = Model.DavamiyyetFaizi;
    var faizCls = faiz >= 90 ? "#1e9b6b" : faiz >= 75 ? "#d4920a" : "#c83838";
    var umumiIsci = Model.UmumiIsciSayi > 0 ? Model.UmumiIsciSayi : 1;

    int actionTotal = Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi
                    + Model.GozleyenAvansSayi + Model.MaasLayiheSayi
                    + Model.GozleyenSenedSayi + Model.KritikMezBalansSayi
                    + Model.MaasHesablanmamisSayi;

    var saatIndi = DateTime.Now.Hour;
    var salam = saatIndi < 6 ? "Xeyirli gecələr"
              : saatIndi < 12 ? "Sabahın xeyir"
              : saatIndi < 18 ? "Günün xeyir"
              : "Axşamın xeyir";

    var userFullName = User.Identity?.Name ?? "";
    var firstName = userFullName.Split(' ').FirstOrDefault() ?? "Rəhbər";

    var ayAdlar = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
                          "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
    var gunAdlar = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Bazar ertəsi" }, { DayOfWeek.Tuesday, "Çərşənbə axşamı" },
        { DayOfWeek.Wednesday, "Çərşənbə" }, { DayOfWeek.Thursday, "Cümə axşamı" },
        { DayOfWeek.Friday, "Cümə" }, { DayOfWeek.Saturday, "Şənbə" }, { DayOfWeek.Sunday, "Bazar" }
    };
    var bugun = DateTime.Today;
    var tarixStr = $"{gunAdlar[bugun.DayOfWeek]}, {bugun.Day} {ayAdlar[bugun.Month]} {bugun.Year}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/rehber-dashboard.css" asp-append-version="true" />
}

@if (ViewBag.ErrorMessage != null)
{
    <div style="background:#fef0f0;border:1px solid #f5c6c2;padding:16px;border-radius:8px;margin-bottom:16px;color:#c83838;font-size:13px">
        <strong>Xəta:</strong> @ViewBag.ErrorMessage
    </div>
}

<div class="fn-dashboard rd">

    <!-- ═══ 0. WELCOME HERO ═══ -->
    <div class="rd-hero">
        <div class="rd-hero-bg">
            <svg width="100%" height="100%" viewBox="0 0 600 200" preserveAspectRatio="xMaxYMid slice" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="rdHeroGrad" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%"  stop-color="#1e2a3b" stop-opacity=".0"/>
                        <stop offset="100%" stop-color="#1e2a3b" stop-opacity=".18"/>
                    </linearGradient>
                </defs>
                <circle cx="540" cy="40"  r="80" fill="url(#rdHeroGrad)"/>
                <circle cx="490" cy="170" r="50" fill="url(#rdHeroGrad)"/>
                <circle cx="600" cy="120" r="35" fill="url(#rdHeroGrad)"/>
            </svg>
        </div>
        <div class="rd-hero-main">
            <div class="rd-hero-date">
                <i class="bi bi-calendar3"></i> @tarixStr
            </div>
            <div class="rd-hero-greet">@salam, @firstName 👋</div>
            <div class="rd-hero-sub">
                @if (actionTotal == 0)
                {
                    <span><i class="bi bi-check2-circle" style="color:#7ee2b8"></i> Bu gün diqqət tələb edən iş yoxdur — hər şey nizamdadır.</span>
                }
                else
                {
                    <span><i class="bi bi-bell" style="color:#ffd178"></i> <strong>@actionTotal</strong> element diqqətinizi gözləyir.</span>
                }
            </div>
        </div>
        <div class="rd-hero-snap">
            <div class="rd-hero-snap-item">
                <div class="rd-hero-snap-num">@Model.AktivIsciSayi</div>
                <div class="rd-hero-snap-lbl">Aktiv işçi</div>
            </div>
            <div class="rd-hero-snap-divider"></div>
            <div class="rd-hero-snap-item">
                <div class="rd-hero-snap-num">@Model.HazirdaMezuniyyetde</div>
                <div class="rd-hero-snap-lbl">Məzuniyyətdə</div>
            </div>
            <div class="rd-hero-snap-divider"></div>
            <div class="rd-hero-snap-item">
                <div class="rd-hero-snap-num" style="color:@(actionTotal > 0 ? "#ffd178" : "#7ee2b8")">@actionTotal</div>
                <div class="rd-hero-snap-lbl">Tapşırıq</div>
            </div>
        </div>
    </div>

    <!-- ═══ 1. ACTION CENTER — Diqqət Tələb Edən İşlər ═══ -->
    <div class="rd-section-head rd-section-head--action">
        <span class="rd-action-pulse"></span> Diqqət tələb edir
        @if (actionTotal > 0)
        {
            <span class="rd-action-total">@actionTotal element</span>
        }
        else
        {
            <span class="rd-action-total rd-action-total--ok">Hər şey nizamdadır</span>
        }
    </div>
    <div class="rd-action-grid">
        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Index"
           class="rd-action-tile @(Model.GozleyenMezuniyyetTesdiqi > 0 ? "rd-action-tile--alert" : "")">
            <i class="bi bi-tree"></i>
            <div class="rd-action-num">@Model.GozleyenMezuniyyetTesdiqi</div>
            <div class="rd-action-lbl">Məzuniyyət təsdiqi</div>
        </a>
        <a asp-area="HR" asp-controller="Icaze" asp-action="Index"
           class="rd-action-tile @(Model.GozleyenIcazeTesdiqi > 0 ? "rd-action-tile--alert" : "")">
            <i class="bi bi-hourglass-split"></i>
            <div class="rd-action-num">@Model.GozleyenIcazeTesdiqi</div>
            <div class="rd-action-lbl">İcazə təsdiqi</div>
        </a>
        <a asp-area="HR" asp-controller="Avans" asp-action="Index"
           class="rd-action-tile @(Model.GozleyenAvansSayi > 0 ? "rd-action-tile--alert" : "")">
            <i class="bi bi-cash-coin"></i>
            <div class="rd-action-num">@Model.GozleyenAvansSayi</div>
            <div class="rd-action-lbl">Avans müraciəti</div>
        </a>
        <a asp-area="HR" asp-controller="Maas" asp-action="Index"
           class="rd-action-tile @(Model.MaasLayiheSayi > 0 ? "rd-action-tile--info" : "")">
            <i class="bi bi-file-earmark-check"></i>
            <div class="rd-action-num">@Model.MaasLayiheSayi</div>
            <div class="rd-action-lbl">Maaş təsdiqi gözləyir</div>
        </a>
        <a asp-area="HR" asp-controller="Maas" asp-action="Index"
           class="rd-action-tile @(Model.MaasHesablanmamisSayi > 0 ? "rd-action-tile--warn" : "")">
            <i class="bi bi-exclamation-circle"></i>
            <div class="rd-action-num">@Model.MaasHesablanmamisSayi</div>
            <div class="rd-action-lbl">Bu ay maaş yoxdur</div>
        </a>
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
           class="rd-action-tile @(Model.GozleyenSenedSayi > 0 ? "rd-action-tile--info" : "")">
            <i class="bi bi-folder-symlink"></i>
            <div class="rd-action-num">@Model.GozleyenSenedSayi</div>
            <div class="rd-action-lbl">Sənəd yoxlanılır</div>
        </a>
        <a href="#kritikBalans"
           class="rd-action-tile @(Model.KritikMezBalansSayi > 0 ? "rd-action-tile--warn" : "")">
            <i class="bi bi-battery-low"></i>
            <div class="rd-action-num">@Model.KritikMezBalansSayi</div>
            <div class="rd-action-lbl">Məz. balansı kritik</div>
        </a>
    </div>

    <!-- ═══ 2. BUGÜNKÜ DAVAMİYYƏT — Detallı ═══ -->
    <div class="rd-section-head">
        <span class="rd-live-dot"></span> Bugünkü davamiyyət
        <span class="rd-section-meta">@DateTime.Today.ToString("dd MMMM yyyy")</span>
    </div>

    @if (!Model.BugunQeydVar)
    {
        <div class="rd-empty-state">
            <i class="bi bi-calendar2-x"></i>
            <div class="rd-empty-title">Bu gün üçün hələ qeyd yoxdur</div>
            <div class="rd-empty-sub">İşçilər hələ giriş etməyiblər və ya davamiyyət sistemi açılmayıb.</div>
        </div>
    }
    else
    {
        <div class="rd-att-stats">
            <div class="rd-att-stat rd-att-stat--green">
                <div class="rd-att-num">@Model.BugunIshde</div>
                <div class="rd-att-lbl">İşdə</div>
            </div>
            <div class="rd-att-stat rd-att-stat--amber">
                <div class="rd-att-num">@Model.BugunGeciken</div>
                <div class="rd-att-lbl">Gecikən</div>
            </div>
            <div class="rd-att-stat rd-att-stat--red">
                <div class="rd-att-num">@Model.BugunQayib</div>
                <div class="rd-att-lbl">Qayıb</div>
            </div>
            <div class="rd-att-stat rd-att-stat--blue">
                <div class="rd-att-num">@Model.BugunMezuniyyetde</div>
                <div class="rd-att-lbl">Məzuniyyətdə</div>
            </div>
            <div class="rd-att-stat rd-att-stat--purple">
                <div class="rd-att-num">@Model.BugunIcazeli</div>
                <div class="rd-att-lbl">İcazəli</div>
            </div>
            <div class="rd-att-stat rd-att-stat--gauge">
                <div class="rd-att-num" style="color:@faizCls">@faiz%</div>
                <div class="rd-att-lbl">Davamiyyət (bu ay)</div>
                <div class="rd-progress" style="margin-top:6px">
                    <div class="rd-progress-fill" style="width:@faiz%;background:@faizCls"></div>
                </div>
            </div>
        </div>

        @if (Model.BugunGecikenIsciler.Any() || Model.BugunQayibIsciler.Any())
        {
            <div class="rd-att-detail-grid">
                @if (Model.BugunGecikenIsciler.Any())
                {
                    <div class="fn-card rd-att-detail">
                        <div class="fn-card-head">
                            <div class="fn-card-title">
                                <i class="bi bi-clock-history" style="color:#d4920a"></i>
                                Gecikən işçilər
                            </div>
                            <span class="rd-count-badge rd-count-badge--amber">@Model.BugunGecikenIsciler.Count</span>
                        </div>
                        @foreach (var g in Model.BugunGecikenIsciler)
                        {
                            <div class="rd-list-item">
                                <div class="rd-avatar rd-avatar--amber">@(g.AdSoyad.Length > 0 ? g.AdSoyad[0] : '?')</div>
                                <div class="rd-list-info">
                                    <div class="rd-list-name">@g.AdSoyad</div>
                                    <div class="rd-list-meta">@g.Departament</div>
                                </div>
                                @if (g.GirisVaxti != null)
                                {
                                    <span class="rd-time rd-time--in">@g.GirisVaxti</span>
                                }
                            </div>
                        }
                    </div>
                }
                @if (Model.BugunQayibIsciler.Any())
                {
                    <div class="fn-card rd-att-detail">
                        <div class="fn-card-head">
                            <div class="fn-card-title">
                                <i class="bi bi-x-circle" style="color:#c83838"></i>
                                Qayıb işçilər
                            </div>
                            <span class="rd-count-badge rd-count-badge--red">@Model.BugunQayibIsciler.Count</span>
                        </div>
                        @foreach (var g in Model.BugunQayibIsciler)
                        {
                            <div class="rd-list-item">
                                <div class="rd-avatar rd-avatar--red">@(g.AdSoyad.Length > 0 ? g.AdSoyad[0] : '?')</div>
                                <div class="rd-list-info">
                                    <div class="rd-list-name">@g.AdSoyad</div>
                                    <div class="rd-list-meta">@g.Departament</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }

    <!-- ═══ 3. KPI KARTLARI — Maliyyə + Personel ═══ -->
    <div class="rd-section-head">
        <i class="bi bi-graph-up"></i> Əsas göstəricilər
    </div>
    <div class="rd-kpi-grid rd-kpi-grid--rich">
        <div class="rd-kpi rd-kpi--primary">
            <div class="rd-kpi-icon rd-kpi-icon--dark"><i class="bi bi-people-fill"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Ümumi işçi</div>
                <div class="rd-kpi-value">@Model.UmumiIsciSayi</div>
                <div class="rd-kpi-hint">@Model.AktivIsciSayi aktiv · @Model.IshdenCixanSayi ayrılıb</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--pink"><i class="bi bi-gender-ambiguous"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Kişi / Qadın</div>
                <div class="rd-kpi-value">@Model.KisiSayi <span class="rd-kpi-slash">/</span> @Model.QadinSayi</div>
                <div class="rd-kpi-hint">@((int)((double)Model.KisiSayi / umumiIsci * 100))% · @((int)((double)Model.QadinSayi / umumiIsci * 100))%</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--green"><i class="bi bi-person-plus-fill"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Bu ay işə qəbul</div>
                <div class="rd-kpi-value">@Model.BuAyIsheQebulSayi</div>
                <div class="rd-kpi-hint">@Model.BuAyIshdenAyrilanSayi ayrıldı</div>
            </div>
        </div>

        <div class="rd-kpi rd-kpi--primary">
            <div class="rd-kpi-icon rd-kpi-icon--gold"><i class="bi bi-cash-stack"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Bu ayın maaş fondu</div>
                <div class="rd-kpi-value">@Model.UmumiBrutMaas.ToString("N0") <small>₼</small></div>
                <div class="rd-kpi-hint">Net: @Model.UmumiNetMaas.ToString("N0") ₼ · Orta: @Model.OrtaMaas.ToString("N0") ₼</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--purple"><i class="bi bi-wallet2"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Avans (bu ay)</div>
                <div class="rd-kpi-value">@Model.BuAyAvansCemi.ToString("N0") <small>₼</small></div>
                <div class="rd-kpi-hint">@Model.BuAyAvansSayi əməliyyat · @Model.GozleyenAvansSayi gözləyir</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--blue"><i class="bi bi-bank2"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Swift / Ödəniş tapşırığı</div>
                <div class="rd-kpi-value">@Model.BuAyOdenisTapsirigiSayi</div>
                <div class="rd-kpi-hint">@Model.BuAyOdenisTapsirigiMebleg.ToString("N0") ₼ bu ay</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--teal"><i class="bi bi-folder2"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Sənəd dövriyyəsi</div>
                <div class="rd-kpi-value">@Model.AktivSenedSayi</div>
                <div class="rd-kpi-hint">@Model.BuAySenedSayi yeni bu ay · @Model.GozleyenSenedSayi yoxlanılır</div>
            </div>
        </div>

        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--amber"><i class="bi bi-tree-fill"></i></div>
            <div class="rd-kpi-body">
                <div class="rd-kpi-label">Məzuniyyətdə</div>
                <div class="rd-kpi-value">@Model.HazirdaMezuniyyetde</div>
                <div class="rd-kpi-hint">@Model.BuHefteBitenMezuniyyet bu həftə bitir</div>
            </div>
        </div>
    </div>

    <!-- ═══ 4. SİYAHILAR — 3 sütun ═══ -->
    <div class="rd-grid3">

        <!-- Gözləyən təsdiqlər (məz + icazə + avans qısa siyahısı) -->
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Gözləyən təsdiqlər</div>
                <span class="rd-count-badge">@(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi)</span>
            </div>
            @if (Model.GozleyenMezuniyyetler.Any())
            {
                <div class="rd-list-label">Məzuniyyət</div>
                @foreach (var m in Model.GozleyenMezuniyyetler)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar">@(m.AdSoyad.Length > 0 ? m.AdSoyad[0] : '?')</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@m.AdSoyad</div>
                            <div class="rd-list-meta">@m.Departament · @m.Tarix</div>
                        </div>
                        <span class="fn-badge fn-badge--wait">Məz.</span>
                    </div>
                }
            }
            @if (Model.GozleyenIcazeler.Any())
            {
                <div class="rd-list-label" style="margin-top:8px">İcazə</div>
                @foreach (var ic in Model.GozleyenIcazeler)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar">@(ic.AdSoyad.Length > 0 ? ic.AdSoyad[0] : '?')</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@ic.AdSoyad</div>
                            <div class="rd-list-meta">@ic.Departament · @ic.Tarix</div>
                        </div>
                        <span class="fn-badge fn-badge--review">İcazə</span>
                    </div>
                }
            }
            @if (!Model.GozleyenMezuniyyetler.Any() && !Model.GozleyenIcazeler.Any())
            {
                <div class="rd-empty rd-empty--mini">
                    <i class="bi bi-check2-circle"></i>
                    <span>Gözləyən təsdiq yoxdur</span>
                </div>
            }
        </div>

        <!-- Məzuniyyətdə olanlar -->
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Məzuniyyətdə olanlar</div>
                <span class="rd-count-badge">@Model.HazirdaMezuniyyetde</span>
            </div>
            @if (Model.MezuniyyetdeOlanlar.Any())
            {
                @foreach (var m in Model.MezuniyyetdeOlanlar)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar rd-avatar--amber">@(m.AdSoyad.Length > 0 ? m.AdSoyad[0] : '?')</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@m.AdSoyad</div>
                            <div class="rd-list-meta">@m.Departament · @m.Nov</div>
                        </div>
                        <div class="rd-date-tag">@m.BitmeTarixi.ToString("dd.MM")</div>
                    </div>
                }
            }
            else
            {
                <div class="rd-empty rd-empty--mini">
                    <i class="bi bi-tree"></i>
                    <span>Hal-hazırda məzuniyyətdə olan yoxdur</span>
                </div>
            }
            <div class="rd-summary-block">
                <div class="rd-summary-row"><span>Bu həftə bitən</span><strong>@Model.BuHefteBitenMezuniyyet</strong></div>
                <div class="rd-summary-row"><span>İllik</span><strong>@Model.IllikMezuniyyetSayi</strong></div>
                <div class="rd-summary-row"><span>Xəstəlik</span><strong>@Model.XestelikMezuniyyetSayi</strong></div>
                <div class="rd-summary-row"><span>Ezamiyyət</span><strong>@Model.EzamiyyetSayi</strong></div>
            </div>
        </div>

        <!-- Kritik məzuniyyət balansı + Son girişlər (alt-alta) -->
        <div class="rd-stack">
            <div class="fn-card" id="kritikBalans">
                <div class="fn-card-head">
                    <div class="fn-card-title">
                        <i class="bi bi-battery-low" style="color:#c83838"></i>
                        Məzuniyyət balansı kritik
                    </div>
                    <span class="rd-count-badge rd-count-badge--red">@Model.KritikMezBalansSayi</span>
                </div>
                @if (Model.KritikBalansIsciler.Any())
                {
                    @foreach (var k in Model.KritikBalansIsciler)
                    {
                        <div class="rd-list-item">
                            <div class="rd-avatar rd-avatar--red">@(k.AdSoyad.Length > 0 ? k.AdSoyad[0] : '?')</div>
                            <div class="rd-list-info">
                                <div class="rd-list-name">@k.AdSoyad</div>
                                <div class="rd-list-meta">@k.Departament</div>
                            </div>
                            <span class="rd-date-tag rd-date-tag--red">@k.QalanGun gün</span>
                        </div>
                    }
                }
                else
                {
                    <div class="rd-empty rd-empty--mini">
                        <i class="bi bi-shield-check"></i>
                        <span>Kritik balans yoxdur</span>
                    </div>
                }
            </div>

            <div class="fn-card">
                <div class="fn-card-head">
                    <div class="fn-card-title">Son girişlər</div>
                </div>
                <div class="rd-scroll-area">
                    @if (Model.SonGirisler.Any())
                    {
                        @foreach (var g in Model.SonGirisler)
                        {
                            var cls = g.Status == 1 ? "fn-badge--done" :
                                      g.Status == 2 ? "fn-badge--wait" :
                                      g.Status == 3 ? "fn-badge--rejected" : "fn-badge--review";
                            var lbl = g.Status == 1 ? "İşdə" :
                                      g.Status == 2 ? "Gecikdi" :
                                      g.Status == 3 ? "Qayıb" : "İcazəli";
                            <div class="rd-list-item">
                                <div class="rd-avatar rd-avatar--blue">@(g.Ad.Length > 0 ? g.Ad[0] : '?')</div>
                                <div class="rd-list-info">
                                    <div class="rd-list-name">@g.Ad</div>
                                    <div class="rd-list-meta">@g.Departament</div>
                                </div>
                                <div class="rd-time-group">
                                    @if (g.GirisVaxti != null) { <span class="rd-time rd-time--in">@g.GirisVaxti</span> }
                                    @if (g.CixisVaxti != null) { <span class="rd-time rd-time--out">@g.CixisVaxti</span> }
                                </div>
                                <span class="fn-badge @cls">@lbl</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rd-empty rd-empty--mini">
                            <i class="bi bi-clock-history"></i>
                            <span>Bugün hələ qeyd yoxdur</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ═══ 5. ANALİTİKA — Qrafiklər ═══ -->
    <div class="rd-section-head">
        <i class="bi bi-bar-chart-line-fill"></i> Analitika
    </div>
    <div class="rd-grid3">
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Departament üzrə işçilər</div></div>
            <div class="rd-chart-wrap"><canvas id="chartDept"></canvas></div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Kişi / Qadın nisbəti</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartGender"></canvas></div>
            <div class="fn-card-head" style="border-top:1px solid #f0f2f5"><div class="fn-card-title">Yaş qrupları</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartAge"></canvas></div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Staj qrupları</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartStaj"></canvas></div>
            <div class="fn-card-head" style="border-top:1px solid #f0f2f5"><div class="fn-card-title">Vəzifə paylanması (Top 10)</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartVezife"></canvas></div>
        </div>
    </div>

    <!-- ═══ 6. MAAŞ STATUSU + DƏYİŞİKLİKLƏR ═══ -->
    <div class="rd-section-head">
        <i class="bi bi-cash-stack"></i> Maaş statusu
    </div>
    <div class="fn-grid2">
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Bu ayın hesablama vəziyyəti</div></div>
            <div class="rd-maas-pills">
                <span class="rd-pill rd-pill--gray">Layihə: @Model.MaasLayihe</span>
                <span class="rd-pill rd-pill--blue">Təsdiqlənib: @Model.MaasTesdiqlendi</span>
                <span class="rd-pill rd-pill--green">Ödənildi: @Model.MaasOdenildi</span>
                @if (Model.MaasHesablanmamisSayi > 0)
                {
                    <span class="rd-pill rd-pill--red">Hesablanmamış: @Model.MaasHesablanmamisSayi</span>
                }
            </div>
            <div class="rd-fin-grid" style="margin-top:14px">
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Gross fond</div>
                    <div class="rd-fin-val">@Model.UmumiBrutMaas.ToString("N0") <small>AZN</small></div>
                </div>
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Net fond</div>
                    <div class="rd-fin-val">@Model.UmumiNetMaas.ToString("N0") <small>AZN</small></div>
                </div>
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Orta maaş</div>
                    <div class="rd-fin-val">@Model.OrtaMaas.ToString("N0") <small>AZN</small></div>
                </div>
            </div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Son maaş dəyişiklikləri</div></div>
            <div class="rd-scroll-area">
                @if (Model.SonMaasDeyisiklikleri.Any())
                {
                    <table class="rd-table">
                        <thead><tr><th>İşçi</th><th>Köhnə</th><th>Yeni</th><th>Tarix</th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.SonMaasDeyisiklikleri)
                            {
                                var diff = d.YeniMaas - d.KohneMaas;
                                var cls = diff > 0 ? "rd-up" : diff < 0 ? "rd-down" : "";
                                <tr>
                                    <td class="rd-t-bold">@d.AdSoyad</td>
                                    <td>@d.KohneMaas.ToString("N0")</td>
                                    <td class="@cls">@d.YeniMaas.ToString("N0")</td>
                                    <td class="rd-t-muted">@d.Tarix.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="rd-empty rd-empty--mini">
                        <i class="bi bi-cash-coin"></i>
                        <span>Maaş dəyişikliyi yoxdur</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ═══ 7. DEPARTAMENT CƏDVƏLİ ═══ -->
    @if (Model.DepartamentStat.Any())
    {
        <div class="rd-section-head">
            <i class="bi bi-diagram-3-fill"></i> Departament detalları
        </div>
        <div class="fn-card fn-card--full">
            <table class="rd-table">
                <thead>
                    <tr><th>Departament</th><th>Ümumi</th><th>Kişi</th><th>Qadın</th><th>Nisbət</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DepartamentStat)
                    {
                        var pct = d.IsciSayi > 0 ? (int)((double)d.KisiSayi / d.IsciSayi * 100) : 0;
                        <tr>
                            <td class="rd-t-bold">@d.Ad</td>
                            <td><strong>@d.IsciSayi</strong></td>
                            <td>@d.KisiSayi</td>
                            <td>@d.QadinSayi</td>
                            <td>
                                <div class="rd-ratio-bar">
                                    <div class="rd-ratio-fill" style="width:@pct%"></div>
                                </div>
                                <span class="rd-ratio-text">@pct% K</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.font.size = 11;
        Chart.defaults.color = '#6b7589';
        Chart.defaults.plugins.legend.display = false;
        Chart.defaults.plugins.tooltip.backgroundColor = '#1a2332';
        Chart.defaults.plugins.tooltip.titleColor = '#fff';
        Chart.defaults.plugins.tooltip.bodyColor = '#cbd1dc';
        Chart.defaults.plugins.tooltip.padding = 10;
        Chart.defaults.plugins.tooltip.cornerRadius = 8;
        Chart.defaults.plugins.tooltip.displayColors = false;
        Chart.defaults.plugins.tooltip.titleFont = { weight: '600', size: 12 };

        // Şaquli/üfüqi qrafiklər üçün gradient köməkçi
        function vGrad(ctx, top, bottom) {
            const { chart: { ctx: c, chartArea } } = ctx;
            if (!chartArea) return top;
            const g = c.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
            g.addColorStop(0, top); g.addColorStop(1, bottom);
            return g;
        }
        function hGrad(ctx, left, right) {
            const { chart: { ctx: c, chartArea } } = ctx;
            if (!chartArea) return left;
            const g = c.createLinearGradient(chartArea.left, 0, chartArea.right, 0);
            g.addColorStop(0, left); g.addColorStop(1, right);
            return g;
        }

        // Pal cütlükləri (start → end)
        const palPairs = [
            ['#2d6cdf','#5a91f0'], ['#1e9b6b','#4ec99a'], ['#d4920a','#f0b94d'],
            ['#c83838','#e36b6b'], ['#7c3aed','#a06bf2'], ['#0ea5e9','#48c0f5'],
            ['#ec4899','#f57bb5'], ['#f59e0b','#fbb951'], ['#6366f1','#8c8ff5'],
            ['#1e2a3b','#3a4a63']
        ];
        const palStart = palPairs.map(p => p[0]);
        const palEnd   = palPairs.map(p => p[1]);

        // ── Departament üzrə işçilər ──
        new Chart(document.getElementById('chartDept'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.Ad))),
                datasets: [{
                    label: 'İşçi sayı',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.IsciSayi))),
                    backgroundColor: ctx => hGrad(ctx, palStart[ctx.dataIndex % palStart.length], palEnd[ctx.dataIndex % palEnd.length]),
                    borderRadius: 6, barThickness: 22, hoverBackgroundColor: '#1a2332'
                }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { grid: { color: '#f3f4f8', drawBorder: false }, ticks: { precision: 0 } },
                    y: { grid: { display: false, drawBorder: false } }
                }
            }
        });

        // ── Kişi / Qadın ──
        new Chart(document.getElementById('chartGender'), {
            type: 'doughnut',
            data: { labels: ['Kişi','Qadın'], datasets: [{ data: [@Model.KisiSayi, @Model.QadinSayi], backgroundColor: ['#2d6cdf', '#ec4899'], borderWidth: 3, borderColor: '#fff', hoverOffset: 6 }] },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { display: true, position: 'bottom', labels: { boxWidth: 8, padding: 12, usePointStyle: true, pointStyle: 'circle' } } }
            }
        });

        // ── Yaş qrupları ──
        new Chart(document.getElementById('chartAge'), {
            type: 'doughnut',
            data: { labels: ['20-30','30-40','40-50','50+'], datasets: [{ data: [@Model.Yas20_30, @Model.Yas30_40, @Model.Yas40_50, @Model.Yas50Plus], backgroundColor: ['#1e9b6b','#2d6cdf','#d4920a','#c83838'], borderWidth: 3, borderColor: '#fff', hoverOffset: 6 }] },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '68%',
                plugins: { legend: { display: true, position: 'bottom', labels: { boxWidth: 8, padding: 10, usePointStyle: true, pointStyle: 'circle' } } }
            }
        });

        // ── Staj qrupları ──
        new Chart(document.getElementById('chartStaj'), {
            type: 'bar',
            data: {
                labels: ['0-1 il','1-3 il','3-5 il','5+ il'],
                datasets: [{
                    label: 'İşçi sayı',
                    data: [@Model.Staj0_1, @Model.Staj1_3, @Model.Staj3_5, @Model.Staj5Plus],
                    backgroundColor: [
                        ctx => vGrad(ctx, '#48c0f5', '#0ea5e9'),
                        ctx => vGrad(ctx, '#5a91f0', '#2d6cdf'),
                        ctx => vGrad(ctx, '#a06bf2', '#7c3aed'),
                        ctx => vGrad(ctx, '#3a4a63', '#1e2a3b')
                    ],
                    borderRadius: 8, borderSkipped: false, barThickness: 32, hoverBackgroundColor: '#1a2332'
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { grid: { display: false, drawBorder: false } },
                    y: { grid: { color: '#f3f4f8', drawBorder: false }, ticks: { precision: 0 } }
                }
            }
        });

        // ── Vəzifə paylanması ──
        new Chart(document.getElementById('chartVezife'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.Ad))),
                datasets: [{
                    label: 'İşçi sayı',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.IsciSayi))),
                    backgroundColor: ctx => hGrad(ctx, palStart[ctx.dataIndex % palStart.length], palEnd[ctx.dataIndex % palEnd.length]),
                    borderRadius: 6, barThickness: 20, hoverBackgroundColor: '#1a2332'
                }]
            },
            options: {
                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                scales: {
                    x: { grid: { color: '#f3f4f8', drawBorder: false }, ticks: { precision: 0 } },
                    y: { grid: { display: false, drawBorder: false } }
                }
            }
        });
    </script>
}
