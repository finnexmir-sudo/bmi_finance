@model FinNex.UI.Areas.HR.ViewModels.RehberDashboardVM
@{
    ViewData["Title"] = "Rəhbər Dashboard";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var faiz = Model.DavamiyyetFaizi;
    var faizCls = faiz >= 90 ? "#1e9b6b" : faiz >= 75 ? "#d4920a" : "#c83838";
    var umumiIsci = Model.UmumiIsciSayi > 0 ? Model.UmumiIsciSayi : 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/rehber-dashboard.css" asp-append-version="true" />
}

@if (ViewBag.ErrorMessage != null)
{
    <div style="background:#fef0f0;border:1px solid #f5c6c2;padding:16px;border-radius:8px;margin-bottom:16px;color:#c83838;font-size:13px">
        <strong>Xəta:</strong> @ViewBag.ErrorMessage
    </div>
}

<div class="fn-dashboard rd">

    <!-- ═══ KPI KARTLARI ═══ -->
    <div class="rd-kpi-grid">
        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--dark"><i class="bi bi-people-fill"></i></div>
            <div>
                <div class="rd-kpi-label">Ümumi işçi</div>
                <div class="rd-kpi-value">@Model.UmumiIsciSayi</div>
                <div class="rd-kpi-hint">@Model.AktivIsciSayi aktiv · @Model.IshdenCixanSayi ayrılıb</div>
            </div>
        </div>
        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--pink"><i class="bi bi-gender-ambiguous"></i></div>
            <div>
                <div class="rd-kpi-label">Kişi / Qadın</div>
                <div class="rd-kpi-value">@Model.KisiSayi <span class="rd-kpi-slash">/</span> @Model.QadinSayi</div>
                <div class="rd-kpi-hint">@((int)((double)Model.KisiSayi / umumiIsci * 100))% · @((int)((double)Model.QadinSayi / umumiIsci * 100))%</div>
            </div>
        </div>
        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--green"><i class="bi bi-person-plus-fill"></i></div>
            <div>
                <div class="rd-kpi-label">Bu ay işə qəbul</div>
                <div class="rd-kpi-value">@Model.BuAyIsheQebulSayi</div>
                <div class="rd-kpi-hint">@Model.BuAyIshdenAyrilanSayi ayrıldı</div>
            </div>
        </div>
        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--amber"><i class="bi bi-bell-fill"></i></div>
            <div>
                <div class="rd-kpi-label">Gözləyən təsdiqlər</div>
                <div class="rd-kpi-value">@(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi)</div>
                <div class="rd-kpi-hint">@Model.GozleyenMezuniyyetTesdiqi məz. · @Model.GozleyenIcazeTesdiqi icazə</div>
            </div>
        </div>
        <div class="rd-kpi">
            <div class="rd-kpi-icon rd-kpi-icon--blue"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="rd-kpi-label">Davamiyyət faizi</div>
                <div class="rd-kpi-value">@faiz%</div>
                <div class="rd-progress"><div class="rd-progress-fill" style="width:@faiz%;background:@faizCls"></div></div>
            </div>
        </div>
    </div>

    <!-- ═══ BUGÜNKÜ DAVAMİYYƏT ═══ -->
    <div class="rd-section-head">
        <span class="rd-live-dot"></span> Bugünkü davamiyyət
    </div>
    <div class="rd-stat-row">
        <div class="rd-stat rd-stat--green">
            <div class="rd-stat-num">@Model.BugunIshde</div>
            <div class="rd-stat-lbl">İşdə</div>
        </div>
        <div class="rd-stat rd-stat--amber">
            <div class="rd-stat-num">@Model.BugunGeciken</div>
            <div class="rd-stat-lbl">Gecikən</div>
        </div>
        <div class="rd-stat rd-stat--red">
            <div class="rd-stat-num">@Model.BugunQayib</div>
            <div class="rd-stat-lbl">Qayıb</div>
        </div>
        <div class="rd-stat rd-stat--blue">
            <div class="rd-stat-num">@Model.BugunMezuniyyetde</div>
            <div class="rd-stat-lbl">Məzuniyyətdə</div>
        </div>
        <div class="rd-stat rd-stat--purple">
            <div class="rd-stat-num">@Model.BugunIcazeli</div>
            <div class="rd-stat-lbl">İcazəli</div>
        </div>
    </div>

    <!-- ═══ 3 SÜTUNLU BLOK ═══ -->
    <div class="rd-grid3">

        <!-- Gözləyən Təsdiqlər -->
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Gözləyən təsdiqlər</div>
                <span class="rd-count-badge">@(Model.GozleyenMezuniyyetTesdiqi + Model.GozleyenIcazeTesdiqi)</span>
            </div>
            @if (Model.GozleyenMezuniyyetler.Any())
            {
                <div class="rd-list-label">Məzuniyyət</div>
                @foreach (var m in Model.GozleyenMezuniyyetler)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar">@m.AdSoyad[0]</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@m.AdSoyad</div>
                            <div class="rd-list-meta">@m.Departament · @m.Tarix</div>
                        </div>
                        <span class="fn-badge fn-badge--wait">Məz.</span>
                    </div>
                }
            }
            @if (Model.GozleyenIcazeler.Any())
            {
                <div class="rd-list-label" style="margin-top:8px">İcazə</div>
                @foreach (var ic in Model.GozleyenIcazeler)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar">@ic.AdSoyad[0]</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@ic.AdSoyad</div>
                            <div class="rd-list-meta">@ic.Departament · @ic.Tarix</div>
                        </div>
                        <span class="fn-badge fn-badge--review">İcazə</span>
                    </div>
                }
            }
            @if (!Model.GozleyenMezuniyyetler.Any() && !Model.GozleyenIcazeler.Any())
            {
                <div class="rd-empty">Gözləyən təsdiq yoxdur</div>
            }
        </div>

        <!-- Məzuniyyətdə olanlar -->
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Məzuniyyətdə olanlar</div>
                <span class="rd-count-badge">@Model.HazirdaMezuniyyetde</span>
            </div>
            @if (Model.MezuniyyetdeOlanlar.Any())
            {
                @foreach (var m in Model.MezuniyyetdeOlanlar)
                {
                    <div class="rd-list-item">
                        <div class="rd-avatar rd-avatar--amber">@m.AdSoyad[0]</div>
                        <div class="rd-list-info">
                            <div class="rd-list-name">@m.AdSoyad</div>
                            <div class="rd-list-meta">@m.Departament · @m.Nov</div>
                        </div>
                        <div class="rd-date-tag">@m.BitmeTarixi.ToString("dd.MM")</div>
                    </div>
                }
            }
            else
            {
                <div class="rd-empty">Hal-hazırda məzuniyyətdə olan yoxdur</div>
            }
            <div class="rd-summary-block">
                <div class="rd-summary-row"><span>Bu həftə bitən</span><strong>@Model.BuHefteBitenMezuniyyet</strong></div>
                <div class="rd-summary-row"><span>İllik</span><strong>@Model.IllikMezuniyyetSayi</strong></div>
                <div class="rd-summary-row"><span>Xəstəlik</span><strong>@Model.XestelikMezuniyyetSayi</strong></div>
                <div class="rd-summary-row"><span>Ezamiyyət</span><strong>@Model.EzamiyyetSayi</strong></div>
            </div>
        </div>

        <!-- Son girişlər -->
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Son girişlər</div>
            </div>
            <div class="rd-scroll-area">
                @if (Model.SonGirisler.Any())
                {
                    @foreach (var g in Model.SonGirisler)
                    {
                        var cls = g.Status == 1 ? "fn-badge--done" :
                                  g.Status == 2 ? "fn-badge--wait" :
                                  g.Status == 3 ? "fn-badge--rejected" : "fn-badge--review";
                        var lbl = g.Status == 1 ? "İşdə" :
                                  g.Status == 2 ? "Gecikdi" :
                                  g.Status == 3 ? "Qayıb" : "İcazəli";
                        <div class="rd-list-item">
                            <div class="rd-avatar rd-avatar--blue">@g.Ad[0]</div>
                            <div class="rd-list-info">
                                <div class="rd-list-name">@g.Ad</div>
                                <div class="rd-list-meta">@g.Departament</div>
                            </div>
                            <div class="rd-time-group">
                                @if (g.GirisVaxti != null) { <span class="rd-time rd-time--in">@g.GirisVaxti</span> }
                                @if (g.CixisVaxti != null) { <span class="rd-time rd-time--out">@g.CixisVaxti</span> }
                            </div>
                            <span class="fn-badge @cls">@lbl</span>
                        </div>
                    }
                }
                else
                {
                    <div class="rd-empty">Bugün hələ qeyd yoxdur</div>
                }
            </div>
        </div>
    </div>

    <!-- ═══ ANALİTİKA — Qrafiklər ═══ -->
    <div class="rd-section-head">
        <i class="bi bi-bar-chart-line-fill"></i> Analitika
    </div>
    <div class="rd-grid3">
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Departament üzrə işçilər</div></div>
            <div class="rd-chart-wrap"><canvas id="chartDept"></canvas></div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Kişi / Qadın nisbəti</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartGender"></canvas></div>
            <div class="fn-card-head" style="border-top:1px solid #f0f2f5"><div class="fn-card-title">Yaş qrupları</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartAge"></canvas></div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Staj qrupları</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartStaj"></canvas></div>
            <div class="fn-card-head" style="border-top:1px solid #f0f2f5"><div class="fn-card-title">Vəzifə paylanması (Top 10)</div></div>
            <div class="rd-chart-wrap rd-chart-wrap--sm"><canvas id="chartVezife"></canvas></div>
        </div>
    </div>

    <!-- ═══ MALİYYƏ ═══ -->
    <div class="rd-section-head">
        <i class="bi bi-cash-stack"></i> Maaş / Maliyyə
    </div>
    <div class="fn-grid2">
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Bu ayın maaş fondu</div></div>
            <div class="rd-fin-grid">
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Brut fond</div>
                    <div class="rd-fin-val">@Model.UmumiBrutMaas.ToString("N0") <small>AZN</small></div>
                </div>
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Net fond</div>
                    <div class="rd-fin-val">@Model.UmumiNetMaas.ToString("N0") <small>AZN</small></div>
                </div>
                <div class="rd-fin-box">
                    <div class="rd-fin-lbl">Orta maaş</div>
                    <div class="rd-fin-val">@Model.OrtaMaas.ToString("N0") <small>AZN</small></div>
                </div>
            </div>
            <div class="rd-maas-pills">
                <span class="rd-pill rd-pill--gray">Layihə: @Model.MaasLayihe</span>
                <span class="rd-pill rd-pill--blue">Təsdiqlənib: @Model.MaasTesdiqlendi</span>
                <span class="rd-pill rd-pill--green">Ödənildi: @Model.MaasOdenildi</span>
            </div>
        </div>
        <div class="fn-card">
            <div class="fn-card-head"><div class="fn-card-title">Son maaş dəyişiklikləri</div></div>
            <div class="rd-scroll-area">
                @if (Model.SonMaasDeyisiklikleri.Any())
                {
                    <table class="rd-table">
                        <thead><tr><th>İşçi</th><th>Köhnə</th><th>Yeni</th><th>Tarix</th></tr></thead>
                        <tbody>
                            @foreach (var d in Model.SonMaasDeyisiklikleri)
                            {
                                var diff = d.YeniMaas - d.KohneMaas;
                                var cls = diff > 0 ? "rd-up" : diff < 0 ? "rd-down" : "";
                                <tr>
                                    <td class="rd-t-bold">@d.AdSoyad</td>
                                    <td>@d.KohneMaas.ToString("N0")</td>
                                    <td class="@cls">@d.YeniMaas.ToString("N0")</td>
                                    <td class="rd-t-muted">@d.Tarix.ToString("dd.MM.yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="rd-empty">Maaş dəyişikliyi yoxdur</div>
                }
            </div>
        </div>
    </div>

    <!-- ═══ DEPARTAMENT CƏDVƏLİ ═══ -->
    @if (Model.DepartamentStat.Any())
    {
        <div class="rd-section-head">
            <i class="bi bi-diagram-3-fill"></i> Departament detalları
        </div>
        <div class="fn-card fn-card--full">
            <table class="rd-table">
                <thead>
                    <tr><th>Departament</th><th>Ümumi</th><th>Kişi</th><th>Qadın</th><th>Nisbət</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DepartamentStat)
                    {
                        var pct = d.IsciSayi > 0 ? (int)((double)d.KisiSayi / d.IsciSayi * 100) : 0;
                        <tr>
                            <td class="rd-t-bold">@d.Ad</td>
                            <td><strong>@d.IsciSayi</strong></td>
                            <td>@d.KisiSayi</td>
                            <td>@d.QadinSayi</td>
                            <td>
                                <div class="rd-ratio-bar">
                                    <div class="rd-ratio-fill" style="width:@pct%"></div>
                                </div>
                                <span class="rd-ratio-text">@pct% K</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
        Chart.defaults.font.size = 11;
        Chart.defaults.plugins.legend.display = false;

        const pal = ['#1e2a3b','#2d6cdf','#1e9b6b','#d4920a','#c83838','#7c3aed','#0ea5e9','#ec4899','#f59e0b','#6366f1'];

        new Chart(document.getElementById('chartDept'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.Ad))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DepartamentStat.Select(x => x.IsciSayi))),
                    backgroundColor: pal.slice(0, @Model.DepartamentStat.Count),
                    borderRadius: 5, barThickness: 24
                }]
            },
            options: { indexAxis:'y', responsive:true, maintainAspectRatio:false,
                scales: { x:{grid:{display:false},ticks:{precision:0}}, y:{grid:{display:false}} } }
        });

        new Chart(document.getElementById('chartGender'), {
            type: 'doughnut',
            data: { labels:['Kişi','Qadın'], datasets:[{ data:[@Model.KisiSayi,@Model.QadinSayi], backgroundColor:['#2d6cdf','#ec4899'], borderWidth:0 }] },
            options: { responsive:true, maintainAspectRatio:false, cutout:'60%',
                plugins:{ legend:{ display:true, position:'bottom', labels:{boxWidth:10,padding:10} } } }
        });

        new Chart(document.getElementById('chartAge'), {
            type: 'doughnut',
            data: { labels:['20-30','30-40','40-50','50+'], datasets:[{ data:[@Model.Yas20_30,@Model.Yas30_40,@Model.Yas40_50,@Model.Yas50Plus], backgroundColor:['#1e9b6b','#2d6cdf','#d4920a','#c83838'], borderWidth:0 }] },
            options: { responsive:true, maintainAspectRatio:false, cutout:'60%',
                plugins:{ legend:{ display:true, position:'bottom', labels:{boxWidth:10,padding:10} } } }
        });

        new Chart(document.getElementById('chartStaj'), {
            type: 'bar',
            data: { labels:['0-1 il','1-3 il','3-5 il','5+ il'], datasets:[{ data:[@Model.Staj0_1,@Model.Staj1_3,@Model.Staj3_5,@Model.Staj5Plus], backgroundColor:['#0ea5e9','#2d6cdf','#7c3aed','#1e2a3b'], borderRadius:5, barThickness:28 }] },
            options: { responsive:true, maintainAspectRatio:false,
                scales: { x:{grid:{display:false}}, y:{grid:{color:'#f3f4f8'},ticks:{precision:0}} } }
        });

        new Chart(document.getElementById('chartVezife'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.Ad))),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VezifeStat.Select(x => x.IsciSayi))),
                    backgroundColor: pal.slice(0, @Model.VezifeStat.Count),
                    borderRadius: 5, barThickness: 24
                }]
            },
            options: { indexAxis:'y', responsive:true, maintainAspectRatio:false,
                scales: { x:{grid:{display:false},ticks:{precision:0}}, y:{grid:{display:false}} } }
        });
    </script>
}
