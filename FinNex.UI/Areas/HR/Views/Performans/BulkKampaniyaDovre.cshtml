@{
    ViewData["Title"] = "Dövr Seçin";
    var kampTipi = (int)(ViewBag.KampaniyaTipi ?? 1);
    var isSobeR  = kampTipi == 2;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">
                @if (isSobeR)
                { <i class="bi bi-person-badge me-2" style="color:#f59e0b;"></i> }
                else
                { <i class="bi bi-people me-2" style="color:#6366f1;"></i> }
                @(isSobeR ? "Şöbə Rəisi" : "İşçi") Qiymətləndirməsi — Dövr Seçin
            </div>
            <div class="fn-page-sub">Hansı dövr üçün kampaniya başlatmaq istəyirsiniz?</div>
        </div>
        <a asp-action="BulkKampaniya" class="fn-btn fn-btn--outline fn-btn--sm">← Tipi dəyiş</a>
    </div>

    <form asp-action="BulkKampaniya" method="get" style="max-width:480px;margin:40px auto;">
        <input type="hidden" name="tipi" value="@kampTipi" />

        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:28px 32px;">

            <div class="fn-form-row" style="margin-bottom:16px;">
                <label class="fn-label">Dövr Tipi</label>
                <select name="dovrTipi" id="dovrTipi" class="fn-input">
                    <option value="1">Rüblük</option>
                    <option value="2">İllik</option>
                </select>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:24px;">
                <div class="fn-form-row" style="margin-bottom:0">
                    <label class="fn-label">İl</label>
                    <select name="il" class="fn-input">
                        @foreach (var y in Enumerable.Range(DateTime.Now.Year - 1, 3).Reverse())
                        { <option value="@y" selected="@(y == DateTime.Now.Year ? "selected" : null)">@y</option> }
                    </select>
                </div>
                <div class="fn-form-row" style="margin-bottom:0" id="rubuRow">
                    <label class="fn-label">Rüb</label>
                    <select name="rubu" class="fn-input">
                        <option value="1">Rüb 1</option>
                        <option value="2">Rüb 2</option>
                        <option value="3">Rüb 3</option>
                        <option value="4">Rüb 4</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="fn-btn fn-btn--primary" style="width:100%;">
                <i class="bi bi-people me-1"></i> İşçi Siyahısını Göstər
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('dovrTipi').addEventListener('change', function () {
            document.getElementById('rubuRow').style.display = this.value === '2' ? 'none' : '';
        });
    </script>
}
