@{
    ViewData["Title"] = "Yeni Performans Qiymətləndirmə";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni Performans Qiymətləndirmə</div>
            <div class="fn-page-sub">İşçi seçin, kriteriyaları tənzimləyin</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">← Siyahı</a>
    </div>

    <form asp-action="Create" method="post" id="prfForm">
        @Html.AntiForgeryToken()

        <div class="fn-card" style="margin-bottom:16px;">
            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <i class="bi bi-person"></i> İşçi və Müdir
                </div>
                <div class="prf-create-grid" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;">
                    <div class="fn-form-row">
                        <label class="fn-label">İşçi <span style="color:#dc2626">*</span></label>
                        <select name="isciId" id="isciSelect" class="fn-input" required>
                            <option value="">İşçi seçin...</option>
                            @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Şöbə Rəisi <span style="color:#64748b;font-weight:400;">(avtomatik / ixtiyari)</span></label>
                        <select name="sobeReisiId" id="sobeReisiSelect" class="fn-input">
                            <option value="">— yoxdur —</option>
                            @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <div class="prf-mudir-hint" id="sobeReisiHint" style="display:none;">
                            <i class="bi bi-info-circle"></i>
                            <span id="sobeReisiHintText"></span>
                        </div>
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Rəhbər <span style="color:#dc2626">*</span></label>
                        <select name="qiymetlendirenIsciId" id="rehberSelect" class="fn-input" required>
                            <option value="">Rəhbər seçin...</option>
                            @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <div class="prf-mudir-hint" id="rehberHint" style="display:none;">
                            <i class="bi bi-info-circle"></i>
                            <span id="rehberHintText"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fn-card" style="margin-bottom:16px;">
            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <i class="bi bi-calendar3"></i> Dövr Məlumatları
                </div>
                <div class="prf-create-grid prf-create-grid--3">
                    <div class="fn-form-row">
                        <label class="fn-label">Dövr Tipi <span style="color:#dc2626">*</span></label>
                        <select name="dovrTipi" id="dovrTipi" class="fn-input" required>
                            <option value="1">Rüblük</option>
                            <option value="2">İllik</option>
                        </select>
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">İl <span style="color:#dc2626">*</span></label>
                        <select name="il" class="fn-input" required>
                            @foreach (var item in ViewBag.Iller as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                if (item.Selected)
                                { <option value="@item.Value" selected="selected">@item.Text</option> }
                                else
                                { <option value="@item.Value">@item.Text</option> }
                            }
                        </select>
                    </div>
                    <div class="fn-form-row" id="rubuRow">
                        <label class="fn-label">Rüb</label>
                        <select name="rubu" class="fn-input">
                            <option value="1">Rüb 1</option>
                            <option value="2">Rüb 2</option>
                            <option value="3">Rüb 3</option>
                            <option value="4">Rüb 4</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="fn-card" style="margin-bottom:16px;">
            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <i class="bi bi-list-check"></i> Kriteriyalar
                    <span class="prf-ceki-total" id="cekiTotal">Cəmi: 100%</span>
                </div>

                <div id="kriteriyaContainer">
                    <div class="prf-kr-row" data-index="0">
                        <div class="prf-kr-fields">
                            <input type="text" name="kriteriyaAdlari[0]" class="fn-input prf-kr-ad" value="İş keyfiyyəti" placeholder="Kriteriya adı" required />
                            <div class="prf-kr-ceki-wrap">
                                <input type="number" name="kriteriyaCekileri[0]" class="fn-input prf-kr-ceki" value="30" min="1" max="100" required />
                                <span class="prf-kr-pct">%</span>
                            </div>
                            <button type="button" class="prf-kr-sil" title="Sil">&times;</button>
                        </div>
                    </div>
                    <div class="prf-kr-row" data-index="1">
                        <div class="prf-kr-fields">
                            <input type="text" name="kriteriyaAdlari[1]" class="fn-input prf-kr-ad" value="Vaxtında icra" placeholder="Kriteriya adı" required />
                            <div class="prf-kr-ceki-wrap">
                                <input type="number" name="kriteriyaCekileri[1]" class="fn-input prf-kr-ceki" value="20" min="1" max="100" required />
                                <span class="prf-kr-pct">%</span>
                            </div>
                            <button type="button" class="prf-kr-sil" title="Sil">&times;</button>
                        </div>
                    </div>
                    <div class="prf-kr-row" data-index="2">
                        <div class="prf-kr-fields">
                            <input type="text" name="kriteriyaAdlari[2]" class="fn-input prf-kr-ad" value="Komanda işi" placeholder="Kriteriya adı" required />
                            <div class="prf-kr-ceki-wrap">
                                <input type="number" name="kriteriyaCekileri[2]" class="fn-input prf-kr-ceki" value="20" min="1" max="100" required />
                                <span class="prf-kr-pct">%</span>
                            </div>
                            <button type="button" class="prf-kr-sil" title="Sil">&times;</button>
                        </div>
                    </div>
                    <div class="prf-kr-row" data-index="3">
                        <div class="prf-kr-fields">
                            <input type="text" name="kriteriyaAdlari[3]" class="fn-input prf-kr-ad" value="Təşəbbüskarlıq" placeholder="Kriteriya adı" required />
                            <div class="prf-kr-ceki-wrap">
                                <input type="number" name="kriteriyaCekileri[3]" class="fn-input prf-kr-ceki" value="15" min="1" max="100" required />
                                <span class="prf-kr-pct">%</span>
                            </div>
                            <button type="button" class="prf-kr-sil" title="Sil">&times;</button>
                        </div>
                    </div>
                    <div class="prf-kr-row" data-index="4">
                        <div class="prf-kr-fields">
                            <input type="text" name="kriteriyaAdlari[4]" class="fn-input prf-kr-ad" value="Peşəkar inkişaf" placeholder="Kriteriya adı" required />
                            <div class="prf-kr-ceki-wrap">
                                <input type="number" name="kriteriyaCekileri[4]" class="fn-input prf-kr-ceki" value="15" min="1" max="100" required />
                                <span class="prf-kr-pct">%</span>
                            </div>
                            <button type="button" class="prf-kr-sil" title="Sil">&times;</button>
                        </div>
                    </div>
                </div>

                <button type="button" class="prf-kr-elave" id="btnKriteriyaElave">
                    <i class="bi bi-plus-circle"></i> Yeni kriteriya əlavə et
                </button>

                <div class="prf-ceki-error" id="cekiError" style="display:none;">
                    <i class="bi bi-exclamation-triangle"></i> Çəkilərin cəmi 100% olmalıdır
                </div>
            </div>
        </div>

        <div class="prf-create-actions">
            <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
            <button type="submit" class="fn-btn fn-btn--primary" id="btnYarat">
                <i class="bi bi-check-lg"></i> Yarat
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Dövr tipi dəyişəndə rüb gizlə/göstər
        document.getElementById('dovrTipi').addEventListener('change', function () {
            document.getElementById('rubuRow').style.display = this.value === '2' ? 'none' : '';
        });

        // İşçi seçiləndə avtomatik şöbə rəisi və rəhbər tap
        document.getElementById('isciSelect').addEventListener('change', function () {
            var isciId = this.value;
            if (!isciId) {
                document.getElementById('sobeReisiHint').style.display = 'none';
                document.getElementById('rehberHint').style.display = 'none';
                return;
            }
            fetch('/HR/Performans/GetMudir?isciId=' + isciId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.sobeReisiId) {
                        document.getElementById('sobeReisiSelect').value = data.sobeReisiId;
                        document.getElementById('sobeReisiHintText').textContent = 'Avtomatik: ' + data.sobeReisiAd;
                        document.getElementById('sobeReisiHint').style.display = 'flex';
                    } else {
                        document.getElementById('sobeReisiHint').style.display = 'none';
                    }
                    if (data.rehberId) {
                        document.getElementById('rehberSelect').value = data.rehberId;
                        document.getElementById('rehberHintText').textContent = 'Avtomatik: ' + data.rehberAd;
                        document.getElementById('rehberHint').style.display = 'flex';
                    } else {
                        document.getElementById('rehberHint').style.display = 'none';
                    }
                })
                .catch(function() {});
        });

        // Kriteriya əlavə et
        var kriteriyaIndex = 5;
        document.getElementById('btnKriteriyaElave').addEventListener('click', function () {
            var container = document.getElementById('kriteriyaContainer');
            var html = '<div class="prf-kr-row" data-index="' + kriteriyaIndex + '">' +
                '<div class="prf-kr-fields">' +
                '<input type="text" name="kriteriyaAdlari[' + kriteriyaIndex + ']" class="fn-input prf-kr-ad" placeholder="Kriteriya adı" required />' +
                '<div class="prf-kr-ceki-wrap">' +
                '<input type="number" name="kriteriyaCekileri[' + kriteriyaIndex + ']" class="fn-input prf-kr-ceki" value="10" min="1" max="100" required />' +
                '<span class="prf-kr-pct">%</span></div>' +
                '<button type="button" class="prf-kr-sil" title="Sil">&times;</button>' +
                '</div></div>';
            container.insertAdjacentHTML('beforeend', html);
            kriteriyaIndex++;
            updateCekiTotal();
        });

        // Kriteriya sil
        document.getElementById('kriteriyaContainer').addEventListener('click', function (e) {
            if (e.target.classList.contains('prf-kr-sil')) {
                var rows = document.querySelectorAll('.prf-kr-row');
                if (rows.length <= 1) return; // Ən azı 1 kriteriya qalmalı
                e.target.closest('.prf-kr-row').remove();
                reindexKriteriyalar();
                updateCekiTotal();
            }
        });

        // Çəki dəyişəndə cəmi yenilə
        document.getElementById('kriteriyaContainer').addEventListener('input', function (e) {
            if (e.target.classList.contains('prf-kr-ceki')) {
                updateCekiTotal();
            }
        });

        function updateCekiTotal() {
            var inputs = document.querySelectorAll('.prf-kr-ceki');
            var total = 0;
            inputs.forEach(function (inp) { total += parseInt(inp.value) || 0; });
            var el = document.getElementById('cekiTotal');
            var err = document.getElementById('cekiError');
            el.textContent = 'Cəmi: ' + total + '%';
            if (total !== 100) {
                el.style.color = '#dc2626';
                err.style.display = 'flex';
            } else {
                el.style.color = '#059669';
                err.style.display = 'none';
            }
        }

        function reindexKriteriyalar() {
            var rows = document.querySelectorAll('.prf-kr-row');
            rows.forEach(function (row, i) {
                row.dataset.index = i;
                row.querySelector('.prf-kr-ad').name = 'kriteriyaAdlari[' + i + ']';
                row.querySelector('.prf-kr-ceki').name = 'kriteriyaCekileri[' + i + ']';
            });
            kriteriyaIndex = rows.length;
        }

        // Form submit zamanı çəki yoxla
        document.getElementById('prfForm').addEventListener('submit', function (e) {
            var inputs = document.querySelectorAll('.prf-kr-ceki');
            var total = 0;
            inputs.forEach(function (inp) { total += parseInt(inp.value) || 0; });
            if (total !== 100) {
                e.preventDefault();
                alert('Kriteriya çəkilərinin cəmi 100% olmalıdır. Hal-hazırda: ' + total + '%');
            }
        });

        updateCekiTotal();
    </script>
}
