@{
    ViewData["Title"] = "Yeni Performans Qiymətləndirmə";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni Performans Qiymətləndirmə</div>
            <div class="fn-page-sub">İşçi seçin və qiymətləndirmə yaradın</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Siyahı
        </a>
    </div>

    <div class="fn-card prf-create-card">
        <div class="prf-create-header">
            <div class="prf-create-header-icon">
                <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1l1.7 3.5 3.8.5-2.7 2.7.6 3.8L7 9.8 3.6 11.5l.6-3.8L1.5 5l3.8-.5L7 1z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                </svg>
            </div>
            <div>
                <div class="prf-create-header-title">Qiymətləndirmə Məlumatları</div>
                <div class="prf-create-header-sub">Zəruri sahələri doldurun</div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1.5 12c0-3 2.5-4.5 5.5-4.5S12 9 12 12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                    İşçi və Müdir
                </div>

                <div class="prf-create-grid prf-create-grid--2">
                    <div class="fn-form-row">
                        <label class="fn-label">İşçi <span class="fn-required">*</span></label>
                        <select name="isciId" class="fn-input" required>
                            <option value="">İşçi seçin...</option>
                            @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="fn-form-row">
                        <label class="fn-label">Qiymətləndirən (Müdir) <span class="fn-required">*</span></label>
                        <select name="qiymetlendirenIsciId" class="fn-input" required>
                            <option value="">Müdir seçin...</option>
                            @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1 5h12M5 2v2M9 2v2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                    </svg>
                    Dövr Məlumatları
                </div>

                <div class="prf-create-grid prf-create-grid--3">
                    <div class="fn-form-row">
                        <label class="fn-label">Dövr Tipi <span class="fn-required">*</span></label>
                        <select name="dovrTipi" id="dovrTipi" class="fn-input" required>
                            <option value="1">Rüblük</option>
                            <option value="2">İllik</option>
                        </select>
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">İl <span class="fn-required">*</span></label>
                        <select name="il" class="fn-input" required>
                            @foreach (var item in ViewBag.Iller as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            {
                                if (item.Selected)
                                { <option value="@item.Value" selected>@item.Text</option> }
                                else
                                { <option value="@item.Value">@item.Text</option> }
                            }
                        </select>
                    </div>
                    <div class="fn-form-row" id="rubuRow">
                        <label class="fn-label">Rüb</label>
                        <select name="rubu" class="fn-input">
                            <option value="1">Rüb 1</option>
                            <option value="2">Rüb 2</option>
                            <option value="3">Rüb 3</option>
                            <option value="4">Rüb 4</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="prf-create-section">
                <div class="prf-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M2 11V4l5-2.5L12 4v7l-5 2.5L2 11z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        <path d="M7 6v5M2 4l5 2.5L12 4" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                    </svg>
                    Defolt Kriteriyalar
                </div>

                <div class="prf-criteria-table-wrap">
                    <table class="prf-criteria-table">
                        <thead>
                            <tr>
                                <th class="left">Kriteriya</th>
                                <th>Çəki</th>
                                <th>Vizual</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="left">
                                    <div class="prf-criteria-name">İş keyfiyyəti</div>
                                    <div class="prf-criteria-desc">Tapşırıqların dəqiq və keyfiyyətli icrası</div>
                                </td>
                                <td><span class="prf-criteria-weight prf-criteria-weight--blue">30%</span></td>
                                <td>
                                    <div class="prf-criteria-bar">
                                        <div class="prf-criteria-bar-fill prf-criteria-bar-fill--blue" style="width:30%"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="left">
                                    <div class="prf-criteria-name">Vaxtında icra</div>
                                    <div class="prf-criteria-desc">Son tarixlərə riayət</div>
                                </td>
                                <td><span class="prf-criteria-weight prf-criteria-weight--green">20%</span></td>
                                <td>
                                    <div class="prf-criteria-bar">
                                        <div class="prf-criteria-bar-fill prf-criteria-bar-fill--green" style="width:20%"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="left">
                                    <div class="prf-criteria-name">Komanda işi</div>
                                    <div class="prf-criteria-desc">Əməkdaşlarla birgə iş bacarığı</div>
                                </td>
                                <td><span class="prf-criteria-weight prf-criteria-weight--purple">20%</span></td>
                                <td>
                                    <div class="prf-criteria-bar">
                                        <div class="prf-criteria-bar-fill prf-criteria-bar-fill--purple" style="width:20%"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="left">
                                    <div class="prf-criteria-name">Təşəbbüskarlıq</div>
                                    <div class="prf-criteria-desc">Yeni ideyalar və fəallıq</div>
                                </td>
                                <td><span class="prf-criteria-weight prf-criteria-weight--orange">15%</span></td>
                                <td>
                                    <div class="prf-criteria-bar">
                                        <div class="prf-criteria-bar-fill prf-criteria-bar-fill--orange" style="width:15%"></div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td class="left">
                                    <div class="prf-criteria-name">Peşəkar inkişaf</div>
                                    <div class="prf-criteria-desc">Öyrənmə və bacarıq artırma</div>
                                </td>
                                <td><span class="prf-criteria-weight prf-criteria-weight--teal">15%</span></td>
                                <td>
                                    <div class="prf-criteria-bar">
                                        <div class="prf-criteria-bar-fill prf-criteria-bar-fill--teal" style="width:15%"></div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="prf-info-box">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M7 5v4M7 10.2v.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                    Yaradılandan sonra yuxarıdakı kriteriyalar avtomatik əlavə edilir. Sonradan redaktə edə bilərsiniz.
                </div>
            </div>

            <div class="prf-create-actions">
                <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Yarat
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('dovrTipi').addEventListener('change', function () {
            document.getElementById('rubuRow').style.display = this.value === '2' ? 'none' : '';
        });
    </script>
}
