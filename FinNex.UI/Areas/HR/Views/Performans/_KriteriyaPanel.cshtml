@using FinNex.Domain.Entities.HR
@{
    var panelList  = ViewData["PanelList"]  as List<PerformansKriteriyaSablon> ?? new();
    var panelTipi  = (int)(ViewData["PanelTipi"]  ?? 1);
    var panelTitle = (string)(ViewData["PanelTitle"] ?? "");
    var panelColor = (string)(ViewData["PanelColor"] ?? "#6366f1");
    var panelIcon  = (string)(ViewData["PanelIcon"]  ?? "bi-people");
    var panelCemi  = (decimal)(ViewData["PanelCemi"] ?? 0m);
    bool cekiOk    = panelCemi == 100;
}

<div class="krit-panel">
    <div class="krit-panel-head">
        <div class="krit-panel-title">
            <i class="bi @panelIcon" style="color:@panelColor;font-size:16px;"></i>
            @panelTitle
        </div>
        <span class="krit-ceki-badge @(cekiOk ? "krit-ceki-ok" : "krit-ceki-warn")">
            Cəm: @panelCemi%  @(cekiOk ? "✓" : "≠ 100%")
        </span>
    </div>

    <table class="krit-table">
        <thead>
            <tr>
                <th>Kriteriya</th>
                <th style="width:70px;">Çəki %</th>
                <th style="width:60px;">Status</th>
                <th style="width:110px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in panelList)
            {
                <tr class="@(!k.Aktiv ? "krit-inactive" : "")">
                    <td><strong>@k.Ad</strong></td>
                    <td>@k.Ceki%</td>
                    <td>
                        @if (k.Aktiv)
                        { <span style="font-size:11px;background:#dcfce7;color:#16a34a;padding:2px 7px;border-radius:10px;">Aktiv</span> }
                        else
                        { <span style="font-size:11px;background:#f1f5f9;color:#64748b;padding:2px 7px;border-radius:10px;">Passiv</span> }
                    </td>
                    <td style="text-align:right;">
                        <button class="fn-btn fn-btn--outline fn-btn--sm"
                                onclick="editOpen(@k.Id,'@Html.Raw(k.Ad.Replace("'","\\'"))',@k.Ceki,@(k.Aktiv ? "true" : "false"))">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <form asp-action="KriteriyaSil" method="post" style="display:inline;"
                              onsubmit="return confirm('Silmək istəyirsiniz?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@k.Id" />
                            <button class="fn-btn fn-btn--sm" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            @if (!panelList.Any())
            {
                <tr><td colspan="4" style="text-align:center;color:#94a3b8;padding:24px;font-size:13px;">Hələ kriteriya yoxdur</td></tr>
            }
        </tbody>
    </table>

    @* ── Yeni Əlavə Et ── *@
    <form asp-action="KriteriyaYarat" method="post" class="krit-add-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="kampaniyaTipi" value="@panelTipi" />
        <div style="flex:1;">
            <div style="font-size:11px;color:#64748b;margin-bottom:3px;">Kriteriya adı</div>
            <input type="text" name="ad" class="fn-input" placeholder="Məs: İş keyfiyyəti" required style="font-size:13px;" />
        </div>
        <div style="width:80px;">
            <div style="font-size:11px;color:#64748b;margin-bottom:3px;">Çəki %</div>
            <input type="number" name="ceki" class="fn-input" placeholder="20" min="1" max="100" required style="font-size:13px;" />
        </div>
        <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm" style="background:@panelColor;border-color:@panelColor;">
            <i class="bi bi-plus-lg"></i> Əlavə et
        </button>
    </form>
</div>

@* ── Redaktə Modal ── *@
<div id="editModal_@panelTipi" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:12px;padding:28px;width:380px;box-shadow:0 20px 60px rgba(0,0,0,.2);">
        <div style="font-size:15px;font-weight:700;color:#1e293b;margin-bottom:18px;">
            <i class="bi @panelIcon" style="color:@panelColor;"></i> Kriteriya Redaktə
        </div>
        <form asp-action="KriteriyaYenile" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editId_@panelTipi" />
            <div class="fn-form-row" style="margin-bottom:12px;">
                <label class="fn-label">Ad</label>
                <input type="text" name="ad" id="editAd_@panelTipi" class="fn-input" required />
            </div>
            <div class="fn-form-row" style="margin-bottom:12px;">
                <label class="fn-label">Çəki %</label>
                <input type="number" name="ceki" id="editCeki_@panelTipi" class="fn-input" min="1" max="100" required />
            </div>
            <div class="fn-form-row" style="margin-bottom:18px;display:flex;align-items:center;gap:8px;">
                <input type="checkbox" name="aktiv" id="editAktiv_@panelTipi" value="true" style="width:16px;height:16px;" />
                <label for="editAktiv_@panelTipi" class="fn-label" style="margin:0;cursor:pointer;">Aktiv</label>
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
                <button type="button" onclick="editClose(@panelTipi)" class="fn-btn fn-btn--outline fn-btn--sm">Ləğv et</button>
                <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm" style="background:@panelColor;border-color:@panelColor;">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

<script>
    function editOpen(id, ad, ceki, aktiv) {
        var t = @panelTipi;
        document.getElementById('editId_'   + t).value   = id;
        document.getElementById('editAd_'   + t).value   = ad;
        document.getElementById('editCeki_' + t).value   = ceki;
        document.getElementById('editAktiv_'+ t).checked = aktiv;
        var m = document.getElementById('editModal_' + t);
        m.style.display = 'flex';
    }
    function editClose(t) {
        document.getElementById('editModal_' + t).style.display = 'none';
    }
</script>
