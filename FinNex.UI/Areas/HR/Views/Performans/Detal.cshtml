@model FinNex.Domain.Entities.HR.PerformansQiymetlendirme
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = $"Performans — {Model.Isci.Ad} {Model.Isci.Soyad}";

    var teyinat = Model.Isci.IsciTeyinatlari.FirstOrDefault();

    string StatusClass(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "prf-badge--wait",
        PerformansStatus.IsciQiymetlendirdi => "prf-badge--progress",
        PerformansStatus.MudirQiymetlendirdi => "prf-badge--review",
        PerformansStatus.Tamamlandi => "prf-badge--done",
        _ => "prf-badge--wait"
    };
    string StatusText(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "Gözləmədə",
        PerformansStatus.IsciQiymetlendirdi => "İşçi qiymətləndirdi",
        PerformansStatus.MudirQiymetlendirdi => "Müdir qiymətləndirdi",
        PerformansStatus.Tamamlandi => "Tamamlandı",
        _ => "—"
    };
    string QiymetClass(decimal q) => q >= 4 ? "prf-q--high" : q >= 3 ? "prf-q--mid" : q > 0 ? "prf-q--low" : "";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.Isci.Ad @Model.Isci.Soyad</div>
            <div class="fn-page-sub">
                @(teyinat?.Departament?.Ad ?? "—") ·
                @(teyinat?.Vezife?.Ad ?? "—") ·
                @(Model.DovrTipi == PerformansDovrTipi.Rublik ? $"Rüb {Model.Rubu}" : "İllik") @Model.Il ·
                <span class="prf-badge @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">← Siyahı</a>
    </div>

    @* ── Qiymet Kartlari ─────────────────────────────────── *@
    <div class="prf-score-cards">
        <div class="prf-score-card prf-score-card--isci">
            <div class="prf-score-label">İşçi Ortalaması</div>
            <div class="prf-score-value @QiymetClass(Model.IsciOrtalamaQiymet)">
                @(Model.IsciOrtalamaQiymet > 0 ? Model.IsciOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.IsciQiymetlendirmeTarixi.HasValue)
            {
                <div class="prf-score-date">@Model.IsciQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
            }
        </div>
        <div class="prf-score-card prf-score-card--mudir">
            <div class="prf-score-label">Müdir Ortalaması</div>
            <div class="prf-score-value @QiymetClass(Model.MudirOrtalamaQiymet)">
                @(Model.MudirOrtalamaQiymet > 0 ? Model.MudirOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.MudirQiymetlendirmeTarixi.HasValue)
            {
                <div class="prf-score-date">@Model.MudirQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
            }
        </div>
        <div class="prf-score-card prf-score-card--yekun">
            <div class="prf-score-label">Yekun Qiymət</div>
            <div class="prf-score-value @QiymetClass(Model.YekunQiymet)">
                @(Model.YekunQiymet > 0 ? Model.YekunQiymet.ToString("N2") : "—")
            </div>
            <div class="prf-score-date">5 üzrə qiymət</div>
        </div>
    </div>

    @* ── Kriteriya Cedveli ────────────────────────────────── *@
    <div class="fn-card" style="padding:0;overflow:hidden;">
        <div class="prf-section-head">Kriteriyalar</div>
        <div class="prf-table-wrap">
            <table class="prf-table prf-table--detail">
                <thead>
                    <tr>
                        <th class="left">Kriteriya</th>
                        <th>Çəki (%)</th>
                        <th>İşçi Qiyməti</th>
                        <th>İşçi Şərhi</th>
                        <th>Müdir Qiyməti</th>
                        <th>Müdir Şərhi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                    {
                        <tr>
                            <td class="left"><strong>@k.KriteriyaAdi</strong></td>
                            <td>@k.Ceki%</td>
                            <td>
                                @if (k.IsciQiymeti.HasValue)
                                {
                                    <span class="prf-q @QiymetClass(k.IsciQiymeti.Value)">@k.IsciQiymeti.Value.ToString("N1")</span>
                                }
                                else
                                { <span class="prf-q--empty">—</span> }
                            </td>
                            <td class="prf-sherh-cell">@(k.IsciSherhi ?? "—")</td>
                            <td>
                                @if (k.MudirQiymeti.HasValue)
                                {
                                    <span class="prf-q @QiymetClass(k.MudirQiymeti.Value)">@k.MudirQiymeti.Value.ToString("N1")</span>
                                }
                                else
                                { <span class="prf-q--empty">—</span> }
                            </td>
                            <td class="prf-sherh-cell">@(k.MudirSherhi ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Sherhler ─────────────────────────────────────────── *@
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px;">
        <div class="fn-card">
            <div class="fn-card-title">İşçi Şərhi</div>
            <div class="prf-sherh-text">@(Model.IsciSherhi ?? "Hələ yazılmayıb")</div>
        </div>
        <div class="fn-card">
            <div class="fn-card-title">Müdir Şərhi</div>
            <div class="prf-sherh-text">@(Model.MudirSherhi ?? "Hələ yazılmayıb")</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.InkisafPlani))
    {
        <div class="fn-card" style="margin-top:12px;">
            <div class="fn-card-title">İnkişaf Planı</div>
            <div class="prf-sherh-text">@Model.InkisafPlani</div>
        </div>
    }

    @* ── Isci Qiymetlendirme Formu ───────────────────────── *@
    @if (Model.Status == PerformansStatus.Gozlemede)
    {
        <div class="fn-card prf-form-card" style="margin-top:20px;">
            <div class="fn-card-title">İşçi Qiymətləndirməsi</div>
            <form asp-action="IsciQiymetlendir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="performansId" value="@Model.Id" />

                @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                {
                    <div class="prf-krit-form-row">
                        <div class="prf-krit-name">@k.KriteriyaAdi <span class="prf-krit-ceki">(@k.Ceki%)</span></div>
                        <input type="hidden" name="kriteriyaIds" value="@k.Id" />
                        <div class="prf-krit-inputs">
                            <select name="isciQiymetleri" class="fn-input fn-input--sm" required>
                                <option value="">Qiymət...</option>
                                <option value="1">1 - Çox zəif</option>
                                <option value="2">2 - Zəif</option>
                                <option value="3">3 - Orta</option>
                                <option value="4">4 - Yaxşı</option>
                                <option value="5">5 - Əla</option>
                            </select>
                            <input type="text" name="isciSherhler" class="fn-input fn-input--sm" placeholder="Şərh..." />
                        </div>
                    </div>
                }

                <div class="fn-form-row" style="margin-top:12px;">
                    <label class="fn-label">Qeyd / Şərh</label>
                    <textarea name="isciSherhi" class="fn-input" rows="3" placeholder="Ümumi qeydə..."></textarea>
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">İnkişaf Planı</label>
                    <textarea name="inkisafPlani" class="fn-input" rows="3" placeholder="İnkişaf təklifləri..."></textarea>
                </div>

                <div style="display:flex;justify-content:flex-end;margin-top:12px;">
                    <button type="submit" class="fn-btn fn-btn--primary">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Qiymətləndir
                    </button>
                </div>
            </form>
        </div>
    }

    @* ── Mudir Qiymetlendirme Formu ──────────────────────── *@
    @if (Model.Status == PerformansStatus.IsciQiymetlendirdi || Model.Status == PerformansStatus.Gozlemede)
    {
        <div class="fn-card prf-form-card" style="margin-top:16px;">
            <div class="fn-card-title">Müdir Qiymətləndirməsi</div>
            <form asp-action="MudirQiymetlendir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="performansId" value="@Model.Id" />

                @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                {
                    <div class="prf-krit-form-row">
                        <div class="prf-krit-name">@k.KriteriyaAdi <span class="prf-krit-ceki">(@k.Ceki%)</span></div>
                        <input type="hidden" name="kriteriyaIds" value="@k.Id" />
                        <div class="prf-krit-inputs">
                            <select name="mudirQiymetleri" class="fn-input fn-input--sm" required>
                                <option value="">Qiymət...</option>
                                <option value="1">1 - Çox zəif</option>
                                <option value="2">2 - Zəif</option>
                                <option value="3">3 - Orta</option>
                                <option value="4">4 - Yaxşı</option>
                                <option value="5">5 - Əla</option>
                            </select>
                            <input type="text" name="mudirSherhler" class="fn-input fn-input--sm" placeholder="Şərh..." />
                        </div>
                    </div>
                }

                <div class="fn-form-row" style="margin-top:12px;">
                    <label class="fn-label">Müdir Şərhi</label>
                    <textarea name="mudirSherhi" class="fn-input" rows="3" placeholder="Ümumi qiymətləndirmə..."></textarea>
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">İnkişaf Planı</label>
                    <textarea name="inkisafPlani" class="fn-input" rows="3" placeholder="İnkişaf təklifləri...">@Model.InkisafPlani</textarea>
                </div>

                <div style="display:flex;justify-content:flex-end;margin-top:12px;">
                    <button type="submit" class="fn-btn fn-btn--primary">
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Müdir Qiymətləndirməsi
                    </button>
                </div>
            </form>
        </div>
    }

</div>
