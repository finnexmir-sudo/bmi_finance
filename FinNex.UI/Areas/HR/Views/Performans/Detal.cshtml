@model FinNex.Domain.Entities.HR.PerformansQiymetlendirme
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = $"Performans — {Model.Isci.Ad} {Model.Isci.Soyad}";
    var teyinat = Model.Isci.IsciTeyinatlari.FirstOrDefault();

    string StatusClass(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "prf-badge--wait",
        PerformansStatus.IsciQiymetlendirdi => "prf-badge--progress",
        PerformansStatus.SobeReisiQiymetlendirdi => "prf-badge--review",
        PerformansStatus.RehberQiymetlendirdi => "prf-badge--review",
        PerformansStatus.Tamamlandi => "prf-badge--done",
        _ => "prf-badge--wait"
    };
    string StatusText(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "Gözləmədə",
        PerformansStatus.IsciQiymetlendirdi => "İşçi qiymətləndirdi",
        PerformansStatus.SobeReisiQiymetlendirdi => "Şöbə rəisi qiymətləndirdi",
        PerformansStatus.RehberQiymetlendirdi => "Rəhbər qiymətləndirdi",
        PerformansStatus.Tamamlandi => "Tamamlandı",
        _ => "—"
    };
    string QiymetClass(decimal q) => q >= 4 ? "prf-q--high" : q >= 3 ? "prf-q--mid" : q > 0 ? "prf-q--low" : "";

    bool hasSobeReisi = Model.SobeReisiId.HasValue;
    bool rehberFormuGoster = hasSobeReisi
        ? Model.Status == PerformansStatus.SobeReisiQiymetlendirdi
        : Model.Status == PerformansStatus.IsciQiymetlendirdi;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.Isci.Ad @Model.Isci.Soyad</div>
            <div class="fn-page-sub">
                @(teyinat?.Departament?.Ad ?? "—") ·
                @(teyinat?.Vezife?.Ad ?? "—") ·
                @(Model.DovrTipi == PerformansDovrTipi.Rublik ? $"Rüb {Model.Rubu}" : "İllik") @Model.Il ·
                <span class="prf-badge @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">← Siyahı</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#16a34a;font-size:13px;">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#dc2626;font-size:13px;">
            <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
        </div>
    }

    @* ── Axın göstəricisi ── *@
    <div style="display:flex;align-items:center;gap:0;margin-bottom:20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 20px;overflow-x:auto;">
        @{
            var steps = new[] {
                ("İşçi", (int)PerformansStatus.IsciQiymetlendirdi),
                hasSobeReisi ? ("Şöbə Rəisi", (int)PerformansStatus.SobeReisiQiymetlendirdi) : (null, -1),
                ("Rəhbər", (int)PerformansStatus.Tamamlandi)
            };
            int curStep = (int)Model.Status;
        }
        @for (int si = 0; si < steps.Length; si++)
        {
            if (steps[si].Item1 == null) continue;
            bool done = curStep >= steps[si].Item2;
            bool active = (si == 0 && curStep == 0) ||
                          (si == 1 && hasSobeReisi && curStep == 1) ||
                          (si == (hasSobeReisi ? 2 : 1) && curStep == (hasSobeReisi ? 2 : 1));
            <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;
                    background:@(done?"#6366f1":active?"#e0e7ff":"#e2e8f0");
                    color:@(done?"#fff":active?"#6366f1":"#94a3b8");">
                    @(done ? "✓" : (si + 1).ToString())
                </div>
                <span style="font-size:13px;font-weight:@(done||active?"600":"400");color:@(done?"#6366f1":active?"#6366f1":"#94a3b8");">
                    @steps[si].Item1
                </span>
            </div>
            if (si < steps.Length - 1 && steps[si + 1].Item1 != null)
            {
                <div style="flex:1;min-width:20px;height:2px;background:@(curStep>steps[si].Item2?"#6366f1":"#e2e8f0");margin:0 8px;"></div>
            }
        }
    </div>

    @* ── Qiymət Kartları ── *@
    <div class="prf-score-cards">
        <div class="prf-score-card prf-score-card--isci">
            <div class="prf-score-label">İşçi Ortalaması</div>
            <div class="prf-score-value @QiymetClass(Model.IsciOrtalamaQiymet)">
                @(Model.IsciOrtalamaQiymet > 0 ? Model.IsciOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.IsciQiymetlendirmeTarixi.HasValue)
            { <div class="prf-score-date">@Model.IsciQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
        </div>
        @if (hasSobeReisi)
        {
            <div class="prf-score-card" style="border-top:3px solid #f59e0b;">
                <div class="prf-score-label">Şöbə Rəisi Ortalaması</div>
                <div class="prf-score-value @QiymetClass(Model.SobeReisiOrtalamaQiymet)">
                    @(Model.SobeReisiOrtalamaQiymet > 0 ? Model.SobeReisiOrtalamaQiymet.ToString("N2") : "—")
                </div>
                @if (Model.SobeReisiQiymetlendirmeTarixi.HasValue)
                { <div class="prf-score-date">@Model.SobeReisiQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
            </div>
        }
        <div class="prf-score-card prf-score-card--mudir">
            <div class="prf-score-label">Rəhbər Ortalaması</div>
            <div class="prf-score-value @QiymetClass(Model.MudirOrtalamaQiymet)">
                @(Model.MudirOrtalamaQiymet > 0 ? Model.MudirOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.MudirQiymetlendirmeTarixi.HasValue)
            { <div class="prf-score-date">@Model.MudirQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
        </div>
        <div class="prf-score-card prf-score-card--yekun">
            <div class="prf-score-label">Yekun Qiymət</div>
            <div class="prf-score-value @QiymetClass(Model.YekunQiymet)">
                @(Model.YekunQiymet > 0 ? Model.YekunQiymet.ToString("N2") : "—")
            </div>
            <div class="prf-score-date">5 üzrə qiymət</div>
        </div>
    </div>

    @* ── Kriteriya Cədvəli ── *@
    <div class="fn-card" style="padding:0;overflow:hidden;margin-top:16px;">
        <div class="prf-section-head">Kriteriyalar</div>
        <div class="prf-table-wrap" style="overflow-x:auto;">
            <table class="prf-table prf-table--detail" style="min-width:@(hasSobeReisi ? "900px" : "700px");">
                <thead>
                    <tr>
                        <th class="left">Kriteriya</th>
                        <th>Çəki</th>
                        <th>İşçi</th>
                        <th>İşçi Şərhi</th>
                        @if (hasSobeReisi) { <th>Şöbə Rəisi</th><th>Ş.R. Şərhi</th> }
                        <th>Rəhbər</th>
                        <th>Rəhbər Şərhi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                    {
                        <tr>
                            <td class="left"><strong>@k.KriteriyaAdi</strong></td>
                            <td>@k.Ceki%</td>
                            <td>@(k.IsciQiymeti.HasValue ? $"{k.IsciQiymeti.Value:N1}" : "—")</td>
                            <td class="prf-sherh-cell">@(k.IsciSherhi ?? "—")</td>
                            @if (hasSobeReisi)
                            {
                                <td>@(k.SobeReisiQiymeti.HasValue ? $"{k.SobeReisiQiymeti.Value:N1}" : "—")</td>
                                <td class="prf-sherh-cell">@(k.SobeReisiSherhi ?? "—")</td>
                            }
                            <td>@(k.MudirQiymeti.HasValue ? $"{k.MudirQiymeti.Value:N1}" : "—")</td>
                            <td class="prf-sherh-cell">@(k.MudirSherhi ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Şərhlər ── *@
    <div style="display:grid;grid-template-columns:@(hasSobeReisi ? "1fr 1fr 1fr" : "1fr 1fr");gap:12px;margin-top:12px;">
        <div class="fn-card">
            <div class="fn-card-title">İşçi Şərhi</div>
            <div class="prf-sherh-text">@(Model.IsciSherhi ?? "Hələ yazılmayıb")</div>
        </div>
        @if (hasSobeReisi)
        {
            <div class="fn-card">
                <div class="fn-card-title">Şöbə Rəisi Şərhi</div>
                <div class="prf-sherh-text">@(Model.SobeReisiSherhi ?? "Hələ yazılmayıb")</div>
            </div>
        }
        <div class="fn-card">
            <div class="fn-card-title">Rəhbər Şərhi</div>
            <div class="prf-sherh-text">@(Model.MudirSherhi ?? "Hələ yazılmayıb")</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.InkisafPlani))
    {
        <div class="fn-card" style="margin-top:12px;">
            <div class="fn-card-title">İnkişaf Planı</div>
            <div class="prf-sherh-text">@Model.InkisafPlani</div>
        </div>
    }

    @* ── İşçi Qiymətləndirmə Formu ── *@
    @if (Model.Status == PerformansStatus.Gozlemede)
    {
        <div class="fn-card prf-form-card" style="margin-top:20px;">
            <div class="fn-card-title">İşçi Qiymətləndirməsi</div>
            <form asp-action="IsciQiymetlendir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="performansId" value="@Model.Id" />
                @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                {
                    <div class="prf-krit-form-row">
                        <div class="prf-krit-name">@k.KriteriyaAdi <span class="prf-krit-ceki">(@k.Ceki%)</span></div>
                        <input type="hidden" name="kriteriyaIds" value="@k.Id" />
                        <div class="prf-krit-inputs">
                            <select name="isciQiymetleri" class="fn-input fn-input--sm" required>
                                <option value="">Qiymət...</option>
                                <option value="1">1 - Çox zəif</option>
                                <option value="2">2 - Zəif</option>
                                <option value="3">3 - Orta</option>
                                <option value="4">4 - Yaxşı</option>
                                <option value="5">5 - Əla</option>
                            </select>
                            <input type="text" name="isciSherhler" class="fn-input fn-input--sm" placeholder="Şərh..." />
                        </div>
                    </div>
                }
                <div class="fn-form-row" style="margin-top:12px;">
                    <label class="fn-label">Ümumi Şərh</label>
                    <textarea name="isciSherhi" class="fn-input" rows="3" placeholder="Ümumi qeyd..."></textarea>
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">İnkişaf Planı</label>
                    <textarea name="inkisafPlani" class="fn-input" rows="3" placeholder="İnkişaf təklifləri..."></textarea>
                </div>
                <div style="display:flex;justify-content:flex-end;margin-top:12px;">
                    <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-check-lg me-1"></i>Qiymətləndir</button>
                </div>
            </form>
        </div>
    }

    @* ── Şöbə Rəisi Qiymətləndirmə Formu ── *@
    @if (hasSobeReisi && Model.Status == PerformansStatus.IsciQiymetlendirdi)
    {
        <div class="fn-card prf-form-card" style="margin-top:16px;border-left:4px solid #f59e0b;">
            <div class="fn-card-title">Şöbə Rəisi Qiymətləndirməsi</div>
            <form asp-action="SobeReisiQiymetlendir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="performansId" value="@Model.Id" />
                @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                {
                    <div class="prf-krit-form-row">
                        <div class="prf-krit-name">
                            @k.KriteriyaAdi <span class="prf-krit-ceki">(@k.Ceki%)</span>
                            @if (k.IsciQiymeti.HasValue)
                            { <span style="font-size:11px;color:#64748b;margin-left:8px;">İşçi: @k.IsciQiymeti.Value.ToString("N1")</span> }
                        </div>
                        <input type="hidden" name="kriteriyaIds" value="@k.Id" />
                        <div class="prf-krit-inputs">
                            <select name="sobeReisiQiymetleri" class="fn-input fn-input--sm" required>
                                <option value="">Qiymət...</option>
                                <option value="1">1 - Çox zəif</option>
                                <option value="2">2 - Zəif</option>
                                <option value="3">3 - Orta</option>
                                <option value="4">4 - Yaxşı</option>
                                <option value="5">5 - Əla</option>
                            </select>
                            <input type="text" name="sobeReisiSherhler" class="fn-input fn-input--sm" placeholder="Şərh..." />
                        </div>
                    </div>
                }
                <div class="fn-form-row" style="margin-top:12px;">
                    <label class="fn-label">Ümumi Şərh</label>
                    <textarea name="sobeReisiSherhi" class="fn-input" rows="3" placeholder="Şöbə rəisi qeydi..."></textarea>
                </div>
                <div style="display:flex;justify-content:flex-end;margin-top:12px;">
                    <button type="submit" class="fn-btn fn-btn--primary" style="background:#f59e0b;border-color:#f59e0b;"><i class="bi bi-check-lg me-1"></i>Şöbə Rəisi Qiymətləndirsin</button>
                </div>
            </form>
        </div>
    }

    @* ── Rəhbər Qiymətləndirmə Formu ── *@
    @if (rehberFormuGoster)
    {
        <div class="fn-card prf-form-card" style="margin-top:16px;border-left:4px solid #6366f1;">
            <div class="fn-card-title">Rəhbər Qiymətləndirməsi</div>
            <form asp-action="RehberQiymetlendir" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="performansId" value="@Model.Id" />
                @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                {
                    <div class="prf-krit-form-row">
                        <div class="prf-krit-name">
                            @k.KriteriyaAdi <span class="prf-krit-ceki">(@k.Ceki%)</span>
                            @if (k.IsciQiymeti.HasValue)
                            { <span style="font-size:11px;color:#64748b;margin-left:8px;">İşçi: @k.IsciQiymeti.Value.ToString("N1")</span> }
                            @if (k.SobeReisiQiymeti.HasValue)
                            { <span style="font-size:11px;color:#92400e;margin-left:4px;">| Ş.R.: @k.SobeReisiQiymeti.Value.ToString("N1")</span> }
                        </div>
                        <input type="hidden" name="kriteriyaIds" value="@k.Id" />
                        <div class="prf-krit-inputs">
                            <select name="mudirQiymetleri" class="fn-input fn-input--sm" required>
                                <option value="">Qiymət...</option>
                                <option value="1">1 - Çox zəif</option>
                                <option value="2">2 - Zəif</option>
                                <option value="3">3 - Orta</option>
                                <option value="4">4 - Yaxşı</option>
                                <option value="5">5 - Əla</option>
                            </select>
                            <input type="text" name="mudirSherhler" class="fn-input fn-input--sm" placeholder="Şərh..." />
                        </div>
                    </div>
                }
                <div class="fn-form-row" style="margin-top:12px;">
                    <label class="fn-label">Rəhbər Şərhi</label>
                    <textarea name="mudirSherhi" class="fn-input" rows="3" placeholder="Rəhbər qeydi..."></textarea>
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">İnkişaf Planı</label>
                    <textarea name="inkisafPlani" class="fn-input" rows="3" placeholder="İnkişaf təklifləri...">@Model.InkisafPlani</textarea>
                </div>
                <div style="display:flex;justify-content:flex-end;margin-top:12px;">
                    <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-check-lg me-1"></i>Rəhbər Qiymətləndirsin</button>
                </div>
            </form>
        </div>
    }

</div>
