@model FinNex.Domain.Entities.HR.PerformansQiymetlendirme
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = $"Performans — {Model.Isci.Ad} {Model.Isci.Soyad}";
    var teyinat = Model.Isci.IsciTeyinatlari.FirstOrDefault();
    bool hasSobeReisi = Model.SobeReisiId.HasValue;
    bool hasRehber2 = Model.Rehber2Id.HasValue;

    string StatusClass(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "prf-badge--wait",
        PerformansStatus.SobeReisiGozleyir => "prf-badge--progress",
        PerformansStatus.RehberGozleyir => "prf-badge--review",
        PerformansStatus.Rehber2Gozleyir => "prf-badge--review",
        PerformansStatus.Tamamlandi => "prf-badge--done",
        _ => "prf-badge--wait"
    };
    string StatusText(PerformansStatus s) => s switch {
        PerformansStatus.Gozlemede => "Gözləmədə",
        PerformansStatus.SobeReisiGozleyir => "Şöbə rəisi gözlənilir",
        PerformansStatus.RehberGozleyir => "Rəhbər gözlənilir",
        PerformansStatus.Rehber2Gozleyir => "Rəhbər 2 gözlənilir",
        PerformansStatus.Tamamlandi => "Tamamlandı",
        _ => "—"
    };
    string QiymetClass(decimal q) => q >= 4 ? "prf-q--high" : q >= 3 ? "prf-q--mid" : q > 0 ? "prf-q--low" : "";

}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/performans.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">
                @Model.Isci.Ad @Model.Isci.Soyad
                @if (Model.MenecerKriteriyalari)
                { <span style="background:#ede9fe;color:#6d28d9;font-size:11px;padding:2px 8px;border-radius:12px;margin-left:8px;font-weight:500;">Menecer</span> }
            </div>
            <div class="fn-page-sub">
                @(teyinat?.Departament?.Ad ?? "—") · @(teyinat?.Vezife?.Ad ?? "—") ·
                @(Model.DovrTipi == PerformansDovrTipi.Rublik ? $"Rüb {Model.Rubu}" : "İllik") @Model.Il ·
                <span class="prf-badge @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">← Siyahı</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#16a34a;font-size:13px;">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:12px 16px;margin-bottom:16px;color:#dc2626;font-size:13px;">
            <i class="bi bi-exclamation-circle me-1"></i>@TempData["Error"]
        </div>
    }

    @* ── Workflow Axını ── *@
    <div style="display:flex;align-items:center;gap:0;margin-bottom:20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:12px 20px;overflow-x:auto;">
        @{
            var steps = new List<(string Label, int DoneAt)>();
            steps.Add(("İşçi", 1));
            if (hasSobeReisi) steps.Add(("Şöbə Rəisi", 2));
            steps.Add(("Rəhbər 1", hasRehber2 ? 3 : 4));
            if (hasRehber2) steps.Add(("Rəhbər 2", 4));
            int curStatus = (int)Model.Status;
        }
        @for (int si = 0; si < steps.Count; si++)
        {
            bool done = curStatus >= steps[si].DoneAt;
            bool active = curStatus == steps[si].DoneAt - 1;
            <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                <div style="width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;
                    background:@(done?"#6366f1":active?"#e0e7ff":"#e2e8f0");
                    color:@(done?"#fff":active?"#6366f1":"#94a3b8");">
                    @(done ? "✓" : (si + 1).ToString())
                </div>
                <span style="font-size:13px;font-weight:@(done||active?"600":"400");color:@(done?"#6366f1":active?"#6366f1":"#94a3b8");">@steps[si].Label</span>
            </div>
            @if (si < steps.Count - 1)
            {
                <div style="flex:1;min-width:20px;height:2px;background:@(curStatus>steps[si].DoneAt-1?"#6366f1":"#e2e8f0");margin:0 8px;"></div>
            }
        }
    </div>

    @* ── Qiymət Kartları ── *@
    <div class="prf-score-cards">
        <div class="prf-score-card prf-score-card--isci">
            <div class="prf-score-label">İşçi Ortalaması</div>
            <div class="prf-score-value @QiymetClass(Model.IsciOrtalamaQiymet)">
                @(Model.IsciOrtalamaQiymet > 0 ? Model.IsciOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.IsciQiymetlendirmeTarixi.HasValue)
            { <div class="prf-score-date">@Model.IsciQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
        </div>
        @if (hasSobeReisi)
        {
            <div class="prf-score-card" style="border-top:3px solid #f59e0b;">
                <div class="prf-score-label">Şöbə Rəisi</div>
                <div class="prf-score-value @QiymetClass(Model.SobeReisiOrtalamaQiymet)">
                    @(Model.SobeReisiOrtalamaQiymet > 0 ? Model.SobeReisiOrtalamaQiymet.ToString("N2") : "—")
                </div>
                @if (Model.SobeReisiQiymetlendirmeTarixi.HasValue)
                { <div class="prf-score-date">@Model.SobeReisiQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
            </div>
        }
        <div class="prf-score-card prf-score-card--mudir">
            <div class="prf-score-label">Rəhbər 1</div>
            <div class="prf-score-value @QiymetClass(Model.MudirOrtalamaQiymet)">
                @(Model.MudirOrtalamaQiymet > 0 ? Model.MudirOrtalamaQiymet.ToString("N2") : "—")
            </div>
            @if (Model.MudirQiymetlendirmeTarixi.HasValue)
            { <div class="prf-score-date">@Model.MudirQiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
        </div>
        @if (hasRehber2)
        {
            <div class="prf-score-card" style="border-top:3px solid #8b5cf6;">
                <div class="prf-score-label">Rəhbər 2</div>
                <div class="prf-score-value @QiymetClass(Model.Rehber2OrtalamaQiymet)">
                    @(Model.Rehber2OrtalamaQiymet > 0 ? Model.Rehber2OrtalamaQiymet.ToString("N2") : "—")
                </div>
                @if (Model.Rehber2QiymetlendirmeTarixi.HasValue)
                { <div class="prf-score-date">@Model.Rehber2QiymetlendirmeTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div> }
            </div>
        }
        <div class="prf-score-card prf-score-card--yekun">
            <div class="prf-score-label">Yekun Qiymət</div>
            <div class="prf-score-value @QiymetClass(Model.YekunQiymet)">
                @(Model.YekunQiymet > 0 ? Model.YekunQiymet.ToString("N2") : "—")
            </div>
            <div class="prf-score-date">5 üzrə qiymət</div>
        </div>
    </div>

    @* ── Kriteriya Cədvəli ── *@
    <div class="fn-card" style="padding:0;overflow:hidden;margin-top:16px;">
        <div class="prf-section-head">Kriteriyalar</div>
        <div class="prf-table-wrap" style="overflow-x:auto;">
            <table class="prf-table prf-table--detail">
                <thead>
                    <tr>
                        <th class="left">Kriteriya</th>
                        <th>Çəki</th>
                        <th>İşçi</th>
                        <th>İşçi Şərhi</th>
                        @if (hasSobeReisi) { <th>Şöbə R.</th><th>Ş.R. Şərhi</th> }
                        <th>Rəhbər 1</th>
                        <th>R.1 Şərhi</th>
                        @if (hasRehber2) { <th>Rəhbər 2</th><th>R.2 Şərhi</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.Kriteriyalar.OrderByDescending(x => x.Ceki))
                    {
                        <tr>
                            <td class="left"><strong>@k.KriteriyaAdi</strong></td>
                            <td>@k.Ceki%</td>
                            <td>@(k.IsciQiymeti.HasValue ? k.IsciQiymeti.Value.ToString("N1") : "—")</td>
                            <td class="prf-sherh-cell">@(k.IsciSherhi ?? "—")</td>
                            @if (hasSobeReisi)
                            {
                                <td>@(k.SobeReisiQiymeti.HasValue ? k.SobeReisiQiymeti.Value.ToString("N1") : "—")</td>
                                <td class="prf-sherh-cell">@(k.SobeReisiSherhi ?? "—")</td>
                            }
                            <td>@(k.MudirQiymeti.HasValue ? k.MudirQiymeti.Value.ToString("N1") : "—")</td>
                            <td class="prf-sherh-cell">@(k.MudirSherhi ?? "—")</td>
                            @if (hasRehber2)
                            {
                                <td>@(k.Rehber2Qiymeti.HasValue ? k.Rehber2Qiymeti.Value.ToString("N1") : "—")</td>
                                <td class="prf-sherh-cell">@(k.Rehber2Sherhi ?? "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Şərhlər ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-top:12px;">
        <div class="fn-card"><div class="fn-card-title">İşçi Şərhi</div><div class="prf-sherh-text">@(Model.IsciSherhi ?? "Hələ yazılmayıb")</div></div>
        @if (hasSobeReisi)
        { <div class="fn-card"><div class="fn-card-title">Şöbə Rəisi Şərhi</div><div class="prf-sherh-text">@(Model.SobeReisiSherhi ?? "Hələ yazılmayıb")</div></div> }
        <div class="fn-card"><div class="fn-card-title">Rəhbər 1 Şərhi</div><div class="prf-sherh-text">@(Model.MudirSherhi ?? "Hələ yazılmayıb")</div></div>
        @if (hasRehber2)
        { <div class="fn-card"><div class="fn-card-title">Rəhbər 2 Şərhi</div><div class="prf-sherh-text">@(Model.Rehber2Sherhi ?? "Hələ yazılmayıb")</div></div> }
    </div>
    @if (!string.IsNullOrEmpty(Model.InkisafPlani))
    {
        <div class="fn-card" style="margin-top:12px;">
            <div class="fn-card-title">İnkişaf Planı</div>
            <div class="prf-sherh-text">@Model.InkisafPlani</div>
        </div>
    }


    @* ── Cari Mərhələ (read-only info) ── *@
    @if (Model.Status != PerformansStatus.Tamamlandi)
    {
        <div style="background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:12px 16px;margin-top:16px;font-size:13px;color:#92400e;display:flex;align-items:center;gap:8px;">
            <i class="bi bi-hourglass-split"></i>
            <span>
                Hazırda <strong>@StatusText(Model.Status)</strong> mərhələsindədir. Qiymətləndirməni həmin rolun sahibi öz şəxsi kabinetindən həyata keçirir.
            </span>
        </div>
    }

</div>
