@model List<FinNex.Domain.Entities.HR.XercKateqoriyasi>
@{
    ViewData["Title"] = "Xərc Kateqoriyaları";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/xerc-kateqoriya.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Xərc Kateqoriyaları</div>
            <div class="fn-page-sub">Xərc növlərini idarə edin</div>
        </div>
        <button class="fn-btn fn-btn--primary" id="btnYeniKat">
            <i class="bi bi-plus-lg"></i> Yeni kateqoriya
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="xk-alert xk-alert--success">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="xk-alert xk-alert--error">
            <i class="bi bi-exclamation-circle-fill"></i> @TempData["Error"]
        </div>
    }

    <div class="fn-card">
        @if (!Model.Any())
        {
            <div class="xk-empty">
                <i class="bi bi-tags"></i>
                <p>Hələ kateqoriya əlavə olunmayıb</p>
            </div>
        }
        else
        {
            <table class="xk-table">
                <thead>
                    <tr>
                        <th>İkon</th>
                        <th>Ad</th>
                        <th>Status</th>
                        <th>Xərc sayı</th>
                        <th class="xk-act">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model)
                    {
                        <tr class="@(!k.Aktivdir ? "xk-row--deaktiv" : "")">
                            <td><i class="bi @(k.Ikon ?? "bi-tag")" style="font-size:18px;color:#667eea"></i></td>
                            <td class="xk-ad">@k.Ad</td>
                            <td>
                                @if (k.Aktivdir)
                                {
                                    <span class="xk-badge xk-badge--aktiv">Aktiv</span>
                                }
                                else
                                {
                                    <span class="xk-badge xk-badge--deaktiv">Deaktiv</span>
                                }
                            </td>
                            <td class="xk-say">@k.Xercler.Count(x => !x.Silinib)</td>
                            <td>
                                <div class="xk-btns">
                                    <button class="fn-btn fn-btn--outline xk-edit-btn"
                                            data-id="@k.Id"
                                            data-ad="@k.Ad"
                                            data-ikon="@(k.Ikon ?? "bi-tag")"
                                            data-aktiv="@k.Aktivdir.ToString().ToLower()">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (k.Xercler.Count(x => !x.Silinib) == 0)
                                    {
                                        <form asp-action="Sil" asp-route-id="@k.Id" method="post"
                                              style="display:inline"
                                              onsubmit="return confirm('@k.Ad kateqoriyasını silmək istəyirsiniz?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="fn-btn fn-btn--danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@* ── Yeni / Redaktə Modal ── *@
<div class="xk-modal-overlay" id="katModal" style="display:none">
    <div class="xk-modal">
        <div class="xk-modal-head">
            <span id="katModalTitle">Yeni kateqoriya</span>
            <button type="button" class="xk-modal-close" id="katModalClose">&times;</button>
        </div>
        <form id="katForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="katId" name="id" value="0" />

            <div class="fn-form-group" style="padding:20px 24px 0">
                <label class="fn-label">Ad <span class="fn-required">*</span></label>
                <input type="text" name="ad" id="katAd" class="fn-input" required
                       placeholder="Kateqoriya adı..." maxlength="100" />
            </div>

            <div class="fn-form-group" style="padding:12px 24px 0">
                <label class="fn-label">İkon <span class="fn-label-hint">(isteğe bağlı)</span></label>
                <input type="hidden" name="ikon" id="katIkon" value="" />
                <div class="xk-ikon-grid" id="ikonGrid">
                    <button type="button" class="xk-ikon-item xk-ikon-item--none" data-ikon="" title="İkonsuz">
                        <span style="font-size:11px;color:#94a3b8">—</span>
                    </button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-tag-fill"            title="Ümumi"><i class="bi bi-tag-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-cash-stack"          title="Nağd pul"><i class="bi bi-cash-stack"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-car-front-fill"      title="Nəqliyyat"><i class="bi bi-car-front-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-house-fill"          title="İcarə / Ofis"><i class="bi bi-house-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-lightbulb-fill"      title="Kommunal"><i class="bi bi-lightbulb-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-laptop-fill"         title="Texnika"><i class="bi bi-laptop-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-telephone-fill"      title="Rabitə"><i class="bi bi-telephone-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-people-fill"         title="İşçilər"><i class="bi bi-people-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-bag-fill"            title="Alış-veriş"><i class="bi bi-bag-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-tools"               title="Təmir / Texniki"><i class="bi bi-tools"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-heart-pulse-fill"    title="Tibbi"><i class="bi bi-heart-pulse-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-mortarboard-fill"    title="Təlim / Təhsil"><i class="bi bi-mortarboard-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-airplane-fill"       title="Ezamiyyət"><i class="bi bi-airplane-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-graph-up-arrow"      title="Marketinq"><i class="bi bi-graph-up-arrow"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-shield-fill-check"   title="Sığorta"><i class="bi bi-shield-fill-check"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-printer-fill"        title="Çap / Kanselyariya"><i class="bi bi-printer-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-box-seam-fill"       title="Anbar / Material"><i class="bi bi-box-seam-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-cup-hot-fill"        title="Yemək / İçki"><i class="bi bi-cup-hot-fill"></i></button>
                    <button type="button" class="xk-ikon-item" data-ikon="bi-three-dots"          title="Digər"><i class="bi bi-three-dots"></i></button>
                </div>
            </div>

            <div class="fn-form-group xk-aktiv-row" id="aktivRow" style="padding:12px 24px 0;display:none">
                <label class="xk-checkbox-label">
                    <input type="checkbox" name="aktivdir" id="katAktivdir" value="true" />
                    <span>Aktiv</span>
                </label>
            </div>

            <div class="xk-modal-foot">
                <button type="button" class="fn-btn fn-btn--outline" id="katModalCancel">Ləğv</button>
                <button type="submit" class="fn-btn fn-btn--primary" id="katModalSave">
                    <i class="bi bi-save"></i> Yadda saxla
                </button>
            </div>
        </form>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/hr/xerc-kateqoriya.js" asp-append-version="true"></script>
}
