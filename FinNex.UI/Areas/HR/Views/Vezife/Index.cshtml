@using FinNex.Application.DTOs.HR.Vezife
@model IEnumerable<VezifeListDto>
@{
    ViewData["Title"] = "Vəzifələr";
    Layout = "_HRLayout";
}

<div class="page-container">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">Vəzifələr</h1>
            <p class="page-subtitle">Bütün vəzifələrin idarəsi</p>
        </div>
        <a asp-action="Create" class="btn-add">
            <i class="bi bi-plus-lg"></i> Yeni Vəzifə
        </a>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Vəzifə Adı</th>
                    <th>Departament</th>
                    <th>İşçi Sayı</th>
                    <th>Status</th>
                    <th class="text-end">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="cell-main">@item.Ad</div>
                            </td>
                            <td>
                                <span class="badge-dept">@item.DepartamentAd</span>
                            </td>
                            <td>
                                <span class="badge-count">@item.IsciSayi</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge-active">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Deaktiv</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btns">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Bax">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Redaktə">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn-icon btn-delete" onclick="deleteVezife(@item.Id)" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center empty-state">
                            <i class="bi bi-inbox"></i>
                            <p>Heç bir vəzifə tapılmadı</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/vezife-list.css" />
}

@section Scripts {
    <script src="~/js/hr/vezife-list.js"></script>
}