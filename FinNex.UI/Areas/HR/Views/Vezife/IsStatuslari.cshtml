@using FinNex.Application.DTOs.HR.VezifeIsStatusu
@using FinNex.Domain.Entities.HR
@model IList<VezifeIsStatusuDto>
@{
    ViewData["Title"] = "Vəzifələr — İşdə statusları";
}

@* `isci-table`/`fn-badge` stilləri bu faylda yüklənməlidir — sibling
   view-lardan (Vezife/Index, AileVeziyyeti/Index) fərqli olaraq bura
   unudulmuşdu və səhifə birbaşa açılanda (Index-dən keçmədən) cədvəl
   TAMAMİLƏ stilsiz (brauzer default) görünürdü — "səliqəsiz" şikayətinin
   kök səbəbi elə budur, markup-un özü deyil. *@
@section Styles {
    <link rel="stylesheet" href="~/css/hr/isci.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İşdə statusları</div>
            <div class="fn-page-sub">
                Hər vəzifə adı üçün "İcraçı" / "Məsul şəxs" statusu — bir dəfə qurulur,
                Məzuniyyət tarixçə Excel-ində istifadə olunur.
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">Vəzifələrə qayıt</a>
    </div>

    <form asp-action="IsStatuslariSaxla" method="post" style="max-width:760px">
        @Html.AntiForgeryToken()
        <div class="fn-card" style="padding:0;overflow:hidden;">
            @* Sütun enləri sabitlənib — yoxsa 2-3 dar sütunlu cədvəl bütün səhifə
               enini tutub sağ tərəfi boş, qeyri-mütənasib görünürdü. *@
            <table class="isci-table">
                <colgroup>
                    <col />
                    <col style="width:200px" />
                    <col style="width:220px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Vəzifə Adı</th>
                        <th>İşdə statusu</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Count; i++)
                    {
                        var s = Model[i];
                        <tr>
                            <td>
                                @s.VezifeAdi
                                <input type="hidden" name="setirler[@i].VezifeAdi" value="@s.VezifeAdi" />
                            </td>
                            <td>
                                <select name="setirler[@i].Status" class="fn-select">
                                    <option value="@((int)VezifeIsStatusuTipi.Icrachi)" selected="@(s.Status == VezifeIsStatusuTipi.Icrachi)">İcraçı</option>
                                    <option value="@((int)VezifeIsStatusuTipi.MesulSexs)" selected="@(s.Status == VezifeIsStatusuTipi.MesulSexs)">Məsul şəxs</option>
                                </select>
                            </td>
                            <td>
                                @if (!s.Qurulub)
                                {
                                    @* `isci-badge`/`--warn` heç vaxt mövcud olmayıb (yalnız
                                       `isci-badge-yes`/`-no` var) — bu yazı stilsiz, çılpaq
                                       mətn kimi görünürdü. Eyni mənaya uyğun, artıq işlək
                                       `fn-badge fn-badge--wait` (kəhrəba, "gözləmə/default"
                                       semantikası, `Vezife/Index.cshtml`-də sübut olunub). *@
                                    <span class="fn-badge fn-badge--wait">qurulmayıb — default</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="3" style="text-align:center;color:#94a3b8;padding:20px">Aktiv vəzifə tapılmadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Count > 0)
        {
            <div style="margin-top:14px">
                <button type="submit" class="fn-btn fn-btn--primary">Saxla</button>
            </div>
        }
    </form>
</div>
