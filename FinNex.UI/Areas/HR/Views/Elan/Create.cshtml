@{
    ViewData["Title"] = "Yeni Elan";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni elan yaradın</div>
            <div class="fn-page-sub">Bütün əməkdaşlara göstəriləcək elan</div>
        </div>
        <a asp-area="HR" asp-controller="Elan" asp-action="Index"
           class="fn-btn fn-btn--outline">&#8592; Geri</a>
    </div>

    <div class="fn-form-wrap">
        <form asp-area="HR" asp-controller="Elan" asp-action="Create" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">

                @* ── Başlıq ── *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Başlıq <span class="fn-required">*</span>
                    </label>
                    <input type="text" name="Bashliq" class="fn-input" required
                           placeholder="Elan başlığı..." />
                </div>

                @* ── Mətn ── *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Mətn <span class="fn-required">*</span>
                    </label>
                    <textarea name="Metn" class="fn-input" rows="5" required
                              placeholder="Elan mətni..."></textarea>
                </div>

                @* ── Şəkil (banner) ── *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Şəkil / Banner
                        <span class="fn-label-hint">(JPG, PNG, GIF — max 10MB)</span>
                    </label>
                    <input type="file" name="sekil" class="fn-input" accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <div class="elan-upload-preview" id="sekilPreview" style="display:none">
                        <img id="sekilImg" alt="preview" />
                    </div>
                </div>

                @* ── Sənəd əlavəsi ── *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Sənəd əlavəsi
                        <span class="fn-label-hint">(PDF, Word, Excel — max 10MB)</span>
                    </label>
                    <input type="file" name="fayl" class="fn-input" accept=".pdf,.doc,.docx,.xls,.xlsx" />
                </div>

                @* ── Vacibdir + Bitmə tarixi ── *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Vacib elan</label>
                        <div class="fn-checkbox-wrap">
                            <input type="checkbox" name="Vacibdir" value="true" id="chkVacib" />
                            <label for="chkVacib">Bu elan vacibdir</label>
                        </div>
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Bitmə tarixi
                            <span class="fn-label-hint">(boş = müddətsiz)</span>
                        </label>
                        <input type="date" name="BitirmeTarixi" class="fn-input" />
                    </div>
                </div>

                @* ── Düymələr ── *@
                <div class="fn-form-actions">
                    <a asp-area="HR" asp-controller="Elan" asp-action="Index"
                       class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">
                        Elan yarat
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/elan.css" asp-append-version="true" />
}

@section Scripts {
<script>
    // Şəkil preview
    document.querySelector('input[name="sekil"]').addEventListener('change', function () {
        var file = this.files[0];
        var preview = document.getElementById('sekilPreview');
        var img = document.getElementById('sekilImg');
        if (file && file.type.startsWith('image/')) {
            var reader = new FileReader();
            reader.onload = function (e) { img.src = e.target.result; preview.style.display = 'block'; };
            reader.readAsDataURL(file);
        } else {
            preview.style.display = 'none';
        }
    });
</script>
}
