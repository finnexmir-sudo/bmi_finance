@model FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetUpdateDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Qeydi Redaktə Et";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page fn-mez-create">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Qeydi redaktə et</div>
            <div class="fn-page-sub">Qeyd #@Model?.Id</div>
        </div>
    </div>

    <div class="fn-create-layout">

        @* ── Forma ── *@
        <div class="fn-form-wrap fn-form-wrap--wide">
            <form asp-area="HR" asp-controller="XestelikEzamiyyet" asp-action="Edit"
                  method="post" id="mezForm">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="ImtinaSebebi" />
                <input type="hidden" asp-for="EvezEdenIsciId" />

                <div class="fn-card fn-card--form">

                    @* ── Növ seçimi ── *@
                    <div class="fn-form-group">
                        <label class="fn-label">Qeyd növü <span class="fn-required">*</span></label>
                        <div class="fn-nov-grid" style="grid-template-columns: repeat(2, 1fr);">
                            <label class="fn-nov-card @(Model?.Nov == MezuniyyetNovu.Xestelik ? "fn-nov-card--active" : "")">
                                <input type="radio" name="Nov" value="@((int)MezuniyyetNovu.Xestelik)"
                                       class="fn-nov-radio"
                                       @(Model?.Nov == MezuniyyetNovu.Xestelik ? "checked" : "") />
                                <i class="bi bi-hospital" style="font-size:20px;color:#a855f7;"></i>
                                Xəstəlik
                                <small>Xəstəlik vərəqəsi</small>
                            </label>
                            <label class="fn-nov-card @(Model?.Nov == MezuniyyetNovu.Ezamiyyet ? "fn-nov-card--active" : "")">
                                <input type="radio" name="Nov" value="@((int)MezuniyyetNovu.Ezamiyyet)"
                                       class="fn-nov-radio"
                                       @(Model?.Nov == MezuniyyetNovu.Ezamiyyet ? "checked" : "") />
                                <i class="bi bi-briefcase" style="font-size:20px;color:#f97316;"></i>
                                Ezamiyyət
                                <small>Xidməti ezamiyyət</small>
                            </label>
                        </div>
                        <span asp-validation-for="Nov" class="fn-val-msg"></span>
                    </div>

                    @* ── Tarixlər ── *@
                    <div class="fn-form-row">
                        <div class="fn-form-group">
                            <label asp-for="BaslamaTarixi" class="fn-label">
                                Başlama tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BaslamaTarixi" type="date"
                                   class="fn-input" id="baslamaTarixi" required />
                            <span asp-validation-for="BaslamaTarixi" class="fn-val-msg"></span>
                        </div>
                        <div class="fn-form-group">
                            <label asp-for="BitmeTarixi" class="fn-label">
                                Bitmə tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BitmeTarixi" type="date"
                                   class="fn-input" id="bitmeTarixi" required />
                            <span asp-validation-for="BitmeTarixi" class="fn-val-msg"></span>
                        </div>
                    </div>

                    @* ── Müddət göstəricisi ── *@
                    <div class="fn-duration-box" id="durationBox" style="display:none">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <rect x="1" y="1.5" width="12" height="11" rx="2" stroke="#1e9b6b" stroke-width="1.2" />
                            <path d="M1 5h12" stroke="#1e9b6b" stroke-width="1.2" />
                        </svg>
                        Hesablanmış iş günü: <strong id="durationText"></strong>
                    </div>

                    @* ── Qeyd ── *@
                    <div class="fn-form-group">
                        <label asp-for="Qeyd" class="fn-label">
                            Qeyd
                            <span class="fn-label-hint">(isteğe bağlı)</span>
                        </label>
                        <textarea asp-for="Qeyd" rows="3"
                                  class="fn-textarea"
                                  placeholder="Xəstəlik vərəqəsi nömrəsi, ezamiyyət məqsədi və s."></textarea>
                        <span asp-validation-for="Qeyd" class="fn-val-msg"></span>
                    </div>

                    @* ── Düymələr ── *@
                    <div class="fn-form-actions">
                        <button type="submit" class="fn-btn fn-btn--primary">
                            Yadda saxla
                        </button>
                    </div>

                </div>
            </form>
        </div>

        @* ── Sağ panel ── *@
        <div class="fn-side-info">
            <div class="fn-card">
                <div class="fn-card-title" style="margin-bottom:10px">Məlumat</div>
                <div class="fn-workflow-info">
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">
                            <i class="bi bi-check2" style="font-size:11px;"></i>
                        </div>
                        <div class="fn-wi-text">
                            <strong>Tarix dəyişəndə</strong>
                            <span>İş günləri yenidən hesablanır</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">
                            <i class="bi bi-check2" style="font-size:11px;"></i>
                        </div>
                        <div class="fn-wi-text">
                            <strong>Xəstəlik balansı</strong>
                            <span>14 gün illik limit</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">
                            <i class="bi bi-check2" style="font-size:11px;"></i>
                        </div>
                        <div class="fn-wi-text">
                            <strong>Ezamiyyət limitsiz</strong>
                            <span>Balans yoxlanılmır</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Növ seçimi
            var novCards = document.querySelectorAll('.fn-nov-card');
            novCards.forEach(function (card) {
                card.addEventListener('click', function () {
                    novCards.forEach(function (c) { c.classList.remove('fn-nov-card--active'); });
                    card.classList.add('fn-nov-card--active');
                });
            });

            // İş günü hesablama
            var baslamaEl = document.getElementById('baslamaTarixi');
            var bitmeEl = document.getElementById('bitmeTarixi');
            var durationBox = document.getElementById('durationBox');
            var durationText = document.getElementById('durationText');

            function hesablaIsGunu() {
                if (!baslamaEl.value || !bitmeEl.value) {
                    durationBox.style.display = 'none';
                    return;
                }
                var baslama = new Date(baslamaEl.value);
                var bitme = new Date(bitmeEl.value);
                if (bitme < baslama) {
                    durationBox.style.display = 'none';
                    return;
                }
                var count = 0;
                var cur = new Date(baslama);
                while (cur <= bitme) {
                    var day = cur.getDay();
                    if (day !== 0 && day !== 6) count++;
                    cur.setDate(cur.getDate() + 1);
                }
                durationText.textContent = count + ' iş günü';
                durationBox.style.display = 'flex';
            }

            baslamaEl.addEventListener('change', hesablaIsGunu);
            bitmeEl.addEventListener('change', hesablaIsGunu);
            hesablaIsGunu(); // Mövcud tarixləri hesabla
        });
    </script>
}
