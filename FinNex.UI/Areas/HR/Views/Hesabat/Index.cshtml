@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "HR Hesabatları";

    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/hr-hesabat.css" asp-append-version="true" />
}

<div class="rp-page">
    <!-- Header -->
    <div class="rp-header">
        <h2>HR Hesabatları</h2>
    </div>

    <!-- Tabs -->
    <div class="rp-tabs">
        <button class="rp-tab rp-tab--active" data-tab="maas">
            <i class="bi bi-cash-stack"></i> Maaş Hesabatı
        </button>
        <button class="rp-tab" data-tab="davamiyyet">
            <i class="bi bi-calendar-check"></i> Davamiyyət Hesabatı
        </button>
        <button class="rp-tab" data-tab="balans">
            <i class="bi bi-pie-chart"></i> Balans Hesabatı
        </button>
        <button class="rp-tab" data-tab="vergi">
            <i class="bi bi-receipt"></i> Vergi Hesabatı
        </button>
    </div>

    <!-- Maaş Hesabatı Panel -->
    <div class="rp-panel rp-panel--active" id="panel-maas">
        <div class="rp-filter-bar">
            <div class="rp-filter-group">
                <label class="rp-filter-label">İl</label>
                <select id="maasIl" class="rp-select">
                    @for (int y = currentYear + 1; y >= currentYear - 3; y--)
                    {
                        <option value="@y" selected="@(y == currentYear)">@y</option>
                    }
                </select>
            </div>
            <div class="rp-filter-group">
                <label class="rp-filter-label">Ay</label>
                <select id="maasAy" class="rp-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == currentMonth)">
                            @(new DateTime(2000, m, 1).ToString("MMMM"))
                        </option>
                    }
                </select>
            </div>
            <button class="rp-btn-show" id="btnMaasGoster">
                <i class="bi bi-search"></i> Göstər
            </button>
            <div class="rp-export-bar">
                <button class="rp-btn-export rp-btn-export--excel" id="btnMaasExcel" title="Excel-ə ixrac et">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button class="rp-btn-export rp-btn-export--pdf" id="btnMaasPdf" title="PDF kimi çap et">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
            </div>
        </div>

        <div class="rp-table-wrap" id="maasTableWrap">
            <div class="rp-empty-state">
                <i class="bi bi-bar-chart-line"></i>
                <p>Hesabat görmək üçün dövr seçin və "Göstər" düyməsinə basın</p>
            </div>
        </div>
    </div>

    <!-- Davamiyyət Hesabatı Panel -->
    <div class="rp-panel" id="panel-davamiyyet">
        <div class="rp-filter-bar">
            <div class="rp-filter-group">
                <label class="rp-filter-label">İl</label>
                <select id="davamiyyetIl" class="rp-select">
                    @for (int y = currentYear + 1; y >= currentYear - 3; y--)
                    {
                        <option value="@y" selected="@(y == currentYear)">@y</option>
                    }
                </select>
            </div>
            <div class="rp-filter-group">
                <label class="rp-filter-label">Ay</label>
                <select id="davamiyyetAy" class="rp-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == currentMonth)">
                            @(new DateTime(2000, m, 1).ToString("MMMM"))
                        </option>
                    }
                </select>
            </div>
            <button class="rp-btn-show" id="btnDavamiyyetGoster">
                <i class="bi bi-search"></i> Göstər
            </button>
            <div class="rp-export-bar">
                <button class="rp-btn-export rp-btn-export--excel" id="btnDavamiyyetExcel" title="Excel-ə ixrac et">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button class="rp-btn-export rp-btn-export--pdf" id="btnDavamiyyetPdf" title="PDF kimi çap et">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
            </div>
        </div>

        <div class="rp-table-wrap" id="davamiyyetTableWrap">
            <div class="rp-empty-state">
                <i class="bi bi-calendar3"></i>
                <p>Hesabat görmək üçün dövr seçin və "Göstər" düyməsinə basın</p>
            </div>
        </div>
    </div>

    <!-- Balans Hesabatı Panel -->
    <div class="rp-panel" id="panel-balans">
        <div class="rp-filter-bar">
            <div class="rp-filter-group">
                <label class="rp-filter-label">İl</label>
                <select id="balansIl" class="rp-select">
                    @for (int y = currentYear + 1; y >= currentYear - 3; y--)
                    {
                        <option value="@y" selected="@(y == currentYear)">@y</option>
                    }
                </select>
            </div>
            <button class="rp-btn-show" id="btnBalansGoster">
                <i class="bi bi-search"></i> Göstər
            </button>
            <div class="rp-export-bar">
                <button class="rp-btn-export rp-btn-export--excel" id="btnBalansExcel" title="Excel-ə ixrac et">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button class="rp-btn-export rp-btn-export--pdf" id="btnBalansPdf" title="PDF kimi çap et">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
            </div>
        </div>

        <div class="rp-table-wrap" id="balansTableWrap">
            <div class="rp-empty-state">
                <i class="bi bi-pie-chart"></i>
                <p>Hesabat görmək üçün il seçin və "Göstər" düyməsinə basın</p>
            </div>
        </div>
    </div>

    <!-- Vergi Hesabatı Panel -->
    <div class="rp-panel" id="panel-vergi">
        <div class="rp-filter-bar">
            <div class="rp-filter-group">
                <label class="rp-filter-label">İl</label>
                <select id="vergiIl" class="rp-select">
                    @for (int y = currentYear + 1; y >= currentYear - 3; y--)
                    {
                        <option value="@y" selected="@(y == currentYear)">@y</option>
                    }
                </select>
            </div>
            <button class="rp-btn-show" id="btnVergiGoster">
                <i class="bi bi-search"></i> Göstər
            </button>
            <div class="rp-export-bar">
                <button class="rp-btn-export rp-btn-export--excel" id="btnVergiExcel" title="Excel-ə ixrac et">
                    <i class="bi bi-file-earmark-excel"></i> Excel
                </button>
                <button class="rp-btn-export rp-btn-export--pdf" id="btnVergiPdf" title="PDF kimi çap et">
                    <i class="bi bi-file-earmark-pdf"></i> PDF
                </button>
            </div>
        </div>

        <div class="rp-table-wrap" id="vergiTableWrap">
            <div class="rp-empty-state">
                <i class="bi bi-receipt"></i>
                <p>Hesabat görmək üçün il seçin və "Göstər" düyməsinə basın</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/hr/hr-hesabat.js" asp-append-version="true"></script>
}
