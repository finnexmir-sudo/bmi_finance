@model FinNex.Application.DTOs.HR.Kompensasiya.KompensasiyaDetalDto
@using FinNex.Domain.Entities.HR
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Kompensasiya Detal";
    var ayAdlari = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
        "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };

    string StatusText(KompensasiyaStatus s) => s switch
    {
        KompensasiyaStatus.Layihe => "Layihə",
        KompensasiyaStatus.Tesdiqlenib => "Təsdiqlənib",
        KompensasiyaStatus.MaasaDaxilEdildi => "Maaşa daxil edilib",
        KompensasiyaStatus.LegvEdildi => "Ləğv edilib",
        _ => "-"
    };
    string StatusClass(KompensasiyaStatus s) => s switch
    {
        KompensasiyaStatus.MaasaDaxilEdildi => "fn-badge--done",
        KompensasiyaStatus.Tesdiqlenib => "fn-badge--review",
        KompensasiyaStatus.Layihe => "fn-badge--wait",
        KompensasiyaStatus.LegvEdildi => "fn-badge--rejected",
        _ => ""
    };
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <a asp-action="Index" style="font-size:13px;color:#64748b;text-decoration:none">‹ Siyahıya qayıt</a>
            <div class="fn-page-title" style="margin-top:4px;display:flex;align-items:center;gap:10px">
                @Model.IsciAdSoyad
                <span class="fn-badge @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
            </div>
            <div class="fn-page-sub">
                @(Model.DepartamentAd ?? "—") · @(Model.VezifeAd ?? "—") ·
                Hesablanan ay: @ayAdlari[Model.HesablananAy] @Model.HesablananIl
            </div>
        </div>
        <div>
            @if (Model.Status != KompensasiyaStatus.MaasaDaxilEdildi && Model.Status != KompensasiyaStatus.LegvEdildi)
            {
                <form asp-action="LegvEt" method="post" style="display:inline"
                      onsubmit="return confirm('Ləğv etmək istəyirsiniz?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="fn-btn fn-btn--danger-sm">Ləğv et</button>
                </form>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fn-alert fn-alert--success">@TempData["Success"]</div>
    }

    <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:16px;align-items:flex-start">

        <div>
            @* ── YEKUN MƏBLƏĞ ─────────────── *@
            <div class="fn-card" style="padding:20px;margin-bottom:14px;background:linear-gradient(to bottom right,#ecfdf5,#fff);border:2px solid #16a34a">
                <div style="font-size:12px;color:#15803d;font-weight:600;text-transform:uppercase;margin-bottom:4px">Yekun Kompensasiya Məbləği</div>
                <div style="font-size:32px;font-weight:800;color:#15803d">@Model.CemiMebleg.ToString("N2") ₼</div>
                <div style="font-size:13px;color:#475569;margin-top:6px">
                    @Model.CemiKompensasiyaGun.ToString("N2") gün × @Model.GunlukRate.ToString("N4") ₼/gün
                </div>
            </div>

            @* ── Gün Hesablanması ─────────── *@
            <div class="fn-card" style="padding:18px;margin-bottom:14px">
                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:12px">Gün Hesablanması</div>

                @if (Model.KecmisIller.Any())
                {
                    <div style="font-size:11px;color:#64748b;text-transform:uppercase;margin-bottom:6px">Keçmiş illər qalığı</div>
                    <table style="width:100%;font-size:13px;border-collapse:collapse">
                        <thead>
                            <tr style="border-bottom:1px solid #e2e8f0;color:#64748b;font-size:11px">
                                <th style="text-align:left;padding:4px 8px">İl</th>
                                <th style="text-align:right;padding:4px 8px">Toplam</th>
                                <th style="text-align:right;padding:4px 8px">İstifadə</th>
                                <th style="text-align:right;padding:4px 8px">Qalıq</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var il in Model.KecmisIller)
                            {
                                <tr style="border-bottom:1px solid #f1f5f9">
                                    <td style="padding:5px 8px">@il.Il</td>
                                    <td style="text-align:right;padding:5px 8px;font-family:monospace">@il.ToplamGun.ToString("N0")</td>
                                    <td style="text-align:right;padding:5px 8px;font-family:monospace">@il.IstifadeOlunanGun.ToString("N0")</td>
                                    <td style="text-align:right;padding:5px 8px;font-family:monospace;color:@(il.QaligGun > 0 ? "#16a34a" : "#94a3b8");font-weight:600">@il.QaligGun.ToString("N2")</td>
                                </tr>
                            }
                            <tr style="border-top:2px solid #0f172a;font-weight:700">
                                <td style="padding:6px 8px" colspan="3">Keçmiş cəm</td>
                                <td style="text-align:right;padding:6px 8px;color:#16a34a;font-family:monospace">@Model.KecmisQaligGun.ToString("N2") gün</td>
                            </tr>
                        </tbody>
                    </table>
                }

                <div style="font-size:11px;color:#64748b;text-transform:uppercase;margin:14px 0 6px">Cari anniversary ili prorate (@Model.CariIl)</div>
                <div style="font-size:13px;color:#475569;margin-bottom:6px">
                    Anniversary başlanğıcı: <b>@Model.AnniversaryBaslangic.ToString("dd.MM.yyyy")</b>
                    @if (Model.SonuncuMezuniyyetIsheQebulTarixindenGoturuldu)
                    {
                        <span style="color:#b45309">(yeni işçi — işə qəbul tarixindən)</span>
                    }
                </div>
                <div style="font-size:13px;color:#475569;margin-bottom:6px">
                    Keçən gün: <b>@Model.KecenGunSayi</b> · İllik hüquq: <b>@Model.CariIlToplamGun.ToString("N0")</b> · İstifadə: <b>@Model.CariIlIstifadeOlunan.ToString("N0")</b>
                </div>
                @if (Model.SonuncuMezuniyyetBitmeTarixi.HasValue)
                {
                    <div style="font-size:11px;color:#94a3b8;margin-bottom:6px;font-style:italic">
                        (İnformativ) Sonuncu məzuniyyət bitiş: @Model.SonuncuMezuniyyetBitmeTarixi.Value.ToString("dd.MM.yyyy") — hesablamaya təsir etmir
                    </div>
                }
                <div style="display:flex;justify-content:space-between;padding:6px 0;border-top:1px solid #e2e8f0;font-weight:700;font-size:14px">
                    <span>Cari anniversary ili prorate</span>
                    <span style="color:#16a34a">@Model.CariIlProrateGun.ToString("N2") gün</span>
                </div>

                <div style="display:flex;justify-content:space-between;padding:10px 0;border-top:2px solid #0f172a;margin-top:8px;font-weight:700;font-size:15px">
                    <span>CƏMİ KOMPENSASİYA GÜNLƏRİ</span>
                    <span>@Model.CemiKompensasiyaGun.ToString("N2") gün</span>
                </div>
            </div>

            @* ── Gündəlik dərəcə ─────────── *@
            <div class="fn-card" style="padding:18px">
                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:12px">Gündəlik Dərəcə</div>
                <table style="width:100%;font-size:13px;border-collapse:collapse">
                    <tr style="border-bottom:1px solid #f1f5f9">
                        <td style="padding:5px 0;color:#64748b">Son 12 ay düzəlmiş cəm (S)</td>
                        <td style="padding:5px 0;text-align:right;font-family:monospace">@Model.Son12AyDuzelmisQazanc.ToString("N2") ₼</td>
                    </tr>
                    <tr style="border-bottom:1px solid #f1f5f9">
                        <td style="padding:5px 0;color:#64748b">MH = S / 12 / 30.4</td>
                        <td style="padding:5px 0;text-align:right;font-family:monospace;color:@(Model.Qalib == "MH" ? "#16a34a" : "#0f172a");font-weight:@(Model.Qalib == "MH" ? "700" : "400")">@Model.GunlukMezPul.ToString("N4") ₼/gün</td>
                    </tr>
                    <tr style="border-bottom:1px solid #f1f5f9">
                        <td style="padding:5px 0;color:#64748b">ƏH = CariMaas / ayİşGün</td>
                        <td style="padding:5px 0;text-align:right;font-family:monospace;color:@(Model.Qalib == "ƏH" ? "#16a34a" : "#0f172a");font-weight:@(Model.Qalib == "ƏH" ? "700" : "400")">@Model.GunlukMaas.ToString("N4") ₼/gün</td>
                    </tr>
                    <tr style="font-weight:700;border-top:1px solid #0f172a">
                        <td style="padding:8px 0">MAX (@Model.Qalib qalib)</td>
                        <td style="padding:8px 0;text-align:right;font-family:monospace">@Model.GunlukRate.ToString("N4") ₼/gün</td>
                    </tr>
                </table>
            </div>
        </div>

        <div>
            @* ── İzahat ──── *@
            <div class="fn-card" style="padding:18px;margin-bottom:12px">
                <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:10px">İzahat Addımları</div>
                @foreach (var iz in Model.Izahatlar)
                {
                    <div style="font-size:12px;color:#475569;padding:4px 0;border-bottom:1px solid #f1f5f9">@iz</div>
                }
            </div>

            @if (Model.Xeberdarliqlar.Any())
            {
                <div class="fn-card" style="padding:14px 18px;background:#fffbeb;border:1px solid #fcd34d;margin-bottom:12px">
                    <div style="font-size:11px;font-weight:700;color:#b45309;margin-bottom:6px">⚠ XƏBƏRDARLIQLAR</div>
                    @foreach (var x in Model.Xeberdarliqlar)
                    {
                        <div style="font-size:12px;color:#92400e;margin:3px 0">• @x</div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Qeyd))
            {
                <div class="fn-card" style="padding:14px 18px;margin-bottom:12px">
                    <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:6px">QEYD</div>
                    <div style="font-size:13px;color:#0f172a;white-space:pre-wrap">@Model.Qeyd</div>
                </div>
            }

            <div class="fn-card" style="padding:14px 18px">
                <div style="font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:6px">QEYD İNFOSU</div>
                <div style="font-size:12px;color:#475569;line-height:1.7">
                    Yaradılıb: <b>@Model.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")</b><br/>
                    Ayrılma tarixi: <b>@Model.AyrilmaTarixi.ToString("dd.MM.yyyy")</b><br/>
                    Hesablanan: <b>@ayAdlari[Model.HesablananAy] @Model.HesablananIl</b><br/>
                    @if (Model.MaasId.HasValue)
                    {
                        <text>Maaş qeydi: <a asp-area="HR" asp-controller="Maas" asp-action="Detal" asp-route-id="@Model.MaasId">#@Model.MaasId</a></text>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
