@model List<FinNex.Domain.Entities.HR.Mezuniyyet>
@{
    ViewData["Title"] = "Məzuniyyət ödənişləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var filter = (string)(ViewBag.Filter ?? "gozleyir");
    var gozleyirSay = (int)(ViewBag.GozleyirSay ?? 0);
    var planliSay = (int)(ViewBag.PlanliSay ?? 0);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mo-page">
    <div class="mo-head">
        <div>
            <div class="mo-title">Məzuniyyət ödənişləri (qabaqcadan)</div>
            <div class="mo-sub">HR təsdiqindən sonra yaranan qabaqcadan ödəniş müraciətləri</div>
        </div>
        <div class="mo-badges">
            <span class="mo-pill mo-pill--warn">
                <i class="bi bi-hourglass-split"></i> @gozleyirSay gözləyən
            </span>
            @if (planliSay > 0)
            {
                <span class="mo-pill mo-pill--planli" style="margin-left:6px;">
                    <i class="bi bi-calendar-event"></i> @planliSay planlı
                </span>
            }
        </div>
    </div>

    <div class="mo-filters">
        <a asp-action="Index" asp-route-filter="gozleyir"
           class="mo-filter @(filter == "gozleyir" ? "mo-filter--active" : "")">
            Gözləyən
        </a>
        <a asp-action="Index" asp-route-filter="planli"
           class="mo-filter @(filter == "planli" ? "mo-filter--active" : "")">
            Planlı
        </a>
        <a asp-action="Index" asp-route-filter="odenilib"
           class="mo-filter @(filter == "odenilib" ? "mo-filter--active" : "")">
            Ödənilmiş
        </a>
        <a asp-action="Index" asp-route-filter="hamisi"
           class="mo-filter @(filter == "hamisi" ? "mo-filter--active" : "")">
            Hamısı
        </a>
    </div>

    <div class="mo-card">
        @if (!Model.Any())
        {
            <div class="mo-empty">
                <i class="bi bi-inbox"></i>
                <p>Qeyd tapılmadı</p>
            </div>
        }
        else
        {
            <table class="mo-table">
                <thead>
                    <tr>
                        <th>İşçi</th>
                        <th>Məzuniyyət dövrü</th>
                        <th>HR təsdiq</th>
                        <th class="mo-num">Məbləğ (ilkin)</th>
                        <th>Status</th>
                        <th class="mo-act">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>
                                <strong>@(m.Isci?.TamAd ?? ("#" + m.IsciId))</strong>
                            </td>
                            <td>
                                @m.BaslamaTarixi.ToString("dd.MM.yyyy") – @m.BitmeTarixi.ToString("dd.MM.yyyy")
                                <div class="mo-sub-sm">@m.IsGunlerininSayi iş günü</div>
                            </td>
                            <td>
                                @(m.HrTesdiqTarixi?.ToString("dd.MM.yyyy HH:mm") ?? "—")
                            </td>
                            <td class="mo-num">
                                @(m.OdenenMebleg.HasValue ? m.OdenenMebleg.Value.ToString("N2") + " ₼" : "—")
                            </td>
                            <td>
                                @if (m.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.Gozleyir)
                                {
                                    <span class="mo-status mo-status--warn">Gözləyir</span>
                                }
                                else if (m.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.PlanliOdenis)
                                {
                                    <span class="mo-status mo-status--planli">
                                        Planlı · @(m.PlanliOdenisTarixi?.ToString("dd.MM") ?? "—")
                                    </span>
                                }
                                else if (m.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.Odenilib)
                                {
                                    <span class="mo-status mo-status--ok">Ödənilib</span>
                                }
                                else
                                {
                                    <span class="mo-status">—</span>
                                }
                            </td>
                            <td class="mo-act">
                                <a asp-action="Detail" asp-route-id="@m.Id"
                                   class="mo-btn mo-btn--outline">
                                    <i class="bi bi-eye"></i> Bax
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .mo-page { padding: 24px 28px; max-width: 1400px; margin: 0 auto; }
    .mo-head {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 18px;
    }
    .mo-title { font-size: 1.4rem; font-weight: 800; color: #1a1d29; }
    .mo-sub { font-size: 0.85rem; color: #8a93a8; margin-top: 2px; }
    .mo-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px; border-radius: 999px;
        font-size: 12px; font-weight: 700;
    }
    .mo-pill--warn { background: #fef3c7; color: #92400e; }
    .mo-pill--planli { background: #dbeafe; color: #1e40af; }

    .mo-filters { display: flex; gap: 8px; margin-bottom: 14px; }
    .mo-filter {
        padding: 8px 16px; border-radius: 9px;
        border: 1px solid #e2e6ef; background: #fff;
        color: #3d4557; text-decoration: none;
        font-size: 13px; font-weight: 600;
        transition: all .15s;
    }
    .mo-filter:hover { border-color: #7c3aed; color: #6b21a8; }
    .mo-filter--active {
        background: #7c3aed; color: #fff; border-color: #7c3aed;
    }

    .mo-card {
        background: #fff; border-radius: 14px;
        border: 1px solid #e9ecef;
        box-shadow: 0 4px 18px rgba(15, 26, 46, .04);
        overflow: hidden;
    }
    .mo-empty {
        padding: 50px; text-align: center; color: #8a93a8;
    }
    .mo-empty i { font-size: 48px; display: block; margin-bottom: 10px; }

    .mo-table { width: 100%; border-collapse: collapse; }
    .mo-table thead th {
        background: #f7f9fc; padding: 12px 16px;
        font-size: 11px; font-weight: 800;
        text-transform: uppercase;
        color: #5a647a; letter-spacing: .4px;
        border-bottom: 1px solid #eef0f5;
        text-align: left;
    }
    .mo-table td {
        padding: 14px 16px;
        border-bottom: 1px solid #f1f3f7;
        font-size: 13px; color: #1a2332;
    }
    .mo-table tbody tr:last-child td { border-bottom: none; }
    .mo-table .mo-num { text-align: right; font-weight: 700; }
    .mo-table .mo-act { text-align: right; width: 140px; }
    .mo-sub-sm { font-size: 11px; color: #8a93a8; margin-top: 2px; }

    .mo-status {
        display: inline-block; padding: 4px 10px;
        border-radius: 999px; font-size: 11px; font-weight: 700;
    }
    .mo-status--warn { background: #fef3c7; color: #92400e; }
    .mo-status--ok { background: #d1fae5; color: #065f46; }
    .mo-status--planli { background: #dbeafe; color: #1e40af; }

    .mo-btn {
        display: inline-flex; gap: 5px; align-items: center;
        padding: 7px 14px; border-radius: 8px;
        font-size: 12px; font-weight: 700;
        text-decoration: none; transition: all .15s;
    }
    .mo-btn--outline {
        border: 1px solid #e2e6ef; background: #fff; color: #3d4557;
    }
    .mo-btn--outline:hover { border-color: #7c3aed; color: #6b21a8; }
</style>
