@model FinNex.Application.DTOs.HR.Mezuniyyet.MezuniyyetOdenisHesablamaDto
@{
    ViewData["Title"] = "Məzuniyyət ödənişi — detal";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var mez = (FinNex.Domain.Entities.HR.Mezuniyyet)ViewBag.Mezuniyyet;
    bool odenilib = mez.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.Odenilib;
    bool planli = mez.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.PlanliOdenis;
    bool gozleyir = mez.OdenisStatus == FinNex.Domain.Entities.HR.MezuniyyetOdenisStatus.Gozleyir;
    bool aySonu = mez.OdenisTipi == FinNex.Domain.Entities.HR.MezuniyyetOdenisTipi.AySonuOdenis;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mod-page">
    <div class="mod-head">
        <div>
            <a asp-action="Index" class="mod-back"><i class="bi bi-arrow-left"></i> Geri</a>
            <div class="mod-title">Məzuniyyət ödənişi — @Model.IsciAdSoyad</div>
            <div class="mod-sub">
                @Model.BaslamaTarixi.ToString("dd.MM.yyyy") – @Model.BitmeTarixi.ToString("dd.MM.yyyy")
                &middot; @Model.UmumiTeqvimGun təqvim günü / @Model.UmumiIsGun iş günü
            </div>
        </div>
        @if (odenilib)
        {
            <span class="mod-status mod-status--ok">
                <i class="bi bi-check-circle-fill"></i> Ödənilib
                @if (mez.OdenilmeTarixi.HasValue)
                {
                    <small>(@mez.OdenilmeTarixi.Value.ToString("dd.MM.yyyy HH:mm"))</small>
                }
            </span>
        }
        else if (planli)
        {
            <span class="mod-status mod-status--planli">
                <i class="bi bi-calendar-event"></i> Planlı ödəniş
                @if (mez.PlanliOdenisTarixi.HasValue)
                {
                    <small>(@mez.PlanliOdenisTarixi.Value.ToString("dd.MM.yyyy"))</small>
                }
            </span>
        }
        else
        {
            <span class="mod-status mod-status--warn">
                <i class="bi bi-hourglass-split"></i> Gözləyir
            </span>
        }
    </div>

    <div class="mod-grid">

        @* ── Əsas göstəricilər ── *@
        <div class="mod-card mod-card--summary">
            <div class="mod-card-title"><i class="bi bi-info-circle"></i> Hesablama göstəriciləri</div>
            <div class="mod-kv">
                <span>Cari maaş</span><strong>@Model.CariMaas.ToString("N2") ₼</strong>
                <span>Son 12 ay xam cəmi</span>
                <strong>
                    @Model.Son12AyCemi.ToString("N2") ₼
                    <small class="mod-muted">(@Model.Son12AyQeydSayi / 12 qeyd)</small>
                </strong>
                <span>Son 12 ay artım əmsallı düzəlmiş cəmi</span>
                <strong class="mod-gold">@Model.Son12AyDuzelmisCemi.ToString("N2") ₼</strong>
                <span>Hesablama məntiqi</span>
                <strong class="mod-mono">MAX(tarixi orta, cari maaş hesabı) — hansı böyükdürsə</strong>
            </div>
            @foreach (var xeb in Model.TarixceXeberdarliqlari)
            {
                <div class="mod-warn">
                    <i class="bi bi-exclamation-triangle"></i>
                    @xeb
                </div>
            }
            @if (Model.Son12AyQeydSayi < 12)
            {
                <div class="mod-warn">
                    <i class="bi bi-exclamation-triangle"></i>
                    Yalnız @Model.Son12AyQeydSayi / 12 ay qazanc tarixçəsi mövcuddur — tarixi
                    ortalama qeyri-dəqiq ola bilər.
                </div>
            }
        </div>

        @* ── Artım əmsalı cədvəli ── *@
        <div class="mod-card">
            <div class="mod-card-title">
                <i class="bi bi-graph-up-arrow"></i> Son 12 ayın artım əmsalı cədvəli
                <small class="mod-muted">Artım əmsalı = cari ştat maaşı ÷ o aydaki ştat maaşı (yalnız artım)</small>
            </div>
            @if (!Model.QazancEmsallari.Any())
            {
                <div class="mod-muted">Qazanc qeydi yoxdur.</div>
            }
            else
            {
                <table class="mod-table">
                    <thead>
                        <tr>
                            <th>Ay</th>
                            <th class="mod-num">O aydaki ştat maaşı</th>
                            <th class="mod-num">Faktiki qazanc</th>
                            <th class="mod-num">Artım əmsalı</th>
                            <th class="mod-num">Düzəlmiş qazanc</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in Model.QazancEmsallari)
                        {
                            <tr>
                                <td><strong>@k.AyAdi</strong></td>
                                <td class="mod-num">@k.StatMaas.ToString("N2")</td>
                                <td class="mod-num">@k.Qazanc.ToString("N2")</td>
                                <td class="mod-num">
                                    @if (k.Emsal > 1m)
                                    {
                                        <strong style="color:#1e9b6b">×@k.Emsal.ToString("0.0000")</strong>
                                    }
                                    else
                                    {
                                        <span class="mod-muted">1.0000</span>
                                    }
                                </td>
                                <td class="mod-num"><strong>@k.DuzelmisQazanc.ToString("N2")</strong></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="mod-num"><strong>Cəmi (düzəlmiş)</strong></td>
                            <td class="mod-num mod-total">@Model.Son12AyDuzelmisCemi.ToString("N2") ₼</td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        @* ── Per-month breakdown ── *@
        <div class="mod-card">
            <div class="mod-card-title"><i class="bi bi-calendar3"></i> Ay-ay bölünmə</div>
            <table class="mod-table">
                <thead>
                    <tr>
                        <th>Ay</th>
                        <th class="mod-num" title="Təqvim günü — şənbə/bazar daxil">Təqvim günü</th>
                        <th class="mod-num" title="İş günü — şənbə/bazar/bayram çıxılmış">İş günü</th>
                        <th class="mod-num">Ay iş günü</th>
                        <th class="mod-num" title="Gündəlik tarixi orta (son 12 ayın düzəlmiş cəmi ÷ 12 ÷ 30.4) × iş günü">Tarixi orta</th>
                        <th class="mod-num" title="Gündəlik cari maaş (cari maaş ÷ ay iş günü) × məzuniyyət iş günü">Cari maaş hesabı</th>
                        <th class="mod-num" title="MAX(gündəlik dərəcələr) × iş günü — böyük gündəlik götürülür">Məzuniyyət ödənişi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.AySliceleri)
                    {
                        <tr>
                            <td><strong>@s.AyAdi</strong></td>
                            <td class="mod-num">@s.TeqvimGun</td>
                            <td class="mod-num">@s.IsGun</td>
                            <td class="mod-num">@s.AyIsGun</td>
                            <td class="mod-num">@s.MH.ToString("N2")</td>
                            <td class="mod-num">@s.EH.ToString("N2")</td>
                            <td class="mod-num">
                                <strong>@s.Secilen.ToString("N2")</strong>
                                <small class="mod-muted">
                                    (@(s.Qalib == "MH" ? "tarixi orta" : "cari maaş hesabı"))
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6" class="mod-num"><strong>CƏMİ</strong></td>
                        <td class="mod-num mod-total">@Model.CemiOdenis.ToString("N2") ₼</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @* ── Addım-addım izahat ── *@
        <div class="mod-card">
            <div class="mod-card-title">
                <i class="bi bi-list-check"></i> Addım-addım hesablama məntiqi
                <small class="mod-muted">(kodlara baxmadan izləyə bilərsiniz)</small>
            </div>
            <ol class="mod-steps">
                @foreach (var addim in Model.IzahatAddimlari)
                {
                    <li>@addim</li>
                }
            </ol>
        </div>

        @* ── Maaş günü preview — mühasib üçün informativ ── *@
        @if (!odenilib)
        {
            var cariMaasVal = (decimal)(ViewBag.CariMaas ?? 0m);
            var ayIsGunVal = (int)(ViewBag.AyIsGun ?? 22);
            var mezIsGunVal = (int)(ViewBag.MezIsGun ?? 0);
            var islenmisGunVal = (int)(ViewBag.IslenmisGun ?? 0);
            var islenmisMaasVal = (decimal)(ViewBag.IslenmisMaas ?? 0m);
            var islenmisNetVal = (decimal)(ViewBag.IslenmisNet ?? 0m);
            var hysMeblegVal = (decimal)(ViewBag.HysMebleg ?? 0m);
            var avansMeblegVal = (decimal)(ViewBag.AvansMebleg ?? 0m);
            var mezPuluBrutVal = (decimal)(ViewBag.MezPuluBrut ?? 0m);
            var maasGuniNetVal = (decimal)(ViewBag.MaasGuniNet ?? 0m);
            bool menfi = maasGuniNetVal < 0;

            <div class="mod-card @(menfi ? "mod-card--danger" : "")">
                <div class="mod-card-title">
                    <i class="bi bi-calculator"></i>
                    İşçi maaş günü nə alacaq? (təxmini)
                </div>
                <div class="mod-kv" style="font-size:13px;">
                    <span>Cari maaş</span>
                    <strong>@cariMaasVal.ToString("N2") ₼</strong>

                    <span>Ayda @ayIsGunVal iş günü, @islenmisGunVal işlənir, @mezIsGunVal məzuniyyət</span>
                    <strong>İşlənmiş günlər maaşı: @islenmisMaasVal.ToString("N2") ₼</strong>

                    <span>İşlənmiş maaş NET (tutulmalardan sonra)</span>
                    <strong>@islenmisNetVal.ToString("N2") ₼</strong>

                    @if (hysMeblegVal > 0)
                    {
                        <span>− HYS (işçi payı)</span>
                        <strong style="color:#dc2626">− @hysMeblegVal.ToString("N2") ₼</strong>
                    }
                    @if (avansMeblegVal > 0)
                    {
                        <span>− Avans</span>
                        <strong style="color:#dc2626">− @avansMeblegVal.ToString("N2") ₼</strong>
                    }
                    <span>− Məzuniyyət pulu (qabaqcadan verildi)</span>
                    <strong style="color:#dc2626">− @mezPuluBrutVal.ToString("N2") ₼</strong>

                    <span style="font-weight:800;font-size:14px;">Maaş günü işçi alacaq</span>
                    <strong style="font-size:16px;color:@(menfi ? "#dc2626" : "#1e9b6b")">@maasGuniNetVal.ToString("N2") ₼</strong>
                </div>

                @if (menfi)
                {
                    <div class="mod-warn" style="background:#fef2f2;border-color:#fecaca;color:#991b1b;margin-top:12px;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Diqqət:</strong> İşçinin maaşı qabaqcadan verilən məzuniyyət pulunu, HYS və avans kəsintilərini
                        ödəməyə çatmır. Maaş günü @(Math.Abs(maasGuniNetVal).ToString("N2")) ₼ borc yaranacaq. Qərarı özünüz verin.
                    </div>
                }
            </div>
        }

        @* ── Ödəniş bölümü ── *@
        <div class="mod-card mod-card--action">
            <div class="mod-card-title"><i class="bi bi-cash-coin"></i> Ödəniş</div>

            @if (odenilib)
            {
                <div class="mod-kv">
                    <span>Ödənilmiş məbləğ</span>
                    <strong class="mod-gold">@((mez.OdenenMebleg ?? 0).ToString("N2")) ₼</strong>
                    <span>Ödəniş tarixi</span>
                    <strong>@(mez.OdenilmeTarixi?.ToString("dd.MM.yyyy HH:mm"))</strong>
                    <span>Təsdiqləyən Mühasib</span>
                    <strong>@(mez.OdeyenMuhasib?.TamAd ?? "—")</strong>
                </div>
            }
            else if (planli)
            {
                <div class="mod-kv">
                    <span>Planlı məbləğ</span>
                    <strong class="mod-gold">@((mez.OdenenMebleg ?? 0).ToString("N2")) ₼</strong>
                    <span>Planlı ödəniş tarixi</span>
                    <strong>@(mez.PlanliOdenisTarixi?.ToString("dd.MM.yyyy"))</strong>
                    <span>Təsdiqləyən Mühasib</span>
                    <strong>@(mez.OdeyenMuhasib?.TamAd ?? "—")</strong>
                </div>
                <div class="mod-warn" style="margin-top:10px;">
                    <i class="bi bi-info-circle"></i>
                    Ödəniş planlı tarixdə avtomatik icra ediləcək. Bank köçürməsini
                    daha erkən icra etmisinizsə, aşağıdakı düymə ilə dərhal
                    <b>İcra edildi</b> işarələyə bilərsiniz.
                </div>
                <form asp-action="IcraEt" method="post" class="mod-odenis-form" style="margin-top:10px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@mez.Id" />
                    <div class="mod-form-actions">
                        <a asp-action="Index" class="mod-btn mod-btn--outline">Geri</a>
                        <button type="submit" class="mod-btn mod-btn--primary">
                            <i class="bi bi-check2-circle"></i> İndi icra edildi
                        </button>
                    </div>
                </form>
            }
            else if (aySonu)
            {
                <div class="mod-warn" style="background:#eff6ff;border-color:#bfdbfe;color:#1e40af;">
                    <i class="bi bi-info-circle"></i>
                    Bu məzuniyyət <b>ay sonu maaşla</b> ödəniş tipinə təyin olunub.
                    Ayrıca ödəniş planlaşdırılmır — məzuniyyət pulu həmin ayın
                    maaş hesablamasına avtomatik daxil ediləcək. Yuxarıdakı
                    "İşçi maaş günü nə alacaq?" bloku informativ məqsəd daşıyır.
                </div>
                <div class="mod-form-actions" style="margin-top:10px;">
                    <a asp-action="Index" class="mod-btn mod-btn--outline">Geri</a>
                </div>
            }
            else
            {
                <form asp-action="Planla" method="post" class="mod-odenis-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@mez.Id" />
                    <div class="mod-form-row">
                        <label class="mod-label">Ödəniş məbləği (AZN)</label>
                        <input type="number"
                               name="redakteEdilmisMebleg"
                               value="@((mez.OdenenMebleg ?? Model.CemiOdenis).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))"
                               step="0.01" min="0"
                               class="mod-input" />
                        <small class="mod-hint">
                            HR təsdiq anında hesablanan məbləğ: <strong>@((mez.OdenenMebleg ?? 0).ToString("N2")) ₼</strong>.
                            Yuxarıdakı canlı hesablama nəticəsi: <strong>@Model.CemiOdenis.ToString("N2") ₼</strong>.
                            Səhv varsa burada düzəldə bilərsiniz.
                        </small>
                        @if (mez.OdenenMebleg.HasValue && mez.OdenenMebleg != Model.CemiOdenis)
                        {
                            <div style="margin-top:6px;">
                                <button type="button" onclick="document.querySelector('[name=redakteEdilmisMebleg]').value='@Model.CemiOdenis.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)'"
                                        style="font-size:12px;padding:4px 10px;border:1px solid #6366f1;border-radius:6px;background:#f0f0ff;color:#4338ca;cursor:pointer;">
                                    <i class="bi bi-arrow-repeat"></i> Canlı hesablamadan götür (@Model.CemiOdenis.ToString("N2") ₼)
                                </button>
                            </div>
                        }
                    </div>
                    <div class="mod-warn" style="margin-bottom:10px;">
                        <i class="bi bi-info-circle"></i>
                        Ödəniş məzuniyyətin başladığı gündən <b>bir iş günü əvvəl</b>
                        avtomatik icra ediləcək. İşçiyə planlı tarix bildirişi göndəriləcək.
                    </div>
                    <div class="mod-form-actions">
                        <a asp-action="Index" class="mod-btn mod-btn--outline">Ləğv et</a>
                        <button type="submit" class="mod-btn mod-btn--primary">
                            <i class="bi bi-calendar-check"></i> Ödənişi planlaşdır
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<style>
    .mod-page { padding: 24px 28px; max-width: 1200px; margin: 0 auto; }
    .mod-head {
        display: flex; justify-content: space-between; align-items: flex-start;
        margin-bottom: 18px;
    }
    .mod-back {
        display: inline-flex; align-items: center; gap: 4px;
        color: #5a647a; text-decoration: none;
        font-size: 12px; font-weight: 600;
        margin-bottom: 6px;
    }
    .mod-back:hover { color: #6b21a8; }
    .mod-title { font-size: 1.35rem; font-weight: 800; color: #1a1d29; }
    .mod-sub { font-size: 0.82rem; color: #8a93a8; margin-top: 3px; }

    .mod-status {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 18px; border-radius: 999px;
        font-size: 13px; font-weight: 700;
    }
    .mod-status small { font-weight: 500; opacity: 0.85; }
    .mod-status--warn { background: #fef3c7; color: #92400e; }
    .mod-status--ok { background: #d1fae5; color: #065f46; }
    .mod-status--planli { background: #dbeafe; color: #1e40af; }

    .mod-grid { display: flex; flex-direction: column; gap: 14px; }
    .mod-card {
        background: #fff; border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 18px 22px;
        box-shadow: 0 4px 14px rgba(15, 26, 46, .04);
    }
    .mod-card-title {
        font-size: 13px; font-weight: 800; color: #6b21a8;
        margin-bottom: 14px; display: flex; gap: 8px; align-items: center;
    }
    .mod-card-title small { color: #8a93a8; font-weight: 500; margin-left: auto; font-size: 11px; }

    .mod-card--summary { background: linear-gradient(135deg, #faf5ff, #f5f3ff); border-color: #d8b4fe; }
    .mod-card--action { border-color: #c8b3f2; }
    .mod-card--danger { border-color: #fca5a5; background: #fef2f2; }

    .mod-kv {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 20px; row-gap: 6px;
        font-size: 13px; color: #3d4557;
    }
    .mod-kv span { color: #5a647a; }
    .mod-kv strong { color: #1a2332; }
    .mod-mono { font-family: ui-monospace, Menlo, monospace; font-size: 11.5px; }
    .mod-muted { color: #8a93a8; font-weight: 500; }
    .mod-gold { color: #c9900a; font-weight: 900; font-size: 18px; }

    .mod-warn {
        margin-top: 10px;
        padding: 8px 12px;
        background: #fef3c7; border-radius: 8px;
        color: #92400e; font-size: 11.5px;
        display: flex; gap: 6px; align-items: center;
    }

    .mod-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .mod-table th {
        text-align: left; padding: 10px 14px;
        background: #f7f9fc; color: #5a647a;
        text-transform: uppercase; font-size: 10.5px; letter-spacing: .4px;
        border-bottom: 1px solid #eef0f5; font-weight: 800;
    }
    .mod-table td {
        padding: 11px 14px;
        border-bottom: 1px solid #f1f3f7;
        color: #1a2332;
    }
    .mod-table tbody tr:last-child td { border-bottom: none; }
    .mod-table .mod-num { text-align: right; font-variant-numeric: tabular-nums; }
    .mod-table tfoot td {
        padding: 13px 14px;
        background: #faf5ff;
        border-top: 2px solid #d8b4fe;
        font-size: 13px;
    }
    .mod-total { color: #c9900a; font-weight: 900; font-size: 15px; }

    .mod-steps {
        background: #fcfaff;
        border: 1px solid #ede7fa;
        border-radius: 10px;
        padding: 14px 18px 14px 38px;
        font-size: 12.5px;
        line-height: 1.7;
        color: #3d4557;
    }
    .mod-steps li { margin-bottom: 2px; }

    .mod-odenis-form {
        background: #fcfaff;
        border: 1px dashed #d8b4fe;
        border-radius: 10px;
        padding: 16px 18px;
    }
    .mod-form-row { margin-bottom: 14px; }
    .mod-label {
        display: block; font-size: 12px; font-weight: 700;
        color: #6b21a8; margin-bottom: 6px;
        text-transform: uppercase; letter-spacing: .3px;
    }
    .mod-input {
        width: 240px; padding: 10px 14px;
        border: 1.5px solid #e2e6ef; border-radius: 8px;
        font-size: 15px; font-weight: 700;
        font-family: inherit;
    }
    .mod-input:focus { outline: none; border-color: #7c3aed; box-shadow: 0 0 0 3px rgba(124, 58, 237, .12); }
    .mod-hint { display: block; margin-top: 7px; font-size: 11.5px; color: #8a93a8; }

    .mod-form-actions {
        display: flex; justify-content: flex-end; gap: 10px;
        margin-top: 10px;
    }
    .mod-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 10px 20px; border-radius: 9px;
        font-size: 13px; font-weight: 700;
        text-decoration: none; border: none; cursor: pointer;
        transition: all .15s; font-family: inherit;
    }
    .mod-btn--outline { background: #fff; color: #3d4557; border: 1px solid #e2e6ef; }
