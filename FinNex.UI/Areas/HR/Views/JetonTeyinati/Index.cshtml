@{
    ViewData["Title"] = "Jeton Kataloqu";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var teyinatlar = ViewBag.Teyinatlar as IList<FinNex.Application.DTOs.HR.Jeton.JetonTeyinatiListDto> ?? new List<FinNex.Application.DTOs.HR.Jeton.JetonTeyinatiListDto>();
    var jsonOpts = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<link rel="stylesheet" href="~/css/hr/hr-jeton.css" asp-append-version="true" />

<div class="hj-page">
    <div class="hj-header">
        <div class="hj-header-left">
            <div class="hj-title-icon"><i class="bi bi-gear-fill"></i></div>
            <div>
                <h1 class="hj-title">Jeton Kataloqu</h1>
                <p class="hj-subtitle">Jeton növlərinin saat dəyərlərini və adlarını idarə et</p>
            </div>
        </div>
        <div>
            <button class="hj-btn hj-btn--primary" onclick="hjtOpenCreateModal()">
                <i class="bi bi-plus-lg"></i> Yeni Jeton
            </button>
        </div>
    </div>

    <div class="hj-table-wrap">
        <table class="hj-table">
            <thead>
                <tr>
                    <th>Növ</th>
                    <th>Ad</th>
                    <th>Dəyər</th>
                    <th>Ödəniş növü</th>
                    <th>Təsvir</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="hjtBody">
                @foreach (var t in teyinatlar)
                {
                    <tr data-id="@t.Id">
                        <td>
                            <span class="hj-jeton-badge" style="background:@t.RengKodu">
                                <i class="@t.Ikon"></i> @t.Ad
                            </span>
                        </td>
                        <td>@t.Ad</td>
                        <td>
                            @if (t.SaatDeyeri == 0)
                            {
                                <span style="color:#9ca3af;">—</span>
                            }
                            else if (t.Vahid == FinNex.Domain.Entities.HR.JetonVahid.Gun)
                            {
                                var gun2 = t.SaatDeyeri / 8m;
                                <strong>@gun2.ToString("0.##") gün</strong>
                                <span style="color:#9ca3af;font-size:12px;"> (@t.SaatDeyeri.ToString("0.##") saat)</span>
                            }
                            else
                            {
                                <strong>@t.SaatDeyeri.ToString("0.##") saat</strong>
                            }
                        </td>
                        <td>
                            @if (t.BirbasaOdenishli)
                            {
                                <span style="background:#d1fae5;color:#065f46;border-radius:5px;padding:2px 8px;font-size:12px;font-weight:600;">
                                    <i class="bi bi-cash"></i> Birbaşa ödəniş
                                </span>
                            }
                            else
                            {
                                <span style="background:#f1f5f9;color:#64748b;border-radius:5px;padding:2px 8px;font-size:12px;">
                                    <i class="bi bi-clock"></i> Saat balansı
                                </span>
                            }
                        </td>
                        <td>@(t.Tesvir ?? "—")</td>
                        <td>
                            @if (t.Aktivdir)
                            {
                                <span class="hj-status hj-status--aktiv">Aktiv</span>
                            }
                            else
                            {
                                <span class="hj-status hj-status--legvedildi">Deaktiv</span>
                            }
                        </td>
                        <td>
                            <button class="hj-btn hj-btn--ghost hj-btn--sm"
                                    onclick='hjtOpenEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(t, jsonOpts)))'>
                                <i class="bi bi-pencil"></i> Redaktə
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Edit Modal ───────────────────────────────────────── -->
<div class="hj-overlay" id="hjtOverlay" onclick="hjtCloseEditModal()"></div>
<div class="hj-modal" id="hjtModal">
    <div class="hj-modal-head">
        <h3><i class="bi bi-pencil-square"></i> Jeton növünü redaktə et</h3>
        <button class="hj-modal-close" onclick="hjtCloseEditModal()">&times;</button>
    </div>
    <div class="hj-modal-body">
        <input type="hidden" id="hjtId" />
        <div class="hj-field">
            <label>Ad</label>
            <input type="text" id="hjtAd" class="hj-input" />
        </div>
        <div class="hj-field">
            <label>Dəyər <span style="color:#dc2626">*</span></label>
            <div style="display:flex;gap:8px;align-items:center;">
                <input type="number" step="0.25" id="hjtSaat" class="hj-input" style="flex:1;" />
                <select id="hjtVahid" class="hj-input" style="width:100px;" onchange="hjtSyncEditVahid()">
                    <option value="saat">Saat</option>
                    <option value="gun">Gün (×8)</option>
                </select>
            </div>
            <small style="color:#6b7280;font-size:12px" id="hjtSaatHint"></small>
        </div>
        <div class="hj-field">
            <label>Təsvir</label>
            <textarea id="hjtTesvir" class="hj-textarea" rows="2"></textarea>
        </div>
        <div class="hj-field">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                <input type="checkbox" id="hjtBirbasaOdenishli" />
                <span>Birbaşa ödənişli <span style="font-size:11px;color:#6b7280;">(gələcəkdə pul ödənişi üçün)</span></span>
            </label>
        </div>
        <div class="hj-field">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                <input type="checkbox" id="hjtAktiv" />
                <span>Aktivdir</span>
            </label>
        </div>
    </div>
    <div class="hj-modal-foot">
        <button class="hj-btn hj-btn--ghost" onclick="hjtCloseEditModal()">Ləğv et</button>
        <button class="hj-btn hj-btn--primary" onclick="hjtSubmitEdit()">
            <i class="bi bi-check2"></i> Yadda saxla
        </button>
    </div>
</div>

<!-- ── Create Modal ─────────────────────────────────────────── -->
<div class="hj-overlay" id="hjtCreateOverlay" onclick="hjtCloseCreateModal()"></div>
<div class="hj-modal" id="hjtCreateModal">
    <div class="hj-modal-head">
        <h3><i class="bi bi-plus-circle"></i> Yeni jeton növü əlavə et</h3>
        <button class="hj-modal-close" onclick="hjtCloseCreateModal()">&times;</button>
    </div>
    <div class="hj-modal-body">
        <div class="hj-field">
            <label>Ad <span style="color:#dc2626">*</span></label>
            <input type="text" id="hjtcAd" class="hj-input" placeholder="məs. Platin" />
        </div>
        <div class="hj-field">
            <label>Növ <span style="color:#dc2626">*</span></label>
            <select id="hjtcNov" class="hj-input">
                <option value="1">Müsbət (bonus saat)</option>
                <option value="2">Mənfi (cəza)</option>
            </select>
        </div>
        <div class="hj-field">
            <label>Kateqoriya <span style="color:#dc2626">*</span></label>
            <select id="hjtcRengi" class="hj-input" onchange="hjtcSyncRengKodu()">
                <option value="1" data-kod="#cd7f32">Bürünc</option>
                <option value="2" data-kod="#a8a9ad">Gümüş</option>
                <option value="3" data-kod="#ffc200">Qızıl</option>
                <option value="4" data-kod="#1a1a1a">Qara</option>
                <option value="ferdi" data-kod="" id="hjtcFerdiOpt" style="display:none;">✏ Fərdi rəng</option>
            </select>
        </div>
        <div class="hj-field">
            <label>Görünüş rengi <span style="color:#dc2626">*</span></label>
            <div style="display:flex;gap:8px;align-items:center;">
                <input type="color" id="hjtcRengPicker" value="#cd7f32"
                       oninput="document.getElementById('hjtcRengKodu').value=this.value; hjtcManualColorChange();"
                       style="width:40px;height:36px;padding:2px;border:1px solid #cbd5e1;border-radius:6px;cursor:pointer;" />
                <input type="text" id="hjtcRengKodu" class="hj-input" value="#cd7f32"
                       placeholder="#rrggbb"
                       oninput="document.getElementById('hjtcRengPicker').value=this.value; hjtcManualColorChange();" />
            </div>
            <small style="color:#6b7280;font-size:12px;">Kateqoriya yuxarıda seçilir, rəng kodu göstəriş üçündür.</small>
        </div>
        <div class="hj-field">
            <label>İkon <span style="font-size:11px;color:#6b7280;">(Bootstrap Icons sinfi)</span></label>
            <input type="text" id="hjtcIkon" class="hj-input" value="bi bi-award-fill" placeholder="bi bi-award-fill" />
        </div>
        <div class="hj-field">
            <label>Dəyər <span style="color:#dc2626">*</span></label>
            <div style="display:flex;gap:8px;align-items:center;">
                <input type="number" step="0.25" id="hjtcSaat" class="hj-input" style="flex:1;" value="1" oninput="hjtcUpdateHint()" />
                <select id="hjtcVahid" class="hj-input" style="width:100px;" onchange="hjtcUpdateHint()">
                    <option value="saat">Saat</option>
                    <option value="gun">Gün (×8)</option>
                </select>
            </div>
            <small id="hjtcSaatHint" style="color:#6b7280;font-size:12px;">= 1 saat saxlanılacaq</small>
        </div>
        <div class="hj-field">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                <input type="checkbox" id="hjtcBirbasaOdenishli" />
                <span>Birbaşa ödənişli <span style="font-size:11px;color:#6b7280;">(gələcəkdə pul ödənişi üçün)</span></span>
            </label>
        </div>
        <div class="hj-field">
            <label>Təsvir</label>
            <textarea id="hjtcTesvir" class="hj-textarea" rows="2" placeholder="İstəyə bağlı..."></textarea>
        </div>
    </div>
    <div class="hj-modal-foot">
        <button class="hj-btn hj-btn--ghost" onclick="hjtCloseCreateModal()">Ləğv et</button>
        <button class="hj-btn hj-btn--primary" onclick="hjtSubmitCreate()">
            <i class="bi bi-plus-lg"></i> Əlavə et
        </button>
    </div>
</div>

@section Scripts {
<script src="~/js/hr/hr-jeton-teyinati.js" asp-append-version="true"></script>
}
