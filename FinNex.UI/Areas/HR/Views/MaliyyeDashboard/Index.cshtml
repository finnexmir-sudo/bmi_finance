@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Maliyyə Dashboard";
}

<style>
.md-grid { display:grid; gap:20px; }
.md-kpi { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
.md-kpi-card { background:#fff; border:1px solid #e5e7eb; border-radius:16px;
               padding:20px 22px; display:flex; align-items:center; gap:16px;
               box-shadow:0 1px 4px rgba(0,0,0,.04); transition:box-shadow .2s; }
.md-kpi-card:hover { box-shadow:0 4px 16px rgba(0,0,0,.08); }
.md-kpi-icon { width:50px; height:50px; border-radius:14px; display:flex;
               align-items:center; justify-content:center; font-size:1.4rem;
               flex-shrink:0; box-shadow:0 2px 8px rgba(0,0,0,.08); }
.md-kpi-val  { font-size:1.5rem; font-weight:700; line-height:1.1; }
.md-kpi-lbl  { font-size:.78rem; color:#6b7280; margin-top:3px; }
.md-kpi-sub  { font-size:.75rem; margin-top:4px; color:#9ca3af; }
.md-row2 { display:grid; grid-template-columns:2fr 1fr; gap:20px; }
.md-row3 { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.md-card { background:#fff; border:1px solid #e5e7eb; border-radius:16px; padding:22px;
           box-shadow:0 1px 4px rgba(0,0,0,.04); }
.md-card h5 { margin:0 0 18px; font-size:.95rem; font-weight:700; color:#1e293b;
              display:flex; align-items:center; gap:8px; }
.md-list { list-style:none; margin:0; padding:0; }
.md-list li { display:flex; align-items:center; justify-content:space-between;
              padding:10px 0; border-bottom:1px solid #f1f5f9; font-size:.85rem; }
.md-list li:last-child { border-bottom:none; }
.md-list .left { display:flex; align-items:center; gap:10px; }
.md-list .mebleg { font-weight:600; }
.md-tag { display:inline-flex; align-items:center; padding:3px 10px;
          border-radius:20px; font-size:.74rem; font-weight:600; }
.md-tag-gecikib { background:#fee2e2; color:#b91c1c; }
.md-tag-bugun   { background:#fef3c7; color:#92400e; }
.md-tag-yaxinda { background:#dbeafe; color:#1d4ed8; }
.md-tag-kecmis  { background:#fee2e2; color:#b91c1c; }
.md-dept-bar { height:6px; background:#f1f5f9; border-radius:6px; overflow:hidden; margin-top:5px; }
.md-dept-bar-fill { height:100%; border-radius:6px; transition:width .6s ease; }
.md-empty {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:8px; padding:36px 20px; color:#9ca3af; font-size:.86rem; text-align:center;
}
.md-empty i { font-size:1.6rem; opacity:.45; }
@@media (max-width:900px) {
    .md-kpi { grid-template-columns:repeat(2,1fr); }
    .md-row2, .md-row3 { grid-template-columns:1fr; }
}
</style>

<div class="md-grid">

    <!-- ── KPI Kartlar ──────────────────────────────────────── -->
    <div class="md-kpi" id="kpiRow">
        <div class="md-kpi-card">
            <div class="md-kpi-icon" style="background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1d4ed8">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div>
                <div class="md-kpi-val" id="kpi1">—</div>
                <div class="md-kpi-lbl">Bu ay ödənilmiş</div>
            </div>
        </div>
        <div class="md-kpi-card">
            <div class="md-kpi-icon" style="background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div>
                <div class="md-kpi-val" id="kpi2">—</div>
                <div class="md-kpi-lbl">Gözləmədə (workflow)</div>
            </div>
        </div>
        <div class="md-kpi-card">
            <div class="md-kpi-icon" style="background:linear-gradient(135deg,#d1fae5,#a7f3d0);color:#065f46">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <div>
                <div class="md-kpi-val" id="kpi3">—</div>
                <div class="md-kpi-lbl">Bu ay büdcə istifadəsi</div>
                <div class="md-kpi-sub" id="kpi3sub"></div>
            </div>
        </div>
        <div class="md-kpi-card">
            <div class="md-kpi-icon" style="background:linear-gradient(135deg,#fee2e2,#fecaca);color:#b91c1c">
                <i class="bi bi-alarm"></i>
            </div>
            <div>
                <div class="md-kpi-val" id="kpi4">—</div>
                <div class="md-kpi-lbl">Gecikmiş dövri ödəniş</div>
                <div class="md-kpi-sub" id="kpi4sub"></div>
            </div>
        </div>
    </div>

    <!-- ── Trend chart + Kateqoriya chart ─────────────────── -->
    <div class="md-row2">
        <div class="md-card">
            <h5><i class="bi bi-graph-up" style="color:#0f766e"></i> Son 6 Ay — Plan vs Faktiki (AZN)</h5>
            <canvas id="trendChart" height="90"></canvas>
        </div>
        <div class="md-card">
            <h5><i class="bi bi-pie-chart" style="color:#8b5cf6"></i> Bu Ay Kateqoriya Paylanması</h5>
            <canvas id="katChart" height="170"></canvas>
            <ul class="md-list" id="katLegend" style="margin-top:12px;"></ul>
        </div>
    </div>

    <!-- ── Departamentlər + Gözlənilən ────────────────────── -->
    <div class="md-row3">
        <div class="md-card">
            <h5><i class="bi bi-building" style="color:#0f766e"></i> Bu Ay Ən Çox Xərc Edən Departamentlər</h5>
            <div id="deptList">
                <div class="md-empty"><i class="bi bi-hourglass"></i>Yüklənir…</div>
            </div>
        </div>
        <div class="md-card">
            <h5><i class="bi bi-calendar-check" style="color:#f59e0b"></i> Gözlənilən Xərclər (30 gün)</h5>
            <ul class="md-list" id="gxList">
                <li style="border:none"><div class="md-empty"><i class="bi bi-hourglass"></i>Yüklənir…</div></li>
            </ul>
        </div>
    </div>

    <!-- ── Yaxında dövri ödənişlər ─────────────────────────── -->
    <div class="md-card">
        <h5><i class="bi bi-arrow-repeat" style="color:#6366f1"></i> Yaxında Dövri Ödənişlər (14 gün)</h5>
        <ul class="md-list" id="dovriList">
            <li style="border:none"><div class="md-empty"><i class="bi bi-hourglass"></i>Yüklənir…</div></li>
        </ul>
    </div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const AZN = v => v.toLocaleString('az-AZ', { minimumFractionDigits: 2 }) + ' ₼';

const COLORS = ['#2ecc71','#3498db','#f1c40f','#e74c3c','#9b59b6','#1abc9c','#e67e22','#e91e63'];

async function init() {
    const [summary, trend, kat, dept, dovri, goz] = await Promise.all([
        fetch('/HR/MaliyyeDashboard/GetSummary').then(r=>r.json()),
        fetch('/HR/MaliyyeDashboard/GetAylikTrend').then(r=>r.json()),
        fetch('/HR/MaliyyeDashboard/GetKateqoriyaBreakdown').then(r=>r.json()),
        fetch('/HR/MaliyyeDashboard/GetTopDept').then(r=>r.json()),
        fetch('/HR/MaliyyeDashboard/GetYaxindaDovri').then(r=>r.json()),
        fetch('/HR/MaliyyeDashboard/GetYaxindaGozlenilen').then(r=>r.json()),
    ]);

    renderKPI(summary);
    renderTrend(trend);
    renderKat(kat);
    renderDept(dept);
    renderDovri(dovri);
    renderGoz(goz);
}

function renderKPI(s) {
    document.getElementById('kpi1').textContent = AZN(s.buAyOdenilmis);
    document.getElementById('kpi2').textContent = AZN(s.buAyGozleme);

    const faiz = s.isletmeFaizi;
    const faizClr = faiz >= 100 ? '#ef4444' : faiz >= 80 ? '#f59e0b' : '#059669';
    document.getElementById('kpi3').innerHTML = `<span style="color:${faizClr}">${faiz}%</span>`;
    document.getElementById('kpi3sub').innerHTML =
        `Plan: ${AZN(s.buAyPlan)} | Azad: ${AZN(Math.max(0,s.azad))}`;

    document.getElementById('kpi4').textContent = s.gecikmisDovri;
    document.getElementById('kpi4sub').textContent = `Bu ay ${s.dovriSay} dövri ödəniş gözlənilir`;
    if (s.gecikmisDovri > 0)
        document.getElementById('kpi4').style.color = '#ef4444';
}

function renderTrend(data) {
    new Chart(document.getElementById('trendChart'), {
        type: 'bar',
        data: {
            labels: data.map(x => x.etiket),
            datasets: [
                {
                    label: 'Plan',
                    data: data.map(x => x.plan),
                    backgroundColor: 'rgba(99,102,241,0.05)',
                    borderColor: '#6366f1',
                    borderWidth: 3,
                    type: 'line',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 5,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#6366f1',
                    pointBorderWidth: 2,
                    pointHoverRadius: 7
                },
                {
                    label: 'Faktiki',
                    data: data.map(x => x.faktiki),
                    backgroundColor: 'rgba(15,118,110,0.75)',
                    borderColor: '#0f766e',
                    borderWidth: 0,
                    borderRadius: 6,
                    borderSkipped: false,
                    hoverBackgroundColor: '#0f766e'
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: {
                    position: 'top',
                    labels: { usePointStyle: true, pointStyleWidth: 10, font: { size: 12 } }
                },
                tooltip: {
                    backgroundColor: 'rgba(15,23,42,0.9)',
                    padding: 12,
                    cornerRadius: 10,
                    callbacks: { label: ctx => '  ' + ctx.dataset.label + ': ' + AZN(ctx.parsed.y) }
                }
            },
            scales: {
                x: { grid: { display: false } },
                y: {
                    ticks: { callback: v => AZN(v), font: { size: 11 } },
                    grid: { color:'rgba(241,245,249,0.8)' }
                }
            }
        }
    });
}

function renderKat(data) {
    if (!data.length) {
        document.getElementById('katLegend').innerHTML =
            `<li style="border:none"><div class="md-empty"><i class="bi bi-pie-chart"></i>Bu ay xərc qeydə alınmayıb.</div></li>`;
        return;
    }
    const total = data.reduce((s, x) => s + x.mebleg, 0);
    new Chart(document.getElementById('katChart'), {
        type: 'doughnut',
        data: {
            labels: data.map(x => x.ad),
            datasets: [{
                data: data.map(x => x.mebleg),
                backgroundColor: COLORS,
                borderWidth: 3,
                borderColor: '#fff',
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(15,23,42,0.9)',
                    padding: 10,
                    cornerRadius: 8,
                    callbacks: { label: ctx => '  ' + AZN(ctx.parsed) }
                }
            },
            cutout: '68%'
        }
    });
    document.getElementById('katLegend').innerHTML = data.map((x, i) =>
        `<li>
            <span class="left">
                <span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:${COLORS[i % COLORS.length]};flex-shrink:0;"></span>
                <span style="color:#374151">${x.ad}</span>
            </span>
            <span class="mebleg" style="color:#1e293b">${(x.mebleg/total*100).toFixed(1)}% — ${AZN(x.mebleg)}</span>
        </li>`
    ).join('');
}

function renderDept(data) {
    if (!data.length) {
        document.getElementById('deptList').innerHTML =
            `<div class="md-empty"><i class="bi bi-building"></i>Bu ay departament xərci yoxdur.</div>`;
        return;
    }
    const max = data[0].mebleg;
    document.getElementById('deptList').innerHTML = data.map((x, i) => {
        const pct = max > 0 ? Math.round(x.mebleg / max * 100) : 0;
        return `<div style="padding:8px 0;border-bottom:1px solid #f1f5f9;">
            <div style="display:flex;justify-content:space-between;font-size:.84rem;margin-bottom:4px;">
                <span style="color:#374151">${x.departament}</span>
                <strong style="color:#1e293b">${AZN(x.mebleg)}</strong>
            </div>
            <div class="md-dept-bar">
                <div class="md-dept-bar-fill" style="width:${pct}%;background:${COLORS[i % COLORS.length]};"></div>
            </div>
        </div>`;
    }).join('');
}

function renderDovri(data) {
    if (!data.length) {
        document.getElementById('dovriList').innerHTML =
            `<li style="border:none"><div class="md-empty"><i class="bi bi-arrow-repeat"></i>Yaxın 14 günə dövri ödəniş planlanmayıb.</div></li>`;
        return;
    }
    document.getElementById('dovriList').innerHTML = data.map(x => {
        const tag = x.gecikib
            ? `<span class="md-tag md-tag-gecikib">⚠️ Gecikib</span>`
            : x.buGun
            ? `<span class="md-tag md-tag-bugun">🔔 Bu gün</span>`
            : `<span class="md-tag md-tag-yaxinda">${x.tarix}</span>`;
        return `<li>
            <span class="left">
                <span style="width:32px;height:32px;border-radius:9px;background:#ede9fe;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-arrow-repeat" style="color:#6366f1;font-size:.9rem"></i>
                </span>
                <span>
                    <strong style="color:#1e293b">${x.ad}</strong>
                    <br><small style="color:#6b7280">${x.departament} · ${x.kateqoriya}</small>
                </span>
            </span>
            <span style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                <span class="mebleg" style="color:#1e293b">${AZN(x.mebleg)}</span>
                ${tag}
            </span>
        </li>`;
    }).join('');
}

function renderGoz(data) {
    if (!data.length) {
        document.getElementById('gxList').innerHTML =
            `<li style="border:none"><div class="md-empty"><i class="bi bi-calendar-check"></i>30 günlük müddətdə gözlənilən xərc yoxdur.</div></li>`;
        return;
    }
    const pClr = { 'Yuksek':'#ef4444', 'Orta':'#f59e0b', 'Asagi':'#059669' };
    document.getElementById('gxList').innerHTML = data.map(x => {
        const clr = pClr[x.prioritet] || '#6b7280';
        const tag = x.kecmis
            ? `<span class="md-tag md-tag-kecmis">Keçib</span>`
            : `<span style="font-size:.76rem;color:#6b7280;background:#f8fafc;padding:2px 8px;border-radius:6px;">${x.tarix}</span>`;
        return `<li>
            <span class="left">
                <span style="width:9px;height:9px;border-radius:50%;background:${clr};display:inline-block;flex-shrink:0;box-shadow:0 0 0 3px ${clr}22;"></span>
                <span>
                    <strong style="color:#1e293b">${x.ad}</strong>
                    <br><small style="color:#6b7280">${x.departament} · ${x.kateqoriya}</small>
                </span>
            </span>
            <span style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
                <span class="mebleg" style="color:#1e293b">${AZN(x.tahminiMebleg)}</span>
                ${tag}
            </span>
        </li>`;
    }).join('');
}

init();
</script>
}
