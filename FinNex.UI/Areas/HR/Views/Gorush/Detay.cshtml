@model FinNex.Application.DTOs.Communication.GorushDetailDto
@using FinNex.Domain.Entities.Communication
@{
    ViewData["Title"] = Model.Bashliq;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var bitisStr = Model.BitisSaati.HasValue
        ? " — " + Model.BitisSaati.Value.ToString(@"hh\:mm") : "";

    string IshtStatusText(IshtirakciStatus s) => s switch
    {
        IshtirakciStatus.Qebul => "Qəbul etdi",
        IshtirakciStatus.Redd => "Rədd etdi",
        IshtirakciStatus.IshtiraketmeyecekBildirib => "İştirak etməyəcək",
        _ => "Gözləyir"
    };
    string IshtStatusRenk(IshtirakciStatus s) => s switch
    {
        IshtirakciStatus.Qebul => "#22c55e",
        IshtirakciStatus.Redd => "#ef4444",
        IshtirakciStatus.IshtiraketmeyecekBildirib => "#ef4444",
        _ => "#f59e0b"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/gorush.css" asp-append-version="true" />
    @* `.tsk-detay-grid` (2 sütunlu detal düzümü) elə bu fayldadır — User-in öz
       Gorush/Detay.cshtml-i bu linki UNUDUB, ona görə orda grid-siz (tək sütun)
       görünür. Bura qəsdən əlavə edildi ki, YENİ səhifə düzgün görünsün. *@
    <link rel="stylesheet" href="~/css/User/tapshiriq.css" asp-append-version="true" />
    <style>
        .td-hero{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:28px 32px;margin-bottom:16px}
        .td-hero-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px}
        .td-hero-title{font-size:1.35rem;font-weight:700;color:#111827;margin-top:6px;line-height:1.3}
        .td-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .td-meta-item{display:flex;align-items:flex-start;gap:10px;background:#f9fafb;border-radius:8px;padding:12px 14px}
        .td-meta-icon{font-size:1.1rem;margin-top:1px;flex-shrink:0}
        .td-meta-lbl{font-size:.72rem;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:.04em;margin-bottom:2px}
        .td-meta-val{font-size:.88rem;font-weight:600;color:#1f2937}
        .td-section-title{font-size:.8rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px}
        .td-agenda{background:#f9fafb;border-radius:8px;padding:16px;font-size:.88rem;color:#374151;line-height:1.7;white-space:pre-wrap}
        .td-ishtirakci{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid #f3f4f6}
        .td-ishtirakci:last-child{border-bottom:none}
        .td-ic-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0}
        .td-ic-name{font-size:.88rem;font-weight:600;color:#1f2937}
        .td-ic-vezife{font-size:.75rem;color:#9ca3af;margin-top:1px}
        .td-ic-status{font-size:.72rem;font-weight:600;margin-left:auto;white-space:nowrap}
        .td-sidebar-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:20px;margin-bottom:16px}
        .td-org-row{display:flex;align-items:center;gap:10px}
        .td-org-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#10b981,#059669);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.9rem;flex-shrink:0}
        .td-org-lbl{font-size:.72rem;color:#9ca3af;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
        .td-org-name{font-size:.88rem;font-weight:700;color:#1f2937}
        @@media(max-width:700px){.td-meta-grid{grid-template-columns:1fr}}
    </style>
}

<div class="fn-page">
    <div style="margin-bottom:16px">
        <a asp-action="Index" class="grsh-btn grsh-btn--ghost">← Görüşlərə qayıt</a>
    </div>

    <div class="tsk-detay-grid">

        <div>
            <div class="td-hero">
                <div class="td-hero-top">
                    <div>
                        <span class="grsh-status @Model.HesablanmisStatusClass">
                            @Model.HesablanmisStatusText
                        </span>
                        <div class="td-hero-title">@Model.Bashliq</div>
                    </div>
                </div>

                <div class="td-meta-grid">
                    <div class="td-meta-item">
                        <div class="td-meta-icon">📅</div>
                        <div>
                            <div class="td-meta-lbl">Tarix</div>
                            <div class="td-meta-val">@Model.Tarix.ToString("dd MMMM yyyy")</div>
                        </div>
                    </div>
                    <div class="td-meta-item">
                        <div class="td-meta-icon">🕐</div>
                        <div>
                            <div class="td-meta-lbl">Saat</div>
                            <div class="td-meta-val">@Model.BaslamaSaati.ToString(@"hh\:mm")@bitisStr</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Yer))
                    {
                        <div class="td-meta-item" style="grid-column:1/-1">
                            <div class="td-meta-icon">📍</div>
                            <div>
                                <div class="td-meta-lbl">Yer</div>
                                <div class="td-meta-val">@Model.Yer</div>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.OnlineLink))
                    {
                        <div class="td-meta-item" style="grid-column:1/-1">
                            <div class="td-meta-icon">🔗</div>
                            <div>
                                <div class="td-meta-lbl">Onlayn link</div>
                                <div class="td-meta-val">@Model.OnlineLink</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Agenda))
            {
                <div class="td-sidebar-card">
                    <div class="td-section-title">Gündəm</div>
                    <div class="td-agenda">@Model.Agenda</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Qeydler))
            {
                <div class="td-sidebar-card">
                    <div class="td-section-title">Görüş Qeydləri</div>
                    <div class="td-agenda">@Model.Qeydler</div>
                </div>
            }

            <div class="td-sidebar-card">
                <div class="td-section-title">
                    İştirakçılar
                    <span style="background:#e0e7ff;color:#4338ca;font-size:.72rem;padding:1px 7px;border-radius:20px;margin-left:6px;font-weight:700">
                        @Model.IshtirakciSayi
                    </span>
                </div>
                @if (!Model.Ishtirakcılar.Any())
                {
                    <div style="font-size:.85rem;color:#9ca3af">İştirakçı əlavə edilməyib.</div>
                }
                @foreach (var i in Model.Ishtirakcılar)
                {
                    <div class="td-ishtirakci">
                        <div class="td-ic-av">@i.IsciAd.Substring(0, 1)</div>
                        <div>
                            <div class="td-ic-name">@i.IsciAd</div>
                            <div class="td-ic-vezife">@i.IsciVezife</div>
                        </div>
                        <div class="td-ic-status" style="color:@IshtStatusRenk(i.Status)">@IshtStatusText(i.Status)</div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="td-sidebar-card">
                <div class="td-org-row">
                    <div class="td-org-av">@Model.TeshkilatciAd.Substring(0, 1)</div>
                    <div>
                        <div class="td-org-lbl">Təşkilatçı</div>
                        <div class="td-org-name">@Model.TeshkilatciAd</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
