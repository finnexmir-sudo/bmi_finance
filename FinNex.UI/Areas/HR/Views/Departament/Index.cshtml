@using FinNex.Application.DTOs.Structur
@model IEnumerable<DepartmentListDto>
@{
    ViewData["Title"] = "Departamentlər";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/struktur.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Departamentlər</div>
            <div class="fn-page-sub">Şöbələrin idarə olunması</div>
        </div>
        <a asp-action="Create" class="fn-btn fn-btn--primary">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            Yeni Departament
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Departament yoxdur</div>
            <div class="fn-empty-sub">Yeni departament əlavə edin</div>
        </div>
    }
    else
    {
        <div class="str-grid">
            @foreach (var item in Model)
            {
                <div class="str-card">
                    <div class="str-card-top">
                        <div class="str-card-icon">
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                                <rect x="2" y="3" width="14" height="12" rx="2" stroke="currentColor" stroke-width="1.3" />
                                <path d="M2 7h14M6 3V1M12 3V1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                            </svg>
                        </div>
                        <div class="str-card-actions">
                            <button class="str-action-btn"
                                    title="Redaktə"
                                    data-action="dept-edit"
                                    data-id="@item.Id"
                                    data-ad="@item.Ad"
                                    data-aciqlama="@(item.Aciqlama ?? "")">
                                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                    <path d="M9 2l2 2-6.5 6.5H2.5v-2L9 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                                </svg>
                            </button>
                            <button class="str-action-btn str-action-btn--red"
                                    title="Sil"
                                    data-action="dept-delete"
                                    data-id="@item.Id"
                                    data-ad="@item.Ad"
                                    data-sayi="@item.IsciSayi">
                                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                    <path d="M2 3.5h9M5 3.5V2h3v1.5M4.5 3.5l.5 7M8.5 3.5l-.5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="str-card-name">@item.Ad</div>
                    @if (!string.IsNullOrEmpty(item.Aciqlama))
                    {
                        <div class="str-card-desc">@item.Aciqlama</div>
                    }
                    <div class="str-card-footer">
                        <div class="str-card-count">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <circle cx="6" cy="4" r="1.8" stroke="currentColor" stroke-width="1.1" />
                                <path d="M1.5 11c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                            </svg>
                            @item.IsciSayi işçi
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<!-- ── Edit Modal ───────────────────────────────── -->
<div class="str-modal-overlay" id="editModal" style="display:none;">
    <div class="str-modal">
        <div class="str-modal-header">
            <div class="str-modal-title">Departamenti Redaktə Et</div>
            <button type="button" class="str-modal-close" data-close-modal="editModal">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editId" />
            <div class="str-modal-body">
                <div class="isci-field str-field-mb">
                    <label class="isci-label">Departament Adı <span class="isci-required">*</span></label>
                    <input type="text" name="Ad" id="editAd" class="isci-input" required placeholder="Departament adı" />
                </div>
                <div class="isci-field">
                    <label class="isci-label">Açıqlama</label>
                    <textarea name="Aciqlama" id="editAciqlama"
                              class="isci-input str-modal-textarea"
                              placeholder="Departamentin funksiyası..."></textarea>
                </div>
            </div>
            <div class="str-modal-footer">
                <button type="button" class="fn-btn fn-btn--outline" data-close-modal="editModal">Ləğv et</button>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Yadda saxla
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ── Delete Modal ─────────────────────────────── -->
<div class="str-modal-overlay" id="deleteModal" style="display:none;">
    <div class="str-modal str-modal--sm">
        <div class="str-modal-header">
            <div class="str-modal-title">Departamenti Sil</div>
            <button type="button" class="str-modal-close" data-close-modal="deleteModal">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        <div class="str-modal-body">
            <div class="str-delete-blocked" id="deptWarnBlocked" style="display:none;">
                <div id="deptWarnBlockedText"></div>
            </div>
            <div class="str-delete-confirm" id="deptWarnConfirm" style="display:none;">
                <div id="deptWarnConfirmText"></div>
            </div>
        </div>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="str-modal-footer">
                <button type="button" class="fn-btn fn-btn--outline" data-close-modal="deleteModal">Ləğv et</button>
                <button type="submit" id="deleteConfirmBtn" class="fn-btn str-btn-danger">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 3h8M4.5 3V2h3v1M4 3l.5 6.5M8 3l-.5 6.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    </svg>
                    Sil
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/hr/departament-index.js" asp-append-version="true"></script>
}
