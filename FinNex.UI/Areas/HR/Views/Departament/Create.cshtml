@using FinNex.Application.DTOs.Structur
@model DepartmentCreateDto
@{
    ViewData["Title"] = "Yeni Departament";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/struktur.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/isci.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="isci-form-wrap">

        <a asp-action="Index" class="isci-form-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Departamentlərə qayıt
        </a>

        <div class="isci-form-card">
            <div class="isci-form-header">
                <div class="isci-form-header-icon isci-form-header-icon--indigo">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <rect x="2" y="3" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.4" />
                        <path d="M2 8h16M7 3V1M13 3V1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-form-header-title">Yeni Departament</div>
                    <div class="isci-form-header-sub">Departament məlumatlarını daxil edin</div>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="isci-form-body">
                    <div class="isci-field">
                        <label class="isci-label">
                            Departament Adı <span class="isci-required">*</span>
                        </label>
                        <input asp-for="Ad" class="isci-input" placeholder="Məsələn: Kredit, Kassa, IT" />
                        <span asp-validation-for="Ad" class="isci-error"></span>
                    </div>

                    <div class="isci-field">
                        <label class="isci-label">Açıqlama</label>
                        <textarea asp-for="Aciqlama" class="isci-input str-modal-textarea"
                                  rows="4"
                                  placeholder="Departamentin funksiyası haqqında qısa məlumat..."></textarea>
                        <span asp-validation-for="Aciqlama" class="isci-error"></span>
                    </div>
                </div>

                <div class="isci-form-footer">
                    <div class="isci-form-footer-note">* olan sahələr məcburidir</div>
                    <div class="isci-form-footer-actions">
                        <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Yadda saxla
                        </button>
                    </div>
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
