@model FinNex.Application.DTOs.HR.Maas.FerdiHesablaInputDto
@{
    ViewData["Title"] = "Maaş Hesabla";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Fərdi Maaş Hesabla</div>
            <div class="fn-page-sub">İşçi seçin, bonus/cərimə daxil edin, hesablayın</div>
        </div>
        <a asp-action="Index" asp-controller="Maas" asp-area="HR" class="fn-btn fn-btn--outline fn-btn--sm">← Maaş siyahısına qayıt</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="fn-alert fn-alert--danger">@TempData["Error"]</div>
    }

    <div style="display:grid;grid-template-columns:1fr 340px;gap:16px;align-items:start;">

        @* ── Sol: Form ── *@
        <form asp-action="Hesabla" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">
                <div class="fn-card-head" style="margin-bottom:4px;">
                    <div class="fn-card-title">Hesablama məlumatları</div>
                </div>

                @* İşçi + İl/Ay *@
                <div class="fn-form-row">
                    <div class="fn-form-group" style="grid-column:1/-1;">
                        <label asp-for="IsciId" class="fn-label">İşçi *</label>
                        <select asp-for="IsciId" asp-items="ViewBag.Isciler"
                                class="fn-select" id="isciSelect">
                            <option value="">— İşçi seçin —</option>
                        </select>
                        <span asp-validation-for="IsciId" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="Il" class="fn-label">İl *</label>
                        <select asp-for="Il" asp-items="ViewBag.Iller" class="fn-select"></select>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="Ay" class="fn-label">Ay *</label>
                        <select asp-for="Ay" asp-items="ViewBag.Aylar" class="fn-select"></select>
                    </div>
                </div>

                @* ═══ Faktiki kontekst (işçi+tarix seçiləndə AJAX yükləyir) ═══ *@
                <div id="ctxBox" style="display:none;margin-top:8px;padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                        <div style="font-size:12px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px">
                            <i class="bi bi-info-circle"></i> Cari vəziyyət (seçilən ay üzrə)
                        </div>
                        <span id="ctxSpinner" style="display:none;font-size:11px;color:#94a3b8">yüklənir...</span>
                    </div>

                    <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px">
                        @* Əsas maaş *@
                        <div style="padding:10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px">
                            <div style="font-size:10.5px;color:#94a3b8;text-transform:uppercase">Əsas əmək haqqı (cari)</div>
                            <div id="ctxMaas" style="font-size:16px;font-weight:700;color:#0f172a;margin-top:3px">—</div>
                            <div id="ctxMaasSub" style="font-size:10.5px;color:#64748b">—</div>
                        </div>

                        @* Staj + faiz *@
                        <div style="padding:10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px">
                            <div style="font-size:10.5px;color:#94a3b8;text-transform:uppercase">Ümumi staj</div>
                            <div id="ctxStaj" style="font-size:16px;font-weight:700;color:#0f172a;margin-top:3px">—</div>
                            <div id="ctxStajFaiz" style="font-size:10.5px;color:#64748b">—</div>
                        </div>

                        @* Məzuniyyət (ay) *@
                        <div style="padding:10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;grid-column:1/-1">
                            <div style="font-size:10.5px;color:#94a3b8;text-transform:uppercase">Bu ay məzuniyyət</div>
                            <div id="ctxMez" style="font-size:13px;color:#0f172a;margin-top:3px">—</div>
                        </div>

                        @* Xəstəlik (ay) *@
                        <div style="padding:10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;grid-column:1/-1">
                            <div style="font-size:10.5px;color:#94a3b8;text-transform:uppercase">Bu ay xəstəlik bülletənləri</div>
                            <div id="ctxXes" style="font-size:13px;color:#0f172a;margin-top:3px">—</div>
                        </div>

                        @* Avans (ay) *@
                        <div style="padding:10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;grid-column:1/-1">
                            <div style="font-size:10.5px;color:#94a3b8;text-transform:uppercase">Bu ay avans</div>
                            <div id="ctxAvans" style="font-size:13px;color:#0f172a;margin-top:3px">—</div>
                        </div>

                        @* Əvvəlki hesablama *@
                        <div id="ctxEvvelki" style="display:none;padding:10px;background:#fef3c7;border:1px solid #fde68a;border-radius:6px;grid-column:1/-1">
                            <div style="font-size:11.5px;color:#78350f;font-weight:600">
                                ⚠ Bu ay üçün artıq hesablama var: <span id="ctxEvvelkiText"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr style="border:none;border-top:1px solid #f2f4f7;">

                @* Bonus *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="BonusMeblegi" class="fn-label">
                            Bonus / Mükafat
                            <span class="fn-label-hint">AZN, istəğə bağlı</span>
                        </label>
                        <div class="fn-input-pfx">
                            <span class="fn-input-pfx-icon">₼</span>
                            <input asp-for="BonusMeblegi" type="number" step="0.01" min="0"
                                   class="fn-input fn-input--pfx" placeholder="0.00"/>
                        </div>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="BonusAciqlama" class="fn-label">Bonus izahı</label>
                        <input asp-for="BonusAciqlama" class="fn-input" placeholder="məs: Kvartallıq mükafat"/>
                    </div>
                </div>

                @* Cərimə *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="CerimeMeblegi" class="fn-label">
                            Cərimə / Kəsinti
                            <span class="fn-label-hint">AZN, istəğə bağlı</span>
                        </label>
                        <div class="fn-input-pfx">
                            <span class="fn-input-pfx-icon">₼</span>
                            <input asp-for="CerimeMeblegi" type="number" step="0.01" min="0"
                                   class="fn-input fn-input--pfx" placeholder="0.00"/>
                        </div>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="CerimeAciqlama" class="fn-label">Kəsinti izahı</label>
                        <input asp-for="CerimeAciqlama" class="fn-input" placeholder="məs: Gecikdirmə"/>
                    </div>
                </div>

                <div class="fn-form-actions">
                    <a href="@returnUrl" class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M6.5 1.5v5.5L9 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6.5 7 4 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                            <path d="M2 9.5a4.5 4.5 0 0 0 9 0" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                        </svg>
                        Hesabla
                    </button>
                </div>
            </div>
        </form>

        @* ── Sağ: İzah paneli ── *@
        <div class="fn-card" style="position:sticky;top:20px;">
            <div class="fn-card-head">
                <div class="fn-card-title">Hesablama qaydası</div>
            </div>
            <div class="hesab-qayda">
                <div class="hq-item hq-gelir">
                    <div class="hq-icon">+</div>
                    <div>
                        <div class="hq-ad">Əsas əməkhaqqı</div>
                        <div class="hq-izah">Müqavilə üzrə ştat maaşı</div>
                    </div>
                </div>
                <div class="hq-item hq-gelir">
                    <div class="hq-icon">+</div>
                    <div>
                        <div class="hq-ad">Məzuniyyət ödənişi</div>
                        <div class="hq-izah">2026 qaydası · Max(orta, cari) ÷ 30 × gün</div>
                    </div>
                </div>
                <div class="hq-item hq-gelir">
                    <div class="hq-icon">+</div>
                    <div>
                        <div class="hq-ad">Xəstəlik ödənişi (şirkət)</div>
                        <div class="hq-izah">Təsdiqlənmiş bülletənlər üzrə · max 14 gün/bülletən · staj%</div>
                    </div>
                </div>
                <div class="hq-item hq-gelir">
                    <div class="hq-icon">+</div>
                    <div>
                        <div class="hq-ad">Bonus / Mükafat</div>
                        <div class="hq-izah">İstəğə bağlı əlavə</div>
                    </div>
                </div>
                <div class="hq-item hq-kesinti">
                    <div class="hq-icon">−</div>
                    <div>
                        <div class="hq-ad">Məzuniyyət kəsintisi</div>
                        <div class="hq-izah">Maaş ÷ iş günü × məz. günü</div>
                    </div>
                </div>
                <div class="hq-item hq-kesinti">
                    <div class="hq-icon">−</div>
                    <div>
                        <div class="hq-ad">Cərimə</div>
                        <div class="hq-izah">İstəğə bağlı kəsinti</div>
                    </div>
                </div>
                <div class="hq-sep">= GROSS</div>
                <div class="hq-item hq-vergi">
                    <div class="hq-icon">%</div>
                    <div>
                        <div class="hq-ad">Gəlir vergisi</div>
                        <div class="hq-izah">14% · güzəşt: 200 AZN</div>
                    </div>
                </div>
                <div class="hq-item hq-vergi">
                    <div class="hq-icon">%</div>
                    <div>
                        <div class="hq-ad">DSMF (işçi)</div>
                        <div class="hq-izah">3%</div>
                    </div>
                </div>
                <div class="hq-item hq-vergi">
                    <div class="hq-icon">%</div>
                    <div>
                        <div class="hq-ad">İşsizlik sığortası</div>
                        <div class="hq-izah">0.5%</div>
                    </div>
                </div>
                <div class="hq-item hq-vergi">
                    <div class="hq-icon">%</div>
                    <div>
                        <div class="hq-ad">İTSS</div>
                        <div class="hq-izah">2%</div>
                    </div>
                </div>
                <div class="hq-sep hq-sep--net">= NET MAAŞ</div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/maas-hesabla.css" />
}

@section Scripts {
<script>
    (function () {
        const isciSel = document.getElementById('isciSelect');
        const ilSel = document.querySelector('select[name="Il"]');
        const aySel = document.querySelector('select[name="Ay"]');
        const ctxBox = document.getElementById('ctxBox');
        const spinner = document.getElementById('ctxSpinner');

        function fmt(n) {
            if (n == null || isNaN(n)) return '—';
            return Number(n).toLocaleString('az-AZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₼';
        }

        let lastKey = '';
        async function refresh() {
            const iid = isciSel.value;
            const il = ilSel.value;
            const ay = aySel.value;
            if (!iid || !il || !ay) { ctxBox.style.display = 'none'; return; }

            const key = iid + '|' + il + '|' + ay;
            if (key === lastKey) return;
            lastKey = key;

            ctxBox.style.display = 'block';
            spinner.style.display = 'inline';
            try {
                const r = await fetch(`/HR/Maas/Context?isciId=${iid}&il=${il}&ay=${ay}`);
                const d = await r.json();
                if (!d.success) return;

                document.getElementById('ctxMaas').textContent = fmt(d.cariMaas);
                document.getElementById('ctxMaasSub').textContent = 'Müqavilə üzrə';

                document.getElementById('ctxStaj').textContent = d.staj.il + ' il ' + d.staj.ay + ' ay';
                document.getElementById('ctxStajFaiz').textContent = 'xəstəlikdə ' + d.staj.faiz + '%';

                // Məzuniyyət
                const mezEl = document.getElementById('ctxMez');
                if (!d.mezuniyyetler.length) {
                    mezEl.innerHTML = '<span style="color:#94a3b8;font-size:12px">— yoxdur —</span>';
                } else {
                    mezEl.innerHTML = d.mezuniyyetler.map(m =>
                        `<div style="padding:4px 0">
                            <strong>${m.nov}</strong> · ${m.baslama} → ${m.bitme} · ${m.isGunu} iş günü
                            ${m.odenen ? ' · ödənən: <strong>' + fmt(m.odenen) + '</strong>' : ''}
                        </div>`
                    ).join('');
                }

                // Xəstəlik
                const xesEl = document.getElementById('ctxXes');
                if (!d.xestelikler.length) {
                    xesEl.innerHTML = '<span style="color:#94a3b8;font-size:12px">— yoxdur —</span>';
                } else {
                    let cemiSirket = 0;
                    xesEl.innerHTML = d.xestelikler.map(x => {
                        cemiSirket += Number(x.sirketOdenis || 0);
                        return `<div style="padding:4px 0">
                            Bülletən <strong>№${x.bulletenNo}</strong>: şirkət ${x.sirketGun} gün / ${fmt(x.sirketOdenis)},
                            DSMF ${x.dsmfGun} gün / ${fmt(x.dsmfOdenis)}
                        </div>`;
                    }).join('') +
                    `<div style="margin-top:4px;font-size:11px;font-weight:700;color:#1e40af">Şirkət cəmi (gross-a əlavə olunur): ${fmt(cemiSirket)}</div>`;
                }

                // Avans
                const avEl = document.getElementById('ctxAvans');
                if (!d.avanslar.length) {
                    avEl.innerHTML = '<span style="color:#94a3b8;font-size:12px">— yoxdur —</span>';
                } else {
                    avEl.innerHTML = d.avanslar.map(a =>
                        `<div style="padding:4px 0">
                            ${fmt(a.mebleg)} · status: <strong>${a.status}</strong>
                        </div>`
                    ).join('');
                }

                // Əvvəlki hesablama xəbərdarlığı
                const evvEl = document.getElementById('ctxEvvelki');
                const evvTxt = document.getElementById('ctxEvvelkiText');
                if (d.movcudHesablama) {
                    evvEl.style.display = 'block';
                    evvTxt.textContent = `#${d.movcudHesablama.id} — Brüt ${fmt(d.movcudHesablama.brut)} · Net ${fmt(d.movcudHesablama.net)}. Yenidən hesablasanız köhnə dəyişdirilir.`;
                } else {
                    evvEl.style.display = 'none';
                }
            } catch (e) {
                ctxBox.style.display = 'none';
            } finally {
                spinner.style.display = 'none';
            }
        }

        [isciSel, ilSel, aySel].forEach(el => el && el.addEventListener('change', refresh));
        // Səhifə açılanda default seçilibsə dərhal yüklə
        if (isciSel.value) refresh();
    })();
</script>
}
