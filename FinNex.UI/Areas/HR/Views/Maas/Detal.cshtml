@model FinNex.Application.DTOs.HR.Maas.MaasDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = $"Maaş Detalı — {Model.IsciAdSoyad}";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string AyAdi(int ay) => new DateTime(2000, ay, 1).ToString("MMMM");
    string StatusClass(MaasStatus s) => s switch {
        MaasStatus.Odenildi     => "fn-badge--done",
        MaasStatus.Tesdiqlendi  => "fn-badge--review",
        MaasStatus.Layihe       => "fn-badge--wait",
        MaasStatus.LegvEdildi   => "fn-badge--rejected",
        _ => "fn-badge--wait"
    };
    string StatusText(MaasStatus s) => s switch {
        MaasStatus.Odenildi     => "Ödənildi",
        MaasStatus.Tesdiqlendi  => "Təsdiqləndi",
        MaasStatus.Layihe       => "Layihə",
        MaasStatus.LegvEdildi   => "Ləğv edildi",
        _ => "—"
    };

    // VM 98.2.1 gəlirləri hesabi (imputed) vergiyə cəlb gəlirdir — işçiyə nağd ödənmir,
    // yalnız vergi bazasını artırır. Ona görə "Gəlirlər" siyahısından və brüt/gəlir cəmindən
    // çıxarılır (əks halda cəmlər tutmaz); izahı aşağıda "Hesablama axını" cədvəlində görünür.
    var gelirlər  = Model.Detallar.Where(d => d.Tip == MaasDetayTipi.Gelir && d.MaasNovuAd != "VM 98.2.1 Gəlirləri").ToList();
    var tutulmalar = Model.Detallar.Where(d => d.Tip == MaasDetayTipi.Tutulma).ToList();
    var sirket    = Model.Detallar.Where(d => d.Tip == MaasDetayTipi.IsegoturenXerci).ToList();
    decimal brutMaas = gelirlər.Sum(d => d.Mebleg) - tutulmalar.Where(d => d.MaasNovuAd == "Məzuniyyət Kəsintisi" || d.MaasNovuAd == "Gecikdirmə Cəriməsi").Sum(d => d.Mebleg);
    decimal umumiTutulma = tutulmalar.Where(d => d.MaasNovuAd != "Məzuniyyət Kəsintisi" && d.MaasNovuAd != "Gecikdirmə Cəriməsi").Sum(d => d.Mebleg);

    // Qabaqcadan ödənilmiş məzuniyyət (ayrıca ödənilib, adi maaşdan çıxılıb) — başlıqda
    // ayın TAM gross/net-i görünsün. Yalnız məzuniyyət olan ayda tətbiq olunur (adi/HYS
    // işçilərdə brutMaas/NetMebleg toxunulmaz qalır).
    decimal mezQabaqBrut = ViewBag.MezQabaqBrut == null ? 0m : (decimal)ViewBag.MezQabaqBrut;
    decimal mezQabaqNet  = ViewBag.MezQabaqNet  == null ? 0m : (decimal)ViewBag.MezQabaqNet;
    decimal tamGross = ViewBag.TamGross == null ? brutMaas        : (decimal)ViewBag.TamGross;
    decimal tamNet   = ViewBag.TamNet   == null ? Model.NetMebleg : (decimal)ViewBag.TamNet;
    decimal grossDisplay = mezQabaqBrut > 0 ? tamGross : brutMaas;
    decimal netDisplay   = mezQabaqNet  > 0 ? tamNet   : Model.NetMebleg;
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.IsciAdSoyad</div>
            <div class="fn-page-sub">
                @Model.DepartamentAd · @Model.VezifeAd ·
                @AyAdi(Model.Ay) @Model.Il ·
                <span class="fn-badge @StatusClass(Model.Status)">@StatusText(Model.Status)</span>
            </div>
        </div>
        <div style="display:flex;gap:8px;">
            <a asp-action="IsciTarixce" asp-route-isciId="@Model.IsciId"
               class="fn-btn fn-btn--outline fn-btn--sm">Tarixçə</a>
            <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">← Siyahı</a>
        </div>
    </div>

    @* Success/Error _UserLayout.cshtml-də render olunur — burada təkrar etmirik. *@

    <div style="display:grid;grid-template-columns:1fr 280px;gap:16px;align-items:start;">

        @* ── Sol: Hesablama cədvəli ── *@
        <div style="display:flex;flex-direction:column;gap:12px;">

            @* Gəlirlər *@
            <div class="fn-card" style="padding:0;overflow:hidden;">
                <div class="dt-sec-head dt-sec-head--gelir">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <path d="M6.5 2v9M3 5.5l3.5-3.5L10 5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Gəlirlər
                </div>
                <table class="dt-table">
                    @foreach (var d in gelirlər)
                    {
                        <tr>
                            <td class="dt-ad">@d.MaasNovuAd</td>
                            <td class="dt-izah">@d.Aciqlama</td>
                            <td class="dt-mebleg dt-gelir">+@d.Mebleg.ToString("N2") ₼</td>
                        </tr>
                    }
                </table>
            </div>

            @* Kəsintilər / Tutulmalar *@
            <div class="fn-card" style="padding:0;overflow:hidden;">
                <div class="dt-sec-head dt-sec-head--kesinti">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <path d="M6.5 11V2M3 7.5l3.5 3.5L10 7.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Tutulmalar və kəsintilər
                </div>
                <table class="dt-table">
                    @foreach (var d in tutulmalar)
                    {
                        <tr>
                            <td class="dt-ad">@d.MaasNovuAd</td>
                            <td class="dt-izah">@d.Aciqlama</td>
                            <td class="dt-mebleg dt-kesinti">−@d.Mebleg.ToString("N2") ₼</td>
                        </tr>
                    }
                </table>
            </div>

            @* Şirkət xərcləri *@
            @if (sirket.Any())
            {
                <div class="fn-card" style="padding:0;overflow:hidden;">
                    <div class="dt-sec-head dt-sec-head--sirket">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <rect x="1.5" y="5" width="10" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.1"/>
                            <path d="M4.5 5V3.5a2 2 0 0 1 4 0V5" stroke="currentColor" stroke-width="1.1"/>
                        </svg>
                        Şirkət xərcləri <span style="font-weight:400;opacity:.6;font-size:10px;">(işçidən tutulmur)</span>
                    </div>
                    <table class="dt-table">
                        @foreach (var d in sirket)
                        {
                            <tr>
                                <td class="dt-ad">@d.MaasNovuAd</td>
                                <td class="dt-izah">@d.Aciqlama</td>
                                <td class="dt-mebleg dt-sirket">@d.Mebleg.ToString("N2") ₼</td>
                            </tr>
                        }
                    </table>
                </div>
            }

            @* Hesablama axını — addım-addım audit izahı (mühasibatçı üçün) *@
            @if (Model.Izahatlar != null && Model.Izahatlar.Any())
            {
                string TipBadge(string tip) => tip switch
                {
                    "gelir"    => "background:#e8f6ee;color:#1a7a50;border:1px solid #b2e0cc;",
                    "kesinti"  => "background:#fdecea;color:#8a2a20;border:1px solid #f4c1b9;",
                    "vergi"    => "background:#fff4e0;color:#8a5a1b;border:1px solid #eecb97;",
                    "sirket"   => "background:#eef2f9;color:#3b4a66;border:1px solid #c7d1e4;",
                    _           => "background:#f4f6fb;color:#5a6478;border:1px solid #dfe4ee;"
                };
                string TipAd(string tip) => tip switch
                {
                    "gelir"    => "gəlir",
                    "kesinti"  => "kəsinti",
                    "vergi"    => "vergi",
                    "sirket"   => "şirkət",
                    _           => "məlumat"
                };
                string MeblegPrefix(string tip) => tip switch
                {
                    "gelir"   => "+",
                    "kesinti" => "−",
                    "vergi"   => "−",
                    _         => ""
                };

                <details class="fn-card" style="padding:0;overflow:hidden;" open>
                    <summary style="cursor:pointer;padding:10px 14px;font-weight:600;font-size:12px;color:#3b4a66;background:#f8fafd;border-bottom:1px solid #e4e8f0;display:flex;align-items:center;gap:8px;list-style:none;">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M2 3h9M2 6.5h9M2 10h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                        Hesablama axını <span style="font-weight:400;opacity:.6;font-size:10px;">(hər rəqəmin hardan gəldiyi — audit üçün)</span>
                    </summary>
                    <table class="dt-table" style="font-size:11.5px;">
                        <thead>
                            <tr style="background:#fafbfd;color:#8a93a8;font-size:10px;text-transform:uppercase;letter-spacing:.3px;">
                                <th style="padding:6px 10px;text-align:left;width:26%;">Addım</th>
                                <th style="padding:6px 10px;text-align:left;">İzah / Düstur</th>
                                <th style="padding:6px 10px;text-align:right;width:13%;">Tip</th>
                                <th style="padding:6px 10px;text-align:right;width:15%;">Məbləğ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var iz in Model.Izahatlar)
                            {
                                <tr>
                                    <td class="dt-ad" style="vertical-align:top;">@iz.Addim</td>
                                    <td class="dt-izah" style="white-space:normal;line-height:1.5;">@iz.Izah</td>
                                    <td style="text-align:right;vertical-align:top;">
                                        <span style="display:inline-block;padding:1px 7px;border-radius:10px;font-size:9.5px;font-weight:500;@TipBadge(iz.Tip)">@TipAd(iz.Tip)</span>
                                    </td>
                                    <td class="dt-mebleg" style="vertical-align:top;">
                                        @if (iz.Mebleg != 0)
                                        {
                                            <text>@MeblegPrefix(iz.Tip)@iz.Mebleg.ToString("N2") ₼</text>
                                        }
                                        else
                                        {
                                            <span style="color:#b0b7c5;">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </div>

        @* ── Sağ: Xülasə ── *@
        <div style="display:flex;flex-direction:column;gap:12px;position:sticky;top:20px;">

            @* NET kart *@
            <div class="fn-card dt-net-card">
                <div class="dt-net-ay">@AyAdi(Model.Ay) @Model.Il</div>
                <div class="dt-net-val">@netDisplay.ToString("N2") ₼</div>
                <div class="dt-net-lbl">NET MAAŞ</div>

                @if (!string.IsNullOrEmpty(Model.BankHesabNo))
                {
                    <div class="dt-iban">
                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
                            <rect x="1" y="2.5" width="9" height="6" rx="1.5" stroke="currentColor" stroke-width="1"/>
                            <path d="M1 5h9" stroke="currentColor" stroke-width=".9"/>
                        </svg>
                        @Model.BankHesabNo
                    </div>
                }
                else
                {
                    <div class="dt-iban dt-iban--missing">⚠ IBAN qeydiyyatda yoxdur</div>
                }
            </div>

            @* Xülasə sətirləri *@
            <div class="fn-card" style="padding:14px 16px;">
                <div class="fn-card-title" style="margin-bottom:10px;">Xülasə</div>
                <div class="dt-sum-row">
                    <span>Ümumi gəlirlər</span>
                    <span class="dt-gelir">@gelirlər.Sum(d => d.Mebleg).ToString("N2") ₼</span>
                </div>
                <div class="dt-sum-row">
                    <span>Kəsintilər</span>
                    <span class="dt-kesinti">−@tutulmalar.Where(d => d.MaasNovuAd is "Məzuniyyət Kəsintisi" or "Gecikdirmə Cəriməsi").Sum(d => d.Mebleg).ToString("N2") ₼</span>
                </div>
                <div class="dt-sum-row dt-sum-sep">
                    <span>Gross maaş</span>
                    <span style="font-weight:600;">@grossDisplay.ToString("N2") ₼</span>
                </div>
                <div class="dt-sum-row">
                    <span>Vergi tutulmaları</span>
                    <span class="dt-kesinti">−@umumiTutulma.ToString("N2") ₼</span>
                </div>
                <div class="dt-sum-row dt-sum-net">
                    <span>NET maaş</span>
                    <span>@netDisplay.ToString("N2") ₼</span>
                </div>
                @if (mezQabaqBrut > 0)
                {
                    <div class="dt-sum-row" style="margin-top:6px;padding-top:6px;border-top:1px dashed #e4e8f0;color:#8a93a8;font-size:10px;">
                        <span>— o cümlədən qabaqcadan məzuniyyət (ayrıca ödənilib)</span>
                        <span>brüt @mezQabaqBrut.ToString("N2") / net @mezQabaqNet.ToString("N2") ₼</span>
                    </div>
                }
                @if (sirket.Any())
                {
                    <div class="dt-sum-row" style="margin-top:8px;padding-top:8px;border-top:1px dashed #e4e8f0;color:#8a93a8;font-size:10px;">
                        <span>Şirkət xərcləri</span>
                        <span>@sirket.Sum(d => d.Mebleg).ToString("N2") ₼</span>
                    </div>
                }
            </div>

            @* Tarix məlumatları *@
            <div class="fn-card" style="padding:14px 16px;">
                <div class="fn-card-title" style="margin-bottom:10px;">Tarix məlumatları</div>
                <div class="dt-tarix-row">
                    <span>Hesablandı</span>
                    <span>@Model.HesablanmaTarixi.ToString("dd.MM.yyyy HH:mm")</span>
                </div>
                @if (Model.TesdiqTarixi.HasValue)
                {
                    <div class="dt-tarix-row">
                        <span>Təsdiqləndi</span>
                        <span style="color:#1a4fa0;">@Model.TesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }
                @if (Model.OdenisTarixi.HasValue)
                {
                    <div class="dt-tarix-row">
                        <span>Ödənildi</span>
                        <span style="color:#1a7a50;">@Model.OdenisTarixi.Value.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                }
            </div>

            @* Əməliyyatlar *@
            <div class="fn-card" style="padding:14px 16px;">
                <div class="fn-card-title" style="margin-bottom:10px;">Əməliyyatlar</div>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    @if (Model.Status == MaasStatus.Layihe)
                    {
                        <form asp-action="StatusDeyis" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="yeniStatus" value="@((int)MaasStatus.Tesdiqlendi)"/>
                            <input type="hidden" name="il" value="@Model.Il"/>
                            <input type="hidden" name="ay" value="@Model.Ay"/>
                            <button type="submit" class="fn-btn fn-btn--primary" style="width:100%;justify-content:center;">
                                Rəhbər təsdiqləyir
                            </button>
                        </form>
                        <form asp-action="YenidenHesabla" method="post"
                              onsubmit="return confirm('Köhnə hesablama silinib yenidən hesablanacaq. Bonus və cərimə saxlanılır. Davam?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <button type="submit" class="fn-btn fn-btn--outline" style="width:100%;justify-content:center;">
                                Yenidən Hesabla
                            </button>
                        </form>
                    }
                    @if (Model.Status == MaasStatus.Tesdiqlendi)
                    {
                        <form asp-action="StatusDeyis" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id"/>
                            <input type="hidden" name="yeniStatus" value="@((int)MaasStatus.Odenildi)"/>
                            <input type="hidden" name="il" value="@Model.Il"/>
                            <input type="hidden" name="ay" value="@Model.Ay"/>
                            <button type="submit" class="fn-btn" style="width:100%;justify-content:center;background:#edf8f4;color:#1a7a50;border:1px solid #b2e0cc;">
                                Mühasib bazaya vurur → Ödənildi
                            </button>
                        </form>
                    }
                    <a asp-action="Index" asp-route-il="@Model.Il" asp-route-ay="@Model.Ay"
                       class="fn-btn fn-btn--outline" style="width:100%;justify-content:center;">
                        Siyahıya qayıt
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/maas-detal.css" />
}
