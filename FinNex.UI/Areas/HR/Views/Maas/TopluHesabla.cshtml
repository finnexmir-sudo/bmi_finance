@model IEnumerable<FinNex.Domain.Entities.HR.Isci>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Toplu Maaş Hesablaması";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var il           = (int)ViewBag.Il;
    var ay           = (int)ViewBag.Ay;
    var hesablanmis  = (List<int>)ViewBag.Hesablanmis;
    var cariMaasMap  = ViewBag.CariMaasMap as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var ibanMap      = ViewBag.IbanMap as Dictionary<int, string?> ?? new Dictionary<int, string?>();
    var vergiPilleleriList = (ViewBag.VergiPilleleri as List<VergiPille>) ?? new();
    var vergiGuzestiDeyer  = (decimal)(ViewBag.VergiGuzesti ?? 200m);
    var firstBracketMax    = (decimal)(ViewBag.FirstBracketMax ?? 2500m);
    var isciList     = Model.ToList();

    decimal GetEsas(int isciId) => cariMaasMap.TryGetValue(isciId, out var v) ? v : (isciList.FirstOrDefault(x => x.Id == isciId)?.Maliye?.CariMaas ?? 0m);
    string? GetIban(int isciId) => ibanMap.TryGetValue(isciId, out var v) ? v : isciList.FirstOrDefault(x => x.Id == isciId)?.Maliye?.BankHesabNo;

    var ayAdlar = new[]{"","Yanvar","Fevral","Mart","Aprel","May","İyun","İyul","Avqust","Sentyabr","Oktyabr","Noyabr","Dekabr"};

    int doneSayi  = isciList.Count(x => hesablanmis.Contains(x.Id));
    int yeniSayi  = isciList.Count(x => !hesablanmis.Contains(x.Id));
    int ibanYox   = isciList.Count(x => string.IsNullOrEmpty(GetIban(x.Id)));

    string Fmt(decimal v) => v > 0 ? v.ToString("N2") + " ₼" : "—";

    // JS-ə keçiriləcək pilləli konfiqurasiya
    var isciHysMap = ViewBag.IsciHysMap as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
    var hysIsvFaiz = (decimal)(ViewBag.HysIsvFaiz ?? 15m);

    var pilleConfigJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        pilleler = vergiPilleleriList.GroupBy(x => (int)x.Nov).ToDictionary(
            g => g.Key.ToString(),
            g => g.OrderBy(x => x.Sira).Select(x => new {
                AsagiHedd = x.AsagiHedd,
                YuxariHedd = x.YuxariHedd,
                Faiz = x.Faiz,
                SabitMebleg = x.SabitMebleg
            }).ToArray()
        ),
        vergiGuzesti = vergiGuzestiDeyer,
        hysIsvFaiz = hysIsvFaiz
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/maas-toplu.css" asp-append-version="true" />
}

<div class="mth-page">

    @* ── Alerts ──────────────────────────────────────────────── *@
    @if (TempData["Success"] != null)
    {
        <div class="mth-alert mth-alert--success">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="#1e9b6b" stroke-width="1.4"/>
                <path d="M5 8l2.5 2.5L11 6" stroke="#1e9b6b" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mth-alert mth-alert--error">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <circle cx="8" cy="8" r="7" stroke="#d85a30" stroke-width="1.4"/>
                <path d="M8 5v4M8 10.5v.5" stroke="#d85a30" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            @TempData["Error"]
        </div>
    }

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="mth-header">
        <div>
            <div class="mth-breadcrumb">
                <a asp-area="HR" asp-controller="Dashboard" asp-action="Index">HR İdarəetmə</a>
                <span class="mth-breadcrumb-sep">›</span>
                <a asp-area="HR" asp-controller="Maas" asp-action="Index"
                   asp-route-il="@il" asp-route-ay="@ay">Əmək Haqqı</a>
                <span class="mth-breadcrumb-sep">›</span>
                <span>Toplu Hesablama</span>
            </div>
            <div class="mth-title">Toplu Maaş Hesablaması</div>
            <div class="mth-subtitle">Bonus / cərimə daxil edib kütləvi hesablama aparın — @ayAdlar[ay] @il</div>
        </div>
        <div class="mth-header-right">
            <a asp-area="HR" asp-controller="Maas" asp-action="Index"
               asp-route-il="@il" asp-route-ay="@ay"
               class="mth-btn mth-btn--outline">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M8 2L3 6.5 8 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Maaş Siyahısı
            </a>
            <a asp-area="HR" asp-controller="Maas" asp-action="BankFayliYukle"
               asp-route-il="@il" asp-route-ay="@ay"
               class="mth-btn mth-btn--outline">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                    <path d="M6.5 2v6M4 6l2.5 2.5L9 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M1.5 9.5v1a.5.5 0 00.5.5h9a.5.5 0 00.5-.5v-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                Bank Faylı
            </a>
        </div>
    </div>

    @* ── Period bar ───────────────────────────────────────────── *@
    <div class="mth-period-bar">
        <span class="mth-period-label">Dövr</span>
        <div class="mth-period-selects">
            <select class="mth-select" id="mthIlSec" onchange="mthPeriodChange()">
                @foreach (var item in ViewBag.Iller as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>

            <select class="mth-select" id="mthAySec" onchange="mthPeriodChange()">
                @foreach (var item in ViewBag.Aylar as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
        </div>
        <div class="mth-period-div"></div>
        <div class="mth-period-badge">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <rect x="1" y="1.5" width="10" height="9" rx="1.5" stroke="#c9900a" stroke-width="1.2"/>
                <path d="M1 4h10M4 1.5v2M8 1.5v2" stroke="#c9900a" stroke-width="1" stroke-linecap="round"/>
            </svg>
            @ayAdlar[ay] @il
        </div>
        <div class="mth-period-div"></div>
        <div style="display:flex;align-items:center;gap:14px;margin-left:auto;">
            <span style="font-size:12px;font-weight:600;color:#1e9b6b;display:flex;align-items:center;gap:5px;">
                <span style="width:7px;height:7px;border-radius:50%;background:#1e9b6b;display:inline-block;"></span>
                @doneSayi hesablanıb
            </span>
            <span style="font-size:12px;font-weight:600;color:#2d6cdf;display:flex;align-items:center;gap:5px;">
                <span style="width:7px;height:7px;border-radius:50%;background:#2d6cdf;display:inline-block;"></span>
                @yeniSayi yeni
            </span>
            @if (ibanYox > 0)
            {
                <span style="font-size:12px;font-weight:600;color:#b45309;display:flex;align-items:center;gap:5px;">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M6 1.5L11 10.5H1L6 1.5z" stroke="#b45309" stroke-width="1.1" stroke-linejoin="round"/>
                        <path d="M6 5v2.5M6 9v.3" stroke="#b45309" stroke-width="1.1" stroke-linecap="round"/>
                    </svg>
                    @ibanYox IBAN yoxdur
                </span>
            }
        </div>
    </div>

    @* ── Vergi dərəcələri (2026 — pilləli qaydalar) ────────────── *@
    @{
        var vergiPilleleri = (ViewBag.VergiPilleleri as List<FinNex.Domain.Entities.HR.VergiPille>) ?? new();

        string PilleXulase(FinNex.Domain.Entities.HR.MaasParametrNovu nov)
        {
            var nP = vergiPilleleri.Where(x => x.Nov == nov).OrderBy(x => x.Sira).ToList();
            if (!nP.Any()) return "—";
            if (nP.Count == 1) return $"{nP[0].Faiz.ToString("G29")}%";
            return string.Join(" / ", nP.Select(x => $"{x.Faiz.ToString("G29")}%"));
        }

        bool Pilleli(FinNex.Domain.Entities.HR.MaasParametrNovu nov) =>
            vergiPilleleri.Count(x => x.Nov == nov) > 1;

        var rates = new[]
        {
            new{Lbl="Gəlir vergisi",     Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.GelirVergisiFaizi,                 Flat=(string?)null, Clr="#2d6cdf"},
            new{Lbl="DSMF (işçi)",       Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.DsmfFaizi,                         Flat=(string?)null, Clr="#7c5cbf"},
            new{Lbl="İşsizlik (işçi)",   Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.IssizlikSigortasiFaizi,             Flat="0.5%",        Clr="#d85a30"},
            new{Lbl="İTSS (işçi)",       Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.IcbariTibbiSigortaFaizi,            Flat=(string?)null, Clr="#1e9b6b"},
            new{Lbl="DSMF (işv.)",       Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.DsmfIsegoturenFaizi,                Flat=(string?)null, Clr="#e8b84b"},
            new{Lbl="İTSS (işv.)",       Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.IcbariTibbiSigortaIsegoturenFaizi,  Flat=(string?)null, Clr="#14a5a5"},
            new{Lbl="İşsizlik (işv.)",   Nov=FinNex.Domain.Entities.HR.MaasParametrNovu.IssizlikIsegoturenFaizi,            Flat="0.5%",        Clr="#8a93a8"},
        };
    }
    <div class="mth-rates">
        @foreach (var r in rates)
        {
            var isPilleli = Pilleli(r.Nov);
            var val = r.Flat ?? PilleXulase(r.Nov);
            <div class="mth-rate-card" title="@(isPilleli ? "Pilləli — parametr səhifəsinə bax" : "Flat dərəcə")">
                <div class="mth-rate-bar" style="background:@r.Clr"></div>
                <div style="flex:1;min-width:0;">
                    <div class="mth-rate-lbl">
                        @r.Lbl
                        @if (isPilleli)
                        {
                            <span style="font-size:8px;font-weight:700;background:rgba(99,102,241,.12);color:#6366f1;padding:1px 5px;border-radius:999px;margin-left:4px;letter-spacing:.3px;">PİLLƏLİ</span>
                        }
                    </div>
                    <div class="mth-rate-val" style="font-size:@(isPilleli ? "11px" : "13px");white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@val</div>
                </div>
            </div>
        }
        <a asp-area="HR" asp-controller="MaasParametri" asp-action="Index" class="mth-rate-card" style="text-decoration:none;color:inherit;border:1px dashed #d0d5dd;background:#f9fafb;display:flex;align-items:center;justify-content:center;gap:6px;font-size:11px;font-weight:600;color:#6366f1;">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Parametrləri idarə et
        </a>
    </div>

    @* ── Main form + table ────────────────────────────────────── *@
    @if (!isciList.Any())
    {
        <div class="mth-card">
            <div class="mth-empty">
                <div class="mth-empty-ico">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="mth-empty-title">Aktiv işçi tapılmadı</div>
            </div>
        </div>
    }
    else
    {
        <form id="mthForm" asp-area="HR" asp-controller="Maas" asp-action="TopluHesablaEt" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="il" value="@il"/>
            <input type="hidden" name="ay" value="@ay"/>

            <div class="mth-card">

                @* Toolbar *@
                <div class="mth-toolbar"
                     data-first-bracket-max="@firstBracketMax.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="mth-toolbar-left">
                        <label class="mth-chk-wrap">
                            <input type="checkbox" class="mth-checkbox" id="mthChkAll"/>
                            <span class="mth-chk-label">Hamısını seç</span>
                        </label>
                        <div class="mth-sel-chip" id="mthSelChip"></div>
                    </div>
                    <div class="mth-toolbar-center" style="flex:1;display:flex;justify-content:center;padding:0 12px;">
                        <div class="mth-search">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                <circle cx="6" cy="6" r="4.3" stroke="#8a93a8" stroke-width="1.3"/>
                                <path d="M9.2 9.2L12 12" stroke="#8a93a8" stroke-width="1.3" stroke-linecap="round"/>
                            </svg>
                            <input type="text" id="mthSearchBox" class="mth-search-input"
                                   placeholder="Ad və ya departament ilə axtar..." autocomplete="off" />
                            <button type="button" id="mthSearchClear" class="mth-search-clear" aria-label="Təmizlə" title="Təmizlə">×</button>
                        </div>
                    </div>
                    <div class="mth-toolbar-right">
                        <span style="font-size:12px;color:#8a93a8;font-weight:500;" id="mthIsciCount">@isciList.Count işçi</span>
                        @* "Seçilənləri Hesabla" düyməsi müvəqqəti gizlədilib — alt footer-dəki 'Hamısını Hesabla' eyni işi görür.
                           JS-in btnCalc-a ehtiyacı olduğu üçün DOM-da qalır (display:none). *@
                        <button type="button" id="mthBtnCalc" disabled class="mth-btn mth-btn--gold" style="display:none;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <rect x="1" y="1" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/>
                                <path d="M6.5 4v5M4 6.5h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                            </svg>
                            Seçilənləri Hesabla
                        </button>
                    </div>
                </div>

                @* ── Compact table with expandable details ────────── *@
                <div class="mth-table-wrap">
                    <table class="mth-table">
                        <thead>
                            <tr class="tr-cols">
                                <th class="col-chk"></th>
                                <th class="col-name left">Ad Soyad</th>
                                <th class="col-status center">Status</th>
                                <th class="col-bonus">+ Bonus</th>
                                <th class="col-cerime">− Cərimə</th>
                                <th class="col-esas">Əsas Maaş</th>
                                <th class="col-brut">
                                    <span style="color:#1e9b6b;">GROSS</span>
                                </th>
                                <th class="col-net">
                                    <span style="color:#c9900a;">NET MAAŞ</span>
                                </th>
                                <th class="col-expand center"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < isciList.Count; i++)
                            {
                                var isci    = isciList[i];
                                var teyin   = isci.IsciTeyinatlari.FirstOrDefault();
                                var dept    = teyin?.Departament?.Ad ?? "—";
                                var esas    = GetEsas(isci.Id);
                                var isDone  = hesablanmis.Contains(isci.Id);
                                var hasIban = !string.IsNullOrEmpty(GetIban(isci.Id));

                                @* ── Main row ──────────────────────────────── *@
                                decimal isciGuzestMebleg = 0m;
                                string isciGuzestAd = "";
                                var _igMap = ViewBag.IsciGuzestMap as Dictionary<int, FinNex.Domain.Entities.HR.IsciGuzest>;
                                if (_igMap != null && _igMap.ContainsKey(isci.Id))
                                {
                                    var _ig = _igMap[isci.Id];
                                    if (_ig != null && _ig.Guzest != null)
                                    {
                                        isciGuzestMebleg = _ig.Guzest.Mebleg;
                                        isciGuzestAd = _ig.Guzest.Ad ?? "";
                                    }
                                }
                                var isciGuzestMeblegStr = isciGuzestMebleg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                var isciGuzestAdParen = isciGuzestAd.Length > 0 ? "(" + isciGuzestAd + ")" : "";

                                decimal isciHys = 0m;
                                if (isciHysMap.ContainsKey(isci.Id))
                                    isciHys = isciHysMap[isci.Id];
                                var isciHysStr = isciHys.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

                                <tr data-isci="@isci.Id"
                                    data-esas="@esas.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-isci-guzest="@isciGuzestMeblegStr"
                                    data-isci-guzest-ad="@isciGuzestAd"
                                    data-hys="@isciHysStr"
                                    class="mth-row @(isDone ? "done" : "")">

                                    @* Checkbox *@
                                    <td class="col-chk center">
                                        <input type="checkbox" class="mth-checkbox"
                                               @(isDone ? "disabled" : "")/>
                                        <input type="hidden" name="ferdiElaveler[@i].IsciId" value="@isci.Id"/>
                                    </td>

                                    @* Ad Soyad + Dept *@
                                    <td class="col-name left">
                                        <div class="mth-name-cell">
                                            <div class="mth-name-primary">@isci.Ad @isci.Soyad</div>
                                            <div class="mth-name-dept">@dept</div>
                                        </div>
                                        @if (!hasIban)
                                        {
                                            <div class="mth-iban">
                                                <svg width="9" height="9" viewBox="0 0 9 9" fill="none">
                                                    <path d="M4.5 1L8.5 8H.5L4.5 1z" stroke="#b45309" stroke-width=".9" stroke-linejoin="round"/>
                                                    <path d="M4.5 3.5v2M4.5 6.5v.2" stroke="#b45309" stroke-width=".9" stroke-linecap="round"/>
                                                </svg>
                                                IBAN yoxdur
                                            </div>
                                        }
                                    </td>

                                    @* Status *@
                                    <td class="col-status center">
                                        @if (isDone)
                                        {
                                            <span class="mth-badge mth-badge--done">Hesablanıb</span>
                                        }
                                        else
                                        {
                                            <span class="mth-badge mth-badge--new">Yeni</span>
                                        }
                                    </td>

                                    @* + Bonus *@
                                    <td class="col-bonus">
                                        <div class="mth-inp-wrap">
                                            <span class="mth-inp-pfx mth-inp-pfx--plus">+</span>
                                            <input type="number" class="mth-inp mth-inp--b"
                                                   name="ferdiElaveler[@i].BonusMeblegi"
                                                   min="0" step="0.01" placeholder="0.00"
                                                   @(isDone?"readonly":"")/>
                                        </div>
                                    </td>

                                    @* − Cərimə *@
                                    <td class="col-cerime">
                                        <div class="mth-inp-wrap">
                                            <span class="mth-inp-pfx mth-inp-pfx--minus">−</span>
                                            <input type="number" class="mth-inp mth-inp--c"
                                                   name="ferdiElaveler[@i].CerimeMeblegi"
                                                   min="0" step="0.01" placeholder="0.00"
                                                   @(isDone?"readonly":"")/>
                                        </div>
                                    </td>

                                    @* Əsas Maaş *@
                                    <td class="col-esas"><span class="n">@Fmt(esas)</span></td>

                                    @* GROSS (real-time) *@
                                    <td class="col-brut">
                                        <span data-p="brut" class="n">—</span>
                                    </td>

                                    @* NET MAAŞ (real-time) *@
                                    <td class="col-net">
                                        <span data-p="net" class="n n--au">—</span>
                                    </td>

                                    @* Expand button *@
                                    <td class="col-expand center">
                                        <button type="button" class="mth-expand-btn" data-tip="Ətraflı məlumat">
                                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>

                                @* ── Expandable detail panel ───────────────── *@
                                <tr class="mth-detail-row" data-detail-for="@isci.Id">
                                    <td colspan="9">
                                        <div class="mth-detail-panel">
                                            <div class="mth-detail-grid">

                                                @* Məzuniyyət *@
                                                <div class="mth-detail-card">
                                                    <div class="mth-detail-card-head">
                                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                            <rect x="1.5" y="2" width="11" height="10" rx="1.5" stroke="#2d6cdf" stroke-width="1.2"/>
                                                            <path d="M1.5 5h11M4.5 2v2M9.5 2v2" stroke="#2d6cdf" stroke-width="1" stroke-linecap="round"/>
                                                        </svg>
                                                        <span>Məzuniyyət</span>
                                                    </div>
                                                    <div class="mth-detail-card-body">
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Gün sayı</span>
                                                            <span class="n n--d" data-p="mezgun">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Ödəniş</span>
                                                            <span class="n n--b" data-p="mez">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Kəsinti</span>
                                                            <span class="n n--r" data-p="mezkes">—</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* Vergi güzəşti (standart + işçi) *@
                                                <div class="mth-detail-card">
                                                    <div class="mth-detail-card-head">
                                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                            <path d="M7 1.5v11M4 5l3-3.5L10 5" stroke="#1e9b6b" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                        <span>Vergi güzəşti</span>
                                                    </div>
                                                    <div class="mth-detail-card-body">
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Standart <small style="opacity:.6">(brüt ≤ @firstBracketMax.ToString("N0"))</small></span>
                                                            <span class="n n--g" data-p="standartguzest">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">
                                                                İşçi güzəşti
                                                                <small style="opacity:.7">@isciGuzestAdParen</small>
                                                            </span>
                                                            <span class="n n--g" data-p="isciguzest">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Vergilənəcək</span>
                                                            <span class="n n--au" data-p="vergilenecek">—</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* İşçi tutulmaları *@
                                                <div class="mth-detail-card mth-detail-card--wide">
                                                    <div class="mth-detail-card-head">
                                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                            <circle cx="7" cy="7" r="5.5" stroke="#d85a30" stroke-width="1.2"/>
                                                            <path d="M7 4.5v3M7 9v.5" stroke="#d85a30" stroke-width="1.2" stroke-linecap="round"/>
                                                        </svg>
                                                        <span>İşçi tutulmaları</span>
                                                        <span class="mth-rate-hint" style="margin-left:auto;font-size:9px;color:#6366f1;font-weight:700;">PİLLƏLİ</span>
                                                    </div>
                                                    <div class="mth-detail-card-body mth-detail-card-body--row">
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">Gəlir V.</span>
                                                            <span class="n n--r" data-p="gelirv">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">DSMF</span>
                                                            <span class="n n--p" data-p="dsmf">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">İşsizlik <span class="mth-rate-hint">0.5%</span></span>
                                                            <span class="n" data-p="issizlik">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">İTSS</span>
                                                            <span class="n" data-p="itss">—</span>
                                                        </div>
                                                        <div class="mth-detail-sep"></div>
                                                        <div class="mth-detail-item mth-detail-item--total">
                                                            <span class="mth-detail-lbl">Cəmi tutulma</span>
                                                            <span class="n n--r" data-p="tutulma">—</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* HYS (Həyat Yığım Sığortası) *@
                                                @if (isciHys > 0)
                                                {
                                                    <div class="mth-detail-card">
                                                        <div class="mth-detail-card-head" style="color:#0d9488;">
                                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                                <path d="M7 1.5v11M4 5l3-3.5L10 5" stroke="#0d9488" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                                            </svg>
                                                            <span>HYS</span>
                                                        </div>
                                                        <div class="mth-detail-card-body">
                                                            <div class="mth-detail-item">
                                                                <span class="mth-detail-lbl">İşçi payı</span>
                                                                <span class="n n--r" data-p="hysisci">—</span>
                                                            </div>
                                                            <div class="mth-detail-item">
                                                                <span class="mth-detail-lbl">İşəgötürən <span class="mth-rate-hint">@hysIsvFaiz.ToString("G29")%</span></span>
                                                                <span class="n n--p" data-p="hysisv">—</span>
                                                            </div>
                                                            <div class="mth-detail-item">
                                                                <span class="mth-detail-lbl">Vergi bazası (HYS sonrası)</span>
                                                                <span class="n n--au" data-p="vergibazasi">—</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                @* Şirkət xərcləri *@
                                                <div class="mth-detail-card">
                                                    <div class="mth-detail-card-head mth-detail-card-head--purple">
                                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                            <rect x="2" y="5" width="10" height="7" rx="1" stroke="#7c5cbf" stroke-width="1.2"/>
                                                            <path d="M4.5 5V3.5a2.5 2.5 0 015 0V5" stroke="#7c5cbf" stroke-width="1.2" stroke-linecap="round"/>
                                                        </svg>
                                                        <span>Şirkət xərcləri</span>
                                                    </div>
                                                    <div class="mth-detail-card-body">
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">DSMF işv.</span>
                                                            <span class="n n--p" data-p="dsmfisv">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">İTSS işv.</span>
                                                            <span class="n n--p" data-p="itssisv">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">İşsizlik işv. <span class="mth-rate-hint">0.5%</span></span>
                                                            <span class="n" data-p="issizlikisv">—</span>
                                                        </div>
                                                        <div class="mth-detail-item">
                                                            <span class="mth-detail-lbl">HYS işv.</span>
                                                            <span class="n n--p" data-p="hysisv2">—</span>
                                                        </div>
                                                        <div class="mth-detail-sep"></div>
                                                        <div class="mth-detail-item mth-detail-item--total">
                                                            <span class="mth-detail-lbl">Ümumi</span>
                                                            <span class="n n--p" data-p="sirketcemi">—</span>
                                                        </div>
                                                    </div>
                                                </div>

                                                @* Fərdi hesabla link *@
                                                <div class="mth-detail-card mth-detail-card--action">
                                                    <a asp-area="HR" asp-controller="Maas" asp-action="Hesabla"
                                                       asp-route-isciId="@isci.Id"
                                                       class="mth-btn mth-btn--outline mth-btn--detail-link">
                                                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                            <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                                        </svg>
                                                        Fərdi hesabla
                                                    </a>
                                                </div>

                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                        @* ── Cəmi sətri ────────────────────────────────── *@
                        <tfoot>
                            <tr>
                                <td class="left" colspan="5" style="font-weight:700;font-size:12px;color:#3d4557;padding:11px 10px;">
                                    CƏMİ — @isciList.Count işçi
                                </td>
                                <td><span class="n">@Fmt(isciList.Sum(x=>GetEsas(x.Id)))</span></td>
                                <td><span class="n" id="mthFootBrutTable">—</span></td>
                                <td><span class="n n--au" id="mthFootNet">— ₼</span></td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @* ── Footer (sticky — həmişə görünür) ─────────── *@
                <div class="mth-footer mth-footer--sticky">
                    <div class="mth-footer-left">
                        <strong id="mthFootSayi">0</strong> işçi seçilib ·
                        <span style="color:#1e9b6b;">@doneSayi hesablanıb</span> ·
                        <span style="color:#2d6cdf;">@yeniSayi yeni</span>
                    </div>

                    @* İki qrup: İşçi tərəfi + Şirkət tərəfi *@
                    <div class="mth-foot-groups">

                        @* ── QRUP 1: İşçi tərəfi (hər biri ayrıca) ── *@
                        <div class="mth-foot-grp mth-foot-grp--isci">
                            <div class="mth-foot-grp-title">
                                <svg width="11" height="11" viewBox="0 0 14 14" fill="none">
                                    <circle cx="7" cy="4" r="2.5" stroke="currentColor" stroke-width="1.3"/>
                                    <path d="M2 12c0-2.5 2-4 5-4s5 1.5 5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                                </svg>
                                İşçi tərəfi (tutulmalar)
                            </div>
                            <div class="mth-foot-grp-body">
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">Gross</span>
                                    <span class="mth-ftotal-val" id="mthFootBrut">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">Gəlir V.</span>
                                    <span class="mth-ftotal-val" id="mthFootGelirV">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">DSMF</span>
                                    <span class="mth-ftotal-val" id="mthFootDsmfIsci">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">İşsizlik</span>
                                    <span class="mth-ftotal-val" id="mthFootIssizlikIsci">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">İTSS</span>
                                    <span class="mth-ftotal-val" id="mthFootItssIsci">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">HYS</span>
                                    <span class="mth-ftotal-val" id="mthFootHysIsci">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">Cəmi tutulma</span>
                                    <span class="mth-ftotal-val" style="color:#d85a30;font-weight:800;" id="mthFootTutulma">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">NET (əlinə)</span>
                                    <span class="mth-ftotal-val mth-ftotal-val--net" id="mthFootNet2">— ₼</span>
                                </div>
                            </div>
                        </div>

                        @* ── QRUP 2: Şirkət tərəfi (hər biri ayrıca) ── *@
                        <div class="mth-foot-grp mth-foot-grp--sirket">
                            <div class="mth-foot-grp-title">
                                <svg width="11" height="11" viewBox="0 0 14 14" fill="none">
                                    <rect x="2" y="3" width="10" height="9" rx="1" stroke="currentColor" stroke-width="1.3"/>
                                    <path d="M5 6h1M8 6h1M5 8h1M8 8h1" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                                </svg>
                                Şirkət tərəfi (işəgötürən payı)
                            </div>
                            <div class="mth-foot-grp-body">
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">DSMF</span>
                                    <span class="mth-ftotal-val" id="mthFootDsmfIsv">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">İşsizlik</span>
                                    <span class="mth-ftotal-val" id="mthFootIssizlikIsv">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">İTSS</span>
                                    <span class="mth-ftotal-val" id="mthFootItssIsv">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">HYS</span>
                                    <span class="mth-ftotal-val" id="mthFootHysIsv">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">Cəmi əlavə</span>
                                    <span class="mth-ftotal-val" style="color:#7c3aed;font-weight:800;" id="mthFootSirketEx">— ₼</span>
                                </div>
                                <div class="mth-footer-div"></div>
                                <div class="mth-ftotal">
                                    <span class="mth-ftotal-lbl">Ümumi Xərc</span>
                                    <span class="mth-ftotal-val mth-ftotal-val--sirket" id="mthFootSirket">— ₼</span>
                                </div>
                            </div>
                        </div>

                        <div class="mth-footer-actions">
                            <a asp-area="HR" asp-controller="Maas" asp-action="Index"
                               asp-route-il="@il" asp-route-ay="@ay"
                               class="mth-btn mth-btn--outline">Ləğv et</a>
                            <button type="button" id="mthBtnCalc2" disabled class="mth-btn mth-btn--gold"
                                    onclick="document.getElementById('mthBtnCalc').click()">
                                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                    <path d="M6.5 1.5v10M1.5 6.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                                Hamısını Hesabla
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    }

</div>

@* ── Confirm modal ────────────────────────────────────────────── *@
<div class="mth-overlay" id="mthOverlay">
    <div class="mth-modal">
        <div class="mth-modal-head">
            <div class="mth-modal-ico">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <rect x="2" y="2" width="18" height="18" rx="3" stroke="#c9900a" stroke-width="1.5"/>
                    <path d="M11 7v5M11 14v.5" stroke="#c9900a" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <div class="mth-modal-title">Toplu hesablamanı təsdiqlə</div>
                <div class="mth-modal-sub">Seçilmiş işçilər üçün maaş hesablanacaq. Davam edirsiniz?</div>
            </div>
        </div>
        <div class="mth-modal-body">
            <div class="mth-modal-grid">
                <div class="mth-modal-item">
                    <span class="mth-modal-lbl">İşçi sayı</span>
                    <span class="mth-modal-val" id="mthMIsci">—</span>
                </div>
                <div class="mth-modal-item">
                    <span class="mth-modal-lbl">Ümumi Gross</span>
                    <span class="mth-modal-val mth-modal-val--au" id="mthMBrut">—</span>
                </div>
                <div class="mth-modal-item">
                    <span class="mth-modal-lbl">Ümumi NET</span>
                    <span class="mth-modal-val mth-modal-val--g" id="mthMNet">—</span>
                </div>
                <div class="mth-modal-item">
                    <span class="mth-modal-lbl">Bonus cəmi</span>
                    <span class="mth-modal-val" id="mthMBonus">—</span>
                </div>
            </div>
        </div>
        <div class="mth-modal-foot">
            <button type="button" id="mthBtnNo"  class="mth-btn mth-btn--outline">Ləğv et</button>
            <button type="button" id="mthBtnOk"  class="mth-btn mth-btn--gold">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M2 6l2.5 2.5 5.5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Hesablamanı Başlat
            </button>
        </div>
    </div>
</div>

@section Scripts {
    @* Pilləli vergi konfiqurasiyası (JS-ə ötürülür) *@
    <script type="application/json" id="mthVergiConfig">@Html.Raw(pilleConfigJson)</script>
    <script>
        function mthNav() {
            const il = document.getElementById('mthIl').value;
            const ay = document.getElementById('mthAy').value;
            location.href = '@Url.Action("TopluHesabla","Maas",new{area="HR"})?il=' + il + '&ay=' + ay;
        }
        document.addEventListener('DOMContentLoaded', () => {
            const b1 = document.getElementById('mthBtnCalc');
            const b2 = document.getElementById('mthBtnCalc2');
            if (b1 && b2) new MutationObserver(() => b2.disabled = b1.disabled)
                            .observe(b1, {attributes:true, attributeFilter:['disabled']});
        });
    </script>
    <script src="~/js/maas-toplu.js" asp-append-version="true"></script>
}
