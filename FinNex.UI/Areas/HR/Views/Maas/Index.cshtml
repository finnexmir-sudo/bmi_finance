@model List<FinNex.Domain.Entities.HR.Maas>
@using FinNex.Domain.Entities.HR

@{
    ViewData["Title"] = "Maaşlar";
    Layout = "_HRLayout";
    var aylar = new[] { "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun", "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
}

@if (TempData["Success"] != null)
{
    <div class="toast-success" id="toastSuccess">
        <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
    </div>
}

<div class="page-header">
    <div>
        <h2 class="page-title">Maaş Hesablamaları</h2>
        <div class="page-sub">Aylıq maaş siyahısı</div>
    </div>
    <a asp-area="HR" asp-controller="Maas" asp-action="Create" class="btn btn-primary hr-btn-add">
        <i class="bi bi-plus-lg"></i> Yeni Maaş
    </a>
</div>

<!-- Filtr Barı -->
<div class="card-soft mb-3" style="padding: 1rem 1.25rem;">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label mb-1 small fw-semibold">İl</label>
            <select name="il" class="form-select form-select-sm" style="min-width:90px">
                @for (int y = DateTime.Today.Year; y >= 2020; y--)
                {
                    <option value="@y" @(y == (int)(ViewBag.Il ?? DateTime.Today.Year) ? "selected" : "")>@y</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Ay</label>
            <select name="ay" class="form-select form-select-sm" style="min-width:130px">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" @(m == (int)(ViewBag.Ay ?? DateTime.Today.Month) ? "selected" : "")>@aylar[m - 1]</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label mb-1 small fw-semibold">Status</label>
            <select name="status" class="form-select form-select-sm" style="min-width:140px">
                <option value="">Hamısı</option>
                <option value="1" @(ViewBag.Status?.ToString() == "1" ? "selected" : "")>Layihə</option>
                <option value="2" @(ViewBag.Status?.ToString() == "2" ? "selected" : "")>Təsdiqəldi</option>
                <option value="3" @(ViewBag.Status?.ToString() == "3" ? "selected" : "")>Ödənildi</option>
                <option value="4" @(ViewBag.Status?.ToString() == "4" ? "selected" : "")>Ləğv Edildi</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-funnel"></i> Filtr
            </button>
            <a asp-action="Index" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-x"></i>
            </a>
        </div>
    </form>
</div>

<div class="card-soft">
    <div class="table-responsive">
        <table class="table table-hover align-middle custom-table">
            <thead>
                <tr>
                    <th>İşçi</th>
                    <th>Dövr</th>
                    <th>Hesablanma Tarixi</th>
                    <th>Net Məbləğ</th>
                    <th>Status</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-cash-coin fs-4 d-block mb-2"></i>
                            Göstəriləcək maaş tapilmadı
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    @{
                        var (badgeClass, badgeText) = item.Status switch
                        {
                            MaasStatus.Layihe => ("bg-warning text-dark", "Layihə"),
                            MaasStatus.Tesdiqlendi => ("bg-primary text-white", "Təsdiqəldi"),
                            MaasStatus.Odenildi => ("bg-success text-white", "Ödənildi"),
                            MaasStatus.LegvEdildi => ("bg-danger text-white", "Ləğv Edildi"),
                            _ => ("bg-secondary text-white", item.Status.ToString())
                        };
                    }
                    <tr>
                        <td>
                            <div class="emp-info">
                                <div class="emp-avatar">@item.Isci?.Ad?.Substring(0, 1)</div>
                                <div>
                                    <div class="emp-name">@item.Isci?.TamAd</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold">@aylar[item.Ay - 1]</span>
                            <span class="text-muted"> @item.Il</span>
                        </td>
                        <td>@item.HesablanmaTarixi.ToString("dd.MM.yyyy")</td>
                        <td class="fw-bold">@item.NetMebleg.ToString("N2") ₼</td>
                        <td>
                            <span class="badge @badgeClass px-3 py-1 rounded-pill">@badgeText</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@item.Id" class="action-icon" title="Bax">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
