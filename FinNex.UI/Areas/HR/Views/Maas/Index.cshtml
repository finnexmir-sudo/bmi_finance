@using FinNex.UI.Areas.HR.ViewModels
@model MaasIndexVM
@{
    ViewData["Title"] = "Maaşlar";
    Layout = "~/Areas/HR/Views/Shared/_HRLayout.cshtml";

    ViewData["FilterBar_Action"]      = "Index";
    ViewData["FilterBar_ShowSearch"]  = true;
    ViewData["FilterBar_ShowDept"]    = true;
    ViewData["FilterBar_ShowDate"]    = false;
    ViewData["FilterBar_ShowStatus"]  = false;
    ViewData["FilterBar_SearchTerm"]  = Model.SearchTerm;
    ViewData["FilterBar_SobeFilter"]  = Model.SobeFilter;
    ViewData["FilterBar_DeptOptions"] = Model.SobeLer;
    ViewData["FilterBar_AddUrl"]      = Url.Action("Create");
    ViewData["FilterBar_AddLabel"]    = "Maaş Hesabla";

    ViewData["Pagination_CurrentPage"] = Model.CurrentPage;
    ViewData["Pagination_TotalPages"]  = Model.TotalPages;
    ViewData["Pagination_Action"]      = "Index";

    string[] months = { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
                         "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
}

<div class="page-container">

    <!-- Page Header -->
    <div class="mod-page-header">
        <div>
            <h1 class="mod-page-title">
                <i class="bi bi-cash-stack title-icon title-icon-purple"></i>
                Maaş İdarəetməsi
            </h1>
            <p class="mod-page-subtitle">İşçilərin aylıq maaş hesablamalarını idarə edin</p>
        </div>
        <!-- Month/Year quick filter -->
        <div class="maas-period-filter">
            <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                <input type="hidden" name="SobeFilter" value="@Model.SobeFilter" />
                <select name="AyFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">Bütün aylar</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.AyFilter == m)">@months[m]</option>
                    }
                </select>
                <select name="IlFilter" class="filter-select" onchange="this.form.submit()">
                    <option value="">Bütün illər</option>
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
                    {
                        <option value="@y" selected="@(Model.IlFilter == y)">@y</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Stats -->
    <div class="mod-stats-grid">
        <div class="mod-stat-card mod-stat-purple">
            <div class="mod-stat-ico"><i class="bi bi-cash-stack"></i></div>
            <div class="mod-stat-body">
                <div class="mod-stat-val mod-stat-val-sm">@Model.UmumiMaas.ToString("N2") ₼</div>
                <div class="mod-stat-lbl">Ümumi Maaş</div>
            </div>
        </div>
        <div class="mod-stat-card mod-stat-green">
            <div class="mod-stat-ico"><i class="bi bi-plus-circle-fill"></i></div>
            <div class="mod-stat-body">
                <div class="mod-stat-val mod-stat-val-sm">+@Model.UmumiElave.ToString("N2") ₼</div>
                <div class="mod-stat-lbl">Əlavələr</div>
            </div>
        </div>
        <div class="mod-stat-card mod-stat-red">
            <div class="mod-stat-ico"><i class="bi bi-dash-circle-fill"></i></div>
            <div class="mod-stat-body">
                <div class="mod-stat-val mod-stat-val-sm">-@Model.UmumiCerime.ToString("N2") ₼</div>
                <div class="mod-stat-lbl">Cərimələr</div>
            </div>
        </div>
        <div class="mod-stat-card mod-stat-blue">
            <div class="mod-stat-ico"><i class="bi bi-people-fill"></i></div>
            <div class="mod-stat-body">
                <div class="mod-stat-val">@Model.IsciSayi</div>
                <div class="mod-stat-lbl">İşçi Sayı</div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <partial name="_FilterBar" />

    <!-- Table -->
    <div class="mod-table-card">
        @if (Model.Items != null && Model.Items.Any())
        {
            <div class="mod-table-header">
                <span class="mod-table-count">
                    <strong>@Model.Items.Count()</strong> qeyd göstərilir
                </span>
            </div>
            <div class="table-responsive">
                <table class="mod-table">
                    <thead>
                        <tr>
                            <th>İşçi</th>
                            <th>Şöbə</th>
                            <th>Dövr</th>
                            <th>Əsas Maaş</th>
                            <th>Əlavə</th>
                            <th>Cərimə</th>
                            <th class="fw-bold">Ümumi</th>
                            <th class="text-end">Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="emp-cell">
                                        <div class="emp-av emp-av-purple">@item.IsciTamAd[..Math.Min(2, item.IsciTamAd.Length)].ToUpper()</div>
                                        <span class="emp-name">@item.IsciTamAd</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="dept-chip">@item.Sobe</span>
                                </td>
                                <td>
                                    <span class="period-chip">
                                        <i class="bi bi-calendar3"></i>
                                        @item.AyAd @item.Il
                                    </span>
                                </td>
                                <td>
                                    <span class="amount-base">@item.EsasMaas.ToString("N2") ₼</span>
                                </td>
                                <td>
                                    <span class="amount-plus">+@item.Elave.ToString("N2") ₼</span>
                                </td>
                                <td>
                                    <span class="amount-minus">-@item.Cerime.ToString("N2") ₼</span>
                                </td>
                                <td>
                                    <span class="amount-total fw-bold">@item.UmumiMaas.ToString("N2") ₼</span>
                                </td>
                                <td class="text-end">
                                    <div class="mod-action-btns">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="mod-btn-icon mod-btn-view" title="Bax">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="mod-btn-icon mod-btn-edit" title="Redaktə">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="mod-btn-icon mod-btn-delete"
                                                onclick="confirmDelete(@item.Id, '@item.IsciTamAd')"
                                                title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <!-- Total row -->
                    <tfoot>
                        <tr class="maas-total-row">
                            <td colspan="3"><strong>Cəmi</strong></td>
                            <td><strong>@Model.Items.Sum(x => x.EsasMaas).ToString("N2") ₼</strong></td>
                            <td><strong class="amount-plus">+@Model.Items.Sum(x => x.Elave).ToString("N2") ₼</strong></td>
                            <td><strong class="amount-minus">-@Model.Items.Sum(x => x.Cerime).ToString("N2") ₼</strong></td>
                            <td><strong class="amount-total">@Model.Items.Sum(x => x.UmumiMaas).ToString("N2") ₼</strong></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="mod-table-footer">
                <partial name="_Pagination" />
            </div>
        }
        else
        {
            {
                ViewData["EmptyState_Icon"]     = "bi-cash-coin";
                ViewData["EmptyState_Title"]    = "Maaş qeydi tapılmadı";
                ViewData["EmptyState_Sub"]      = "Seçilmiş filtrə uyğun heç bir maaş hesablaması yoxdur";
                ViewData["EmptyState_AddUrl"]   = Url.Action("Create");
                ViewData["EmptyState_AddLabel"] = "Maaş Hesabla";
            }
            <partial name="_EmptyState" />
        }
    </div>

</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content mod-modal">
            <div class="modal-header mod-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>Silmə Təsdiqi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0"><strong id="deleteEmpName"></strong> işçisinin maaş qeydi silinəcək.</p>
            </div>
            <div class="modal-footer mod-modal-footer">
                <button type="button" class="btn-mod-secondary" data-bs-dismiss="modal">Ləğv Et</button>
                <form id="deleteForm" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-mod-danger"><i class="bi bi-trash"></i> Sil</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/maas-list.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/hr-modules.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hr/maas-list.js" asp-append-version="true"></script>
    <script src="~/js/hr/hr-modules.js" asp-append-version="true"></script>
    <script>
        function confirmDelete(id, name) {
            document.getElementById('deleteEmpName').textContent = name;
            document.getElementById('deleteForm').action = '@Url.Action("Delete")/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}