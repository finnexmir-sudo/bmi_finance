@model IEnumerable<FinNex.Application.DTOs.HR.Maas.MaasListDto>
@using FinNex.Domain.Entities.HR
@using FinNex.Domain
@{
    ViewData["Title"] = $"Əmək Haqqı — {ViewBag.SecilmisIl}/{ViewBag.SecilmisAy:D2}";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var il   = (int)ViewBag.SecilmisIl;
    var ay   = (int)ViewBag.SecilmisAy;
    var list = Model.ToList();

    // Rol-əsaslı icazələr (iş axını: HR hesablayır → Rəhbər təsdiqləyir → Mühasib ödəyir)
    var isAdmin   = User.IsInRole(RoleNames.Admin);
    var isHR      = User.IsInRole(RoleNames.HR);
    var isRehber  = User.IsInRole(RoleNames.Rehber);
    var isMuhasib = User.IsInRole(RoleNames.Muhasib);
    var canHesabla      = isHR || isAdmin;              // Fərdi hesablama
    var canTopluHesabla = isHR || isMuhasib || isAdmin; // Toplu hesablama (Muhasib ilkin hesablama üçün)
    var canTesdiq       = isRehber || isAdmin;          // Layihe → Tesdiqlendi
    var canOdeme        = isMuhasib || isAdmin;         // Tesdiqlendi → Odenildi
    var canLegv         = isHR || isAdmin;              // Layihe → LegvEdildi

    // Toplu Hesabla düyməsinin görünmə şərti:
    //   - İstifadəçinin toplu hesablama icazəsi var
    //   - VƏ hələ hesablanmamış (və ya ləğv edilmiş) aktiv işçi qalıb
    var aktivIsciSayi = (int)(ViewBag.AktivIsciSayi ?? 0);
    var aktivHesablanmis = list.Count(x => x.Status != MaasStatus.LegvEdildi);
    var hesablanmamisVar = aktivHesablanmis < aktivIsciSayi;
    var showHesabla = canTopluHesabla && hesablanmamisVar;
    var canSil      = isHR || isAdmin;                  // Layihe statusunda silinə bilər

    decimal umumiNet      = list.Sum(x => x.NetMebleg);
    decimal umumiBrut     = list.Sum(x => x.BrutMaas);
    decimal umumiGelirV   = list.Sum(x => x.GelirVergisi);
    decimal umumiDsmf     = list.Sum(x => x.DsmfIsci);
    decimal umumiIssizlik = list.Sum(x => x.IssizlikIsci);
    decimal umumiItss     = list.Sum(x => x.Itss);
    decimal umumiBonus    = list.Sum(x => x.BonusMeblegi);
    decimal umumiOvertime = list.Sum(x => x.OvertimeMeblegi);
    decimal umumiCerime   = list.Sum(x => x.CerimeMeblegi);
    decimal umumiTutulma  = umumiGelirV + umumiDsmf + umumiIssizlik + umumiItss;

    int layiheSayi  = list.Count(x => x.Status == MaasStatus.Layihe);
    int tesdiqSayi  = list.Count(x => x.Status == MaasStatus.Tesdiqlendi);
    int odenisSayi  = list.Count(x => x.Status == MaasStatus.Odenildi);

    var ayAdlar = new[]{"","Yanvar","Fevral","Mart","Aprel","May","İyun","İyul","Avqust","Sentyabr","Oktyabr","Noyabr","Dekabr"};

    string BadgeClass(MaasStatus s) => s switch {
        MaasStatus.Layihe      => "mi-badge--wait",
        MaasStatus.Tesdiqlendi => "mi-badge--review",
        MaasStatus.Odenildi    => "mi-badge--done",
        MaasStatus.LegvEdildi  => "mi-badge--rejected",
        _ => "mi-badge--wait"
    };
    string BadgeText(MaasStatus s) => s switch {
        MaasStatus.Layihe      => "Layihə",
        MaasStatus.Tesdiqlendi => "Təsdiqləndi",
        MaasStatus.Odenildi    => "Ödənildi",
        MaasStatus.LegvEdildi  => "Ləğv edildi",
        _ => "Layihə"
    };
    string Fmt(decimal v) => v > 0 ? v.ToString("N2") : "—";
    string FmtC(decimal v, string prefix = "") =>
        v > 0 ? $"{prefix}{v:N2} ₼" : "—";
}

@section Styles {
    <link rel="stylesheet" href="~/css/maas-index.css" asp-append-version="true" />
}

<div class="mi-page">

    @* ── Alerts ──────────────────────────────────────────────── *@
    @* Success/Error _UserLayout.cshtml-də render olunur — burada təkrar etmirik. *@
    @if (TempData["Xetalar"] != null)
    {
        foreach (var x in TempData["Xetalar"]!.ToString()!.Split('|'))
        {
            <div class="mi-alert mi-alert--error">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <circle cx="8" cy="8" r="7" stroke="#d85a30" stroke-width="1.4"/>
                    <path d="M8 5v4M8 10.5v.5" stroke="#d85a30" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                @x
            </div>
        }
    }

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="mi-header">
        <div>
            <div class="mi-breadcrumb">
                <a asp-area="HR" asp-controller="Dashboard" asp-action="Index">HR İdarəetmə</a>
                <span class="mi-breadcrumb-sep">›</span>
                <span>Əmək Haqqı</span>
            </div>
            <div class="mi-title">Əmək Haqqı — @ayAdlar[ay] @il</div>
            <div class="mi-subtitle">
                @list.Count işçi &nbsp;·&nbsp;
                <span style="color:#e8b84b;font-weight:600;">@layiheSayi layihə</span> &nbsp;·&nbsp;
                <span style="color:#2d6cdf;font-weight:600;">@tesdiqSayi təsdiqləndi</span> &nbsp;·&nbsp;
                <span style="color:#1e9b6b;font-weight:600;">@odenisSayi ödənildi</span>
            </div>
        </div>
        <div class="mi-header-actions">
            @if (canOdeme)
            {
                <a asp-area="HR" asp-controller="Maas" asp-action="BankFayliYukle"
                   asp-route-il="@il" asp-route-ay="@ay"
                   class="mi-btn mi-btn--outline">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <path d="M6.5 2v6M4 6l2.5 2.5L9 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M1.5 9.5v1a.5.5 0 00.5.5h9a.5.5 0 00.5-.5v-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                    Bank Faylı (CSV)
                </a>
                <a asp-area="HR" asp-controller="Maas" asp-action="BankKocurme"
                   asp-route-il="@il" asp-route-ay="@ay"
                   class="mi-btn mi-btn--outline">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <rect x="1.5" y="3" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1.5 5.5h10" stroke="currentColor" stroke-width="1.2"/>
                        <circle cx="4" cy="8" r="0.8" fill="currentColor"/>
                    </svg>
                    Bank Köçürmə Faylı
                </a>
            }
            @if (canTopluHesabla)
            {
                <a asp-area="HR" asp-controller="Maas" asp-action="PravodkaExport"
                   asp-route-il="@il" asp-route-ay="@ay"
                   class="mi-btn mi-btn--outline" title="Seçilmiş ay üzrə əmək haqqı əməliyyat yazılışı (.xls)">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <rect x="1.5" y="1.5" width="10" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M4 4.5h5M4 6.5h5M4 8.5h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                    Əməliyyat yazılışı (.xls)
                </a>
            }
            @if (showHesabla)
            {
                var qalanSayi = aktivIsciSayi - aktivHesablanmis;
                <a asp-area="HR" asp-controller="Maas" asp-action="TopluHesabla"
                   asp-route-il="@il" asp-route-ay="@ay"
                   class="mi-btn mi-btn--outline" title="@qalanSayi işçi hələ hesablanmayıb">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <rect x="1" y="1" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/>
                        <path d="M6.5 4v5M4 6.5h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    Toplu Hesabla (@qalanSayi)
                </a>
            }
            @if (canHesabla)
            {
                <a asp-area="HR" asp-controller="Maas" asp-action="Hesabla"
                   class="mi-btn mi-btn--gold">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <path d="M6.5 1.5v10M1.5 6.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                    Fərdi Hesabla
                </a>
            }
        </div>
    </div>

    @* ── Stats ────────────────────────────────────────────────── *@
    <div class="mi-stats">
        <div class="mi-stat mi-stat--blue">
            <div class="mi-stat-label">Ümumi İşçi</div>
            <div class="mi-stat-value">@list.Count</div>
            <div class="mi-stat-sub">@ayAdlar[ay] @il</div>
        </div>
        <div class="mi-stat mi-stat--gold">
            <div class="mi-stat-label">Ümumi Gross</div>
            <div class="mi-stat-value">@umumiBrut.ToString("N0") ₼</div>
            <div class="mi-stat-sub">Bonus daxil</div>
        </div>
        <div class="mi-stat mi-stat--orange">
            <div class="mi-stat-label">Ümumi Tutulma</div>
            <div class="mi-stat-value">@umumiTutulma.ToString("N0") ₼</div>
            <div class="mi-stat-sub">Vergi + DSMF + İTSS</div>
        </div>
        <div class="mi-stat mi-stat--green">
            <div class="mi-stat-label">Ümumi NET</div>
            <div class="mi-stat-value">@umumiNet.ToString("N0") ₼</div>
            <div class="mi-stat-sub">Əldə edilən</div>
        </div>
        <div class="mi-stat mi-stat--purple">
            <div class="mi-stat-label">Ödənildi</div>
            <div class="mi-stat-value">@odenisSayi / @list.Count</div>
            <div class="mi-stat-sub">İşçi</div>
        </div>
    </div>

    @* ── Filter Bar ───────────────────────────────────────────── *@
    <form id="miFilterForm" asp-area="HR" asp-controller="Maas" asp-action="Index" method="get">
        <div class="mi-filter-bar">
            <span class="mi-filter-label">Filtr</span>
            <select name="il" class="mi-select mi-auto-filter">
                @foreach (var item in ViewBag.Iller as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>

            <select name="ay" class="mi-select mi-auto-filter">
                @foreach (var item in ViewBag.Aylar as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>

            <div class="mi-filter-sep"></div>

            @* Tam mətn axtarışı — client-side table filtri *@
            <div class="mi-search-wrap">
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" style="position:absolute;left:11px;top:50%;transform:translateY(-50%);pointer-events:none;color:#8a93a8;">
                    <circle cx="5.5" cy="5.5" r="3.5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M8.5 8.5l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                <input type="text" id="miQuickSearch" class="mi-search-input"
                       placeholder="Ad, soyad, departament, vəzifə ilə axtar..."
                       autocomplete="off"/>
                <button type="button" id="miClearSearch" class="mi-search-clear" title="Təmizlə" style="display:none;">&times;</button>
            </div>

            <div class="mi-filter-sep"></div>

            <select name="isciId" class="mi-select mi-select--wide mi-auto-filter">
                <option value="">— Bütün işçilər</option>
                @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>

            <select name="departamentId" class="mi-select mi-select--wide mi-auto-filter">
                <option value="">— Bütün departamentlər</option>
                @foreach (var item in ViewBag.Departamentler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                {
                    if (item.Selected)
                    {
                        <option value="@item.Value" selected>@item.Text</option>
                    }
                    else
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
            <div class="mi-filter-actions">
                <a asp-area="HR" asp-controller="Maas" asp-action="Index"
                   class="mi-btn mi-btn--outline mi-btn--sm">Sıfırla</a>
            </div>
        </div>
    </form>

    @* ── Table Card ───────────────────────────────────────────── *@
    <div class="mi-table-card">

        @* Prominent period chip — dövrü aydın göstərir *@
        <div class="mi-period-chip">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <rect x="1.5" y="2.5" width="11" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M1.5 5.5h11M4 1.5v2M10 1.5v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            <span class="mi-period-chip-lbl">Hesablama dövrü:</span>
            <span class="mi-period-chip-val">@ayAdlar[ay] @il</span>
            <span class="mi-period-chip-sep">·</span>
            <span class="mi-period-chip-count">@list.Count qeyd</span>
        </div>

        <div class="mi-toolbar">
            <div class="mi-toolbar-left">
                <div class="mi-result-count"><span>@list.Count</span> nəticə</div>
                @{
                    var layiheliSayi = list.Count(x => x.Status == MaasStatus.Layihe);
                    var tesdiqliSayi = list.Count(x => x.Status == MaasStatus.Tesdiqlendi);
                    var legvSayi     = list.Count(x => x.Status == MaasStatus.LegvEdildi);
                }
                @if (canTopluHesabla && legvSayi > 0 && layiheliSayi == 0 && tesdiqliSayi == 0)
                {
                    <a asp-area="HR" asp-controller="Maas" asp-action="TopluHesabla"
                       asp-route-il="@il" asp-route-ay="@ay"
                       class="mi-btn mi-btn--gold mi-btn--sm" style="margin-left:12px;">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M6.5 1.5v10M1.5 6.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        Yenidən Hesabla
                    </a>
                }
                @if (canTesdiq && layiheliSayi > 0)
                {
                    <form asp-area="HR" asp-controller="Maas" asp-action="TopluTesdiqle"
                          method="post" style="display:inline;margin-left:12px;"
                          onsubmit="return confirm('@layiheliSayi layihə statuslu maaşı təsdiqləmək istədiyinizə əminsiniz? Bu əməliyyat geri alına bilməz.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="il" value="@il"/>
                        <input type="hidden" name="ay" value="@ay"/>
                        <button type="submit" class="mi-btn mi-btn--green mi-btn--sm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 6.5l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            Hamısını Təsdiqlə (@layiheliSayi)
                        </button>
                    </form>
                }
                @if (canTesdiq && layiheliSayi > 0)
                {
                    <button type="button" class="mi-btn mi-btn--sm mi-btn--orange" style="margin-left:8px;"
                            onclick="document.getElementById('geriGonderModal').style.display='flex'">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M2 6.5h7M6 3.5l-4 3 4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Geri Göndər (@layiheliSayi)
                    </button>

                    <div id="geriGonderModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:9999;align-items:center;justify-content:center;">
                        <div style="background:#1e2130;border:1px solid #2d3348;border-radius:12px;padding:28px 32px;width:420px;max-width:94vw;">
                            <div style="font-size:15px;font-weight:600;color:#e2e8f0;margin-bottom:6px;">Hesablamanı geri qaytır</div>
                            <div style="font-size:13px;color:#8a93a8;margin-bottom:18px;">
                                @layiheliSayi layihə statuslu maaş ləğv ediləcək və mühasib yenidən hesablamağa dəvət ediləcək.
                            </div>
                            <form asp-area="HR" asp-controller="Maas" asp-action="TopluGeriGonder" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="il" value="@il"/>
                                <input type="hidden" name="ay" value="@ay"/>
                                <label style="font-size:12px;color:#8a93a8;display:block;margin-bottom:6px;">Səbəb (istəyə bağlı)</label>
                                <textarea name="sebeb" rows="3"
                                    placeholder="Nə yenidən hesablanmalıdır?..."
                                    style="width:100%;box-sizing:border-box;background:#131722;border:1px solid #2d3348;border-radius:8px;color:#e2e8f0;font-size:13px;padding:9px 12px;resize:vertical;outline:none;margin-bottom:16px;"></textarea>
                                <div style="display:flex;gap:8px;justify-content:flex-end;">
                                    <button type="button" class="mi-btn mi-btn--outline mi-btn--sm"
                                            onclick="document.getElementById('geriGonderModal').style.display='none'">Ləğv et</button>
                                    <button type="submit" class="mi-btn mi-btn--sm mi-btn--orange">
                                        Geri Göndər
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                @if (canLegv && layiheliSayi > 0)
                {
                    <form asp-area="HR" asp-controller="Maas" asp-action="TopluLegvEt"
                          method="post" style="display:inline;margin-left:8px;"
                          onsubmit="return confirm('@layiheliSayi layihə statuslu maaşın hamısını ləğv etmək istədiyinizə əminsiniz?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="il" value="@il"/>
                        <input type="hidden" name="ay" value="@ay"/>
                        <button type="submit" class="mi-btn mi-btn--outline mi-btn--sm" style="color:#dc2626;border-color:#dc2626;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 2l9 9M11 2l-9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                            Hamısını Ləğv Et (@layiheliSayi)
                        </button>
                    </form>
                }
                @if (canOdeme && tesdiqliSayi > 0)
                {
                    <form asp-area="HR" asp-controller="Maas" asp-action="TopluOdenis"
                          method="post" style="display:inline;margin-left:8px;"
                          onsubmit="return confirm('@tesdiqliSayi təsdiqlənmiş maaşı Ödənildi işarələmək istədiyinizə əminsiniz? Bank köçürməsi artıq aparılmış olmalıdır.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="il" value="@il"/>
                        <input type="hidden" name="ay" value="@ay"/>
                        <button type="submit" class="mi-btn mi-btn--green mi-btn--sm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <rect x="1" y="2.5" width="11" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                                <path d="M1 5h11" stroke="currentColor" stroke-width="1.3"/>
                                <circle cx="4" cy="8" r="0.8" fill="currentColor"/>
                            </svg>
                            Ödəniş Et (@tesdiqliSayi)
                        </button>
                    </form>
                }
            </div>
            <div class="mi-toolbar-right">
                @if (list.Any())
                {
                    <a asp-area="HR" asp-controller="Maas" asp-action="BankFayliYukle"
                       asp-route-il="@il" asp-route-ay="@ay"
                       class="mi-btn mi-btn--outline mi-btn--sm">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M2 1.5h6l3 3v7H2z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M8 1.5v3h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Excel İxrac
                    </a>
                }
            </div>
        </div>

        @if (!list.Any())
        {
            <div class="mi-empty">
                <div class="mi-empty-ico">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="mi-empty-title">Bu dövr üçün maaş tapılmadı</div>
                <div class="mi-empty-sub">Toplu hesablama aparın</div>
                @if (canTopluHesabla)
                {
                    <a asp-area="HR" asp-controller="Maas" asp-action="TopluHesabla"
                       asp-route-il="@il" asp-route-ay="@ay"
                       class="mi-btn mi-btn--gold" style="margin-top:4px;">Toplu Hesabla</a>
                }
            </div>
        }
        else
        {
            <div class="mi-scroll">
                <table class="mi-table">
                    <thead>
                        @* ── Qrup başlıqları ───────────────────────────────── *@
                        <tr class="tr-group">
                            <th colspan="1" class="grp-sts center">Status</th>
                            <th colspan="1" class="grp-sts center">Əməliyyat</th>
                            <th colspan="1" class="grp-isci left">İşçi</th>
                            <th colspan="4" class="grp-gelir">Gəlirlər</th>
                            <th colspan="1" class="grp-kesinti">Kəsinti</th>
                            <th colspan="4" class="grp-vergi">Tutulmalar (İşçi)</th>
                            <th colspan="2" class="grp-net">NET / Ödəniş</th>
                            <th colspan="2" class="grp-isci">Departament / Vəzifə</th>
                        </tr>
                        @* ── Sütun başlıqları ──────────────────────────────── *@
                        <tr class="tr-cols">
                            <th class="center" style="min-width:110px;">Status</th>
                            <th class="center col-sep" style="min-width:120px;">Əməliyyat</th>

                            <th class="left col-sep" style="min-width:200px;">Ad Soyad</th>

                            <th style="min-width:110px;">Əsas Maaş</th>
                            <th style="min-width:90px;">Bonus</th>
                            <th style="min-width:90px;">Overtime</th>
                            <th class="col-sep" style="min-width:110px;">Məzuniyyət Öd.</th>

                            <th class="col-sep" style="min-width:100px;">Cərimə</th>

                            <th style="min-width:110px;">Gəlir Vergisi<br><span style="font-size:8.5px;font-weight:500;color:#aab0bf;">pilləli</span></th>
                            <th style="min-width:90px;">DSMF<br><span style="font-size:8.5px;font-weight:500;color:#aab0bf;">pilləli</span></th>
                            <th style="min-width:100px;">İşsizlik<br><span style="font-size:8.5px;font-weight:500;color:#aab0bf;">0.5%</span></th>
                            <th class="col-sep" style="min-width:90px;">İTSS<br><span style="font-size:8.5px;font-weight:500;color:#aab0bf;">pilləli</span></th>

                            <th style="min-width:120px;">NET Maaş</th>
                            <th class="center col-sep" style="min-width:110px;">Ödəniş Tarixi</th>

                            <th class="left" style="min-width:120px;">Departament</th>
                            <th class="left" style="min-width:110px;">Vəzifə</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in list)
                        {
                            var hasIban = !string.IsNullOrEmpty(m.BankHesabNo);
                            var tutulma = m.GelirVergisi + m.DsmfIsci + m.IssizlikIsci + m.Itss;
                            var isLegv = false; // Ləğv edilmişlər artıq soft-delete olduğu üçün buraya çatmır
                            <tr class="mi-tr">
                                @* Status *@
                                <td class="center">
                                    <span class="mi-badge @BadgeClass(m.Status)">@BadgeText(m.Status)</span>
                                </td>

                                @* Əməliyyatlar *@
                                <td class="center col-sep">
                                    <div class="mi-actions">
                                        <a asp-area="HR" asp-controller="Maas" asp-action="Detal"
                                           asp-route-id="@m.Id"
                                           class="mi-act-btn mi-act-btn--blue" data-tip="Detal">
                                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                <path d="M1.5 6h9M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </a>
                                        <a asp-area="HR" asp-controller="Maas" asp-action="IsciTarixce"
                                           asp-route-isciId="@m.IsciId"
                                           class="mi-act-btn" data-tip="Tarixçə">
                                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.2"/>
                                                <path d="M6 3.5v3l1.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                                            </svg>
                                        </a>
                                        @if (m.Status == MaasStatus.Layihe && canTesdiq)
                                        {
                                            <button type="button" class="mi-act-btn mi-act-btn--green"
                                                    data-status-trigger
                                                    data-maas-id="@m.Id" data-yeni-status="Tesdiqlendi"
                                                    data-il="@il" data-ay="@ay" data-tip="Təsdiqlə (Rəhbər)">
                                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                    <path d="M2 6l2.5 2.5 5.5-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (m.Status == MaasStatus.Tesdiqlendi && canOdeme)
                                        {
                                            <button type="button" class="mi-act-btn mi-act-btn--green"
                                                    data-status-trigger
                                                    data-maas-id="@m.Id" data-yeni-status="Odenildi"
                                                    data-il="@il" data-ay="@ay" data-tip="Ödənildi (Mühasib)">
                                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                    <rect x="1" y="2.5" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                                                    <path d="M1 5.5h10" stroke="currentColor" stroke-width="1.2"/>
                                                    <circle cx="4" cy="8" r="1" fill="currentColor"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (m.Status == MaasStatus.Layihe && canLegv)
                                        {
                                            <button type="button" class="mi-act-btn mi-act-btn--red"
                                                    data-status-trigger
                                                    data-maas-id="@m.Id" data-yeni-status="LegvEdildi"
                                                    data-il="@il" data-ay="@ay" data-tip="Ləğv et">
                                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                    <path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                                                </svg>
                                            </button>
                                        }
                                        @if (m.Status == MaasStatus.Layihe && canSil)
                                        {
                                            <form asp-area="HR" asp-controller="Maas" asp-action="Sil"
                                                  method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id"  value="@m.Id"/>
                                                <input type="hidden" name="il"  value="@il"/>
                                                <input type="hidden" name="ay"  value="@ay"/>
                                                <button type="submit" class="mi-act-btn mi-act-btn--red"
                                                        data-delete-trigger data-ad="@m.IsciAdSoyad" data-tip="Sil">
                                                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                                        <path d="M2 3h8M4.5 3V2h3v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M3 3l.5 7h5L9 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>

                                @* İşçi adı *@
                                <td class="left col-sep">
                                    <div class="mi-emp-name">@m.IsciAdSoyad</div>
                                </td>

                                @* Gəlirlər *@
                                <td><span class="n @(isLegv ? "n--dim" : "")">@(isLegv ? "—" : Fmt(m.EsasMaas) + " ₼")</span></td>
                                <td>
                                    @if (!isLegv && m.BonusMeblegi > 0)
                                    { <span class="n n--green">+@m.BonusMeblegi.ToString("N2") ₼</span> }
                                    else
                                    { <span class="n n--dim">—</span> }
                                </td>
                                <td>
                                    @if (!isLegv && m.OvertimeMeblegi > 0)
                                    { <span class="n n--green">+@m.OvertimeMeblegi.ToString("N2") ₼</span> }
                                    else
                                    { <span class="n n--dim">—</span> }
                                </td>
                                <td class="col-sep">
                                    @if (!isLegv && m.MezuniyyetOdenisi > 0)
                                    { <span class="n n--blue">@m.MezuniyyetOdenisi.ToString("N2") ₼</span> }
                                    else if (!isLegv && m.AvansBrut > 0)
                                    {
                                        <span class="n n--blue" title="Brüt: @m.AvansBrut.ToString("N2") ₼">@m.AvansNet.ToString("N2") ₼</span>
                                        <span style="font-size:9px;color:#9ca3af;display:block">avans (NET)</span>
                                    }
                                    else
                                    { <span class="n n--dim">—</span> }
                                </td>

                                @* Kəsinti *@
                                <td class="col-sep">
                                    @if (!isLegv && m.CerimeMeblegi > 0)
                                    { <span class="n n--red">−@m.CerimeMeblegi.ToString("N2") ₼</span> }
                                    else
                                    { <span class="n n--dim">—</span> }
                                </td>

                                @* Tutulmalar (məzuniyyət avansı varsa birləşdirilmiş) *@
                                @if (!isLegv && m.AvansBrut > 0)
                                {
                                    <td title="Maaş: @Fmt(m.GelirVergisi) + Avans: @Fmt(m.AvansGelirVergisi)">
                                        <span class="n n--red">@Fmt(m.BirlesikGelirVergisi) ₼</span>
                                        <span style="font-size:9px;color:#9ca3af;display:block">maaş+avans</span>
                                    </td>
                                    <td title="Maaş: @Fmt(m.DsmfIsci) + Avans: @Fmt(m.AvansDsmfIsci)">
                                        <span class="n n--purple">@Fmt(m.BirlesikDsmfIsci) ₼</span>
                                        <span style="font-size:9px;color:#9ca3af;display:block">maaş+avans</span>
                                    </td>
                                    <td title="Maaş: @Fmt(m.IssizlikIsci) + Avans: @Fmt(m.AvansIssizlikIsci)">
                                        <span class="n">@Fmt(m.BirlesikIssizlik) ₼</span>
                                        <span style="font-size:9px;color:#9ca3af;display:block">maaş+avans</span>
                                    </td>
                                    <td class="col-sep" title="Maaş: @Fmt(m.Itss) + Avans: @Fmt(m.AvansItss)">
                                        <span class="n">@Fmt(m.BirlesikItss) ₼</span>
                                        <span style="font-size:9px;color:#9ca3af;display:block">maaş+avans</span>
                                    </td>
                                }
                                else
                                {
                                    <td><span class="n n--red">@(isLegv ? "—" : Fmt(m.GelirVergisi) + " ₼")</span></td>
                                    <td><span class="n n--purple">@(isLegv ? "—" : Fmt(m.DsmfIsci) + " ₼")</span></td>
                                    <td><span class="n">@(isLegv ? "—" : Fmt(m.IssizlikIsci) + " ₼")</span></td>
                                    <td class="col-sep"><span class="n">@(isLegv ? "—" : Fmt(m.Itss) + " ₼")</span></td>
                                }

                                @* NET *@
                                <td>
                                    <span class="n @(isLegv ? "n--dim" : "n--gold")">@(isLegv ? "—" : m.NetMebleg.ToString("N2") + " ₼")</span>
                                </td>

                                @* Ödəniş Tarixi *@
                                <td class="center col-sep">
                                    @if (m.OdenisTarixi.HasValue)
                                    {
                                        <span class="n" style="font-size:11.5px;color:#1e9b6b;font-weight:600;">@m.OdenisTarixi.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="n n--dim">—</span>
                                    }
                                </td>

                                @* Departament + Vəzifə (sona köçürüldü) *@
                                <td class="left"><span class="mi-emp-dept">@m.DepartamentAd</span></td>
                                <td class="left"><span class="mi-emp-dept">@m.VezifeAd</span></td>
                            </tr>
                        }
                    </tbody>

                    @* ── Cəmi sətri (mərkəzdə) ────────────────────────── *@
                    <tfoot>
                        <tr class="mi-tfoot-cemi">
                            <td colspan="2" class="center" style="font-weight:700;font-size:12px;color:#1a2332;">
                                CƏMİ
                            </td>
                            <td class="center col-sep" style="font-weight:700;font-size:12px;color:#1a2332;">
                                @list.Count işçi
                            </td>
                            <td class="center"><span class="n">@umumiBrut.ToString("N2") ₼</span></td>
                            <td class="center"><span class="n n--green">@FmtC(umumiBonus,"+")</span></td>
                            <td class="center"><span class="n n--green">@FmtC(umumiOvertime,"+")</span></td>
                            <td class="center col-sep"><span class="n n--blue">@FmtC(list.Sum(x=>x.MezuniyyetOdenisi))</span></td>
                            <td class="center col-sep"><span class="n n--red">@FmtC(umumiCerime,"−")</span></td>
                            <td class="center"><span class="n n--red">@umumiGelirV.ToString("N2") ₼</span></td>
                            <td class="center"><span class="n n--purple">@umumiDsmf.ToString("N2") ₼</span></td>
                            <td class="center"><span class="n">@umumiIssizlik.ToString("N2") ₼</span></td>
                            <td class="center col-sep"><span class="n">@umumiItss.ToString("N2") ₼</span></td>
                            <td class="center"><span class="n n--gold" style="font-size:14px;">@umumiNet.ToString("N2") ₼</span></td>
                            <td class="col-sep"></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

</div>

@* ── Status Modal ─────────────────────────────────────────────── *@
<div class="mi-overlay" id="miOverlay">
    <div class="mi-modal">
        <div class="mi-modal-head">
            <div class="mi-modal-icon mi-modal-icon--green" id="miModalIcon"></div>
            <div>
                <div class="mi-modal-title" id="miModalTitle">Status dəyişikliyi</div>
                <div class="mi-modal-sub"   id="miModalSub">Əmin misiniz?</div>
            </div>
        </div>
        <div class="mi-modal-foot" style="padding-top:20px;">
            <button type="button" id="miModalCancel" class="mi-btn mi-btn--outline">Ləğv et</button>
            <form asp-area="HR" asp-controller="Maas" asp-action="StatusDeyis"
                  method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" id="miStatusId"  name="id"/>
                <input type="hidden" id="miStatusVal" name="yeniStatus"/>
                <input type="hidden" id="miStatusIl"  name="il"/>
                <input type="hidden" id="miStatusAy"  name="ay"/>
                <button type="submit" class="mi-btn mi-btn--primary">Təsdiqlə</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/maas-index.js" asp-append-version="true"></script>
}
