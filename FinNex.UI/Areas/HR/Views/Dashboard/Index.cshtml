@{
    ViewData["Title"] = "HR Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/hr-dashboard.css" asp-append-version="true" />
}

<div class="fn-page">

    <!-- ── Greeting ──────────────────────────────────── -->
    <div class="hr-greeting">
        <div>
            <div class="hr-greeting-title">HR Dashboard</div>
            <div class="hr-greeting-sub">İşçi idarəetmə və analitika paneli</div>
        </div>
        <div class="hr-greeting-actions">
            <a asp-area="HR" asp-controller="Isci" asp-action="Create" class="fn-btn fn-btn--primary">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                Yeni işçi
            </a>
        </div>
    </div>

    <!-- ── KPI kartlar ───────────────────────────────── -->
    <div class="hr-kpi-grid">

        <div class="hr-kpi-card">
            <div class="hr-kpi-top">
                <span class="hr-kpi-label">Ümumi işçi</span>
                <div class="hr-kpi-icon hr-kpi-icon--indigo">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="6" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3" />
                        <path d="M1 14c0-3 2.2-5 5-5s5 2 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        <path d="M12 7c1.5 0 3 .8 3 3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        <circle cx="12" cy="4.5" r="1.8" stroke="currentColor" stroke-width="1.3" />
                    </svg>
                </div>
            </div>
            <div class="hr-kpi-value">@(ViewBag.UmumiIsci ?? 0)</div>
            <div class="hr-kpi-sub">
                <span class="hr-kpi-trend hr-kpi-trend--up">↑ Son 30 gün</span>
            </div>
        </div>

        <div class="hr-kpi-card">
            <div class="hr-kpi-top">
                <span class="hr-kpi-label">Aktiv işçi</span>
                <div class="hr-kpi-icon hr-kpi-icon--green">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="7" cy="5" r="2.5" stroke="currentColor" stroke-width="1.3" />
                        <path d="M2 14c0-3 2.2-5 5-5s5 2 5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        <path d="M10.5 9l1.5 1.5 2.5-2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
            <div class="hr-kpi-value">@(ViewBag.AktivIsci ?? 0)</div>
            <div class="hr-kpi-sub">
                <span class="hr-kpi-badge hr-kpi-badge--green">Stabil</span>
            </div>
        </div>

        <div class="hr-kpi-card">
            <div class="hr-kpi-top">
                <span class="hr-kpi-label">Məzuniyyətdə</span>
                <div class="hr-kpi-icon hr-kpi-icon--amber">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M8 2C5.8 2 4 3.8 4 6c0 3.5 4 8 4 8s4-4.5 4-8c0-2.2-1.8-4-4-4z" stroke="currentColor" stroke-width="1.3" />
                        <circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.3" />
                    </svg>
                </div>
            </div>
            <div class="hr-kpi-value">@(ViewBag.Mezuniyyetde ?? 0)</div>
            <div class="hr-kpi-sub">
                <span class="hr-kpi-badge hr-kpi-badge--amber">Bu həftə: @(ViewBag.MezuniyyetBitir ?? 0) bitir</span>
            </div>
        </div>

        <div class="hr-kpi-card">
            <div class="hr-kpi-top">
                <span class="hr-kpi-label">Bu ay gecikmə</span>
                <div class="hr-kpi-icon hr-kpi-icon--red">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.3" />
                        <path d="M8 5v3.5M8 10.5v.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    </svg>
                </div>
            </div>
            <div class="hr-kpi-value">@(ViewBag.Gecikme ?? 0)</div>
            <div class="hr-kpi-sub">
                <span class="hr-kpi-badge hr-kpi-badge--red">Diqqət tələb edir</span>
            </div>
        </div>

    </div>

    <!-- ── Sürətli əməliyyatlar ──────────────────────── -->
    <div class="hr-section-title">Sürətli əməliyyatlar</div>
    <div class="hr-action-grid">

        <a asp-area="HR" asp-controller="Isci" asp-action="Create" class="hr-action-card">
            <div class="hr-action-icon hr-action-icon--indigo">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="8" cy="6" r="3" stroke="currentColor" stroke-width="1.3" />
                    <path d="M2 16c0-3.5 2.7-6 6-6s6 2.5 6 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M13.5 4v5M16 6.5h-5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                </svg>
            </div>
            <div class="hr-action-body">
                <div class="hr-action-title">Yeni işçi əlavə et</div>
                <div class="hr-action-sub">İşçi qeydiyyatını başlat</div>
            </div>
            <svg class="hr-action-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>

        <a asp-area="HR" asp-controller="Davamiyyet" asp-action="Index" class="hr-action-card">
            <div class="hr-action-icon hr-action-icon--blue">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <rect x="2" y="3" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.3" />
                    <path d="M2 7h14M6 3V1M12 3V1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                    <path d="M6 11l2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="hr-action-body">
                <div class="hr-action-title">Davamiyyət</div>
                <div class="hr-action-sub">Giriş/çıxış qeydiyyatı</div>
            </div>
            <svg class="hr-action-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>

        <a asp-area="HR" asp-controller="Mezuniyyet" asp-action="Hr" class="hr-action-card">
            <div class="hr-action-icon hr-action-icon--amber">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M9 2l2 4 4.5.7-3.2 3.1.8 4.5L9 12l-4 2.3.8-4.5L2.5 6.7 7 6z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                </svg>
            </div>
            <div class="hr-action-body">
                <div class="hr-action-title">Məzuniyyət təsdiq</div>
                <div class="hr-action-sub">Gözləyən müraciətlər</div>
            </div>
            <svg class="hr-action-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>

    </div>

    <!-- ── Alt panel: Son işçilər + Bugünün xülasəsi ── -->
    <div class="hr-bottom-grid">

        <!-- Son əlavə olunan işçilər -->
        <div class="fn-card">
            <div class="fn-card-head">
                <span class="fn-card-title">Son əlavə olunan işçilər</span>
                <a asp-area="HR" asp-controller="Isci" asp-action="Index"
                   class="fn-card-link">Hamısı →</a>
            </div>

            @if (ViewBag.SonIsciler != null && ((IEnumerable<dynamic>)ViewBag.SonIsciler).Any())
            {
                <div class="hr-isci-list">
                    @foreach (var isci in ViewBag.SonIsciler)
                    {
                        <div class="hr-isci-row">
                            <div class="hr-isci-avatar">@isci.TamAd.Substring(0, 1)</div>
                            <div class="hr-isci-info">
                                <div class="hr-isci-name">@isci.TamAd</div>
                                <div class="hr-isci-meta">@isci.Departament • @isci.Vezife</div>
                            </div>
                            <div class="hr-isci-date">@isci.ElaveTarixi</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="fn-empty">Məlumat yoxdur</div>
            }
        </div>

        <!-- Bu günün xülasəsi -->
        <div class="fn-card">
            <div class="fn-card-head">
                <span class="fn-card-title">Bu günün xülasəsi</span>
                <span class="hr-live-badge">● Live</span>
            </div>

            <div class="hr-summary-list">
                <div class="hr-summary-row">
                    <div class="hr-summary-left">
                        <div class="hr-summary-dot hr-summary-dot--green"></div>
                        <span>Gələnlər</span>
                    </div>
                    <strong>@(ViewBag.Gelenler ?? 0)</strong>
                </div>
                <div class="hr-summary-row">
                    <div class="hr-summary-left">
                        <div class="hr-summary-dot hr-summary-dot--red"></div>
                        <span>Gecikənlər</span>
                    </div>
                    <strong>@(ViewBag.Gecikenler ?? 0)</strong>
                </div>
                <div class="hr-summary-row">
                    <div class="hr-summary-left">
                        <div class="hr-summary-dot hr-summary-dot--amber"></div>
                        <span>Məzuniyyətdə</span>
                    </div>
                    <strong>@(ViewBag.Mezuniyyetdebugun ?? 0)</strong>
                </div>
                <div class="hr-summary-row">
                    <div class="hr-summary-left">
                        <div class="hr-summary-dot hr-summary-dot--gray"></div>
                        <span>Gəlməyən</span>
                    </div>
                    <strong>@(ViewBag.Gelmeyen ?? 0)</strong>
                </div>
            </div>

            <div class="hr-summary-footer">
                <a asp-area="HR" asp-controller="Davamiyyet" asp-action="Index"
                   class="fn-btn fn-btn--outline fn-btn--sm" style="width:100%;justify-content:center">
                    Davamiyyətə bax
                </a>
            </div>
        </div>

    </div>

</div>
