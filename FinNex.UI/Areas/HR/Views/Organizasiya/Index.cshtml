@{
    ViewData["Title"] = "Organizasiya Sxemi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/organizasiya.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Organizasiya Sxemi</div>
            <div class="fn-page-sub">Şirkətin struktur və işçi iyerarxiyası</div>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            <button class="fn-btn fn-btn--outline fn-btn--sm" id="orgCollapseAll">Yığ</button>
            <button class="fn-btn fn-btn--outline fn-btn--sm" id="orgExpandAll">Aç</button>
        </div>
    </div>

    <div id="orgLoading" class="org-loading">
        <div class="org-loading-spinner"></div>
        Yüklənir...
    </div>

    @* ── Rehber seviyyesi ─────────────────────────────────── *@
    <div id="orgRehberler" class="org-rehberler" style="display:none;"></div>

    @* ── Departamentler grid ──────────────────────────────── *@
    <div id="orgChart" class="org-chart" style="display:none;"></div>

</div>

@section Scripts {
    <script>
        var orgDataUrl = '@Url.Action("GetOrgData", "Organizasiya", new { area = "HR" })';
    </script>
    <script src="~/js/hr/organizasiya.js" asp-append-version="true"></script>
}
