@model List<FinNex.Domain.Entities.HR.Guzest>
@{
    ViewData["Title"] = "Vergi güzəştləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/guzest.css" asp-append-version="true" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="gz-page">
    <div class="gz-head">
        <div>
            <div class="gz-title">Vergi güzəştləri kataloqu</div>
            <div class="gz-sub">Maaş hesablamasında istifadə olunan güzəştlərin siyahısı</div>
        </div>
        <a asp-action="Create" class="gz-btn gz-btn--primary">
            <i class="bi bi-plus-lg"></i> Yeni güzəşt
        </a>
    </div>

    <div class="gz-card">
        @if (!Model.Any())
        {
            <div class="gz-empty">
                <i class="bi bi-inbox"></i>
                <p>Hələ güzəşt əlavə olunmayıb</p>
            </div>
        }
        else
        {
            <table class="gz-table">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th class="gz-num">Məbləğ</th>
                        <th>Maddə</th>
                        <th>Növ</th>
                        <th>Status</th>
                        <th class="gz-act">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td><strong>@g.Ad</strong></td>
                            <td class="gz-num">@g.Mebleg.ToString("N2") ₼</td>
                            <td>@(g.Madde ?? "—")</td>
                            <td>
                                @if (g.Novu == FinNex.Domain.Entities.HR.GuzestNovu.Elillik)
                                {
                                    <span class="gz-status gz-status--ok">Əlillik</span>
                                }
                                else if (g.Novu == FinNex.Domain.Entities.HR.GuzestNovu.MecburiKockun)
                                {
                                    <span>Məcburi köçkün</span>
                                }
                                else
                                {
                                    <span>Adi</span>
                                }
                            </td>
                            <td>
                                @if (g.Aktivdir)
                                {
                                    <span class="gz-status gz-status--ok">Aktiv</span>
                                }
                                else
                                {
                                    <span class="gz-status">Passiv</span>
                                }
                            </td>
                            <td class="gz-act">
                                <a asp-action="Edit" asp-route-id="@g.Id"
                                   class="gz-btn gz-btn--outline gz-btn--sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@g.Id" method="post"
                                      style="display:inline" onsubmit="return confirm('Güzəşti silmək istəyirsiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="gz-btn gz-btn--danger gz-btn--sm">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

