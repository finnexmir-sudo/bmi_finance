@model FinNex.Domain.Entities.HR.Guzest
@{
    ViewData["Title"] = "Güzəşti düzəlt";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="gz-form-page">
    <div class="gz-form-head">
        <a asp-action="Index" class="gz-back"><i class="bi bi-arrow-left"></i> Geri</a>
        <div class="gz-title">Güzəşti düzəlt</div>
    </div>

    <div class="gz-form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="gz-form-group">
                <label asp-for="Ad" class="gz-label">Ad <span class="gz-req">*</span></label>
                <input asp-for="Ad" class="gz-input" />
                <span asp-validation-for="Ad" class="gz-err"></span>
            </div>

            <div class="gz-form-group">
                <label asp-for="Mebleg" class="gz-label">Məbləğ (AZN) <span class="gz-req">*</span></label>
                <input asp-for="Mebleg" type="number" step="0.01" min="0" class="gz-input" />
                <span asp-validation-for="Mebleg" class="gz-err"></span>
            </div>

            <div class="gz-form-group">
                <label asp-for="Madde" class="gz-label">Maddə <span class="gz-hint">(istəyə bağlı)</span></label>
                <input asp-for="Madde" class="gz-input" />
                <span asp-validation-for="Madde" class="gz-err"></span>
            </div>

            <div class="gz-form-group gz-form-check">
                <label class="gz-check-label">
                    <input asp-for="Aktivdir" type="checkbox" />
                    <span>Aktiv güzəşt</span>
                </label>
            </div>

            <div class="gz-form-actions">
                <a asp-action="Index" class="gz-btn gz-btn--outline">Ləğv et</a>
                <button type="submit" class="gz-btn gz-btn--primary">
                    <i class="bi bi-check2"></i> Yadda saxla
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .gz-form-page { padding: 24px 28px; max-width: 680px; margin: 0 auto; }
    .gz-form-head { margin-bottom: 18px; }
    .gz-back {
        display: inline-flex; align-items: center; gap: 4px;
        color: #5a647a; text-decoration: none;
        font-size: 12px; font-weight: 600;
        margin-bottom: 6px;
    }
    .gz-back:hover { color: #6b21a8; }
    .gz-title { font-size: 1.35rem; font-weight: 800; color: #1a1d29; }
    .gz-form-card {
        background: #fff; border-radius: 14px;
        border: 1px solid #e9ecef; padding: 24px 28px;
        box-shadow: 0 4px 18px rgba(15, 26, 46, .04);
    }
    .gz-form-group { margin-bottom: 18px; }
    .gz-label {
        display: block; font-size: 12px; font-weight: 800;
        color: #3d4557; margin-bottom: 6px;
        text-transform: uppercase; letter-spacing: .3px;
    }
    .gz-req { color: #dc2626; }
    .gz-hint { color: #8a93a8; font-weight: 500; text-transform: none; letter-spacing: 0; }
    .gz-input {
        width: 100%; padding: 11px 14px;
        border: 1.5px solid #e2e6ef; border-radius: 9px;
        font-size: 14px; font-family: inherit;
        background: #fff;
    }
    .gz-input:focus {
        outline: none; border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, .12);
    }
    .gz-err { display: block; font-size: 11.5px; color: #dc2626; margin-top: 4px; }
    .gz-form-check .gz-check-label {
        display: inline-flex; align-items: center; gap: 8px;
        font-size: 13px; font-weight: 700; color: #3d4557;
        cursor: pointer;
    }
    .gz-form-check input[type=checkbox] { width: 16px; height: 16px; accent-color: #7c3aed; }
    .gz-form-actions {
        display: flex; justify-content: flex-end; gap: 10px;
        margin-top: 10px; padding-top: 16px;
        border-top: 1px solid #eef0f5;
    }
    .gz-btn {
        display: inline-flex; gap: 5px; align-items: center;
        padding: 10px 20px; border-radius: 9px;
        font-size: 13px; font-weight: 700;
        text-decoration: none; border: none; cursor: pointer;
        transition: all .15s; font-family: inherit;
    }
    .gz-btn--primary { background: #7c3aed; color: #fff; }
    .gz-btn--primary:hover { background: #6b21a8; }
    .gz-btn--outline { background: #fff; color: #3d4557; border: 1px solid #e2e6ef; }
    .gz-btn--outline:hover { border-color: #7c3aed; color: #6b21a8; }
</style>
