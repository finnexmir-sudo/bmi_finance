@{
    ViewData["Title"] = "Xərc İdarəetməsi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var canManualCreate = (bool)(ViewBag.CanManualCreate ?? false);
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Xərc İdarəetməsi</div>
            <div class="fn-page-sub">Bütün xərc müraciətləri və onların statusu</div>
        </div>
        <div class="xerc-hr-actions">
            @if (canManualCreate)
            {
                <a asp-area="HR" asp-controller="Xerc" asp-action="ManualCreate"
                   class="fn-btn fn-btn--primary">
                    <i class="bi bi-plus-lg"></i> Manual Xərc
                </a>
            }
            <button id="btnExcel" class="fn-btn fn-btn--outline" type="button">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="xerc-alert xerc-alert--success">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
        </div>
    }

    @* ── Filtrlər ── *@
    <div class="fn-card xerc-filters">
        <div class="fn-form-row">
            <div class="fn-form-group">
                <label class="fn-label">Status</label>
                <select id="filterStatus" class="fn-input">
                    <option value="-1">Hamısı</option>
                    <option value="0">Müraciət</option>
                    <option value="1">Şöbə reisi təsdiq</option>
                    <option value="2">HR təsdiq</option>
                    <option value="3">Ödənildi</option>
                    <option value="4">İmtina edildi</option>
                </select>
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Axtarış</label>
                <input type="text" id="filterAxtaris" class="fn-input"
                       placeholder="İşçi adı, şöbə və ya təsvir..." />
            </div>
            <div class="fn-form-group" style="align-self:flex-end">
                <button id="btnFilter" class="fn-btn fn-btn--primary" type="button">Axtar</button>
            </div>
        </div>
    </div>

    @* ── Cədvəl ── *@
    <div class="fn-card">
        <div class="xerc-table-wrap">
            <table class="xerc-table" id="xercTable">
                <thead>
                    <tr>
                        <th>İşçi / Şöbə</th>
                        <th>Kateqoriya</th>
                        <th>Təsvir</th>
                        <th>Məbləğ</th>
                        <th>Tarix</th>
                        <th>Status</th>
                        <th>Əməliyyat</th>
                    </tr>
                </thead>
                <tbody id="xercBody">
                    <tr>
                        <td colspan="7" class="xerc-empty">Yüklənir...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* ── İmtina Modal ── *@
    <div class="xerc-modal-overlay" id="imtinaModal" style="display:none">
        <div class="xerc-modal">
            <div class="xerc-modal-header">
                <h3>İmtina Səbəbi</h3>
                <button type="button" class="xerc-modal-close" id="btnImtinaClose">&times;</button>
            </div>
            <div class="xerc-modal-body">
                <input type="hidden" id="imtinaXercId" />
                <div class="fn-form-group">
                    <label class="fn-label">Səbəb</label>
                    <textarea id="imtinaSebeb" class="fn-input" rows="3"
                              placeholder="İmtina səbəbini qeyd edin..."></textarea>
                </div>
            </div>
            <div class="xerc-modal-footer">
                <button type="button" class="fn-btn fn-btn--outline" id="btnImtinaCancel">Ləğv</button>
                <button type="button" class="fn-btn fn-btn--danger" id="btnImtinaConfirm">İmtina Et</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/hr/xerc.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/hr/xerc.js" asp-append-version="true"></script>
}
