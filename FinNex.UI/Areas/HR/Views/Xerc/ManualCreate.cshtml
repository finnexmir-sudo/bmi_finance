@model FinNex.UI.Areas.HR.Controllers.ManualXercCreateDto
@{
    ViewData["Title"] = "Manual Xərc Girişi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var kateqoriyalar  = ViewBag.Kateqoriyalar  as List<FinNex.Domain.Entities.HR.XercKateqoriyasi>;
    var departamentler = ViewBag.Departamentler as List<FinNex.Domain.Entities.Structure.Departament>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/xerc.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/xerc.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Manual Xərc Girişi</div>
            <div class="fn-page-sub">Şirkətin şöbə üzrə xərclərini birbaşa qeydə alın</div>
        </div>
        <a asp-area="HR" asp-controller="Xerc" asp-action="Index"
           class="fn-btn fn-btn--outline">&#8592; Geri</a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="xerc-alert xerc-alert--error">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@err.ErrorMessage</div>
            }
        </div>
    }

    <div class="fn-form-wrap">
        <form asp-area="HR" asp-controller="Xerc" asp-action="ManualCreate"
              method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">

                @* Şöbə *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Şöbə <span class="fn-required">*</span>
                    </label>
                    <select name="DepartamentId" id="manualDeptId" class="fn-input" required>
                        <option value="">— Seçin —</option>
                        @if (departamentler != null)
                        {
                            foreach (var d in departamentler)
                            {
                                if (Model?.DepartamentId == d.Id)
                                {
                                    <option value="@d.Id" selected>@d.Ad</option>
                                }
                                else
                                {
                                    <option value="@d.Id">@d.Ad</option>
                                }
                            }
                        }
                    </select>
                </div>

                @* Kateqoriya *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Kateqoriya <span class="fn-required">*</span>
                    </label>
                    <select name="KateqoriyaId" class="fn-input" required>
                        <option value="">— Seçin —</option>
                        @if (kateqoriyalar != null)
                        {
                            foreach (var k in kateqoriyalar)
                            {
                                if (Model?.KateqoriyaId == k.Id)
                                {
                                    <option value="@k.Id" selected>@k.Ad</option>
                                }
                                else
                                {
                                    <option value="@k.Id">@k.Ad</option>
                                }
                            }
                        }
                    </select>
                </div>

                @* Məbləğ + Tarix *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Məbləğ (AZN) <span class="fn-required">*</span>
                        </label>
                        <input type="number" name="Mebleg" id="manualMebleg" class="fn-input"
                               step="0.01" min="0.01" required placeholder="0.00"
                               value="@(Model != null && Model.Mebleg > 0 ? Model.Mebleg.ToString("F2") : "")" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Xərc tarixi <span class="fn-required">*</span>
                        </label>
                        <input type="date" name="XercTarixi" id="manualTarix" class="fn-input" required
                               value="@((Model?.XercTarixi ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                @* Büdcə xəbərdarı *@
                <div id="budceXeberdar" style="display:none;margin-bottom:12px;border-radius:10px;padding:12px 16px;font-size:13px"></div>

                @* Təsvir *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Təsvir <span class="fn-required">*</span>
                    </label>
                    <textarea name="Tesvir" class="fn-input" rows="3" required
                              placeholder="Xərcin məqsədi, təchizatçı, faktura nömrəsi və s...">@(Model?.Tesvir)</textarea>
                </div>

                @* Faktura *@
                <div class="fn-form-group">
                    <label class="fn-label">
                        Faktura / Sənəd
                        <span class="fn-label-hint">(isteğe bağlı)</span>
                    </label>
                    <input type="file" name="faktura" class="fn-input"
                           accept=".pdf,.jpg,.jpeg,.png" />
                    <div class="fn-hint">PDF, JPG, PNG (max 10MB)</div>
                </div>

                @* Info *@
                <div class="fn-info-box xerc-manual-info">
                    <i class="bi bi-check-circle-fill" style="color:#16a34a;font-size:15px;flex-shrink:0"></i>
                    <div>
                        <strong>Birbaşa qeydiyyat:</strong> Bu xərc işçi müraciəti olmadan bilavasitə
                        <em>Ödənildi</em> statusu ilə qeydə alınır. Heç bir təsdiq addımı tələb olunmur.
                    </div>
                </div>

                @* Düymələr *@
                <div class="fn-form-actions">
                    <a asp-area="HR" asp-controller="Xerc" asp-action="Index"
                       class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">
                        <i class="bi bi-save"></i> Qeydə al
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
    (function () {
        var deptEl   = document.getElementById('manualDeptId');
        var tarixEl  = document.getElementById('manualTarix');
        var meblegEl = document.getElementById('manualMebleg');
        var boxEl    = document.getElementById('budceXeberdar');

        function fmt(v) {
            return Number(v).toLocaleString('az-AZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function showLimit(data, meblegVal) {
            var mebleg = parseFloat(meblegVal) || 0;
            if (data.yoxdur) {
                boxEl.style.display    = 'block';
                boxEl.style.background = '#f8f9fb';
                boxEl.style.border     = '1px solid #e2e8f0';
                boxEl.style.color      = '#64748b';
                boxEl.innerHTML = '<i class="bi bi-info-circle"></i> Bu şöbə üçün bu ay büdcə planı daxil edilməyib.';
                return;
            }

            var azadAfter = data.azad - mebleg;
            var isOver    = azadAfter < 0;
            var isWarn    = !isOver && data.faiz > 79;
            var bg     = isOver ? '#fef2f2' : isWarn ? '#fffbeb' : '#f0fdf4';
            var border = isOver ? '#fecaca' : isWarn ? '#fde68a' : '#bbf7d0';
            var color  = isOver ? '#dc2626' : isWarn ? '#92400e' : '#16a34a';
            var icon   = isOver ? 'bi-exclamation-triangle-fill' : isWarn ? 'bi-exclamation-circle' : 'bi-check-circle';

            var rezervPart = data.rezerv > 0
                ? ' · Rezerv <strong style="color:#d97706">' + fmt(data.rezerv) + ' ₼</strong>'
                : '';

            boxEl.style.display    = 'block';
            boxEl.style.background = bg;
            boxEl.style.border     = '1px solid ' + border;
            boxEl.style.color      = color;
            boxEl.innerHTML = '<i class="bi ' + icon + '"></i> ' +
                '<strong>Büdcə:</strong> Plan <strong>' + fmt(data.plan) + ' ₼</strong> · ' +
                'Faktiki <strong>' + fmt(data.faktiki) + ' ₼</strong>' + rezervPart + ' · ' +
                'Azad <strong>' + fmt(data.azad) + ' ₼</strong>' +
                (isOver ? ' — <strong>Bu xərc azad büdcəni aşır!</strong>' : '');
        }

        function loadLimit() {
            var deptId = deptEl.value;
            var tarix  = tarixEl.value;
            if (!deptId || !tarix) { boxEl.style.display = 'none'; return; }
            var d = new Date(tarix);
            fetch('/HR/Budce/GetLimitInfo?departamentId=' + deptId +
                  '&il=' + d.getFullYear() + '&ay=' + (d.getMonth() + 1))
                .then(function (r) { return r.json(); })
                .then(function (data) { showLimit(data, meblegEl.value); });
        }

        deptEl.addEventListener('change', loadLimit);
        tarixEl.addEventListener('change', loadLimit);
        meblegEl.addEventListener('input', loadLimit);

        // İlkin yükləmə (redaktə zamanı)
        if (deptEl.value && tarixEl.value) loadLimit();
    })();
    </script>
}
