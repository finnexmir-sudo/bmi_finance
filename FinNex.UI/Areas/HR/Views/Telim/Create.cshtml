@{
    ViewData["Title"] = "Yeni T\u0259lim";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/telim.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni T\u0259lim</div>
            <div class="fn-page-sub">T\u0259lim m\u0259lumatlar\u0131n\u0131 daxil edin</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">\u2190 Siyah\u0131</a>
    </div>

    <div class="fn-card" style="max-width:720px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-form-row">
                <label class="fn-label">T\u0259lim Ad\u0131 <span style="color:#d85a30;">*</span></label>
                <input type="text" name="ad" class="fn-input" required placeholder="T\u0259lim ad\u0131..." />
            </div>

            <div class="fn-form-row">
                <label class="fn-label">T\u0259svir</label>
                <textarea name="tesvir" class="fn-input" rows="3" placeholder="T\u0259limin m\u0259zmunu..."></textarea>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="fn-form-row">
                    <label class="fn-label">T\u0259lim\u00e7i</label>
                    <input type="text" name="tesviqci" class="fn-input" placeholder="T\u0259lim\u00e7i ad\u0131..." />
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">M\u0259kan</label>
                    <input type="text" name="mekan" class="fn-input" placeholder="T\u0259lim m\u0259kan\u0131..." />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
                <div class="fn-form-row">
                    <label class="fn-label">Ba\u015flama Tarixi <span style="color:#d85a30;">*</span></label>
                    <input type="date" name="baslamaTarixi" class="fn-input" required />
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">Bitm\u0259 Tarixi</label>
                    <input type="date" name="bitmeTarixi" class="fn-input" />
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">M\u00fcdd\u0259t (saat) <span style="color:#d85a30;">*</span></label>
                    <input type="number" name="muddetSaat" class="fn-input" required min="1" placeholder="Saat say\u0131..." />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                <div class="fn-form-row">
                    <label class="fn-label">T\u0259lim N\u00f6v\u00fc</label>
                    <select name="daxiliTelimdir" class="fn-input">
                        <option value="true">Daxili T\u0259lim</option>
                        <option value="false">Xarici T\u0259lim</option>
                    </select>
                </div>
                <div class="fn-form-row">
                    <label class="fn-label">X\u0259rc (AZN)</label>
                    <input type="number" name="xerc" class="fn-input" step="0.01" min="0" placeholder="X\u0259rc m\u0259bl\u0259\u011fi..." />
                </div>
            </div>

            <div class="fn-form-row">
                <label class="fn-label">\u0130\u015ftirak\u00e7\u0131lar</label>
                <div class="tlm-participant-select">
                    <select id="ishtirakciSelect" class="fn-input" multiple size="6">
                        @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <div class="tlm-select-hint">Ctrl/Cmd basaraq bir ne\u00e7\u0259 i\u015f\u00e7i se\u00e7\u0259 bil\u0259rsiniz</div>
                </div>
                <div id="selectedParticipants"></div>
            </div>

            <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">
                <a asp-action="Index" class="fn-btn fn-btn--outline">L\u0259\u011fv et</a>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Yarat
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Secilmis ishtirakilar ucun hidden input yarat
        var sel = document.getElementById('ishtirakciSelect');
        var container = document.getElementById('selectedParticipants');
        sel.addEventListener('change', function() {
            container.innerHTML = '';
            for (var opt of sel.selectedOptions) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'ishtirakcilar';
                inp.value = opt.value;
                container.appendChild(inp);
            }
        });
    </script>
}
