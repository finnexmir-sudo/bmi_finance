@{
    ViewData["Title"] = "Yeni Təlim";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/telim.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni Təlim</div>
            <div class="fn-page-sub">Təlim məlumatlarını daxil edin</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Siyahı
        </a>
    </div>

    <div class="fn-card tlm-create-card">
        <div class="tlm-create-header">
            <div class="tlm-create-header-icon">
                <svg width="18" height="18" viewBox="0 0 14 14" fill="none">
                    <path d="M2 2h3v3H2zM9 2h3v3H9zM2 9h3v3H2z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
                    <path d="M9 10.5h3M10.5 9v3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <div class="tlm-create-header-title">Təlim Məlumatları</div>
                <div class="tlm-create-header-sub">Zəruri sahələri doldurun</div>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="tlm-create-section">
                <div class="tlm-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M3 2h8a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M5 5h4M5 7h4M5 9h2" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                    </svg>
                    Əsas Məlumatlar
                </div>

                <div class="fn-form-row">
                    <label class="fn-label">Təlim Adı <span class="fn-required">*</span></label>
                    <input type="text" name="ad" class="fn-input" required placeholder="Təlim adı..." />
                </div>

                <div class="fn-form-row">
                    <label class="fn-label">Təsvir</label>
                    <textarea name="tesvir" class="fn-input" rows="3" placeholder="Təlimin məzmunu..."></textarea>
                </div>

                <div class="tlm-create-grid tlm-create-grid--2">
                    <div class="fn-form-row">
                        <label class="fn-label">Təlimçi</label>
                        <input type="text" name="tesviqci" class="fn-input" placeholder="Təlimçi adı..." />
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Məkan</label>
                        <input type="text" name="mekan" class="fn-input" placeholder="Təlim məkanı..." />
                    </div>
                </div>
            </div>

            <div class="tlm-create-section">
                <div class="tlm-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1 5h12M5 2v2M9 2v2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                    </svg>
                    Tarix və Müddət
                </div>

                <div class="tlm-create-grid tlm-create-grid--3">
                    <div class="fn-form-row">
                        <label class="fn-label">Başlama Tarixi <span class="fn-required">*</span></label>
                        <input type="date" name="baslamaTarixi" class="fn-input" required />
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Bitmə Tarixi</label>
                        <input type="date" name="bitmeTarixi" class="fn-input" />
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Müddət (saat) <span class="fn-required">*</span></label>
                        <input type="number" name="muddetSaat" class="fn-input" required min="1" placeholder="Saat sayı..." />
                    </div>
                </div>
            </div>

            <div class="tlm-create-section">
                <div class="tlm-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <rect x="1" y="2.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1 5.5h12M4 9h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                    Növ və Xərc
                </div>

                <div class="tlm-create-grid tlm-create-grid--2">
                    <div class="fn-form-row">
                        <label class="fn-label">Təlim Növü</label>
                        <select name="daxiliTelimdir" class="fn-input">
                            <option value="true">Daxili Təlim</option>
                            <option value="false">Xarici Təlim</option>
                        </select>
                    </div>
                    <div class="fn-form-row">
                        <label class="fn-label">Xərc (AZN)</label>
                        <input type="number" name="xerc" class="fn-input" step="0.01" min="0" placeholder="Xərc məbləği..." />
                    </div>
                </div>
            </div>

            <div class="tlm-create-section">
                <div class="tlm-create-section-title">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="5" cy="4" r="2" stroke="currentColor" stroke-width="1.2"/>
                        <path d="M1 12c0-2.5 1.8-4 4-4s4 1.5 4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        <circle cx="10.5" cy="5" r="1.5" stroke="currentColor" stroke-width="1"/>
                        <path d="M9 11c0-1.5 1-2.5 2-2.5" stroke="currentColor" stroke-width="1" stroke-linecap="round"/>
                    </svg>
                    İştirakçılar
                </div>

                <div class="tlm-participant-search-wrap">
                    <svg class="tlm-participant-search-icon" width="13" height="13" viewBox="0 0 14 14" fill="none">
                        <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/>
                        <path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    <input type="text" id="participantSearch" class="fn-input tlm-participant-search" placeholder="İşçi axtar..." />
                    <div class="tlm-selected-count" id="selectedCount">0 seçildi</div>
                </div>

                <div class="tlm-participant-list" id="participantList">
                    @foreach (var item in ViewBag.Isciler as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                    {
                        <label class="tlm-participant-item" data-name="@item.Text.ToLower()">
                            <input type="checkbox" name="ishtirakcilar" value="@item.Value" class="tlm-participant-cb" />
                            <div class="tlm-participant-check">
                                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                    <path d="M2 5.5l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div class="tlm-participant-avatar">@(item.Text.Length >= 2 ? item.Text.Substring(0, 1).ToUpper() : "?")</div>
                            <span class="tlm-participant-name">@item.Text</span>
                        </label>
                    }
                </div>
            </div>

            <div class="tlm-create-actions">
                <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M2 6.5l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Yarat
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Search / filter participants
        var searchInput = document.getElementById('participantSearch');
        var listItems = document.querySelectorAll('.tlm-participant-item');
        var countEl = document.getElementById('selectedCount');

        searchInput.addEventListener('input', function () {
            var q = this.value.toLowerCase();
            listItems.forEach(function (item) {
                var name = item.getAttribute('data-name');
                item.style.display = name.indexOf(q) > -1 ? '' : 'none';
            });
        });

        // Update selected count
        document.getElementById('participantList').addEventListener('change', function () {
            var checked = document.querySelectorAll('.tlm-participant-cb:checked').length;
            countEl.textContent = checked + ' seçildi';
            countEl.classList.toggle('tlm-selected-count--active', checked > 0);
        });
    </script>
}
