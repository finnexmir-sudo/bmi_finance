@using FinNex.Application.DTOs.HR.Isci
@model IList<IsciHesabDto>
@{
    ViewData["Title"] = "Bank Hesab Nömrələri";
}

<div class="fn-page">
    @Html.AntiForgeryToken()

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Bank Hesab Nömrələri</div>
            <div class="fn-page-sub">İşçilərin bank hesab nömrələrini idarə edin</div>
        </div>
    </div>

    <div id="hesab-alert" style="display:none;margin-bottom:12px;" class="fn-alert"></div>

    <div class="fn-card" style="overflow:auto;">
        <table class="fn-table">
            <thead>
                <tr>
                    <th style="width:40px;">#</th>
                    <th>Ad Soyad</th>
                    <th>Departament</th>
                    <th style="min-width:260px;">Hesab Nömrəsi</th>
                    <th style="width:110px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var isci = Model[i];
                    <tr id="row-@isci.IsciId">
                        <td class="fn-td-muted">@(i + 1)</td>
                        <td><strong>@isci.TamAd</strong></td>
                        <td class="fn-td-muted">@(isci.Departament ?? "—")</td>
                        <td>
                            <input type="text"
                                   class="fn-input hesab-input"
                                   data-isci-id="@isci.IsciId"
                                   value="@isci.BankHesabNo"
                                   placeholder="Hesab nömrəsi daxil edin"
                                   maxlength="34"
                                   style="font-family:monospace;text-transform:uppercase;" />
                        </td>
                        <td>
                            <button class="fn-btn fn-btn--sm fn-btn--primary saxla-btn"
                                    data-isci-id="@isci.IsciId"
                                    type="button">
                                Yadda saxla
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script>
        document.querySelectorAll('.saxla-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const isciId = this.dataset.isciId;
                const input  = document.querySelector(`.hesab-input[data-isci-id="${isciId}"]`);
                const hesab  = input.value.trim().toUpperCase();

                this.disabled = true;
                this.textContent = '...';

                try {
                    const fd = new FormData();
                    fd.append('isciId', isciId);
                    fd.append('hesab', hesab);
                    fd.append('__RequestVerificationToken', getToken());

                    const res  = await fetch('@Url.Action("Saxla", "IsciHesab", new { area = "HR" })', {
                        method: 'POST',
                        body: fd
                    });
                    const data = await res.json();

                    showAlert(data.ok, data.ok ? 'Yadda saxlandı.' : (data.error || 'Xəta baş verdi.'));
                    if (data.ok) input.value = hesab;
                } catch {
                    showAlert(false, 'Sorğu göndərilmədi.');
                } finally {
                    this.disabled = false;
                    this.textContent = 'Yadda saxla';
                }
            });
        });

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }

        function showAlert(ok, msg) {
            const el = document.getElementById('hesab-alert');
            el.className = 'fn-alert ' + (ok ? 'fn-alert--success' : 'fn-alert--error');
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3000);
        }
    </script>
}
