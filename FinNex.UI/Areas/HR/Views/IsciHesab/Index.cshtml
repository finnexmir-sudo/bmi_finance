@using FinNex.Application.DTOs.HR.Isci
@model IList<IsciHesabDto>
@{
    ViewData["Title"] = "Bank Hesab Nömrələri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/isci-hesab.css" asp-append-version="true" />
}

<div class="bh-page">
    @Html.AntiForgeryToken()

    <div class="bh-head">
        <div>
            <div class="bh-title">Bank Hesab Nömrələri</div>
            <div class="bh-sub">İşçilərin bank hesab nömrələrini daxil edin və ya yeniləyin</div>
        </div>
    </div>

    <div id="bh-alert" class="bh-alert"></div>

    <div class="bh-card">
        <table class="bh-table">
            <thead>
                <tr>
                    <th class="bh-num">#</th>
                    <th>Ad Soyad</th>
                    <th>Departament</th>
                    <th style="min-width:280px;">Hesab Nömrəsi</th>
                    <th style="width:120px;"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var isci = Model[i];
                    <tr>
                        <td class="bh-num">@(i + 1)</td>
                        <td class="bh-name">@isci.TamAd</td>
                        <td class="bh-dept">@(isci.Departament ?? "—")</td>
                        <td>
                            <input type="text"
                                   class="bh-input"
                                   data-isci-id="@isci.IsciId"
                                   value="@isci.BankHesabNo"
                                   placeholder="Hesab nömrəsi daxil edin"
                                   maxlength="34" />
                        </td>
                        <td>
                            <button class="bh-btn" type="button" data-isci-id="@isci.IsciId">
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2 6.5l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                                Yadda saxla
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.bh-btn').forEach(btn => {
            btn.addEventListener('click', async function () {
                const id    = this.dataset.isciId;
                const input = document.querySelector(`.bh-input[data-isci-id="${id}"]`);
                const hesab = input.value.trim().toUpperCase();

                this.disabled = true;
                this.innerHTML = '...';

                const fd = new FormData();
                fd.append('isciId', id);
                fd.append('hesab', hesab);
                fd.append('__RequestVerificationToken',
                    document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');

                try {
                    const res  = await fetch('@Url.Action("Saxla", "IsciHesab", new { area = "HR" })', { method: 'POST', body: fd });
                    const data = await res.json();
                    if (data.ok) input.value = hesab;
                    showAlert(data.ok, data.ok ? 'Yadda saxlandı.' : (data.error ?? 'Xəta baş verdi.'));
                } catch {
                    showAlert(false, 'Sorğu göndərilmədi.');
                } finally {
                    this.disabled = false;
                    this.innerHTML = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6.5l2.5 2.5 5.5-5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> Yadda saxla';
                }
            });
        });

        function showAlert(ok, msg) {
            const el = document.getElementById('bh-alert');
            el.className = 'bh-alert ' + (ok ? 'bh-alert--ok' : 'bh-alert--err');
            el.textContent = msg;
            el.style.display = 'block';
            setTimeout(() => { el.style.display = 'none'; }, 3000);
        }
    </script>
}
