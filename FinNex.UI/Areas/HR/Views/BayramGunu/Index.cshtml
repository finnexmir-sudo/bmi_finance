@model IEnumerable<FinNex.Domain.Entities.HR.BayramGunu>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Qeyri iş günləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/hr/bayram-gunu.css" asp-append-version="true" />
}

<div class="bg-page">
    <div class="bg-header">
        <div class="bg-header-left">
            <h1 class="bg-title">Qeyri iş günləri</h1>
            <p class="bg-subtitle">Bayram, matəm, istirahət və əlavə iş günü (şənbə/bazar override) qeydləri</p>
        </div>
        <button class="bg-btn bg-btn-primary" id="bgOpenCreateBtn">
            <i class="bi bi-plus-lg"></i> Yeni qeyd əlavə et
        </button>
    </div>

    <div class="bg-stats">
        <div class="bg-stat-card">
            <div class="bg-stat-icon bg-stat-icon--total">
                <i class="bi bi-calendar-event"></i>
            </div>
            <div class="bg-stat-info">
                <span class="bg-stat-value" id="statCemi">@ViewBag.Cemi</span>
                <span class="bg-stat-label">Cəmi qeyri iş günü</span>
            </div>
        </div>
        <div class="bg-stat-card">
            <div class="bg-stat-icon bg-stat-icon--upcoming">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="bg-stat-info">
                <span class="bg-stat-value" id="statGelecek">@ViewBag.Gelecek</span>
                <span class="bg-stat-label">Gələcək qeyri iş günləri</span>
            </div>
        </div>
        <div class="bg-stat-card">
            <div class="bg-stat-icon bg-stat-icon--workdays">
                <i class="bi bi-briefcase"></i>
            </div>
            <div class="bg-stat-info">
                <span class="bg-stat-value" id="statIsGunu">—</span>
                <span class="bg-stat-label">Bu il iş günləri</span>
            </div>
        </div>
    </div>

    @* ═══════ YEAR CALENDAR GRID ═══════ *@
    <div class="bg-calendar-card">
        <div class="bg-calendar-head">
            <div class="bg-calendar-nav">
                <button type="button" class="bg-nav-btn" id="bgYearPrev">‹</button>
                <h2 class="bg-calendar-year" id="bgCalendarYear">@DateTime.Now.Year</h2>
                <button type="button" class="bg-nav-btn" id="bgYearNext">›</button>
                <button type="button" class="bg-btn bg-btn-secondary bg-btn-sm" id="bgYearToday">Bu il</button>
            </div>
            <div class="bg-calendar-legend">
                <span class="bg-lgnd"><span class="bg-sw bg-sw--weekend"></span>Şənbə/Bazar</span>
                <span class="bg-lgnd"><span class="bg-sw bg-sw--holiday"></span>Qeyri iş günü</span>
                <span class="bg-lgnd"><span class="bg-sw bg-sw--work-override"></span>Əlavə iş günü</span>
                <span class="bg-lgnd"><span class="bg-sw bg-sw--past"></span>Keçmiş (kiliddə)</span>
            </div>
        </div>
        <div class="bg-calendar-hint">
            <i class="bi bi-info-circle"></i>
            Kliklə istənilən günü dəyişdirin:
            <strong>İş günü</strong> → qeyri iş günü (qırmızı),
            <strong>Şənbə/Bazar</strong> → iş günü (yaşıl).
            Təkrar kliklə geri qaytarın. Keçmiş tarixləri dəyişmək mümkün deyil.
        </div>
        <div class="bg-calendar-grid" id="bgCalendarGrid">
            <div class="bg-calendar-loading">Yüklənir...</div>
        </div>
    </div>

    <div class="bg-table-card">
        <table class="bg-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Tarix</th>
                    <th>Növ</th>
                    <th>Hər il</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody id="bgTableBody">
                @{ var idx = 0; }
                @foreach (var item in Model)
                {
                    idx++;
                    <tr data-id="@item.Id">
                        <td>@idx</td>
                        <td>@item.Ad</td>
                        <td>@item.Tarix.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (item.Tip == GunTipi.IsGunu)
                            {
                                <span class="bg-badge bg-badge--work"><i class="bi bi-briefcase-fill"></i> İş günü</span>
                            }
                            else
                            {
                                <span class="bg-badge bg-badge--holiday"><i class="bi bi-calendar-heart"></i> Qeyri iş günü</span>
                            }
                        </td>
                        <td>
                            @if (item.HerIlTeyinOlunur)
                            {
                                <span class="bg-badge bg-badge--yes"><i class="bi bi-check-circle-fill"></i> Bəli</span>
                            }
                            else
                            {
                                <span class="bg-badge bg-badge--no"><i class="bi bi-x-circle"></i> Xeyr</span>
                            }
                        </td>
                        <td>
                            <button class="bg-btn-icon bg-btn-icon--edit" data-edit-id="@item.Id" title="Duzelis et">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="bg-btn-icon bg-btn-icon--delete" data-delete-id="@item.Id" title="Sil">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="bg-empty">
                <i class="bi bi-calendar-x"></i>
                <p>Heç bir qeyri iş günü qeydi tapılmadı</p>
            </div>
        }
    </div>
</div>

<!-- Modal -->
<div class="bg-modal-overlay" id="bgModalOverlay">
    <div class="bg-modal">
        <div class="bg-modal-header">
            <h2 class="bg-modal-title" id="bgModalTitle">Yeni qeyri iş günü</h2>
            <button class="bg-modal-close" id="bgCloseModalBtn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <form id="bgForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="bgId" name="id" />
            <div class="bg-modal-body">
                <div class="bg-form-group">
                    <label class="bg-label">Qeyd növü *</label>
                    <div class="bg-tip-selector">
                        <label class="bg-tip-option">
                            <input type="radio" name="tip" value="1" id="bgTip1" checked />
                            <div class="bg-tip-card bg-tip-card--holiday">
                                <i class="bi bi-calendar-heart"></i>
                                <span class="bg-tip-title">Qeyri iş günü</span>
                                <span class="bg-tip-sub">Bayram, matəm, istirahət — iş günü olsa da sayılmır</span>
                            </div>
                        </label>
                        <label class="bg-tip-option">
                            <input type="radio" name="tip" value="2" id="bgTip2" />
                            <div class="bg-tip-card bg-tip-card--work">
                                <i class="bi bi-briefcase-fill"></i>
                                <span class="bg-tip-title">İş günü</span>
                                <span class="bg-tip-sub">Şənbə / bazar-ı iş günü etmək üçün</span>
                            </div>
                        </label>
                    </div>
                </div>
                <div class="bg-form-group">
                    <label class="bg-label" for="bgAd">Ad *</label>
                    <input type="text" class="bg-input" id="bgAd" name="ad" required placeholder="Məs: Novruz Bayramı, Şəhidlər günü (matəm), ..." />
                    <span class="bg-error" id="bgAdError"></span>
                </div>
                <div class="bg-form-row">
                    <div class="bg-form-group bg-form-half">
                        <label class="bg-label" for="bgBaslangicTarix">Başlanğıc tarix *</label>
                        <input type="date" class="bg-input" id="bgBaslangicTarix" name="baslangicTarix" required data-fn-datepicker />
                        <span class="bg-error" id="bgTarixError"></span>
                    </div>
                    <div class="bg-form-group bg-form-half">
                        <label class="bg-label" for="bgBitisTarix">Bitiş tarix</label>
                        <input type="date" class="bg-input" id="bgBitisTarix" name="bitisTarix" data-fn-datepicker />
                        <span class="bg-error" id="bgBitisTarixError"></span>
                        <span class="bg-hint">Boş buraxsanız tək gün əlavə olunur</span>
                    </div>
                </div>
                <div class="bg-form-group bg-form-check">
                    <label class="bg-checkbox-label">
                        <input type="checkbox" id="bgHerIl" name="herIlTeyinOlunur" value="true" />
                        <span class="bg-checkmark"></span>
                        Hər il təkrar olunur
                    </label>
                </div>
                <div class="bg-form-group bg-form-check" id="bgMezuniyyetdeHesablanirGroup">
                    <label class="bg-checkbox-label">
                        <input type="checkbox" id="bgMezuniyyetdeHesablanir" name="mezuniyyetdeHesablanir" value="true" />
                        <span class="bg-checkmark"></span>
                        Məzuniyyət günlərinə daxildir (sayılır)
                    </label>
                    <span class="bg-hint" style="margin-top:4px;display:block;font-size:11.5px;color:#64748b">
                        Default: işarələnməyib (məzuniyyətdə skip olunur). Qurban bayramının ikinci günü kimi "bir gün sayılan" hallar üçün işarələyin.
                    </span>
                </div>
            </div>
            <div class="bg-modal-footer">
                <button type="button" class="bg-btn bg-btn-secondary" id="bgCancelBtn">Legv et</button>
                <button type="submit" class="bg-btn bg-btn-primary" id="bgSubmitBtn">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

<!-- Toast -->
<div class="bg-toast" id="bgToast">
    <span id="bgToastMsg"></span>
</div>

@section Scripts {
    <script src="~/js/hr/bayram-gunu.js" asp-append-version="true"></script>
}
