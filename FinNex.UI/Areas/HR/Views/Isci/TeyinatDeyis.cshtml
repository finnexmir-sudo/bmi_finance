@model FinNex.UI.Areas.HR.ViewModels.TeyinatDeyisVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Təyinat Dəyişikliyi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/isci.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="isci-form-wrap">

        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="isci-form-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            İşçi məlumatlarına qayıt
        </a>

        <!-- Mövcud vəziyyət -->
        <div class="isci-teyinat-current" style="margin-bottom:16px;">
            <div class="isci-teyinat-current-title">Mövcud Vəziyyət</div>
            <div class="isci-teyinat-row">
                <div class="isci-teyinat-ico isci-teyinat-ico--dept">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                        <path d="M1 6h12M5 2v2M9 2v2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-teyinat-key">Departament</div>
                    <div class="isci-teyinat-val">@(Model.KohneDepartament ?? "Təyin edilməyib")</div>
                </div>
            </div>
            <div class="isci-teyinat-row">
                <div class="isci-teyinat-ico isci-teyinat-ico--role">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <rect x="2" y="4" width="10" height="8" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                        <path d="M5 4V3a2 2 0 014 0v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-teyinat-key">Vəzifə</div>
                    <div class="isci-teyinat-val">@(Model.KohneVezife ?? "Təyin edilməyib")</div>
                </div>
            </div>
        </div>

        <div class="isci-form-card">
            <div class="isci-form-header">
                <div class="isci-form-header-icon isci-form-header-icon--blue">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M2 8h16M13 3l5 5-5 5M18 12H2M7 7l-5 5 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-form-header-title">Təyinat Dəyişikliyi</div>
                    <div class="isci-form-header-sub">@Model.IsciTamAd üçün departament/vəzifə dəyişikliyi</div>
                </div>
            </div>

            <form asp-action="TeyinatDeyis" method="post" id="teyinatForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IsciId" />
                <div asp-validation-summary="ModelOnly" class="fn-alert fn-alert--error" style="margin:16px 24px 0;"></div>

                <div class="isci-form-body">

                    <div class="isci-field">
                        <label class="isci-label">Yeni Departament <span class="isci-required">*</span></label>
                        <select asp-for="YeniDepartamentId" id="departamentSec"
                                asp-items="@(new SelectList(Model.Departamentler, "Value", "Text"))"
                                class="isci-select"
                                data-vezifeler-url="@Url.Action("GetVezifeler", "Isci", new { area = "HR" })"
                                data-initial-dept="@Model.YeniDepartamentId"
                                data-initial-vezife="@Model.YeniVezifeId">
                            <option value="">Departament seçin</option>
                        </select>
                        <span asp-validation-for="YeniDepartamentId" class="isci-error"></span>
                    </div>

                    <div class="isci-field">
                        <label class="isci-label">Yeni Vəzifə <span class="isci-required">*</span></label>
                        <select asp-for="YeniVezifeId" id="vezifeSec" class="isci-select">
                            <option value="">Əvvəl departament seçin</option>
                        </select>
                        <span asp-validation-for="YeniVezifeId" class="isci-error"></span>
                    </div>

                    <div class="isci-field">
                        <label class="isci-label">Başlama Tarixi <span class="isci-required">*</span></label>
                        <input asp-for="BaslamaTarixi" type="date" class="isci-input" />
                        <span asp-validation-for="BaslamaTarixi" class="isci-error"></span>
                    </div>

                    <div class="isci-hint">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex-shrink:0;margin-top:1px;">
                            <circle cx="7" cy="7" r="6" stroke="#c9900a" stroke-width="1.3" />
                            <path d="M7 4.5v3M7 9.5v.5" stroke="#c9900a" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                        Köhnə aktiv təyinat avtomatik olaraq bağlanacaq və yeni təyinat yaradılacaq.
                    </div>

                </div>

                <div class="isci-form-footer">
                    <div class="isci-form-footer-note">* olan sahələr məcburidir</div>
                    <div class="isci-form-footer-actions">
                        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary" style="background:#2563eb;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Təyinatı Dəyiş
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const getVezifelerUrl = '@Url.Action("GetVezifeler", "Isci", new { area = "HR" })';
        const initialDeptId = @Model.YeniDepartamentId;
    </script>
    <script src="~/js/hr/isci-teyinat.js" asp-append-version="true"></script>
}
