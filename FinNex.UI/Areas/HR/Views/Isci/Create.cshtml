@model IsciCreateVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Yeni İşçi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/isci.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="isci-form-wrap">

        <a asp-action="Index" class="isci-form-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            İşçilər siyahısına qayıt
        </a>

        <div class="isci-form-card">

            <div class="isci-form-header">
                <div class="isci-form-header-icon isci-form-header-icon--indigo">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="8" cy="6" r="3.5" stroke="currentColor" stroke-width="1.4" />
                        <path d="M2 17c0-4 2.7-6.5 6-6.5s6 2.5 6 6.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        <path d="M15 6v6M18 9h-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-form-header-title">Yeni İşçi</div>
                    <div class="isci-form-header-sub">Yeni işçi məlumatlarını daxil edin</div>
                </div>
            </div>

            <form asp-action="Create" method="post" id="isciForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="fn-alert fn-alert--error" style="margin:16px 24px 0;"></div>

                <div class="isci-form-body">

                    <!-- Şəxsi Məlumatlar -->
                    <div>
                        <div class="isci-section-label">Şəxsi Məlumatlar</div>
                        <div class="isci-form-grid-3" style="margin-top:12px;">
                            <div class="isci-field">
                                <label class="isci-label">Ad <span class="isci-required">*</span></label>
                                <input asp-for="Ad" class="isci-input" placeholder="Ad" />
                                <span asp-validation-for="Ad" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Soyad <span class="isci-required">*</span></label>
                                <input asp-for="Soyad" class="isci-input" placeholder="Soyad" />
                                <span asp-validation-for="Soyad" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Ata Adı</label>
                                <input asp-for="AtaAdi" class="isci-input" placeholder="Ata adı" />
                            </div>
                        </div>
                        <div class="isci-form-grid-3" style="margin-top:14px;">
                            <div class="isci-field">
                                <label class="isci-label">FIN <span class="isci-required">*</span></label>
                                <input asp-for="FIN" class="isci-input isci-input--mono" placeholder="FIN kod" maxlength="7" style="text-transform:uppercase" />
                                <span asp-validation-for="FIN" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Şəxsiyyət Vəsiqəsi <span class="isci-required">*</span></label>
                                <input asp-for="SeriyaNomre" class="isci-input isci-input--mono" placeholder="AA1234567" />
                                <span asp-validation-for="SeriyaNomre" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Doğum Tarixi <span class="isci-required">*</span></label>
                                <input asp-for="DogumTarixi" type="date" class="isci-input" />
                                <small class="date-format-hint" style="color:#888;font-size:11px;"></small>
                                <span asp-validation-for="DogumTarixi" class="isci-error"></span>
                            </div>
                        </div>
                        <div class="isci-form-grid-3" style="margin-top:14px;">
                            <div class="isci-field">
                                <label class="isci-label">Cins <span class="isci-required">*</span></label>
                                <select asp-for="CinsId" class="isci-select">
                                    <option value="">Seçin</option>
                                    <option value="0">Kişi</option>
                                    <option value="1">Qadın</option>
                                </select>
                                <span asp-validation-for="CinsId" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Telefon</label>
                                <input asp-for="Telefon" type="tel" class="isci-input" placeholder="+994501234567" />
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Email</label>
                                <input asp-for="Email" type="email" class="isci-input" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="isci-error"></span>
                            </div>
                        </div>
                        <div class="isci-field isci-field--full" style="margin-top:14px;">
                            <label class="isci-label">Ünvan</label>
                            <input asp-for="Unvan" class="isci-input" placeholder="Yaşayış ünvanı" />
                        </div>
                    </div>

                    <!-- Hesab Məlumatları -->
                    <div>
                        <div class="isci-section-label">Hesab Məlumatları</div>
                        <div class="isci-form-grid-3" style="margin-top:12px;">
                            <div class="isci-field">
                                <label class="isci-label">İstifadəçi Adı <span class="isci-required">*</span></label>
                                <input asp-for="IstifadeciAd" class="isci-input" placeholder="İstifadəçi adı" />
                                <span asp-validation-for="IstifadeciAd" class="isci-error"></span>
                            </div>
                        </div>
                    </div>

                    <!-- İş Məlumatları -->
                    <div>
                        <div class="isci-section-label">İş Məlumatları</div>
                        <div class="isci-form-grid-3" style="margin-top:12px;">
                            <div class="isci-field">
                                <label class="isci-label">Departament <span class="isci-required">*</span></label>
                                <select asp-for="DepartamentId" class="isci-select"
                                        asp-items="@(new SelectList(Model.Departments, "Value", "Text"))">
                                    <option value="">Departament seçin</option>
                                </select>
                                <span asp-validation-for="DepartamentId" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Vəzifə <span class="isci-required">*</span></label>
                                <select asp-for="VezifeId" class="isci-select">
                                    <option value="">Vəzifə seçin</option>
                                </select>
                                <span asp-validation-for="VezifeId" class="isci-error"></span>
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">İşə Qəbul Tarixi <span class="isci-required">*</span></label>
                                <input asp-for="IseQebulTarixi" type="date" class="isci-input" />
                                <small class="date-format-hint" style="color:#888;font-size:11px;"></small>
                                <span asp-validation-for="IseQebulTarixi" class="isci-error"></span>
                            </div>
                        </div>
                        <div class="isci-form-grid-3" style="margin-top:14px;">
                            <div class="isci-field">
                                <label class="isci-label">Başlanğıc Maaş</label>
                                <input asp-for="BaslangicMaas" type="number" step="0.01" min="0" class="isci-input" placeholder="0.00" />
                            </div>
                            <div class="isci-field">
                                <label class="isci-label">Başlanğıc Məzuniyyət (gün)</label>
                                <input asp-for="BaslangicMezuniyyet" type="number" min="0" class="isci-input" placeholder="21" />
                            </div>
                        </div>
                    </div>

                    <!-- Bank Məlumatları -->
                    <div>
                        <div class="isci-section-label">Bank Məlumatları</div>
                        <div class="isci-form-grid-3" style="margin-top:12px;">
                            <div class="isci-field isci-field--full" style="grid-column:span 3">
                                <label class="isci-label">Bank Hesabı (IBAN)</label>
                                <input asp-for="Iban" class="isci-input isci-input--mono"
                                       maxlength="28"
                                       style="text-transform:uppercase;letter-spacing:.5px"
                                       placeholder="AZ55MELI41010000000008700000"
                                       autocomplete="off"
                                       data-form-type="other"
                                       data-lpignore="true"
                                       data-1p-ignore="true" />
                                <small style="color:#888;font-size:11px;">
                                    Format: AZ + 2 rəqəm + 4 hərf bank kodu + 20 rəqəm hesab nömrəsi (cəmi 28 simvol). İstəyə bağlı, sonradan da əlavə edə bilərsiniz.
                                </small>
                                <span asp-validation-for="Iban" class="isci-error"></span>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="isci-form-footer">
                    <div class="isci-form-footer-note">* olan sahələr məcburidir</div>
                    <div class="isci-form-footer-actions">
                        <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Yadda saxla
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/isci-create.js" asp-append-version="true"></script>
}
