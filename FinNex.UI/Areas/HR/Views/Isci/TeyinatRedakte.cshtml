@model FinNex.UI.Areas.HR.ViewModels.TeyinatRedakteVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Təyinat Redaktəsi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/isci.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="isci-form-wrap">

        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="isci-form-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            İşçi məlumatlarına qayıt
        </a>

        <div class="isci-form-card">
            <div class="isci-form-header">
                <div class="isci-form-header-icon isci-form-header-icon--blue">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M14.5 3.5l2 2-9 9H5.5v-2l9-9z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                    </svg>
                </div>
                <div>
                    <div class="isci-form-header-title">Təyinat Redaktəsi</div>
                    <div class="isci-form-header-sub">@Model.IsciTamAd — departament/vəzifə səhvinin düzəlişi</div>
                </div>
            </div>

            <form asp-action="TeyinatRedakte" method="post" id="teyinatRedakteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IsciId" />
                <div asp-validation-summary="ModelOnly" class="fn-alert fn-alert--error" style="margin:16px 24px 0;"></div>

                <div class="isci-form-body">

                    <div class="isci-field">
                        <label class="isci-label">Departament <span class="isci-required">*</span></label>
                        <select asp-for="DepartamentId" id="departamentSec"
                                asp-items="@(new SelectList(Model.Departamentler, "Value", "Text"))"
                                class="isci-select"
                                data-vezifeler-url="@Url.Action("GetVezifeler", "Isci", new { area = "HR" })"
                                data-initial-dept="@Model.DepartamentId"
                                data-initial-vezife="@Model.VezifeId">
                            <option value="">Departament seçin</option>
                        </select>
                        <span asp-validation-for="DepartamentId" class="isci-error"></span>
                    </div>

                    <div class="isci-field">
                        <label class="isci-label">Vəzifə <span class="isci-required">*</span></label>
                        <select asp-for="VezifeId" id="vezifeSec" class="isci-select">
                            <option value="">Əvvəl departament seçin</option>
                        </select>
                        <span asp-validation-for="VezifeId" class="isci-error"></span>
                    </div>

                    <div class="isci-field">
                        <label class="isci-label">Müqavilə bitmə tarixi
                            <span style="font-size:11px;color:#6b7280;font-weight:400;">(müddətsizdirsə boş buraxın)</span>
                        </label>
                        <input asp-for="BitmeTarixi" type="date" class="isci-input"
                               value="@(Model.BitmeTarixi.HasValue ? Model.BitmeTarixi.Value.ToString("yyyy-MM-dd") : "")" />
                        <span asp-validation-for="BitmeTarixi" class="isci-error"></span>
                    </div>

                    <div class="isci-hint" style="background:#e8f5e9;border-color:#a5d6a7;">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex-shrink:0;margin-top:1px;">
                            <circle cx="7" cy="7" r="6" stroke="#2e7d32" stroke-width="1.3" />
                            <path d="M4.5 7l2 2 3.5-3.5" stroke="#2e7d32" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span style="color:#2e7d32;">Bu sadə redaktədir — təyinat tarixçəsi dəyişmir, yeni qeyd yaranmır.</span>
                    </div>

                </div>

                <div class="isci-form-footer">
                    <div class="isci-form-footer-note">* olan sahələr məcburidir</div>
                    <div class="isci-form-footer-actions">
                        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary" style="background:#2563eb;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Yadda Saxla
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/hr/isci-teyinat.js" asp-append-version="true"></script>
}
