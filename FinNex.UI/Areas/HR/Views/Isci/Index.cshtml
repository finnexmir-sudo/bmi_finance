@model IsciIndexVM
@using FinNex.Domain.Entities.HR
@using FinNex.UI.Areas.HR.ViewModels
@{
    ViewData["Title"] = "İşçilər";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/isci.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İşçilər</div>
            <div class="fn-page-sub">Bütün işçilərin idarəsi</div>
        </div>
        <a asp-area="HR" asp-controller="Isci" asp-action="Create" class="fn-btn fn-btn--primary">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            Yeni işçi
        </a>
    </div>

    @* Axtarış *@
    <form method="get" asp-action="Index" style="margin-bottom:12px;">
        <input type="hidden" name="tab" value="@Model.Tab" />
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <input type="text" name="search" value="@Model.Search"
                   class="fn-input" placeholder="Ad, soyad, FIN ilə axtar..."
                   style="max-width:280px;" />
            <button type="submit" class="fn-btn fn-btn--ghost">Axtar</button>
            @if (!string.IsNullOrEmpty(Model.Search))
            {
                <a asp-action="Index" asp-route-tab="@Model.Tab"
                   class="fn-btn fn-btn--ghost" style="color:var(--fn-danger,#e53e3e);">Sıfırla</a>
                <span style="color:var(--fn-text-muted,#888);font-size:13px;">
                    "@Model.Search" üzrə @Model.TotalCount nəticə
                </span>
            }
        </div>
    </form>

    @* Tab bar *@
    <div class="isci-tabs">
        <a asp-action="Index"
           asp-route-tab="aktiv"
           asp-route-search="@Model.Search"
           class="isci-tab @(Model.Tab == "aktiv" ? "isci-tab--active" : "")">
            Aktiv
            <span class="isci-tab-count">@Model.AktivCount</span>
        </a>
        <a asp-action="Index"
           asp-route-tab="cixmis"
           asp-route-search="@Model.Search"
           class="isci-tab @(Model.Tab == "cixmis" ? "isci-tab--active" : "")">
            İşdən Çıxmış
            <span class="isci-tab-count isci-tab-count--red">@Model.CixmisCount</span>
        </a>
    </div>

    <div class="fn-card" style="padding:0;overflow:hidden;">
        <table class="isci-table">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Şöbə</th>
                    <th>Vəzifə</th>
                    <th>Status</th>
                    @if (Model.Tab == "cixmis")
                    {
                        <th>Ayrılma tarixi</th>
                        <th>Səbəb</th>
                    }
                    <th class="isci-th-right">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var isCixmis = item.Status == IsciStatus.IshtenCixib;
                        <tr class="@(isCixmis ? "isci-row-cixmis" : "")">
                            <td>
                                <div class="isci-info">
                                    <div class="isci-avatar @(isCixmis ? "isci-avatar--cixmis" : "")">@item.TamAd.Substring(0, 1)</div>
                                    <div>
                                        <div class="isci-name">@item.TamAd</div>
                                        <div class="isci-email">@item.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="isci-td-meta">@(item.SobeAdi ?? "—")</td>
                            <td class="isci-td-meta">@(item.VezifeAdi ?? "—")</td>
                            <td>
                                @if (item.Status == IsciStatus.Aktiv)
                                {
                                    <span class="fn-badge fn-badge--done">Aktiv</span>
                                }
                                else if (item.Status == IsciStatus.Mezuniyyetde)
                                {
                                    <span class="fn-badge fn-badge--pending">Məzuniyyətdə</span>
                                }
                                else
                                {
                                    <span class="fn-badge fn-badge--rejected">İşdən Çıxmış</span>
                                }
                            </td>
                            @if (Model.Tab == "cixmis")
                            {
                                <td class="isci-td-meta">
                                    @(item.IsdenAyrilmaTarixi.HasValue
                                        ? item.IsdenAyrilmaTarixi.Value.ToString("dd.MM.yyyy")
                                        : "—")
                                </td>
                                <td class="isci-td-meta">
                                    <span title="@item.FesihSebebi">
                                        @(string.IsNullOrEmpty(item.FesihSebebi)
                                            ? "—"
                                            : (item.FesihSebebi.Length > 40
                                                ? item.FesihSebebi.Substring(0, 40) + "…"
                                                : item.FesihSebebi))
                                    </span>
                                </td>
                            }
                            <td class="isci-td-actions">
                                <a asp-action="Detail" asp-route-id="@item.Id" class="isci-action-btn" title="Bax">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                        <ellipse cx="7" cy="7" rx="6" ry="4" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="7" cy="7" r="1.8" stroke="currentColor" stroke-width="1.2" />
                                    </svg>
                                </a>
                                @if (!isCixmis)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="isci-action-btn" title="Redaktə">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M9.5 2.5l2 2-7 7H2.5v-2l7-7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                    <a asp-action="TeyinatDeyis" asp-route-id="@item.Id" class="isci-action-btn isci-action-btn--blue" title="Təyinat Dəyiş">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M2 5h10M9 2l3 3-3 3M12 9H2M5 6l-3 3 3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                    <a asp-action="MaasDeyis" asp-route-id="@item.Id" class="isci-action-btn isci-action-btn--green" title="Maaş Dəyiş">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" />
                                            <path d="M7 4v6M5 5.5h3a1 1 0 010 2H6a1 1 0 000 2h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                        </svg>
                                    </a>
                                    <button class="isci-action-btn isci-action-btn--red btn-isden-cixar"
                                            title="İşdən Çıxar"
                                            data-id="@item.Id"
                                            data-ad="@item.TamAd">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M9 2H5a1 1 0 00-1 1v8a1 1 0 001 1h4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                            <path d="M11 7H6M9 5l2 2-2 2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <button class="isci-action-btn isci-action-btn--green btn-isey-geri"
                                            title="Yenidən Aktiv Et"
                                            data-id="@item.Id"
                                            data-ad="@item.TamAd">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M2 7a5 5 0 1010 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                            <path d="M2 4v3h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Model.Tab == "cixmis" ? 7 : 5)"
                            style="text-align:center;padding:48px;color:var(--fn-text-muted,#888);">
                            @if (string.IsNullOrEmpty(Model.Search))
                            {
                                <span>Nəticə tapılmadı.</span>
                            }
                            else
                            {
                                <span>&ldquo;@Model.Search&rdquo; üzrə nəticə tapılmadı.</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        var startPage = Math.Max(1, Model.CurrentPage - 2);
        var endPage   = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

        <nav style="display:flex;justify-content:center;align-items:center;gap:4px;margin-top:16px;flex-wrap:wrap;">
            @* Prev *@
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-search="@Model.Search"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   class="fn-btn fn-btn--ghost" style="min-width:36px;padding:6px 10px;">
                    ‹
                </a>
            }
            else
            {
                <span class="fn-btn fn-btn--ghost" style="min-width:36px;padding:6px 10px;opacity:.4;cursor:default;">‹</span>
            }

            @* Page numbers *@
            @for (int i = startPage; i <= endPage; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span class="fn-btn fn-btn--primary" style="min-width:36px;padding:6px 10px;cursor:default;">@i</span>
                }
                else
                {
                    <a asp-action="Index"
                       asp-route-tab="@Model.Tab"
                       asp-route-search="@Model.Search"
                       asp-route-page="@i"
                       class="fn-btn fn-btn--ghost" style="min-width:36px;padding:6px 10px;">@i</a>
                }
            }

            @* Next *@
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-search="@Model.Search"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   class="fn-btn fn-btn--ghost" style="min-width:36px;padding:6px 10px;">
                    ›
                </a>
            }
            else
            {
                <span class="fn-btn fn-btn--ghost" style="min-width:36px;padding:6px 10px;opacity:.4;cursor:default;">›</span>
            }
        </nav>
        <div style="text-align:center;margin-top:6px;color:var(--fn-text-muted,#888);font-size:13px;">
            Ümumi @Model.TotalCount işçi &bull; Səhifə @Model.CurrentPage / @Model.TotalPages
        </div>
    }
</div>

@* İşdən Çıxar Modal *@
<div id="isdenCixarModal" class="fn-modal-backdrop" style="display:none;">
    <div class="fn-modal" style="max-width:460px;">
        <div class="fn-modal-header">
            <div class="fn-modal-title">İşdən Çıxar</div>
            <button class="fn-modal-close" onclick="closeIsdenCixarModal()">×</button>
        </div>
        <div class="fn-modal-body">
            <div class="isci-cixar-name" id="cixar-isci-name"></div>
            <input type="hidden" id="cixar-isci-id" />
            <div class="fn-form-group">
                <label class="fn-label">İşdən ayrılma tarixi <span class="req">*</span></label>
                <input type="date" id="cixar-tarix" class="fn-input" />
                <div class="isci-cixar-qeyd" style="margin-top:6px;font-size:12px;line-height:1.5;color:#64748b;background:#f8fafc;border:1px solid #e2e8f0;border-left:3px solid #2563eb;border-radius:6px;padding:8px 10px;">
                    ℹ️ Bu tarix işçinin <b>son iş günüdür</b> — həmin günə (o gün <b>daxil</b> olmaqla) maaş hesablanır, sonrakı günlər ödənilmir.
                    Yəni son iş günü hansıdırsa, məhz onu yazın (növbəti günü yox).
                </div>
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Çıxma səbəbi <span class="req">*</span></label>
                <textarea id="cixar-sebeb" class="fn-input" rows="3"
                          placeholder="Öz arzusu ilə, müqavilənin bitməsi, intizam pozuntusu..."></textarea>
            </div>
            <div id="cixar-error" class="isci-modal-error" style="display:none;"></div>
        </div>
        <div class="fn-modal-footer">
            <button class="fn-btn fn-btn--ghost" onclick="closeIsdenCixarModal()">Ləğv et</button>
            <button class="fn-btn fn-btn--danger" onclick="submitIsdenCixar()" id="cixar-submit-btn">
                İşdən Çıxar
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.btn-isden-cixar').forEach(function (btn) {
        btn.addEventListener('click', function () {
            openIsdenCixarModal(this.dataset.id, this.dataset.ad);
        });
    });
    document.querySelectorAll('.btn-isey-geri').forEach(function (btn) {
        btn.addEventListener('click', function () {
            iseyiGeri(this.dataset.id, this.dataset.ad);
        });
    });
});

function openIsdenCixarModal(isciId, tamAd) {
    document.getElementById('cixar-isci-id').value = isciId;
    document.getElementById('cixar-isci-name').textContent = tamAd;
    document.getElementById('cixar-tarix').value = new Date().toISOString().split('T')[0];
    document.getElementById('cixar-sebeb').value = '';
    var errEl = document.getElementById('cixar-error');
    if (errEl) errEl.style.display = 'none';
    document.getElementById('isdenCixarModal').style.display = 'flex';
}

function closeIsdenCixarModal() {
    document.getElementById('isdenCixarModal').style.display = 'none';
}

async function submitIsdenCixar() {
    const isciId = parseInt(document.getElementById('cixar-isci-id').value);
    const tarix  = document.getElementById('cixar-tarix').value;
    const sebeb  = document.getElementById('cixar-sebeb').value.trim();
    const errEl  = document.getElementById('cixar-error');
    const btn    = document.getElementById('cixar-submit-btn');

    errEl.style.display = 'none';
    if (!tarix) { showCixarErr('Tarix seçilməlidir.'); return; }
    if (!sebeb) { showCixarErr('Səbəb daxil edilməlidir.'); return; }

    btn.disabled = true;
    try {
        const res = await fetch('@Url.Action("IsdenCixar", "Isci")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ isciId, tarix, sebeb })
        });
        const data = await res.json();
        if (data.success) {
            location.reload();
        } else {
            showCixarErr(data.message);
        }
    } catch { showCixarErr('Xəta baş verdi.'); }
    finally { btn.disabled = false; }
}

function showCixarErr(msg) {
    const el = document.getElementById('cixar-error');
    el.textContent = msg;
    el.style.display = '';
}

async function iseyiGeri(isciId, tamAd) {
    if (!confirm(`"${tamAd}" yenidən aktiv edilsin?`)) return;
    try {
        const res = await fetch('@Url.Action("IseyiGeri", "Isci")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(parseInt(isciId))
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.message);
    } catch { alert('Xəta baş verdi.'); }
}
</script>
}
