@model FinNex.UI.Areas.HR.ViewModels.IsciEditVM
@using FinNex.Domain.Entities.HR

@{
    ViewData["Title"] = "İşçi Redaktəsi";
    Layout = "_HRLayout";
}

<div class="form-page-header">
    <a asp-action="Detail" asp-route-id="@Model.Id" class="form-back-link">
        <i class="bi bi-arrow-left"></i> Geriyə
    </a>
    <div>
        <h2 class="form-page-title">İşçi Redaktəsi</h2>
        <p class="form-page-sub">Şəxsi məlumatları yeniləyin</p>
    </div>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post" id="editForm">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert-error"></div>

        <div class="section-label">
            <i class="bi bi-person-fill"></i> Şəxsi Məlumatlar
        </div>

        <div class="form-grid-3">
            <div class="form-field">
                <label asp-for="Ad">Ad <span class="req">*</span></label>
                <input asp-for="Ad" class="form-input" placeholder="Ad" />
                <span asp-validation-for="Ad" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="Soyad">Soyad <span class="req">*</span></label>
                <input asp-for="Soyad" class="form-input" placeholder="Soyad" />
                <span asp-validation-for="Soyad" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="AtaAdi">Ata Adı</label>
                <input asp-for="AtaAdi" class="form-input" placeholder="Ata adı" />
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-field">
                <label asp-for="FIN">FIN <span class="req">*</span></label>
                <input asp-for="FIN" class="form-input input-mono" placeholder="FIN kod" maxlength="7" style="text-transform:uppercase" />
                <span asp-validation-for="FIN" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="SeriyaNomre">Şəxsiyyət Vəsiqəsi <span class="req">*</span></label>
                <input asp-for="SeriyaNomre" class="form-input input-mono" placeholder="AA1234567" />
                <span asp-validation-for="SeriyaNomre" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="DogumTarixi">Doğum Tarixi <span class="req">*</span></label>
                <input asp-for="DogumTarixi" type="date" class="form-input" />
                <span asp-validation-for="DogumTarixi" class="error-text"></span>
            </div>
        </div>

        <div class="form-grid-3">
            <div class="form-field">
                <label asp-for="CinsId">Cins <span class="req">*</span></label>
                <select asp-for="CinsId" class="form-select">
                    <option value="">Seçin</option>
                    <option value="0">Kişi</option>
                    <option value="1">Qadın</option>
                </select>
                <span asp-validation-for="CinsId" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="Telefon">Telefon</label>
                <input asp-for="Telefon" type="tel" class="form-input" placeholder="+994501234567" />
            </div>
            <div class="form-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="form-input" placeholder="email@example.com" />
                <span asp-validation-for="Email" class="error-text"></span>
            </div>
        </div>

        <div class="form-field full-width">
            <label asp-for="Unvan">Ünvan</label>
            <input asp-for="Unvan" class="form-input" placeholder="Yaşayış ünvanı" />
        </div>

        <div class="section-label mt-20">
            <i class="bi bi-briefcase-fill"></i> İş Məlumatları
        </div>

        <div class="form-grid-3">
            <div class="form-field">
                <label asp-for="IsheQebulTarixi">İşə Qəbul Tarixi <span class="req">*</span></label>
                <input asp-for="IsheQebulTarixi" type="date" class="form-input" />
                <span asp-validation-for="IsheQebulTarixi" class="error-text"></span>
            </div>
            <div class="form-field">
                <label asp-for="IsdenAyrilmaTarixi">İşdən Ayrılma Tarixi</label>
                <input asp-for="IsdenAyrilmaTarixi" type="date" class="form-input" />
            </div>
            <div class="form-field">
                <label asp-for="Status">Status <span class="req">*</span></label>
                <select asp-for="Status" class="form-select">
                    <option value="0">Aktiv</option>
                    <option value="1">Qeyri-aktiv</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">
                <i class="bi bi-check-lg"></i> Yadda Saxla
            </button>
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn-cancel">
                <i class="bi bi-x-lg"></i> Ləğv Et
            </a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/hr/isci-edit.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
