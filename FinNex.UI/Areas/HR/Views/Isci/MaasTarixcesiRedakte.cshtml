@model FinNex.UI.Areas.HR.ViewModels.MaasTarixcesiRedakteVM
@{
    ViewData["Title"] = "Maaş Qeydi Redaktəsi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HR/isci.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="isci-form-wrap">

        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="isci-form-back">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            İşçi məlumatlarına qayıt
        </a>

        @if (Model.EnSonQeyddirmi)
        {
            <div class="fn-alert fn-alert--warn" style="margin-bottom:12px;">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex-shrink:0">
                    <path d="M7 1.5L13 12.5H1L7 1.5z" stroke="#c9900a" stroke-width="1.2" stroke-linejoin="round"/>
                    <path d="M7 5.5v3M7 10v.5" stroke="#c9900a" stroke-width="1.1" stroke-linecap="round"/>
                </svg>
                Bu ən son maaş qeydidir — yeni maaş dəyişsə işçinin <strong>cari maaşı</strong> da avtomatik yenilənəcək.
            </div>
        }

        <div class="isci-form-card">
            <div class="isci-form-header">
                <div class="isci-form-header-icon isci-form-header-icon--green">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 13l3 3 9-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div>
                    <div class="isci-form-header-title">Maaş Qeydi Redaktəsi</div>
                    <div class="isci-form-header-sub">@Model.IsciTamAd · @Model.DeyismeTarixi.ToString("dd.MM.yyyy")</div>
                </div>
            </div>

            <form asp-action="MaasTarixcesiRedakte" method="post" id="redakteForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="IsciId" />
                <input type="hidden" asp-for="IsciTamAd" />
                <input type="hidden" asp-for="KohneMaas" />
                <input type="hidden" asp-for="DeyismeTarixi" />
                <input type="hidden" asp-for="EnSonQeyddirmi" />

                <div asp-validation-summary="ModelOnly" class="fn-alert fn-alert--error" style="margin:16px 24px 0;"></div>

                <div class="isci-form-body">

                    <!-- Köhnə maaş (oxunuş üçün) -->
                    <div class="isci-field">
                        <label class="isci-label">Köhnə Maaş</label>
                        <div class="isci-input-prefix-wrap">
                            <span class="isci-input-prefix">₼</span>
                            <input type="text" class="isci-input isci-input--has-prefix"
                                   value="@Model.KohneMaas.ToString("N2")" readonly
                                   style="background:#f9fafb;color:#6b7280;cursor:default;" />
                        </div>
                    </div>

                    <!-- Yeni maaş (redaktə) -->
                    <div class="isci-field">
                        <label class="isci-label">Yeni Maaş (₼) <span class="isci-required">*</span></label>
                        <div class="isci-input-prefix-wrap">
                            <span class="isci-input-prefix">₼</span>
                            <input asp-for="YeniMaas" type="number" step="0.01" min="0.01"
                                   class="isci-input isci-input--has-prefix" id="yeniMaasInp"
                                   placeholder="0.00" />
                        </div>
                        <span asp-validation-for="YeniMaas" class="isci-error"></span>
                    </div>

                    <!-- Diff preview -->
                    <div class="isci-diff-preview" id="diffPreview" style="display:none;">
                        <div class="isci-diff-from">@Model.KohneMaas.ToString("N2") ₼</div>
                        <div class="isci-diff-arrow">→</div>
                        <div class="isci-diff-to" id="diffTo">—</div>
                        <div class="isci-diff-amount" id="diffAmount"></div>
                    </div>

                    <!-- Əmr nömrəsi -->
                    <div class="isci-field">
                        <label class="isci-label">Əmr Nömrəsi</label>
                        <input asp-for="EmrNomresi" class="isci-input" placeholder="Məs: Əmr №12/2024" />
                        <span asp-validation-for="EmrNomresi" class="isci-error"></span>
                    </div>

                    <div class="isci-hint">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" style="flex-shrink:0;margin-top:1px;">
                            <circle cx="7" cy="7" r="6" stroke="#c9900a" stroke-width="1.3" />
                            <path d="M7 4.5v3M7 9.5v.5" stroke="#c9900a" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                        Köhnə maaş dəyişdirilmir — yalnız yeni maaş və əmr nömrəsi redaktə oluna bilər.
                    </div>

                </div>

                <div class="isci-form-footer">
                    <div class="isci-form-footer-note">* olan sahələr məcburidir</div>
                    <div class="isci-form-footer-actions">
                        <a asp-action="Detail" asp-route-id="@Model.IsciId" class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary" style="background:#1a7a50;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Yadda Saxla
                        </button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const kohneMaas = @Model.KohneMaas;
        const inp = document.getElementById('yeniMaasInp');
        const preview = document.getElementById('diffPreview');
        const diffTo = document.getElementById('diffTo');
        const diffAmount = document.getElementById('diffAmount');
        inp.addEventListener('input', function () {
            const val = parseFloat(this.value);
            if (!isNaN(val) && val > 0) {
                preview.style.display = 'flex';
                diffTo.textContent = val.toFixed(2) + ' ₼';
                const f = val - kohneMaas;
                diffAmount.textContent = (f >= 0 ? '+' : '') + f.toFixed(2) + ' ₼';
                diffAmount.style.background = f >= 0 ? 'rgba(30,155,107,.10)' : 'rgba(239,68,68,.10)';
                diffAmount.style.color = f >= 0 ? '#1a7a50' : '#dc2626';
            } else {
                preview.style.display = 'none';
            }
        });
    </script>
}
