@using FinNex.Domain.Entities.HR
@model List<Teklif>
@{
    ViewData["Title"] = "Təkliflər";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var cols = new[]
    {
        (Status: TeklifStatus.Gozlemede,  Label: "Gözlənilir",  HdrCls: "kn-hdr-gray",  Icon: "bi-hourglass-split"),
        (Status: TeklifStatus.Baxilir,    Label: "Baxılır",     HdrCls: "kn-hdr-blue",  Icon: "bi-eye-fill"),
        (Status: TeklifStatus.Tamamlandi, Label: "Tamamlandı",  HdrCls: "kn-hdr-green", Icon: "bi-check-circle-fill"),
        (Status: TeklifStatus.ReddEdildi, Label: "Rədd edildi", HdrCls: "kn-hdr-red",   Icon: "bi-x-circle-fill"),
    };

    static (string icon, string label, string color, string bg) NovInfo(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => ("bi-exclamation-triangle-fill", "Boşluq",  "#f59e0b", "#fffbeb"),
        TeklifNov.Sikayat         => ("bi-megaphone-fill",            "Şikayət", "#ef4444", "#fef2f2"),
        _                         => ("bi-lightbulb-fill",            "Teklif",  "#6366f1", "#eef2ff"),
    };

    static string PrioritetLabel(TeklifPrioritet p) => p switch
    {
        TeklifPrioritet.Yuksek => "⬆ Yüksək",
        TeklifPrioritet.Asagi  => "⬇ Aşağı",
        _                      => "➡ Orta"
    };
    static string PrioritetCls(TeklifPrioritet p) => p switch
    {
        TeklifPrioritet.Yuksek => "kn-pr-y",
        TeklifPrioritet.Asagi  => "kn-pr-a",
        _                      => "kn-pr-o"
    };

    static string Initials(string? ad, string? soyad)
    {
        var a = string.IsNullOrWhiteSpace(ad)    ? "?" : ad.Trim()[0].ToString().ToUpper();
        var s = string.IsNullOrWhiteSpace(soyad) ? ""  : soyad.Trim()[0].ToString().ToUpper();
        return a + s;
    }
    static string AvatarColor(string? name)
    {
        var colors = new[] { "#6366f1","#0ea5e9","#10b981","#f59e0b","#ec4899","#8b5cf6","#14b8a6","#f97316" };
        return colors[Math.Abs((name ?? "?").GetHashCode()) % colors.Length];
    }
}

<!-- Başlıq -->
<div class="kn-page-hdr">
    <div>
        <h4 class="kn-page-title"><i class="bi bi-lightbulb-fill me-2"></i>Təkliflər</h4>
    </div>
    <!-- Stat pills -->
    <div class="kn-pills">
        @foreach (var col in cols)
        {
            <span class="kn-pill kn-pill-@col.HdrCls.Split('-')[2]">
                <i class="bi @col.Icon"></i>
                <strong>@Model.Count(x => x.Status == col.Status)</strong>
                @col.Label
            </span>
        }
        <span class="kn-pill kn-pill-total">
            <i class="bi bi-collection-fill"></i>
            <strong>@Model.Count</strong> Cəmi
        </span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="kn-flash kn-flash-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="kn-flash kn-flash-err"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]</div>
}

<!-- Kanban lövhəsi -->
<div class="kn-board">
    @foreach (var col in cols)
    {
        var cards = Model.Where(x => x.Status == col.Status).ToList();
        <div class="kn-col">
            <div class="kn-col-hdr @col.HdrCls">
                <i class="bi @col.Icon"></i>
                <span>@col.Label</span>
                <span class="kn-badge">@cards.Count</span>
            </div>
            <div class="kn-col-body">
                @if (!cards.Any())
                {
                    <div class="kn-empty">
                        <i class="bi bi-inbox"></i>
                        <span>Boşdur</span>
                    </div>
                }
                @foreach (var item in cards)
                {
                    var nov    = NovInfo(item.Nov);
                    var av     = Initials(item.Isci?.Ad, item.Isci?.Soyad);
                    var avClr  = AvatarColor(item.Isci?.TamAd);
                    <div class="kn-card"
                         style="--nov-clr:@nov.color; --nov-bg:@nov.bg"
                         data-id="@item.Id"
                         data-bashliq="@item.Bashliq"
                         data-mezmun="@item.Mezmun"
                         data-isci="@(item.Isci?.TamAd ?? "")"
                         data-nov-icon="@nov.icon"
                         data-nov-label="@nov.label"
                         data-nov-clr="@nov.color"
                         data-nov-bg="@nov.bg"
                         data-prioritet="@((int)item.Prioritet)"
                         data-status="@((int)item.Status)"
                         data-cavab="@(item.Cavab ?? "")"
                         data-cavab-tarix="@(item.CavabTarixi?.ToString("dd.MM.yyyy HH:mm") ?? "")"
                         data-cavab-veren="@(item.CavabVeren?.TamAd ?? "")"
                         data-tarix="@item.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")"
                         data-av="@av"
                         data-av-clr="@avClr"
                         onclick="acModal(this)">

                        <!-- Növ şeridi -->
                        <div class="kn-card-nov-bar">
                            <span class="kn-card-nov-tag">
                                <i class="bi @nov.icon"></i> @nov.label
                            </span>
                            <span class="kn-pr @PrioritetCls(item.Prioritet)">
                                @PrioritetLabel(item.Prioritet)
                            </span>
                        </div>

                        <!-- İşçi -->
                        <div class="kn-card-isci">
                            <div class="kn-av" style="background:@avClr">@av</div>
                            <span class="kn-isci-ad">@(item.Isci?.TamAd ?? "—")</span>
                        </div>

                        <!-- Başlıq -->
                        <div class="kn-card-title">@item.Bashliq</div>

                        <!-- Alt məlumat -->
                        <div class="kn-card-foot">
                            <span class="kn-date"><i class="bi bi-calendar3"></i> @item.YaradilmaTarixi.ToString("dd.MM.yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(item.Cavab))
                            {
                                <span class="kn-has-cavab"><i class="bi bi-chat-left-text-fill"></i></span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ── Detail Modal ────────────────────────────────────── -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content kn-modal">

            <!-- Header -->
            <div class="modal-header kn-modal-hdr" id="modal-hdr">
                <div class="kn-modal-isci">
                    <div class="kn-av kn-av-lg" id="modal-av">??</div>
                    <div>
                        <div class="kn-modal-isci-ad" id="modal-isci">—</div>
                        <span class="kn-modal-nov-tag" id="modal-nov-tag">—</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body kn-modal-body">
                <div class="row g-3">
                    <!-- Sol: məzmun -->
                    <div class="col-md-7">
                        <div class="kn-modal-bashliq" id="modal-bashliq">—</div>
                        <div class="kn-modal-meta" id="modal-tarix"></div>
                        <div class="kn-modal-section-lbl">Məzmun</div>
                        <div class="kn-modal-mezmun" id="modal-mezmun">—</div>

                        <div id="modal-cavab-block" style="display:none">
                            <div class="kn-modal-section-lbl mt-2">
                                <i class="bi bi-chat-left-text-fill me-1"></i>Mövcud cavab
                                <span id="modal-cavab-tarix" class="kn-cavab-meta"></span>
                            </div>
                            <div class="kn-modal-cavab-box" id="modal-cavab-text">—</div>
                        </div>
                    </div>

                    <!-- Sağ: form -->
                    <div class="col-md-5">
                        <form method="post" asp-area="HR" asp-controller="Teklif" asp-action="Saxla" id="modal-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="modal-id" />

                            <div class="mb-3">
                                <label class="kn-lbl">Status</label>
                                <select name="status" id="modal-status" class="form-select kn-sel">
                                    <option value="0">⏳ Gözlənilir</option>
                                    <option value="1">👁 Baxılır</option>
                                    <option value="2">✅ Tamamlandı</option>
                                    <option value="3">❌ Rədd edildi</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="kn-lbl">Prioritet</label>
                                <select name="prioritet" id="modal-prioritet" class="form-select kn-sel">
                                    <option value="0">⬇ Aşağı</option>
                                    <option value="1">➡ Orta</option>
                                    <option value="2">⬆ Yüksək</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="kn-lbl">
                                    Cavab
                                    <span class="text-muted fw-normal small">(isteğe bağlı)</span>
                                </label>
                                <textarea name="cavab" id="modal-cavab"
                                          class="form-control kn-ta"
                                          placeholder="İşçiyə cavab yazın..." rows="5"></textarea>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="kn-btn-save flex-grow-1">
                                    <i class="bi bi-save2-fill me-1"></i>Yadda saxla
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                                    Ləğv
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function acModal(card) {
    const d = card.dataset;

    document.getElementById('modal-id').value        = d.id;
    document.getElementById('modal-isci').textContent  = d.isci || '—';
    document.getElementById('modal-bashliq').textContent = d.bashliq || '—';
    document.getElementById('modal-mezmun').textContent  = d.mezmun || '—';
    document.getElementById('modal-tarix').textContent   = d.tarix || '';
    document.getElementById('modal-status').value    = d.status;
    document.getElementById('modal-prioritet').value = d.prioritet;
    document.getElementById('modal-cavab').value     = d.cavab || '';

    // Avatar
    const av = document.getElementById('modal-av');
    av.textContent = d.av || '??';
    av.style.background = d.avClr || '#6366f1';

    // Header background
    document.getElementById('modal-hdr').style.background =
        `linear-gradient(135deg, ${d.novClr}dd, ${d.novClr})`;

    // Nov tag
    const tag = document.getElementById('modal-nov-tag');
    tag.innerHTML = `<i class="bi ${d.novIcon} me-1"></i>${d.novLabel}`;
    tag.style.background = d.novBg;
    tag.style.color = d.novClr;

    // Mövcud cavab
    const cavabBlock = document.getElementById('modal-cavab-block');
    if (d.cavab) {
        cavabBlock.style.display = '';
        document.getElementById('modal-cavab-text').textContent = d.cavab;
        document.getElementById('modal-cavab-tarix').textContent =
            d.cavabTarix ? '· ' + d.cavabTarix + (d.cavabVeren ? ' (' + d.cavabVeren + ')' : '') : '';
    } else {
        cavabBlock.style.display = 'none';
    }

    new bootstrap.Modal(document.getElementById('detailModal')).show();
}
</script>
}

@section Styles {
<style>
/* ── Başlıq ──────────────────────────────────────────── */
.kn-page-hdr {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: .75rem;
    margin-bottom: 1.2rem;
}
.kn-page-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0;
}
.kn-pills {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
}
.kn-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .76rem;
    padding: 4px 11px;
    border-radius: 20px;
    font-weight: 600;
}
.kn-pill-gray  { background:#f1f5f9; color:#475569; }
.kn-pill-blue  { background:#dbeafe; color:#1e40af; }
.kn-pill-green { background:#d1fae5; color:#065f46; }
.kn-pill-red   { background:#fee2e2; color:#991b1b; }
.kn-pill-total { background:#ede9fe; color:#4c1d95; }

/* ── Flash ───────────────────────────────────────────── */
.kn-flash {
    border-radius: 8px;
    padding: .65rem 1rem;
    font-size: .87rem;
    margin-bottom: 1rem;
}
.kn-flash-ok  { background:#d1fae5; color:#065f46; }
.kn-flash-err { background:#fee2e2; color:#991b1b; }

/* ── Board ───────────────────────────────────────────── */
.kn-board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    align-items: start;
}
@@media (max-width: 900px) { .kn-board { grid-template-columns: repeat(2,1fr); } }
@@media (max-width: 540px) { .kn-board { grid-template-columns: 1fr; } }

/* ── Column ──────────────────────────────────────────── */
.kn-col {
    background: #f1f5f9;
    border-radius: 14px;
    overflow: hidden;
}
.kn-col-hdr {
    display: flex;
    align-items: center;
    gap: .45rem;
    padding: .65rem 1rem;
    font-size: .82rem;
    font-weight: 700;
    color: #fff;
}
.kn-hdr-gray  { background: #64748b; }
.kn-hdr-blue  { background: #2563eb; }
.kn-hdr-green { background: #16a34a; }
.kn-hdr-red   { background: #dc2626; }
.kn-badge {
    margin-left: auto;
    background: rgba(255,255,255,.25);
    border-radius: 20px;
    padding: 1px 9px;
    font-size: .73rem;
}
.kn-col-body {
    padding: .75rem;
    display: flex;
    flex-direction: column;
    gap: .65rem;
    min-height: 80px;
}
.kn-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .3rem;
    padding: 2rem 0;
    color: #cbd5e1;
    font-size: .78rem;
}
.kn-empty i { font-size: 1.6rem; }

/* ── Card ────────────────────────────────────────────── */
.kn-card {
    background: #fff;
    border-radius: 12px;
    padding: 0;
    cursor: pointer;
    box-shadow: 0 1px 3px rgba(0,0,0,.07);
    border: 1px solid #e8edf3;
    overflow: hidden;
    transition: box-shadow .15s, transform .12s;
    border-top: 3px solid var(--nov-clr, #6366f1);
}
.kn-card:hover {
    box-shadow: 0 6px 18px rgba(0,0,0,.12);
    transform: translateY(-2px);
}

/* Nov şeridi */
.kn-card-nov-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: .55rem .75rem .35rem;
    background: var(--nov-bg, #eef2ff);
}
.kn-card-nov-tag {
    font-size: .72rem;
    font-weight: 800;
    color: var(--nov-clr, #6366f1);
    display: flex;
    align-items: center;
    gap: .3rem;
    letter-spacing: .02em;
    text-transform: uppercase;
}

/* İşçi -->
.kn-card-isci {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .5rem .75rem .25rem;
}
.kn-isci-ad {
    font-size: .8rem;
    font-weight: 700;
    color: #334155;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Başlıq */
.kn-card-title {
    font-size: .88rem;
    font-weight: 700;
    color: #1e293b;
    padding: .1rem .75rem .4rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
}

/* Alt -->
.kn-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .35rem .75rem .55rem;
    border-top: 1px solid #f1f5f9;
}
.kn-date {
    font-size: .72rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: .25rem;
}
.kn-has-cavab {
    font-size: .78rem;
    color: #6366f1;
}

/* Avatar -->
.kn-av {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .68rem;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
}
.kn-av-lg { width: 44px; height: 44px; font-size: 1rem; }

/* Prioritet -->
.kn-pr {
    font-size: .68rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 20px;
    white-space: nowrap;
}
.kn-pr-y { background: #fee2e2; color: #b91c1c; }
.kn-pr-o { background: #fef9c3; color: #92400e; }
.kn-pr-a { background: #f1f5f9; color: #64748b; }

/* ── Modal ───────────────────────────────────────────── */
.kn-modal { border: none; border-radius: 16px; overflow: hidden; }
.kn-modal-hdr {
    padding: 1.1rem 1.3rem;
    border: none;
    transition: background .2s;
}
.kn-modal-isci {
    display: flex;
    align-items: center;
    gap: .75rem;
}
.kn-modal-isci-ad {
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: .2rem;
}
.kn-modal-nov-tag {
    font-size: .73rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 20px;
    letter-spacing: .03em;
}
.kn-modal-body { padding: 1.3rem; background: #fff; }
.kn-modal-bashliq {
    font-size: 1.05rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: .25rem;
}
.kn-modal-meta {
    font-size: .77rem;
    color: #94a3b8;
    margin-bottom: .9rem;
}
.kn-modal-section-lbl {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #94a3b8;
    margin-bottom: .4rem;
}
.kn-modal-mezmun {
    font-size: .86rem;
    color: #334155;
    line-height: 1.65;
    white-space: pre-wrap;
    background: #f8fafc;
    border-radius: 10px;
    padding: .8rem 1rem;
    margin-bottom: .5rem;
}
.kn-modal-cavab-box {
    font-size: .85rem;
    color: #3b0764;
    line-height: 1.55;
    white-space: pre-wrap;
    background: #ede9fe;
    border-radius: 10px;
    padding: .75rem 1rem;
    margin-top: .35rem;
}
.kn-cavab-meta { font-size: .72rem; color: #7c3aed; font-weight: 400; }

.kn-lbl {
    font-size: .82rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: .3rem;
    display: block;
}
.kn-sel, .kn-ta {
    border-radius: 8px;
    border-color: #e2e8f0;
    font-size: .85rem;
}
.kn-sel:focus, .kn-ta:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.15);
}
.kn-ta { resize: vertical; }
.kn-btn-save {
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .5rem 1rem;
    font-size: .85rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity .15s;
}
.kn-btn-save:hover { opacity: .88; }
</style>
}
