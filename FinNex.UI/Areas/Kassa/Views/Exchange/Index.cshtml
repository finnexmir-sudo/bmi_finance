@model ExchangeIndexVM
@using System.Globalization
@{
    ViewData["Title"] = "Exchange — Valyuta kursu";

    var g = Model.Gunluk;
    // 12.10.2026 — "Index" (göstərmə) indi hər giriş etmiş işçiyə açıqdır
    // (kurs başqa yerdə də istifadə olunur, oxumaq/kopyalamaq bloklanmır).
    // Yazma (Saxla) və sənəd (Word) server tərəfdə hələ də Kassa/Admin-lədir
    // ([Authorize(Roles=...)] birbaşa action-larda) — bu bayraq yalnız
    // görüntünü uyğunlaşdırır ki, qeyri-Kassa işçi klikləyib Access Denied-ə
    // düşməsin.
    var canEdit = User.IsInRole(RoleNames.Kassa) || User.IsInRole(RoleNames.Admin);
    string V(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";
    decimal? Pay(string valyuta, Func<FinNex.Application.DTOs.Kassa.KassaKursSetriDto, decimal?> sel)
        => g.Setirler.FirstOrDefault(x => x.Valyuta == valyuta) is { } s ? sel(s) : null;

    var statusBadge = g.Status switch
    {
        FinNex.Domain.Entities.Kassa.KassaKursStatus.Gozleyir => ("Gözləyir", "fn-badge--wait"),
        FinNex.Domain.Entities.Kassa.KassaKursStatus.Tesdiqlendi => ("Təsdiqləndi", "fn-badge--approved"),
        FinNex.Domain.Entities.Kassa.KassaKursStatus.Imtina => ("İmtina edilib", "fn-badge--rejected"),
        _ => ((string?)null, "")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/Kassa/exchange.css" asp-append-version="true" />
}

@* MB (CBAR) kursu kartı MÜVƏQQƏTİ YIĞIŞDIRILDI (13.10.2026, istifadəçi qərarı) —
   rəqəm Oracle-dakı `kurval`/`func_get_kurval`-dan gəlirdi, bu isə canlı CBAR
   mənbəyi deyil (bax CLAUDE.md "Gələn/Göndərilən Mail Saatı" bölməsindən sonrakı
   müzakirə). İstifadəçi: "menasiz olur, yene men yazdigimdir". Əsl CBAR inteqrasiyası
   qurulana qədər kart göstərilmir — `ExchangeIndexVM.UsdMbKurs/AvroMbKurs/MbTarix`
   və controller-dəki çağırış da bununla birlikdə silindi. `IBmiValyutaService.
   KursAsync`-in ÖZÜ TOXUNULMADI — Pul Köçürməsinin 20 000 USD limiti (KocurmeLimit.cs)
   onu hələ işlədir, bu, tamam ayrı və kritik bir funksiyadır. *@
<div class="fn-page">
    <div class="kx-top-row">
        <a asp-action="Index" asp-controller="ExchangeTesdiq" class="fn-btn fn-btn--outline">
            <i class="bi bi-check2-circle"></i> Təsdiq ekranı
        </a>
    </div>

    <div class="fn-card">
        <form method="get" asp-action="Index" class="kx-date-row mb-3">
            <div>
                <label>Tarix</label>
                <input type="date" name="tarix" class="fn-input" value="@g.Tarix.ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit" class="fn-btn fn-btn--outline"><i class="bi bi-search"></i> Göstər</button>

            @if (statusBadge.Item1 != null)
            {
                <span class="fn-badge @statusBadge.Item2">@statusBadge.Item1</span>
            }

            @if (canEdit && g.BeyannameId.HasValue)
            {
                <a asp-action="Word" asp-route-beyannameId="@g.BeyannameId" class="fn-btn fn-btn--outline">
                    <i class="bi bi-file-earmark-word"></i> Word sənədi
                </a>
            }
        </form>

        @if (g.Status == FinNex.Domain.Entities.Kassa.KassaKursStatus.Imtina && !string.IsNullOrWhiteSpace(g.ImtinaSebebi))
        {
            <div class="fn-info-box mb-3">
                <i class="bi bi-x-circle"></i>
                <span><b>İmtina səbəbi (@g.TesdiqEdenAdi):</b> @g.ImtinaSebebi — düzəliş edib yenidən göndərə bilərsiniz.</span>
            </div>
        }
        @if (g.Status == FinNex.Domain.Entities.Kassa.KassaKursStatus.Gozleyir)
        {
            <div class="fn-info-box mb-3">
                <i class="bi bi-hourglass-split"></i>
                <span>Bu günün kursu göndərilib, təsdiq gözləyir — təsdiqlənənə/imtina olunana qədər yenidən yazıla bilməz.</span>
            </div>
        }
        @if (g.Status == FinNex.Domain.Entities.Kassa.KassaKursStatus.Tesdiqlendi)
        {
            <div class="fn-info-box mb-3">
                <i class="bi bi-check-circle"></i>
                <span>Bu günün kursu təsdiqlənib (@g.TesdiqEdenAdi, @g.TesdiqTarixi?.ToString("dd.MM.yyyy HH:mm")) — gün ərzində kurs dəyişibsə aşağıda yeni dəyər yazıb göndərə bilərsiniz, əvvəlki təsdiqlənmiş kurs "Son qeydlər"də qalır.</span>
            </div>
        }

        <form method="post" asp-action="Saxla">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Tarix" value="@g.Tarix.ToString("yyyy-MM-dd")" />

            <div class="table-responsive">
                <table class="kx-table">
                    <thead>
                        <tr>
                            <th>Valyuta</th>
                            <th>Nağd Alış</th>
                            <th>Nağd Satış</th>
                            <th>Qeyri nağd Alış</th>
                            <th>Qeyri nağd Satış</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var valyutalar = new (string Kod, string Ad)[]
                            {
                                ("USD", "USD"), ("AVRO", "AVRO"), ("IRR", "IRR"), ("AED", "AED"), ("RUB", "RUB")
                            };
                        }
                        @foreach (var v in valyutalar)
                        {
                            <tr>
                                @* `readonly` İŞLƏDİLİR, `disabled` YOX (12.10.2026) — disabled input-un
                                   mətni brauzerdə seçilə/kopyalana bilmir (bəzi brauzerlərdə kursor
                                   belə düşmür), halbuki tələb elə BUDUR: qeyri-Kassa işçi rəqəmi
                                   seçib köçürə bilsin. `readonly` input-u redaktəyə bağlayır, amma
                                   seçim/Ctrl+C-ni sərbəst qoyur. *@
                                <td class="kx-val">@v.Ad</td>
                                <td><input type="number" step="any" class="fn-input" name="@(v.Kod)_NA" value="@V(Pay(v.Kod, x => x.NagdAlis))" readonly="@(!canEdit || !g.YazaBiler)" /></td>
                                <td><input type="number" step="any" class="fn-input" name="@(v.Kod)_NS" value="@V(Pay(v.Kod, x => x.NagdSatis))" readonly="@(!canEdit || !g.YazaBiler)" /></td>
                                <td><input type="number" step="any" class="fn-input" name="@(v.Kod)_QNA" value="@V(Pay(v.Kod, x => x.QeyriNagdAlis))" readonly="@(!canEdit || !g.YazaBiler)" /></td>
                                <td><input type="number" step="any" class="fn-input" name="@(v.Kod)_QNS" value="@V(Pay(v.Kod, x => x.QeyriNagdSatis))" readonly="@(!canEdit || !g.YazaBiler)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (canEdit && g.YazaBiler)
            {
                var gonderMetni = g.Status switch
                {
                    FinNex.Domain.Entities.Kassa.KassaKursStatus.Imtina => "Yenidən göndər",
                    FinNex.Domain.Entities.Kassa.KassaKursStatus.Tesdiqlendi => "Yeni kurs göndər",
                    _ => "İcra et"
                };
                <button type="submit" class="fn-btn fn-btn--primary mt-3">
                    <i class="bi bi-send"></i> @gonderMetni
                </button>
            }
        </form>
    </div>

    <div class="fn-card mt-3">
        <div class="fn-card-title mb-2">Son qeydlər</div>
        <div class="table-responsive">
            <table class="kx-table">
                <thead>
                    <tr>
                        <th>Tarix</th><th>Valyuta</th><th>Nağd alış</th><th>Nağd satış</th>
                        <th>Qeyri nağd alış</th><th>Qeyri nağd satış</th><th>İcraçı</th><th>Status</th>
                        <th>Təsdiqləyən</th><th>Təsdiq tarixi</th><th>Sənəd</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.SonQeydler.Any())
                    {
                        <tr><td colspan="11" class="text-center text-muted py-3">Qeyd tapılmadı.</td></tr>
                    }
                    else
                    {
                        // Hər beyannamənin 5 valyuta sətri var — Word düyməsi (bütöv
                        // günün sənədini yaradır) grup üzrə TƏKRARLANMASIN, yalnız
                        // ilk görünən sətirdə göstərilir. (Artıq C# kontekstindəyik —
                        // yeni kod bloku açmaq lazım deyil, birbaşa yaz; bax CLAUDE.md
                        // "Razor — @if bloku içində kod bloku açma" bölməsi, RZ1010.)
                        var gorunenBeyanname = new HashSet<int>();
                        @foreach (var r in Model.SonQeydler)
                        {
                            var (ad, cls) = r.Status switch
                            {
                                FinNex.Domain.Entities.Kassa.KassaKursStatus.Gozleyir => ("Gözləyir", "fn-badge--wait"),
                                FinNex.Domain.Entities.Kassa.KassaKursStatus.Tesdiqlendi => ("Təsdiqləndi", "fn-badge--approved"),
                                _ => ("İmtina", "fn-badge--rejected")
                            };
                            var ilkGorunus = gorunenBeyanname.Add(r.BeyannameId);
                            <tr>
                                <td>@r.Tarix.ToString("dd.MM.yyyy")</td>
                                <td>@r.Valyuta</td>
                                <td>@V(r.NagdAlis)</td>
                                <td>@V(r.NagdSatis)</td>
                                <td>@V(r.QeyriNagdAlis)</td>
                                <td>@V(r.QeyriNagdSatis)</td>
                                <td>@r.IcraciAdi</td>
                                <td><span class="fn-badge @cls">@ad</span></td>
                                <td>@r.TesdiqEdenAdi</td>
                                <td>@r.TesdiqTarixi?.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (canEdit && ilkGorunus)
                                    {
                                        <a asp-action="Word" asp-route-beyannameId="@r.BeyannameId" title="Word sənədi">
                                            <i class="bi bi-file-earmark-word"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
