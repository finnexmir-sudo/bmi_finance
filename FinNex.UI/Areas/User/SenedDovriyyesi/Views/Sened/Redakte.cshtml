@model FinNex.UI.Areas.User.SenedDovriyyesi.ViewModels.SenedUpdateVM
@{
    ViewData["Title"] = "Sənədi Redaktə Et";
    // Layout = "~/Views/Shared/_SenedDovriyyesiLayout.cshtml";
}

<div class="sd-content">

    <!-- Breadcrumb / Top Info -->
    <div class="sd-detail-header mb-3 d-flex align-items-center gap-3">
        <div class="sd-detail-icon">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <h5 class="mb-0 fw-700">Sənədi Redaktə Et</h5>
            <div class="sd-topbar-breadcrumb mt-1">
                <a asp-action="Index">Sənəd Dövriyyəsi</a>
                <span class="mx-1 text-muted">/</span>
                <a asp-action="Detal" asp-route-id="@Model.Id">@Model.Basliq</a>
                <span class="mx-1 text-muted">/</span>
                <span class="text-muted">Redaktə</span>
            </div>
        </div>
        <div class="ms-auto">
            <a asp-action="Detal" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary sd-btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>

    <!-- Validation Summary -->
    <div asp-validation-summary="ModelOnly" class="alert alert-danger sd-alert sd-validation-summary" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Xəta:</strong>
        <div asp-validation-summary="ModelOnly"></div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger sd-alert d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-x-circle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <form asp-action="Redakte" asp-controller="Sened" method="post" id="updateForm" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="row g-3">

            <!-- LEFT: Main Form -->
            <div class="col-lg-8">
                <div class="sd-form-card">
                    <div class="sd-form-header d-flex align-items-center gap-2">
                        <i class="bi bi-card-text text-primary"></i>
                        Sənəd Məlumatları
                    </div>
                    <div class="sd-form-body">

                        <!-- SECTION 1: Struktur -->
                        <div class="sd-form-section">
                            <div class="sd-form-section-title">
                                <span class="sd-step-number">1</span>
                                Struktur Məlumatları
                            </div>
                            <div class="row g-3">
                                <!-- Şöbə -->
                                <div class="col-md-6">
                                    <label asp-for="SobeId" class="sd-form-label">
                                        Şöbə <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="SobeId"
                                            asp-items="@(ViewBag.Sobeler as SelectList)"
                                            class="form-select form-select-sm">
                                        <option value="">— Şöbə seçin —</option>
                                    </select>
                                    <span asp-validation-for="SobeId" class="text-danger small"></span>
                                </div>

                                <!-- Sənəd Növü -->
                                <div class="col-md-6">
                                    <label asp-for="SenedNovuId" class="sd-form-label">
                                        Sənəd Növü <span class="text-danger">*</span>
                                    </label>
                                    <select asp-for="SenedNovuId"
                                            asp-items="@(ViewBag.SenedNovleri as SelectList)"
                                            class="form-select form-select-sm">
                                        <option value="">— Növ seçin —</option>
                                    </select>
                                    <span asp-validation-for="SenedNovuId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 2: Əsas Məlumatlar -->
                        <div class="sd-form-section">
                            <div class="sd-form-section-title">
                                <span class="sd-step-number">2</span>
                                Əsas Məlumatlar
                            </div>
                            <div class="row g-3">
                                <!-- Başlıq -->
                                <div class="col-12">
                                    <label asp-for="Basliq" class="sd-form-label">
                                        Başlıq <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="Basliq"
                                           class="form-control form-control-sm"
                                           placeholder="Sənədin tam başlığını daxil edin..." />
                                    <span asp-validation-for="Basliq" class="text-danger small"></span>
                                </div>

                                <!-- Açar Söz -->
                                <div class="col-12">
                                    <label asp-for="AcarSoz" class="sd-form-label">
                                        Açar Söz
                                        <span class="text-muted fw-normal" style="font-size:0.7rem;">(axtarış üçün)</span>
                                    </label>
                                    <input asp-for="AcarSoz"
                                           class="form-control form-control-sm"
                                           placeholder="Vergüllə ayrılmış açar sözlər..." />
                                    <span asp-validation-for="AcarSoz" class="text-danger small"></span>
                                    <div class="mt-1" style="font-size:0.72rem; color:var(--sd-text-muted);">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Nümunə: müqavilə, qaydalar, maliyyə, 2024
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECTION 3: Teqlər -->
                        <div class="sd-form-section">
                            <div class="sd-form-section-title">
                                <span class="sd-step-number">3</span>
                                Teqlər
                                <span class="text-muted fw-normal" style="font-size:0.75rem;">(isteğe bağlı)</span>
                            </div>

                            @if (ViewBag.Tags != null)
                            {
                                <div class="sd-tag-selector" id="tagSelector">
                                    @foreach (var tag in ViewBag.Tags as List<dynamic> ?? new List<dynamic>())
                                    {
                                        var isChecked = Model.TagIds != null && Model.TagIds.Contains((int)tag.Id);
                                        <label class="sd-tag-option">
                                            <input type="checkbox"
                                                   name="TagIds"
                                                   value="@tag.Id"
                                            @(isChecked ? "checked" : "") />
                                            <span class="sd-tag-label">
                                                <i class="bi bi-tag-fill me-1" style="font-size:0.65rem;"></i>@tag.Ad
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-muted" style="font-size:0.82rem;">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Mövcud teq yoxdur.
                                </div>
                            }
                        </div>

                    </div><!-- /sd-form-body -->
                </div><!-- /sd-form-card -->
            </div>

            <!-- RIGHT: Info Panel -->
            <div class="col-lg-4">

                <!-- Current File Info -->
                <div class="sd-card mb-3">
                    <div class="sd-card-header d-flex align-items-center gap-2">
                        <i class="bi bi-paperclip text-primary"></i>
                        Cari Fayl
                    </div>
                    <div class="sd-card-body">
                        <div class="sd-file-preview-info mb-2">
                            <div class="sd-file-icon">
                                <i class="bi bi-file-earmark-text text-primary"></i>
                            </div>
                            <div class="sd-file-details">
                                <div class="sd-file-name">@(ViewBag.CurrentFileName ?? "fayl.pdf")</div>
                                <div class="sd-file-meta">
                                    @(ViewBag.CurrentFileSize ?? "—") ·
                                    <span class="text-muted">Dəyişdirilmir</span>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-info py-2 px-3 mb-0" style="font-size:0.78rem; border-radius:6px;">
                            <i class="bi bi-info-circle me-1"></i>
                            Redaktə zamanı fayl dəyişdirilmir. Yeni versiya yükləmək üçün
                            <a asp-action="YeniVersiya" asp-route-id="@Model.Id" class="alert-link">buraya klik edin</a>.
                        </div>
                    </div>
                </div>

                <!-- Metadata Panel -->
                <div class="sd-card mb-3">
                    <div class="sd-card-header d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-secondary"></i>
                        Sistem Məlumatı
                    </div>
                    <div class="sd-card-body">
                        <div class="sd-meta-item border-bottom pb-2 mb-2">
                            <div class="sd-meta-label">Sənəd ID</div>
                            <div class="sd-meta-value">
                                <span class="sd-kod-badge">#@Model.Id</span>
                            </div>
                        </div>
                        <div class="sd-meta-item border-bottom pb-2 mb-2">
                            <div class="sd-meta-label">Yaradılma Tarixi</div>
                            <div class="sd-meta-value" style="font-size:0.82rem;">
                                @(ViewBag.YaradilmaTarixi ?? "—")
                            </div>
                        </div>
                        <div class="sd-meta-item">
                            <div class="sd-meta-label">Son Dəyişiklik</div>
                            <div class="sd-meta-value" style="font-size:0.82rem;">
                                @(ViewBag.SonDeyisiklik ?? "—")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="sd-card">
                    <div class="sd-card-body">
                        <button type="submit" class="btn btn-primary w-100 mb-2" id="submitBtn">
                            <i class="bi bi-check-lg me-2"></i>
                            Dəyişiklikləri Yadda Saxla
                        </button>
                        <a asp-action="Index" 
                           class="btn btn-outline-secondary w-100 mb-2">
                            <i class="bi bi-x-lg me-2"></i>
                            Ləğv Et
                        </a>
                        <!-- Danger Zone -->
                        <hr class="my-2">
                        <button type="button"
                                class="btn btn-outline-danger w-100 sd-btn-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal">
                            <i class="bi bi-trash me-1"></i>
                            Sənədi Sil
                        </button>
                    </div>
                </div>

            </div><!-- /col-lg-4 -->
        </div><!-- /row -->
    </form>
</div>

<!-- ============================================================
     Delete Confirmation Modal
     ============================================================ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content sd-modal">
            <div class="sd-modal-header d-flex align-items-center gap-2">
                <div style="width:32px;height:32px;border-radius:8px;background:rgba(220,53,69,0.1);
                            display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:0.9rem;"></i>
                </div>
                <h6 class="modal-title mb-0" id="deleteModalLabel">Sənədi Sil</h6>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p style="font-size:0.875rem;" class="mb-1">
                    <strong>@Model.Basliq</strong> adlı sənədi silmək istədiyinizə əminsiniz?
                </p>
                <p class="text-danger mb-0" style="font-size:0.8rem;">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    Bu əməliyyat geri alına bilməz. Bütün versiyalar silinəcək.
                </p>
            </div>
            <div class="modal-footer border-top py-2 px-4">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">
                    Ləğv Et
                </button>
                <form asp-action="Sil" asp-route-id="@Model.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash me-1"></i> Bəli, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Submit button loading state
        document.getElementById('updateForm').addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Saxlanılır...';
        });
    </script>
}
