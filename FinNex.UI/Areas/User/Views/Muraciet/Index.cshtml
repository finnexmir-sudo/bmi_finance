@model FinNex.UI.Areas.User.Models.MuracietPortalViewModel
@using FinNex.Domain.Entities.HR
@using FinNex.Application.DTOs.HR.Ezamiyyet
@{
    ViewData["Title"] = "Müraciətlərim";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    bool mezTab  = Model.AktivTab == "mezuniyyet";
    bool icazeTab = Model.AktivTab == "icaze";
    bool ezamiyyetTab = Model.AktivTab == "ezamiyyet";
    var bugun = DateTime.Today;

    // Workflow addımı: string → int (entity enum yox)
    int WorkflowStep(string merhele) => merhele switch
    {
        "Gözləmədə"               => 0,
        "Şöbə rəisi təsdiqində"   => 1,
        "Rəhbər təsdiqində"       => 2,
        "HR təsdiqində"           => 3,
        "Təsdiqlənib"             => 4,
        "İmtina edildi"           => -1,
        _                         => 0
    };

    string BadgeClass(string merhele) => merhele switch
    {
        "Təsdiqlənib"   => "fn-badge--done",
        "İmtina edildi" => "fn-badge--rejected",
        "Gözləmədə"     => "fn-badge--wait",
        _               => "fn-badge--review"
    };
}

<div class="fn-page">

    @* ── Başlıq ── *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müraciətlərim</div>
            <div class="fn-page-sub">Bütün müraciətlərinizi buradan izləyə bilərsiniz</div>
        </div>
        @if (mezTab)
        {
            <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
               class="fn-btn fn-btn--primary">+ Məzuniyyət müraciəti</a>
        }
        else if (icazeTab)
        {
            <a asp-area="User" asp-controller="Icaze" asp-action="Create"
               class="fn-btn fn-btn--primary">+ İcazə müraciəti</a>
        }
        else
        {
            <a asp-area="User" asp-controller="EzamiyyetMuraciet" asp-action="Create"
               class="fn-btn fn-btn--primary">+ Ezamiyyət müraciəti</a>
        }
    </div>

    @* ── Ümumi statistika ── *@
    <div class="fn-stat-row">
        <div class="fn-stat">
            <div class="fn-stat-val">@(Model.MezuniyyetCemi + Model.IcazeCemi + Model.EzamiyyetCemi)</div>
            <div class="fn-stat-lbl">Cəmi</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#1e9b6b">@(Model.MezuniyyetTesdiq + Model.IcazeTesdiq + Model.EzamiyyetTesdiq)</div>
            <div class="fn-stat-lbl">Təsdiqlənib</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#c9900a">@(Model.MezuniyyetGozlemede + Model.IcazeGozlemede + Model.EzamiyyetGozlemede)</div>
            <div class="fn-stat-lbl">Gözləmədə</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#2d6cdf">@Model.MezuniyyetCemi</div>
            <div class="fn-stat-lbl">Məzuniyyət</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#7c5cbf">@Model.IcazeCemi</div>
            <div class="fn-stat-lbl">İcazə</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#0d9488">@Model.EzamiyyetCemi</div>
            <div class="fn-stat-lbl">Ezamiyyət</div>
        </div>
    </div>

    @* ── Tab-lar ── *@
    <div class="fn-card" style="padding:0">
        <div class="fn-tabs">
            <a asp-area="User" asp-controller="Muraciet" asp-action="Index"
               asp-route-tab="mezuniyyet"
               class="fn-tab @(mezTab ? "fn-tab--active" : "")">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <rect x="1" y="2" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.2" />
                    <path d="M1 5h12M5 2v2M9 2v2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                </svg>
                Məzuniyyət
                <span class="fn-tab-count">@Model.MezuniyyetCemi</span>
            </a>
            <a asp-area="User" asp-controller="Muraciet" asp-action="Index"
               asp-route-tab="icaze"
               class="fn-tab @(icazeTab ? "fn-tab--active" : "")">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2" />
                    <path d="M7 4v3.5l2 1.5" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
                </svg>
                İcazə
                <span class="fn-tab-count">@Model.IcazeCemi</span>
            </a>
            <a asp-area="User" asp-controller="Muraciet" asp-action="Index"
               asp-route-tab="ezamiyyet"
               class="fn-tab @(ezamiyyetTab ? "fn-tab--active" : "")">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                    <rect x="2" y="4" width="10" height="8" rx="1.2" stroke="currentColor" stroke-width="1.2" />
                    <path d="M5 4V3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
                Ezamiyyət
                <span class="fn-tab-count">@Model.EzamiyyetCemi</span>
            </a>
        </div>

        @* ══ MƏZUNİYYƏT TAB-I ══ *@
        @if (mezTab)
        {
            @if (!Model.Mezuniyyetler.Any())
            {
                <div class="fn-tab-empty">
                    <div class="fn-empty-title">Məzuniyyət müraciətiniz yoxdur</div>
                    <div class="fn-empty-sub">
                        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
                           style="color:#e8b84b">Yeni müraciət göndər →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="fn-icaze-list">
                    @foreach (var m in Model.Mezuniyyetler)
                    {
                         var step = WorkflowStep(m.WorkflowMerhele); 
                        <div class="fn-icaze-item">
                            <div class="fn-icaze-date-block">
                                <div class="fn-icaze-day">@m.BaslamaTarixi.ToString("dd")</div>
                                <div class="fn-icaze-month">@m.BaslamaTarixi.ToString("MMM")</div>
                            </div>

                            <div class="fn-icaze-info">
                                <div class="fn-icaze-title">
                                    @m.NovText
                                    <span class="fn-icaze-dur">
                                        (@m.BaslamaTarixi.ToString("dd.MM") –
                                        @m.BitmeTarixi.ToString("dd.MM.yyyy") ·
                                        @m.IsGunlerininSayi iş günü)
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(m.EvezEdenIsciAdSoyad))
                                {
                                    <div class="fn-icaze-meta">
                                        <span class="fn-icaze-evez">Əvəzedici: @m.EvezEdenIsciAdSoyad</span>
                                    </div>
                                }
                                @if (step != -1)
                                {
                                    <div class="fn-workflow-steps">
                                        <div class="fn-ws @(step >= 1 ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Müraciət</div>
                                        </div>
                                        @if (m.EvezediciSecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 1 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(m.EvezediciTesdiqlenib == true ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Əvəzedici</div>
                                            </div>
                                        }
                                        @if (!m.SobeReisiKecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 2 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(step >= 2 ? "fn-ws--done" : step == 1 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Şöbə rəisi</div>
                                            </div>
                                        }
                                        @if (!m.RehberKecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 3 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(step >= 3 ? "fn-ws--done" : step == 2 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Rəhbər</div>
                                            </div>
                                        }
                                        <div class="fn-ws-line @(step >= 4 ? "fn-ws-line--done" : "")"></div>
                                        <div class="fn-ws @(step >= 4 ? "fn-ws--done" : step == 3 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div><div class="fn-ws-lbl">HR</div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="fn-icaze-actions">
                                <span class="fn-badge @BadgeClass(m.WorkflowMerhele)">@m.WorkflowMerhele</span>
                                <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Detail"
                                   asp-route-id="@m.Id" class="fn-btn fn-btn--ghost-sm" style="margin-top:6px">
                                    Detay
                                </a>
                                @if (m.WorkflowMerhele != "Təsdiqlənib" && m.WorkflowMerhele != "İmtina edildi")
                                {
                                    <form asp-area="User" asp-controller="Mezuniyyet"
                                          asp-action="Legv" method="post" style="margin-top:4px"
                                          onsubmit="return confirm('Bu müraciəti ləğv etmək istəyirsiniz?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="fn-btn fn-btn--danger-sm">Ləğv et</button>
                                    </form>
                                }
                                else if (m.LegvTelebiMumkun)
                                {
                                    <button type="button" class="fn-btn fn-btn--danger-sm" style="margin-top:4px"
                                            onclick="legvTelebAc(@m.Id)">Ləğv müraciəti</button>
                                }
                                else if (m.LegvTelebEdilib)
                                {
                                    <span class="fn-badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;margin-top:6px">
                                        <i class="bi bi-hourglass-split"></i> Ləğv tələb olunub
                                    </span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* ── İşçi ləğv müraciəti modalı (paylaşılan) ── *@
                <div id="legvTelebModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1050;align-items:center;justify-content:center;">
                    <div style="background:#fff;border-radius:12px;width:100%;max-width:440px;margin:16px;box-shadow:0 8px 32px rgba(0,0,0,.18);">
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #e4e8f0;">
                            <div style="font-size:15px;font-weight:700;color:#b91c1c;">
                                <i class="bi bi-x-circle" style="margin-right:6px;"></i> Məzuniyyəti ləğv üçün müraciət
                            </div>
                            <button type="button" onclick="legvTelebBag()" style="background:none;border:none;font-size:18px;color:#6b7280;cursor:pointer;line-height:1;">×</button>
                        </div>
                        <form asp-area="User" asp-controller="Mezuniyyet" asp-action="LegvTelebi" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="legvTelebId" value="" />
                            <div style="padding:20px;">
                                <div style="font-size:13px;color:#374151;line-height:1.7;margin-bottom:14px;">
                                    Bu <b>təsdiqlənmiş</b> məzuniyyətin ləğvi üçün HR-a müraciət göndərilir.
                                    HR təsdiqlədikdən sonra məzuniyyət ləğv olunacaq və balans geri qaytarılacaq.
                                </div>
                                <label style="font-size:12.5px;font-weight:600;color:#374151;display:block;margin-bottom:6px;">Ləğv səbəbi <span style="color:#b91c1c">*</span></label>
                                <textarea name="sebeb" required rows="3" placeholder="Nə üçün ləğv etmək istəyirsiniz?"
                                          style="width:100%;border:1.5px solid #d1d5db;border-radius:8px;padding:9px 11px;font-size:13px;resize:vertical;"></textarea>
                            </div>
                            <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid #e4e8f0;">
                                <button type="button" onclick="legvTelebBag()" style="padding:8px 18px;border-radius:8px;border:1.5px solid #d1d5db;background:#fff;color:#374151;font-size:13px;font-weight:600;cursor:pointer;">İmtina</button>
                                <button type="submit" style="padding:8px 18px;border-radius:8px;border:none;background:#ef4444;color:#fff;font-size:13px;font-weight:700;cursor:pointer;">Müraciət göndər</button>
                            </div>
                        </form>
                    </div>
                </div>
                <script>
                    function legvTelebAc(id) {
                        document.getElementById('legvTelebId').value = id;
                        document.getElementById('legvTelebModal').style.display = 'flex';
                    }
                    function legvTelebBag() {
                        document.getElementById('legvTelebModal').style.display = 'none';
                    }
                </script>
            }
        }

        @* ══ İCAZƏ TAB-I ══ *@
        @if (icazeTab)
        {
            @if (!Model.Icazeler.Any())
            {
                <div class="fn-tab-empty">
                    <div class="fn-empty-title">İcazə müraciətiniz yoxdur</div>
                    <div class="fn-empty-sub">
                        <a asp-area="User" asp-controller="Icaze" asp-action="Create"
                           style="color:#e8b84b">Yeni müraciət göndər →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="fn-icaze-list">
                    @foreach (var i in Model.Icazeler)
                    {
                         var step = WorkflowStep(i.WorkflowMerhele); 
                        <div class="fn-icaze-item">
                            <div class="fn-icaze-date-block">
                                <div class="fn-icaze-day">@i.IcazeTarixi.ToString("dd")</div>
                                <div class="fn-icaze-month">@i.IcazeTarixi.ToString("MMM")</div>
                            </div>

                            <div class="fn-icaze-info">
                                <div class="fn-icaze-title">
                                    Saatlıq icazə
                                    <span class="fn-icaze-dur">
                                        (@i.BaslamaSaati.ToString(@"hh\:mm") –
                                        @i.BitisSaati.ToString(@"hh\:mm") ·
                                        @i.IcazeSaati.ToString("F1") saat)
                                    </span>
                                </div>
                                <div class="fn-icaze-meta">
                                    <span class="fn-icaze-evez">Əvəzedici: @i.EvezEdenAdSoyad</span>
                                    @if (!string.IsNullOrEmpty(i.Sebeb))
                                    {
                                        <span class="fn-icaze-sep">·</span>
                                        <span class="fn-icaze-sebeb">@i.Sebeb</span>
                                    }
                                </div>
                                @if (step != -1)
                                {
                                    <div class="fn-workflow-steps">
                                        <div class="fn-ws @(step >= 1 ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Müraciət</div>
                                        </div>
                                        @if (i.EvezediciSecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 1 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(i.EvezediciTesdiqlenib == true ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Əvəzedici</div>
                                            </div>
                                        }
                                        @if (!i.SobeReisiKecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 2 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(step >= 2 ? "fn-ws--done" : step == 1 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Şöbə rəisi</div>
                                            </div>
                                        }
                                        @if (!i.RehberKecildi)
                                        {
                                            <div class="fn-ws-line @(step >= 3 ? "fn-ws-line--done" : "")"></div>
                                            <div class="fn-ws @(step >= 3 ? "fn-ws--done" : step == 2 ? "fn-ws--active" : "")">
                                                <div class="fn-ws-dot"></div><div class="fn-ws-lbl">Rəhbər</div>
                                            </div>
                                        }
                                        <div class="fn-ws-line @(step >= 4 ? "fn-ws-line--done" : "")"></div>
                                        <div class="fn-ws @(step >= 4 ? "fn-ws--done" : step == 3 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div><div class="fn-ws-lbl">HR</div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="fn-icaze-actions">
                                <span class="fn-badge @BadgeClass(i.WorkflowMerhele)">@i.WorkflowMerhele</span>
                                @if (i.WorkflowMerhele != "Təsdiqlənib" && i.WorkflowMerhele != "İmtina edildi")
                                {
                                    <form asp-area="User" asp-controller="Icaze"
                                          asp-action="Legv" method="post" style="margin-top:8px"
                                          onsubmit="return confirm('Bu icazəni ləğv etmək istəyirsiniz?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@i.Id" />
                                        <button type="submit" class="fn-btn fn-btn--danger-sm">Ləğv et</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ══ EZAMİYYƏT TAB-I ══ *@
        @if (ezamiyyetTab)
        {
            @if (!Model.Ezamiyyetler.Any())
            {
                <div class="fn-tab-empty">
                    <div class="fn-empty-title">Ezamiyyət müraciətiniz yoxdur</div>
                    <div class="fn-empty-sub">
                        <a asp-area="User" asp-controller="EzamiyyetMuraciet" asp-action="Create"
                           style="color:#e8b84b">Yeni müraciət göndər →</a>
                    </div>
                </div>
            }
            else
            {
                <div class="fn-icaze-list">
                    @foreach (var e in Model.Ezamiyyetler)
                    {
                        var (ebg, etxt, elbl) = e.Status switch
                        {
                            EzamiyyetStatus.Gozleyir    => ("#fef3c7", "#b45309", "Gözləyir"),
                            EzamiyyetStatus.Tesdiqlendi => ("#dcfce7", "#15803d", "Təsdiqləndi"),
                            EzamiyyetStatus.Reddedildi  => ("#fee2e2", "#dc2626", "Rədd edildi"),
                            _                           => ("#f1f5f9", "#64748b", "Ləğv edildi")
                        };
                        var eNotElave = e.Status == EzamiyyetStatus.Tesdiqlendi && e.BitmeTarixi.Date < bugun;
                        <div class="fn-icaze-item">
                            <div class="fn-icaze-date-block">
                                <div class="fn-icaze-day">@e.BaslamaTarixi.ToString("dd")</div>
                                <div class="fn-icaze-month">@e.BaslamaTarixi.ToString("MMM")</div>
                            </div>
                            <div class="fn-icaze-info">
                                <div class="fn-icaze-title">
                                    @e.Baslig
                                    <span class="fn-icaze-dur">
                                        (@e.BaslamaTarixi.ToString("dd.MM")@(e.BaslamaTarixi.Date != e.BitmeTarixi.Date ? " – " + e.BitmeTarixi.ToString("dd.MM.yyyy") : "") · @e.GunSayi gün)
                                    </span>
                                </div>
                                <div class="fn-icaze-meta">
                                    <span class="fn-icaze-evez"><i class="bi bi-geo-alt"></i> @e.MekanAd</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(e.Qeyd))
                                {
                                    <div style="font-size:12px;color:#94a3b8;margin-top:2px">@e.Qeyd</div>
                                }
                                @if (e.Status == EzamiyyetStatus.Reddedildi && !string.IsNullOrWhiteSpace(e.RehberQeydi))
                                {
                                    <div style="font-size:12px;color:#dc2626;margin-top:4px">Rədd səbəbi: @e.RehberQeydi</div>
                                }
                                @if (eNotElave)
                                {
                                    <div style="margin-top:6px">
                                        @if (!string.IsNullOrWhiteSpace(e.GeriDonusQeydi))
                                        {
                                            <div style="padding:6px 8px;background:#f0fdf4;border-radius:6px;font-size:12px;color:#166534">
                                                <i class="bi bi-check2-circle"></i> <em>@e.GeriDonusQeydi</em>
                                                <a href="#" onclick="ezamNotAc(@e.Id);return false;" style="margin-left:6px;font-size:11px;color:#6366f1">düzəlt</a>
                                            </div>
                                        }
                                        else
                                        {
                                            <a href="#" onclick="ezamNotAc(@e.Id);return false;" style="font-size:12px;color:#6366f1"><i class="bi bi-plus-circle"></i> Geri dönüş notu</a>
                                        }
                                        <div id="ezamNot-@e.Id" style="display:none;margin-top:6px">
                                            <form asp-area="User" asp-controller="EzamiyyetMuraciet" asp-action="GeriQeyd" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@e.Id" />
                                                <textarea name="qeyd" rows="2" placeholder="Ezamiyyət nəticəsi, görülən işlər…"
                                                          style="width:100%;border:1.5px solid #d1d5db;border-radius:6px;padding:6px 8px;font-size:12px;margin-bottom:4px">@e.GeriDonusQeydi</textarea>
                                                <div style="display:flex;gap:6px">
                                                    <button type="submit" class="fn-btn fn-btn--primary" style="font-size:11px;padding:4px 10px">Saxla</button>
                                                    <button type="button" class="fn-btn fn-btn--ghost-sm" onclick="ezamNotAc(@e.Id)">İmtina</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="fn-icaze-actions">
                                <span style="display:inline-block;padding:2px 10px;border-radius:12px;font-size:12px;font-weight:600;background:@ebg;color:@etxt">@elbl</span>
                                @if (!string.IsNullOrEmpty(e.SenedYolu))
                                {
                                    <a href="/dms/@e.SenedYolu" download="@(e.SenedAd ?? "sened")" class="fn-btn fn-btn--ghost-sm" style="margin-top:6px"><i class="bi bi-paperclip"></i> Sənəd</a>
                                }
                                @if (e.Status == EzamiyyetStatus.Gozleyir)
                                {
                                    <form asp-area="User" asp-controller="EzamiyyetMuraciet" asp-action="Legvet" asp-route-id="@e.Id" method="post" style="margin-top:4px"
                                          onsubmit="return confirm('Bu müraciəti ləğv etmək istəyirsiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="fn-btn fn-btn--danger-sm">Ləğv et</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
                <script>
                    function ezamNotAc(id) {
                        var el = document.getElementById('ezamNot-' + id);
                        el.style.display = el.style.display === 'none' ? 'block' : 'none';
                    }
                </script>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var hash = window.location.hash;
            if (hash) {
                var el = document.querySelector(hash);
                if (el) el.scrollIntoView({ behavior: 'smooth' });
            }
        });
    </script>
}

@section Styles {
    <style>
        .fn-btn--ghost-sm {
            font-size: 11px; padding: 4px 10px;
            background: none; border: 1px solid #dde1ea;
            border-radius: 5px; color: #5a647a; cursor: pointer;
            display: inline-block; text-decoration: none;
        }
        .fn-btn--ghost-sm:hover { background: #f3f4f8; }
    </style>
}
