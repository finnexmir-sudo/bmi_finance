@using FinNex.Domain.Entities.AI
@{
    ViewData["Title"] = "HR Məsləhətçi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var sohbetler  = ViewBag.Sohbetler  as dynamic ?? new List<dynamic>();
    var mesajlar   = ViewBag.Mesajlar   as List<HRSohbetMesaj> ?? new List<HRSohbetMesaj>();
    var aktivId    = (int)(ViewBag.AktivSohbetId ?? 0);
}

<style>
    /* ── Layout ────────────────────────────────────────── */
    .hrm-wrap {
        display: flex;
        height: calc(100vh - 64px);
        overflow: hidden;
        background: #f5f6fa;
    }

    /* ── Sol panel ─────────────────────────────────────── */
    .hrm-sidebar {
        width: 260px;
        min-width: 260px;
        background: #fff;
        border-right: 1px solid #e8eaf0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .hrm-sidebar-top {
        padding: 16px;
        border-bottom: 1px solid #e8eaf0;
    }

    .hrm-sidebar-top h2 {
        font-size: 15px;
        font-weight: 700;
        color: #1a2035;
        margin: 0 0 12px 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-yeni {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 9px 12px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .2s;
        text-decoration: none;
    }

    .btn-yeni:hover { background: #1d4ed8; color: #fff; }

    .hrm-history {
        flex: 1;
        overflow-y: auto;
        padding: 8px 0;
    }

    .hrm-history-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        cursor: pointer;
        border-radius: 0;
        transition: background .15s;
        font-size: 13px;
        color: #374151;
        text-decoration: none;
    }

    .hrm-history-item:hover { background: #f0f4ff; color: #1a2035; }
    .hrm-history-item.aktiv { background: #eff6ff; color: #2563eb; font-weight: 600; }

    .hrm-history-item-date {
        font-size: 11px;
        color: #9ca3af;
        margin-top: 2px;
    }

    .btn-sil-kicik {
        background: none;
        border: none;
        color: #d1d5db;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 4px;
        font-size: 14px;
        line-height: 1;
        display: none;
    }

    .hrm-history-item:hover .btn-sil-kicik { display: block; }
    .btn-sil-kicik:hover { color: #ef4444; background: #fee2e2; }

    /* ── Sağ panel ─────────────────────────────────────── */
    .hrm-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #f5f6fa;
    }

    .hrm-header {
        background: #fff;
        border-bottom: 1px solid #e8eaf0;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hrm-header-icon {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 18px;
    }

    .hrm-header-info h3 {
        font-size: 15px;
        font-weight: 700;
        color: #1a2035;
        margin: 0;
    }

    .hrm-header-info p {
        font-size: 12px;
        color: #6b7280;
        margin: 0;
    }

    /* ── Mesaj sahəsi ──────────────────────────────────── */
    .hrm-messages {
        flex: 1;
        overflow-y: auto;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .hrm-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #9ca3af;
        text-align: center;
        gap: 12px;
    }

    .hrm-empty-icon {
        width: 64px;
        height: 64px;
        background: #eff6ff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        color: #2563eb;
    }

    .hrm-empty h4 { font-size: 16px; color: #374151; margin: 0; font-weight: 600; }
    .hrm-empty p  { font-size: 13px; margin: 0; max-width: 300px; line-height: 1.6; }

    /* ── Mesaj bubble-lar ──────────────────────────────── */
    .hrm-msg {
        display: flex;
        gap: 10px;
        max-width: 820px;
    }

    .hrm-msg.user  { align-self: flex-end; flex-direction: row-reverse; }
    .hrm-msg.assistant { align-self: flex-start; }

    .hrm-msg-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    .hrm-msg.user      .hrm-msg-avatar { background: #2563eb; color: #fff; }
    .hrm-msg.assistant .hrm-msg-avatar { background: linear-gradient(135deg, #7c3aed, #2563eb); color: #fff; }

    .hrm-msg-body { display: flex; flex-direction: column; gap: 4px; }

    .hrm-msg-bubble {
        padding: 12px 16px;
        border-radius: 14px;
        font-size: 14px;
        line-height: 1.65;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .hrm-msg.user .hrm-msg-bubble {
        background: #2563eb;
        color: #fff;
        border-bottom-right-radius: 4px;
    }

    .hrm-msg.assistant .hrm-msg-bubble {
        background: #fff;
        color: #1a2035;
        border: 1px solid #e8eaf0;
        border-bottom-left-radius: 4px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .hrm-msg-bubble strong { font-weight: 700; }

    .hrm-msg-time {
        font-size: 11px;
        color: #9ca3af;
        padding: 0 4px;
    }

    .hrm-msg.user .hrm-msg-time { text-align: right; }

    /* ── Disclaimer ────────────────────────────────────── */
    .hrm-disclaimer {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        margin-top: 4px;
        padding: 6px 10px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        font-size: 11.5px;
        color: #92400e;
        max-width: 660px;
    }

    /* ── Yazı sahəsi ───────────────────────────────────── */
    .hrm-input-wrap {
        background: #fff;
        border-top: 1px solid #e8eaf0;
        padding: 16px 24px;
    }

    .hrm-input-box {
        display: flex;
        gap: 10px;
        align-items: flex-end;
        background: #f5f6fa;
        border: 1.5px solid #e8eaf0;
        border-radius: 12px;
        padding: 10px 12px;
        transition: border-color .2s;
    }

    .hrm-input-box:focus-within { border-color: #2563eb; }

    #sualInput {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        font-size: 14px;
        color: #1a2035;
        resize: none;
        min-height: 24px;
        max-height: 140px;
        line-height: 1.5;
        font-family: inherit;
    }

    #sualInput::placeholder { color: #9ca3af; }

    .btn-gonder {
        width: 38px;
        height: 38px;
        background: #2563eb;
        border: none;
        border-radius: 8px;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background .2s;
        font-size: 16px;
    }

    .btn-gonder:hover:not(:disabled)  { background: #1d4ed8; }
    .btn-gonder:disabled { background: #93c5fd; cursor: not-allowed; }

    /* ── Yazır... animasiya ────────────────────────────── */
    .hrm-typing {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        max-width: 820px;
        align-self: flex-start;
    }

    .hrm-typing-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed, #2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        flex-shrink: 0;
    }

    .hrm-typing-bubble {
        background: #fff;
        border: 1px solid #e8eaf0;
        border-radius: 14px;
        border-bottom-left-radius: 4px;
        padding: 14px 18px;
        display: flex;
        gap: 5px;
        align-items: center;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .hrm-typing-dot {
        width: 7px;
        height: 7px;
        background: #93c5fd;
        border-radius: 50%;
        animation: typingDot 1.2s infinite;
    }

    .hrm-typing-dot:nth-child(2) { animation-delay: .2s; }
    .hrm-typing-dot:nth-child(3) { animation-delay: .4s; }

    @@keyframes typingDot {
        0%, 80%, 100% { transform: scale(1); opacity: .5; }
        40%            { transform: scale(1.3); opacity: 1; }
    }
</style>

<div class="hrm-wrap">

    @* ── Sol panel ─────────────────────────────────────── *@
    <div class="hrm-sidebar">
        <div class="hrm-sidebar-top">
            <h2><i class="bi bi-scales"></i> HR Məsləhətçi</h2>
            <a href="@Url.Action("Index", "HRMeslehetci", new { area = "User" })" class="btn-yeni">
                <i class="bi bi-plus-lg"></i> Yeni Söhbət
            </a>
        </div>
        <div class="hrm-history">
            @foreach (var s in sohbetler)
            {
                bool isAktiv = (int)s.Id == aktivId;
                <a href="@Url.Action("Index", "HRMeslehetci", new { area = "User", sohbetId = s.Id })"
                   class="hrm-history-item @(isAktiv ? "aktiv" : "")">
                    <div>
                        <div>Söhbət #@s.Id</div>
                        <div class="hrm-history-item-date">@((DateTime)s.BaslanmaTarixi).ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    <button class="btn-sil-kicik" title="Sil"
                            onclick="event.preventDefault(); sohbetSil(@s.Id)">
                        <i class="bi bi-trash3"></i>
                    </button>
                </a>
            }
            @if (!((IEnumerable<dynamic>)sohbetler).Any())
            {
                <div style="padding:20px 16px; font-size:12px; color:#9ca3af; text-align:center;">
                    Hələ söhbət yoxdur.<br/>Yeni söhbət başladın.
                </div>
            }
        </div>
    </div>

    @* ── Sağ panel ──────────────────────────────────────── *@
    <div class="hrm-main">
        <div class="hrm-header">
            <div class="hrm-header-icon"><i class="bi bi-robot"></i></div>
            <div class="hrm-header-info">
                <h3>HR & Hüquq Məsləhətçisi</h3>
                <p>Azərbaycan Respublikası qanunvericiliyinə əsasən cavab verir</p>
            </div>
        </div>

        <div class="hrm-messages" id="messageArea">
            @if (!mesajlar.Any())
            {
                <div class="hrm-empty" id="emptyState">
                    <div class="hrm-empty-icon"><i class="bi bi-chat-square-text"></i></div>
                    <h4>Sualınızı yazın</h4>
                    <p>Əmək hüququ, vergi, DSMF, İTSS və digər qanunvericilik məsələləri üzrə sual verin.</p>
                </div>
            }
            else
            {
                foreach (var m in mesajlar)
                {
                    bool isUser = m.Rol == "user";
                    <div class="hrm-msg @m.Rol">
                        <div class="hrm-msg-avatar">
                            @if (isUser) { <i class="bi bi-person-fill"></i> }
                            else         { <i class="bi bi-robot"></i> }
                        </div>
                        <div class="hrm-msg-body">
                            <div class="hrm-msg-bubble">@Html.Raw(FormatMesaj(m.Metn))</div>
                            <div class="hrm-msg-time">@m.Tarix.ToString("HH:mm")</div>
                            @if (!isUser)
                            {
                                <div class="hrm-disclaimer">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    ⚠️ Bu informativ cavabdır, hüquqi qərarlar üçün mütəxəssislə məsləhətləşin.
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="hrm-input-wrap">
            <div class="hrm-input-box">
                <textarea id="sualInput" rows="1"
                          placeholder="Sualınızı yazın... (Shift+Enter yeni sətir, Enter göndər)"></textarea>
                <button class="btn-gonder" id="gonderBtn" title="Göndər">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>

</div>

@functions {
    string FormatMesaj(string metn)
    {
        if (string.IsNullOrEmpty(metn)) return "";
        var escaped = System.Net.WebUtility.HtmlEncode(metn);
        // **text** → <strong>text</strong>
        escaped = System.Text.RegularExpressions.Regex.Replace(
            escaped, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        return escaped;
    }
}

<script>
    const aktivSohbetId = @aktivId;
    let aktivId = aktivSohbetId;

    const messageArea = document.getElementById('messageArea');
    const sualInput   = document.getElementById('sualInput');
    const gonderBtn   = document.getElementById('gonderBtn');

    // Scroll aşağı
    function scrollDown() {
        messageArea.scrollTop = messageArea.scrollHeight;
    }
    scrollDown();

    // Textarea auto-resize
    sualInput.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 140) + 'px';
    });

    // Enter göndər, Shift+Enter yeni sətir
    sualInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            gonder();
        }
    });

    gonderBtn.addEventListener('click', gonder);

    async function gonder() {
        const sual = sualInput.value.trim();
        if (!sual || gonderBtn.disabled) return;

        // Empty state gizlət
        const empty = document.getElementById('emptyState');
        if (empty) empty.remove();

        // İstifadəçi bubble əlavə et
        appendMesaj('user', sual, new Date().toLocaleTimeString('az', { hour: '2-digit', minute: '2-digit' }));
        sualInput.value = '';
        sualInput.style.height = 'auto';

        // Typing animasiya
        const typingEl = appendTyping();
        gonderBtn.disabled = true;

        try {
            const resp = await fetch('/User/HRMeslehetci/Sor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sohbetId: aktivId, sual })
            });

            const data = await resp.json();
            typingEl.remove();

            if (data.ok) {
                aktivId = data.sohbetId;
                appendMesaj('assistant', data.cavab, data.tarix, true);

                // Yeni söhbətdisə sidebarı yenilə
                if (aktivSohbetId === 0 && data.sohbetId > 0) {
                    window.history.replaceState(null, '', '?sohbetId=' + data.sohbetId);
                }
            } else {
                appendXeta(data.xeta || 'Xəta baş verdi.');
            }
        } catch {
            typingEl.remove();
            appendXeta('Şəbəkə xətası. Zəhmət olmasa yenidən cəhd edin.');
        }

        gonderBtn.disabled = false;
        sualInput.focus();
    }

    function appendMesaj(rol, metn, saatStr, disclaimer) {
        const isUser = rol === 'user';
        const div = document.createElement('div');
        div.className = 'hrm-msg ' + rol;

        const htmlMetn = formatMesaj(metn);

        div.innerHTML = `
            <div class="hrm-msg-avatar">
                <i class="bi bi-${isUser ? 'person-fill' : 'robot'}"></i>
            </div>
            <div class="hrm-msg-body">
                <div class="hrm-msg-bubble">${htmlMetn}</div>
                <div class="hrm-msg-time">${saatStr}</div>
                ${disclaimer ? `<div class="hrm-disclaimer">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    ⚠️ Bu informativ cavabdır, hüquqi qərarlar üçün mütəxəssislə məsləhətləşin.
                </div>` : ''}
            </div>`;

        messageArea.appendChild(div);
        scrollDown();
    }

    function appendTyping() {
        const div = document.createElement('div');
        div.className = 'hrm-typing';
        div.innerHTML = `
            <div class="hrm-typing-avatar"><i class="bi bi-robot"></i></div>
            <div class="hrm-typing-bubble">
                <div class="hrm-typing-dot"></div>
                <div class="hrm-typing-dot"></div>
                <div class="hrm-typing-dot"></div>
            </div>`;
        messageArea.appendChild(div);
        scrollDown();
        return div;
    }

    function appendXeta(metn) {
        const div = document.createElement('div');
        div.style.cssText = 'align-self:center;padding:8px 14px;background:#fee2e2;color:#991b1b;border-radius:8px;font-size:13px;';
        div.textContent = metn;
        messageArea.appendChild(div);
        scrollDown();
    }

    function formatMesaj(metn) {
        let s = metn
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
        // **bold**
        s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        return s;
    }

    async function sohbetSil(sohbetId) {
        if (!confirm('Bu söhbəti silmək istəyirsiniz?')) return;

        const resp = await fetch('/User/HRMeslehetci/TarixiSil', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sohbetId })
        });

        const data = await resp.json();
        if (data.ok) {
            if (sohbetId === aktivId) {
                window.location.href = '/User/HRMeslehetci';
            } else {
                window.location.reload();
            }
        }
    }
</script>
