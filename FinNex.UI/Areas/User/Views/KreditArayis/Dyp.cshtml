@using FinNex.UI.Areas.User.ViewModels
@model DypArayisVM
@{
    ViewData["Title"] = "DYP arayış";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var nomreYaz = ViewBag.NomreYaz as bool? ?? false;
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">DYP arayış</div>
            <div class="fn-page-sub">Avtomobilin girovdan çıxması — DYP-yə məktub</div>
        </div>
        <a asp-controller="KreditMuraciet" asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <partial name="_ArayisBaslik" />

    <div class="fn-form-wrap" style="max-width:900px">
        <form asp-action="Dyp" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">
                <div class="km-detail-section-title">Müştəri və müqavilə</div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Müştəri</label>
                        <input type="text" name="Musteri" value="@Model?.Musteri" class="fn-input" required
                               placeholder="Məs: Əliyev Əli Məmməd oğlu" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Müqavilə №</label>
                        <input type="text" name="MuqavileNo" value="@Model?.MuqavileNo" class="fn-input" />
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Müqavilə tarixi</label>
                        <input type="date" name="MuqavileTarixi" class="fn-input"
                               value="@(Model?.MuqavileTarixi?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Məktubun tarixi</label>
                        <input type="date" name="MektubTarixi" class="fn-input"
                               value="@((Model?.MektubTarixi ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                    </div>
                </div>
            </div>

            <div class="fn-card fn-card--form">
                <div class="km-detail-section-title">Avtomobil</div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Avto №</label>
                        <input type="text" name="AvtoNo" value="@Model?.AvtoNo" class="fn-input" required
                               placeholder="Məs: 10-AB-123" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Marka</label>
                        <input type="text" name="Marka" value="@Model?.Marka" class="fn-input" />
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Buraxılış ili</label>
                        <input type="text" name="BuraxilisIli" value="@Model?.BuraxilisIli" class="fn-input" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Mühərrik</label>
                        <input type="text" name="Muherrik" value="@Model?.Muherrik" class="fn-input" />
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Ban</label>
                        <input type="text" name="Ban" value="@Model?.Ban" class="fn-input" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Rəng</label>
                        <input type="text" name="Reng" value="@Model?.Reng" class="fn-input" />
                    </div>
                </div>
            </div>

            <div style="text-align:right;margin-top:14px">
                <button type="submit" class="fn-btn fn-btn--primary">
                    📄 Arayışı hazırla@(nomreYaz ? "" : " (önizləmə)")
                </button>
            </div>
        </form>
    </div>
</div>
