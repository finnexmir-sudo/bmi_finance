@{
    ViewData["Title"] = "Cüzdanım";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var balans = (decimal)(ViewBag.Balans ?? 0m);
    var qaraVar = (bool)(ViewBag.QaraVar ?? false);
    var musbetTeyinatlar = ViewBag.MusbetTeyinatlar as IList<FinNex.Application.DTOs.HR.Jeton.JetonTeyinatiListDto>
        ?? new List<FinNex.Application.DTOs.HR.Jeton.JetonTeyinatiListDto>();
}

<link rel="stylesheet" href="~/css/User/user-jeton.css" asp-append-version="true" />

<div class="uj-page">

    <!-- ── Balans kartı ────────────────────────────────── -->
    <div class="uj-balance-card @(qaraVar ? "uj-balance-card--blocked" : "")">
        <div class="uj-balance-icon">
            @if (qaraVar)
            {
                <i class="bi bi-slash-circle-fill"></i>
            }
            else
            {
                <i class="bi bi-award-fill"></i>
            }
        </div>
        <div class="uj-balance-info">
            <div class="uj-balance-label">Aktiv saat balansı</div>
            <div class="uj-balance-val">@balans.ToString("0.##") saat</div>
            @if (qaraVar)
            {
                <div class="uj-balance-warn">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Qara jeton mövcuddur — xərcləmə bloklanıb
                </div>
            }
        </div>
        @if (!qaraVar && balans > 0)
        {
            <button class="uj-btn uj-btn--primary" onclick="ujOpenRedimModal()">
                <i class="bi bi-send"></i> Jeton xərclə
            </button>
        }
    </div>

    <!-- ── Reytinq Widget ────────────────────────────── -->
    <div class="uj-reyting-widget" id="ujReytingWidget" style="display:none">
        <div class="uj-reyting-left">
            <div class="uj-reyting-icon"><i class="bi bi-star-fill"></i></div>
            <div>
                <div class="uj-reyting-label">Reytinqim</div>
                <div class="uj-reyting-val" id="ujReytingXal">—</div>
            </div>
        </div>
        <div class="uj-reyting-mid">
            <div class="uj-reyting-kat" id="ujReytingKat">—</div>
            <div class="uj-reyting-ay" id="ujReytingAy"></div>
        </div>
        <div class="uj-reyting-right">
            <div class="uj-amsal-item">
                <span class="uj-amsal-lab">💰 Pul əmsalı</span>
                <span class="uj-amsal-val" id="ujReytingPul">1.00x</span>
            </div>
            <div class="uj-amsal-item">
                <span class="uj-amsal-lab">⏱ Saat əmsalı</span>
                <span class="uj-amsal-val" id="ujReytingSaat">1.00x</span>
            </div>
        </div>
    </div>

    <!-- ── Tabs ───────────────────────────────────────── -->
    <div class="uj-tabs">
        <button class="uj-tab uj-tab--active" data-tab="jetonlar" onclick="ujSwitchTab(this,'jetonlar')">
            <i class="bi bi-award"></i> Jetonlarım
        </button>
        <button class="uj-tab" data-tab="redimler" onclick="ujSwitchTab(this,'redimler')">
            <i class="bi bi-clock-history"></i> Xərcləmə Tarixçəsi
        </button>
    </div>

    <!-- ── Jetonlar panel ──────────────────────────────── -->
    <div id="ujTabJetonlar" class="uj-panel">
        <div id="ujJetonList" class="uj-jeton-list">
            <div class="uj-empty">Yüklənir…</div>
        </div>
    </div>

    <!-- ── Redim tarixçəsi panel ──────────────────────── -->
    <div id="ujTabRedimler" class="uj-panel" style="display:none">
        <div class="uj-table-wrap">
            <table class="uj-table">
                <thead>
                    <tr>
                        <th>Nov</th>
                        <th>Cəmi saat</th>
                        <th>Tarix</th>
                        <th>Status</th>
                        <th>Qeyd</th>
                    </tr>
                </thead>
                <tbody id="ujRedimBody">
                    <tr><td colspan="5" class="uj-empty">Yüklənir…</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ── Redim Modal ─────────────────────────────────────── -->
<div class="uj-overlay" id="ujRedimOverlay" onclick="ujCloseRedimModal()"></div>
<div class="uj-modal" id="ujRedimModal">
    <div class="uj-modal-head">
        <h3><i class="bi bi-send"></i> Jeton Xərcləmə</h3>
        <button class="uj-modal-close" onclick="ujCloseRedimModal()">&times;</button>
    </div>
    <div class="uj-modal-body">
        <p class="uj-help-text">İstifadə etmək istədiyiniz jetonları seçin:</p>

        <div id="ujJetonSelectList" class="uj-jeton-select-list">
            <!-- JS tərəfindən doldurulur -->
        </div>

        <div class="uj-field" style="margin-top:18px">
            <label>Xərcləmə növü</label>
            <div class="uj-radio-group">
                <label class="uj-radio">
                    <input type="radio" name="ujRedimNov" value="1" checked onchange="ujRedimNovChanged()" />
                    <span><i class="bi bi-clock"></i> İcazə (erkən çıxış)</span>
                </label>
                <label class="uj-radio uj-radio--disabled" title="Hələlik deaktivdir — gələcəkdə əlavə olunacaq"
                       style="opacity:.45;cursor:not-allowed">
                    <input type="radio" name="ujRedimNov" value="2" disabled />
                    <span><i class="bi bi-cash-coin"></i> Maaşa əlavə <small style="color:#9ca3af">(tezliklə)</small></span>
                </label>
            </div>
        </div>

        <div id="ujIcazeFields" style="margin-top:14px">
            <div class="uj-field">
                <label>İcazə tarixi</label>
                <input type="date" id="ujIcazeTarixi" class="uj-input" />
            </div>
            <div style="display:flex;gap:12px">
                <div class="uj-field" style="flex:1">
                    <label>Başlama saatı</label>
                    <input type="text" id="ujBaslamaSaati" class="uj-input"
                           value="09:00" placeholder="09:00" maxlength="5"
                           pattern="^([01]?\d|2[0-3]):[0-5]\d$" />
                </div>
                <div class="uj-field" style="flex:1">
                    <label>Bitmə saatı</label>
                    <input type="text" id="ujBitisSaati" class="uj-input"
                           value="11:00" placeholder="11:00" maxlength="5"
                           pattern="^([01]?\d|2[0-3]):[0-5]\d$" />
                </div>
            </div>
            <small style="color:#6b7280;font-size:12px">
                Sorğu rəhbər → HR təsdiqindən sonra avtomatik icazə qeydi yaranır.
            </small>
        </div>

        <div class="uj-selected-info" id="ujSelectedInfo" style="display:none">
            Seçilmiş: <strong id="ujSelectedSaat">0</strong> saat
        </div>
    </div>
    <div class="uj-modal-foot">
        <button class="uj-btn uj-btn--ghost" onclick="ujCloseRedimModal()">Ləğv et</button>
        <button class="uj-btn uj-btn--primary" onclick="ujSubmitRedim()">
            <i class="bi bi-send"></i> Göndər
        </button>
    </div>
</div>

@section Scripts {
<script>
window.ujBalans = @balans;
window.ujQaraVar = @(qaraVar ? "true" : "false");
</script>
<script src="~/js/User/user-jeton.js" asp-append-version="true"></script>
}
