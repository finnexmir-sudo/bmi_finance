@{
    ViewData["Title"] = "Daxili Chat";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page chat-page">
    <div class="chat-container">

        @* ── Left Panel: Contacts ── *@
        <div class="chat-sidebar">
            <div class="chat-sidebar-header">
                <div class="chat-sidebar-top">
                    <div class="chat-sidebar-title">Mesajlar</div>
                    <button type="button" id="btnTopluMesaj" class="fn-btn fn-btn--sm chat-bulk-btn"
                            title="Toplu mesaj göndər">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </button>
                </div>
                <input type="text" id="contactSearch" class="fn-input chat-search"
                       placeholder="İşçi axtar..." />
            </div>
            <div class="chat-contact-list" id="contactList">
                <div class="chat-loading">Yüklənir...</div>
            </div>
        </div>

        @* ── Right Panel: Messages ── *@
        <div class="chat-main">
            <div class="chat-main-header" id="chatHeader" style="display:none">
                <div class="chat-avatar" id="chatAvatar">--</div>
                <div class="chat-header-info">
                    <div class="chat-header-name" id="chatName">-</div>
                </div>
            </div>

            <div class="chat-messages" id="chatMessages">
                <div class="chat-empty-state">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                        <rect x="4" y="8" width="40" height="28" rx="4" stroke="#dde1ea" stroke-width="2" />
                        <path d="M4 28l12-8 8 6 8-6 12 8" stroke="#dde1ea" stroke-width="2" />
                    </svg>
                    <div class="chat-empty-title">Söhbət seçin</div>
                    <div class="chat-empty-sub">Mesajlaşmaq üçün sol paneldən kontakt seçin</div>
                </div>
            </div>

            @* ── Fayl preview bar ── *@
            <div class="chat-file-preview" id="filePreview" style="display:none">
                <div class="chat-file-preview-info">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#e8b84b" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <span id="filePreviewName">fayl.pdf</span>
                    <span id="filePreviewSize" class="chat-file-size"></span>
                </div>
                <button type="button" class="chat-file-preview-close" id="btnClearFile">&times;</button>
            </div>

            <div class="chat-input-area" id="chatInputArea" style="display:none">
                @* Emoji düyməsi *@
                <div class="chat-emoji-wrap">
                    <button type="button" class="chat-icon-btn" id="btnEmoji" title="Emoji">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                            <line x1="9" y1="9" x2="9.01" y2="9"/>
                            <line x1="15" y1="9" x2="15.01" y2="9"/>
                        </svg>
                    </button>
                    <div class="chat-emoji-panel" id="emojiPanel" style="display:none"></div>
                </div>

                @* Fayl əlavə düyməsi *@
                <button type="button" class="chat-icon-btn" id="btnAttach" title="Fayl əlavə et (PDF, Word, Excel)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                </button>
                <input type="file" id="fileInput" style="display:none"
                       accept=".pdf,.doc,.docx,.xls,.xlsx" />

                <textarea id="chatInput" class="fn-input chat-input" rows="1"
                          placeholder="Mesaj yazın..." maxlength="250" autocomplete="off"></textarea>
                <button type="button" id="btnSend" class="fn-btn fn-btn--primary chat-send-btn">
                    Göndər
                </button>
            </div>
        </div>
    </div>
</div>

@* ── Toplu Mesaj Modalı ── *@
<div class="chat-modal-overlay" id="bulkModal" style="display:none">
    <div class="chat-modal">
        <div class="chat-modal-header">
            <div class="chat-modal-title">Toplu Mesaj Göndər</div>
            <button type="button" class="chat-modal-close" id="btnCloseBulk">&times;</button>
        </div>
        <div class="chat-modal-body">
            <div class="fn-form-group">
                <label class="fn-label">Alıcılar</label>
                <div class="bulk-filter-row">
                    <select id="bulkTarget" class="fn-input chat-bulk-select">
                        <option value="all">Bütün işçilər</option>
                    </select>
                    <input type="text" id="bulkSearch" class="fn-input" placeholder="İşçi axtar..." />
                </div>
                <div class="bulk-actions-row">
                    <button type="button" class="fn-btn fn-btn--sm bulk-select-all" id="btnSelectAll">Hamısını seç</button>
                    <button type="button" class="fn-btn fn-btn--sm bulk-deselect-all" id="btnDeselectAll">Hamısını sil</button>
                    <span class="bulk-count" id="bulkCount">0 seçili</span>
                </div>
                <div class="bulk-employee-list" id="bulkEmployeeList">
                    <div class="chat-loading">Yüklənir...</div>
                </div>
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Mesaj mətni <span class="fn-required">*</span></label>
                <textarea id="bulkMetn" class="fn-input chat-bulk-textarea"
                          rows="3" placeholder="Mesajınızı yazın..."></textarea>
            </div>
            <div class="fn-form-group" style="margin-top:6px;">
                <label class="fn-label" style="margin-bottom:6px;">
                    Fayl qoşması
                    <span style="color:#94a3b8;font-size:11px;font-weight:400;"> (PDF, Word, Excel · max 10 MB)</span>
                </label>
                <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                    <label class="fn-btn fn-btn--sm fn-btn--outline" style="cursor:pointer;margin:0;display:inline-flex;align-items:center;gap:5px;">
                        <i class="bi bi-paperclip"></i> Fayl seç
                        <input type="file" id="bulkFaylInput" accept=".pdf,.doc,.docx,.xls,.xlsx" style="display:none;">
                    </label>
                    <span id="bulkFaylPreview" style="font-size:12px;color:#475569;display:flex;align-items:center;gap:6px;"></span>
                </div>
            </div>
        </div>
        <div class="chat-modal-footer">
            <div class="chat-bulk-info" id="bulkInfo"></div>
            <button type="button" class="fn-btn fn-btn--outline" id="btnCancelBulk">Ləğv et</button>
            <button type="button" class="fn-btn fn-btn--primary" id="btnSendBulk">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px">
                    <line x1="22" y1="2" x2="11" y2="13"/>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
                Göndər
            </button>
        </div>
    </div>
</div>

<input type="hidden" id="menimIsciId" value="" />
<input type="hidden" id="secilmisIsciId" value="" />

@section Styles {
    <link rel="stylesheet" href="~/css/User/chat.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/User/chat.js" asp-append-version="true"></script>
}
