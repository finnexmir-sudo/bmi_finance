@{
    ViewData["Title"] = "Mənim Hesabatlarım";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/hesabat-izleme.css" asp-append-version="true" />
}

<div class="fn-dashboard hi">

    @Html.AntiForgeryToken()

    <!-- ═══ BAŞLIQ + XÜLASƏ ═══ -->
    <div class="hi-head">
        <div>
            <h1 class="hi-head-title">Mənim Hesabatlarım</h1>
            <div class="hi-head-sub">Sizə təyin olunmuş dövri hesabat öhdəlikləri</div>
        </div>
        <div class="hi-head-chips" id="hiChips"></div>
    </div>

    <!-- ═══ TOOLBAR ═══ -->
    <div class="hi-toolbar fn-card">
        <div class="hi-search">
            <i class="bi bi-search"></i>
            <input type="text" id="hiAxtar" placeholder="Hesabat adı axtar..." />
        </div>
        <select id="hiTezlik" class="hi-input hi-input--sm">
            <option value="">Bütün tezliklər</option>
            <option value="1">Günlük</option>
            <option value="2">Həftəlik</option>
            <option value="3">Aylıq</option>
            <option value="4">Rüblük</option>
            <option value="5">İllik</option>
        </select>
        <select id="hiStatus" class="hi-input hi-input--sm">
            <option value="">Bütün statuslar</option>
            <option value="1">Gözləyir</option>
            <option value="2">İcrada</option>
            <option value="3">Tamamlandı</option>
            <option value="4">Gecikib</option>
        </select>
        <button type="button" class="hi-btn hi-btn--ghost" id="hiYenile" title="Yenilə">
            <i class="bi bi-arrow-clockwise"></i> Yenilə
        </button>
    </div>

    <!-- ═══ TAPŞIRIQ CƏDVƏLİ ═══ -->
    <div class="fn-card hi-table-wrap">
        <div class="hi-scroll">
            <table class="hi-table hi-table--main">
                <thead>
                    <tr>
                        <th>Hesabat adı</th>
                        <th>Kateqoriya</th>
                        <th>Tezlik</th>
                        <th>Son tarix</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="hiTbody"></tbody>
            </table>
        </div>
        <div class="hi-empty" id="hiEmpty" style="display:none">Sizə təyin olunmuş hesabat tapşırığı yoxdur.</div>
        <div class="hi-empty" id="hiLoading">Yüklənir...</div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
    var tbody = document.getElementById('hiTbody');
    var emptyEl = document.getElementById('hiEmpty');
    var loadingEl = document.getElementById('hiLoading');
    var axtarEl = document.getElementById('hiAxtar');
    var tezlikEl = document.getElementById('hiTezlik');
    var statusEl = document.getElementById('hiStatus');
    var yenileBtn = document.getElementById('hiYenile');
    var chipsEl = document.getElementById('hiChips');
    var axtarTimer = null;

    function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function tezlikText(t) {
        return { 1: 'Günlük', 2: 'Həftəlik', 3: 'Aylıq', 4: 'Rüblük', 5: 'İllik' }[t] || '-';
    }

    function pillInfo(row) {
        if (row.status === 3) return { cls: 'done', text: 'Tamamlanıb' };
        if (row.status === 4) return { cls: 'late', text: 'Gecikib' };
        var saatQalib = (new Date(row.deadline) - new Date()) / 3600000;
        if (saatQalib < 0) return { cls: 'late', text: 'Gecikib' };
        if (saatQalib <= 72) return { cls: 'soon', text: 'Yaxınlaşır' };
        if (row.status === 2) return { cls: 'progress', text: 'İcrada' };
        return { cls: 'wait', text: 'Vaxtında' };
    }

    function relativeText(row) {
        if (row.status === 3) {
            return row.icraTarixi ? 'Tamamlanıb: ' + fmtDate(row.icraTarixi) : 'Tamamlanıb';
        }
        var deadline = new Date(row.deadline);
        var gun = Math.floor((deadline - new Date()) / 86400000);
        if (gun < 0) return Math.abs(gun) === 0 ? 'Bu gün gecikib' : Math.abs(gun) + ' gün gecikib';
        if (gun === 0) return 'Bu gün';
        if (gun === 1) return 'Sabah';
        return gun + ' gün qalıb';
    }

    function fmtDate(iso) {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return '-';
        var pad = function (n) { return n < 10 ? '0' + n : n; };
        return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + '.' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function renderChips(list) {
        var geciken = list.filter(function (t) { return t.status === 4 || (t.status !== 3 && new Date(t.deadline) < new Date()); }).length;
        var gozleyen = list.filter(function (t) { return t.status === 1 || t.status === 2; }).length;
        var tamamlanan = list.filter(function (t) { return t.status === 3; }).length;
        chipsEl.innerHTML =
            '<span class="hi-chip">Cəmi <b>' + list.length + '</b></span>' +
            '<span class="hi-chip hi-chip--wait">Gözləyir <b>' + gozleyen + '</b></span>' +
            '<span class="hi-chip hi-chip--late">Gecikib <b>' + geciken + '</b></span>' +
            '<span class="hi-chip hi-chip--done">Tamamlanıb <b>' + tamamlanan + '</b></span>';
    }

    function renderRows(list) {
        renderChips(list);
        if (!list.length) {
            tbody.innerHTML = '';
            emptyEl.textContent = 'Sizə təyin olunmuş hesabat tapşırığı yoxdur.';
            emptyEl.style.display = 'block';
            return;
        }
        emptyEl.style.display = 'none';
        tbody.innerHTML = list.map(function (t) {
            var pill = pillInfo(t);
            var basla = t.status === 1
                ? '<button type="button" class="hi-btn hi-btn--start" data-act="basla" data-id="' + t.id + '" title="İcraya başla"><i class="bi bi-play-fill"></i></button>'
                : '';
            var tamamla = t.status !== 3
                ? '<button type="button" class="hi-btn hi-btn--done" data-act="tamamla" data-id="' + t.id + '" title="Tamamla"><i class="bi bi-check-lg"></i></button>'
                : '';
            return '' +
                '<tr>' +
                    '<td><div class="hi-r-title">' + esc(t.sablonAd) + '</div><div class="hi-r-sub">' + esc(t.departamentAd) + '</div></td>' +
                    '<td>' + esc(t.kateqoriyaAd) + '</td>' +
                    '<td><span class="hi-tag">' + tezlikText(t.tezlik) + '</span></td>' +
                    '<td><div class="hi-r-title">' + fmtDate(t.deadline) + '</div><div class="hi-r-sub">' + relativeText(t) + '</div></td>' +
                    '<td><span class="hi-pill hi-pill--' + pill.cls + '">' + pill.text + '</span></td>' +
                    '<td class="hi-r-actions">' + basla + tamamla + '</td>' +
                '</tr>';
        }).join('');
    }

    async function hiYukle() {
        loadingEl.style.display = 'block';
        emptyEl.style.display = 'none';
        var params = new URLSearchParams();
        if (axtarEl.value.trim()) params.set('axtar', axtarEl.value.trim());
        if (tezlikEl.value) params.set('tezlik', tezlikEl.value);
        if (statusEl.value) params.set('status', statusEl.value);

        try {
            var r = await fetch('@Url.Action("GetMenimTapshiriqlar")?' + params.toString());
            var d = await r.json();
            loadingEl.style.display = 'none';
            if (!d.success) {
                tbody.innerHTML = '';
                emptyEl.textContent = d.message || 'Yüklənmədi.';
                emptyEl.style.display = 'block';
                return;
            }
            renderRows(d.data || []);
        } catch (e) {
            loadingEl.style.display = 'none';
            tbody.innerHTML = '';
            emptyEl.textContent = 'Yüklənmədi — şəbəkə xətası.';
            emptyEl.style.display = 'block';
        }
    }

    tbody.addEventListener('click', async function (e) {
        var btn = e.target.closest('button[data-act]');
        if (!btn) return;
        var id = btn.getAttribute('data-id');
        var action = btn.getAttribute('data-act') === 'basla' ? '@Url.Action("IcrayaBasla")' : '@Url.Action("Tamamla")';
        btn.disabled = true;
        try {
            var r = await fetch(action, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'tapshiriqId=' + encodeURIComponent(id)
            });
            var d = await r.json();
            if (d.success) {
                hiYukle();
            } else {
                btn.disabled = false;
                alert(d.message || 'Əməliyyat uğursuz oldu.');
            }
        } catch (err) {
            btn.disabled = false;
            alert('Şəbəkə xətası.');
        }
    });

    axtarEl.addEventListener('input', function () {
        clearTimeout(axtarTimer);
        axtarTimer = setTimeout(hiYukle, 350);
    });
    tezlikEl.addEventListener('change', hiYukle);
    statusEl.addEventListener('change', hiYukle);
    yenileBtn.addEventListener('click', hiYukle);

    hiYukle();
})();
</script>
}
