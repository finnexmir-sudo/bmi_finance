@model FinNex.Application.DTOs.HR.HesabatIzleme.HesabatIzlemeDashboardDto
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Hesabat İzləmə";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var depts = ViewBag.Departamentler as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var isciler = ViewBag.Isciler as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/hesabat-izleme.css" asp-append-version="true" />
}

<div class="fn-dashboard hi">

    @Html.AntiForgeryToken()

    <!-- ═══ BAŞLIQ + XÜLASƏ ═══ -->
    <div class="hi-head">
        <div>
            <h1 class="hi-head-title">Hesabat İzləmə</h1>
            <div class="hi-head-sub">Dövri hesabat öhdəlikləri — kim, nə vaxt, hansı statusda</div>
        </div>
        <div class="hi-head-chips">
            <span class="hi-chip">Cəmi <b>@Model.Umumi</b></span>
            <span class="hi-chip hi-chip--wait">Gözləyir <b>@Model.Gozleyen</b></span>
            <span class="hi-chip hi-chip--late">Gecikib <b>@Model.Geciken</b></span>
            <span class="hi-chip hi-chip--done">Tamamlanıb <b>@Model.Tamamlanan</b> (@Model.TamamlanmaFaizi%)</span>
        </div>
    </div>

    <!-- ═══ TOOLBAR ═══ -->
    <div class="hi-toolbar fn-card">
        <div class="hi-search">
            <i class="bi bi-search"></i>
            <input type="text" id="hiAxtar" placeholder="Hesabat adı, departament, məsul şəxs axtar..." />
        </div>
        @if (ViewBag.UserDeptId == null)
        {
            <select id="hiDept" class="hi-input hi-input--sm">
                <option value="">Bütün departamentlər</option>
                @foreach (var d in depts)
                {
                    <option value="@d.Id">@d.Ad</option>
                }
            </select>
        }
        <select id="hiTezlik" class="hi-input hi-input--sm">
            <option value="">Bütün tezliklər</option>
            <option value="1">Günlük</option>
            <option value="2">Həftəlik</option>
            <option value="3">Aylıq</option>
            <option value="4">Rüblük</option>
            <option value="5">İllik</option>
        </select>
        <select id="hiStatus" class="hi-input hi-input--sm">
            <option value="">Bütün statuslar</option>
            <option value="1">Gözləyir</option>
            <option value="2">İcrada</option>
            <option value="3">Tamamlandı</option>
            <option value="4">Gecikib</option>
        </select>
        <button type="button" class="hi-btn hi-btn--ghost" id="hiYenile" title="Yenilə">
            <i class="bi bi-arrow-clockwise"></i> Yenilə
        </button>
    </div>

    <!-- ═══ TAPŞIRIQ CƏDVƏLİ ═══ -->
    <div class="fn-card hi-table-wrap">
        <div class="hi-scroll">
            <table class="hi-table hi-table--main">
                <thead>
                    <tr>
                        <th>Hesabat adı</th>
                        <th>Departament</th>
                        <th>Tezlik</th>
                        <th>Son tarix</th>
                        <th>Məsul şəxs</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="hiTbody"></tbody>
            </table>
        </div>
        <div class="hi-empty" id="hiEmpty" style="display:none">Heç bir hesabat tapşırığı tapılmadı.</div>
        <div class="hi-empty" id="hiLoading">Yüklənir...</div>
    </div>

    <!-- ═══ TƏNZİMLƏMƏLƏR (qatlanan — Kateqoriyalar + Şablonlar) ═══ -->
    <details class="hi-settings">
        <summary class="hi-settings-summary">
            <i class="bi bi-gear"></i>
            <span>Tənzimləmələr</span>
            <span class="hi-settings-sub">kateqoriyalar və hesabat şablonları</span>
            <i class="bi bi-chevron-down hi-settings-chevron"></i>
        </summary>
        <div class="hi-settings-body">

            <!-- ═══ KATEQORİYALAR ═══ -->
            <div class="hi-section-head">
                <i class="bi bi-tags"></i> Kateqoriyalar
                <button type="button" class="hi-add-btn" onclick="document.getElementById('katModal').classList.add('hi-modal--open')">
                    <i class="bi bi-plus-lg"></i> Yeni kateqoriya
                </button>
            </div>
            <div class="fn-card">
                @if (Model.Kateqoriyalar.Any())
                {
                    <div class="hi-kat-list">
                        @foreach (var k in Model.Kateqoriyalar)
                        {
                            <div class="hi-kat-item">
                                <span class="hi-kat-name">@k.Ad</span>
                                <form asp-action="KateqoriyaSil" method="post" class="hi-inline-form" onsubmit="return confirm('Bu kateqoriyanı silmək istəyirsiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@k.Id" />
                                    <button type="submit" class="hi-btn hi-btn--del" title="Sil"><i class="bi bi-x-lg"></i></button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="hi-empty">Hələ kateqoriya yaradılmayıb.</div>
                }
            </div>

            <!-- ═══ ŞABLONLAR + YENİ ŞABLON ═══ -->
            <div class="hi-section-head">
                <i class="bi bi-journal-text"></i> Hesabat şablonları
                <button type="button" class="hi-add-btn" onclick="document.getElementById('sablonModal').classList.add('hi-modal--open')">
                    <i class="bi bi-plus-lg"></i> Yeni şablon
                </button>
            </div>

            @if (Model.Sablonlar.Any())
            {
                <div class="fn-card">
                    <table class="hi-table">
                        <thead>
                            <tr>
                                <th>Hesabat adı</th>
                                <th>Tezlik</th>
                                <th>Kateqoriya</th>
                                <th>Prioritet</th>
                                <th>Məsul</th>
                                <th>Departament</th>
                                <th>Deadline</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Sablonlar)
                            {
                                <tr>
                                    <td class="hi-t-bold">@s.Ad</td>
                                    <td><span class="hi-tag">@s.TezlikText</span></td>
                                    <td>@s.KateqoriyaAd</td>
                                    <td><span class="hi-pri hi-pri--@s.Prioritet.ToString().ToLower()">@s.PrioritetText</span></td>
                                    <td>@s.MesulIsciAd</td>
                                    <td>@s.DepartamentAd</td>
                                    <td>@(s.SonTarixGunu > 0 ? $"{s.SonTarixGunu}-ci gün" : "") @s.SonTarixSaati.ToString(@"hh\:mm")</td>
                                    <td>
                                        <form asp-action="SablonSil" method="post" class="hi-inline-form" onsubmit="return confirm('Silmək istədiyinizə əminsiniz?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="hi-btn hi-btn--del" title="Sil"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="fn-card">
                    <div class="hi-empty">
                        Hələ hesabat şablonu yaradılmayıb. <strong>"Yeni şablon"</strong> düyməsini basın.
                    </div>
                </div>
            }
        </div>
    </details>
</div>

<!-- ═══ YENİ KATEQORİYA MODAL ═══ -->
<div class="hi-modal" id="katModal">
    <div class="hi-modal-overlay" onclick="this.parentElement.classList.remove('hi-modal--open')"></div>
    <div class="hi-modal-card" style="width:380px">
        <div class="hi-modal-head">
            <h3>Yeni kateqoriya</h3>
            <button type="button" class="hi-modal-close" onclick="this.closest('.hi-modal').classList.remove('hi-modal--open')">&times;</button>
        </div>
        <form asp-action="KateqoriyaYarat" method="post">
            @Html.AntiForgeryToken()
            <div class="hi-modal-body">
                <div class="hi-form-group">
                    <label>Kateqoriya adı *</label>
                    <input name="kateqoriyaAd" class="hi-input" required placeholder="Məs: Vergi, Bank, Kassa..." />
                </div>
            </div>
            <div class="hi-modal-foot">
                <button type="button" class="hi-btn hi-btn--cancel" onclick="this.closest('.hi-modal').classList.remove('hi-modal--open')">Ləğv et</button>
                <button type="submit" class="hi-btn hi-btn--submit">Yarat</button>
            </div>
        </form>
    </div>
</div>

<!-- ═══ YENİ ŞABLON MODAL ═══ -->
<div class="hi-modal" id="sablonModal">
    <div class="hi-modal-overlay" onclick="this.parentElement.classList.remove('hi-modal--open')"></div>
    <div class="hi-modal-card">
        <div class="hi-modal-head">
            <h3>Yeni hesabat şablonu</h3>
            <button type="button" class="hi-modal-close" onclick="this.closest('.hi-modal').classList.remove('hi-modal--open')">&times;</button>
        </div>
        <form asp-action="SablonYarat" method="post">
            @Html.AntiForgeryToken()
            <div class="hi-modal-body">
                <div class="hi-form-group">
                    <label>Hesabat adı *</label>
                    <input name="Ad" class="hi-input" required placeholder="Məs: Gündəlik kassa hesabatı" />
                </div>
                <div class="hi-form-group">
                    <label>Təsvir</label>
                    <input name="Tesvir" class="hi-input" placeholder="Qısa izah" />
                </div>
                <div class="hi-form-row">
                    <div class="hi-form-group">
                        <label>Tezlik *</label>
                        <select name="Tezlik" class="hi-input" required>
                            <option value="1">Günlük</option>
                            <option value="2">Həftəlik</option>
                            <option value="3">Aylıq</option>
                            <option value="4">Rüblük</option>
                            <option value="5">İllik</option>
                        </select>
                    </div>
                    <div class="hi-form-group">
                        <label>Kateqoriya *</label>
                        <select name="KateqoriyaId" class="hi-input" required>
                            <option value="">Seçin</option>
                            @foreach (var k in Model.Kateqoriyalar)
                            {
                                <option value="@k.Id">@k.Ad</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="hi-form-row">
                    <div class="hi-form-group">
                        <label>Prioritet</label>
                        <select name="Prioritet" class="hi-input">
                            <option value="1">Aşağı</option>
                            <option value="2" selected>Orta</option>
                            <option value="3">Yüksək</option>
                        </select>
                    </div>
                    <div class="hi-form-group">
                        <label>Son tarix günü</label>
                        <input name="SonTarixGunu" type="number" class="hi-input" value="0" min="0" max="31"
                               placeholder="Aylıq: ayın günü, Həftəlik: 1-7" />
                    </div>
                </div>
                <div class="hi-form-row">
                    <div class="hi-form-group">
                        <label>Son tarix saatı</label>
                        <input name="SonTarixSaati" type="time" class="hi-input" value="17:00" />
                    </div>
                    <div class="hi-form-group">
                        <label>Departament *</label>
                        <select name="DepartamentId" class="hi-input" required>
                            <option value="">Seçin</option>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Id">@d.Ad</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="hi-form-group">
                    <label>Məsul şəxs *</label>
                    <select name="MesulIsciId" class="hi-input" required>
                        <option value="">Seçin</option>
                        @foreach (var i in isciler)
                        {
                            <option value="@i.Id">@i.TamAd</option>
                        }
                    </select>
                </div>
            </div>
            <div class="hi-modal-foot">
                <button type="button" class="hi-btn hi-btn--cancel" onclick="this.closest('.hi-modal').classList.remove('hi-modal--open')">Ləğv et</button>
                <button type="submit" class="hi-btn hi-btn--submit">Yarat</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
    var tbody = document.getElementById('hiTbody');
    var emptyEl = document.getElementById('hiEmpty');
    var loadingEl = document.getElementById('hiLoading');
    var axtarEl = document.getElementById('hiAxtar');
    var deptEl = document.getElementById('hiDept');
    var tezlikEl = document.getElementById('hiTezlik');
    var statusEl = document.getElementById('hiStatus');
    var yenileBtn = document.getElementById('hiYenile');
    var axtarTimer = null;

    function esc(s) {
        return String(s ?? '').replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function tezlikText(t) {
        return { 1: 'Günlük', 2: 'Həftəlik', 3: 'Aylıq', 4: 'Rüblük', 5: 'İllik' }[t] || '-';
    }

    function pillInfo(row) {
        if (row.status === 3) return { cls: 'done', text: 'Tamamlanıb' };
        if (row.status === 4) return { cls: 'late', text: 'Gecikib' };
        var saatQalib = (new Date(row.deadline) - new Date()) / 3600000;
        if (saatQalib < 0) return { cls: 'late', text: 'Gecikib' };
        if (saatQalib <= 72) return { cls: 'soon', text: 'Yaxınlaşır' };
        if (row.status === 2) return { cls: 'progress', text: 'İcrada' };
        return { cls: 'wait', text: 'Vaxtında' };
    }

    function relativeText(row) {
        if (row.status === 3) {
            return row.icraTarixi ? 'Tamamlanıb: ' + fmtDate(row.icraTarixi) : 'Tamamlanıb';
        }
        var deadline = new Date(row.deadline);
        var gun = Math.floor((deadline - new Date()) / 86400000);
        if (gun < 0) return Math.abs(gun) === 0 ? 'Bu gün gecikib' : Math.abs(gun) + ' gün gecikib';
        if (gun === 0) return 'Bu gün';
        if (gun === 1) return 'Sabah';
        return gun + ' gün qalıb';
    }

    function fmtDate(iso) {
        var d = new Date(iso);
        if (isNaN(d.getTime())) return '-';
        var pad = function (n) { return n < 10 ? '0' + n : n; };
        return pad(d.getDate()) + '.' + pad(d.getMonth() + 1) + '.' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    function renderRows(list) {
        if (!list.length) {
            tbody.innerHTML = '';
            emptyEl.textContent = 'Heç bir hesabat tapşırığı tapılmadı.';
            emptyEl.style.display = 'block';
            return;
        }
        emptyEl.style.display = 'none';
        tbody.innerHTML = list.map(function (t) {
            var pill = pillInfo(t);
            var basla = t.status === 1
                ? '<button type="button" class="hi-btn hi-btn--start" data-act="basla" data-id="' + t.id + '" title="İcraya başla"><i class="bi bi-play-fill"></i></button>'
                : '';
            var tamamla = t.status !== 3
                ? '<button type="button" class="hi-btn hi-btn--done" data-act="tamamla" data-id="' + t.id + '" title="Tamamla"><i class="bi bi-check-lg"></i></button>'
                : '';
            return '' +
                '<tr>' +
                    '<td><div class="hi-r-title">' + esc(t.sablonAd) + '</div><div class="hi-r-sub">' + esc(t.kateqoriyaAd) + '</div></td>' +
                    '<td>' + esc(t.departamentAd) + '</td>' +
                    '<td><span class="hi-tag">' + tezlikText(t.tezlik) + '</span></td>' +
                    '<td><div class="hi-r-title">' + fmtDate(t.deadline) + '</div><div class="hi-r-sub">' + relativeText(t) + '</div></td>' +
                    '<td>' + esc(t.mesulIsciAd) + '</td>' +
                    '<td><span class="hi-pill hi-pill--' + pill.cls + '">' + pill.text + '</span></td>' +
                    '<td class="hi-r-actions">' + basla + tamamla + '</td>' +
                '</tr>';
        }).join('');
    }

    async function hiYukle() {
        loadingEl.style.display = 'block';
        emptyEl.style.display = 'none';
        var params = new URLSearchParams();
        if (axtarEl.value.trim()) params.set('axtar', axtarEl.value.trim());
        if (deptEl && deptEl.value) params.set('departamentId', deptEl.value);
        if (tezlikEl.value) params.set('tezlik', tezlikEl.value);
        if (statusEl.value) params.set('status', statusEl.value);

        try {
            var r = await fetch('@Url.Action("GetTapshiriqlar")?' + params.toString());
            var d = await r.json();
            loadingEl.style.display = 'none';
            if (!d.success) {
                tbody.innerHTML = '';
                emptyEl.textContent = d.message || 'Yüklənmədi.';
                emptyEl.style.display = 'block';
                return;
            }
            renderRows(d.data || []);
        } catch (e) {
            loadingEl.style.display = 'none';
            tbody.innerHTML = '';
            emptyEl.textContent = 'Yüklənmədi — şəbəkə xətası.';
            emptyEl.style.display = 'block';
        }
    }

    tbody.addEventListener('click', async function (e) {
        var btn = e.target.closest('button[data-act]');
        if (!btn) return;
        var id = btn.getAttribute('data-id');
        var action = btn.getAttribute('data-act') === 'basla' ? '@Url.Action("IcrayaBasla")' : '@Url.Action("Tamamla")';
        btn.disabled = true;
        try {
            var r = await fetch(action, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'tapshiriqId=' + encodeURIComponent(id)
            });
            var d = await r.json();
            if (d.success) {
                hiYukle();
            } else {
                btn.disabled = false;
                alert(d.message || 'Əməliyyat uğursuz oldu.');
            }
        } catch (err) {
            btn.disabled = false;
            alert('Şəbəkə xətası.');
        }
    });

    axtarEl.addEventListener('input', function () {
        clearTimeout(axtarTimer);
        axtarTimer = setTimeout(hiYukle, 350);
    });
    if (deptEl) deptEl.addEventListener('change', hiYukle);
    tezlikEl.addEventListener('change', hiYukle);
    statusEl.addEventListener('change', hiYukle);
    yenileBtn.addEventListener('click', hiYukle);

    hiYukle();
})();
</script>
}
