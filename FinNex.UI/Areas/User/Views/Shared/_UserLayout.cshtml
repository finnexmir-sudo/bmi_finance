@inject FinNex.Application.Interfaces.IDashboardService _layoutDashSvc
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentTab = Context.Request.Query["tab"].ToString();

    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isHR = User.IsInRole(RoleNames.HR) || isAdmin;
    var isRehberRol = User.IsInRole(RoleNames.Rehber);
    var isSobeReisi = User.IsInRole(RoleNames.SobeReisi);
    var isMuhasib = User.IsInRole(RoleNames.Muhasib) || isHR || isRehberRol;
    var isRehberOnly = isRehberRol && !isHR && !isMuhasib;

    var tesdiqGorunur = isSobeReisi || isRehberRol || isHR;
    var hrGorunur = isHR || isRehberRol;

    var _layoutVezife = ViewData["UserRole"] as string ?? "";
    if (string.IsNullOrEmpty(_layoutVezife) && User.Identity?.IsAuthenticated == true)
    {
        var _dashRes = await _layoutDashSvc.GetDashboardAsync(User.Identity.Name!);
        if (_dashRes.Success && _dashRes.Data != null)
            _layoutVezife = _dashRes.Data.VezifeAdi ?? "";
    }

    // Hangı modul aktivdir — top tab-ı vurğulamaq + contextual sidebar üçün
    bool IsAccountingCtrl()
    {
        return currentController == "Maas"
            || currentController == "MaasParametri"
            || currentController == "Budce"
            || currentController == "Xerc"
            || currentController == "XercKateqoriya"
            || currentController == "XercHesabat"
            || currentController == "IsciAyliqQazanc"
            || currentController == "MezuniyyetOdenis"
            || currentController == "Guzest"
            || currentController == "IsciGuzest"
            || currentController == "IsciHYS"
            || (currentController == "Avans" && currentArea == "HR");
    }

    string DetectActiveModule()
    {
        // Əvvəl ümumi home səhifələrini yoxla (Chat, Elan, Inbox, Xatirlatma,
        // Profile) ki, onlara klik edəndə top tab "Əsas"-da qalsın və
        // sidebar "keçid" etməsin.
        if (currentController is "Chat" or "Elan" or "Inbox" or "Xatirlatma"
            or "Dashboard" or "Profile" && currentArea == "User")
            return "home";

        // Rəhbər Panel — Əsas sidebar-dan girilir, orada qalsın
        if (currentController == "RehberDashboard") return "home";

        if (currentArea == "HR")
            return IsAccountingCtrl() ? "muhasibat" : "hr";
        if (currentArea == "SenedDovriyyesi") return "umumi";
        if (currentArea == "PR_Odenis_Tapsirigi") return "umumi";
        if (currentController == "Tesdiq") return "tesdiq";
        if (currentController == "KreditMuraciet") return "kredit";
        if (currentController == "Hesabat" || currentController == "HesabatIzleme") return "hesabat";
        if (currentController == "Icaze" && currentAction is "Izleme" or "Dovriyye") return "hr";
        if (currentController is "Davamiyyet" or "Takvim" or "Mezuniyyet" or "Muraciet"
            or "Tapshiriq" or "Gorush" or "Icaze" or "Maas" or "Xerc" or "Avans")
            return "emekdas";
        return "home";
    }

    var activeModule = DetectActiveModule();

    string TabCls(string module) =>
        "fn-topnav-tab" + (activeModule == module ? " fn-topnav-tab--active" : "");

    string userName = User.Identity?.Name ?? "";
    var parts = userName.Split(' ');
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}"
        : userName.Length > 0 ? userName[0].ToString() : "?";
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FinNex</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2332" />
    <meta name="application-name" content="BMI Finance" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BMI Finance" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/User/user-area.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/createmezuniyyet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/topnav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fn-datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        // Temanı səhifə rendera başlamadan tətbiq et — "flash" (saxta rəng
        // saniyəsi) yaranmasın deyə <body> görüşdən əvvəl class qoyulur.
        (function () {
            try {
                var t = localStorage.getItem('fn-theme') || 'ocean';
                document.documentElement.dataset.theme = t; // diaqnostika
            } catch (e) { }
        })();
    </script>
</head>
<body class="@(string.IsNullOrEmpty(ViewData["Theme"] as string) ? "" : "theme-" + ViewData["Theme"])">
    <script>
        // body element-inə tema class-ı tətbiq et (JS — localStorage-dən)
        (function () {
            try {
                var t = localStorage.getItem('fn-theme') || 'ocean';
                document.body.classList.add('theme-' + t);
            } catch (e) {
                document.body.classList.add('theme-ocean');
            }
        })();
    </script>

<!-- ══════════════════ YUXARI NAVBAR ══════════════════ -->
<header class="fn-topnav">
    <div class="fn-topnav-inner">
        <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="fn-topnav-brand">
            <img src="~/images/Logobank.jpg" alt="BMI" class="fn-topnav-logo" />
            <span class="fn-topnav-brand-text">BMI <b>Finance</b></span>
        </a>

        <nav class="fn-topnav-tabs">
            <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="@TabCls("home")">
                <i class="bi bi-house-door"></i><span>Əsas</span>
            </a>

            <a asp-area="User" asp-controller="Davamiyyet" asp-action="Index" class="@TabCls("emekdas")">
                <i class="bi bi-person-badge"></i><span>Əməkdaş</span>
            </a>

            @if (tesdiqGorunur)
            {
                var tesdiqAction = isSobeReisi ? "SobeReisi" : (isRehberRol ? "Rehber" : "Hr");
                <a asp-area="User" asp-controller="Tesdiq" asp-action="@tesdiqAction" class="@TabCls("tesdiq")">
                    <i class="bi bi-check2-square"></i><span>Təsdiq</span>
                </a>
            }

            @{
                var isDepartModule = activeModule is "kredit" or "hr" or "muhasibat" or "umumi";
                var departActiveCls = isDepartModule ? " fn-topnav-tab--active" : "";
            }
            <div class="fn-topnav-dropdown @(isDepartModule ? "fn-topnav-dropdown--active" : "")">
                <button type="button" class="fn-topnav-tab @departActiveCls">
                    <i class="bi bi-grid-3x3-gap"></i><span>Departamentlər</span>
                    <i class="bi bi-chevron-down fn-topnav-caret"></i>
                </button>
                <div class="fn-topnav-dropdown-menu">
                    <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Index"
                       class="fn-topnav-dd-item @(activeModule == "kredit" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-credit-card"></i>
                        <div>
                            <div class="fn-topnav-dd-title">Kredit</div>
                            <div class="fn-topnav-dd-sub">Müraciətlər, komitə, qərarlar</div>
                        </div>
                    </a>
                    @if (hrGorunur)
                    {
                        <a asp-area="HR" asp-controller="Dashboard" asp-action="Index"
                           class="fn-topnav-dd-item @(activeModule == "hr" ? "fn-topnav-dd-item--active" : "")">
                            <i class="bi bi-people"></i>
                            <div>
                                <div class="fn-topnav-dd-title">HR</div>
                                <div class="fn-topnav-dd-sub">Kadr, davamiyyət, qiymətləndirmə</div>
                            </div>
                        </a>
                    }
                    @if (isMuhasib)
                    {
                        <a asp-area="HR" asp-controller="Maas" asp-action="Index"
                           class="fn-topnav-dd-item @(activeModule == "muhasibat" ? "fn-topnav-dd-item--active" : "")">
                            <i class="bi bi-cash-coin"></i>
                            <div>
                                <div class="fn-topnav-dd-title">Mühasibatlıq</div>
                                <div class="fn-topnav-dd-sub">Maaş, avans, büdcə, xərc</div>
                            </div>
                        </a>
                    }
                    <a asp-area="SenedDovriyyesi" asp-controller="Dashboard" asp-action="Index"
                       class="fn-topnav-dd-item @(activeModule == "umumi" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-folder2"></i>
                        <div>
                            <div class="fn-topnav-dd-title">Ümumi</div>
                            <div class="fn-topnav-dd-sub">Sənəd dövriyyəsi, Swift / ödəniş</div>
                        </div>
                    </a>
                </div>
            </div>

            @if (isMuhasib || isRehberRol)
            {
                <a asp-area="User" asp-controller="Hesabat" asp-action="Index" class="@TabCls("hesabat")">
                    <i class="bi bi-bar-chart"></i><span>Hesabatlar</span>
                </a>
            }
        </nav>

        <div class="fn-topnav-right">
            <a asp-area="User" asp-controller="Xatirlatma" asp-action="Index"
               class="fn-topnav-icon" id="xatirlatmaBtn" title="Xatırlatmalar">
                <i class="bi bi-clock"></i>
                <span class="fn-topnav-badge" id="xatirlatmaCount" style="display:none">0</span>
            </a>
            <a asp-area="User" asp-controller="Chat" asp-action="Index"
               class="fn-topnav-icon" id="chatBtn" title="Chat">
                <i class="bi bi-chat-dots"></i>
                <span class="fn-topnav-badge" id="chatCount" style="display:none">0</span>
            </a>
            <a asp-area="User" asp-controller="Inbox" asp-action="Index"
               asp-route-tab="bildirisler"
               class="fn-topnav-icon" id="notifBtn" title="Bildirişlər">
                <i class="bi bi-bell"></i>
                <span class="fn-topnav-badge" id="notifCount" style="display:none">0</span>
            </a>

            <div class="fn-topnav-user" tabindex="0">
                <div class="fn-topnav-avatar">@initials</div>
                <div class="fn-topnav-user-info">
                    <div class="fn-topnav-user-name">@userName</div>
                    <div class="fn-topnav-user-role">@_layoutVezife</div>
                </div>
                <div class="fn-topnav-user-menu">
                    <a asp-area="User" asp-controller="Profile" asp-action="Index" class="fn-topnav-user-menu-item">
                        <i class="bi bi-person"></i> Profil
                    </a>

                    <div class="fn-topnav-user-menu-divider"></div>

                    <div class="fn-theme-label">Tema</div>
                    <div class="fn-theme-row">
                        <button type="button" class="fn-theme-chip fn-theme-chip--red" data-theme="red" title="Bank Melli qırmızı"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--ocean" data-theme="ocean" title="Okean göy"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--forest" data-theme="forest" title="Zümrüd yaşıl"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--midnight" data-theme="midnight" title="Gecə qara"></button>
                    </div>

                    <div class="fn-topnav-user-menu-divider"></div>

                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="fn-topnav-user-menu-item fn-topnav-user-menu-danger">
                            <i class="bi bi-box-arrow-right"></i> Çıxış
                        </button>
                    </form>
                </div>
            </div>

            <button type="button" class="fn-topnav-burger" id="fnBurgerBtn" title="Menyu">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</header>

<div class="fn-layout2">

    <!-- ══════════════════ KONTEKSTUAL SİDEBAR ══════════════════ -->
    <aside class="fn-sidebar2" id="fnSidebar">

        @switch (activeModule)
        {
            case "home":
                <div class="fn-nav-label">Əsas</div>
                <a asp-area="User" asp-controller="Dashboard" asp-action="Index"
                   class="fn-nav-item @(currentController == "Dashboard" && currentArea == "User" ? "active" : "")">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
                @if (isRehberRol)
                {
                    <a asp-area="HR" asp-controller="RehberDashboard" asp-action="Index"
                       class="fn-nav-item @(currentController == "RehberDashboard" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Rəhbər Panel
                    </a>
                    <a asp-area="HR" asp-controller="RehberDashboard" asp-action="Davamiyyet"
                       class="fn-nav-item fn-nav-item--sub @(currentController == "RehberDashboard" && currentAction == "Davamiyyet" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i> Davamiyyət
                    </a>
                    <a asp-area="HR" asp-controller="RehberDashboard" asp-action="IcazeIzleme"
                       class="fn-nav-item fn-nav-item--sub @(currentController == "RehberDashboard" && currentAction == "IcazeIzleme" ? "active" : "")">
                        <i class="bi bi-bar-chart-line"></i> İcazə İzləmə
                    </a>
                }
                @if (isHR)
                {
                    <a asp-area="HR" asp-controller="Dashboard" asp-action="Index"
                       class="fn-nav-item @(currentArea == "HR" && currentController == "Dashboard" ? "active" : "")">
                        <i class="bi bi-clipboard2-pulse"></i> HR Dashboard
                    </a>
                }
                <a asp-area="User" asp-controller="Profile" asp-action="Index"
                   class="fn-nav-item @(currentController == "Profile" ? "active" : "")">
                    <i class="bi bi-person"></i> Profil
                </a>
                <a asp-area="User" asp-controller="Chat" asp-action="Index"
                   class="fn-nav-item @(currentController == "Chat" && currentArea == "User" ? "active" : "")">
                    <i class="bi bi-chat-dots"></i> Chat
                </a>
                <a asp-area="User" asp-controller="Elan" asp-action="Index"
                   class="fn-nav-item @(currentController == "Elan" && currentArea == "User" ? "active" : "")">
                    <i class="bi bi-megaphone"></i> Elanlar
                </a>
                break;

            case "emekdas":
                {
                    var emekPortalActive = currentController is "Davamiyyet" or "Takvim" or "Mezuniyyet" or "Icaze" or "Muraciet" or "Tapshiriq" or "Gorush";
                    var emekMaliyyeActive = currentArea == "User" && (currentController == "Maas" || currentController == "Avans" || currentController == "Xerc");
                    var emekJetonActive = currentArea == "User" && currentController == "Jeton";
                    <div class="fn-nav-g @(emekPortalActive ? "open" : "")">
                        <button type="button" class="fn-nav-g-head">
                            <span>Əməkdaş Portalı</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="fn-nav-g-body">
                            <a asp-area="User" asp-controller="Davamiyyet" asp-action="Index"
                               class="fn-nav-item @(currentController == "Davamiyyet" ? "active" : "")">
                                <i class="bi bi-calendar-check"></i> Davamiyyət
                            </a>
                            <a asp-area="User" asp-controller="Takvim" asp-action="Index"
                               class="fn-nav-item @(currentController == "Takvim" ? "active" : "")">
                                <i class="bi bi-calendar3"></i> Təqvim
                            </a>
                            <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
                               class="fn-nav-item @(currentController == "Mezuniyyet" ? "active" : "")">
                                <i class="bi bi-tree"></i> Məzuniyyət
                            </a>
                            <a asp-area="User" asp-controller="Icaze" asp-action="Index"
                               class="fn-nav-item @(currentController == "Icaze" ? "active" : "")">
                                <i class="bi bi-hourglass-split"></i> İcazə
                            </a>
                            <a asp-area="User" asp-controller="Muraciet" asp-action="Index"
                               class="fn-nav-item @(currentController == "Muraciet" ? "active" : "")">
                                <i class="bi bi-envelope-paper"></i> Müraciətlər
                            </a>
                            <a asp-area="User" asp-controller="Tapshiriq" asp-action="Index"
                               class="fn-nav-item @(currentController == "Tapshiriq" ? "active" : "")">
                                <i class="bi bi-list-check"></i> Tapşırıqlar
                            </a>
                            <a asp-area="User" asp-controller="Gorush" asp-action="Index"
                               class="fn-nav-item @(currentController == "Gorush" ? "active" : "")">
                                <i class="bi bi-calendar-event"></i> Görüşlər
                            </a>
                        </div>
                    </div>
                    <div class="fn-nav-g @(emekMaliyyeActive ? "open" : "")">
                        <button type="button" class="fn-nav-g-head">
                            <span>Maliyyə</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="fn-nav-g-body">
                            <a asp-area="User" asp-controller="Maas" asp-action="Tarixce"
                               class="fn-nav-item @(currentController == "Maas" && currentArea == "User" && currentAction == "Tarixce" ? "active" : "")">
                                <i class="bi bi-clock-history"></i> Maaş Tarixçəsi
                            </a>
                            <a asp-area="User" asp-controller="Maas" asp-action="HYS"
                               class="fn-nav-item @(currentController == "Maas" && currentArea == "User" && currentAction == "HYS" ? "active" : "")">
                                <i class="bi bi-percent"></i> HYS
                            </a>
                            <a asp-area="User" asp-controller="Avans" asp-action="Index"
                               class="fn-nav-item @(currentController == "Avans" && currentArea == "User" ? "active" : "")">
                                <i class="bi bi-cash"></i> Avans
                            </a>
                            <a asp-area="User" asp-controller="Xerc" asp-action="Index"
                               class="fn-nav-item @(currentController == "Xerc" && currentArea == "User" ? "active" : "")">
                                <i class="bi bi-receipt"></i> Xərclər
                            </a>
                        </div>
                    </div>
                    <div class="fn-nav-g @(emekJetonActive ? "open" : "")">
                        <button type="button" class="fn-nav-g-head">
                            <span>Motivasiya</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="fn-nav-g-body">
                            <a asp-area="User" asp-controller="Jeton" asp-action="Index"
                               class="fn-nav-item @(emekJetonActive ? "active" : "")">
                                <i class="bi bi-award-fill"></i> Cüzdanım
                            </a>
                        </div>
                    </div>
                }
                break;

            case "tesdiq":
                <div class="fn-nav-label">Təsdiq Paneli</div>
                @if (isSobeReisi)
                {
                    <a asp-area="User" asp-controller="Tesdiq" asp-action="SobeReisi"
                       class="fn-nav-item @(currentAction == "SobeReisi" ? "active" : "")">
                        <i class="bi bi-person-check"></i> Şöbə Rəhbəri
                    </a>
                }
                @if (isRehberRol)
                {
                    <a asp-area="User" asp-controller="Tesdiq" asp-action="Rehber"
                       class="fn-nav-item @(currentAction == "Rehber" ? "active" : "")">
                        <i class="bi bi-person-workspace"></i> Rəhbər
                    </a>
                }
                @if (isHR)
                {
                    <a asp-area="User" asp-controller="Tesdiq" asp-action="Hr"
                       class="fn-nav-item @(currentAction == "Hr" ? "active" : "")">
                        <i class="bi bi-briefcase"></i> HR
                    </a>
                }
                break;

            case "kredit":
                <div class="fn-nav-label">Kredit</div>
                <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Index"
                   class="fn-nav-item @(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-credit-card"></i> Müraciətlər
                </a>
                <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Komite"
                   class="fn-nav-item @(currentAction == "Komite" ? "active" : "")">
                    <i class="bi bi-people"></i> Kredit Komitəsi
                </a>
                <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Qerarlar"
                   class="fn-nav-item @(currentAction == "Qerarlar" ? "active" : "")">
                    <i class="bi bi-journal-check"></i> Komitə Qərarları
                </a>
                <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Randevular"
                   class="fn-nav-item @(currentAction == "Randevular" ? "active" : "")">
                    <i class="bi bi-calendar-plus"></i> Randevular
                </a>
                break;

            case "hr":
                {
                    var hrAsasActive = currentArea == "HR" && (currentController is "Dashboard" or "RehberDashboard");
                    var hrKadrActive = currentController is "Isci" or "Departament" or "Vezife" or "Organizasiya";
                    var hrDMActive = (currentArea == "HR" && currentController is "Davamiyyet" or "Mezuniyyet" or "BayramGunu" or "MezuniyyetBalans" or "Xestelik" or "XestelikEzamiyyet" or "IsciStaji")
                                  || (currentController == "Icaze" && currentAction is "Izleme" or "Dovriyye");
                    var hrQymetActive = currentArea == "HR" && currentController is "Performans" or "Telim";
                    var hrDigerActive = currentArea == "HR" && currentController is "Hesabat" or "Elan";
                    var hrMotivActive = currentArea == "HR" && (currentController == "Jeton" || currentController == "JetonAnalitika" || currentController == "Reyting" || currentController == "ReytingParametr" || currentController == "JetonTeklifi" || currentController == "JetonTeyinati");
                    var hrAnyActive = hrAsasActive || hrKadrActive || hrDMActive || hrQymetActive || hrDigerActive || hrMotivActive;

                    <div class="fn-nav-g @(hrAsasActive ? "open" : "")">
                        <button type="button" class="fn-nav-g-head">
                            <span>Əsas</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="fn-nav-g-body">
                            <a asp-area="HR" asp-controller="Dashboard" asp-action="Index"
                               class="fn-nav-item @(currentArea == "HR" && currentController == "Dashboard" ? "active" : "")">
                                <i class="bi bi-grid"></i> HR Dashboard
                            </a>
