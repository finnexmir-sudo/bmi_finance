@inject FinNex.Application.Interfaces.IDashboardService _layoutDashSvc
@inject FinNex.Application.Interfaces.Pid.IMehkemeIsiService _pidSorguSvc
@inject FinNex.Application.Interfaces.IUserPermissionService _permSvc
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentTab = Context.Request.Query["tab"].ToString();

    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isHR = User.IsInRole(RoleNames.HR) || isAdmin;
    var isRehberRol = User.IsInRole(RoleNames.Rehber);
    var isSobeReisi = User.IsInRole(RoleNames.SobeReisi);
    var isMuhasib = User.IsInRole(RoleNames.Muhasib) || isHR || isRehberRol;
    var isRehberOnly = isRehberRol && !isHR && !isMuhasib;

    var tesdiqGorunur = isSobeReisi || isRehberRol || isHR;
    var hrGorunur = isHR || isRehberRol;

    // Maliyyə & Risk Paneli girişi:
    //  - Tam maliyyə işçisi (Admin/Muhasib/HR) BÜTÜN mühasibat menyusunu görür.
    //  - Rəhbər / risk (icazə ilə) YALNIZ paneli görür — maaş/büdcə/xərc yox.
    var isTamMaliyye = isAdmin || User.IsInRole(RoleNames.Muhasib) || isHR;
    var hasPanelPerm = false;
    if (!isTamMaliyye && !isRehberRol && User.Identity?.IsAuthenticated == true)
    {
        var _pid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(_pid, out var _puid))
        {
            var _pr = await _permSvc.HasPermissionAsync(_puid, "muhasibat_dashboard_bax");
            hasPanelPerm = _pr.Success && _pr.Data;
        }
    }
    var canPanel = isTamMaliyye || isRehberRol || hasPanelPerm;   // paneli görə bilər

    // Avtopark idarəetməsi (Maşınlar, Müddətlər) — Admin + `avtopark_idare`
    // icazəsi. Şərt `AvtoparkIdareIcazesiAttribute` ilə EYNİ olmalıdır, yoxsa
    // istifadəçi linki görüb 403 alar (və ya əksinə — icazəsi var, link yoxdur).
    // Mail (Gələn Maillər + Profildəki Mail Ayarları) — Admin + Rəhbər rolu +
    // «mail_istifade» icazəsi. Şərt `MailIcazesiAttribute` ilə EYNİ olmalıdır,
    // yoxsa istifadəçi linki görüb 403 alar (və ya əksinə).
    var hasMail = isAdmin || isRehberRol;
    if (!hasMail && User.Identity?.IsAuthenticated == true)
    {
        var _mid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(_mid, out var _muid))
        {
            var _mr = await _permSvc.HasPermissionAsync(_muid, "mail_istifade");
            hasMail = _mr.Success && _mr.Data;
        }
    }

    var hasAvtoparkIdare = isAdmin;
    if (!hasAvtoparkIdare && User.Identity?.IsAuthenticated == true)
    {
        var _aid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(_aid, out var _auid))
        {
            var _ar = await _permSvc.HasPermissionAsync(_auid, "avtopark_idare");
            hasAvtoparkIdare = _ar.Success && _ar.Data;
        }
    }
    // YALNIZ panel = rəhbər + qıraqdan icazə verilən (tam maliyyə işçisi deyil).
    // Maaş təsdiqi rəhbərə BİLDİRİŞ linki (redirectUrl → /HR/Maas) ilə gedir və
    // controller icazəsi qalır — yəni menyudan asılı deyil. Ona görə rəhbəri
    // yalnız panelə məhdudlaşdırmaq təsdiqi pozmur. Gələcəkdə lazım olsa icazə verilir.
    var panelYalniz = canPanel && !isTamMaliyye;

    var _layoutVezife = ViewData["UserRole"] as string ?? "";
    if (string.IsNullOrEmpty(_layoutVezife) && User.Identity?.IsAuthenticated == true)
    {
        var _dashRes = await _layoutDashSvc.GetDashboardAsync(User.Identity.Name!);
        if (_dashRes.Success && _dashRes.Data != null)
            _layoutVezife = _dashRes.Data.VezifeAdi ?? "";
    }

    // Hangı modul aktivdir — top tab-ı vurğulamaq + contextual sidebar üçün
    bool IsAccountingCtrl()
    {
        return currentController == "Maas"
            || currentController == "MaasParametri"
            || currentController == "AyliqElave"
            || currentController == "Budce"
            || currentController == "Xerc"
            || currentController == "XercKateqoriya"
            || currentController == "XercHesabat"
            || currentController == "IsciAyliqQazanc"
            || currentController == "MezuniyyetOdenis"
            || currentController == "Guzest"
            || currentController == "IsciGuzest"
            || currentController == "IsciHYS"
            // VM 98.2.1 dərəcəsi — Parametrlər & Güzəştlər qrupundadır; bu siyahıya
            // salınmasa səhifə açılanda sol menyu HR kontekstinə keçir və menyu
            // sətri görünmür (18.08.2026 — real hadisə).
            || currentController == "KreditFaizDerecesi"
            || currentController == "DovriOdenis"
            || currentController == "GozlenilenXerc"
            || currentController == "MaliyyeDashboard"
            || (currentController == "Avans" && currentArea == "HR")
            || (currentController == "DigerTutulma" && currentArea == "HR");
    }

    string DetectActiveModule()
    {
        // Əvvəl ümumi home səhifələrini yoxla (Chat, Elan, Inbox, Xatirlatma,
        // Profile) ki, onlara klik edəndə top tab "Əsas"-da qalsın və
        // sidebar "keçid" etməsin.
        if (currentController is "Chat" or "Elan" or "Inbox" or "Xatirlatma"
            or "Dashboard" or "Profile" && currentArea == "User")
            return "home";

        // Rəhbər Panel — Əsas sidebar-dan girilir, orada qalsın
        if (currentController == "RehberDashboard") return "home";

        if (currentArea == "HR")
            return IsAccountingCtrl() ? "muhasibat" : "hr";
        if (currentArea == "SenedDovriyyesi") return "umumi";
        if (currentArea == "PR_Odenis_Tapsirigi") return "umumi";
        if (currentArea == "Emeliyyat") return "emeliyyat";
        if (currentArea == "Avtopark") return "avtopark";
        if (currentArea == "Risk") return "risk";
        if (currentArea == "Muhasibat") return "muhasibat";
        if (currentController == "Tesdiq") return "tesdiq";
        if (currentController is "KreditMuraciet" or "KreditMuqavile" or "MuqavileSayghac") return "kredit";
        if (currentController is "PidSms" or "MehkemeIsi" or "OdenisNezareti" or "MehkemeCedvel") return "pid";
        if (currentController == "Hesabat" || currentController == "HesabatIzleme") return "hesabat";
        if (currentController == "Icaze" && currentAction is "Izleme" or "Dovriyye") return "hr";
        if (currentController is "Davamiyyet" or "Takvim" or "Mezuniyyet" or "Muraciet"
            or "Tapshiriq" or "Gorush" or "Icaze" or "Maas" or "Xerc" or "Avans")
            return "emekdas";
        if (currentController == "Teklif" && currentAction != "Idare")
            return "emekdas";
        return "home";
    }

    var activeModule = DetectActiveModule();

    string TabCls(string module) =>
        "fn-topnav-tab" + (activeModule == module ? " fn-topnav-tab--active" : "");

    string userName = User.Identity?.Name ?? "";
    var parts = userName.Split(' ');
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}"
        : userName.Length > 0 ? userName[0].ToString() : "?";

    // AI modul sidebar aktiv vəziyyəti
    var aiModule    = Context.Request.Query["module"].ToString();
    var isSYarat    = currentController == "SenedAi" && currentAction == "SenedYarat";
    var konstrAktiv = isSYarat && aiModule != "hr" && aiModule != "kredit" ? "active" : "";
    var hrAktiv     = isSYarat && aiModule == "hr"     ? "active" : "";
    var kreditAktiv = isSYarat && aiModule == "kredit" ? "active" : "";
    var hrMeslehetciAktiv = currentController == "HRMeslehetci" ? "active" : "";
    var aiRiskAktiv  = currentController == "SenedAi" && currentAction == "RiskAnaliz";
    var aiAnyActive  = aiRiskAktiv || !string.IsNullOrEmpty(konstrAktiv) || !string.IsNullOrEmpty(hrMeslehetciAktiv) || !string.IsNullOrEmpty(kreditAktiv);
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FinNex</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2332" />
    <meta name="application-name" content="BMI Finance" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="BMI Finance" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/User/user-area.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/createmezuniyyet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/User/topnav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fn-datepicker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <script>
        // Temanı səhifə rendera başlamadan tətbiq et — "flash" (saxta rəng
        // saniyəsi) yaranmasın deyə <body> görüşdən əvvəl class qoyulur.
        (function () {
            try {
                var t = localStorage.getItem('fn-theme') || 'ocean';
                document.documentElement.dataset.theme = t; // diaqnostika
            } catch (e) { }
        })();
    </script>
</head>
<body class="@(string.IsNullOrEmpty(ViewData["Theme"] as string) ? "" : "theme-" + ViewData["Theme"])">
    <script>
        // body element-inə tema class-ı tətbiq et (JS — localStorage-dən)
        (function () {
            try {
                var t = localStorage.getItem('fn-theme') || 'ocean';
                document.body.classList.add('theme-' + t);
            } catch (e) {
                document.body.classList.add('theme-ocean');
            }
        })();
    </script>

<!-- ══════════════════ YUXARI NAVBAR ══════════════════ -->
<header class="fn-topnav">
    <div class="fn-topnav-inner">
        <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="fn-topnav-brand">
            <img src="~/images/Logobank.jpg" alt="BMI" class="fn-topnav-logo" />
            <span class="fn-topnav-brand-text">BMI <b>Finance</b></span>
        </a>

        <nav class="fn-topnav-tabs">
            <a asp-area="User" asp-controller="Dashboard" asp-action="Index" class="@TabCls("home")">
                <i class="bi bi-house-door"></i><span>Əsas</span>
            </a>

            <a asp-area="User" asp-controller="Davamiyyet" asp-action="Index" class="@TabCls("emekdas")">
                <i class="bi bi-person-badge"></i><span>Əməkdaş</span>
            </a>

            @if (tesdiqGorunur)
            {
                var tesdiqAction = isSobeReisi ? "SobeReisi" : (isRehberRol ? "Rehber" : "Hr");
                <a asp-area="User" asp-controller="Tesdiq" asp-action="@tesdiqAction" class="@TabCls("tesdiq")">
                    <i class="bi bi-check2-square"></i><span>Təsdiq</span>
                </a>
            }

            @* "Ümumi xidmətlər" (SenedDovriyyesi + PR_Odenis_Tapsirigi) BİLƏRƏKDƏN bu
               siyahıda deyil — o, departament deyil, hamının işlətdiyi xidmətdir və
               ayrıca tab kimi aşağıda verilir. Buraya "umumi" qaytarılsa, Ümumi
               səhifələrində HƏM bu dropdown, HƏM də öz tabı aktiv görünər. *@
            @{
                var isDepartModule = activeModule is "kredit" or "hr" or "muhasibat" or "pid";
                var departActiveCls = isDepartModule ? " fn-topnav-tab--active" : "";
            }
            <div class="fn-topnav-dropdown @(isDepartModule ? "fn-topnav-dropdown--active" : "")">
                <button type="button" class="fn-topnav-tab @departActiveCls">
                    <i class="bi bi-grid-3x3-gap"></i><span>Departamentlər</span>
                    <i class="bi bi-chevron-down fn-topnav-caret"></i>
                </button>
                <div class="fn-topnav-dropdown-menu">
                    <a asp-area="User" asp-controller="KreditMuraciet" asp-action="Index"
                       class="fn-topnav-dd-item @(activeModule == "kredit" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-credit-card"></i>
                        <div>
                            <div class="fn-topnav-dd-title">Kredit</div>
                            <div class="fn-topnav-dd-sub">Müraciətlər, komitə, qərarlar</div>
                        </div>
                    </a>
                    @if (hrGorunur)
                    {
                        <a asp-area="HR" asp-controller="Dashboard" asp-action="Index"
                           class="fn-topnav-dd-item @(activeModule == "hr" ? "fn-topnav-dd-item--active" : "")">
                            <i class="bi bi-people"></i>
                            <div>
                                <div class="fn-topnav-dd-title">HR</div>
                                <div class="fn-topnav-dd-sub">Kadr, davamiyyət, qiymətləndirmə</div>
                            </div>
                        </a>
                    }
                    @if (canPanel)
                    {
                        <a asp-area="Muhasibat" asp-controller="Dashboard" asp-action="Index"
                           class="fn-topnav-dd-item @(activeModule == "muhasibat" ? "fn-topnav-dd-item--active" : "")">
                            <i class="bi bi-bank2"></i>
                            <div>
                                <div class="fn-topnav-dd-title">@(panelYalniz ? "Maliyyə & Risk Paneli" : "Mühasibatlıq")</div>
                                <div class="fn-topnav-dd-sub">@(panelYalniz ? "Balans, kredit keyfiyyəti, likvidlik, risk" : "Balans, likvidlik · maaş, avans, büdcə")</div>
                            </div>
                        </a>
                    }
                    <a asp-area="User" asp-controller="MehkemeIsi" asp-action="Monitorinq"
                       class="fn-topnav-dd-item @(activeModule == "pid" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-shield-exclamation"></i>
                        <div>
                            <div class="fn-topnav-dd-title">PİD</div>
                            <div class="fn-topnav-dd-sub">Problemli İşlər Departamenti</div>
                        </div>
                    </a>
                    <a asp-area="Emeliyyat" asp-controller="Dashboard" asp-action="Index"
                       class="fn-topnav-dd-item @(activeModule == "emeliyyat" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-arrow-left-right"></i>
                        <div>
                            <div class="fn-topnav-dd-title">Əməliyyat</div>
                            <div class="fn-topnav-dd-sub">Pul köçürməsi — həvalələr</div>
                        </div>
                    </a>
                    <a asp-area="Risk" asp-controller="Dashboard" asp-action="Index"
                       class="fn-topnav-dd-item @(activeModule == "risk" ? "fn-topnav-dd-item--active" : "")">
                        <i class="bi bi-shield-exclamation"></i>
                        <div>
                            <div class="fn-topnav-dd-title">Risk</div>
                            <div class="fn-topnav-dd-sub">Risk / AML hesabatları</div>
                        </div>
                    </a>
                </div>
            </div>

            @* Ümumi xidmətlər — sənəd dövriyyəsi, məktublar, həvalə, Swift / ödəniş.
               Departament deyil (bir şöbəyə aid deyil), ona görə "Departamentlər"
               dropdown-undan çıxarılıb ayrıca tab edilib. Dropdown-dakı kimi
               burada da icazə şərti YOXDUR — bütün istifadəçilər görür. *@
            <a asp-area="SenedDovriyyesi" asp-controller="Dashboard" asp-action="Index" class="@TabCls("umumi")">
                <i class="bi bi-folder2"></i><span>Ümumi xidmətlər</span>
            </a>

            @* Avtopark — xidməti maşınlar. «Ümumi xidmətlər» kimi DEPARTAMENT DEYİL:
               maşından bütün şöbələr istifadə edir, ona görə «Departamentlər»
               dropdown-una qoyulmur. İcazə şərti yoxdur — müraciəti hər işçi yaza
               bilir; kassa/təsdiq ekranlarını controller-lərin öz rolları qoruyur. *@
            <a asp-area="Avtopark" asp-controller="Muraciet" asp-action="Index" class="@TabCls("avtopark")">
                <i class="bi bi-car-front"></i><span>Avtopark</span>
            </a>

            @if (isMuhasib || isRehberRol)
            {
                <a asp-area="User" asp-controller="Hesabat" asp-action="Index" class="@TabCls("hesabat")">
                    <i class="bi bi-bar-chart"></i><span>Hesabatlar</span>
                </a>
            }
        </nav>

        <div class="fn-topnav-right">
            <a asp-area="User" asp-controller="Xatirlatma" asp-action="Index"
               class="fn-topnav-icon" id="xatirlatmaBtn" title="Xatırlatmalar">
                <i class="bi bi-clock"></i>
                <span class="fn-topnav-badge" id="xatirlatmaCount" style="display:none">0</span>
            </a>
            <a asp-area="User" asp-controller="Chat" asp-action="Index"
               class="fn-topnav-icon" id="chatBtn" title="Chat">
                <i class="bi bi-chat-dots"></i>
                <span class="fn-topnav-badge" id="chatCount" style="display:none">0</span>
            </a>
            @if (hasMail)
            {
                <a asp-area="User" asp-controller="GelenMail" asp-action="Index"
                   class="fn-topnav-icon" id="gelenMailBtn" title="Gələn Maillər"
                   style="color:#0f766e">
                    <i class="bi bi-envelope-fill"></i>
                    <span class="fn-topnav-badge fn-topnav-badge--teal" id="gelenMailCount" style="display:none">0</span>
                </a>
            }
            <a asp-area="User" asp-controller="Inbox" asp-action="Index"
               asp-route-tab="bildirisler"
               class="fn-topnav-icon" id="notifBtn" title="Bildirişlər">
                <i class="bi bi-bell"></i>
                <span class="fn-topnav-badge" id="notifCount" style="display:none">0</span>
            </a>

            <div class="fn-topnav-user" tabindex="0">
                <div class="fn-topnav-avatar">@initials</div>
                <div class="fn-topnav-user-info">
                    <div class="fn-topnav-user-name">@userName</div>
                    <div class="fn-topnav-user-role">@_layoutVezife</div>
                </div>
                <div class="fn-topnav-user-menu">
                    <a asp-area="User" asp-controller="Profile" asp-action="Index" class="fn-topnav-user-menu-item">
                        <i class="bi bi-person"></i> Profil
                    </a>

                    <div class="fn-topnav-user-menu-divider"></div>

                    <div class="fn-theme-label">Tema</div>
                    <div class="fn-theme-row">
                        <button type="button" class="fn-theme-chip fn-theme-chip--red" data-theme="red" title="Bank Melli qırmızı"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--ocean" data-theme="ocean" title="Okean göy"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--forest" data-theme="forest" title="Zümrüd yaşıl"></button>
                        <button type="button" class="fn-theme-chip fn-theme-chip--midnight" data-theme="midnight" title="Gecə qara"></button>
                    </div>

                    <div class="fn-topnav-user-menu-divider"></div>

                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="fn-topnav-user-menu-item fn-topnav-user-menu-danger">
                            <i class="bi bi-box-arrow-right"></i> Çıxış
                        </button>
                    </form>
                </div>
            </div>

            <button type="button" class="fn-topnav-burger" id="fnBurgerBtn" title="Menyu">
                <i class="bi bi-list"></i>
            </button>
        </div>
    </div>
</header>

<div class="fn-layout2">

    <!-- ══════════════════ KONTEKSTUAL SİDEBAR ══════════════════ -->
    <aside class="fn-sidebar2" id="fnSidebar">

        @switch (activeModule)
        {
            case "home":
                <div class="fn-nav-label">Əsas</div>
                <a asp-area="User" asp-controller="Dashboard" asp-action="Index"
                   class="fn-nav-item @(currentController == "Dashboard" && currentArea == "User" ? "active" : "")">
                    <i class="bi bi-grid"></i> Dashboard
                </a>
                @if (isRehberRol || isAdmin)
                {
                    <a asp-area="HR" asp-controller="RehberDashboard" asp-action="Index"
                       class="fn-nav-item @(currentController == "RehberDashboard" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Rəhbər Panel
                    </a>
                    <a asp-area="HR" asp-controller="Davamiyyet" asp-action="Index"
                       class="fn-nav-item fn-nav-item--sub @(currentController == "Davamiyyet" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i> Davamiyyət
                    </a>
                    <a asp-area="User" asp-controller="Icaze" asp-action="Izleme"
                       class="fn-nav-item fn-nav-item--sub @(currentController == "Icaze" && currentAction == "Izleme" ? "active" : "")">
                        <i class="bi bi-bar-chart-line"></i> İcazə İzləmə
                    </a>
                    <a asp-area="User" asp-controller="Teklif" asp-action="Idare"
                       class="fn-nav-item @(currentController == "Teklif" && currentAction == "Idare" ? "active" : "")">
                        <i class="bi bi-lightbulb-fill"></i> Təkliflər (İdarə)
                    </a>
                    <div class="fn-nav-g @(aiAnyActive ? "open" : "")">
                        <button type="button" class="fn-nav-g-head">
                            <span>AI Modulları</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="fn-nav-g-body">
                            <a asp-area="User" asp-controller="SenedAi" asp-action="RiskAnaliz"
                               class="fn-nav-item @(aiRiskAktiv ? "active" : "")">
                                <i class="bi bi-shield-exclamation"></i> Sənəd Risk Analizi
                            </a>
