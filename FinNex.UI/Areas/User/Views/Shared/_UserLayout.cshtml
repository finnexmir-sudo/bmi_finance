<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/User/user-area.js" asp-append-version="true"></script>
<script src="~/js/User/Bildiris.js" asp-append-version="true"></script>
<script src="~/js/date-format-hint.js" asp-append-version="true"></script>
<script src="~/js/fn-datepicker.js" asp-append-version="true"></script>
<script>
    // Hamburger (mobile) — sidebar toggle
    document.getElementById('fnBurgerBtn')?.addEventListener('click', function () {
        document.getElementById('fnSidebar')?.classList.toggle('fn-sidebar2--open');
    });

    // User menu toggle
    (function () {
        var u = document.querySelector('.fn-topnav-user');
        if (!u) return;
        u.addEventListener('click', function (e) {
            if (e.target.closest('.fn-topnav-user-menu')) return;
            u.classList.toggle('fn-topnav-user--open');
        });
        document.addEventListener('click', function (e) {
            if (!u.contains(e.target)) u.classList.remove('fn-topnav-user--open');
        });
    })();

    // Departamentlər dropdown — yalnız hover ilə açılır (klik yoxdur)
    // CSS :hover pattern-i işləyir, JS gərək deyil.

    // Sidebar accordion qrupları — header-ə klik qrupu aç/bağla.
    // Yalnız aktiv səhifəyə uyğun qrup default açıq olur (Razor tərəfindən
    // `.open` class-ı ilə işarələnir). Səhifə yenidən yüklənəndə vəziyyət
    // YADDA SAXLANMIR — istifadəçinin əvvəl açdıqları qruplar səhifə
    // dəyişəndən sonra avtomatik bağlanır. Belə davranış istifadəçinin
    // "ilk dəfə açanda hamısı açıq görünür" şikayətini aradan qaldırır.
    document.querySelectorAll('.fn-nav-g-head').forEach(function (btn) {
        btn.addEventListener('click', function () {
            btn.parentElement.classList.toggle('open');
        });
    });

    // Tema seçici
    (function () {
        function markActiveChip() {
            var current = localStorage.getItem('fn-theme') || 'ocean';
            document.querySelectorAll('.fn-theme-chip').forEach(function (c) {
                c.classList.toggle('active', c.dataset.theme === current);
            });
        }
        markActiveChip();

        document.querySelectorAll('.fn-theme-chip').forEach(function (chip) {
            chip.addEventListener('click', function (e) {
                e.stopPropagation();
                var theme = chip.dataset.theme;
                // Köhnə tema class-larını təmizlə
                document.body.classList.remove('theme-red', 'theme-ocean', 'theme-forest', 'theme-midnight');
                document.body.classList.add('theme-' + theme);
                localStorage.setItem('fn-theme', theme);
                markActiveChip();
            });
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
