                    </div>
                }
                break;

            case "emeliyyat":
                {
                    <a asp-area="Emeliyyat" asp-controller="Dashboard" asp-action="Index"
                       class="fn-nav-item @(currentController == "Dashboard" && currentArea == "Emeliyyat" ? "active" : "")">
                        <i class="bi bi-grid"></i> Dashboard
                    </a>
                    <a asp-area="Emeliyyat" asp-controller="PulKocurme" asp-action="Index"
                       class="fn-nav-item @(currentController == "PulKocurme" ? "active" : "")">
                        <i class="bi bi-cash-stack"></i> Pul köçürməsi
                    </a>
                    <a asp-area="Emeliyyat" asp-controller="TelebeKocurme" asp-action="Index"
                       class="fn-nav-item @(currentController == "TelebeKocurme" ? "active" : "")">
                        <i class="bi bi-mortarboard"></i> Tələbə köçürməsi
                    </a>
                }
                break;

            case "avtopark":
                {
                    @* MENYU QƏSDƏN QISADIR (19.08.2026 — «sadələşdirək» qərarı).
                       Aşağıdakılar buradan ÇIXARILDI, amma SİLİNMƏDİ — hər biri
                       öz səhifəsinin içində düymə kimi qalır:
                         Çöldə olanlar     → Təsdiq panelində
                         Jurnal tarixçəsi  → Açar jurnalında («Tarixçə»)
                         Yaxınlaşanlar     → Müddətlərdə (+ Maşınlar səhifəsində)
                         Növlər            → Müddətlərdə
                         Xəbərdarlıq alıcıları → Müddətlərdə
                       Yeni link əlavə etməzdən əvvəl düşün: gündəlik işlənmirsə
                       menyuda yeri yoxdur. *@
                    <div class="fn-nav-label">Avtopark</div>
                    <a asp-area="Avtopark" asp-controller="Muraciet" asp-action="Index"
                       class="fn-nav-item @(currentController == "Muraciet" && currentArea == "Avtopark" ? "active" : "")">
                        <i class="bi bi-card-checklist"></i> Müraciətlərim
                    </a>

                    @* Yol vərəqəsi — HƏR İŞÇİ görür (20.08.2026 qərarı).
                       Sənəd sürücünün özündə olmalıdır, ona görə rol şərti yoxdur;
                       controller-də də sadəcə `[Authorize]` var. *@
                    <a asp-area="Avtopark" asp-controller="YolVereqesi" asp-action="Index"
                       class="fn-nav-item @(currentController == "YolVereqesi" ? "active" : "")">
                        <i class="bi bi-file-earmark-text"></i> Yol vərəqəsi
                    </a>

                    @* Şərtlər controller-dəki [Authorize] ilə EYNİ olmalıdır —
                       linki görüb 403 almaq istifadəçini çaşdırır. *@
                    @if (User.IsInRole(RoleNames.Rehber) || isAdmin)
                    {
                        @* Aktivlik ACTION-a görə yox, CONTROLLER-ə görədir:
                           «Çöldə olanlar» ayrıca link olmadığı üçün ora keçəndə
                           menyuda heç nə seçili qalmazdı. *@
                        <a asp-area="Avtopark" asp-controller="Tesdiq" asp-action="Index"
                           class="fn-nav-item @(currentController == "Tesdiq" && currentArea == "Avtopark" ? "active" : "")">
                            <i class="bi bi-check2-square"></i> Təsdiq paneli
                        </a>
                    }

                    @if (User.IsInRole(RoleNames.Kassa) || User.IsInRole(RoleNames.Rehber) || isAdmin)
                    {
                        <a asp-area="Avtopark" asp-controller="Kassa" asp-action="Index"
                           class="fn-nav-item @(currentController == "Kassa" ? "active" : "")">
                            <i class="bi bi-key"></i> Açar jurnalı
                        </a>
                    }

                    @if (hasAvtoparkIdare)
                    {
                        <div class="fn-nav-label">İdarəetmə</div>
                        <a asp-area="Avtopark" asp-controller="Masin" asp-action="Index"
                           class="fn-nav-item @(currentController == "Masin" ? "active" : "")">
                            <i class="bi bi-car-front"></i> Maşınlar
                        </a>
                        <a asp-area="Avtopark" asp-controller="Muddet" asp-action="Index"
                           class="fn-nav-item @(currentController == "Muddet" ? "active" : "")">
                            <i class="bi bi-calendar-check"></i> Müddətlər
                        </a>
                    }
                }
                break;

            case "risk":
                {
                    <div class="fn-nav-label">Risk Departamenti</div>
                    <a asp-area="Risk" asp-controller="Dashboard" asp-action="Index"
                       class="fn-nav-item @(currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-grid"></i> Hesabatlar
                    </a>
                }
                break;

            case "hesabat":
                <div class="fn-nav-label">Hesabatlar</div>
                <a asp-area="User" asp-controller="Hesabat" asp-action="Index"
                   class="fn-nav-item @(currentController == "Hesabat" && currentArea == "User" ? "active" : "")">
                    <i class="bi bi-graph-up"></i> Məzuniyyət / İcazə
                </a>
                @if (isMuhasib)
                {
                    <a asp-area="User" asp-controller="HesabatIzleme" asp-action="Index"
                       class="fn-nav-item @(currentController == "HesabatIzleme" ? "active" : "")">
                        <i class="bi bi-clipboard-check"></i> Hesabat İzləmə
                    </a>
                }
                break;
        }

    </aside>

    <!-- ══════════════════ ƏSAS KONTENT ══════════════════ -->
    <main class="fn-main2">

        <div class="fn-topbar-wrap">
            @if (ViewData["HideBackButton"] == null)
            {
                <button onclick="history.back()" class="fn-back-btn" title="Geri qayıt">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Geri
                </button>
            }
            <div>
                <div class="fn-topbar-title">@ViewData["Title"]</div>
                <div class="fn-topbar-sub">@(ViewData["TopbarTarix"] ?? (object)DateTime.Now.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("az-Latn-AZ")))</div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="fn-alert fn-alert--success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="fn-alert fn-alert--error">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/User/user-area.js" asp-append-version="true"></script>
<script src="~/js/User/Bildiris.js" asp-append-version="true"></script>
<script src="~/js/date-format-hint.js" asp-append-version="true"></script>
<script src="~/js/fn-datepicker.js" asp-append-version="true"></script>
<script>
    // Hamburger (mobile) — sidebar toggle
    document.getElementById('fnBurgerBtn')?.addEventListener('click', function () {
        document.getElementById('fnSidebar')?.classList.toggle('fn-sidebar2--open');
    });

    // User menu toggle
    (function () {
        var u = document.querySelector('.fn-topnav-user');
        if (!u) return;
        u.addEventListener('click', function (e) {
            if (e.target.closest('.fn-topnav-user-menu')) return;
            u.classList.toggle('fn-topnav-user--open');
        });
        document.addEventListener('click', function (e) {
            if (!u.contains(e.target)) u.classList.remove('fn-topnav-user--open');
        });
    })();

    // Departamentlər dropdown — yalnız hover ilə açılır (klik yoxdur)
    // CSS :hover pattern-i işləyir, JS gərək deyil.

    // Sidebar accordion qrupları — header-ə klik qrupu aç/bağla.
    // Yalnız aktiv səhifəyə uyğun qrup default açıq olur (Razor tərəfindən
    // `.open` class-ı ilə işarələnir). Səhifə yenidən yüklənəndə vəziyyət
    // YADDA SAXLANMIR — istifadəçinin əvvəl açdıqları qruplar səhifə
    // dəyişəndən sonra avtomatik bağlanır. Belə davranış istifadəçinin
    // "ilk dəfə açanda hamısı açıq görünür" şikayətini aradan qaldırır.
    document.querySelectorAll('.fn-nav-g-head').forEach(function (btn) {
        btn.addEventListener('click', function () {
            btn.parentElement.classList.toggle('open');
        });
    });

    // Tema seçici
    (function () {
        function markActiveChip() {
            var current = localStorage.getItem('fn-theme') || 'ocean';
            document.querySelectorAll('.fn-theme-chip').forEach(function (c) {
                c.classList.toggle('active', c.dataset.theme === current);
            });
        }
        markActiveChip();

        document.querySelectorAll('.fn-theme-chip').forEach(function (chip) {
            chip.addEventListener('click', function (e) {
                e.stopPropagation();
                var theme = chip.dataset.theme;
                // Köhnə tema class-larını təmizlə
                document.body.classList.remove('theme-red', 'theme-ocean', 'theme-forest', 'theme-midnight');
                document.body.classList.add('theme-' + theme);
                localStorage.setItem('fn-theme', theme);
                markActiveChip();
            });
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)

<script>
(function () {
    // Nav sidebar badge (köhnə)
    var navBadge = document.querySelector('.fn-mail-badge');
    // Topbar badge
    var topBadge = document.getElementById('gelenMailCount');
    if (!navBadge && !topBadge) return;
    var url = (navBadge && navBadge.getAttribute('data-badge-url'))
           || '@Url.Action("OxunmamisSay", "GelenMail", new { area = "User" })';
    if (!url) return;
    function refreshMailBadge() {
        fetch(url).then(function(r){ return r.json(); }).then(function(d){
            var say = d.say || 0;
            if (navBadge) {
                navBadge.textContent = say;
                navBadge.style.display = say > 0 ? 'inline-flex' : 'none';
            }
            if (topBadge) {
                topBadge.textContent = say;
                topBadge.style.display = say > 0 ? 'inline-flex' : 'none';
            }
        }).catch(function(){});
    }
    refreshMailBadge();
    setInterval(refreshMailBadge, 120000);
})();
</script>

    @* Səhifə təlimatı — «?» düyməsi. Tam yol yazılır ki, bütün area-lardan
       tapılsın. Login səhifəsinə (_AuthLayout) QƏSDƏN qoyulmayıb. *@
    @await Html.PartialAsync("~/Views/Shared/_YardimDuymesi.cshtml")
