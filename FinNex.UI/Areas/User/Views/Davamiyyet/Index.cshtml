@using FinNex.Application.DTOs.HR.Davamiyyet
@using FinNex.Domain.Entities.HR
@using FinNex.UI.Areas.User.Controllers
@model IList<DavamiyyetListDto>
@{
    ViewData["Title"] = "Davamiyyət";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var list = Model ?? new List<DavamiyyetListDto>();

    // Statlar controller-də HR ilə eyni məntiqlə hesablanır (erkən çıxış: ErkenCixisIcaze +
    // BayramGunu + IsGunuBitdiElan + status istisnaları; İcazəli: məzuniyyət günləri çıxılır).
    var stats = ViewBag.Stats as DavamiyyetStatlar ?? new DavamiyyetStatlar();
    var tezCixanIds = ViewBag.TezCixanIds as HashSet<int> ?? new HashSet<int>();

    var isdeSayi = stats.Isde;
    var gecikmeSayi = stats.Gecikme;
    var qayibSayi = stats.Qayib;
    var icazeliSayi = stats.Icazeli;
    var tezCixanSayi = stats.TezCixan;
    var cixisYoxSayi = stats.CixisYox;
    var mezuniyyetGun = (int)(ViewBag.MezuniyyetGun ?? 0);
    var cemi = stats.Cemi;

    var girisVaxtiStr = ViewBag.GirisVaxti as string ?? "09:00";
    var cixisVaxtiStr = ViewBag.CixisVaxti as string ?? "17:45";
    int gecikmeTolerans = (int)(ViewBag.GecikmeTolerans ?? 5);
    int tezCixmaTolerans = (int)(ViewBag.TezCixmaTolerans ?? 15);

    // Gecikmə vurğusu üçün hədd (erkən çıxış vurğusu artıq controller-dən gəlir)
    var girisParts = girisVaxtiStr.Split(':');
    int girisH = int.Parse(girisParts[0]), girisM = int.Parse(girisParts[1]);
    int lateThreshMin = girisH * 60 + girisM + gecikmeTolerans;
}

<div class="ud-page">

    <div class="ud-head">
        <div>
            <h2 class="ud-title">Davamiyyətim</h2>
            <p class="ud-sub">@DateTime.Today.Year-ci il üzrə giriş-çıxış qeydləri və statistika</p>
        </div>
    </div>

    <div class="ud-kpi-row">
        <div class="ud-kpi ud-kpi--clickable" data-filter="1" title="İşdə olan günlərə bax">
            <div class="ud-kpi-icon ud-kpi-icon--green">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiIsde">@isdeSayi</div>
                <div class="ud-kpi-lbl">İşdə</div>
            </div>
        </div>
        <div class="ud-kpi ud-kpi--clickable" data-filter="2" title="Gecikdiyim günlərə bax">
            <div class="ud-kpi-icon ud-kpi-icon--amber">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiGecikme">@gecikmeSayi</div>
                <div class="ud-kpi-lbl">Gecikmə</div>
            </div>
        </div>
        <div class="ud-kpi ud-kpi--clickable" data-filter="3" title="Qayib olduğum günlərə bax">
            <div class="ud-kpi-icon ud-kpi-icon--red">
                <i class="bi bi-x-circle-fill"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiQayib">@qayibSayi</div>
                <div class="ud-kpi-lbl">Qayıb</div>
            </div>
        </div>
        <div class="ud-kpi ud-kpi--clickable" data-filter="4" title="Saat icazəli günlərə bax" style="position:relative">
            <a asp-area="User" asp-controller="Icaze" asp-action="Index"
               class="ud-kpi-link" title="İcazə müraciətlərim" style="position:absolute;top:6px;right:8px;font-size:11px;color:var(--fn-primary);text-decoration:none;">
                <i class="bi bi-box-arrow-up-right"></i>
            </a>
            <div class="ud-kpi-icon ud-kpi-icon--blue">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiIcazeli">@icazeliSayi</div>
                <div class="ud-kpi-lbl">Saat İcazəsi</div>
            </div>
        </div>
        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
           class="ud-kpi ud-kpi--clickable" style="text-decoration:none;color:inherit" title="Məzuniyyət müraciətlərimə keç">
            <div class="ud-kpi-icon ud-kpi-icon--purple" style="background:rgba(139,92,246,.12);color:#8b5cf6;">
                <i class="bi bi-tree"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val">@mezuniyyetGun</div>
                <div class="ud-kpi-lbl">Məzuniyyət günü</div>
            </div>
        </a>
        <div class="ud-kpi ud-kpi--clickable" data-filter="tezCixan" title="Erkən çıxdığım günlərə bax">
            <div class="ud-kpi-icon ud-kpi-icon--orange">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiTezCixan">@tezCixanSayi</div>
                <div class="ud-kpi-lbl">Erkən çıxış</div>
            </div>
        </div>
        <div class="ud-kpi ud-kpi--clickable" data-filter="cixisYox" title="Çıxış vurmadığım günlərə bax">
            <div class="ud-kpi-icon ud-kpi-icon--slate">
                <i class="bi bi-door-open"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiCixisYox">@cixisYoxSayi</div>
                <div class="ud-kpi-lbl">Çıxış yoxdur</div>
            </div>
        </div>
        <div class="ud-kpi ud-kpi--total">
            <div class="ud-kpi-icon ud-kpi-icon--indigo">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="ud-kpi-body">
                <div class="ud-kpi-val" id="kpiCemi">@cemi</div>
                <div class="ud-kpi-lbl">Cəmi qeyd</div>
            </div>
        </div>
    </div>

    <div id="udIntizamSection" class="ud-intizam-section" style="display:none">
        <div class="ud-intizam-head">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Diqqət tələb edən qeydlər
        </div>
        <div class="ud-intizam-chips" id="udIntizamChips"></div>
    </div>

    <div class="ud-filter-panel">
        <div class="ud-filter-row">
            <div class="ud-filter-group">
                <label class="ud-filter-lbl">Başlanğıc</label>
                <input type="date" id="udBaslangic" class="ud-input" />
            </div>
            <div class="ud-filter-group">
                <label class="ud-filter-lbl">Son</label>
                <input type="date" id="udSon" class="ud-input" />
            </div>
            <div class="ud-filter-group">
                <label class="ud-filter-lbl">Status</label>
                <select id="udStatus" class="ud-select">
                    <option value="">Hamısı</option>
                    <option value="1">İşdə</option>
                    <option value="2">Gecikmə</option>
                    <option value="3">Qayıb</option>
                    <option value="4">İcazəli</option>
                    <option value="tezCixan">Erkən çıxış</option>
                    <option value="cixisYox">Çıxış yoxdur</option>
                </select>
            </div>
            <button id="udAxtar" class="ud-btn ud-btn--primary">
                <i class="bi bi-search"></i> Axtar
            </button>
        </div>
    </div>

    <div class="ud-table-card">
        <div class="ud-table-head">
            <div class="ud-table-title">
                <i class="bi bi-table"></i> Davamiyyət tarixçəsi
            </div>
            <div class="ud-table-meta">
                <span class="ud-record-count" id="udRecordCount">@cemi qeyd</span>
            </div>
        </div>

        <div class="ud-table-wrap">
            <table class="ud-table">
                <thead>
                    <tr>
                        <th>Tarix</th>
                        <th>Giriş</th>
                        <th>Çıxış</th>
                        <th>İş saatı</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="udTableBody">
                    @if (list.Any())
                    {
                        @foreach (var item in list.OrderByDescending(x => x.Tarix))
                        {
                            var isLate = item.GirisVaxti.HasValue &&
                                (item.GirisVaxti.Value.Hour * 60 + item.GirisVaxti.Value.Minute) > lateThreshMin;
                            var isEarly = tezCixanIds.Contains(item.Id);
                            <tr>
                                <td>
                                    <div class="ud-date">@item.Tarix.ToString("dd.MM.yyyy")</div>
                                </td>
                                <td>
                                    @if (item.GirisVaxti.HasValue)
                                    {
                                        <span class="ud-time @(isLate ? "ud-time--late" : "")">
                                            @item.GirisVaxti.Value.ToString("HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="ud-nodata">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.CixisVaxti.HasValue)
                                    {
                                        <span class="ud-time @(isEarly ? "ud-time--early" : "")">@item.CixisVaxti.Value.ToString("HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="ud-nodata">--:--</span>
                                    }
                                </td>
                                <td>
                                    @if (item.GirisVaxti.HasValue && item.CixisVaxti.HasValue)
                                    {
                                        var dur = item.CixisVaxti.Value - item.GirisVaxti.Value;
                                        var cls = dur.TotalHours < 8 ? "ud-dur--short" : "ud-dur--ok";
                                        <span class="ud-dur @cls">@dur.Hours s @dur.Minutes d</span>
                                    }
                                    else
                                    {
                                        <span class="ud-nodata">---</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case DavamiyyetStatus.Isde:
                                            <span class="ud-badge ud-badge--isde"><span class="ud-badge-dot"></span>İşdə</span>
                                            break;
                                        case DavamiyyetStatus.Gecikme:
                                            <span class="ud-badge ud-badge--gecikme"><span class="ud-badge-dot"></span>Gecikmə</span>
                                            break;
                                        case DavamiyyetStatus.Qayib:
                                            <span class="ud-badge ud-badge--qayib"><span class="ud-badge-dot"></span>Qayıb</span>
                                            break;
                                        case DavamiyyetStatus.Icazeli:
                                            <span class="ud-badge ud-badge--icazeli"><span class="ud-badge-dot"></span>İcazəli</span>
                                            break;
                                        case DavamiyyetStatus.Xestelik:
                                            <span class="ud-badge ud-badge--xestelik" style="background:rgba(168,85,247,.1);color:#a855f7;"><span class="ud-badge-dot" style="background:#a855f7;"></span>Xəstəlik</span>
                                            break;
                                        case DavamiyyetStatus.Ezamiyyet:
                                            <span class="ud-badge ud-badge--ezamiyyet" style="background:rgba(249,115,22,.1);color:#f97316;"><span class="ud-badge-dot" style="background:#f97316;"></span>Ezamiyyət</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                <div class="ud-empty">
                                    <i class="bi bi-inbox"></i>
                                    <div>Hələ davamiyyət qeydiniz yoxdur</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-davamiyyet.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.isParametriData = {
            girisVaxti: '@girisVaxtiStr',
            cixisVaxti: '@cixisVaxtiStr',
            gecikmeTolerans: @gecikmeTolerans,
            tezCixmaTolerans: @tezCixmaTolerans
        };
        window.udInitStats = {
            gecikme: @gecikmeSayi,
            tezCixan: @tezCixanSayi,
            qayib: @qayibSayi,
            cixisYox: @cixisYoxSayi
        };
    </script>
    <script src="~/js/User/user-davamiyyet.js" asp-append-version="true"></script>
}
