@using FinNex.Application.DTOs.HR.Davamiyyet
@using FinNex.Domain.Entities.HR
@model IList<DavamiyyetListDto>
@{
    ViewData["Title"] = "Davamiyyət";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole("Operator") ? "Operator" : "";

    var list = Model ?? new List<DavamiyyetListDto>();

    var isdeSayi = list.Count(x => x.Status == DavamiyyetStatus.Isde);
    var gecikmeSayi = list.Count(x => x.Status == DavamiyyetStatus.Gecikme);
    var qayibSayi = list.Count(x => x.Status == DavamiyyetStatus.Qayib);
    var icazeliSayi = list.Count(x => x.Status == DavamiyyetStatus.Icazeli);
    var cemi = list.Count;

    // Aylıq xülasə (cari ay)
    var buAy = list.Where(x => x.Tarix.Month == DateTime.Now.Month && x.Tarix.Year == DateTime.Now.Year).ToList();
    var ayIsde = buAy.Count(x => x.Status == DavamiyyetStatus.Isde);
    var ayGecikme = buAy.Count(x => x.Status == DavamiyyetStatus.Gecikme);
    var ayQayib = buAy.Count(x => x.Status == DavamiyyetStatus.Qayib);
    var ayIcazeli = buAy.Count(x => x.Status == DavamiyyetStatus.Icazeli);
    var ayCemi = buAy.Count;
}

<div class="fn-dvm-page">

    @* ── Başlıq ── *@
    <div class="fn-dvm-head">
        <div>
            <div class="fn-dvm-title">Davamiyyətim</div>
            <div class="fn-dvm-sub">Giriş-çıxış qeydləriniz və iş saatlarınız</div>
        </div>
    </div>

    @* ── Statistika kartları ── *@
    <div class="fn-dvm-stats">
        <div class="fn-dvm-stat">
            <div class="fn-dvm-stat-icon fn-dvm-stat-icon--green">
                <svg viewBox="0 0 20 20" fill="none">
                    <path d="M16.7 5.3L8 14l-4.7-4.7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div>
                <div class="fn-dvm-stat-val" id="statIsde">@isdeSayi</div>
                <div class="fn-dvm-stat-lbl">İşdə</div>
            </div>
        </div>

        <div class="fn-dvm-stat">
            <div class="fn-dvm-stat-icon fn-dvm-stat-icon--orange">
                <svg viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M10 6v4.5l3 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <div class="fn-dvm-stat-val" id="statGecikme">@gecikmeSayi</div>
                <div class="fn-dvm-stat-lbl">Gecikmə</div>
            </div>
        </div>

        <div class="fn-dvm-stat">
            <div class="fn-dvm-stat-icon fn-dvm-stat-icon--red">
                <svg viewBox="0 0 20 20" fill="none">
                    <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M7 7l6 6M13 7l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <div class="fn-dvm-stat-val" id="statQayib">@qayibSayi</div>
                <div class="fn-dvm-stat-lbl">Qayıb</div>
            </div>
        </div>

        <div class="fn-dvm-stat">
            <div class="fn-dvm-stat-icon fn-dvm-stat-icon--blue">
                <svg viewBox="0 0 20 20" fill="none">
                    <rect x="3" y="4" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M3 8h14M7 4v3M13 4v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                </svg>
            </div>
            <div>
                <div class="fn-dvm-stat-val" id="statCemi">@cemi</div>
                <div class="fn-dvm-stat-lbl">Cəmi qeyd</div>
            </div>
        </div>
    </div>

    @* ── Aylıq xülasə ── *@
    @if (ayCemi > 0)
    {
        <div class="fn-dvm-summary">
            <div class="fn-dvm-summary-card">
                <div class="fn-dvm-summary-title">@DateTime.Now.ToString("MMMM yyyy") — Aylıq xülasə</div>
                <div class="fn-dvm-progress-row" id="summaryIsde">
                    <div class="fn-dvm-progress-lbl">İşdə</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(ayCemi > 0 ? (int)((double)ayIsde / ayCemi * 100) : 0)%;background:#10b981"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@ayIsde</div>
                </div>
                <div class="fn-dvm-progress-row" id="summaryGecikme">
                    <div class="fn-dvm-progress-lbl">Gecikmə</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(ayCemi > 0 ? (int)((double)ayGecikme / ayCemi * 100) : 0)%;background:#f59e0b"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@ayGecikme</div>
                </div>
                <div class="fn-dvm-progress-row" id="summaryQayib">
                    <div class="fn-dvm-progress-lbl">Qayıb</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(ayCemi > 0 ? (int)((double)ayQayib / ayCemi * 100) : 0)%;background:#ef4444"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@ayQayib</div>
                </div>
                <div class="fn-dvm-progress-row" id="summaryIcazeli">
                    <div class="fn-dvm-progress-lbl">İcazəli</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(ayCemi > 0 ? (int)((double)ayIcazeli / ayCemi * 100) : 0)%;background:#2d6cdf"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@ayIcazeli</div>
                </div>
            </div>

            <div class="fn-dvm-summary-card">
                <div class="fn-dvm-summary-title">Ümumi statistika</div>
                <div class="fn-dvm-progress-row">
                    <div class="fn-dvm-progress-lbl">İşdə</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(cemi > 0 ? (int)((double)isdeSayi / cemi * 100) : 0)%;background:#10b981"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@isdeSayi</div>
                </div>
                <div class="fn-dvm-progress-row">
                    <div class="fn-dvm-progress-lbl">Gecikmə</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(cemi > 0 ? (int)((double)gecikmeSayi / cemi * 100) : 0)%;background:#f59e0b"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@gecikmeSayi</div>
                </div>
                <div class="fn-dvm-progress-row">
                    <div class="fn-dvm-progress-lbl">Qayıb</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(cemi > 0 ? (int)((double)qayibSayi / cemi * 100) : 0)%;background:#ef4444"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@qayibSayi</div>
                </div>
                <div class="fn-dvm-progress-row">
                    <div class="fn-dvm-progress-lbl">İcazəli</div>
                    <div class="fn-dvm-progress-track">
                        <div class="fn-dvm-progress-fill" style="width:@(cemi > 0 ? (int)((double)icazeliSayi / cemi * 100) : 0)%;background:#2d6cdf"></div>
                    </div>
                    <div class="fn-dvm-progress-val">@icazeliSayi</div>
                </div>
            </div>
        </div>
    }

    @* ── Filtr çubuğu ── *@
    <div class="fn-dvm-filters">
        <span class="fn-dvm-filter-lbl">Filtr:</span>
        <input type="date" id="dvmDateStart" class="fn-dvm-input" />
        <span style="color:#7a8599;font-size:0.8125rem">—</span>
        <input type="date" id="dvmDateEnd" class="fn-dvm-input" />
        <select id="dvmStatusFilter" class="fn-dvm-select">
            <option value="">Bütün statuslar</option>
            <option value="1">İşdə</option>
            <option value="2">Gecikmə</option>
            <option value="3">Qayıb</option>
            <option value="4">İcazəli</option>
        </select>
        <button id="dvmFilterBtn" class="fn-dvm-btn fn-dvm-btn--primary">Axtar</button>
        <button id="dvmResetBtn" class="fn-dvm-btn fn-dvm-btn--outline">Sıfırla</button>
    </div>

    @* ── Cədvəl ── *@
    <div class="fn-dvm-card">
        <div class="fn-dvm-card-head">
            <div class="fn-dvm-card-title">Davamiyyət qeydləri</div>
            <div class="fn-dvm-card-count" id="dvmRecordCount">@cemi qeyd</div>
        </div>
        <table class="fn-dvm-table">
            <thead>
                <tr>
                    <th>Tarix</th>
                    <th>Giriş</th>
                    <th>Çıxış</th>
                    <th>İş saatı</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody id="dvmTableBody">
                @if (list.Any())
                {
                    @foreach (var item in list.OrderByDescending(x => x.Tarix))
                    {
                        var isLate = item.GirisVaxti.HasValue &&
                            (item.GirisVaxti.Value.Hour > 9 || (item.GirisVaxti.Value.Hour == 9 && item.GirisVaxti.Value.Minute > 5));

                        <tr>
                            <td>
                                <div class="fn-dvm-date">@item.Tarix.ToString("dd.MM.yyyy")</div>
                                <div class="fn-dvm-day">@item.Tarix.ToString("dddd", new System.Globalization.CultureInfo("az-AZ"))</div>
                            </td>
                            <td>
                                @if (item.GirisVaxti.HasValue)
                                {
                                    <span class="fn-dvm-time @(isLate ? "fn-dvm-time--late" : "")">
                                        @item.GirisVaxti.Value.ToString("HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span class="fn-dvm-nodata">--:--</span>
                                }
                            </td>
                            <td>
                                @if (item.CixisVaxti.HasValue)
                                {
                                    <span class="fn-dvm-time">@item.CixisVaxti.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span class="fn-dvm-nodata">--:--</span>
                                }
                            </td>
                            <td>
                                @if (item.GirisVaxti.HasValue && item.CixisVaxti.HasValue)
                                {
                                    var dur = item.CixisVaxti.Value - item.GirisVaxti.Value;
                                    var durClass = dur.TotalHours < 8 ? "fn-dvm-duration--short" : "fn-dvm-duration--ok";
                                    <span class="fn-dvm-duration @durClass">@dur.Hours saat @dur.Minutes dəq</span>
                                }
                                else
                                {
                                    <span class="fn-dvm-nodata">---</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case DavamiyyetStatus.Isde:
                                        <span class="fn-dvm-badge fn-dvm-badge--isde"><span class="fn-dvm-badge-dot"></span>İşdə</span>
                                        break;
                                    case DavamiyyetStatus.Gecikme:
                                        <span class="fn-dvm-badge fn-dvm-badge--gecikme"><span class="fn-dvm-badge-dot"></span>Gecikmə</span>
                                        break;
                                    case DavamiyyetStatus.Qayib:
                                        <span class="fn-dvm-badge fn-dvm-badge--qayib"><span class="fn-dvm-badge-dot"></span>Qayıb</span>
                                        break;
                                    case DavamiyyetStatus.Icazeli:
                                        <span class="fn-dvm-badge fn-dvm-badge--icazeli"><span class="fn-dvm-badge-dot"></span>İcazəli</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5">
                            <div class="fn-dvm-empty">
                                <div class="fn-dvm-empty-icon">
                                    <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                                        <rect x="7" y="8" width="30" height="28" rx="4" stroke="#dde1ea" stroke-width="2"/>
                                        <path d="M7 15h30M15 8v6M29 8v6M15 22h14M15 28h10" stroke="#dde1ea" stroke-width="1.8" stroke-linecap="round"/>
                                    </svg>
                                </div>
                                <div class="fn-dvm-empty-title">Davamiyyət qeydi tapılmadı</div>
                                <div class="fn-dvm-empty-sub">Hələ ki heç bir giriş-çıxış qeydiniz yoxdur</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@* Initial data for JS *@
<script type="application/json" id="dvmInitialData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(list.Select(x => new {
    tarix = x.Tarix,
    girisVaxti = x.GirisVaxti,
    cixisVaxti = x.CixisVaxti,
    status = (int)x.Status
})))</script>

@section Styles {
    <link rel="stylesheet" href="~/css/User/davamiyyet.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/User/davamiyyet.js" asp-append-version="true"></script>
}
