@model List<FinNex.Domain.Entities.Communication.Elan>
@{
    ViewData["Title"] = "Elanlar";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Elanlar</div>
            <div class="fn-page-sub">Şirkət daxili elan və bildirişlər</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-icon">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect x="6" y="4" width="28" height="32" rx="4" stroke="#dde1ea" stroke-width="2" />
                    <path d="M12 14h16M12 20h12M12 26h8" stroke="#dde1ea" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-empty-title">Hazırda elan yoxdur</div>
            <div class="fn-empty-sub">Yeni elanlar burada göstəriləcək</div>
        </div>
    }
    else
    {
        <div class="elan-feed" id="elanGrid">
            @foreach (var elan in Model)
            {
                <article class="elan-card @(elan.Vacibdir ? "elan-card--vacib" : "")">

                    @* ── Banner / Şəkil ── *@
                    @if (!string.IsNullOrEmpty(elan.SekilYolu))
                    {
                        <div class="elan-card-banner">
                            <img src="@elan.SekilYolu" alt="@elan.Bashliq" />
                        </div>
                    }

                    @* ── Header ── *@
                    <div class="elan-card-header">
                        <div class="elan-card-header-left">
                            @if (elan.Vacibdir)
                            {
                                <span class="elan-vacib-badge">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L1 21h22L12 2zm0 4l7.53 13H4.47L12 6zm-1 5v4h2v-4h-2zm0 6v2h2v-2h-2z"/></svg>
                                    Vacib
                                </span>
                            }
                            @if (elan.BitirmeTarixi.HasValue)
                            {
                                <span class="elan-date-badge">
                                    Son: @elan.BitirmeTarixi.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                        <div class="elan-card-time-small">
                            @elan.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    @* ── Başlıq ── *@
                    <h2 class="elan-card-title">@elan.Bashliq</h2>

                    @* ── Mətn ── *@
                    <div class="elan-card-body">
                        @foreach (var line in elan.Metn.Split('\n'))
                        {
                            <p>@line</p>
                        }
                    </div>

                    @* ── Sənəd əlavəsi ── *@
                    @if (!string.IsNullOrEmpty(elan.FaylAdi))
                    {
                        var icon = "📄";
                        if (elan.FaylTipi == "pdf") { icon = "📕"; }
                        else if (elan.FaylTipi == "doc" || elan.FaylTipi == "docx") { icon = "📘"; }
                        else if (elan.FaylTipi == "xls" || elan.FaylTipi == "xlsx") { icon = "📗"; }

                        <a href="@elan.FaylYolu" target="_blank" class="elan-file-attach">
                            <span class="elan-file-icon">@icon</span>
                            <span class="elan-file-name">@elan.FaylAdi</span>
                            @if (elan.FaylOlcusu.HasValue)
                            {
                                var kb = elan.FaylOlcusu.Value / 1024.0;
                                var sizeStr = kb < 1024 ? $"{kb:F1} KB" : $"{kb / 1024:F1} MB";
                                <span class="elan-file-size">@sizeStr</span>
                            }
                            <span class="elan-file-download">Yüklə ↓</span>
                        </a>
                    }

                    @* ── Footer ── *@
                    <div class="elan-card-footer">
                        <div class="elan-card-author">
                            <div class="elan-author-avatar">
                                @{
                                    var initials = elan.GonderenIsci != null
                                        ? $"{elan.GonderenIsci.Ad?.FirstOrDefault()}{elan.GonderenIsci.Soyad?.FirstOrDefault()}"
                                        : "--";
                                }
                                @initials.ToUpper()
                            </div>
                            <div>
                                <div class="elan-author-name">
                                    @(elan.GonderenIsci != null ? $"{elan.GonderenIsci.Ad} {elan.GonderenIsci.Soyad}" : "-")
                                </div>
                                <div class="elan-author-role">Elan müəllifi</div>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/elan.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/User/elan.js" asp-append-version="true"></script>
}
