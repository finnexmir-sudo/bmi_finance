@model List<FinNex.Domain.Entities.Kredit.KreditMuraciet>
@using FinNex.Domain.Entities.Kredit
@{
    ViewData["Title"] = "Kredit Müraciətləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var secilmis = ViewBag.SecilmisStatus as int?;
    var saylar = ViewBag.StatusSaylari as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Kredit Müraciətləri</div>
            <div class="fn-page-sub">Online kredit sifarişləri</div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-action="Create" class="fn-btn fn-btn--outline">+ Yeni müraciət</a>
            <form asp-action="Yenile" method="post" style="display:inline">
                <button type="submit" class="fn-btn fn-btn--outline" id="btnYenile">
                    ↻ Mail-dən yenilə
                </button>
            </form>
            <a asp-action="Qerarlar" class="fn-btn fn-btn--outline">Komitə qərarları</a>
            <a asp-action="Komite" class="fn-btn fn-btn--primary">Kredit Komitəsi</a>
        </div>
    </div>

    <div class="km-search-bar">
        <input type="text" id="kmSearch" class="fn-input" placeholder="Ad, FİN və ya telefon ilə axtar..." />
    </div>

    <div class="km-filters">
        <a href="@Url.Action("Index")" class="km-filter-btn @(secilmis == null ? "km-filter-btn--active" : "")">Hamısı (@Model.Count)</a>
        <a href="@Url.Action("Index", new { status = 0 })" class="km-filter-btn @(secilmis == 0 ? "km-filter-btn--active" : "")">Yeni (@saylar.GetValueOrDefault(0))</a>
        <a href="@Url.Action("Index", new { status = 1 })" class="km-filter-btn @(secilmis == 1 ? "km-filter-btn--active" : "")">Yoxlanılır</a>
        <a href="@Url.Action("Index", new { status = 2 })" class="km-filter-btn @(secilmis == 2 ? "km-filter-btn--active" : "")">Komitə (@saylar.GetValueOrDefault(2))</a>
        <a href="@Url.Action("Index", new { status = 3 })" class="km-filter-btn @(secilmis == 3 ? "km-filter-btn--active" : "")">Təsdiqlənib</a>
        <a href="@Url.Action("Index", new { status = 4 })" class="km-filter-btn @(secilmis == 4 ? "km-filter-btn--active" : "")">Rədd</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fn-alert fn-alert--success" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Müraciət tapılmadı</div>
            <div class="fn-empty-sub">Yeni müraciətlər avtomatik mail-dən yüklənəcək</div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow:hidden">
            <div class="km-table-wrap">
                <table class="km-table">
                    <thead>
                        <tr>
                            <th style="width:45px">#</th>
                            <th style="width:24%">Ad Soyad</th>
                            <th style="width:10%">Məbləğ</th>
                            <th style="width:8%">Müddət</th>
                            <th style="width:11%">Telefon</th>
                            <th style="width:12%">Tarix</th>
                            <th style="width:9%">Status</th>
                            <th style="width:60px;text-align:center" title="SMS">📨</th>
                            <th style="width:80px;text-align:center" title="Randevu">📅</th>
                            <th style="width:50px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            var ad = m.AdSoyadAtaAdi.Length > 35 ? m.AdSoyadAtaAdi.Substring(0, 35) + "..." : m.AdSoyadAtaAdi;
                            var tel = (m.Telefon ?? "").Length > 15 ? m.Telefon!.Substring(0, 15) : (m.Telefon ?? "—");
                            var mud = (m.KreditMuddeti ?? "").Length > 12 ? m.KreditMuddeti!.Substring(0, 12) : (m.KreditMuddeti ?? "—");
                            var statusAd = "";
                            var statusCls = "";
                            switch (m.Status)
                            {
                                case KreditMuracietStatus.Yeni: statusAd = "Yeni"; statusCls = "km-status--yeni"; break;
                                case KreditMuracietStatus.Yoxlanilir: statusAd = "Yoxlanılır"; statusCls = "km-status--baxilir"; break;
                                case KreditMuracietStatus.KomiteyeGonderildi: statusAd = "Komitə"; statusCls = "km-status--komite"; break;
                                case KreditMuracietStatus.Tesdiqlenib: statusAd = "Təsdiq"; statusCls = "km-status--tesdiq"; break;
                                case KreditMuracietStatus.ReddEdilib: statusAd = "Rədd"; statusCls = "km-status--redd"; break;
                            }
                            var menbeBadge = m.Menbe == KreditMuracietMenbe.Filial
                                ? "<span class=\"km-menbe km-menbe--filial\">Filial</span>"
                                : "<span class=\"km-menbe km-menbe--online\">Online</span>";

                            var smsSay = m.SmsLoglar?.Count(s => !s.Silinib) ?? 0;
                            var randevu = m.Randevu != null && !m.Randevu.Silinib ? m.Randevu : null;
                            var randevuRengi = randevu switch {
                                null => "#cbd5e1",
                                { Status: KreditRandevuStatus.Gelib } => "#16a34a",
                                { Status: KreditRandevuStatus.Gelmeyib } => "#dc2626",
                                { Status: KreditRandevuStatus.Legv } => "#94a3b8",
                                { Status: KreditRandevuStatus.Tehxir } => "#f59e0b",
                                _ => "#2563eb"
                            };

                            <tr class="km-row">
                                <td class="km-td-id" onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@m.Id</td>
                                <td class="km-td-name" onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@ad @Html.Raw(menbeBadge)</td>
                                <td class="km-td-amount" onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@m.KreditMeblegi.ToString("N0") <small>@m.Valyuta</small></td>
                                <td onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@mud</td>
                                <td onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@tel</td>
                                <td class="km-td-date" onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">@m.MuracietTarixi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td onclick="location.href='@Url.Action("Detail", new { id = m.Id })'"><span class="km-status @statusCls">@statusAd</span></td>
                                <td style="text-align:center" onclick="event.stopPropagation()">
                                    <a asp-action="Sms" asp-route-id="@m.Id"
                                       title="@(smsSay > 0 ? $"{smsSay} SMS göndərilib" : "SMS göndərilməyib")"
                                       style="display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:12px;text-decoration:none;
                                              background:@(smsSay > 0 ? "#dbeafe" : "#f1f5f9");
                                              color:@(smsSay > 0 ? "#1e40af" : "#94a3b8");
                                              font-size:12px;font-weight:600">
                                        📨 @(smsSay > 0 ? smsSay.ToString() : "0")
                                    </a>
                                </td>
                                <td style="text-align:center" onclick="event.stopPropagation()">
                                    <a asp-action="Randevu" asp-route-id="@m.Id"
                                       title="@(randevu != null ? $"{randevu.Tarix:dd.MM HH:mm}" : "Randevu yoxdur")"
                                       style="display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:12px;text-decoration:none;
                                              background:@(randevu != null ? "#eff6ff" : "#f1f5f9");
                                              color:@randevuRengi;
                                              font-size:12px;font-weight:600">
                                        📅 @(randevu != null ? randevu.Tarix.ToString("dd.MM") : "—")
                                    </a>
                                </td>
                                <td><a asp-action="Detail" asp-route-id="@m.Id" class="km-detail-btn">Bax</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}

@section Scripts {
<script>
document.getElementById('kmSearch').addEventListener('input', function () {
    var t = this.value.toLowerCase();
    document.querySelectorAll('.km-row').forEach(function (r) {
        r.style.display = r.textContent.toLowerCase().indexOf(t) >= 0 ? '' : 'none';
    });
});
</script>
}
