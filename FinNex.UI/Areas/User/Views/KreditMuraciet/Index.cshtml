@model List<FinNex.Domain.Entities.Kredit.KreditMuraciet>
@using FinNex.Domain.Entities.Kredit
@{
    ViewData["Title"] = "Kredit Müraciətləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var secilmis = ViewBag.SecilmisStatus as int?;
    var saylar = ViewBag.StatusSaylari as Dictionary<int, int> ?? new Dictionary<int, int>();

    string StatusText(KreditMuracietStatus s) => s switch {
        KreditMuracietStatus.Yeni => "Yeni",
        KreditMuracietStatus.Yoxlanilir => "Yoxlanılır",
        KreditMuracietStatus.KomiteyeGonderildi => "Komitə",
        KreditMuracietStatus.Tesdiqlenib => "Təsdiqlənib",
        KreditMuracietStatus.ReddEdilib => "Rədd",
        _ => "-"
    };
    string StatusCls(KreditMuracietStatus s) => s switch {
        KreditMuracietStatus.Yeni => "km-status--yeni",
        KreditMuracietStatus.Yoxlanilir => "km-status--baxilir",
        KreditMuracietStatus.KomiteyeGonderildi => "km-status--komite",
        KreditMuracietStatus.Tesdiqlenib => "km-status--tesdiq",
        KreditMuracietStatus.ReddEdilib => "km-status--redd",
        _ => ""
    };
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Kredit Müraciətləri</div>
            <div class="fn-page-sub">Online kredit sifarişləri</div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-action="Qerarlar" class="fn-btn fn-btn--outline">Komitə qərarları</a>
            <a asp-action="Komite" class="fn-btn fn-btn--primary">
                Kredit Komitəsi
                @if(saylar.GetValueOrDefault(2) > 0) { <span style="background:rgba(255,255,255,0.25);padding:1px 7px;border-radius:10px;font-size:10px;margin-left:4px">@saylar[2]</span> }
            </a>
        </div>
    </div>

    @* ── Axtarış ── *@
    <div class="km-search-bar">
        <input type="text" id="kmSearch" class="fn-input" placeholder="Ad, FİN və ya telefon ilə axtar..." />
    </div>

    <div class="km-filters">
        <a href="@Url.Action("Index")" class="km-filter-btn @(secilmis == null ? "km-filter-btn--active" : "")">
            Hamısı <span class="km-filter-count">@Model.Count</span>
        </a>
        @{ var filterItems = new[] { (0,"Yeni"), (1,"Yoxlanılır"), (2,"Komitə"), (3,"Təsdiqlənib"), (4,"Rədd") }; }
        @foreach (var (val, txt) in filterItems)
        {
            var say = saylar.GetValueOrDefault(val);
            <a href="@Url.Action("Index", new { status = val })" class="km-filter-btn @(secilmis == val ? "km-filter-btn--active" : "")">
                @txt @if(say > 0 && val == 0) { <span class="km-filter-count km-filter-count--yeni">@say</span> }
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Müraciət tapılmadı</div>
            <div class="fn-empty-sub">Yeni müraciətlər avtomatik mail-dən yüklənəcək</div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow:hidden">
            <table class="km-table">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Ad Soyad</th>
                        <th>Məbləğ</th>
                        <th>Müddət</th>
                        <th>Telefon</th>
                        <th>Tarix</th>
                        <th>Status</th>
                        <th style="width:60px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr class="km-row" onclick="location.href='@Url.Action("Detail", new { id = m.Id })'">
                            <td class="km-td-id">@m.Id</td>
                            <td class="km-td-name">@m.AdSoyadAtaAdi</td>
                            <td class="km-td-amount">@m.KreditMeblegi.ToString("N0") <small>@m.Valyuta</small></td>
                            <td>@m.KreditMuddeti</td>
                            <td>@m.Telefon</td>
                            <td class="km-td-date">@m.MuracietTarixi.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><span class="km-status @StatusCls(m.Status)">@StatusText(m.Status)</span></td>
                            <td><a asp-action="Detail" asp-route-id="@m.Id" class="km-detail-btn">Bax →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}

@section Scripts {
<script>
    document.getElementById('kmSearch').addEventListener('input', function () {
        var term = this.value.toLowerCase();
        document.querySelectorAll('.km-row').forEach(function (row) {
            var text = row.textContent.toLowerCase();
            row.style.display = text.includes(term) ? '' : 'none';
        });
    });
</script>
}
