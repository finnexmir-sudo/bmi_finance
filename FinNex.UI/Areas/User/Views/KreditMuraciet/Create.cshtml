@{
    ViewData["Title"] = "Yeni Müraciət";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni Müraciət</div>
            <div class="fn-page-sub">Filiala müraciət etmiş müştəri üçün əl ilə daxiletmə</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-form-wrap" style="max-width:820px">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">

                <div class="km-detail-section-title">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                    </svg>
                    Müştəri məlumatları
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Ad, Soyad, Ata adı</label>
                        <input type="text" name="adSoyadAtaAdi" class="fn-input" placeholder="Məs: Əliyev Əli Məmməd oğlu" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">FİN</label>
                        <input type="text" name="fin" class="fn-input" placeholder="7 simvol" maxlength="7" />
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Telefon</label>
                        <input type="text" name="telefon" class="fn-input" placeholder="050 xxx xx xx" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">İş yeri</label>
                        <input type="text" name="isYeri" class="fn-input" placeholder="İş yeri..." />
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Əmək haqqı (AZN)</label>
                        <input type="number" name="emekHaqqi" class="fn-input" placeholder="0" step="0.01" />
                    </div>
                    <div class="fn-form-group"></div>
                </div>

                <div class="km-detail-section-title" style="margin-top:16px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                    </svg>
                    Kredit məlumatları
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Kredit məbləği</label>
                        <input type="number" name="kreditMeblegi" class="fn-input" placeholder="0" step="0.01" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Valyuta</label>
                        <select name="valyuta" class="fn-input">
                            <option value="AZN" selected>AZN</option>
                            <option value="USD">USD</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">Müddət</label>
                        <input type="text" name="kreditMuddeti" class="fn-input" placeholder="Məs: 24 ay" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Məqsəd</label>
                        <input type="text" name="meqsed" class="fn-input" placeholder="Məs: Təmir, biznes, avtomobil..." />
                    </div>
                </div>

                <div class="fn-form-actions">
                    <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">Yarat</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}
