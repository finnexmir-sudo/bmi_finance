@model FinNex.Domain.Entities.Kredit.KreditMuraciet
@using FinNex.Domain.Entities.Kredit
@{
    ViewData["Title"] = "Müraciət #" + Model.Id;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var statusCls = Model.Status switch {
        KreditMuracietStatus.Yeni => "km-status--yeni",
        KreditMuracietStatus.Baxilir => "km-status--baxilir",
        KreditMuracietStatus.Tesdiqlenib => "km-status--tesdiq",
        KreditMuracietStatus.ReddEdilib => "km-status--redd",
        _ => ""
    };
    var statusTxt = Model.Status switch {
        KreditMuracietStatus.Yeni => "Yeni",
        KreditMuracietStatus.Baxilir => "Baxılır",
        KreditMuracietStatus.Tesdiqlenib => "Təsdiqlənib",
        KreditMuracietStatus.ReddEdilib => "Rədd edilib",
        _ => "-"
    };
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müraciət #@Model.Id</div>
            <div class="fn-page-sub">@Model.MuracietTarixi.ToString("dd MMMM yyyy, HH:mm")</div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bu müraciəti silmək istəyirsiniz?')">
                <button type="submit" class="fn-btn fn-btn--outline" style="color:#dc2626;border-color:#dc2626">Sil</button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fn-alert fn-alert--success">@TempData["Success"]</div>
    }

    @* ── Status badge ── *@
    <div style="margin-bottom:16px">
        <span class="km-status @statusCls" style="font-size:14px;padding:6px 16px">@statusTxt</span>
    </div>

    <div class="km-detail-grid">

        @* ── Müştəri ── *@
        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                Müştəri məlumatları
            </div>

            <div class="km-detail-row">
                <span class="km-detail-label">Ad, Soyad, Ata adı</span>
                <span class="km-detail-value km-val-bold">@Model.AdSoyadAtaAdi</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">FİN</span>
                <span class="km-detail-value">@(Model.FIN ?? "—")</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">Telefon</span>
                <span class="km-detail-value">@(Model.Telefon ?? "—")</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">İş yeri</span>
                <span class="km-detail-value">@(Model.IsYeri ?? "—")</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">Əmək haqqı</span>
                <span class="km-detail-value">@(Model.EmekHaqqi?.ToString("N0") ?? "—") AZN</span>
            </div>
        </div>

        @* ── Kredit ── *@
        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                    <line x1="1" y1="10" x2="23" y2="10"/>
                </svg>
                Kredit məlumatları
            </div>

            <div class="km-detail-row">
                <span class="km-detail-label">Kredit məbləği</span>
                <span class="km-detail-value km-val-amount">@Model.KreditMeblegi.ToString("N0") @Model.Valyuta</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">Müddət</span>
                <span class="km-detail-value">@(Model.KreditMuddeti ?? "—")</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">Məqsəd</span>
                <span class="km-detail-value">@(Model.Meqsed ?? "—")</span>
            </div>
            <div class="km-detail-row">
                <span class="km-detail-label">IP ünvan</span>
                <span class="km-detail-value km-val-muted">@(Model.IP ?? "—")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Qeyd))
            {
                <div class="km-detail-divider"></div>
                <div class="km-detail-row">
                    <span class="km-detail-label">Qeyd</span>
                    <span class="km-detail-value">@Model.Qeyd</span>
                </div>
            }
        </div>
    </div>

    @* ── Status dəyişmə ── *@
    <div class="fn-card km-action-card">
        <div class="km-detail-section-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 11 12 14 22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
            Status dəyiş
        </div>
        <form asp-action="ChangeStatus" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="km-action-row">
                <select name="yeniStatus" class="fn-input km-action-select">
                    @{
                        var statuses = new[] {
                            (0, "Yeni"),
                            (1, "Baxılır"),
                            (2, "Təsdiqlənib"),
                            (3, "Rədd edilib")
                        };
                    }
                    @foreach (var (val, txt) in statuses)
                    {
                        if ((int)Model.Status == val)
                        {
                            <option value="@val" selected="selected">@txt</option>
                        }
                        else
                        {
                            <option value="@val">@txt</option>
                        }
                    }
                </select>
                <input type="text" name="qeyd" class="fn-input km-action-input" placeholder="Qeyd yazın..."
                       value="@Model.Qeyd" />
                <button type="submit" class="fn-btn fn-btn--primary">Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}
