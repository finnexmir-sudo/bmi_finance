@model IList<FinNex.Domain.Entities.Kredit.KreditQerar>
@using FinNex.Domain.Entities.Kredit
@{
    ViewData["Title"] = "Komitə Qərarları";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var tesdiq = Model.Count(x => x.Qerar == KreditQerarTipi.Tesdiqlenib);
    var redd = Model.Count(x => x.Qerar == KreditQerarTipi.ReddEdilib);
    var secilmisTip = ViewBag.SecilmisTip as int?;
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Komitə Qərarları</div>
            <div class="fn-page-sub">
                @Model.Count qərar —
                <span style="color:#16a34a">@tesdiq təsdiqlənib</span>,
                <span style="color:#dc2626">@redd rədd edilib</span>
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Bütün müraciətlər</a>
    </div>

    @* Filtr *@
    <div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap">
        <a asp-action="Qerarlar" class="fn-btn @(secilmisTip == null ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">Hamısı (@Model.Count)</a>
        <a asp-action="Qerarlar" asp-route-tip="@((int)KreditQerarTipi.Tesdiqlenib)" class="fn-btn @(secilmisTip == (int)KreditQerarTipi.Tesdiqlenib ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">Təsdiqlənib (@tesdiq)</a>
        <a asp-action="Qerarlar" asp-route-tip="@((int)KreditQerarTipi.ReddEdilib)" class="fn-btn @(secilmisTip == (int)KreditQerarTipi.ReddEdilib ? "fn-btn--primary" : "fn-btn--outline") fn-btn--sm">Rədd (@redd)</a>
    </div>

    <div class="km-search-bar">
        <input type="text" id="kmSearch" class="fn-input" placeholder="Ad, FİN və ya protokol ilə axtar..." />
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Hələ qərar yoxdur</div>
            <div class="fn-empty-sub">Komitə qərar verdikdə burada görünəcək</div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow:hidden">
            <table class="km-table">
                <thead>
                    <tr>
                        <th style="width:60px">Müraciət</th>
                        <th>Müştəri</th>
                        <th>FİN</th>
                        <th>Protokol №</th>
                        <th>Qərar tarixi</th>
                        <th>Məbləğ</th>
                        <th>Təsdiq məbləğ</th>
                        <th>Faiz</th>
                        <th>Qərar</th>
                        <th>Protokol</th>
                        <th style="width:60px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        var m = q.KreditMuraciet;
                        var cls = q.Qerar == KreditQerarTipi.Tesdiqlenib ? "km-status--tesdiq" : "km-status--redd";
                        var txt = q.Qerar == KreditQerarTipi.Tesdiqlenib ? "Təsdiqlənib" : "Rədd edilib";
                        <tr class="km-row">
                            <td class="km-td-id">#@q.KreditMuracietId</td>
                            <td class="km-td-name">@(m?.AdSoyadAtaAdi ?? "—")</td>
                            <td>@(m?.FIN ?? "—")</td>
                            <td style="font-weight:600">@q.ProtokolNo</td>
                            <td class="km-td-date">@q.QerarTarixi.ToString("dd.MM.yyyy")</td>
                            <td class="km-td-amount">@(m?.KreditMeblegi.ToString("N0")) <small>@(m?.Valyuta)</small></td>
                            <td class="km-td-amount">@(q.TesdiqMebleg?.ToString("N0") ?? "—")</td>
                            <td>@(q.FaizDerecesi?.ToString("N1") ?? "—")%</td>
                            <td><span class="km-status @cls">@txt</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(q.ProtokolFaylYolu))
                                {
                                    <a href="@q.ProtokolFaylYolu" target="_blank" style="color:#2563eb;font-size:12px;text-decoration:none">📄 Yüklə</a>
                                }
                                else
                                {
                                    <span style="color:#94a3b8;font-size:12px">—</span>
                                }
                            </td>
                            <td>
                                <a asp-action="KomiteDetail" asp-route-id="@q.KreditMuracietId" class="km-detail-btn">Bax</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}

@section Scripts {
<script>
document.getElementById('kmSearch').addEventListener('input', function () {
    var t = this.value.toLowerCase();
    document.querySelectorAll('.km-row').forEach(function (r) {
        r.style.display = r.textContent.toLowerCase().indexOf(t) >= 0 ? '' : 'none';
    });
});
</script>
}
