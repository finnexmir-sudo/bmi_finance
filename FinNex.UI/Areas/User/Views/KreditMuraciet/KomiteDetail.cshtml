@model FinNex.Domain.Entities.Kredit.KreditMuraciet
@using FinNex.Domain.Entities.Kredit
@{
    ViewData["Title"] = "Komitə — Müraciət #" + Model.Id;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var tarixce = ViewBag.Tarixce as IList<KreditMuraciet> ?? new List<KreditMuraciet>();
    var zaminler = ViewBag.Zaminler as IList<KreditZamin> ?? new List<KreditZamin>();
    var qerar = ViewBag.Qerar as KreditQerar;
    var komiteUzvleri = ViewBag.KomiteUzvleri as IList<KomiteUzvu> ?? new List<KomiteUzvu>();

    string StatusText(KreditMuracietStatus s) => s switch {
        KreditMuracietStatus.Yeni => "Yeni",
        KreditMuracietStatus.Yoxlanilir => "Yoxlanılır",
        KreditMuracietStatus.KomiteyeGonderildi => "Komitəyə göndərildi",
        KreditMuracietStatus.Tesdiqlenib => "Təsdiqlənib",
        KreditMuracietStatus.ReddEdilib => "Rədd edilib",
        _ => "-"
    };
    string StatusCls(KreditMuracietStatus s) => s switch {
        KreditMuracietStatus.Yeni => "km-status--yeni",
        KreditMuracietStatus.Yoxlanilir => "km-status--baxilir",
        KreditMuracietStatus.KomiteyeGonderildi => "km-status--komite",
        KreditMuracietStatus.Tesdiqlenib => "km-status--tesdiq",
        KreditMuracietStatus.ReddEdilib => "km-status--redd",
        _ => ""
    };
    string RolAd(KomiteUzvuRolu r) => r switch {
        KomiteUzvuRolu.Sedr => "Sədr",
        KomiteUzvuRolu.SedrMuavini => "Sədr müavini",
        KomiteUzvuRolu.Katib => "Katib",
        _ => "Üzv"
    };
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">
                Komitə — Müraciət #@Model.Id
                @if (Model.Menbe == KreditMuracietMenbe.Filial)
                {
                    <span class="km-menbe km-menbe--filial">Filial</span>
                }
                else
                {
                    <span class="km-menbe km-menbe--online">Online</span>
                }
            </div>
            <div class="fn-page-sub">@Model.AdSoyadAtaAdi · @Model.MuracietTarixi.ToString("dd.MM.yyyy")</div>
        </div>
        <a asp-action="Komite" class="fn-btn fn-btn--outline">← Komitə siyahısı</a>
    </div>

    @if (TempData["Success"] != null) { <div class="fn-alert fn-alert--success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div> }

    @* ══════ İşçinin rəyi ══════ *@
    <div class="fn-card km-isci-reyi">
        <div class="km-reyi-header">
            <span class="km-reyi-icon">📋</span>
            <div>
                <div class="km-reyi-title">Kredit mütəxəssisinin rəyi</div>
                <div class="km-reyi-meta">
                    @(Model.BaxanIsci != null ? $"{Model.BaxanIsci.Ad} {Model.BaxanIsci.Soyad}" : "—") ·
                    @Model.BaxilmaTarixi?.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
        </div>
        <div class="km-reyi-text">@(Model.IlkinBaxisQeyd ?? Model.Qeyd ?? "Qeyd yazılmayıb")</div>
    </div>

    @* ══════ MKR + AsanFinance (oxunan versiya) ══════ *@
    <div class="km-detail-grid">
        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/><path d="M9 12l2 2 4-4"/>
                </svg>
                MKR (Mərkəzi Kredit Reyestri)
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.MkrNeticesi))
            {
                <div style="white-space:pre-wrap;font-size:13px;color:#0f172a">@Model.MkrNeticesi</div>
                <div style="font-size:11px;color:#94a3b8;margin-top:6px">@Model.MkrBaxilmaTarixi?.ToString("dd.MM.yyyy HH:mm") · @(Model.MkrBaxanIsci != null ? $"{Model.MkrBaxanIsci.Ad} {Model.MkrBaxanIsci.Soyad}" : "")</div>
            }
            else
            {
                <div class="km-placeholder-text">MKR nəticəsi daxil edilməyib</div>
            }
        </div>

        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                AsanFinance
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.AsanFinanceNeticesi))
            {
                <div style="white-space:pre-wrap;font-size:13px;color:#0f172a">@Model.AsanFinanceNeticesi</div>
                <div style="font-size:11px;color:#94a3b8;margin-top:6px">@Model.AsanFinanceBaxilmaTarixi?.ToString("dd.MM.yyyy HH:mm") · @(Model.AsanFinanceBaxanIsci != null ? $"{Model.AsanFinanceBaxanIsci.Ad} {Model.AsanFinanceBaxanIsci.Soyad}" : "")</div>
            }
            else
            {
                <div class="km-placeholder-text">AsanFinance nəticəsi daxil edilməyib</div>
            }
        </div>
    </div>

    @* ══════ FİN Tarixçəsi ══════ *@
    @if (tarixce.Any())
    {
        <div class="fn-card km-tarixce-card">
            <div class="km-detail-section-title km-tarixce-title">Bu FİN ilə əvvəlki müraciətlər (@tarixce.Count)</div>
            <table class="km-tarixce-table">
                <thead><tr><th>Tarix</th><th>Məbləğ</th><th>Nəticə</th></tr></thead>
                <tbody>
                    @foreach (var t in tarixce)
                    {
                        <tr>
                            <td>@t.MuracietTarixi.ToString("dd.MM.yyyy")</td>
                            <td class="km-td-amount">@t.KreditMeblegi.ToString("N0") @t.Valyuta</td>
                            <td><span class="km-status @StatusCls(t.Status)">@StatusText(t.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ══════ Müştəri + Kredit ══════ *@
    <div class="km-detail-grid">
        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">Müştəri məlumatları</div>
            <div class="km-detail-row"><span class="km-detail-label">Ad, Soyad, Ata adı</span><span class="km-detail-value km-val-bold">@Model.AdSoyadAtaAdi</span></div>
            <div class="km-detail-row"><span class="km-detail-label">FİN</span><span class="km-detail-value">@(Model.FIN ?? "—")</span></div>
            <div class="km-detail-row"><span class="km-detail-label">Telefon</span><span class="km-detail-value">@(Model.Telefon ?? "—")</span></div>
            <div class="km-detail-row"><span class="km-detail-label">İş yeri</span><span class="km-detail-value">@(Model.IsYeri ?? "—")</span></div>
            <div class="km-detail-row"><span class="km-detail-label">Əmək haqqı</span><span class="km-detail-value">@(Model.EmekHaqqi?.ToString("N0") ?? "—") AZN</span></div>
        </div>

        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">Kredit məlumatları</div>
            <div class="km-detail-row"><span class="km-detail-label">Kredit məbləği</span><span class="km-detail-value km-val-amount">@Model.KreditMeblegi.ToString("N0") @Model.Valyuta</span></div>
            <div class="km-detail-row"><span class="km-detail-label">Müddət</span><span class="km-detail-value">@(Model.KreditMuddeti ?? "—")</span></div>
            <div class="km-detail-row"><span class="km-detail-label">Məqsəd</span><span class="km-detail-value">@(Model.Meqsed ?? "—")</span></div>
        </div>
    </div>

    @* ══════ Zaminlər ══════ *@
    @if (zaminler.Any())
    {
        <div class="fn-card km-detail-card">
            <div class="km-detail-section-title">Zaminlər (@zaminler.Count)</div>
            <table class="km-table">
                <thead><tr><th>Ad Soyad</th><th>FİN</th><th>Telefon</th><th>İş yeri</th><th>Əmək haqqı</th></tr></thead>
                <tbody>
                    @foreach (var z in zaminler)
                    {
                        <tr>
                            <td class="km-td-name">@z.AdSoyadAtaAdi</td>
                            <td>@(z.FIN ?? "—")</td>
                            <td>@(z.Telefon ?? "—")</td>
                            <td>@(z.IsYeri ?? "—")</td>
                            <td>@(z.EmekHaqqi?.ToString("N0") ?? "—") AZN</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ══════ Qərar — varsa oxunan versiya, yoxdursa yeni qərar formu ══════ *@
    @if (qerar != null)
    {
        var qCls = qerar.Qerar == KreditQerarTipi.Tesdiqlenib ? "km-status--tesdiq" : "km-status--redd";
        var qTxt = qerar.Qerar == KreditQerarTipi.Tesdiqlenib ? "Təsdiqlənib" : "Rədd edilib";
        <div class="fn-card km-qerar-card">
            <div class="km-detail-section-title">Komitə qərarı</div>
            <div class="km-detail-row"><span class="km-detail-label">Nəticə</span><span class="km-detail-value"><span class="km-status @qCls">@qTxt</span></span></div>
            <div class="km-detail-row"><span class="km-detail-label">Protokol №</span><span class="km-detail-value">@qerar.ProtokolNo</span></div>
            <div class="km-detail-row"><span class="km-detail-label">Qərar tarixi</span><span class="km-detail-value">@qerar.QerarTarixi.ToString("dd.MM.yyyy")</span></div>
            @if (!string.IsNullOrEmpty(qerar.ProtokolFaylYolu))
            {
                <div class="km-detail-row"><span class="km-detail-label">Protokol faylı</span><span class="km-detail-value"><a href="@qerar.ProtokolFaylYolu" target="_blank" style="color:#2563eb">📄 @(qerar.ProtokolFaylAdi ?? "Yüklə")</a></span></div>
            }
            @if (qerar.TesdiqMebleg.HasValue)
            {
                <div class="km-detail-row"><span class="km-detail-label">Təsdiq məbləği</span><span class="km-detail-value km-val-amount">@qerar.TesdiqMebleg.Value.ToString("N0") @Model.Valyuta</span></div>
            }
            @if (!string.IsNullOrEmpty(qerar.TesdiqMuddet))
            {
                <div class="km-detail-row"><span class="km-detail-label">Müddət</span><span class="km-detail-value">@qerar.TesdiqMuddet</span></div>
            }
            @if (qerar.FaizDerecesi.HasValue)
            {
                <div class="km-detail-row"><span class="km-detail-label">Faiz</span><span class="km-detail-value">@qerar.FaizDerecesi.Value.ToString("N1")%</span></div>
            }
            @if (!string.IsNullOrEmpty(qerar.Teminat))
            {
                <div class="km-detail-row"><span class="km-detail-label">Təminat</span><span class="km-detail-value">@qerar.Teminat</span></div>
            }
            @if (!string.IsNullOrEmpty(qerar.Qeyd))
            {
                <div class="km-detail-row"><span class="km-detail-label">Qeyd</span><span class="km-detail-value">@qerar.Qeyd</span></div>
            }

            @* İmzalayanlar *@
            @if (qerar.Imzalar != null && qerar.Imzalar.Any())
            {
                <div style="margin-top:12px">
                    <div style="font-size:12px;font-weight:600;color:#475569;margin-bottom:6px">İmzalayan üzvlər (@qerar.Imzalar.Count)</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px">
                        @foreach (var imza in qerar.Imzalar)
                        {
                            var rol = imza.KomiteUzvu != null ? RolAd(imza.KomiteUzvu.Rol) : "Üzv";
                            var ad = imza.KomiteUzvu?.Isci != null ? $"{imza.KomiteUzvu.Isci.Ad} {imza.KomiteUzvu.Isci.Soyad}" : "—";
                            <span style="display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:16px;font-size:12px">
                                <span style="color:#94a3b8">@rol:</span>
                                <strong>@ad</strong>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Status == KreditMuracietStatus.KomiteyeGonderildi)
    {
        @* Yeni qərar formu (offline yığıncaqdan sonra protokol upload) *@
        <div class="fn-card km-qerar-card">
            <div class="km-detail-section-title">Komitə qərarını qeydə al</div>
            <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:6px;padding:10px 14px;margin-bottom:12px;font-size:12px;color:#78350f">
                ℹ Komitə offline yığışır. Word protokolu fiziki olaraq imzalandıqdan sonra bu formada qərarı sistemə daxil edin və skanlanmış protokolu yükləyin.
            </div>
            <form asp-action="KomiteQerar" method="post" enctype="multipart/form-data" id="komiteQerarForm">
                <input type="hidden" name="muracietId" value="@Model.Id" />

                <div class="km-qerar-grid-4" style="grid-template-columns:repeat(2,1fr)">
                    <div class="fn-form-group">
                        <label class="fn-label">Qərar tipi *</label>
                        <select name="qerarTipi" class="fn-input" id="qerarTipi" required>
                            <option value="@((int)KreditQerarTipi.Tesdiqlenib)">✓ Təsdiqlənib</option>
                            <option value="@((int)KreditQerarTipi.ReddEdilib)">✕ Rədd edilib</option>
                        </select>
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Qərar tarixi *</label>
                        <input type="date" name="qerarTarixi" class="fn-input" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Protokol № *</label>
                        <input type="text" name="protokolNo" class="fn-input" placeholder="Məs: K-2026-042" required />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Protokol faylı (Word/PDF skan)</label>
                        <input type="file" name="protokolFayl" class="fn-input" accept=".doc,.docx,.pdf" />
                    </div>
                </div>

                <div id="tesdiqSahelerler" class="km-qerar-grid-4" style="grid-template-columns:repeat(4,1fr);margin-top:8px">
                    <div class="fn-form-group">
                        <label class="fn-label">Təsdiq məbləği</label>
                        <input type="number" name="tesdiqMebleg" class="fn-input" step="0.01" value="@Model.KreditMeblegi" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Müddət</label>
                        <input type="text" name="tesdiqMuddet" class="fn-input" value="@Model.KreditMuddeti" placeholder="Məs: 24 ay" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Faiz dərəcəsi (%)</label>
                        <input type="number" name="faizDerecesi" class="fn-input" step="0.01" placeholder="Məs: 12" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">Təminat</label>
                        <input type="text" name="teminat" class="fn-input" placeholder="Zamin / girov / depozit" />
                    </div>
                </div>

                <div class="fn-form-group" style="margin-top:8px">
                    <label class="fn-label">Qeyd</label>
                    <textarea name="qeyd" class="fn-input" rows="2" placeholder="Komitə qeydi / rədd səbəbi / xüsusi şərtlər..."></textarea>
                </div>

                @* ══════ İmzalayanlar ══════ *@
                <div style="margin-top:16px;padding:12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                        <div style="font-size:13px;font-weight:600;color:#0f172a">İmzalayan üzvlər * <span style="color:#64748b;font-weight:400">(ən azı bir üzv)</span></div>
                        <div style="display:flex;gap:6px">
                            <button type="button" class="fn-btn fn-btn--outline fn-btn--sm" onclick="document.querySelectorAll('.uzvCheck').forEach(c=>c.checked=true)">Hamısı</button>
                            <button type="button" class="fn-btn fn-btn--outline fn-btn--sm" onclick="document.querySelectorAll('.uzvCheck').forEach(c=>c.checked=false)">Təmizlə</button>
                        </div>
                    </div>
                    @if (!komiteUzvleri.Any())
                    {
                        <div style="color:#dc2626;font-size:12px">⚠ Aktiv komitə üzvü yoxdur. Admin panel → Komitə üzvləri-ndən təyin edin.</div>
                    }
                    else
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:8px">
                            @foreach (var u in komiteUzvleri)
                            {
                                <label style="display:flex;align-items:center;gap:8px;padding:8px 10px;background:#fff;border:1px solid #e2e8f0;border-radius:6px;cursor:pointer">
                                    <input type="checkbox" name="imzalayanlar" value="@u.Id" class="uzvCheck" checked />
                                    <div style="flex:1;min-width:0">
                                        <div style="font-size:13px;font-weight:600;color:#0f172a">@u.Isci.Ad @u.Isci.Soyad</div>
                                        <div style="font-size:11px;color:#64748b">@RolAd(u.Rol)</div>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="km-qerar-buttons" style="margin-top:16px">
                    <button type="submit" class="fn-btn fn-btn--primary">Qərarı qeydə al</button>
                </div>
            </form>
        </div>

        <script>
            (function () {
                var sel = document.getElementById('qerarTipi');
                var block = document.getElementById('tesdiqSahelerler');
                function syncVisible() {
                    block.style.display = sel.value == '@((int)KreditQerarTipi.Tesdiqlenib)' ? '' : 'none';
                }
                sel.addEventListener('change', syncVisible);
                syncVisible();
            })();
        </script>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}
