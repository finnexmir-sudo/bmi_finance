@model List<FinNex.Domain.Entities.Kredit.KreditMuraciet>
@{
    ViewData["Title"] = "Kredit Komitəsi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Kredit Komitəsi</div>
            <div class="fn-page-sub">Qərar gözləyən müraciətlər — @Model.Count ədəd</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Bütün müraciətlər</a>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-title">Komitədə müraciət yoxdur</div>
            <div class="fn-empty-sub">Kredit mütəxəssisi müraciəti komitəyə göndərəndə burada görünəcək</div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow:hidden">
            <table class="km-table">
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Ad Soyad</th>
                        <th>FİN</th>
                        <th>Məbləğ</th>
                        <th>Müddət</th>
                        <th>Əmək haqqı</th>
                        <th>Yoxlayan</th>
                        <th>Göndərilmə tarixi</th>
                        <th style="width:100px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr class="km-row">
                            <td class="km-td-id">@m.Id</td>
                            <td class="km-td-name">@m.AdSoyadAtaAdi</td>
                            <td>@(m.FIN ?? "—")</td>
                            <td class="km-td-amount">@m.KreditMeblegi.ToString("N0") <small>@m.Valyuta</small></td>
                            <td>@m.KreditMuddeti</td>
                            <td>@(m.EmekHaqqi?.ToString("N0") ?? "—") AZN</td>
                            <td>@(m.BaxanIsci != null ? $"{m.BaxanIsci.Ad} {m.BaxanIsci.Soyad}" : "—")</td>
                            <td class="km-td-date">@m.BaxilmaTarixi?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a asp-action="KomiteDetail" asp-route-id="@m.Id" class="fn-btn fn-btn--primary fn-btn--sm">Qərar ver</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/kredit-muraciet.css" asp-append-version="true" />
}
