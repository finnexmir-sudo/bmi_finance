@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model IList<OdenisNezaretiDto>
@{
    ViewData["Title"] = "Ödənişə Nəzarət";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var balansFiltri = ViewData["BalansFiltri"] as BalansNovu?;
    var axtaris = ViewData["Axtaris"] as string;
}

<style>
    .on-wrap { padding: 4px 0; }
    .on-bar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .on-inp { padding: 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 13px; outline: none; }
    .on-inp:focus { border-color: #6366f1; }
    .on-grow { flex: 1 1 260px; }
    .on-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; text-decoration: none; }
    .on-btn--p { background: #6366f1; color: #fff; }
    .on-btn--g { background: #fff; color: #334155; border: 1.5px solid #e2e8f0; }
    .on-card { background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .on-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .on-table thead th { background: #f8fafc; padding: 10px 12px; text-align: left; font-weight: 700; color: #475569; border-bottom: 2px solid #e2e8f0; white-space: nowrap; }
    .on-table td { padding: 9px 12px; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
    .on-table tbody tr:hover { background: #fafbff; }
    .on-bal { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 800; white-space: nowrap; }
    .on-bal--b { background: #dbeafe; color: #1d4ed8; }
    .on-bal--bk { background: #fef3c7; color: #b45309; }
    .on-muted { color: #cbd5e1; }
    .on-act { display: inline-flex; gap: 5px; }
    .on-iconbtn { border: 1.5px solid #e2e8f0; background: #fff; border-radius: 7px; padding: 4px 9px; cursor: pointer; font-size: 12px; color: #334155; }
    .on-iconbtn--del { color: #b91c1c; border-color: #fecaca; }
    .on-empty { text-align: center; padding: 40px; color: #94a3b8; }
    .on-foot { padding: 10px 14px; font-size: 12px; color: #64748b; border-top: 1px solid #f1f5f9; }
</style>

<div class="on-wrap">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2">@TempData["Error"]</div>
    }

    <form method="get" class="on-bar">
        <input type="text" name="axtaris" value="@axtaris" class="on-inp on-grow" placeholder="🔍 Müştəri adı və ya hesab № axtar…" />
        <select name="balans" class="on-inp">
            <option value="">Hamısı (balans + b-k)</option>
            <option value="Balans" selected="@(balansFiltri == BalansNovu.Balans)">Yalnız Balans</option>
            <option value="BalansdanKenar" selected="@(balansFiltri == BalansNovu.BalansdanKenar)">Yalnız Balansdan kənar</option>
        </select>
        <button type="submit" class="on-btn on-btn--g"><i class="bi bi-funnel"></i> Filtr</button>
        <button type="button" class="on-btn on-btn--p" style="margin-left:auto" onclick="onOpenAdd()">
            <i class="bi bi-plus-lg"></i> Yeni qeyd
        </button>
    </form>

    <div class="on-card">
        <div style="overflow-x:auto">
            <table class="on-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Balans / B-K</th>
                        <th>Müştəri</th>
                        <th>Hesab №</th>
                        <th>Təyinat</th>
                        <th>Gələn pulun son tarixi</th>
                        <th>Ödənişin vəziyyəti</th>
                        <th>Qeyd</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        var i = 1;
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td>@(i++)</td>
                                <td>
                                    <span class="on-bal @(x.BalansNovu == BalansNovu.BalansdanKenar ? "on-bal--bk" : "on-bal--b")">
                                        @x.BalansNovuAd
                                    </span>
                                </td>
                                <td style="font-weight:600">@x.MusteriAdi</td>
                                <td style="font-family:ui-monospace,monospace">@(string.IsNullOrWhiteSpace(x.HesabNomresi) ? "—" : x.HesabNomresi)</td>
                                <td>@(string.IsNullOrWhiteSpace(x.Teyinat) ? "—" : x.Teyinat)</td>
                                <td>@(x.SonOdenisTarixi?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td>@(string.IsNullOrWhiteSpace(x.OdenisVeziyyeti) ? "—" : x.OdenisVeziyyeti)</td>
                                <td style="max-width:220px;white-space:normal">@(string.IsNullOrWhiteSpace(x.Qeyd) ? "—" : x.Qeyd)</td>
                                <td>
                                    <div class="on-act">
                                        <button type="button" class="on-iconbtn"
                                                data-id="@x.Id"
                                                data-balans="@((int)x.BalansNovu)"
                                                data-ad="@x.MusteriAdi"
                                                data-hesab="@x.HesabNomresi"
                                                data-teyinat="@x.Teyinat"
                                                data-tarix="@(x.SonOdenisTarixi?.ToString("yyyy-MM-dd"))"
                                                data-veziyyet="@x.OdenisVeziyyeti"
                                                data-qeyd="@x.Qeyd"
                                                onclick="onOpenEdit(this)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="Sil" method="post" onsubmit="return confirm('Bu qeyd silinsin?');" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@x.Id" />
                                            <button type="submit" class="on-iconbtn on-iconbtn--del"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9"><div class="on-empty"><i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>Hələ qeyd yoxdur. "Yeni qeyd" ilə əlavə edin.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="on-foot">@Model.Count qeyd</div>
    </div>
</div>

<!-- Əlavə / Redaktə modal -->
<div class="modal fade" id="onModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="onForm" method="post" action="@Url.Action("Yarat")"
                  data-yarat="@Url.Action("Yarat")" data-yenile="@Url.Action("Yenile")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="onId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="onModalTitle">Yeni qeyd</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Balans / B-K</label>
                            <select name="BalansNovu" class="form-select">
                                <option value="0">Balans</option>
                                <option value="1">Balansdan kənar</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Müştəri adı və soyadı *</label>
                            <input type="text" name="MusteriAdi" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hesab №</label>
                            <input type="text" name="HesabNomresi" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Təyinat</label>
                            <input type="text" name="Teyinat" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Gələn pulun son tarixi</label>
                            <input type="date" name="SonOdenisTarixi" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ödənişin vəziyyəti</label>
                            <input type="text" name="OdenisVeziyyeti" class="form-control" placeholder="məs. Ödənilir / Dayanıb / Tam ödənildi" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Qeyd</label>
                            <textarea name="Qeyd" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Saxla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var onModalEl = document.getElementById('onModal');
    var onBsModal = new bootstrap.Modal(onModalEl);
    var onForm = document.getElementById('onForm');

    function onOpenAdd() {
        onForm.action = onForm.dataset.yarat;
        onForm.reset();
        document.getElementById('onId').value = '';
        document.getElementById('onModalTitle').textContent = 'Yeni qeyd';
        onBsModal.show();
    }

    function onOpenEdit(btn) {
        onForm.action = onForm.dataset.yenile;
        document.getElementById('onId').value = btn.dataset.id;
        onForm.BalansNovu.value = btn.dataset.balans || '0';
        onForm.MusteriAdi.value = btn.dataset.ad || '';
        onForm.HesabNomresi.value = btn.dataset.hesab || '';
        onForm.Teyinat.value = btn.dataset.teyinat || '';
        onForm.SonOdenisTarixi.value = btn.dataset.tarix || '';
        onForm.OdenisVeziyyeti.value = btn.dataset.veziyyet || '';
        onForm.Qeyd.value = btn.dataset.qeyd || '';
        document.getElementById('onModalTitle').textContent = 'Qeydi redaktə et';
        onBsModal.show();
    }
</script>
}
