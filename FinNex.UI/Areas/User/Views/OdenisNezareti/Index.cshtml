@using FinNex.Application.DTOs.Pid
@model OdenisNezaretSiyahiDto
@{
    ViewData["Title"] = "Ödənişə Nəzarət";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    Func<decimal?, string> Pul = v => v.HasValue ? v.Value.ToString("N2") + " ₼" : "—";
    Func<int?, string> GunCls = g => g == null ? "" : g <= 30 ? "on-gun--yeni" : g <= 90 ? "on-gun--orta" : "on-gun--kohne";

    // Item_01 (status) filtri üçün datadan yığılan fərqli dəyərlər
    var statuslar = Model.Setirler
        .Where(x => !string.IsNullOrWhiteSpace(x.Status))
        .Select(x => x.Status!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Item_10 filtri üçün fərqli dəyərlər
    var item10lar = Model.Setirler
        .Where(x => !string.IsNullOrWhiteSpace(x.Item10))
        .Select(x => x.Item10!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
        .ToList();

    // Son ödəniş tarixi üzrə mövcud illər (il+ay filtri)
    var iller = Model.Setirler
        .Where(x => x.SonOdenisIl.HasValue)
        .Select(x => x.SonOdenisIl!.Value)
        .Distinct().OrderByDescending(x => x).ToList();

    var ayAdlari = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
                           "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
}

<style>
    .on-wrap { padding: 4px 0; }
    .on-stats { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
    .on-stat { flex: 1 1 150px; background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; padding: 12px 16px; }
    .on-stat-num { font-size: 22px; font-weight: 800; line-height: 1.1; }
    .on-stat-lbl { font-size: 12px; color: #64748b; margin-top: 2px; }
    .on-stat--all .on-stat-num { color: #334155; }
    .on-stat--ok .on-stat-num { color: #16a34a; }
    .on-stat--no .on-stat-num { color: #dc2626; }
    .on-bar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
    .on-inp { padding: 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 13px; outline: none; }
    .on-inp:focus { border-color: #6366f1; }
    .on-grow { flex: 1 1 260px; }
    .on-chk { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #334155; cursor: pointer; user-select: none;
              padding: 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; background: #fff; }
    .on-chk input { accent-color: #dc2626; }
    .on-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; text-decoration: none; }
    .on-btn--g { background: #fff; color: #334155; border: 1.5px solid #e2e8f0; }
    .on-card { background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .on-table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
    .on-table thead th { background: #f8fafc; padding: 10px 12px; text-align: left; font-weight: 700; color: #475569; border-bottom: 2px solid #e2e8f0; white-space: nowrap; position: sticky; top: 0; z-index: 3; }
    /* Müştəri sütunu üfüqi scroll-da solda dondurulur */
    .on-table th.on-fix, .on-table td.on-fix { position: sticky; left: 0; z-index: 2; box-shadow: 6px 0 8px -6px rgba(0,0,0,.15); }
    .on-table td.on-fix { background: #fff; }
    .on-table tbody tr:hover td.on-fix { background: #fafbff; }
    .on-table thead th.on-fix { z-index: 5; }
    .on-table td { padding: 9px 12px; border-bottom: 1px solid #eef2f7; vertical-align: middle; }
    .on-table tbody tr:hover { background: #fafbff; }
    .on-num { text-align: right; font-variant-numeric: tabular-nums; }
    .on-col-odenis { background: #fffdf5; }
    .on-table thead th.on-col-odenis { background: #fef9ec; }
    .on-mono { font-family: ui-monospace, monospace; }
    .on-ks { display: inline-block; padding: 1px 7px; border-radius: 6px; background: #eef2ff; color: #4338ca; font-size: 11px; font-weight: 800; margin-left: 4px; }
    .on-status { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 800; background: #f1f5f9; color: #475569; white-space: nowrap; }
    .on-odate { font-weight: 700; color: #0f172a; }
    .on-gun { display: block; font-size: 11px; margin-top: 1px; }
    .on-gun--yeni { color: #16a34a; }
    .on-gun--orta { color: #b45309; }
    .on-gun--kohne { color: #dc2626; }
    .on-noodenis { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 800; background: #fee2e2; color: #b91c1c; }
    .on-muted { color: #cbd5e1; }
    .on-sub { font-size: 11px; color: #94a3b8; }
    .on-empty { text-align: center; padding: 40px; color: #94a3b8; }
    .on-foot { padding: 10px 14px; font-size: 12px; color: #64748b; border-top: 1px solid #f1f5f9; }
    .on-notice { background: #fff; border: 1.5px dashed #cbd5e1; border-radius: 12px; padding: 28px; color: #64748b; text-align: center; }
    .on-notice code { background: #f1f5f9; padding: 2px 6px; border-radius: 5px; color: #334155; }
</style>

<div class="on-wrap">

    @if (!Model.SorguTapildi)
    {
        <div class="on-notice">
            <i class="bi bi-database-x" style="font-size:2rem;display:block;margin-bottom:10px"></i>
            <div style="font-weight:700;color:#334155;margin-bottom:6px">Oracle sorğusu tapılmadı</div>
            <div>Admin → <b>Oracle Sorğular</b> bölməsində adında <code>Ödəniş</code> və <code>Nəzarət</code> olan
                 <b>aktiv</b> sorğu yaradın (məs. <code>PID Ödənişə Nəzarət</code>).</div>
        </div>
    }
    else if (Model.Xeta != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> Oracle sorğusu icra olunmadı:<br />
            <small style="font-family:ui-monospace,monospace">@Model.Xeta</small>
        </div>
    }
    else
    {
        <div class="on-stats">
            <div class="on-stat on-stat--all">
                <div class="on-stat-num">@Model.CemMusteri</div>
                <div class="on-stat-lbl">Cəmi aktiv müştəri</div>
            </div>
            <div class="on-stat on-stat--ok">
                <div class="on-stat-num">@Model.OdenisEdenSay</div>
                <div class="on-stat-lbl">Ödənişi olan</div>
            </div>
            <div class="on-stat on-stat--no">
                <div class="on-stat-num">@Model.OdenisEtmeyenSay</div>
                <div class="on-stat-lbl">Ödənişi olmayan</div>
            </div>
        </div>

        <div class="on-bar">
            <input type="text" id="onAxtar" class="on-inp on-grow" placeholder="🔍 Müştəri, kredit hesabı və ya Item 01 axtar…" />
            <select id="onStatus" class="on-inp">
                <option value="">Bütün Item 01</option>
                @foreach (var st in statuslar)
                {
                    <option value="@st.ToLowerInvariant()">@st</option>
                }
            </select>
            <select id="onItem10" class="on-inp" title="Item 10 üzrə süz">
                <option value="">Bütün Item 10</option>
                @foreach (var it in item10lar)
                {
                    <option value="@it.ToLowerInvariant()">@it</option>
                }
            </select>
            <span style="font-size:12px;color:#94a3b8;white-space:nowrap;">Son ödəniş:</span>
            <select id="onIl" class="on-inp" title="Son ödəniş ili">
                <option value="">Bütün illər</option>
                @foreach (var il in iller)
                {
                    <option value="@il">@il</option>
                }
            </select>
            <select id="onAy" class="on-inp" title="Son ödəniş ayı">
                <option value="">Bütün aylar</option>
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m">@ayAdlari[m]</option>
                }
            </select>
            <label class="on-chk">
                <input type="checkbox" id="onYalnizNo" /> Yalnız ödənişi olmayanlar
            </label>
            <button type="button" id="onTemizle" class="on-btn on-btn--g"><i class="bi bi-x-circle"></i> Təmizlə</button>
            <a id="onExcel" href="@Url.Action("IndexExcel")" class="on-btn on-btn--g" style="margin-left:auto"><i class="bi bi-file-earmark-excel"></i> Excelə yüklə</a>
        </div>

        <div class="on-card">
            <div style="overflow-x:auto;overflow-y:auto;max-height:calc(100vh - 320px)">
                <table class="on-table" id="onTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Region</th>
                            <th class="on-fix">Müştəri</th>
                            <th>Kredit hesabı</th>
                            <th>Kreditin növü</th>
                            <th class="on-num">Tam qalıq</th>
                            <th class="on-num">Qalıq</th>
                            <th class="on-num">V/K qalıq</th>
                            <th>Item 01</th>
                            <th>Item 10</th>
                            <th class="on-col-odenis">Son ödəniş tarixi</th>
                            <th class="on-num on-col-odenis">Son ödəniş məbləği</th>
                            <th class="on-num on-col-odenis">Ödəniş cəmi</th>
                            <th class="on-num on-col-odenis">Sayı</th>
                        </tr>
                    </thead>
                    <tbody id="onBody">
                        @if (Model.Setirler.Any())
                        {
                            var i = 1;
                            @foreach (var x in Model.Setirler)
                            {
                                <tr data-search="@((x.Musteri + " " + x.KreditHesabi + " " + x.Ks + " " + (x.Status ?? "") + " " + (x.Item10 ?? "")).ToLowerInvariant())"
                                    data-noodenis="@(x.OdenisYox ? "1" : "0")"
                                    data-status="@((x.Status ?? "").Trim().ToLowerInvariant())"
                                    data-item10="@((x.Item10 ?? "").Trim().ToLowerInvariant())"
                                    data-il="@(x.SonOdenisIl?.ToString() ?? "")"
                                    data-ay="@(x.SonOdenisAy?.ToString() ?? "")">
                                    <td>@(i++)</td>
                                    <td>@(string.IsNullOrWhiteSpace(x.Region) ? "—" : x.Region)</td>
                                    <td class="on-fix" style="font-weight:600">@x.Musteri</td>
                                    <td class="on-mono">
                                        @(string.IsNullOrWhiteSpace(x.KreditHesabi) ? "—" : x.KreditHesabi)
                                        @if (!string.IsNullOrWhiteSpace(x.Ks)) { <span class="on-ks">@x.Ks</span> }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(x.KreditinNovu) ? "—" : x.KreditinNovu)</td>
                                    <td class="on-num">@Pul(x.TamQaliq)</td>
                                    <td class="on-num">@Pul(x.Qaliq)</td>
                                    <td class="on-num">@Pul(x.VkQaliq)</td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(x.Status))
                                        {
                                            <span class="on-muted">—</span>
                                        }
                                        else
                                        {
                                            <span class="on-status">@x.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(x.Item10))
                                        {
                                            <span class="on-muted">—</span>
                                        }
                                        else
                                        {
                                            <span class="on-status">@x.Item10</span>
                                        }
                                    </td>
                                    <td class="on-col-odenis">
                                        @if (x.OdenisYox)
                                        {
                                            <span class="on-noodenis">Ödəniş yoxdur</span>
                                        }
                                        else
                                        {
                                            <span class="on-odate">@x.SonOdenisTarixi</span>
                                            <span class="on-gun @GunCls(x.GunEvvel)">@x.GunEvvel gün əvvəl</span>
                                        }
                                    </td>
                                    <td class="on-num on-col-odenis">@(x.OdenisYox ? "—" : Pul(x.SonOdenisMeblegi))</td>
                                    <td class="on-num on-col-odenis">@(x.OdenisYox ? "—" : Pul(x.OdenisCemi))</td>
                                    <td class="on-num on-col-odenis">@(x.OdenisSayi?.ToString() ?? "—")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="14"><div class="on-empty"><i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>Aktiv müştəri tapılmadı.</div></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="on-foot"><span id="onCount">@Model.CemMusteri</span> müştəri</div>
        </div>
    }
</div>

@section Scripts {
<script>
    (function () {
        var axtar = document.getElementById('onAxtar');
        var statusSel = document.getElementById('onStatus');
        var item10Sel = document.getElementById('onItem10');
        var ilSel = document.getElementById('onIl');
        var aySel = document.getElementById('onAy');
        var yalnizNo = document.getElementById('onYalnizNo');
        var btnTemizle = document.getElementById('onTemizle');
        var excelLink = document.getElementById('onExcel');
        var body = document.getElementById('onBody');
        var count = document.getElementById('onCount');
        if (!body) return;

        var excelBase = excelLink ? excelLink.getAttribute('href') : '';

        // Sətir datasını bir dəfə oxu (kaskad filtr üçün)
        var allRows = [];
        body.querySelectorAll('tr[data-search]').forEach(function (r) {
            allRows.push({
                el: r,
                search: r.getAttribute('data-search') || '',
                noodenis: r.getAttribute('data-noodenis') || '0',
                status: r.getAttribute('data-status') || '',
                item10: r.getAttribute('data-item10') || '',
                il: r.getAttribute('data-il') || '',
                ay: r.getAttribute('data-ay') || ''
            });
        });

        function q() { return (axtar.value || '').trim().toLowerCase(); }

        // Sətir filtrlərə uyğundur? exclude — həmin dropdown-un öz dəyərini nəzərə alma
        function uygun(r, exclude) {
            var s = q();
            if (s && r.search.indexOf(s) === -1) return false;
            if (yalnizNo.checked && r.noodenis !== '1') return false;
            if (exclude !== 'status' && statusSel.value && r.status !== statusSel.value) return false;
            if (exclude !== 'item10' && item10Sel.value && r.item10 !== item10Sel.value) return false;
            if (exclude !== 'il' && ilSel.value && r.il !== ilSel.value) return false;
            if (exclude !== 'ay' && aySel.value && r.ay !== aySel.value) return false;
            return true;
        }

        // Kaskad: cari filtrə uyğun olmayan seçimləri gizlət; seçili dəyər yoxa çıxarsa sıfırla
        function opsiyalariYenile(sel, key) {
            if (!sel) return;
            var cur = sel.value, curVar = (cur === '');
            for (var i = 0; i < sel.options.length; i++) {
                var o = sel.options[i];
                if (o.value === '') { o.hidden = false; continue; }
                var movcud = allRows.some(function (r) { return r[key] === o.value && uygun(r, key); });
                o.hidden = !movcud;
                if (o.value === cur && movcud) curVar = true;
            }
            if (!curVar) sel.value = '';
        }

        function suz() {
            opsiyalariYenile(statusSel, 'status');
            opsiyalariYenile(item10Sel, 'item10');
            opsiyalariYenile(ilSel, 'il');
            opsiyalariYenile(aySel, 'ay');

            var gorunen = 0;
            allRows.forEach(function (r) {
                var show = uygun(r, null);
                r.el.style.display = show ? '' : 'none';
                if (show) gorunen++;
            });
            count.textContent = gorunen;
            excelHrefYenile();
        }

        function excelHrefYenile() {
            if (!excelLink) return;
            var p = new URLSearchParams();
            if (q()) p.set('axtaris', axtar.value.trim());
            if (statusSel.value) p.set('status', statusSel.value);
            if (item10Sel.value) p.set('item10', item10Sel.value);
            if (ilSel.value) p.set('il', ilSel.value);
            if (aySel.value) p.set('ay', aySel.value);
            if (yalnizNo.checked) p.set('onlyNo', 'true');
            var s = p.toString();
            excelLink.href = excelBase + (s ? ('?' + s) : '');
        }

        function temizle() {
            axtar.value = '';
            statusSel.value = ''; item10Sel.value = ''; ilSel.value = ''; aySel.value = '';
            yalnizNo.checked = false;
            suz();
        }

        axtar.addEventListener('input', suz);
        yalnizNo.addEventListener('change', suz);
        if (statusSel) statusSel.addEventListener('change', suz);
        if (item10Sel) item10Sel.addEventListener('change', suz);
        if (ilSel) ilSel.addEventListener('change', suz);
        if (aySel) aySel.addEventListener('change', suz);
        if (btnTemizle) btnTemizle.addEventListener('click', temizle);

        excelHrefYenile();
    })();
</script>
}
