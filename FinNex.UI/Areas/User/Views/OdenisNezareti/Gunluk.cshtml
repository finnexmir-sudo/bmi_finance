@using FinNex.Application.DTOs.Pid
@model GunlukOdenisSiyahiDto
@{
    ViewData["Title"] = "Ödənişə Nəzarət — Gündəlik Kredit Ödənişləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    Func<decimal?, string> Pul = v => v.HasValue ? v.Value.ToString("N2") : "—";
    // JS üçün XAM rəqəm (invariant, nöqtə ilə) — cəmləmə client-də olur (az-AZ vergül tələsi)
    Func<decimal, string> Inv = v => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}

<style>
    .on-wrap { padding: 20px 0 4px; }
    .on-bar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
    .on-inp { padding: 8px 12px; border: 1.5px solid #e2e8f0; border-radius: 8px; font-size: 13px; outline: none; }
    .on-inp:focus { border-color: #6366f1; }
    .on-grow { flex: 1 1 240px; max-width: 400px; }
    .on-actions { margin-left: auto; display: flex; gap: 8px; }
    .on-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 8px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; text-decoration: none; }
    .on-btn--g { background: #fff; color: #334155; border: 1.5px solid #e2e8f0; }
    .on-btn--g:hover { background: #f8fafc; border-color: #cbd5e1; color: #1e293b; }
    .on-card { background: #fff; border: 1.5px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .on-table { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
    .on-table thead th { background: #f8fafc; padding: 10px 12px; text-align: left; font-weight: 700; color: #475569; border-bottom: 2px solid #e2e8f0; white-space: nowrap; position: sticky; top: 0; z-index: 3; }
    .on-table td { padding: 9px 12px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
    .on-table th, .on-table td { border-right: 1px solid #e2e8f0; }
    .on-table th:last-child, .on-table td:last-child { border-right: none; }
    .on-table tbody tr:hover { background: #fafbff; }
    .on-num { text-align: right; font-variant-numeric: tabular-nums; }
    .on-mono { font-family: ui-monospace, monospace; }
    .on-empty { text-align: center; padding: 40px; color: #94a3b8; }
    .on-foot { padding: 10px 14px; font-size: 13px; color: #475569; border-top: 1px solid #f1f5f9; }
    .on-notice { background: #fff; border: 1.5px dashed #cbd5e1; border-radius: 12px; padding: 28px; color: #64748b; text-align: center; }
    .on-notice code { background: #f1f5f9; padding: 2px 6px; border-radius: 5px; color: #334155; }
    .on-scope { display: flex; align-items: flex-start; gap: 8px; background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af;
                border-radius: 10px; padding: 10px 14px; font-size: 12.5px; margin-bottom: 12px; }
    .on-scope b { font-weight: 700; }
    .on-scope code { color: #1e40af; background: rgba(30,64,175,.1); padding: 1px 5px; border-radius: 4px; font-size: 12px; }

    /* Tab keçidi */
    .on-tabs { display: inline-flex; border: 1.5px solid #e2e8f0; border-radius: 10px; overflow: hidden; margin-bottom: 14px; }
    .on-tab { padding: 9px 20px; font-size: 13px; font-weight: 700; color: #475569; background: #fff; text-decoration: none; }
    .on-tab + .on-tab { border-left: 1.5px solid #e2e8f0; }
    .on-tab--aktiv { background: #4f46e5; color: #fff; }
    .on-tab:hover:not(.on-tab--aktiv) { background: #f8fafc; color: #334155; }

    /* Gündəlik-ə xas */
    .gn-hesabi { display: inline-block; padding: 2px 9px; border-radius: 20px; font-size: 11px; font-weight: 700; white-space: nowrap; }
    .gn-hesabi--birbasa { background: #dcfce7; color: #15803d; }
    .gn-hesabi--cari     { background: #fef3c7; color: #92400e; }
    .gn-gecikir { color: #b91c1c; font-weight: 800; }
    .gn-vaxtinda { color: #15803d; font-weight: 700; }
    .gn-fanout { display: inline-flex; align-items: center; gap: 3px; margin-left: 6px; padding: 1px 8px;
                 border-radius: 20px; background: #f3e8ff; color: #7e22ce; font-size: 10.5px; font-weight: 700;
                 white-space: nowrap; cursor: help; vertical-align: middle; }
    .gn-teyinat { white-space: normal; max-width: 420px; color: #64748b; font-size: 12px; }
</style>

<div class="on-wrap">

    <div class="on-tabs">
        <a class="on-tab" href="@Url.Action("Index")"><i class="bi bi-people"></i> Adi müştərilər</a>
        <a class="on-tab" href="@Url.Action("Gray")"><i class="bi bi-shield-exclamation"></i> Gray list</a>
        <a class="on-tab on-tab--aktiv" href="@Url.Action("Gunluk")"><i class="bi bi-calendar-check"></i> Gündəlik ödənişlər</a>
    </div>

    @if (!Model.SorguTapildi)
    {
        <div class="on-notice">
            <i class="bi bi-database-x" style="font-size:2rem;display:block;margin-bottom:10px"></i>
            <div style="font-weight:700;color:#334155;margin-bottom:6px">Oracle sorğusu tapılmadı</div>
            <div>Admin → <b>Oracle Sorğular</b> bölməsində adında <code>Odenis</code>, <code>Nezaret</code> və <code>Gunluk</code> olan
                 <b>aktiv</b> sorğu yaradın (məs. <code>PID Odenis Nezaret Gunluk</code>).</div>
        </div>
    }
    else if (Model.Xeta != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle"></i> Oracle sorğusu icra olunmadı:<br />
            <small style="font-family:ui-monospace,monospace">@Model.Xeta</small>
        </div>
    }
    else
    {
        <div class="on-bar">
            <input type="text" id="gnAxtar" class="on-inp on-grow" placeholder="🔍 Müştəri, hesab, reg. nömrəsi axtar…" />
            <div class="on-actions">
                <button type="button" id="gnYenile" class="on-btn on-btn--g" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> Yenilə</button>
                <button type="button" id="gnTemizle" class="on-btn on-btn--g"><i class="bi bi-x-circle"></i> Təmizlə</button>
                <a id="gnExcel" href="@Url.Action("GunlukExcel")" class="on-btn on-btn--g"><i class="bi bi-file-earmark-excel"></i> Excelə yüklə</a>
            </div>
        </div>

        <div class="on-scope">
            <i class="bi bi-info-circle" style="margin-top:2px"></i>
            <span>
                <b>Bu siyahı yalnız BUGÜNÜ göstərir</b> (mənbə canlı <code>docdna</code> cədvəlidir, arxiv deyil) —
                gün ərzində yeni ödəniş gələndə "Yenilə" ilə yoxlayın. Ödəniş — kassa, müştərinin cari hesabı və ya
                köçürmə yolu ilə gələn, müştərinin <b>öz REGNOM-u üzrə</b> krediti ilə uyğunlaşdırılan məbləğdir.
                <b>Hesabı</b> sütunu "(birbaşa)" — kredit hesabına birbaşa düşüb; "Cari hesaba daxil olub" —
                hələ müştərinin cari hesabındadır, kreditə keçməyib (hər ikisi <b>ödənilib</b> sayılır).
                Hər ödəniş (eyni əməliyyat) siyahıda <b>yalnız BİR dəfə</b> göstərilir. Müştərinin bir neçə
                aktiv krediti varsa və ödəniş hələ konkret kreditə bağlanmayıbsa, sistem onu TƏMSİLÇİ olaraq
                bir kreditə yazır — bu sətirlər <span class="gn-fanout"><i class="bi bi-files"></i> bir neçə
                krediti var</span> işarəsi ilə seçilir; <b>real kredit başqası ola bilər</b>, lazım gəlsə
                müştərinin digər açıq kreditlərini də yoxlayın.
            </span>
        </div>

        <div class="on-card">
            <div style="overflow-x:auto;overflow-y:auto;max-height:calc(100vh - 360px)">
                <table class="on-table" id="gnTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tarix</th>
                            <th>Debet</th>
                            <th>Kredit</th>
                            <th>Hesabı</th>
                            <th>Gecikmə</th>
                            <th class="on-num">Məbləğ</th>
                            <th>Müştəri</th>
                            <th>Reg. №</th>
                            <th>Kredit hesabı</th>
                            <th>Girov növü</th>
                            <th>Kredit tipi</th>
                            <th class="on-num">V/K əsas</th>
                            <th>Təyinat</th>
                        </tr>
                    </thead>
                    <tbody id="gnBody">
                        @if (Model.Setirler.Any())
                        {
                            var i = 1;
                            @foreach (var s in Model.Setirler)
                            {
                                var birbasa = (s.Hesabi ?? "").Contains("birbaşa");
                                <tr data-search="@($"{s.Adi} {s.Debet} {s.Kredit} {s.Kat} {s.QeydNo}".ToLowerInvariant())"
                                    data-mebleg="@Inv(s.Mebleg)">
                                    <td>@(i++)</td>
                                    <td>@(s.Tarix?.ToString("dd.MM.yyyy") ?? "—")</td>
                                    <td class="on-mono">@s.Debet</td>
                                    <td class="on-mono">
                                        @s.Kredit
                                        @if (s.CoxKreditliFanOut)
                                        {
                                            <span class="gn-fanout" title="Bu müştərinin BİRDƏN ÇOX aktiv krediti var — bu ödəniş (RECNUM=@s.RecNum) hələ konkret kreditə bağlanmayıb (kreditin öz hesabına yox, cari hesaba düşüb), ona görə sistem TƏMSİLÇİ olaraq bu kreditə yazdı. Real kredit BAŞQASI ola bilər — əmin olmaq üçün müştərinin digər açıq kreditlərini də yoxlayın."><i class="bi bi-files"></i> bir neçə krediti var</span>
                                        }
                                    </td>
                                    <td><span class="gn-hesabi @(birbasa ? "gn-hesabi--birbasa" : "gn-hesabi--cari")">@s.Hesabi</span></td>
                                    <td><span class="@(s.Gecikme == "Gecikir" ? "gn-gecikir" : "gn-vaxtinda")">@s.Gecikme</span></td>
                                    <td class="on-num" style="font-weight:700">@Pul(s.Mebleg)</td>
                                    <td style="font-weight:600">@s.Adi</td>
                                    <td class="on-mono">@(s.QeydNo ?? "—")</td>
                                    <td class="on-mono">@s.Kat</td>
                                    <td>@(s.Novu ?? "—")</td>
                                    <td>@(s.Tipi ?? "—")</td>
                                    <td class="on-num">@(s.VkEsas.HasValue && s.VkEsas.Value > 0 ? Pul(s.VkEsas) : "—")</td>
                                    <td class="gn-teyinat">@(string.IsNullOrWhiteSpace(s.Teyinat) ? "—" : s.Teyinat)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="14" class="on-empty">Bu gün hələ gələn kredit ödənişi qeydə alınmayıb</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="on-foot" id="gnFoot">
                <span id="gnSay">@Model.CemSetir sətir</span> ·
                Müxtəlif müştəri: <b>@Model.Muxtelif</b> ·
                Gecikən: <b style="color:#b91c1c">@Model.GecikenSay</b> ·
                Cəm: <b id="gnCemMebleg" style="color:#15803d;font-size:18px"></b>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var axtar = document.getElementById('gnAxtar');
        if (!axtar) return;

        function pulFmt(v) {
            return v.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₼';
        }

        var rows = Array.prototype.slice.call(document.querySelectorAll('#gnBody tr'));

        function yenile() {
            var q = (axtar.value || '').trim().toLowerCase();
            var say = 0, cem = 0;
            rows.forEach(function (r) {
                var search = r.getAttribute('data-search');
                if (search === null) return; // "boş nəticə" sətri
                var uygun = !q || search.indexOf(q) >= 0;
                r.style.display = uygun ? '' : 'none';
                if (uygun) {
                    say++;
                    cem += parseFloat(r.getAttribute('data-mebleg')) || 0;
                }
            });
            document.getElementById('gnSay').textContent = say + ' sətir';
            document.getElementById('gnCemMebleg').textContent = pulFmt(cem);

            var excel = document.getElementById('gnExcel');
            var url = '@Url.Action("GunlukExcel")';
            excel.href = q ? url + '?axtaris=' + encodeURIComponent(axtar.value.trim()) : url;
        }

        axtar.addEventListener('input', yenile);
        document.getElementById('gnTemizle').addEventListener('click', function () {
            axtar.value = '';
            yenile();
        });

        yenile();
    })();
</script>
