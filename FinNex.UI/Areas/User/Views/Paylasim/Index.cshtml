@model List<FinNex.Application.DTOs.Paylasim.PaylasimListDto>
@{
    ViewData["Title"] = "Paylaşımlar";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">

    @* Başlıq təkrarı (27.10.2026) — "Paylaşımlar" artıq yuxarıdaki ağ topbar-da
       (_UserLayout.cshtml, fn-topbar-title) göstərilir, buradaki başlığı təkrar
       yazmırıq, yalnız qısa izah qalır. *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-sub">Oxumağa dəyər məlumatlar</div>
        </div>
    </div>

    @{
        var kateqoriyalar = Model.Where(x => !string.IsNullOrEmpty(x.KateqoriyaAdi))
            .Select(x => x.KateqoriyaAdi!).Distinct().OrderBy(x => x).ToList();
    }
    @if (Model.Any() && kateqoriyalar.Any())
    {
        <div class="py-filters" id="pyFilters">
            <button type="button" class="py-filter-pill active" data-kat="">Hamısı</button>
            @foreach (var k in kateqoriyalar)
            {
                <button type="button" class="py-filter-pill" data-kat="@k">@k</button>
            }
        </div>
    }

    <div class="py-feed">
        @if (!Model.Any())
        {
            <div class="py-empty">Hələ heç bir paylaşım yoxdur.</div>
        }
        else
        {
            @foreach (var p in Model)
            {
                var bash = (p.GonderenAdi ?? "?").Trim();
                var ilkHerf = bash.Length > 0 ? bash[0].ToString().ToUpperInvariant() : "?";
                // Sırf görüntü — DB-yə toxunmur, "Yeni" kartın yaradılma tarixinə görə
                // hesablanır (27.10.2026). Sidebar-dakı nişan isə AYRI, "son baxış"
                // tarixinə görə işləyir — ikisi fərqli sualların cavabıdır.
                var yeniKart = (DateTime.Now - p.YaradilmaTarixi).TotalDays <= 3;
                <div class="py-card" data-kat="@p.KateqoriyaAdi">
                    <div class="py-card-head">
                        <div class="py-avatar">@ilkHerf</div>
                        <div class="py-head-info">
                            <div class="py-sender">@p.GonderenAdi</div>
                            <div class="py-date">@p.YaradilmaTarixi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("az-AZ"))</div>
                        </div>
                        @if (yeniKart || !string.IsNullOrEmpty(p.KateqoriyaAdi))
                        {
                            <div class="py-head-badges">
                                @if (yeniKart)
                                {
                                    <span class="py-new-badge">Yeni</span>
                                }
                                @if (!string.IsNullOrEmpty(p.KateqoriyaAdi))
                                {
                                    <span class="py-kat-badge">@p.KateqoriyaAdi</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="py-title">@p.Basliq</div>
                    <div class="py-body py-collapsed" id="pyBody_@p.Id">@Html.Raw(p.MetnHtml)</div>
                    <div class="py-readmore-wrap">
                        <button type="button" class="py-readmore-btn" data-target="pyBody_@p.Id" style="display:none">Davamını oxu</button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/paylasim.css" asp-append-version="true" />
}

@section Scripts {
    <script>
    (function () {
        var filtersEl = document.getElementById('pyFilters');
        if (!filtersEl) return;

        filtersEl.addEventListener('click', function (e) {
            var btn = e.target.closest('.py-filter-pill');
            if (!btn) return;

            filtersEl.querySelectorAll('.py-filter-pill').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');

            var kat = btn.dataset.kat || '';
            document.querySelectorAll('.py-card').forEach(function (card) {
                card.style.display = (!kat || card.dataset.kat === kat) ? '' : 'none';
            });
        });
    })();
    </script>
    <script>
    (function () {
        // Boş (yalnız <br>) paraqrafları gizlət — abzas aralarındaki artıq boşluğu
        // aradan qaldırır (27.10.2026). DB-yə toxunmur, sırf göstərmə qatıdır.
        document.querySelectorAll('.py-body p').forEach(function (p) {
            if (p.textContent.trim() === '' && !p.querySelector('img')) {
                p.style.display = 'none';
            }
        });

        // Lentdə hər kart qısa önizləmə (şəkil + bir neçə sətir) göstərir,
        // "Davamını oxu" tam mətni açır (27.10.2026). Şəkillər yüklənənə qədər
        // hündürlük düzgün ölçülmür, ona görə `load` hadisəsini gözləyirik.
        function pySetupReadMore() {
            document.querySelectorAll('.py-card').forEach(function (card) {
                var body = card.querySelector('.py-body');
                var btn = card.querySelector('.py-readmore-btn');
                if (!body || !btn) return;
                if (body.scrollHeight > body.clientHeight + 20) {
                    btn.style.display = 'inline-block';
                } else {
                    body.classList.remove('py-collapsed');
                    btn.style.display = 'none';
                }
            });
        }
        // Skript səhifənin SONUNDA işə düşür — şəkillər keşdən artıq yüklənmiş
        // ola bilər və `load` hadisəsi ARTIQ atəşlənmiş olar; belə halda
        // listener heç vaxt çağırılmazdı (kartlar əbədi kolaps qalardı).
        if (document.readyState === 'complete') {
            pySetupReadMore();
        } else {
            window.addEventListener('load', pySetupReadMore);
        }

        document.addEventListener('click', function (e) {
            var btn = e.target.closest('.py-readmore-btn');
            if (!btn) return;
            var body = document.getElementById(btn.getAttribute('data-target'));
            if (!body) return;
            var collapsed = body.classList.toggle('py-collapsed');
            btn.textContent = collapsed ? 'Davamını oxu' : 'Bağla';
        });
    })();
    </script>
}
