@model List<FinNex.Application.DTOs.Paylasim.PaylasimListDto>
@{
    ViewData["Title"] = "Paylaşımlar";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    // 28.10.2026 (ölçü/proporsiya düzəlişi) — yuxarıdaki ağ "Geri / Paylaşımlar /
    // tarix" topbar-ı YALNIZ bu səhifədə gizlədilir (_UserLayout.cshtml-dəki
    // "HideTopbar" bayrağı), əvəzinə aşağıda öz başlığımızı qoyuruq. Digər
    // səhifələrə TOXUNULMUR — bayraq defolt heç yerdə set olunmur.
    ViewData["HideTopbar"] = true;
}

<div class="fn-page">

    <div class="py-page-header">
        <div class="py-page-header-icon"><i class="bi bi-share-fill"></i></div>
        <div class="py-page-header-text">
            <h1 class="py-page-title">Paylaşımlar</h1>
            <div class="py-page-desc">Oxumağa dəyər məlumatlar</div>
        </div>
        <div class="py-page-header-count">@Model.Count paylaşım</div>
    </div>

    @{
        var kateqoriyalar = Model.Where(x => !string.IsNullOrEmpty(x.KateqoriyaAdi))
            .Select(x => x.KateqoriyaAdi!).Distinct().OrderBy(x => x).ToList();
    }
    @if (Model.Any() && kateqoriyalar.Any())
    {
        <div class="py-filters" id="pyFilters">
            <button type="button" class="py-filter-pill active" data-kat="">Hamısı</button>
            @foreach (var k in kateqoriyalar)
            {
                <button type="button" class="py-filter-pill" data-kat="@k">@k</button>
            }
        </div>
    }

    <div class="py-list-wrap">
        @if (!Model.Any())
        {
            <div class="py-empty">Hələ heç bir paylaşım yoxdur.</div>
        }
        else
        {
            <div class="py-list">
                @{ var pyIdx = 0; }
                @foreach (var p in Model)
                {
                    pyIdx++;
                    var bash = (p.GonderenAdi ?? "?").Trim();
                    var ilkHerf = bash.Length > 0 ? bash[0].ToString().ToUpperInvariant() : "?";
                    // Sırf görüntü — DB-yə toxunmur, "Yeni" kartın yaradılma tarixinə görə
                    // hesablanır (27.10.2026). Sidebar-dakı nişan isə AYRI, "son baxış"
                    // tarixinə görə işləyir — ikisi fərqli sualların cavabıdır.
                    var yeniKart = (DateTime.Now - p.YaradilmaTarixi).TotalDays <= 3;
                    var renk = pyIdx % 6;
                    <div class="py-row" data-kat="@p.KateqoriyaAdi" id="pyRow_@p.Id">
                        <div class="py-row-summary" data-target="pyRow_@p.Id">
                            <div class="py-row-thumb py-thumb-c@renk">
                                <i class="bi bi-journal-richtext"></i>
                            </div>
                            <div class="py-row-main">
                                <div class="py-row-meta">
                                    @if (yeniKart)
                                    {
                                        <span class="py-new-dot"></span><span class="py-new-text">Yeni</span><span class="py-meta-sep">|</span>
                                    }
                                    <span class="py-row-date">@p.YaradilmaTarixi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("az-AZ"))</span>
                                    @if (!string.IsNullOrEmpty(p.KateqoriyaAdi))
                                    {
                                        <span class="py-meta-sep">|</span><span class="py-row-kat">@p.KateqoriyaAdi</span>
                                    }
                                </div>
                                <div class="py-row-title">@p.Basliq</div>
                                <div class="py-row-excerpt"></div>
                                <span class="py-row-link">Oxumağa davam et <i class="bi bi-arrow-right"></i></span>
                            </div>
                            <div class="py-row-chevron"><i class="bi bi-chevron-right"></i></div>
                        </div>
                        <div class="py-row-full" style="display:none">
                            <div class="py-card-head">
                                <div class="py-avatar">@ilkHerf</div>
                                <div class="py-head-info">
                                    <div class="py-sender">@p.GonderenAdi</div>
                                    <div class="py-date">@p.YaradilmaTarixi.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("az-AZ"))</div>
                                </div>
                                @if (!string.IsNullOrEmpty(p.KateqoriyaAdi))
                                {
                                    <div class="py-head-badges"><span class="py-kat-badge">@p.KateqoriyaAdi</span></div>
                                }
                            </div>
                            <div class="py-title">@p.Basliq</div>
                            <div class="py-body" id="pyBody_@p.Id">@Html.Raw(p.MetnHtml)</div>
                            <div class="py-row-collapse-wrap">
                                <button type="button" class="py-row-collapse-btn" data-target="pyRow_@p.Id">Bağla <i class="bi bi-chevron-up"></i></button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/paylasim.css" asp-append-version="true" />
}

@section Scripts {
    <script>
    (function () {
        var filtersEl = document.getElementById('pyFilters');
        if (!filtersEl) return;

        filtersEl.addEventListener('click', function (e) {
            var btn = e.target.closest('.py-filter-pill');
            if (!btn) return;

            filtersEl.querySelectorAll('.py-filter-pill').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');

            var kat = btn.dataset.kat || '';
            document.querySelectorAll('.py-row').forEach(function (row) {
                row.style.display = (!kat || row.dataset.kat === kat) ? '' : 'none';
            });
        });
    })();
    </script>
    <script>
    (function () {
        // Hər sətir üçün artıq server-dən gələn (gizli) tam HTML-dən — şəkil
        // varsa miniatür, yoxdursa ikon, VƏ qısa mətn önizləməsi çıxarılır
        // (28.10.2026, GPT mockup-una uyğun sıx siyahı görünüşü). Heç bir AJAX
        // yoxdur — `.py-body` artıq DOM-dadır, sadəcə `.py-row-full` ilə gizlidir.
        document.querySelectorAll('.py-row').forEach(function (row) {
            var bodyEl = row.querySelector('.py-body');
            if (!bodyEl) return;

            // Boş (yalnız <br>) paraqrafları gizlət — açılanda abzas aralarındaki
            // artıq boşluğu aradan qaldırır. DB-yə toxunmur.
            bodyEl.querySelectorAll('p').forEach(function (p) {
                if (p.textContent.trim() === '' && !p.querySelector('img')) {
                    p.style.display = 'none';
                }
            });

            var thumb = row.querySelector('.py-row-thumb');
            var img = bodyEl.querySelector('img');
            if (thumb && img && img.getAttribute('src')) {
                thumb.innerHTML = '';
                var im = document.createElement('img');
                im.src = img.getAttribute('src');
                im.alt = '';
                thumb.appendChild(im);
                thumb.classList.add('py-thumb-img');
            }

            // Önizləmə — YALNIZ təmiz mətn (textContent şəkli/teqləri özü atır).
            // Hərf həddi CSS-in 3-sətirlik line-clamp-i üçün ehtiyat payıdır —
            // əsl kəsim CSS-dədir, bura yalnız DOM-a çox böyük mətn göndərməsin.
            var excerptEl = row.querySelector('.py-row-excerpt');
            if (excerptEl) {
                var text = (bodyEl.textContent || '').replace(/\s+/g, ' ').trim();
                if (text.length > 260) text = text.slice(0, 260).trim() + '…';
                excerptEl.textContent = text;
            }
        });

        document.addEventListener('click', function (e) {
            var summary = e.target.closest('.py-row-summary');
            if (summary) {
                var row = document.getElementById(summary.getAttribute('data-target'));
                if (!row) return;
                row.querySelector('.py-row-summary').style.display = 'none';
                row.querySelector('.py-row-full').style.display = 'block';
                return;
            }

            var closeBtn = e.target.closest('.py-row-collapse-btn');
            if (closeBtn) {
                var row2 = document.getElementById(closeBtn.getAttribute('data-target'));
                if (!row2) return;
                row2.querySelector('.py-row-full').style.display = 'none';
                // Boş sətirlə CSS-in özünə (grid, 28.10.2026) qayıdır —
                // 'flex' yazsaq inline stil grid-i əzərdi.
                row2.querySelector('.py-row-summary').style.display = '';
                row2.scrollIntoView({ block: 'nearest' });
            }
        });
    })();
    </script>
}
