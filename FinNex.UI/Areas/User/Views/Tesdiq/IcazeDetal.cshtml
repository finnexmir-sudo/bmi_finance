@model FinNex.UI.Areas.User.ViewModels.Tesdiq.TesdiqDetalVM
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "İcazə Detalı";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var rol = ViewBag.Rol as string ?? "SobeReisi";

    string backAction = rol;
    string backLabel = rol switch {
        "SobeReisi" => "Şöbə Rəhbəri Paneli",
        "Rehber"    => "Rəhbər Paneli",
        "Hr"        => "HR Paneli",
        _           => "Panel"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/tesdiq.css" asp-append-version="true" />
}

<div class="fn-page">

    @* ── Back link ── *@
    <div style="margin-bottom:16px">
        <a asp-area="User" asp-controller="Tesdiq" asp-action="@backAction"
           class="tsd-btn tsd-btn--ghost" style="width:fit-content">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M8 2L4 6.5 8 11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            @backLabel-ə qayıt
        </a>
    </div>

    <div class="tsd-detal-grid">

        @* ── Left: Info ── *@
        <div>
            @* Employee Info *@
            <div class="tsd-info-card">
                <div class="tsd-info-card-title">İşçi Məlumatları</div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Ad Soyad</span>
                    <span class="tsd-info-val">@Model.IsciAdSoyad</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Şöbə</span>
                    <span class="tsd-info-val">@Model.SobeAdi</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.EvezEdenIsciAdSoyad))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">Əvəzedici</span>
                        <span class="tsd-info-val">@Model.EvezEdenIsciAdSoyad</span>
                    </div>
                }
            </div>

            @* Icaze Info *@
            <div class="tsd-info-card">
                <div class="tsd-info-card-title">İcazə Məlumatları</div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">İcazə tarixi</span>
                    <span class="tsd-info-val">@Model.IcazeTarixi?.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Başlama saatı</span>
                    <span class="tsd-info-val">@Model.BaslamaSaati?.ToString(@"hh\:mm")</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Bitmə saatı</span>
                    <span class="tsd-info-val">@Model.BitisSaati?.ToString(@"hh\:mm")</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">İcazə saatı</span>
                    <span class="tsd-info-val" style="font-weight:700;color:#1a2332">
                        @{
                            var totalDeq = (int)Math.Round((Model.IcazeSaati ?? 0) * 60);
                            var sH = totalDeq / 60; var sM = totalDeq % 60;
                        }
                        @sH saat@(sM > 0 ? $" {sM} dəqiqə" : "")
                        @if (Model.NaharNezereAlinmasin)
                        {
                            int naharDeqInfo = ViewBag.NaharMuddetDeqiqe ?? 45;
                            var effDeq = Math.Max(0, totalDeq - naharDeqInfo);
                            var eH = effDeq / 60; var eM = effDeq % 60;
                            <span style="margin-left:8px;font-size:11px;background:#fef3c7;color:#92400e;
                                         padding:2px 7px;border-radius:5px;font-weight:600">
                                Nahar çıxıldı → @eH saat@(eM > 0 ? $" {eM} dəq" : "")
                            </span>
                        }
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Sebeb))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">Səbəb</span>
                        <span class="tsd-info-val">@Model.Sebeb</span>
                    </div>
                }
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Status</span>
                    <span class="tsd-info-val">
                        <span class="tsd-badge tsd-badge--wait">@Model.StatusText</span>
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.ImtinaSebebi))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">İmtina səbəbi</span>
                        <span class="tsd-info-val" style="color:#c0392b">@Model.ImtinaSebebi</span>
                    </div>
                }
            </div>
        </div>

        @* ── Right: Workflow + Approval ── *@
        <div>
            @* Workflow Tracker *@
            <div class="tsd-workflow">
                <div class="tsd-workflow-title">Təsdiq Axını</div>
                <div class="tsd-wf-steps">

                    @* Step 0: Müraciət *@
                    <div class="tsd-wf-step done">
                        <div class="tsd-wf-dot">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Müraciət göndərildi</div>
                            <div class="tsd-wf-result tsd-wf-result--ok">Göndərildi</div>
                        </div>
                    </div>

                    @* Şöbə rəisi artıq təsdiq zəncirindən çıxarıldı — yalnız köhnə qeydlər üçün göstər *@
                    @if (Model.SobeReisiTesdiq.HasValue)
                    {
                        var s1Class = Model.SobeReisiTesdiq == true ? "done" : "rejected";
                    <div class="tsd-wf-step @s1Class">
                        <div class="tsd-wf-dot">
                            @if (Model.SobeReisiTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Şöbə Rəhbəri</div>
                            @if (Model.SobeReisiTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.SobeReisiTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.SobeReisiTesdiq == true) { <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div> }
                            else { <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div> }
                        </div>
                    </div>
                    }

                    @* Step 2: Rehber — yalnız bu addımdan keçibsə göstər *@
                    @{
                        // Status >= HrTesdiqinde (4) və RehberTesdiq qeydi yoxdursa, bu addım atlandı (Rəhbər özü muraciet edib)
                        bool rehberAddimi = Model.RehberTesdiq.HasValue
                            || Model.Status == (int)FinNex.Domain.Entities.HR.MezuniyyetStatus.RehberTesdiqinde
                            || (Model.Status < (int)FinNex.Domain.Entities.HR.MezuniyyetStatus.HrTesdiqinde);
                        // Tesdiqlenib və ya HrTesdiqinde olub Rehber qeydi yoxdursa atlandı
                        if ((Model.Status == (int)FinNex.Domain.Entities.HR.MezuniyyetStatus.HrTesdiqinde
                             || Model.Status == (int)FinNex.Domain.Entities.HR.MezuniyyetStatus.Tesdiqlenib)
                            && !Model.RehberTesdiq.HasValue)
                        {
                            rehberAddimi = false;
                        }
                    }
                    @if (rehberAddimi)
                    {
                        var s2Class = Model.RehberTesdiq == true ? "done"
                            : Model.RehberTesdiq == false ? "rejected"
                            : (Model.SobeReisiTesdiq == true || !Model.SobeReisiTesdiq.HasValue) ? "active" : "";
                    <div class="tsd-wf-step @s2Class">
                        <div class="tsd-wf-dot">
                            @if (Model.RehberTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else if (Model.RehberTesdiq == false)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                            else { <text>@(Model.SobeReisiTesdiq.HasValue ? "2" : "1")</text> }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Rəhbər Təsdiqi</div>
                            @if (Model.RehberTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.RehberTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.RehberTesdiq == true) { <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div> }
                            else if (Model.RehberTesdiq == false) { <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div> }
                            else { <div class="tsd-wf-result tsd-wf-result--wait">Gözləyir</div> }
                        </div>
                    </div>
                    }

                    @* HR addımı təsdiq zəncirindən çıxarıldı — rəhbər son təsdiqdir.
                       Yalnız köhnə qeydlər (HR təsdiq/imtina qeydi olanlar) üçün göstərilir. *@
                    @{
                        bool hrAddimi = Model.HrTesdiq.HasValue;

                        // Görünən addım sayını hesabla — HR-ın nömrəsi düzgün dursun
                        int hrNo = 1;
                        if (Model.SobeReisiTesdiq.HasValue) hrNo++;
                        if (rehberAddimi) hrNo++;
                    }
                    @if (hrAddimi)
                    {
                        var s3Class = Model.HrTesdiq == true ? "done"
                            : Model.HrTesdiq == false ? "rejected"
                            : (Model.RehberTesdiq == true || !rehberAddimi) ? "active" : "";
                    <div class="tsd-wf-step @s3Class">
                        <div class="tsd-wf-dot">
                            @if (Model.HrTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else if (Model.HrTesdiq == false)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                            else { <text>@hrNo</text> }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">HR Təsdiqi</div>
                            @if (Model.HrTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.HrTesdiq == true) { <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div> }
                            else if (Model.HrTesdiq == false) { <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div> }
                            else { <div class="tsd-wf-result tsd-wf-result--wait">Gözləyir</div> }
                        </div>
                    </div>
                    }

                </div>
            </div>

            @* Approval Panel — yalnız bu rolun növbəsi gözləyirsə göstər *@
            @{
                bool panelGoster = rol switch {
                    "Rehber"    => Model.Status == (int)IcazeStatus.RehberTesdiqinde,
                    "Hr"        => Model.Status == (int)IcazeStatus.HrTesdiqinde,
                    "SobeReisi" => Model.Status == (int)IcazeStatus.SobeReisiTesdiqinde,
                    _           => false
                };
            }
            @if (panelGoster)
            {
            <div class="tsd-approve-panel">
                <div class="tsd-approve-title">Qərar Ver</div>

                <form asp-area="User" asp-controller="Tesdiq" asp-action="IcazeTesdiq"
                      method="post" id="tsdForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="rol" value="@rol" />
                    <input type="hidden" name="status" id="formStatus" value="true" />

                    <label style="font-size:12px;color:#8a93a8;display:block;margin-bottom:6px">İmtina səbəbi (ixtiyari)</label>
                    <textarea name="qeyd" class="tsd-approve-reason"
                              placeholder="İmtina etdikdə səbəbi qeyd edin..."></textarea>

                    @if (rol == "Rehber")
                    {
                        decimal balans = ViewBag.JetonBalansi != null ? (decimal)ViewBag.JetonBalansi : 0m;
                        decimal icazeSaatiRaw = (decimal)(Model.IcazeSaati ?? 0);
                        decimal maxJeton = Math.Min(balans, icazeSaatiRaw);
                        int rTotalDeq = (int)Math.Round((double)icazeSaatiRaw * 60);
                        int rH = rTotalDeq / 60; int rM = rTotalDeq % 60;

                        // Nahar parametrləri
                        TimeSpan naharBaslama = ViewBag.NaharBaslamaSaati ?? new TimeSpan(13, 0, 0);
                        int naharDeq = ViewBag.NaharMuddetDeqiqe ?? 45;
                        TimeSpan naharBitis = naharBaslama + TimeSpan.FromMinutes(naharDeq);

                        // Checkbox yalnız icazə nahar pəncərəsi ilə kəsişdikdə görünür
                        bool naharKesisir = Model.BaslamaSaati.HasValue && Model.BitisSaati.HasValue &&
                                            Model.BaslamaSaati.Value < naharBitis &&
                                            Model.BitisSaati.Value > naharBaslama;

                        if (naharKesisir)
                        {
                            decimal naharSaat = naharDeq / 60m;
                            decimal efektivSaat = Math.Max(0m, icazeSaatiRaw - naharSaat);
                            int eDeq = (int)Math.Round((double)efektivSaat * 60);
                            int eH = eDeq / 60; int eM = eDeq % 60;

                            <div style="margin:14px 0;padding:12px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px">
                                @if (Model.NaharNezereAlinmasin)
                                {
                                    <div style="font-size:12px;color:#92400e;background:#fef3c7;padding:7px 10px;border-radius:6px;margin-bottom:10px;font-weight:600">
                                        ⚠ İşçi müraciətdə <strong>nahara çıxmadığını</strong> qeyd edib — nahar icazəyə qatılıb.
                                    </div>
                                }
                                <label style="display:flex;align-items:flex-start;gap:8px;cursor:pointer;font-size:13px;color:#374151">
                                    <input type="checkbox" name="naharNezereAlinmasin" id="naharCheck" value="true"
                                           checked="@(Model.NaharNezereAlinmasin ? "checked" : null)"
                                           style="width:15px;height:15px;margin-top:2px;accent-color:#0369a1;flex-shrink:0" />
                                    <span>
                                        <strong>Naharı nəzərə alma</strong>
                                        <span style="color:#6b7280;font-size:11px;display:block;margin-top:1px">
                                            İşçi nahar fasiləsini götürməyib — @naharDeq dəq icazə müddətindən çıxılır
                                            (@naharBaslama.ToString(@"hh\:mm")–@naharBitis.ToString(@"hh\:mm"))
                                        </span>
                                        <span id="naharEfektiv" style="display:none;color:#0369a1;font-size:12px;font-weight:600;margin-top:3px">
                                            Effektiv icazə: @eH saat@(eM > 0 ? $" {eM} dəq" : "")
                                        </span>
                                    </span>
                                </label>
                            </div>
                        }

                        <div style="margin:14px 0;padding:12px;background:#fff8e8;border:1px solid #f0d785;border-radius:8px">
                            <div style="font-size:12px;color:#8a6a18;margin-bottom:6px">
                                <strong>İşçinin aktiv jeton balansı:</strong> @balans.ToString("0.##") saat<br />
                                <strong>İcazə müddəti:</strong>
                                <span id="icazeSaatDisplay">@rH saat@(rM > 0 ? $" {rM} dəq" : "")</span>
                            </div>
                            <label style="font-size:12px;color:#374151;display:block;margin-bottom:4px">
                                Jetonla ödənən saat
                                <small style="color:#8a93a8">(maks: <span id="maxJetonLabel">@maxJeton.ToString("0.##")</span>)</small>
                            </label>
                            <input type="number" name="jetonOdenenSaat" id="jetonInput" value="0"
                                   min="0" max="@maxJeton" step="0.25"
                                   style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px" />
                            <small style="color:#6b7280;font-size:11px;display:block;margin-top:4px">
                                0 = tam adi icazə. Bu rəqəm təsdiqləndikdən sonra HR tərəfindən jetonlardan tutulur.
                            </small>
                        </div>

                        <label style="display:flex;align-items:center;gap:8px;margin:6px 0 12px;font-size:13px;color:#374151;cursor:pointer">
                            <input type="checkbox" name="birdefelik" value="true"
                                   style="width:16px;height:16px;accent-color:#e8b84b" />
                            <span>
                                <strong>Birdəfəlik çıxış</strong>
                                <span style="color:#8a93a8;font-size:11px;display:block">İşçi qayıtmayacaq — faktiki müddət hesablanmayacaq</span>
                            </span>
                        </label>

                        <script>
                        (function(){
                            var rawSaat = @icazeSaatiRaw;
                            var naharSaat = @((naharDeq / 60.0m).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture));
                            var balans = @balans;
                            function fmtSaat(h){
                                var t = Math.round(h * 60);
                                var s = Math.floor(t/60), m = t%60;
                                return s + ' saat' + (m>0 ? ' '+m+' dəq':'');
                            }
                            var cb = document.getElementById('naharCheck');
                            var maxLabel = document.getElementById('maxJetonLabel');
                            var saatDisplay = document.getElementById('icazeSaatDisplay');
                            var efektiv = document.getElementById('naharEfektiv');
                            var inp = document.getElementById('jetonInput');
                            if (cb) {
                                cb.addEventListener('change', function(){
                                    var eff = cb.checked ? Math.max(0, rawSaat - naharSaat) : rawSaat;
                                    var maxJ = Math.min(balans, eff);
                                    maxLabel.textContent = maxJ % 1 === 0 ? maxJ.toFixed(0) : maxJ.toFixed(2);
                                    inp.max = maxJ;
                                    if (parseFloat(inp.value) > maxJ) inp.value = maxJ;
                                    saatDisplay.textContent = fmtSaat(eff);
                                    if (efektiv) {
                                        efektiv.textContent = 'Effektiv icazə: ' + fmtSaat(eff);
                                        efektiv.style.display = cb.checked ? 'block' : 'none';
                                    }
                                });
                            }
                        })();
                        </script>
                    }

                    @if (rol == "Hr")
                    {
                        decimal jetonOdenis = ViewBag.JetonOdenenSaat != null ? (decimal)ViewBag.JetonOdenenSaat : 0m;
                        if (jetonOdenis > 0)
                        {
                            <div style="margin:10px 0;padding:10px;background:#f0faf5;border:1px solid #a7e3c5;border-radius:8px;font-size:12px;color:#1e9b6b">
                                Rəhbər <strong>@jetonOdenis.ToString("0.##") saat</strong> jetonla ödənmə qeyd etdi. Təsdiqləndikdə bu qədər jeton işçidən FIFO ilə tutulacaq.
                            </div>
                        }
                        <label style="display:flex;align-items:center;gap:8px;margin:10px 0;font-size:13px;color:#374151;cursor:pointer">
                            <input type="checkbox" name="birdefelik" value="true"
                                   style="width:16px;height:16px;accent-color:#e8b84b" />
                            <span>
                                <strong>Birdefelik çıxış</strong>
                                <span style="color:#8a93a8;font-size:11px;display:block">İşçi qayıtmayacaq — faktiki müddət hesablanmayacaq</span>
                            </span>
                        </label>
                    }

                    <div class="tsd-approve-btns">
                        <button type="button" class="tsd-btn tsd-btn--approve"
                                data-tesdiq-approve="tsdForm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 6.5l3.5 3.5 5.5-6.5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Təsdiqlə
                        </button>
                        <button type="button" class="tsd-btn tsd-btn--reject"
                                data-tesdiq-reject="tsdForm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2.5 2.5l8 8M10.5 2.5l-8 8" stroke="#fff" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            Rədd et
                        </button>
                    </div>
                </form>
            </div>
            }
            else if (Model.Status == (int)IcazeStatus.Tesdiqlenib)
            {
                <div class="tsd-approve-panel" style="background:#f0faf5;border-color:#a7e3c5">
                    <div style="display:flex;align-items:center;gap:10px;color:#1e9b6b;font-weight:600">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <circle cx="10" cy="10" r="9" stroke="#1e9b6b" stroke-width="1.5"/>
                            <path d="M6 10l2.5 2.5 5.5-5.5" stroke="#1e9b6b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        İcazə tam təsdiqlənib
                    </div>
                </div>
            }
            else if (Model.Status == (int)IcazeStatus.ImtinaEdildi)
            {
                <div class="tsd-approve-panel" style="background:#fff5f5;border-color:#fca5a5">
                    <div style="display:flex;align-items:center;gap:10px;color:#c0392b;font-weight:600">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <circle cx="10" cy="10" r="9" stroke="#c0392b" stroke-width="1.5"/>
                            <path d="M7 7l6 6M13 7l-6 6" stroke="#c0392b" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        İmtina edilib
                    </div>
                </div>
            }
            else
            {
                <div class="tsd-approve-panel" style="background:#fffbeb;border-color:#fcd34d">
                    <div style="display:flex;align-items:center;gap:10px;color:#92400e;font-weight:600">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <circle cx="10" cy="10" r="9" stroke="#d97706" stroke-width="1.5"/>
                            <path d="M10 6v5M10 13v.5" stroke="#d97706" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                        Digər mərhələnin təsdiqi gözlənilir
                    </div>
                </div>
            }
        </div>

    </div>
</div>

@* Confirm Modal *@
<div class="tsd-modal-overlay" id="tsd-confirm-overlay">
    <div class="tsd-modal">
        <div class="tsd-modal-icon tsd-modal-icon--approve" id="tsd-modal-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12l5 5 9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div class="tsd-modal-title" id="tsd-modal-title">Təsdiqlə</div>
        <div class="tsd-modal-sub" id="tsd-modal-sub">Əminsiniz?</div>
        <div class="tsd-modal-footer">
            <button class="tsd-btn tsd-btn--ghost" id="tsd-modal-cancel">Ləğv et</button>
            <button class="tsd-btn tsd-btn--approve" id="tsd-modal-confirm">Bəli</button>
        </div>
        <input type="hidden" id="tsd-modal-status" />
    </div>
</div>

@section Scripts {
    <script src="~/js/User/tesdiq.js" asp-append-version="true"></script>
}
