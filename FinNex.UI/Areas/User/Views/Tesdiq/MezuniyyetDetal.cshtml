@model FinNex.UI.Areas.User.ViewModels.Tesdiq.TesdiqDetalVM
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Məzuniyyət Detalı";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var rol = ViewBag.Rol as string ?? "SobeReisi";

    string backAction = rol;
    string backLabel = rol switch {
        "SobeReisi" => "Şöbə Rəhbəri Paneli",
        "Rehber"    => "Rəhbər Paneli",
        "Hr"        => "HR Paneli",
        _           => "Panel"
    };

    static string OverlapStatusText(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Tesdiqlenib => "Təsdiqlənib",
        MezuniyyetStatus.SobeReisiTesdiqinde => "Şöbə rəisi təsdiqində",
        MezuniyyetStatus.RehberTesdiqinde => "Rəhbər təsdiqində",
        MezuniyyetStatus.HrTesdiqinde => "HR təsdiqində",
        _ => s.ToString()
    };

    static string OverlapNovText(MezuniyyetNovu n) => n switch
    {
        MezuniyyetNovu.Xestelik => "Xəstəlik",
        MezuniyyetNovu.Ezamiyyet => "Ezamiyyət",
        MezuniyyetNovu.Illik => "İllik",
        _ => n.ToString()
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/tesdiq.css" asp-append-version="true" />
}

<div class="fn-page">

    @* ── Back link ── *@
    <div style="margin-bottom:16px">
        <a asp-area="User" asp-controller="Tesdiq" asp-action="@backAction"
           class="tsd-btn tsd-btn--ghost" style="width:fit-content">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M8 2L4 6.5 8 11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            @backLabel-ə qayıt
        </a>
    </div>

    @* ── Əvəzedici konflikti (soft-warn) ── *@
    @if (Model.EvezediciKonfliktleri.Any())
    {
        <div style="margin-bottom:14px;padding:12px 14px;background:#fffbea;border:1px solid #fde68a;border-left:4px solid #f59e0b;border-radius:8px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
                <span style="font-size:16px;">⚠</span>
                <div style="font-size:13px;font-weight:700;color:#b45309;">Əvəzedici konflikti</div>
            </div>
            <div style="font-size:12px;color:#7a5a10;margin-bottom:8px;">
                Bu işçi həmin tarix aralığında başqa müraciətlərdə <b>qəbul edilmiş əvəzedici</b>
                kimi seçilib. Təsdiq mərhələsində nəzərə alın.
            </div>
            <ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:5px;">
                @foreach (var k in Model.EvezediciKonfliktleri)
                {
                    <li style="padding:6px 10px;background:#fef3c7;border-radius:5px;font-size:12px;color:#7a5a10;">
                        <b>@k.MuracietEdenIsciAdSoyad</b> üçün
                        @k.BaslamaTarixi.ToString("dd.MM.yyyy") – @k.BitmeTarixi.ToString("dd.MM.yyyy")
                    </li>
                }
            </ul>
        </div>
    }

    @* ── Bu dövrdə həmkarları ── *@
    @if (Model.OverlapMezuniyyetler.Any())
    {
        <div style="margin-bottom:14px;padding:12px 14px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;">
            <div style="font-size:13px;font-weight:700;color:#1a2332;margin-bottom:4px;">
                Eyni dövrdə məzuniyyətdə olan/olacaq həmkarları (@Model.OverlapMezuniyyetler.Count)
            </div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:10px;">
                Paralel məzuniyyətlər şöbə iş yükünə təsir edə bilər.
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;">
                @foreach (var o in Model.OverlapMezuniyyetler)
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 10px;background:#fff;border:1px solid #e5e7eb;border-radius:6px;">
                        <div>
                            <div style="font-size:12.5px;font-weight:600;color:#1a2332;">
                                @o.IsciAdSoyad
                                @if (o.EyniSobe)
                                {
                                    <span style="margin-left:6px;font-size:10px;padding:2px 6px;border-radius:10px;background:#fee2e2;color:#b91c1c;font-weight:600;">Eyni şöbə</span>
                                }
                            </div>
                            <div style="font-size:11px;color:#6b7280;margin-top:2px;">
                                @o.SobeAdi · @OverlapNovText(o.Nov) · @o.IsGunlerininSayi gün
                            </div>
                        </div>
                        <div style="font-size:11.5px;color:#1a2332;text-align:right;">
                            @o.BaslamaTarixi.ToString("dd.MM") – @o.BitmeTarixi.ToString("dd.MM.yyyy")<br/>
                            <span style="font-size:10.5px;color:#6b7280;">@OverlapStatusText(o.Status)</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="tsd-detal-grid">

        @* ── Left: Info ── *@
        <div>
            @* Employee Info *@
            <div class="tsd-info-card">
                <div class="tsd-info-card-title">İşçi Məlumatları</div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Ad Soyad</span>
                    <span class="tsd-info-val">@Model.IsciAdSoyad</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Şöbə</span>
                    <span class="tsd-info-val">@Model.SobeAdi</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Vəzifə</span>
                    <span class="tsd-info-val">@Model.VezifeAdi</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.EvezEdenIsciAdSoyad))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">Əvəzedici</span>
                        <span class="tsd-info-val">@Model.EvezEdenIsciAdSoyad</span>
                    </div>
                }
            </div>

            @* Request Info *@
            <div class="tsd-info-card">
                <div class="tsd-info-card-title">Məzuniyyət Məlumatları</div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Növ</span>
                    <span class="tsd-info-val">@Model.NovText</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Başlama tarixi</span>
                    <span class="tsd-info-val">@Model.BaslamaTarixi?.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Bitmə tarixi</span>
                    <span class="tsd-info-val">@Model.BitmeTarixi?.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">İş günlərinin sayı</span>
                    <span class="tsd-info-val" style="font-weight:700;color:#1a2332">@Model.IsGunlerininSayi gün</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Qeyd))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">Qeyd</span>
                        <span class="tsd-info-val">@Model.Qeyd</span>
                    </div>
                }
                <div class="tsd-info-row">
                    <span class="tsd-info-lbl">Status</span>
                    <span class="tsd-info-val">
                        <span class="tsd-badge tsd-badge--wait">@Model.StatusText</span>
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Model.EmrNomresi))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">Əmr nömrəsi</span>
                        <span class="tsd-info-val" style="font-family:monospace;font-weight:700;color:#1e40af">
                            📄 @Model.EmrNomresi
                            @if (Model.EmrIl.HasValue) { <span style="color:#94a3b8;font-weight:500">· @Model.EmrIl</span> }
                        </span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ImtinaSebebi))
                {
                    <div class="tsd-info-row">
                        <span class="tsd-info-lbl">İmtina səbəbi</span>
                        <span class="tsd-info-val" style="color:#c0392b">@Model.ImtinaSebebi</span>
                    </div>
                }
            </div>
        </div>

        @* ── Right: Workflow + Approval ── *@
        <div>
            @* Workflow Tracker *@
            <div class="tsd-workflow">
                <div class="tsd-workflow-title">Təsdiq Axını</div>
                <div class="tsd-wf-steps">

                    @* Step 0: Müraciət *@
                    <div class="tsd-wf-step done">
                        <div class="tsd-wf-dot">
                            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Müraciət göndərildi</div>
                            <div class="tsd-wf-result tsd-wf-result--ok">Göndərildi</div>
                        </div>
                    </div>

                    @* Step 1: SobeReisi — yalnız bu addımdan keçibsə göstər *@
                    @{
                        bool sobeReisiAddimi = Model.SobeReisiTesdiq.HasValue
                            || Model.Status == (int)FinNex.Domain.Entities.HR.MezuniyyetStatus.SobeReisiTesdiqinde;
                    }
                    @if (sobeReisiAddimi)
                    {
                        var s1Class = Model.SobeReisiTesdiq == true ? "done" : Model.SobeReisiTesdiq == false ? "rejected" : "active";
                    <div class="tsd-wf-step @s1Class">
                        <div class="tsd-wf-dot">
                            @if (Model.SobeReisiTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else if (Model.SobeReisiTesdiq == false)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                            else { <text>1</text> }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Şöbə Rəhbəri Təsdiqi</div>
                            @if (Model.SobeReisiTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.SobeReisiTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.SobeReisiTesdiq == true)
                            {
                                <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div>
                            }
                            else if (Model.SobeReisiTesdiq == false)
                            {
                                <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div>
                            }
                            else
                            {
                                <div class="tsd-wf-result tsd-wf-result--wait">Gözləyir</div>
                            }
                        </div>
                    </div>
                    }

                    @* Step 2: Rehber — yalnız bu addımdan keçibsə göstər *@
                    @{
                        bool rehberAddimi = Model.RehberTesdiq.HasValue
                            || Model.Status == (int)MezuniyyetStatus.RehberTesdiqinde
                            || Model.Status < (int)MezuniyyetStatus.HrTesdiqinde;
                        if ((Model.Status == (int)MezuniyyetStatus.HrTesdiqinde
                             || Model.Status == (int)MezuniyyetStatus.Tesdiqlenib)
                            && !Model.RehberTesdiq.HasValue)
                        {
                            rehberAddimi = false;
                        }
                    }
                    @if (rehberAddimi)
                    {
                        var s2Class = Model.RehberTesdiq == true ? "done"
                            : Model.RehberTesdiq == false ? "rejected"
                            : (Model.SobeReisiTesdiq == true || !sobeReisiAddimi) ? "active" : "";
                    <div class="tsd-wf-step @s2Class">
                        <div class="tsd-wf-dot">
                            @if (Model.RehberTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else if (Model.RehberTesdiq == false)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                            else { <text>@(sobeReisiAddimi ? "2" : "1")</text> }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">Rəhbər Təsdiqi</div>
                            @if (Model.RehberTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.RehberTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.RehberTesdiq == true)
                            {
                                <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div>
                            }
                            else if (Model.RehberTesdiq == false)
                            {
                                <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div>
                            }
                            else
                            {
                                <div class="tsd-wf-result tsd-wf-result--wait">Gözləyir</div>
                            }
                        </div>
                    </div>
                    }

                    @* Step 3: HR — yalnız bu addımdan keçibsə göstər *@
                    @{
                        bool hrAddimi = Model.HrTesdiq.HasValue
                            || Model.Status == (int)MezuniyyetStatus.HrTesdiqinde
                            || Model.Status < (int)MezuniyyetStatus.HrTesdiqinde;
                        if (Model.Status == (int)MezuniyyetStatus.Tesdiqlenib && !Model.HrTesdiq.HasValue)
                        {
                            hrAddimi = false;
                        }

                        int hrNo = 1;
                        if (sobeReisiAddimi) hrNo++;
                        if (rehberAddimi) hrNo++;
                    }
                    @if (hrAddimi)
                    {
                        var s3Class = Model.HrTesdiq == true ? "done"
                            : Model.HrTesdiq == false ? "rejected"
                            : (Model.RehberTesdiq == true || !rehberAddimi) ? "active" : "";
                    <div class="tsd-wf-step @s3Class">
                        <div class="tsd-wf-dot">
                            @if (Model.HrTesdiq == true)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M2.5 6l2.5 2.5 4.5-5" stroke="#fff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            }
                            else if (Model.HrTesdiq == false)
                            {
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                    <path d="M3 3l6 6M9 3l-6 6" stroke="#fff" stroke-width="1.3" stroke-linecap="round" />
                                </svg>
                            }
                            else { <text>@hrNo</text> }
                        </div>
                        <div class="tsd-wf-info">
                            <div class="tsd-wf-role">HR Təsdiqi</div>
                            @if (Model.HrTesdiqTarixi.HasValue)
                            {
                                <div class="tsd-wf-date">@Model.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm")</div>
                            }
                            @if (Model.HrTesdiq == true)
                            {
                                <div class="tsd-wf-result tsd-wf-result--ok">Təsdiqləndi</div>
                            }
                            else if (Model.HrTesdiq == false)
                            {
                                <div class="tsd-wf-result tsd-wf-result--reject">Rədd edildi</div>
                            }
                            else
                            {
                                <div class="tsd-wf-result tsd-wf-result--wait">Gözləyir</div>
                            }
                        </div>
                    </div>
                    }

                </div>
            </div>

            @* Approval Panel *@
            <div class="tsd-approve-panel">
                <div class="tsd-approve-title">Qərar Ver</div>

                <form asp-area="User" asp-controller="Tesdiq" asp-action="MezuniyyetTesdiq"
                      method="post" id="tsdForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="rol" value="@rol" />
                    <input type="hidden" name="status" id="formStatus" value="true" />

                    @* HR üçün gün sayı manual düzəliş bloğu *@
                    @if (rol == "Hr" && Model.IsMezuniyyet)
                    {
                        <div style="margin-bottom:14px;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
                                <label style="font-size:12px;color:#475569;font-weight:600">Gün sayı</label>
                                <label style="font-size:11px;color:#64748b;display:flex;align-items:center;gap:5px;cursor:pointer">
                                    <input type="checkbox" id="tsd-gun-override" style="cursor:pointer" />
                                    Düzəliş et
                                </label>
                            </div>
                            <div style="font-size:11.5px;color:#64748b;margin-bottom:8px">
                                Avtomatik hesablanmış: <strong style="color:#0f172a">@Model.IsGunlerininSayi gün</strong>
                                <span style="color:#94a3b8;margin-left:6px">(həftəsonu sayılır, hesablanmayan bayramlar skip)</span>
                            </div>
                            <div id="tsd-gun-override-box" style="display:none">
                                <input type="number" name="gunSayiManual" id="tsd-gun-manual" min="0" max="365"
                                       value="@Model.IsGunlerininSayi" placeholder="Faktiki gün sayı"
                                       style="width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;margin-bottom:6px" />
                                <input type="text" name="duzelisSebebi" placeholder="Düzəlişin səbəbi (məs. Qurban bayramı 1 gün)"
                                       style="width:100%;padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:12px" />
                            </div>
                        </div>
                    }

                    <label style="font-size:12px;color:#8a93a8;display:block;margin-bottom:6px">İmtina səbəbi (ixtiyari)</label>
                    <textarea name="qeyd" class="tsd-approve-reason"
                              placeholder="İmtina etdikdə səbəbi qeyd edin..."></textarea>

                    <div class="tsd-approve-btns">
                        <button type="button" class="tsd-btn tsd-btn--approve"
                                data-tesdiq-approve="tsdForm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 6.5l3.5 3.5 5.5-6.5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Təsdiqlə
                        </button>
                        <button type="button" class="tsd-btn tsd-btn--reject"
                                data-tesdiq-reject="tsdForm">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2.5 2.5l8 8M10.5 2.5l-8 8" stroke="#fff" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                            Rədd et
                        </button>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@* Confirm Modal *@
<div class="tsd-modal-overlay" id="tsd-confirm-overlay">
    <div class="tsd-modal">
        <div class="tsd-modal-icon tsd-modal-icon--approve" id="tsd-modal-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M5 12l5 5 9-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <div class="tsd-modal-title" id="tsd-modal-title">Təsdiqlə</div>
        <div class="tsd-modal-sub" id="tsd-modal-sub">Əminsiniz?</div>
        <div class="tsd-modal-footer">
            <button class="tsd-btn tsd-btn--ghost" id="tsd-modal-cancel">Ləğv et</button>
            <button class="tsd-btn tsd-btn--approve" id="tsd-modal-confirm">Bəli</button>
        </div>
        <input type="hidden" id="tsd-modal-status" />
    </div>
</div>

@section Scripts {
    <script src="~/js/User/tesdiq.js" asp-append-version="true"></script>
    <script>
        (function () {
            var cb = document.getElementById('tsd-gun-override');
            var box = document.getElementById('tsd-gun-override-box');
            if (!cb || !box) return;
            var inputs = box.querySelectorAll('input');
            // Default: checkbox yox, input-lar disabled (submit olunmur)
            inputs.forEach(function (i) { i.disabled = true; });
            cb.addEventListener('change', function () {
                box.style.display = cb.checked ? '' : 'none';
                inputs.forEach(function (i) { i.disabled = !cb.checked; });
                if (cb.checked) box.querySelector('input[type="number"]').focus();
            });
        })();
    </script>
}
