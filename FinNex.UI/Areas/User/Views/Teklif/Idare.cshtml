@using FinNex.Domain.Entities.HR
@model List<Teklif>
@{
    ViewData["Title"] = "Təkliflər İdarəsi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    int? filterStatus = ViewBag.FilterStatus as int?;
    int? filterNov    = ViewBag.FilterNov    as int?;

    static string NovLabel(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => "Boşluq",
        TeklifNov.Sikayat         => "Şikayət",
        _                         => "Teklif"
    };
    static string NovIcon(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => "bi-exclamation-triangle-fill",
        TeklifNov.Sikayat         => "bi-megaphone-fill",
        _                         => "bi-lightbulb-fill"
    };
    static string NovColor(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => "#f59e0b",
        TeklifNov.Sikayat         => "#ef4444",
        _                         => "#6366f1"
    };
    static string StatusLabel(TeklifStatus s) => s switch
    {
        TeklifStatus.Baxilir    => "Baxılır",
        TeklifStatus.Tamamlandi => "Tamamlandı",
        TeklifStatus.ReddEdildi => "Rədd edildi",
        _                       => "Gözlənilir"
    };
    static string StatusCls(TeklifStatus s) => s switch
    {
        TeklifStatus.Baxilir    => "ti-s-baxilir",
        TeklifStatus.Tamamlandi => "ti-s-tam",
        TeklifStatus.ReddEdildi => "ti-s-redd",
        _                       => "ti-s-goz"
    };
    static string PrioritetLabel(TeklifPrioritet p) => p switch
    {
        TeklifPrioritet.Yuksek => "Yüksək",
        TeklifPrioritet.Asagi  => "Aşağı",
        _                      => "Orta"
    };
    static string PrioritetCls(TeklifPrioritet p) => p switch
    {
        TeklifPrioritet.Yuksek => "ti-p-y",
        TeklifPrioritet.Asagi  => "ti-p-a",
        _                      => "ti-p-o"
    };
}

<!-- Başlıq -->
<div class="ti-header">
    <h4 class="ti-title"><i class="bi bi-lightbulb-fill me-2"></i>Təkliflər İdarəsi</h4>
</div>

@if (TempData["Success"] != null)
{
    <div class="ti-alert ti-alert-ok"><i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="ti-alert ti-alert-err"><i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]</div>
}

<!-- Filter + stat -->
<div class="ti-toolbar">
    <!-- Status filterlər -->
    <div class="ti-filter-group">
        <a href="@Url.Action("Idare")"
           class="ti-filter-btn @(filterStatus == null && filterNov == null ? "active" : "")">
            Hamısı <span class="ti-cnt">@Model.Count</span>
        </a>
        <a href="@Url.Action("Idare", new { status = 0 })"
           class="ti-filter-btn @(filterStatus == 0 ? "active" : "")">
            ⏳ Gözlənilir
            <span class="ti-cnt">@Model.Count(x => x.Status == TeklifStatus.Gozlemede)</span>
        </a>
        <a href="@Url.Action("Idare", new { status = 1 })"
           class="ti-filter-btn @(filterStatus == 1 ? "active" : "")">
            👁 Baxılır
            <span class="ti-cnt">@Model.Count(x => x.Status == TeklifStatus.Baxilir)</span>
        </a>
        <a href="@Url.Action("Idare", new { status = 2 })"
           class="ti-filter-btn @(filterStatus == 2 ? "active" : "")">
            ✅ Tamamlandı
            <span class="ti-cnt">@Model.Count(x => x.Status == TeklifStatus.Tamamlandi)</span>
        </a>
        <a href="@Url.Action("Idare", new { status = 3 })"
           class="ti-filter-btn @(filterStatus == 3 ? "active" : "")">
            ❌ Rədd edildi
            <span class="ti-cnt">@Model.Count(x => x.Status == TeklifStatus.ReddEdildi)</span>
        </a>
    </div>
    <!-- Növ filterlər -->
    <div class="ti-filter-group ms-auto">
        <a href="@Url.Action("Idare", new { nov = 0, status = filterStatus })"
           class="ti-filter-btn ti-nov-teklif @(filterNov == 0 ? "active" : "")">
            <i class="bi bi-lightbulb-fill"></i> Teklif
        </a>
        <a href="@Url.Action("Idare", new { nov = 1, status = filterStatus })"
           class="ti-filter-btn ti-nov-bosluq @(filterNov == 1 ? "active" : "")">
            <i class="bi bi-exclamation-triangle-fill"></i> Boşluq
        </a>
        <a href="@Url.Action("Idare", new { nov = 2, status = filterStatus })"
           class="ti-filter-btn ti-nov-sikayat @(filterNov == 2 ? "active" : "")">
            <i class="bi bi-megaphone-fill"></i> Şikayət
        </a>
    </div>
</div>

<!-- Cədvəl -->
<div class="ti-table-wrap">
    @if (!Model.Any())
    {
        <div class="ti-empty">
            <i class="bi bi-inbox ti-empty-icon"></i>
            <div>Filterlərə uyğun qeyd tapılmadı.</div>
        </div>
    }
    else
    {
        <table class="ti-table">
            <thead>
                <tr>
                    <th style="width:36px">#</th>
                    <th>İşçi</th>
                    <th style="width:90px">Növ</th>
                    <th>Başlıq</th>
                    <th style="width:95px">Tarix</th>
                    <th style="width:80px">Prioritet</th>
                    <th style="width:110px">Status</th>
                    <th style="width:36px"></th>
                </tr>
            </thead>
            <tbody>
                @{int sira = 0;}
                @foreach (var item in Model)
                {
                    sira++;
                    <tr class="ti-row @(!string.IsNullOrWhiteSpace(item.Cavab) ? "ti-row-cavabli" : "")"
                        onclick="acModal(@item.Id)"
                        data-id="@item.Id"
                        data-bashliq="@item.Bashliq"
                        data-mezmun="@item.Mezmun"
                        data-isci="@(item.Isci?.TamAd ?? "")"
                        data-nov="@NovLabel(item.Nov)"
                        data-nov-icon="@NovIcon(item.Nov)"
                        data-nov-color="@NovColor(item.Nov)"
                        data-status="@((int)item.Status)"
                        data-prioritet="@((int)item.Prioritet)"
                        data-cavab="@(item.Cavab ?? "")"
                        data-cavab-tarix="@(item.CavabTarixi?.ToString("dd.MM.yyyy HH:mm") ?? "")"
                        data-cavab-veren="@(item.CavabVeren?.TamAd ?? "")"
                        data-tarix="@item.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")">

                        <td class="ti-sira">@sira</td>
                        <td>
                            <span class="ti-isci-ad">@(item.Isci?.TamAd ?? "—")</span>
                        </td>
                        <td>
                            <span class="ti-nov-badge" style="color:@NovColor(item.Nov)">
                                <i class="bi @NovIcon(item.Nov)"></i> @NovLabel(item.Nov)
                            </span>
                        </td>
                        <td>
                            <span class="ti-bashliq">@item.Bashliq</span>
                            @if (!string.IsNullOrWhiteSpace(item.Cavab))
                            {
                                <i class="bi bi-chat-left-text-fill ti-cavab-dot" title="Cavab verilmişdir"></i>
                            }
                        </td>
                        <td class="ti-date">@item.YaradilmaTarixi.ToString("dd.MM.yy HH:mm")</td>
                        <td>
                            <span class="ti-prioritet @PrioritetCls(item.Prioritet)">
                                @PrioritetLabel(item.Prioritet)
                            </span>
                        </td>
                        <td>
                            <span class="ti-status @StatusCls(item.Status)">
                                @StatusLabel(item.Status)
                            </span>
                        </td>
                        <td>
                            <button type="button" class="ti-bax-btn" onclick="event.stopPropagation();acModal(@item.Id)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ── Modal ──────────────────────────────────────────── -->
<div class="modal fade" id="teklifModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ti-modal">
            <div class="modal-header ti-modal-hdr" id="ti-modal-hdr">
                <div>
                    <div class="ti-modal-nov" id="ti-modal-nov"></div>
                    <div class="ti-modal-isci" id="ti-modal-isci"></div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="row g-0">
                    <!-- Sol: məzmun -->
                    <div class="col-md-7 ti-modal-left">
                        <div class="ti-modal-bashliq" id="ti-modal-bashliq"></div>
                        <div class="ti-modal-tarix" id="ti-modal-tarix"></div>
                        <div class="ti-modal-label">Məzmun</div>
                        <div class="ti-modal-mezmun" id="ti-modal-mezmun"></div>

                        <div id="ti-cavab-block" class="ti-modal-cavab-block" style="display:none">
                            <div class="ti-modal-label">
                                <i class="bi bi-chat-left-text-fill me-1"></i>Verilmiş cavab
                                <span id="ti-cavab-tarix" class="ti-cavab-meta"></span>
                            </div>
                            <div class="ti-modal-cavab" id="ti-cavab-text"></div>
                        </div>
                    </div>
                    <!-- Sağ: form -->
                    <div class="col-md-5 ti-modal-right">
                        <form method="post" asp-action="Saxla">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" id="ti-form-id" />

                            <div class="mb-3">
                                <label class="ti-lbl">Status</label>
                                <select name="status" id="ti-form-status" class="form-select ti-sel">
                                    <option value="0">⏳ Gözlənilir</option>
                                    <option value="1">👁 Baxılır</option>
                                    <option value="2">✅ Tamamlandı</option>
                                    <option value="3">❌ Rədd edildi</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="ti-lbl">Prioritet</label>
                                <select name="prioritet" id="ti-form-prioritet" class="form-select ti-sel">
                                    <option value="0">⬇ Aşağı</option>
                                    <option value="1">➡ Orta</option>
                                    <option value="2">⬆ Yüksək</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="ti-lbl">Cavab <span class="fw-normal text-muted small">(isteğe bağlı)</span></label>
                                <textarea name="cavab" id="ti-form-cavab"
                                          class="form-control ti-ta"
                                          placeholder="İşçiyə cavab yazın..." rows="5"></textarea>
                            </div>

                            <button type="submit" class="ti-save-btn w-100">
                                <i class="bi bi-save2-fill me-1"></i>Yadda saxla
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function acModal(id) {
    const row = document.querySelector(`tr[data-id="${id}"]`);
    if (!row) return;
    const d = row.dataset;

    document.getElementById('ti-form-id').value        = d.id;
    document.getElementById('ti-modal-bashliq').textContent = d.bashliq || '—';
    document.getElementById('ti-modal-mezmun').textContent  = d.mezmun  || '—';
    document.getElementById('ti-modal-isci').textContent    = d.isci    || '—';
    document.getElementById('ti-modal-tarix').textContent   = d.tarix   || '';
    document.getElementById('ti-form-status').value    = d.status;
    document.getElementById('ti-form-prioritet').value = d.prioritet;
    document.getElementById('ti-form-cavab').value     = d.cavab || '';

    // Nov
    const novEl = document.getElementById('ti-modal-nov');
    novEl.innerHTML = `<i class="bi ${d.novIcon} me-1"></i>${d.nov}`;
    novEl.style.color = d.novColor;

    // Header bg
    document.getElementById('ti-modal-hdr').style.background =
        `linear-gradient(135deg, ${d.novColor}cc, ${d.novColor})`;

    // Cavab
    const cb = document.getElementById('ti-cavab-block');
    if (d.cavab) {
        cb.style.display = '';
        document.getElementById('ti-cavab-text').textContent = d.cavab;
        document.getElementById('ti-cavab-tarix').textContent =
            d.cavabTarix ? '· ' + d.cavabTarix + (d.cavabVeren ? ' (' + d.cavabVeren + ')' : '') : '';
    } else {
        cb.style.display = 'none';
    }

    new bootstrap.Modal(document.getElementById('teklifModal')).show();
}
</script>
}

@section Styles {
<style>
/* ── Header ──────────────────────────────────────────── */
.ti-header { margin-bottom: 1rem; }
.ti-title { font-size: 1.1rem; font-weight: 800; color: #1e293b; margin: 0; }

/* ── Alert ───────────────────────────────────────────── */
.ti-alert { border-radius: 8px; padding: .65rem 1rem; font-size: .87rem; margin-bottom: .85rem; }
.ti-alert-ok  { background: #d1fae5; color: #065f46; }
.ti-alert-err { background: #fee2e2; color: #991b1b; }

/* ── Toolbar ─────────────────────────────────────────── */
.ti-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    align-items: center;
    margin-bottom: .9rem;
}
.ti-filter-group { display: flex; flex-wrap: wrap; gap: .3rem; }
.ti-filter-btn {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .77rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
    text-decoration: none;
    transition: background .12s, color .12s;
    border: 1.5px solid transparent;
}
.ti-filter-btn:hover { background: #e2e8f0; color: #1e293b; }
.ti-filter-btn.active { background: #1e293b; color: #fff; border-color: #1e293b; }
.ti-cnt {
    background: rgba(255,255,255,.25);
    border-radius: 20px;
    padding: 0 6px;
    font-size: .7rem;
}
.ti-filter-btn.active .ti-cnt { background: rgba(255,255,255,.2); }
.ti-nov-teklif.active  { background: #6366f1; border-color: #6366f1; color: #fff; }
.ti-nov-bosluq.active  { background: #f59e0b; border-color: #f59e0b; color: #fff; }
.ti-nov-sikayat.active { background: #ef4444; border-color: #ef4444; color: #fff; }

/* ── Table ───────────────────────────────────────────── */
.ti-table-wrap {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
    overflow: hidden;
}
.ti-table {
    width: 100%;
    border-collapse: collapse;
    font-size: .85rem;
}
.ti-table thead tr {
    background: #f8fafc;
    border-bottom: 2px solid #e2e8f0;
}
.ti-table th {
    padding: .7rem 1rem;
    font-size: .73rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #64748b;
    text-align: left;
    white-space: nowrap;
}
.ti-row {
    border-bottom: 1px solid #f1f5f9;
    cursor: pointer;
    transition: background .1s;
}
.ti-row:last-child { border-bottom: none; }
.ti-row:hover { background: #f8fafc; }
.ti-row-cavabli { background: #fafffe; }
.ti-table td { padding: .65rem 1rem; vertical-align: middle; }
.ti-sira { color: #cbd5e1; font-size: .75rem; font-weight: 600; }
.ti-isci-ad { font-weight: 700; color: #1e293b; font-size: .84rem; }
.ti-nov-badge {
    font-size: .76rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
}
.ti-bashliq {
    font-size: .84rem;
    color: #334155;
    font-weight: 500;
}
.ti-cavab-dot { color: #6366f1; font-size: .75rem; margin-left: .35rem; }
.ti-date { font-size: .75rem; color: #94a3b8; white-space: nowrap; }

.ti-prioritet {
    font-size: .72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    white-space: nowrap;
}
.ti-p-y { background: #fee2e2; color: #b91c1c; }
.ti-p-o { background: #fef9c3; color: #92400e; }
.ti-p-a { background: #f1f5f9; color: #64748b; }

.ti-status {
    font-size: .72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    white-space: nowrap;
}
.ti-s-goz    { background: #f1f5f9; color: #475569; }
.ti-s-baxilir { background: #dbeafe; color: #1e40af; }
.ti-s-tam    { background: #d1fae5; color: #065f46; }
.ti-s-redd   { background: #fee2e2; color: #991b1b; }

.ti-bax-btn {
    background: none;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    font-size: .9rem;
    padding: 3px 5px;
    border-radius: 4px;
    transition: color .12s, background .12s;
}
.ti-bax-btn:hover { color: #6366f1; background: #ede9fe; }

.ti-empty {
    text-align: center;
    padding: 3.5rem 1rem;
    color: #94a3b8;
    font-size: .88rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
}
.ti-empty-icon { font-size: 2.5rem; color: #cbd5e1; }

/* ── Modal ───────────────────────────────────────────── */
.ti-modal { border: none; border-radius: 14px; overflow: hidden; }
.ti-modal-hdr {
    padding: 1rem 1.25rem;
    border: none;
    transition: background .2s;
}
.ti-modal-nov {
    font-size: .78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #fff;
    margin-bottom: .2rem;
    opacity: .9;
}
.ti-modal-isci { font-size: 1rem; font-weight: 800; color: #fff; }
.ti-modal-left {
    padding: 1.2rem 1.3rem;
    border-right: 1px solid #f1f5f9;
}
.ti-modal-right { padding: 1.2rem 1.3rem; background: #f8fafc; }
.ti-modal-bashliq {
    font-size: 1rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: .2rem;
}
.ti-modal-tarix {
    font-size: .76rem;
    color: #94a3b8;
    margin-bottom: .9rem;
}
.ti-modal-label {
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: #94a3b8;
    margin-bottom: .4rem;
}
.ti-modal-mezmun {
    font-size: .85rem;
    color: #334155;
    line-height: 1.65;
    white-space: pre-wrap;
    background: #fff;
    border-radius: 8px;
    padding: .75rem;
    border: 1px solid #e2e8f0;
    margin-bottom: .75rem;
    min-height: 80px;
}
.ti-modal-cavab-block { margin-top: .5rem; }
.ti-modal-cavab {
    font-size: .84rem;
    color: #3b0764;
    line-height: 1.55;
    white-space: pre-wrap;
    background: #ede9fe;
    border-radius: 8px;
    padding: .7rem .9rem;
    margin-top: .35rem;
}
.ti-cavab-meta { font-size: .7rem; color: #7c3aed; font-weight: 400; }

.ti-lbl {
    font-size: .8rem;
    font-weight: 700;
    color: #374151;
    margin-bottom: .3rem;
    display: block;
}
.ti-sel, .ti-ta {
    border-radius: 8px;
    border-color: #e2e8f0;
    font-size: .84rem;
    background: #fff;
}
.ti-sel:focus, .ti-ta:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,.15);
}
.ti-ta { resize: vertical; }
.ti-save-btn {
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: .5rem;
    font-size: .86rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity .15s;
    width: 100%;
}
.ti-save-btn:hover { opacity: .88; }
</style>
}
