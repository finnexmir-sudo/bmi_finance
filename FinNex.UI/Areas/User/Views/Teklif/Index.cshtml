@using FinNex.Domain.Entities.HR
@model List<Teklif>
@{
    ViewData["Title"] = "Mənim Təkliflərim";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    static string NovLabel(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => "Boşluq Bildirişi",
        TeklifNov.Sikayat         => "Şikayət",
        _                         => "Teklif"
    };
    static string NovIcon(TeklifNov n) => n switch
    {
        TeklifNov.BosluqBildirisi => "bi-exclamation-triangle-fill",
        TeklifNov.Sikayat         => "bi-megaphone-fill",
        _                         => "bi-lightbulb-fill"
    };
    static string StatusLabel(TeklifStatus s) => s switch
    {
        TeklifStatus.Baxilir    => "Baxılır",
        TeklifStatus.Tamamlandi => "Tamamlandı",
        TeklifStatus.ReddEdildi => "Rədd edildi",
        _                       => "Gözlənilir"
    };
    static string StatusIcon(TeklifStatus s) => s switch
    {
        TeklifStatus.Baxilir    => "bi-eye-fill",
        TeklifStatus.Tamamlandi => "bi-check-circle-fill",
        TeklifStatus.ReddEdildi => "bi-x-circle-fill",
        _                       => "bi-hourglass-split"
    };
    static string PrioritetLabel(TeklifPrioritet p) => p switch
    {
        TeklifPrioritet.Yuksek => "Yüksək",
        TeklifPrioritet.Asagi  => "Aşağı",
        _                      => "Orta"
    };

    var gozlemede  = Model.Count(x => x.Status == TeklifStatus.Gozlemede);
    var baxilir    = Model.Count(x => x.Status == TeklifStatus.Baxilir);
    var cavablanib = Model.Count(x => x.Status is TeklifStatus.Tamamlandi or TeklifStatus.ReddEdildi);
}

<div class="tk-header">
    <div>
        <h4 class="tk-page-title">
            <i class="bi bi-lightbulb-fill me-2 text-primary"></i>Mənim Təkliflərim
        </h4>
        <div class="tk-stats">
            <span class="tk-stat"><b>@Model.Count</b> cəmi</span>
            @if (gozlemede > 0)
            {
                <span class="tk-stat tk-stat--wait"><i class="bi bi-hourglass-split me-1"></i><b>@gozlemede</b> gözlənilir</span>
            }
            @if (baxilir > 0)
            {
                <span class="tk-stat tk-stat--info"><i class="bi bi-eye me-1"></i><b>@baxilir</b> baxılır</span>
            }
            @if (cavablanib > 0)
            {
                <span class="tk-stat tk-stat--ok"><i class="bi bi-check-circle me-1"></i><b>@cavablanib</b> cavablanıb</span>
            }
        </div>
    </div>
    <button class="tk-btn-new" data-bs-toggle="modal" data-bs-target="#yaratModal">
        <i class="bi bi-plus-lg"></i> Yeni Teklif
    </button>
</div>

@if (!Model.Any())
{
    <div class="tk-empty">
        <div class="tk-empty-icon-wrap">
            <i class="bi bi-lightbulb"></i>
        </div>
        <div class="tk-empty-title">Hələ heç bir teklif yoxdur</div>
        <p class="tk-empty-sub">Bank üçün fikir, boşluq və ya şikayətinizi paylaşın.<br>Hər fikir dəyərlidir!</p>
        <button class="tk-btn-new mt-3" data-bs-toggle="modal" data-bs-target="#yaratModal">
            <i class="bi bi-plus-lg"></i> İlk Teklifinizi Yazın
        </button>
    </div>
}
else
{
    <div class="tk-list">
        @foreach (var item in Model)
        {
            var isTeklif   = item.Nov == TeklifNov.Teklif;
            var isBosluq   = item.Nov == TeklifNov.BosluqBildirisi;
            var isSikayat  = item.Nov == TeklifNov.Sikayat;
            var novKey     = isTeklif ? "teklif" : (isBosluq ? "bosluq" : "sikayat");
            var stKey      = item.Status switch {
                TeklifStatus.Baxilir    => "baxilir",
                TeklifStatus.Tamamlandi => "tamamlandi",
                TeklifStatus.ReddEdildi => "redd",
                _                       => "gozleme"
            };

            <div class="tk-card tk-card--@novKey">
                <!-- Colored top strip with type + status -->
                <div class="tk-card-strip">
                    <span class="tk-nov-pill">
                        <i class="bi @NovIcon(item.Nov)"></i>
                        @NovLabel(item.Nov)
                    </span>
                    <span class="tk-status-pill tk-status-pill--@stKey">
                        <i class="bi @StatusIcon(item.Status)"></i>
                        @StatusLabel(item.Status)
                    </span>
                </div>

                <!-- Body -->
                <div class="tk-card-body">
                    <div class="tk-card-title">@item.Bashliq</div>
                    <div class="tk-card-mezmun">@item.Mezmun</div>

                    <!-- Footer row -->
                    <div class="tk-card-foot">
                        <span class="tk-pr tk-pr--@(item.Prioritet.ToString().ToLower())">
                            <i class="bi bi-flag-fill"></i>
                            @PrioritetLabel(item.Prioritet)
                        </span>
                        <span class="tk-date">
                            <i class="bi bi-calendar3"></i>
                            @item.YaradilmaTarixi.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("az-Latn-AZ"))
                        </span>
                        @if (item.Status == TeklifStatus.Gozlemede)
                        {
                            <form method="post" asp-action="Legv" class="tk-legv-form ms-auto"
                                  onsubmit="return confirm('Bu teklifinizi silmək istədiyinizə əminsiniz?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="tk-btn-legv" title="Sil">
                                    <i class="bi bi-trash3"></i> Sil
                                </button>
                            </form>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(item.Cavab))
                    {
                        <div class="tk-cavab">
                            <div class="tk-cavab-head">
                                <i class="bi bi-chat-left-quote-fill"></i>
                                <span>Rəhbərlik cavabı</span>
                                @if (item.CavabTarixi.HasValue)
                                {
                                    <span class="tk-cavab-date">· @item.CavabTarixi.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                            </div>
                            <div class="tk-cavab-text">@item.Cavab</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<!-- Yeni Teklif Modal -->
<div class="modal fade" id="yaratModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content tk-modal">
            <div class="modal-header tk-modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-lightbulb-fill me-2"></i>Yeni Teklif / Müraciət
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Yarat">
                @Html.AntiForgeryToken()
                <div class="modal-body tk-modal-body">
                    <p class="tk-modal-hint">Növü seçin:</p>
                    <div class="tk-nov-grid">
                        <label class="tk-nov-opt">
                            <input type="radio" name="nov" value="0" checked />
                            <div class="tk-nov-card tk-nov-card--teklif">
                                <i class="bi bi-lightbulb-fill"></i>
                                <span>Teklif</span>
                                <small>Yeni fikir və ya yaxşılaşdırma</small>
                            </div>
                        </label>
                        <label class="tk-nov-opt">
                            <input type="radio" name="nov" value="1" />
                            <div class="tk-nov-card tk-nov-card--bosluq">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                                <span>Boşluq Bildirişi</span>
                                <small>Çatışmayan və ya problemli yer</small>
                            </div>
                        </label>
                        <label class="tk-nov-opt">
                            <input type="radio" name="nov" value="2" />
                            <div class="tk-nov-card tk-nov-card--sikayat">
                                <i class="bi bi-megaphone-fill"></i>
                                <span>Şikayət</span>
                                <small>Narazılıq, inciklik</small>
                            </div>
                        </label>
                    </div>

                    <div class="mb-3 mt-3">
                        <label class="form-label fw-semibold">Başlıq <span class="text-danger">*</span></label>
                        <input type="text" name="bashliq" class="form-control tk-input"
                               placeholder="Qısa, aydın başlıq yazın..." maxlength="200" required />
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Məzmun <span class="text-danger">*</span></label>
                        <textarea name="mezmun" class="form-control tk-input tk-textarea"
                                  placeholder="Ətraflı izah edin — nə baş verib, niyə vacibdir, necə həll etmək olar..." rows="5" required></textarea>
                    </div>
                </div>
                <div class="modal-footer tk-modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Ləğv et</button>
                    <button type="submit" class="tk-btn-submit">
                        <i class="bi bi-send-fill me-1"></i> Göndər
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
<style>
/* ── Page Header ──────────────────────────────────────── */
.tk-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    gap: .75rem;
}
.tk-page-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: #1e293b;
}
.tk-stats {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    margin-top: .4rem;
}
.tk-stat {
    font-size: .75rem;
    background: #f1f5f9;
    border-radius: 20px;
    padding: 3px 10px;
    color: #64748b;
    display: inline-flex;
    align-items: center;
    gap: .2rem;
}
.tk-stat--wait { background: #fef9c3; color: #92400e; }
.tk-stat--info { background: #dbeafe; color: #1e40af; }
.tk-stat--ok   { background: #dcfce7; color: #166534; }

/* ── New button ───────────────────────────────────────── */
.tk-btn-new {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: .55rem 1.2rem;
    font-size: .88rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    box-shadow: 0 2px 8px rgba(99,102,241,.35);
    transition: box-shadow .15s, transform .1s;
}
.tk-btn-new:hover { box-shadow: 0 4px 14px rgba(99,102,241,.45); transform: translateY(-1px); }

/* ── Empty state ──────────────────────────────────────── */
.tk-empty {
    text-align: center;
    padding: 5rem 1rem;
}
.tk-empty-icon-wrap {
    width: 72px; height: 72px;
    background: linear-gradient(135deg, #ede9fe, #ddd6fe);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 1.2rem;
    font-size: 1.9rem;
    color: #7c3aed;
}
.tk-empty-title { font-size: 1.05rem; font-weight: 700; color: #334155; }
.tk-empty-sub   { font-size: .85rem; color: #94a3b8; margin-top: .4rem; line-height: 1.6; }

/* ── Card list ────────────────────────────────────────── */
.tk-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.1rem;
}

/* ── Card ─────────────────────────────────────────────── */
.tk-card {
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
    transition: box-shadow .18s, transform .15s;
    display: flex;
    flex-direction: column;
}
.tk-card:hover {
    box-shadow: 0 6px 20px rgba(0,0,0,.12);
    transform: translateY(-2px);
}

/* Top color strip by type */
.tk-card-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .6rem .9rem;
    gap: .5rem;
}
.tk-card--teklif  .tk-card-strip { background: linear-gradient(90deg, #6366f1 0%, #818cf8 100%); }
.tk-card--bosluq  .tk-card-strip { background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%); }
.tk-card--sikayat .tk-card-strip { background: linear-gradient(90deg, #ef4444 0%, #f87171 100%); }

.tk-nov-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    color: #fff;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .01em;
}

/* Status pill */
.tk-status-pill {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    font-size: .72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
}
.tk-status-pill--gozleme   { background: rgba(255,255,255,.25); color: #fff; }
.tk-status-pill--baxilir   { background: rgba(255,255,255,.9); color: #1e40af; }
.tk-status-pill--tamamlandi { background: rgba(255,255,255,.9); color: #166534; }
.tk-status-pill--redd      { background: rgba(255,255,255,.9); color: #991b1b; }

/* Card body */
.tk-card-body {
    padding: 1rem 1.1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
}
.tk-card-title {
    font-size: .97rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: .4rem;
    line-height: 1.35;
}
.tk-card-mezmun {
    font-size: .84rem;
    color: #64748b;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    margin-bottom: .9rem;
}

/* Footer */
.tk-card-foot {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
    padding-top: .7rem;
    border-top: 1px solid #f1f5f9;
}
.tk-pr {
    font-size: .72rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 20px;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
}
.tk-pr--yuksek { background: #fee2e2; color: #b91c1c; }
.tk-pr--orta   { background: #fef9c3; color: #92400e; }
.tk-pr--asagi  { background: #f1f5f9; color: #64748b; }
.tk-date {
    font-size: .74rem;
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    margin-left: auto;
}
.tk-legv-form { margin: 0; }
.tk-btn-legv {
    background: none;
    border: 1px solid #fca5a5;
    color: #f87171;
    cursor: pointer;
    font-size: .75rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    transition: background .15s, color .15s;
}
.tk-btn-legv:hover { background: #fee2e2; color: #b91c1c; border-color: #fca5a5; }

/* Response block */
.tk-cavab {
    margin-top: .9rem;
    background: #f8fafc;
    border-radius: 10px;
    padding: .8rem 1rem;
    border-left: 3px solid #6366f1;
}
.tk-cavab-head {
    display: flex;
    align-items: center;
    gap: .35rem;
    font-size: .77rem;
    font-weight: 700;
    color: #6366f1;
    margin-bottom: .4rem;
}
.tk-cavab-date { font-weight: 400; color: #94a3b8; }
.tk-cavab-text { font-size: .84rem; color: #334155; line-height: 1.6; }

/* ── Modal ────────────────────────────────────────────── */
.tk-modal { border: none; border-radius: 16px; overflow: hidden; }
.tk-modal-header {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: #fff;
    border: none;
    padding: 1.1rem 1.4rem;
}
.tk-modal-body   { padding: 1.4rem; }
.tk-modal-footer { border: none; padding: .9rem 1.4rem; background: #f8fafc; }
.tk-modal-hint   { font-size: .82rem; color: #64748b; font-weight: 600; margin: 0 0 .7rem; text-transform: uppercase; letter-spacing: .05em; }

/* Type selector */
.tk-nov-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .7rem;
    margin-bottom: .5rem;
}
.tk-nov-opt input { display: none; }
.tk-nov-card {
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    padding: .8rem .5rem;
    text-align: center;
    cursor: pointer;
    transition: border-color .15s, background .15s, transform .1s;
}
.tk-nov-card:hover { transform: translateY(-1px); }
.tk-nov-card i {
    font-size: 1.5rem;
    display: block;
    margin-bottom: .35rem;
}
.tk-nov-card span  { font-size: .82rem; font-weight: 700; display: block; color: #1e293b; }
.tk-nov-card small { font-size: .72rem; color: #94a3b8; display: block; margin-top: .15rem; }

.tk-nov-card--teklif  i { color: #6366f1; }
.tk-nov-card--bosluq  i { color: #f59e0b; }
.tk-nov-card--sikayat i { color: #ef4444; }

.tk-nov-opt input:checked + .tk-nov-card--teklif  { border-color: #6366f1; background: #ede9fe; }
.tk-nov-opt input:checked + .tk-nov-card--bosluq  { border-color: #f59e0b; background: #fffbeb; }
.tk-nov-opt input:checked + .tk-nov-card--sikayat { border-color: #ef4444; background: #fef2f2; }

.tk-input {
    border-radius: 9px;
    border-color: #e2e8f0;
    font-size: .88rem;
}
.tk-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); outline: none; }
.tk-textarea { resize: vertical; min-height: 110px; }

.tk-btn-submit {
    background: linear-gradient(135deg, #6366f1, #4f46e5);
    color: #fff;
    border: none;
    border-radius: 9px;
    padding: .5rem 1.4rem;
    font-size: .88rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    box-shadow: 0 2px 8px rgba(99,102,241,.3);
    transition: box-shadow .15s;
}
.tk-btn-submit:hover { box-shadow: 0 4px 14px rgba(99,102,241,.45); }

@@media (max-width: 600px) {
    .tk-list { grid-template-columns: 1fr; }
    .tk-nov-grid { grid-template-columns: 1fr; }
}
</style>
}
