@model List<FinNex.Application.DTOs.HR.Icaze.IcazeDovriyyeDto>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "İcazə Dövriyyəsi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string StatusBadge(IcazeCixisGirisStatus s) => s switch
    {
        IcazeCixisGirisStatus.Gozlenir   => "fn-badge fn-badge--wait",
        IcazeCixisGirisStatus.Cixdi      => "fn-badge fn-badge--review",
        IcazeCixisGirisStatus.Tamamlandi => "fn-badge fn-badge--done",
        IcazeCixisGirisStatus.LegvEdildi => "fn-badge fn-badge--rejected",
        _                                 => "fn-badge"
    };
}

<style>
    .dov-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .dov-table thead th {
        padding: 11px 14px; text-align: left; font-weight: 600;
        color: #475569; background: #f8fafc; white-space: nowrap;
        border-bottom: 1px solid #e8ecf2;
    }
    .dov-table tbody td {
        padding: 10px 14px; color: #1a2332;
        border-bottom: 1px solid #f1f5f9; vertical-align: middle;
    }
    .dov-table tbody tr:last-child td { border-bottom: none; }
    .dov-table tbody tr:hover { background: #fafbfc; }
    .dov-table th:last-child, .dov-table td:last-child { text-align: right; }
</style>

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İcazə Dövriyyəsi</div>
            <div class="fn-page-sub">Təsdiqlənmiş icazələrin cihaz çıxış/qayıdış izlənməsi</div>
        </div>
    </div>

    @* ── Filtr ── *@
    <form method="get" asp-area="User" asp-controller="Icaze" asp-action="Dovriyye"
          class="fn-filter-bar" style="flex-wrap:wrap;gap:10px">

        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Başlanğıc</label>
            <input type="date" name="tarixFrom" value="@ViewBag.TarixFrom"
                   class="fn-select fn-select--sm" onchange="this.form.submit()" />
        </div>

        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Son tarix</label>
            <input type="date" name="tarixTo" value="@ViewBag.TarixTo"
                   class="fn-select fn-select--sm" onchange="this.form.submit()" />
        </div>

        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Şöbə</label>
            <select name="departamentId" class="fn-select fn-select--sm" onchange="this.form.submit()">
                @foreach (var dep in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Departamentler)
                {
                    <option value="@dep.Value"
                            selected="@(dep.Value == ViewBag.DepartamentId?.ToString())">
                        @dep.Text
                    </option>
                }
            </select>
        </div>

        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Axtarış</label>
            <input type="text" name="axtaris" value="@ViewBag.Axtaris"
                   placeholder="Ad Soyad..." class="fn-select fn-select--sm"
                   style="min-width:160px" />
        </div>

        <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">Axtar</button>

        @if (ViewBag.TarixFrom != null || ViewBag.TarixTo != null ||
             ViewBag.DepartamentId != null || !string.IsNullOrEmpty(ViewBag.Axtaris as string))
        {
            <a asp-area="User" asp-controller="Icaze" asp-action="Dovriyye"
               class="fn-btn fn-btn--outline fn-btn--sm">Sıfırla</a>
        }
    </form>

    @* ── Xülasə kartları ── *@
    @{
        var hamisi    = Model.Count;
        var gozlenir  = Model.Count(x => x.CixisStatus == IcazeCixisGirisStatus.Gozlenir);
        var cixdi     = Model.Count(x => x.CixisStatus == IcazeCixisGirisStatus.Cixdi);
        var tamamlandi = Model.Count(x => x.CixisStatus == IcazeCixisGirisStatus.Tamamlandi);
    }
    <div class="fn-stat-row" style="margin-bottom:16px">
        <div class="fn-stat">
            <div class="fn-stat-val">@hamisi</div>
            <div class="fn-stat-lbl">Cəmi</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#c9900a">@gozlenir</div>
            <div class="fn-stat-lbl">Gözlənir</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#2d6cdf">@cixdi</div>
            <div class="fn-stat-lbl">İşdən kənarda</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#1e9b6b">@tamamlandi</div>
            <div class="fn-stat-lbl">Tamamlandı</div>
        </div>
    </div>

    @* ── Cədvəl ── *@
    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-icon">
                <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                    <rect x="7" y="8" width="30" height="28" rx="4" stroke="#dde1ea" stroke-width="2" />
                    <path d="M7 15h30M15 8v6M29 8v6M15 22h14M15 28h10" stroke="#dde1ea" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-empty-title">Dövriyyə qeydi tapılmadı</div>
        </div>
    }
    else
    {
        <div class="fn-card" style="padding:0;overflow-x:auto">
            <table class="dov-table">
                <thead>
                    <tr>
                        <th>İşçi</th>
                        <th>Şöbə</th>
                        <th>İcazə tarixi</th>
                        <th>Planlaşdırılan</th>
                        <th>Çıxış vaxtı</th>
                        <th>Qayıdış vaxtı</th>
                        <th>Faktiki saat</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight:600;color:#1a2332">@item.IsciAdSoyad</td>
                            <td style="color:#6b7280">@item.SobeAdi</td>
                            <td>@item.IcazeTarixi.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span style="color:#374151">
                                    @item.BaslamaSaati.ToString(@"hh\:mm")–@item.BitisSaati.ToString(@"hh\:mm")
                                </span>
                                <span style="color:#8a93a8;font-size:11px;margin-left:4px">
                                    (@item.PlanlananSaat.ToString("0.#") saat)
                                </span>
                                @if (item.Birdefelik)
                                {
                                    <span style="margin-left:4px;padding:1px 6px;border-radius:8px;background:#fef3c7;color:#92400e;font-size:10px;font-weight:600">1-dəfəlik</span>
                                }
                            </td>
                            <td>
                                @if (item.CixisVaxt.HasValue)
                                {
                                    <span style="color:#1a2332;font-weight:500">@item.CixisVaxt.Value.ToString("HH:mm")</span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1">—</span>
                                }
                            </td>
                            <td>
                                @if (item.QayidisVaxt.HasValue)
                                {
                                    <span style="color:#1a2332;font-weight:500">@item.QayidisVaxt.Value.ToString("HH:mm")</span>
                                }
                                else if (item.Birdefelik)
                                {
                                    <span style="color:#8a93a8;font-size:11px">1-dəfəlik</span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1">—</span>
                                }
                            </td>
                            <td>
                                @if (item.FaktikiSaat.HasValue)
                                {
                                    var fark = item.FaktikiSaat.Value - item.PlanlananSaat;
                                    var farkColor = Math.Abs(fark) < 0.25 ? "#1e9b6b" : fark > 0 ? "#c0392b" : "#2d6cdf";
                                    <span style="font-weight:600;color:@farkColor">
                                        @item.FaktikiSaat.Value.ToString("0.##") saat
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#cbd5e1">—</span>
                                }
                            </td>
                            <td>
                                <span class="@StatusBadge(item.CixisStatus)">@item.CixisStatusText</span>
                                @if (item.CixisQayidisAnomaliya)
                                {
                                    <span title="Cihaz çıxış/qayıdışı icazə pəncərəsinə uyğun gəlmir — yoxlanmalıdır"
                                          style="margin-left:6px;padding:1px 7px;border-radius:8px;background:#fef3c7;color:#b45309;font-size:10px;font-weight:700;cursor:help">⚠ yoxla</span>
                                }
                            </td>
                            <td style="text-align:right">
                                @if (User.IsInRole(FinNex.Domain.RoleNames.HR) || User.IsInRole(FinNex.Domain.RoleNames.Admin))
                                {
                                    <button type="button" class="dovEdit"
                                            data-id="@item.IcazeId"
                                            data-ad="@item.IsciAdSoyad"
                                            data-tarix="@item.IcazeTarixi.ToString("yyyy-MM-dd")"
                                            data-tarix-text="@item.IcazeTarixi.ToString("dd.MM.yyyy")"
                                            data-cixis="@(item.CixisVaxt?.ToString("yyyy-MM-ddTHH:mm"))"
                                            data-qayidis="@(item.QayidisVaxt?.ToString("yyyy-MM-ddTHH:mm"))"
                                            title="Çıxış/qayıdış vaxtını düzəlt"
                                            style="border:1px solid #d1d5db;background:#fff;border-radius:6px;padding:3px 9px;cursor:pointer;color:#374151;font-size:12px">
                                        <i class="bi bi-pencil"></i> Düzəlt
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@if (User.IsInRole(FinNex.Domain.RoleNames.HR) || User.IsInRole(FinNex.Domain.RoleNames.Admin))
{
    <div id="dovEditModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;align-items:center;justify-content:center">
        <div style="background:#fff;border-radius:12px;padding:22px;width:380px;max-width:92vw;box-shadow:0 10px 40px rgba(0,0,0,.2)">
            <h3 style="margin:0 0 4px;font-size:16px;color:#1a2332">Çıxış/qayıdış düzəlişi</h3>
            <div id="dovEditAd" style="font-size:13px;color:#6b7280;margin-bottom:14px"></div>
            <form id="dovEditForm" method="post" asp-area="User" asp-controller="Icaze" asp-action="CixisGirisDuzelt">
                @Html.AntiForgeryToken()
                <input type="hidden" name="icazeId" id="dovEditId" />
                <input type="hidden" name="cixisVaxt" id="dovEditCixisHidden" />
                <input type="hidden" name="qayidisVaxt" id="dovEditQayidisHidden" />
                <div style="background:#f8fafc;border-radius:8px;padding:8px 12px;font-size:13px;color:#374151;margin-bottom:14px">
                    İcazə tarixi: <strong id="dovEditTarixText"></strong>
                </div>
                <div style="margin-bottom:12px">
                    <label style="display:block;font-size:12px;color:#374151;margin-bottom:4px">Faktiki çıxış saatı</label>
                    <input type="text" id="dovEditCixisSaat" inputmode="numeric" placeholder="məs: 11:33" maxlength="5"
                           style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:15px;letter-spacing:.5px" />
                </div>
                <div style="margin-bottom:8px">
                    <label style="display:block;font-size:12px;color:#374151;margin-bottom:4px">Faktiki qayıdış saatı</label>
                    <input type="text" id="dovEditQayidisSaat" inputmode="numeric" placeholder="məs: 17:45" maxlength="5"
                           style="width:100%;padding:8px;border:1px solid #d1d5db;border-radius:6px;font-size:15px;letter-spacing:.5px" />
                </div>
                <div style="font-size:11px;color:#94a3b8;margin-bottom:16px">24 saat formatı (SS:DD). Boş buraxsanız həmin sahə təmizlənir.</div>
                <div style="display:flex;justify-content:flex-end;gap:8px">
                    <button type="button" id="dovEditCancel"
                            style="border:1px solid #d1d5db;background:#fff;border-radius:8px;padding:8px 16px;cursor:pointer;color:#374151">Ləğv</button>
                    <button type="submit"
                            style="border:none;background:#2563eb;color:#fff;border-radius:8px;padding:8px 16px;cursor:pointer;font-weight:600">Yadda saxla</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('dovEditModal');
            if (!modal) return;
            var form = document.getElementById('dovEditForm');
            var curTarix = '';
            var re = /^([01]?\d|2[0-3]):[0-5]\d$/; // 24 saat SS:DD

            function hhmm(iso) {            // "2026-06-10T11:33" → "11:33"
                if (!iso) return '';
                return (iso.split('T')[1] || '').slice(0, 5);
            }

            document.querySelectorAll('.dovEdit').forEach(function (b) {
                b.addEventListener('click', function () {
                    document.getElementById('dovEditId').value = b.dataset.id;
                    document.getElementById('dovEditAd').textContent = b.dataset.ad || '';
                    curTarix = b.dataset.tarix || '';
                    document.getElementById('dovEditTarixText').textContent = b.dataset.tarixText || curTarix;
                    document.getElementById('dovEditCixisSaat').value = hhmm(b.dataset.cixis);
                    document.getElementById('dovEditQayidisSaat').value = hhmm(b.dataset.qayidis);
                    modal.style.display = 'flex';
                });
            });

            form.addEventListener('submit', function (e) {
                var ct = document.getElementById('dovEditCixisSaat').value.trim();
                var qt = document.getElementById('dovEditQayidisSaat').value.trim();
                if (ct && !re.test(ct)) { e.preventDefault(); alert('Çıxış saatı düzgün deyil (SS:DD, məs: 09:30).'); return; }
                if (qt && !re.test(qt)) { e.preventDefault(); alert('Qayıdış saatı düzgün deyil (SS:DD, məs: 17:45).'); return; }
                document.getElementById('dovEditCixisHidden').value   = ct ? (curTarix + 'T' + ct) : '';
                document.getElementById('dovEditQayidisHidden').value = qt ? (curTarix + 'T' + qt) : '';
            });

            document.getElementById('dovEditCancel').addEventListener('click', function () { modal.style.display = 'none'; });
            modal.addEventListener('click', function (e) { if (e.target === modal) modal.style.display = 'none'; });
        })();
    </script>
}
