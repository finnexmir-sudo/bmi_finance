@using FinNex.Domain
@using FinNex.Domain.Entities.HR
@model FinNex.UI.Areas.User.ViewModels.Icaze.IcazeIzlemeVM
@{
    ViewData["Title"] = "İcazə İzləmə";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var sirala = ViewData["Sirala"]?.ToString() ?? "cemi";

    string StatusText(IcazeStatus s) => s switch {
        IcazeStatus.Gozlemede             => "Gözləmədə",
        IcazeStatus.SobeReisiTesdiqinde   => "Şöbə rəisi",
        IcazeStatus.RehberTesdiqinde      => "Rəhbər",
        IcazeStatus.HrTesdiqinde          => "HR",
        IcazeStatus.Tesdiqlenib           => "Təsdiqlənib",
        IcazeStatus.ImtinaEdildi          => "İmtina",
        _                                 => "—"
    };

    string StatusDotClass(IcazeStatus s) => s switch {
        IcazeStatus.Tesdiqlenib  => "iz-status-dot--ok",
        IcazeStatus.ImtinaEdildi => "iz-status-dot--reject",
        _                        => "iz-status-dot--wait"
    };
}

@{
    string SortUrl(string key) => Url.Action("Izleme", "Icaze", new {
        area = "User",
        Model.Filtr.TarixFrom,
        Model.Filtr.TarixTo,
        Model.Filtr.DepartamentId,
        Model.Filtr.Axtaris,
        Model.Filtr.Status,
        sirala = key
    }) ?? "#";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/icaze-izleme.css" asp-append-version="true" />
    <style>
        .iz-sort-bar { display:flex; gap:6px; margin-bottom:14px; flex-wrap:wrap; }
        .iz-sort-btn {
            display:inline-flex; align-items:center; gap:4px;
            padding:5px 13px; border-radius:20px; font-size:.76rem; font-weight:600;
            border:1px solid #dde2ec; background:#f7f8fc; color:#5a6478;
            text-decoration:none; transition:all .15s;
        }
        .iz-sort-btn:hover { background:#eff2fb; border-color:#b0bcf0; color:#2563eb; }
        .iz-sort-btn.active { background:#2563eb; border-color:#2563eb; color:#fff; }
        .iz-rank { display:inline-flex; align-items:center; justify-content:center;
                   width:22px; height:22px; border-radius:50%; font-size:.7rem; font-weight:700; }
        .iz-rank--1 { background:#ffd700; color:#7a5a00; }
        .iz-rank--2 { background:#c0c0c0; color:#444; }
        .iz-rank--3 { background:#cd7f32; color:#fff; }
        .iz-rank--n { background:#f0f2f7; color:#8590a6; }
    </style>
}

<div class="fn-page">

    @* ── Başlıq ── *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İcazə İzləmə</div>
            <div class="fn-page-sub">İşçilərin icazə müraciətlərinin xülasəsi</div>
        </div>
    </div>

    @* ── KPI kartları ── *@
    <div class="iz-kpi-row">
        <div class="iz-kpi iz-kpi--blue">
            <div class="iz-kpi-val">@Model.UmumIsciSayi</div>
            <div class="iz-kpi-lbl">İşçi</div>
        </div>
        <div class="iz-kpi iz-kpi--indigo">
            <div class="iz-kpi-val">@Model.UmumMuraciet</div>
            <div class="iz-kpi-lbl">Cəmi müraciət</div>
        </div>
        <div class="iz-kpi iz-kpi--green">
            <div class="iz-kpi-val">@Model.UmumTesdiq</div>
            <div class="iz-kpi-lbl">Təsdiqlənib</div>
        </div>
        <div class="iz-kpi iz-kpi--amber">
            <div class="iz-kpi-val">@Model.UmumGozleme</div>
            <div class="iz-kpi-lbl">Gözləmədə</div>
        </div>
        <div class="iz-kpi iz-kpi--red">
            <div class="iz-kpi-val">@Model.UmumImtina</div>
            <div class="iz-kpi-lbl">İmtina</div>
        </div>
        <div class="iz-kpi iz-kpi--teal">
            <div class="iz-kpi-val">@Model.UmumTesdiqSaat.ToString("0.#")</div>
            <div class="iz-kpi-lbl">Təsdiq saatı</div>
        </div>
    </div>

    @* ── Sıralama ── *@
    <div class="iz-sort-bar">
        <span style="font-size:.76rem;color:#8590a6;align-self:center;font-weight:600;">Sırala:</span>
        <a href="@SortUrl("cemi")" class="iz-sort-btn @(sirala == "cemi" ? "active" : "")">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 9h8M2 6h5M2 3h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            Ən çox müraciət
        </a>
        <a href="@SortUrl("saat")" class="iz-sort-btn @(sirala == "saat" ? "active" : "")">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="M6 3.5v3l2 1.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Ən çox saat
        </a>
        <a href="@SortUrl("faktiki")" class="iz-sort-btn @(sirala == "faktiki" ? "active" : "")">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="M3.5 6.5l1.8 1.8L8.5 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Ən çox faktiki
        </a>
        <a href="@SortUrl("imtina")" class="iz-sort-btn @(sirala == "imtina" ? "active" : "")">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.3"/><path d="M4 4l4 4M8 4l-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Ən çox imtina
        </a>
    </div>

    @* ── Filtr ── *@
    <div class="iz-filter-card">
        <form method="get" asp-action="Izleme">
            <input type="hidden" name="sirala" value="@sirala" />
            <div class="iz-filter-grid">
                <div>
                    <label class="iz-filter-lbl">Tarixdən</label>
                    <input type="date" name="tarixFrom"
                           value="@Model.Filtr.TarixFrom?.ToString("yyyy-MM-dd")"
                           class="iz-input" />
                </div>
                <div>
                    <label class="iz-filter-lbl">Tarixə qədər</label>
                    <input type="date" name="tarixTo"
                           value="@Model.Filtr.TarixTo?.ToString("yyyy-MM-dd")"
                           class="iz-input" />
                </div>
                <div>
                    <label class="iz-filter-lbl">Şöbə</label>
                    <select name="departamentId" class="iz-input">
                        @foreach (var d in Model.Departamentler)
                        {
                            <option value="@d.Value"
                                    selected="@(d.Value == Model.Filtr.DepartamentId?.ToString() ? "selected" : null)">
                                @d.Text
                            </option>
                        }
                    </select>
                </div>
                <div>
                    <label class="iz-filter-lbl">Status</label>
                    <select name="status" class="iz-input">
                        <option value="">Hamısı</option>
                        <option value="1" selected="@(Model.Filtr.Status == 1 ? "selected" : null)">Gözləmədə</option>
                        <option value="2" selected="@(Model.Filtr.Status == 2 ? "selected" : null)">Şöbə rəisi təsdiqində</option>
                        <option value="3" selected="@(Model.Filtr.Status == 3 ? "selected" : null)">Rəhbər təsdiqində</option>
                        <option value="4" selected="@(Model.Filtr.Status == 4 ? "selected" : null)">HR təsdiqində</option>
                        <option value="5" selected="@(Model.Filtr.Status == 5 ? "selected" : null)">Təsdiqlənib</option>
                        <option value="6" selected="@(Model.Filtr.Status == 6 ? "selected" : null)">İmtina edildi</option>
                    </select>
                </div>
                <div>
                    <label class="iz-filter-lbl">İşçi adı</label>
                    <input type="text" name="axtaris"
                           value="@Model.Filtr.Axtaris"
                           placeholder="Ad, soyad axtar..."
                           class="iz-input" />
                </div>
            </div>
            <div class="iz-filter-actions">
                <button type="submit" class="iz-btn iz-btn--primary">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/>
                        <path d="M9 9l2.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                    </svg>
                    Axtar
                </button>
                <a href="@Url.Action("Izleme")" class="iz-btn iz-btn--ghost">Sıfırla</a>
            </div>
        </form>
    </div>

    @* ── Cədvəl ── *@
    <div class="iz-table-card">
        <div class="iz-table-header">
            <span class="iz-table-count">@Model.IsciIstatistikler.Count işçi</span>
        </div>

        @if (!Model.IsciIstatistikler.Any())
        {
            <div class="iz-empty">
                <div class="iz-empty-icon">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                        <circle cx="18" cy="18" r="13" stroke="#c8cdd8" stroke-width="1.5"/>
                        <path d="M18 11v8l4 3" stroke="#c8cdd8" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="iz-empty-title">Nəticə tapılmadı</div>
                <div class="iz-empty-sub">Filtr parametrlərini dəyişdirməyə cəhd edin</div>
            </div>
        }
        else
        {
            <div class="iz-table-wrap">
                <table class="iz-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th></th>
                            <th>İşçi</th>
                            <th>Şöbə / Vəzifə</th>
                            <th>Cəmi</th>
                            <th>Təsdiqlənib</th>
                            <th>Gözləmədə</th>
                            <th>İmtina</th>
                            <th>Təsdiq saatı</th>
                            <th>Faktiki saat</th>
                            <th>Son icazə</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (ist, idx) in Model.IsciIstatistikler.Select((x, i) => (x, i)))
                        {
                            var detailId = $"iz-detail-{idx}";
                            var rank = idx + 1;
                            var rankClass = rank == 1 ? "iz-rank--1" : rank == 2 ? "iz-rank--2" : rank == 3 ? "iz-rank--3" : "iz-rank--n";

                            <tr data-toggle="@detailId">
                                <td>
                                    <span class="iz-rank @rankClass">@rank</span>
                                </td>
                                <td>
                                    <button class="iz-expand-btn" id="btn-iz-row-@idx"
                                            onclick="toggleRow('@detailId', this); event.stopPropagation();"
                                            title="İcazələri göstər">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>
                                </td>
                                <td>
                                    <div class="iz-isci-name">@ist.IsciAdSoyad</div>
                                </td>
                                <td>
                                    <div class="iz-isci-sub">@ist.SobeAdi</div>
                                    @if (!string.IsNullOrEmpty(ist.VezifeAdi))
                                    {
                                        <div class="iz-isci-sub">@ist.VezifeAdi</div>
                                    }
                                </td>
                                <td>
                                    <span class="iz-badge iz-badge--total">@ist.CemiMuraciet</span>
                                </td>
                                <td>
                                    <span class="iz-badge iz-badge--ok">@ist.TesdiqlenibSayi</span>
                                </td>
                                <td>
                                    <span class="iz-badge iz-badge--wait">@ist.GozlemeSayi</span>
                                </td>
                                <td>
                                    <span class="iz-badge iz-badge--reject">@ist.ImtinaEdildiSayi</span>
                                </td>
                                <td>
                                    <span class="iz-saat">@ist.TesdiqSaat.ToString("0.#")</span>
                                    <span class="iz-saat-lbl"> saat</span>
                                </td>
                                <td title="Cihazdan faktiki çıxış–qayıdış müddətlərinin cəmi">
                                    @if (ist.FaktikiSaat > 0)
                                    {
                                        <span class="iz-saat" style="color:#2d6cdf">@ist.FaktikiSaat.ToString("0.#")</span>
                                        <span class="iz-saat-lbl"> saat</span>
                                    }
                                    else
                                    {
                                        <span class="iz-saat-lbl">—</span>
                                    }
                                </td>
                                <td class="iz-isci-sub">
                                    @(ist.SonIcazeTarixi?.ToString("dd.MM.yyyy") ?? "—")
                                </td>
                            </tr>

                            @* Genişlənmiş detay sıra *@
                            <tr class="iz-detail-row" id="@detailId">
                                <td colspan="11">
                                    <div class="iz-detail-inner">
                                        <div class="iz-detail-title">@ist.IsciAdSoyad — İcazələr (@ist.CemiMuraciet)</div>
                                        @if (ist.Icazeler.Any())
                                        {
                                            <table class="iz-mini-table">
                                                <thead>
                                                    <tr>
                                                        <th>Tarix</th>
                                                        <th>Saat aralığı</th>
                                                        <th>Müddət</th>
                                                        <th>Faktiki çıxış</th>
                                                        <th>Faktiki qayıdış</th>
                                                        <th>Səbəb</th>
                                                        <th>Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ic in ist.Icazeler)
                                                    {
                                                        <tr>
                                                            <td>@ic.IcazeTarixi.ToString("dd.MM.yyyy")</td>
                                                            <td>@ic.BaslamaSaati.ToString(@"hh\:mm") – @ic.BitisSaati.ToString(@"hh\:mm")</td>
                                                            <td><strong>@ic.IcazeSaati.ToString("0.#") saat</strong></td>
                                                            <td>@(ic.CixisVaxt.HasValue ? ic.CixisVaxt.Value.ToString("HH:mm") : "—")</td>
                                                            <td>
                                                                @if (ic.QayidisVaxt.HasValue)
                                                                {
                                                                    <span>@ic.QayidisVaxt.Value.ToString("HH:mm")</span>
                                                                }
                                                                else if (ic.Birdefelik)
                                                                {
                                                                    <span style="color:#8590a6">birdəfəlik</span>
                                                                }
                                                                else
                                                                {
                                                                    <span style="color:#8590a6">—</span>
                                                                }
                                                                @if (ic.CixisQayidisAnomaliya)
                                                                {
                                                                    <span title="Cihaz çıxış/qayıdışı icazə pəncərəsinə uyğun gəlmir — yoxlanmalıdır"
                                                                          style="margin-left:5px;color:#b45309;font-weight:700;cursor:help">⚠</span>
                                                                }
                                                            </td>
                                                            <td>@(string.IsNullOrEmpty(ic.Sebeb) ? "—" : ic.Sebeb)</td>
                                                            <td>
                                                                <span class="iz-status-dot @StatusDotClass(ic.Status)"></span>
                                                                @StatusText(ic.Status)
                                                                @if (!string.IsNullOrEmpty(ic.ImtinaSebebi))
                                                                {
                                                                    <span style="color:#8590a6;font-size:.7rem"> (@ic.ImtinaSebebi)</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                        else
                                        {
                                            <span class="iz-isci-sub">Heç bir icazə tapılmadı.</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function toggleRow(detailId, btn) {
            var row = document.getElementById(detailId);
            var isOpen = row.classList.toggle('is-open');
            btn.classList.toggle('is-open', isOpen);
        }

        // Sütun başlığına klik edərək sıralama
        document.querySelectorAll('.iz-table [data-toggle]').forEach(function (tr) {
            tr.style.cursor = 'pointer';
            tr.addEventListener('click', function () {
                var detailId = tr.getAttribute('data-toggle');
                var btn = tr.querySelector('.iz-expand-btn');
                if (btn) toggleRow(detailId, btn);
            });
        });
    </script>
}
