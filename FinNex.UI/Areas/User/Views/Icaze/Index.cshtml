@model IList<FinNex.Application.DTOs.HR.Icaze.IcazeListDto>
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "İcazələrim";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole("Employee") ? "İşçi" : "";

    string BadgeClass(IcazeStatus s) => s switch
    {
        IcazeStatus.Gozlemede => "fn-badge--wait",
        IcazeStatus.SobeReisiTesdiqinde => "fn-badge--review",
        IcazeStatus.RehberTesdiqinde => "fn-badge--review",
        IcazeStatus.HrTesdiqinde => "fn-badge--review",
        IcazeStatus.Tesdiqlenib => "fn-badge--done",
        IcazeStatus.ImtinaEdildi => "fn-badge--rejected",
        _ => "fn-badge--wait"
    };
}

<div class="fn-page">

    @* ── Başlıq ── *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İcazələrim</div>
            <div class="fn-page-sub">Bütün saatlıq icazə müraciətləriniz</div>
        </div>
        <a asp-area="User" asp-controller="Icaze" asp-action="Create"
           class="fn-btn fn-btn--primary">
            + Yeni müraciət
        </a>
    </div>

    @* ── Boş vəziyyət ── *@
    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-icon">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect x="6" y="6" width="28" height="28" rx="6" stroke="#dde1ea" stroke-width="2" />
                    <circle cx="20" cy="20" r="5" stroke="#dde1ea" stroke-width="2" />
                    <path d="M20 11v3M20 26v3M11 20h3M26 20h3" stroke="#dde1ea" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-empty-title">Hələ icazə müraciətiniz yoxdur</div>
            <div class="fn-empty-sub">Yeni müraciət göndərmək üçün yuxarıdakı düyməni basın</div>
        </div>
    }
    else
    {
        @* ── Statistika sətri ── *@
        <div class="fn-stat-row">
            <div class="fn-stat">
                <div class="fn-stat-val">@Model.Count</div>
                <div class="fn-stat-lbl">Cəmi</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#1e9b6b">
                    @Model.Count(x => x.Status == IcazeStatus.Tesdiqlenib)
                </div>
                <div class="fn-stat-lbl">Təsdiqlənib</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#c9900a">
                    @Model.Count(x => x.Status != IcazeStatus.Tesdiqlenib &&
                    x.Status != IcazeStatus.ImtinaEdildi)
            </div>
            <div class="fn-stat-lbl">Gözləmədə</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#c0392b">
                @Model.Count(x => x.Status == IcazeStatus.ImtinaEdildi)
            </div>
            <div class="fn-stat-lbl">İmtina edildi</div>
        </div>
        <div class="fn-stat">
            <div class="fn-stat-val" style="color:#2d6cdf">
                @Model.Where(x => x.Status == IcazeStatus.Tesdiqlenib)
                .Sum(x => x.IcazeSaati).ToString("F1") saat
            </div>
            <div class="fn-stat-lbl">İstifadə edilib</div>
        </div>
    </div>

    @* ── Siyahı ── *@
    <div class="fn-card">
        <div class="fn-icaze-list">
            @foreach (var icaze in Model)
                {
                    <div class="fn-icaze-item">

                        @* Sol: tarix + saat bloku *@
                        <div class="fn-icaze-date-block">
                            <div class="fn-icaze-day">
                                @icaze.IcazeTarixi.ToString("dd")
                            </div>
                            <div class="fn-icaze-month">
                                @icaze.IcazeTarixi.ToString("MMM")
                            </div>
                        </div>

                        @* Mərkəz: məlumatlar *@
                        <div class="fn-icaze-info">
                            <div class="fn-icaze-title">
                                @icaze.BaslamaSaati.ToString(@"hh\:mm") —
                                @icaze.BitisSaati.ToString(@"hh\:mm")
                                <span class="fn-icaze-dur">(@icaze.IcazeSaati.ToString("F1") saat)</span>
                            </div>
                            <div class="fn-icaze-meta">
                                <span class="fn-icaze-evez">
                                    Əvəzedici: @icaze.EvezEdenAdSoyad
                                </span>
                                @if (!string.IsNullOrEmpty(icaze.Sebeb))
                                {
                                    <span class="fn-icaze-sep">·</span>
                                    <span class="fn-icaze-sebeb">@icaze.Sebeb</span>
                                }
                            </div>
                            @* Workflow addım göstəricisi *@
                            <div class="fn-workflow-steps">
                                <div class="fn-ws @(icaze.Status >= IcazeStatus.SobeReisiTesdiqinde ? "fn-ws--done" : icaze.Status == IcazeStatus.Gozlemede ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">Müraciət</div>
                                </div>
                                <div class="fn-ws-line @(icaze.Status >= IcazeStatus.SobeReisiTesdiqinde ? "fn-ws-line--done" : "")"></div>
                                <div class="fn-ws @(icaze.Status == IcazeStatus.Tesdiqlenib || icaze.Status == IcazeStatus.RehberTesdiqinde || icaze.Status == IcazeStatus.HrTesdiqinde ? "fn-ws--done" : icaze.Status == IcazeStatus.SobeReisiTesdiqinde ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">Şöbə rəisi</div>
                                </div>
                                <div class="fn-ws-line @(icaze.Status >= IcazeStatus.RehberTesdiqinde ? "fn-ws-line--done" : "")"></div>
                                <div class="fn-ws @(icaze.Status == IcazeStatus.Tesdiqlenib || icaze.Status == IcazeStatus.HrTesdiqinde ? "fn-ws--done" : icaze.Status == IcazeStatus.RehberTesdiqinde ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">Rəhbər</div>
                                </div>
                                <div class="fn-ws-line @(icaze.Status >= IcazeStatus.HrTesdiqinde ? "fn-ws-line--done" : "")"></div>
                                <div class="fn-ws @(icaze.Status == IcazeStatus.Tesdiqlenib ? "fn-ws--done" : icaze.Status == IcazeStatus.HrTesdiqinde ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">HR</div>
                                </div>
                            </div>
                        </div>

                        @* Sağ: status + ləğv düyməsi *@
                        <div class="fn-icaze-actions">
                            <span class="fn-badge @BadgeClass(icaze.Status)">
                                @icaze.WorkflowMerhele
                            </span>
                            @if (icaze.Status == IcazeStatus.Gozlemede)
                            {
                                <form asp-area="User" asp-controller="Icaze"
                                      asp-action="Legv" method="post"
                                      style="margin-top:8px"
                                      onsubmit="return confirm('Bu icazəni ləğv etmək istəyirsiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@icaze.Id" />
                                    <button type="submit" class="fn-btn fn-btn--danger-sm">
                                        Ləğv et
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
