@model FinNex.UI.Areas.User.ViewModels.Icaze.IcazeIndexVM
@{
    ViewData["Title"] = "İcazələrim";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole(RoleNames.Operator) ? RoleNames.Operator : "";

    // Workflow addım nömrəsinə çevir (string, entity enum yox)
    int WorkflowStep(string merhele) => merhele switch
    {
        "Gözləmədə"               => 0,
        "Şöbə rəisi təsdiqində"   => 1,
        "Rəhbər təsdiqində"       => 2,
        "HR təsdiqində"           => 3,
        "Təsdiqlənib"             => 4,
        "İmtina edildi"           => -1,
        _                         => 0
    };

    string BadgeClass(string merhele) => merhele switch
    {
        "Təsdiqlənib"   => "fn-badge--done",
        "İmtina edildi" => "fn-badge--rejected",
        "Gözləmədə"     => "fn-badge--wait",
        _               => "fn-badge--review"
    };
}

<div class="fn-page">

    @* ── Başlıq ── *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">İcazələrim</div>
            <div class="fn-page-sub">Bütün saatlıq icazə müraciətləriniz</div>
        </div>
        <a asp-area="User" asp-controller="Icaze" asp-action="Create"
           class="fn-btn fn-btn--primary">
            + Yeni müraciət
        </a>
    </div>

    @* ── Boş vəziyyət ── *@
    @if (!Model.Icazeler.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-icon">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <circle cx="20" cy="20" r="14" stroke="#dde1ea" stroke-width="2" />
                    <path d="M20 12v9l5 4" stroke="#dde1ea" stroke-width="2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-empty-title">Hələ icazə müraciətiniz yoxdur</div>
            <div class="fn-empty-sub">Yeni müraciət göndərmək üçün yuxarıdakı düyməni basın</div>
        </div>
    }
    else
    {
        @* ── Statistika sətri ── *@
        <div class="fn-stat-row">
            <div class="fn-stat">
                <div class="fn-stat-val">@Model.Cemi</div>
                <div class="fn-stat-lbl">Cəmi</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#1e9b6b">@Model.TesdiqCem</div>
                <div class="fn-stat-lbl">Təsdiqlənib</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#c9900a">@Model.GozlemeCem</div>
                <div class="fn-stat-lbl">Gözləmədə</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#c0392b">@Model.ImtinaCem</div>
                <div class="fn-stat-lbl">İmtina edildi</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#2d6cdf">@Model.IstifadeOlunanSaat.ToString("F1") saat</div>
                <div class="fn-stat-lbl">İstifadə edilib</div>
            </div>
        </div>

        @* ── Siyahı ── *@
        <div class="fn-card">
    <div class="fn-icaze-list">
        @foreach (var icaze in Model.Icazeler)
        {
            @* C# kodunu burada təyin edirik *@
             
                var step = WorkflowStep(icaze.WorkflowMerhele); 
            

            <div class="fn-icaze-item">

                @* Sol: tarix + saat bloku *@
                <div class="fn-icaze-date-block">
                    <div class="fn-icaze-day">@icaze.IcazeTarixi.ToString("dd")</div>
                    <div class="fn-icaze-month">@icaze.IcazeTarixi.ToString("MMM")</div>
                </div>

                @* Mərkəz: məlumatlar *@
                <div class="fn-icaze-info">
                    <div class="fn-icaze-title">
                        @icaze.BaslamaSaati.ToString(@"hh\:mm") —
                        @icaze.BitisSaati.ToString(@"hh\:mm")
                        <span class="fn-icaze-dur">(@icaze.IcazeSaati.ToString("F1") saat)</span>
                    </div>
                    <div class="fn-icaze-meta">
                        <span class="fn-icaze-evez">
                            Əvəzedici: @icaze.EvezEdenAdSoyad
                        </span>
                        @if (!string.IsNullOrEmpty(icaze.Sebeb))
                        {
                            <span class="fn-icaze-sep">·</span>
                            <span class="fn-icaze-sebeb">@icaze.Sebeb</span>
                        }
                    </div>

                    @* Workflow addım göstəricisi *@
                    @if (step != -1)
                    {
                        <div class="fn-workflow-steps">
                            <div class="fn-ws @(step >= 1 ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                <div class="fn-ws-dot"></div>
                                <div class="fn-ws-lbl">Müraciət</div>
                            </div>
                            @if (!icaze.SobeReisiKecildi)
                            {
                                <div class="fn-ws-line @(step >= 2 ? "fn-ws-line--done" : "")"></div>
                                <div class="fn-ws @(step >= 2 ? "fn-ws--done" : step == 1 ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">Şöbə rəisi</div>
                                </div>
                            }
                            @if (!icaze.RehberKecildi)
                            {
                                <div class="fn-ws-line @(step >= 3 ? "fn-ws-line--done" : "")"></div>
                                <div class="fn-ws @(step >= 3 ? "fn-ws--done" : step == 2 ? "fn-ws--active" : "")">
                                    <div class="fn-ws-dot"></div>
                                    <div class="fn-ws-lbl">Rəhbər</div>
                                </div>
                            }
                            <div class="fn-ws-line @(step >= 4 ? "fn-ws-line--done" : "")"></div>
                            <div class="fn-ws @(step >= 4 ? "fn-ws--done" : step == 3 ? "fn-ws--active" : "")">
                                <div class="fn-ws-dot"></div>
                                <div class="fn-ws-lbl">HR</div>
                            </div>
                        </div>
                    }
                </div>

                @* Sağ: status + ləğv düyməsi *@
                <div class="fn-icaze-actions">
                    <span class="fn-badge @BadgeClass(icaze.WorkflowMerhele)">
                        @icaze.WorkflowMerhele
                    </span>
                    @if (icaze.WorkflowMerhele == "Gözləmədə" || icaze.WorkflowMerhele == "Şöbə rəisi təsdiqində" || icaze.WorkflowMerhele == "Rəhbər təsdiqində")
                    {
                        <form asp-area="User" asp-controller="Icaze"
                              asp-action="Legv" method="post"
                              style="margin-top:8px"
                              onsubmit="return confirm('Bu icazəni ləğv etmək istəyirsiniz?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@icaze.Id" />
                            <button type="submit" class="fn-btn fn-btn--danger-sm">
                                Ləğv et
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
    }
</div>
