@model FinNex.UI.Areas.User.ViewModels.Icaze.IcazeCreateVM
@{
    ViewData["Title"] = "Yeni İcazə Müraciəti";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole(RoleNames.Operator) ? RoleNames.Operator : "";
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni icazə müraciəti</div>
            <div class="fn-page-sub">Saatlıq icazə üçün müraciət göndərin</div>
        </div>
        <a asp-area="User" asp-controller="Icaze" asp-action="Index"
           class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-form-wrap">
        <form asp-area="User" asp-controller="Icaze" asp-action="Create"
              method="post" id="icazeForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsciId" />

            <div class="fn-card fn-card--form">

                @* ── İcazə tarixi ── *@
                <div class="fn-form-group">
                    <label asp-for="IcazeTarixi" class="fn-label">
                        İcazə tarixi <span class="fn-required">*</span>
                    </label>
                    <input asp-for="IcazeTarixi" type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="fn-input" />
                    <span asp-validation-for="IcazeTarixi" class="fn-val-msg"></span>
                </div>

                @* ── Saat aralığı ── *@
                @{
                    var saatlar = new List<(string val, string txt)>();
                    for (int h = 8; h <= 18; h++)
                    {
                        saatlar.Add(($"{h:D2}:00:00", $"{h:D2}:00"));
                        if (h < 18) saatlar.Add(($"{h:D2}:30:00", $"{h:D2}:30"));
                    }
                    var basVal = Model.BaslamaSaati.ToString(@"hh\:mm\:ss");
                    var bitisVal = Model.BitisSaati.ToString(@"hh\:mm\:ss");
                }
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Başlama saatı <span class="fn-required">*</span>
                        </label>
                        <select name="BaslamaSaati" class="fn-select" id="baslamaSaati">
                            @foreach (var s in saatlar)
                            {
                                if (s.val == basVal)
                                {
                                    <option value="@s.val" selected="selected">@s.txt</option>
                                }
                                else
                                {
                                    <option value="@s.val">@s.txt</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="BaslamaSaati" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Bitmə saatı <span class="fn-required">*</span>
                        </label>
                        <select name="BitisSaati" class="fn-select" id="bitisSaati">
                            @foreach (var s in saatlar)
                            {
                                if (s.val == bitisVal)
                                {
                                    <option value="@s.val" selected="selected">@s.txt</option>
                                }
                                else
                                {
                                    <option value="@s.val">@s.txt</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="BitisSaati" class="fn-val-msg"></span>
                    </div>
                </div>

                @* ── Müddət hesablanır ── *@
                <div class="fn-duration-box" id="durationBox" style="display:none">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="5.5" stroke="#1e9b6b" stroke-width="1.2" />
                        <path d="M7 4v3.5l2 1.5" stroke="#1e9b6b" stroke-width="1.1" stroke-linecap="round" />
                    </svg>
                    İcazə müddəti: <strong id="durationText"></strong>
                </div>

                @* ── Əvəzedici işçi ── *@
                <div class="fn-form-group">
                    <label asp-for="EvezEdenIsciId" class="fn-label">
                        Əvəzedici işçi <span class="fn-required"></span>
                        <span class="fn-label-hint"></span>
                    </label>
                    <select asp-for="EvezEdenIsciId"
                            asp-items="Model.EvezEdenList"
                            class="fn-select">
                        <option value="">— Seçin —</option>
                    </select>
                    <span asp-validation-for="EvezEdenIsciId" class="fn-val-msg"></span>
                </div>

                @* ── Səbəb ── *@
                <div class="fn-form-group">
                    <label asp-for="Sebeb" class="fn-label">
                        Səbəb
                        <span class="fn-label-hint">(istəyə bağlı)</span>
                    </label>
                    <textarea asp-for="Sebeb" rows="3"
                              class="fn-textarea"
                              placeholder="İcazənin səbəbini qısaca yazın..."></textarea>
                    <span asp-validation-for="Sebeb" class="fn-val-msg"></span>
                </div>

                @* ── Xəbərdarlıq bloku ── *@
                <div class="fn-info-box">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="5.5" stroke="#c9900a" stroke-width="1.2" />
                        <path d="M7 4.5v3M7 9v.5" stroke="#c9900a" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    Müraciətiniz 3 mərhələdən keçəcək:
                    <strong>Şöbə rəisi → Rəhbər → HR</strong>.
                    Yalnız <strong>Gözləmədə</strong> statusunda ləğv edə bilərsiniz.
                </div>

                @* ── Düymələr ── *@
                <div class="fn-form-actions">
                    <a asp-area="User" asp-controller="Icaze" asp-action="Index"
                       class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">
                        Müraciət göndər
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/User/user_create_icaze.js" asp-append-version="true"></script>
}
}
