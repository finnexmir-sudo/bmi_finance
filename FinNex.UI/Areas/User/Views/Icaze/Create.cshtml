@model FinNex.UI.Areas.User.ViewModels.Icaze.IcazeCreateVM
@{
    ViewData["Title"] = "Yeni İcazə Müraciəti";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni icazə müraciəti</div>
            <div class="fn-page-sub">Saatlıq icazə üçün müraciət göndərin</div>
        </div>
        <a asp-area="User" asp-controller="Icaze" asp-action="Index"
           class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-form-wrap">
        <form asp-area="User" asp-controller="Icaze" asp-action="Create"
              method="post" id="icazeForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IsciId" />

            <div class="fn-card fn-card--form">

                @* ── İcazə tarixi ── *@
                <div class="fn-form-group">
                    <label asp-for="IcazeTarixi" class="fn-label">
                        İcazə tarixi <span class="fn-required">*</span>
                    </label>
                    <input asp-for="IcazeTarixi" type="date"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="fn-input" />
                    <span asp-validation-for="IcazeTarixi" class="fn-val-msg"></span>
                </div>

                @* ── Saat aralığı ── *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="BaslamaSaati" class="fn-label">
                            Başlama saatı <span class="fn-required">*</span>
                        </label>
                        <input asp-for="BaslamaSaati" type="text"
                               pattern="^([01]?\d|2[0-3]):[0-5]\d$"
                               placeholder="09:00" maxlength="5"
                               class="fn-input" id="baslamaSaati" />
                        <span asp-validation-for="BaslamaSaati" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="BitisSaati" class="fn-label">
                            Bitmə saatı <span class="fn-required">*</span>
                        </label>
                        <input asp-for="BitisSaati" type="text"
                               pattern="^([01]?\d|2[0-3]):[0-5]\d$"
                               placeholder="12:00" maxlength="5"
                               class="fn-input" id="bitisSaati" />
                        <span asp-validation-for="BitisSaati" class="fn-val-msg"></span>
                    </div>
                </div>

                @* ── Müddət hesablanır ── *@
                <div class="fn-duration-box" id="durationBox" style="display:none">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="5.5" stroke="#1e9b6b" stroke-width="1.2" />
                        <path d="M7 4v3.5l2 1.5" stroke="#1e9b6b" stroke-width="1.1" stroke-linecap="round" />
                    </svg>
                    İcazə müddəti: <strong id="durationText"></strong>
                </div>

                @* ── Saat xətası (client-side) ── *@
                <div class="fn-duration-box" id="timeErrorBox"
                     style="display:none; background:#fff3cd; color:#856404; border-color:#ffc107;">
                </div>

                @* ── Əvəzedici işçi ── *@
                <div class="fn-form-group">
                    <label asp-for="EvezEdenIsciId" class="fn-label">
                        Əvəzedici işçi <span class="fn-required"></span>
                        <span class="fn-label-hint"></span>
                    </label>
                    <select asp-for="EvezEdenIsciId"
                            asp-items="Model.EvezEdenList"
                            class="fn-select">
                        <option value="">— Seçin —</option>
                    </select>
                    <span asp-validation-for="EvezEdenIsciId" class="fn-val-msg"></span>
                </div>

                @* ── Səbəb ── *@
                <div class="fn-form-group">
                    <label asp-for="Sebeb" class="fn-label">
                        Səbəb
                        <span class="fn-label-hint">(istəyə bağlı)</span>
                    </label>
                    <textarea asp-for="Sebeb" rows="3"
                              class="fn-textarea"
                              placeholder="İcazənin səbəbini qısaca yazın..."></textarea>
                    <span asp-validation-for="Sebeb" class="fn-val-msg"></span>
                </div>

                @* ── Jeton (yalnız Rəhbər üçün) ── *@
                @if (User.IsInRole(FinNex.Domain.RoleNames.Rehber) && ViewBag.JetonBalansi is decimal balans && balans > 0)
                {
                    <div class="fn-info-box" style="background:#fff8e8;border-color:#f0d785;color:#8a6a18;margin-bottom:8px">
                        <i class="bi bi-coin"></i>
                        Aktiv jeton balansınız: <strong>@balans.ToString("0.##") saat</strong>.
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="JetonOdenenSaat" class="fn-label">
                            Jetonu ödəmə saatı
                            <span class="fn-label-hint">(0 = istifadə etmə)</span>
                        </label>
                        <input asp-for="JetonOdenenSaat" type="number" min="0" max="@balans.ToString("0.##")"
                               step="0.5" class="fn-input" placeholder="0" />
                        <span asp-validation-for="JetonOdenenSaat" class="fn-val-msg"></span>
                        <small style="color:#6b7280;font-size:12px">
                            Müraciət birbaşa təsdiqlənəcəyi üçün bu addımda jeton saatını özünüz təyin edin.
                        </small>
                    </div>
                }
                else if (ViewBag.JetonBalansi is decimal bal && bal > 0)
                {
                    <div class="fn-info-box" style="background:#fff8e8;border-color:#f0d785;color:#8a6a18">
                        <i class="bi bi-coin"></i>
                        Aktiv jeton balansınız: <strong>@bal.ToString("0.##") saat</strong>.
                        Rəhbər təsdiq zamanı bu icazənin neçə saatını jetonla ödənmiş kimi seçə bilər.
                    </div>
                }

                @* ── Xəbərdarlıq bloku ── *@
                <div class="fn-info-box">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <circle cx="7" cy="7" r="5.5" stroke="#c9900a" stroke-width="1.2" />
                        <path d="M7 4.5v3M7 9v.5" stroke="#c9900a" stroke-width="1.2" stroke-linecap="round" />
                    </svg>
                    Müraciətiniz <strong>Rəhbər</strong> tərəfindən təsdiqlənəcək.
                    Rəhbər yoxdursa <strong>HR</strong> təsdiqləyir.
                    Yalnız gözləmədəki müraciəti ləğv edə bilərsiniz.
                </div>

                @* ── Düymələr ── *@
                <div class="fn-form-actions">
                    <a asp-area="User" asp-controller="Icaze" asp-action="Index"
                       class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary">
                        Müraciət göndər
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/User/user_create_icaze.js" asp-append-version="true"></script>
}
}
