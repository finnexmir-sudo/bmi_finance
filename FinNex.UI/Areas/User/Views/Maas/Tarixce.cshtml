@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Əmək haqqı tarixçəsi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/maas-tarixce.css" asp-append-version="true" />
}

<div class="mt-page">
    <div class="mt-header">
        <h2>Əmək haqqı tarixçəsi</h2>
        <p class="mt-subtitle">Son 12 aylıq maaş dinamikası</p>
    </div>

    <div class="mt-card mt-chart-card">
        <div class="mt-chart-head">
            <div class="mt-chart-title"><i class="bi bi-bar-chart-line-fill"></i> Maaş dinamikası</div>
        </div>
        <div class="mt-chart-wrap" id="chartWrap">
            <div class="mt-loading">
                <i class="bi bi-arrow-repeat"></i>
                <span>Yüklənir...</span>
            </div>
        </div>
        <canvas id="maasChart" style="display:none;"></canvas>
    </div>

    <div class="mt-summary-card" id="summaryCard" style="display:none;">
        <div class="mt-summary-grid">
            <div class="mt-stat-card mt-stat-card--indigo">
                <div class="mt-stat-icon"><i class="bi bi-wallet2"></i></div>
                <div class="mt-stat-body">
                    <div class="mt-summary-label">Orta Gross</div>
                    <div class="mt-summary-value" id="ortaBrut">--</div>
                </div>
            </div>
            <div class="mt-stat-card mt-stat-card--teal">
                <div class="mt-stat-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="mt-stat-body">
                    <div class="mt-summary-label">Orta Net</div>
                    <div class="mt-summary-value" id="ortaNet">--</div>
                </div>
            </div>
            <div class="mt-stat-card mt-stat-card--green">
                <div class="mt-stat-icon"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="mt-stat-body">
                    <div class="mt-summary-label">Ən yüksək Net</div>
                    <div class="mt-summary-value mt-summary-value--green" id="enYuksekNet">--</div>
                </div>
            </div>
            <div class="mt-stat-card mt-stat-card--red">
                <div class="mt-stat-icon"><i class="bi bi-graph-down-arrow"></i></div>
                <div class="mt-stat-body">
                    <div class="mt-summary-label">Ən aşağı Net</div>
                    <div class="mt-summary-value mt-summary-value--red" id="enAsagiNet">--</div>
                </div>
            </div>
        </div>
    </div>

    <div id="detayPanel" class="mt-card mt-detay-card" style="display:none;"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/User/maas-tarixce.js" asp-append-version="true"></script>
}
