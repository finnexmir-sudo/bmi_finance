@model List<FinNex.Application.DTOs.Communication.IsciMail.IsciMailDto>
@{
    ViewData["Title"] = "Qaralamalar";
}

<div class="fn-page-header d-flex align-items-center justify-content-between mb-3">
    <h4 class="mb-0">
        <i class="bi bi-file-earmark-text me-2 text-secondary"></i> Qaralamalar
    </h4>
    <a asp-action="Yaz" class="btn btn-primary btn-sm">
        <i class="bi bi-pencil-square me-1"></i> Yeni Mail
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-file-earmark display-5"></i>
                <p class="mt-2">Qaralama yoxdur</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var mail in Model)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <a asp-action="Detay" asp-route-id="@mail.Id" class="fw-semibold text-decoration-none">
                                    @mail.Movzu
                                </a>
                                <small class="text-muted ms-2">@mail.MetinKisar</small>
                                @if (mail.AliciSayi > 0)
                                {
                                    <span class="badge bg-secondary ms-2">@mail.AliciSayi alıcı</span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <small class="text-muted">
                                    @mail.YaradilmaTarixi.ToString("dd.MM.yy HH:mm")
                                </small>
                                <form asp-action="TaslagiGonder" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mail.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-send"></i> Göndər
                                    </button>
                                </form>
                                <form asp-action="Sil" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@mail.Id" />
                                    <input type="hidden" name="donusSehifesi" value="Taslaqlar" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Silinsin?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
