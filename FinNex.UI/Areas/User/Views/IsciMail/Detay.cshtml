@model FinNex.Application.DTOs.Communication.IsciMail.IsciMailDetayDto
@{
    ViewData["Title"] = Model.Movzu;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Geri
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">@Model.Movzu</h5>
        <div class="mt-1">
            <small class="text-muted">
                <i class="bi bi-person me-1"></i>
                <strong>Göndərən:</strong> @Model.GonderenAdSoyad
            </small>
            <span class="mx-2 text-muted">|</span>
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                @(Model.GondermeTarixi?.ToString("dd.MM.yyyy HH:mm") ?? "")
            </small>
        </div>
        @if (Model.Alicilar.Any())
        {
            <div class="mt-1">
                <small class="text-muted">
                    <i class="bi bi-people me-1"></i>
                    <strong>Alıcılar:</strong>
                    @string.Join(", ", Model.Alicilar.Select(a =>
                        a.AliciNovu == "CC" ? $"{a.AdSoyad} (CC)" : a.AdSoyad))
                </small>
            </div>
        }
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.MetinHtml))
        {
            @Html.Raw(Model.MetinHtml)
        }
        else
        {
            <pre class="m-0" style="white-space: pre-wrap; font-family: inherit;">@Model.Metin</pre>
        }
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a asp-action="Yaz" asp-route-aliciId="@Model.GonderenIsciId"
           class="btn btn-sm btn-outline-primary">
            <i class="bi bi-reply me-1"></i> Cavabla
        </a>
        <form asp-action="Sil" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-sm btn-outline-danger"
                    onclick="return confirm('Bu mail silinsin?')">
                <i class="bi bi-trash me-1"></i> Sil
            </button>
        </form>
    </div>
</div>

@if (Model.Alicilar.Any())
{
    <div class="card mt-3 shadow-sm">
        <div class="card-header bg-white">
            <small class="fw-semibold"><i class="bi bi-eye me-1"></i>Oxunma vəziyyəti</small>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Alıcı</th>
                        <th>Növ</th>
                        <th>Oxunub</th>
                        <th>Oxunma tarixi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Alicilar)
                    {
                        <tr>
                            <td>@a.AdSoyad</td>
                            <td><span class="badge bg-secondary">@a.AliciNovu</span></td>
                            <td>
                                @if (a.Oxunub)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle text-muted"></i>
                                }
                            </td>
                            <td><small class="text-muted">@(a.OxunmaTarixi?.ToString("dd.MM.yyyy HH:mm") ?? "-")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
