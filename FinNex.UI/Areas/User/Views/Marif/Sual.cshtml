@model FinNex.Application.DTOs.Marif.MarifIsciSualSetiDto
@{
    ViewData["Title"] = Model.Basliq;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<style>
.mf-wrap{max-width:760px;margin:0 auto}
.mf-breadcrumb{font-size:12.5px;color:#94a3b8;margin-bottom:6px}
.mf-title{font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-0.01em;margin-bottom:4px}
.mf-subtitle{font-size:14px;color:#64748b;margin-bottom:18px}

.mf-info{display:flex;gap:12px;background:#fef3c7;border:1px solid #fde68a;border-radius:12px;padding:14px 16px;margin-bottom:20px}
.mf-info i{color:#d97706;font-size:18px;margin-top:1px;flex-shrink:0}
.mf-info strong{display:block;font-size:13.5px;color:#92400e;margin-bottom:2px}
.mf-info span{font-size:12.5px;color:#a16207;line-height:1.5}

.mf-progress-row{display:flex;justify-content:flex-end;font-size:12.5px;color:#64748b;margin-bottom:6px;font-weight:600}
.mf-progress-track{height:6px;background:#e2e8f0;border-radius:99px;overflow:hidden;margin-bottom:22px}
.mf-progress-fill{height:100%;background:linear-gradient(90deg,#2563eb,#1d4ed8);border-radius:99px;transition:width .3s ease}

.mf-card{background:#fff;border:1px solid #e8eaef;border-radius:16px;box-shadow:0 2px 14px rgba(0,0,0,.05);padding:26px}

.mf-badge{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:700;letter-spacing:.3px;text-transform:uppercase;color:#475569;background:#f1f5f9;border-radius:20px;padding:5px 12px;margin-bottom:14px}
.mf-badge.mf-badge--cox{color:#1d4ed8;background:#eff6ff}
.mf-badge.mf-badge--acig{color:#7c3aed;background:#f5f3ff}

.mf-q-text{font-size:17px;font-weight:700;color:#0f172a;line-height:1.45;margin-bottom:6px}
.mf-q-sub{font-size:12.5px;color:#94a3b8;margin-bottom:16px}

.mf-options{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}
.mf-option{display:flex;align-items:center;gap:11px;border:1.5px solid #e2e8f0;border-radius:11px;padding:13px 15px;cursor:pointer;transition:border-color .15s,background .15s}
.mf-option:hover{border-color:#bfdbfe;background:#f8fafc}
.mf-option input{width:17px;height:17px;accent-color:#2563eb;flex-shrink:0}
.mf-option span{font-size:14px;color:#1e293b}
.mf-option.mf-option--checked{border-color:#2563eb;background:#eff6ff}

.mf-textarea{width:100%;border:1.5px solid #e2e8f0;border-radius:11px;padding:13px 15px;font-size:14px;resize:vertical;min-height:110px;font-family:inherit;outline:none;transition:border-color .15s}
.mf-textarea:focus{border-color:#2563eb}
.mf-charcount{text-align:right;font-size:11.5px;color:#94a3b8;margin:6px 0 20px}
.mf-note{display:flex;gap:7px;align-items:flex-start;font-size:12px;color:#94a3b8;margin-top:-10px;margin-bottom:20px}
.mf-note i{margin-top:2px}

.mf-btn{display:inline-flex;align-items:center;gap:7px;background:#0f172a;color:#fff;border:none;border-radius:10px;padding:11px 22px;font-size:14px;font-weight:600;cursor:pointer;transition:background .15s}
.mf-btn:hover:not(:disabled){background:#1e293b}
.mf-btn:disabled{background:#cbd5e1;cursor:not-allowed}

.mf-result-badge{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:700;border-radius:20px;padding:5px 13px;margin-bottom:14px}
.mf-result-badge--ok{background:#dcfce7;color:#15803d}
.mf-result-badge--fail{background:#fee2e2;color:#b91c1c}

.mf-answer-row{font-size:13.5px;color:#64748b;margin-bottom:8px}
.mf-answer-row b{color:#334155}
.mf-correct-row{font-size:14.5px;color:#0f172a;margin-bottom:14px}
.mf-correct-row b{color:#0f172a}
.mf-explain{display:flex;gap:9px;background:#f8fafc;border-radius:10px;padding:13px 15px;font-size:13px;color:#475569;line-height:1.6;margin-bottom:20px}
.mf-explain i{color:#94a3b8;margin-top:2px;flex-shrink:0}

.mf-done{text-align:center;padding:50px 26px}
.mf-done-icon{font-size:40px;color:#16a34a;margin-bottom:14px}
.mf-done-title{font-size:19px;font-weight:800;color:#0f172a;margin-bottom:6px}
.mf-done-sub{font-size:13.5px;color:#64748b;margin-bottom:22px}
</style>

<div class="fn-page">
    <div class="mf-wrap">

        <div class="mf-breadcrumb">Maarifləndirmə / Bilik yoxlaması</div>
        <div class="mf-title">@Model.Basliq</div>
        <div class="mf-subtitle">Sualları cavablandırın, testi tamamlayın.</div>

        <div class="mf-info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>Sualları kənar kömək olmadan cavablandırın.</strong>
                <span>Məqsəd hansı mövzularda əlavə dəstəyə ehtiyacınız olduğunu müəyyən etməkdir.</span>
            </div>
        </div>

        <div class="mf-progress-row"><span id="mfCariNo">1</span> / @Model.Suallar.Count sual</div>
        <div class="mf-progress-track"><div class="mf-progress-fill" id="mfProgressFill" style="width:0%"></div></div>

        <div class="mf-card" id="mfSualGovdesi"></div>

        <div id="mfBitdi" class="mf-card mf-done d-none">
            <div class="mf-done-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="mf-done-title">Test tamamlandı</div>
            <div class="mf-done-sub">Cavablarınız qeydə alındı.</div>
            <a asp-action="Index" class="mf-btn">Siyahıya qayıt</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const TIP_COX = 1;
    // DİQQƏT: MVC-nin Json() helper-i (fetch cavabları) default CAMEL CASE verir,
    // amma System.Text.Json.JsonSerializer.Serialize birbaşa çağırılanda PASCAL CASE
    // qaytarır (ayrı defolt) — ikisini EYNİ JS state-də işlətdiyimiz üçün burada
    // açıq CamelCase siyasəti verilir, yoxsa s.sualMetni/s.variantA undefined olardı.
    const suallar = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Suallar,
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
    const tesyinatId = @Model.TesyinatId;
    let idx = 0;

    const $ = (id) => document.getElementById(id);
    const esc = (s) => (s ?? '').toString()
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function setProgress() {
        $('mfCariNo').textContent = idx + 1;
        $('mfProgressFill').style.width = Math.round(((idx) / suallar.length) * 100) + '%';
    }

    async function cavabGonder(sualId, cavab) {
        const r = await fetch('@Url.Action("CavabVer")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tesyinatId, sualId, cavab })
        });
        return await r.json();
    }

    function badgeHtml(no, s) {
        const label = s.tip === TIP_COX ? 'Qapalı sual' : 'Açıq sual';
        const cls = s.tip === TIP_COX ? 'mf-badge--cox' : 'mf-badge--acig';
        return `<div class="mf-badge ${cls}">${String(no).padStart(2, '0')} · ${label}</div>`;
    }

    function neticeHtml(no, s, netice) {
        let badge = '';
        if (s.tip === TIP_COX) {
            badge = netice.duzgunduMu
                ? '<div class="mf-result-badge mf-result-badge--ok"><i class="bi bi-check-circle-fill"></i>Düzgün</div>'
                : '<div class="mf-result-badge mf-result-badge--fail"><i class="bi bi-x-circle-fill"></i>Səhv</div>';
        }
        const verilmis = netice.verilmisCavab
            ? `<div class="mf-answer-row"><b>Sizin cavabınız:</b> ${esc(netice.verilmisCavab)}</div>`
            : `<div class="mf-answer-row"><i>Boş buraxıldı</i></div>`;
        return `
            ${badgeHtml(no, s)}
            <div class="mf-q-text">${esc(s.sualMetni)}</div>
            <div style="margin-top:16px">
                ${badge}
                ${verilmis}
                <div class="mf-correct-row"><b>Düzgün cavab:</b> ${esc(netice.duzgunCavabMetni)}</div>
                <div class="mf-explain"><i class="bi bi-info-circle-fill"></i>${esc(netice.izahMetni)}</div>
            </div>
            <button type="button" class="mf-btn" id="mfNovbeti">
                ${idx + 1 >= suallar.length ? 'Bitir' : 'Növbəti sual →'}
            </button>`;
    }

    function sualFormHtml(no, s) {
        if (s.tip === TIP_COX) {
            const variantlar = [['A', s.variantA], ['B', s.variantB], ['C', s.variantC], ['D', s.variantD]];
            return `
                ${badgeHtml(no, s)}
                <div class="mf-q-text">${esc(s.sualMetni)}</div>
                <div class="mf-q-sub">Bir cavab seçin.</div>
                <div class="mf-options">
                    ${variantlar.map(([h, v]) => `
                        <label class="mf-option">
                            <input type="radio" name="mfVariant" value="${h}">
                            <span><strong>${h})</strong> ${esc(v)}</span>
                        </label>`).join('')}
                </div>
                <button type="button" class="mf-btn" id="mfCavablaBtn" disabled>Cavabla</button>`;
        }
        return `
            ${badgeHtml(no, s)}
            <div class="mf-q-text">${esc(s.sualMetni)}</div>
            <div class="mf-q-sub">Cavabınızı qısa və aydın yazın.</div>
            <textarea class="mf-textarea" id="mfAcigCavab" maxlength="1000" placeholder="Cavabınızı buraya yazın..."></textarea>
            <div class="mf-charcount"><span id="mfCharN">0</span> / 1000</div>
            <button type="button" class="mf-btn" id="mfCavablaBtn">Cavabla</button>`;
    }

    async function render() {
        if (idx >= suallar.length) {
            document.querySelector('.mf-breadcrumb').closest('.mf-wrap');
            $('mfProgressFill').style.width = '100%';
            document.querySelector('.mf-progress-row').classList.add('d-none');
            document.querySelector('.mf-card').classList.add('d-none');
            $('mfBitdi').classList.remove('d-none');
            return;
        }

        setProgress();
        const s = suallar[idx];
        const no = idx + 1;

        if (s.cavablanibMi) {
            $('mfSualGovdesi').innerHTML = `${badgeHtml(no, s)}<div class="mf-q-text">${esc(s.sualMetni)}</div><div class="text-muted mt-2">Yüklənir...</div>`;
            const d = await cavabGonder(s.sualId, '');
            if (d.ok) {
                $('mfSualGovdesi').innerHTML = neticeHtml(no, s, d.netice);
                $('mfNovbeti').addEventListener('click', () => { idx++; render(); });
            }
            return;
        }

        $('mfSualGovdesi').innerHTML = sualFormHtml(no, s);

        if (s.tip === TIP_COX) {
            document.querySelectorAll('input[name="mfVariant"]').forEach(r =>
                r.addEventListener('change', () => {
                    $('mfCavablaBtn').disabled = false;
                    document.querySelectorAll('.mf-option').forEach(o => o.classList.remove('mf-option--checked'));
                    r.closest('.mf-option').classList.add('mf-option--checked');
                }));
        } else {
            $('mfAcigCavab').addEventListener('input', function () {
                $('mfCharN').textContent = this.value.length;
            });
        }

        $('mfCavablaBtn').addEventListener('click', async () => {
            let cavab = '';
            if (s.tip === TIP_COX) {
                const secili = document.querySelector('input[name="mfVariant"]:checked');
                if (!secili) return;
                cavab = secili.value;
            } else {
                cavab = $('mfAcigCavab').value.trim();
                if (!cavab) return;
            }

            $('mfCavablaBtn').disabled = true;
            const d = await cavabGonder(s.sualId, cavab);
            if (!d.ok) { alert(d.xeta || 'Xəta baş verdi.'); $('mfCavablaBtn').disabled = false; return; }

            $('mfSualGovdesi').innerHTML = neticeHtml(no, s, d.netice);
            $('mfNovbeti').addEventListener('click', () => { idx++; render(); });
        });
    }

    render();
})();
</script>
}
