@using FinNex.Domain.Entities.Pid
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "SMS — PİD";
    var sablonlar = ViewBag.Sablonlar as IList<PidSmsSablon> ?? new List<PidSmsSablon>();
    var loglar = ViewBag.Loglar as IList<PidSmsLog> ?? new List<PidSmsLog>();

    string StatusText(PidSmsStatus s) => s switch
    {
        PidSmsStatus.Gozleyir => "Gözləyir",
        PidSmsStatus.Gonderildi => "Göndərildi",
        PidSmsStatus.Catdirildi => "Çatdırıldı",
        PidSmsStatus.Catmadi => "Çatmadı",
        PidSmsStatus.Xeta => "Xəta",
        _ => "-"
    };
    string StatusRengi(PidSmsStatus s) => s switch
    {
        PidSmsStatus.Catdirildi => "#16a34a",
        PidSmsStatus.Gonderildi => "#0ea5e9",
        PidSmsStatus.Xeta => "#dc2626",
        PidSmsStatus.Catmadi => "#dc2626",
        _ => "#f59e0b"
    };
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">SMS</div>
            <div class="fn-page-sub">Problemli İşlər Departamenti — Göyərçin gateway</div>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <button type="button" onclick="location.reload()" class="fn-btn fn-btn--outline" title="Səhifəni yenilə">
                <i class="bi bi-arrow-clockwise"></i> Yenilə
            </button>
            <a asp-action="Sablonlar" class="fn-btn fn-btn--outline">
                <i class="bi bi-file-earmark-text"></i> Şablonları idarə et
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="fn-alert fn-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
    }

    @* ── Yeni SMS göndərmə formu ── *@
    <div class="fn-card" style="padding:18px;margin-bottom:16px">
        <div style="font-size:14px;font-weight:700;color:#0f172a;margin-bottom:12px">Yeni SMS</div>
        <form asp-action="Gonder" method="post" novalidate id="tekSmsForm">
            @Html.AntiForgeryToken()
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div class="fn-form-group">
                    <label class="fn-label">Telefon *</label>
                    <input type="text" name="telefon" id="tekTelefon" class="fn-input" placeholder="994551234567 və ya 0551234567" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Şablon (istəyə bağlı)</label>
                    <select name="sablonId" class="fn-input" id="smsSablon" onchange="sablonTetbiqEt(this)">
                        <option value="">— sərbəst mətn —</option>
                        @foreach (var s in sablonlar)
                        {
                            <option value="@s.Id" data-metn="@s.Metn">@s.Ad</option>
                        }
                    </select>
                </div>
            </div>
            <div class="fn-form-group" style="margin-top:8px">
                <label class="fn-label">Mətn * (max 1000 simvol, English)</label>
                <textarea name="metn" id="smsMetn" class="fn-input" rows="4" maxlength="1000"></textarea>
                <div style="font-size:12px;color:#64748b;margin-top:4px"><span id="charCount">0</span> / 1000</div>
            </div>
            <div style="display:flex;justify-content:flex-end;margin-top:12px">
                <button type="submit" class="fn-btn fn-btn--primary">
                    <i class="bi bi-send"></i> Göndər
                </button>
            </div>
        </form>
    </div>

    @* ── Toplu SMS ── *@
    <div class="fn-card" style="padding:18px;margin-bottom:16px" id="topluSmsCard">

        @* Başlıq + düymələr *@
        <div style="margin-bottom:14px">
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
                <div style="font-size:14px;font-weight:700;color:#0f172a">
                    <i class="bi bi-people-fill me-1 text-primary"></i> Toplu SMS
                </div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <button type="button" class="fn-btn fn-btn--outline" id="btnBorcalanlarGetir" onclick="borcalanlarGetir()">
                        <i class="bi bi-cloud-download"></i> VK Borcalanlar
                    </button>
                    <button type="button" class="fn-btn fn-btn--outline" id="btnZaminlerGetir" onclick="zaminlerGetir()">
                        <i class="bi bi-people"></i> VK Borcalan Zaminləri
                    </button>
                    <button type="button" class="fn-btn fn-btn--outline" id="btnExcel" onclick="document.getElementById('excelInput').click()">
                        <i class="bi bi-file-earmark-excel"></i> Excel Yüklə
                    </button>
                    <input type="file" id="excelInput" accept=".xlsx" style="display:none" />
                </div>
            </div>
            <div style="margin-top:8px;padding:10px 12px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
                <span style="font-size:12px;font-weight:600;color:#64748b;white-space:nowrap">
                    <i class="bi bi-calendar2-check me-1"></i> Ödəniş günü olanlar:
                </span>
                <input type="date" id="odenisGunuTarix" class="fn-input"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       style="width:150px;padding:5px 10px;font-size:13px" />
                <button type="button" class="fn-btn fn-btn--outline" id="btnOdenisGunuGetir" onclick="odenisGunuGetir()" style="white-space:nowrap">
                    <i class="bi bi-arrow-down-circle"></i> Gətir
                </button>
            </div>
        </div>

        <div id="topluXeta" style="display:none;background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px"></div>
        <div id="topluUgur" style="display:none;background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px"></div>

        @* Önizləmə — həmişə görünür, mətn varsa *@
        <div id="onizlemeBlok" style="display:none;border:1px dashed #cbd5e1;border-radius:6px;padding:10px 12px;background:#f8fafc;margin-bottom:12px">
            <div style="font-size:11px;font-weight:600;color:#64748b;margin-bottom:4px;text-transform:uppercase;letter-spacing:.5px">
                <i class="bi bi-eye"></i> Önizləmə
                <span id="onizlemeAdLabel" style="font-weight:400;color:#94a3b8;margin-left:4px"></span>
            </div>
            <div id="onizlemeMetn" style="font-size:13px;color:#0f172a;white-space:pre-wrap;word-break:break-word"></div>
        </div>

        <div id="topluSmsPanel" style="display:none">

            @* Filter sətri *@
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
                <input type="text" id="topluFilter" class="fn-input" placeholder="Ad və ya telefona görə axtar..."
                       oninput="topluFilterEt()" style="max-width:300px" />
                <span id="topluSay" style="font-size:13px;color:#64748b;white-space:nowrap"></span>
                <span id="aktivSiyahiBecj" style="display:none;font-size:11px;font-weight:600;padding:3px 9px;border-radius:20px;white-space:nowrap;background:#dbeafe;color:#1d4ed8;border:1px solid #bfdbfe"></span>
                <div style="margin-left:auto;display:flex;gap:6px;flex-wrap:wrap">
                    <button type="button" class="fn-btn fn-btn--outline" onclick="tamSiyahiExcel()"
                            title="Tam SQL nəticəsini Excel-ə çıxart"
                            style="font-size:12px;padding:5px 10px;white-space:nowrap;color:#15803d;border-color:#86efac">
                        <i class="bi bi-file-earmark-excel"></i> Tam siyahı → Excel
                    </button>
                    <button type="button" class="fn-btn fn-btn--outline" onclick="uygunsuzNomrelerExcel()"
                            title="Rəqəm sayı 9-dan çox olan nömrələri Excel-ə çıxart"
                            style="font-size:12px;padding:5px 10px;white-space:nowrap">
                        <i class="bi bi-file-earmark-excel text-warning"></i> Uyğunsuz Nömrələr
                    </button>
                </div>
            </div>

            @* Cədvəl *@
            <div style="border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;margin-bottom:16px">
                <div style="max-height:320px;overflow-y:auto">
                    <table style="width:100%;border-collapse:collapse;font-size:13px" id="topluCedvel">
                        <thead>
                            <tr style="background:#f1f5f9;border-bottom:2px solid #e2e8f0">
                                <th style="padding:9px 12px;width:40px;text-align:center">
                                    <input type="checkbox" id="hamisiSec" onchange="hamisiSec(this)" title="Hamısını seç/ləğv et" />
                                </th>
                                <th style="padding:9px 12px;text-align:left;font-weight:600;color:#374151">Ad</th>
                                <th style="padding:9px 12px;text-align:left;font-weight:600;color:#374151;width:160px">Telefon</th>
                                <th style="padding:9px 12px;width:36px"></th>
                            </tr>
                        </thead>
                        <tbody id="topluTbody"></tbody>
                    </table>
                </div>
            </div>

            @* SMS mətni *@
            <div style="border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;margin-bottom:0">
                <div style="padding:10px 14px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-size:13px;font-weight:600;color:#374151;display:flex;justify-content:space-between;align-items:center">
                    <span>SMS mətni</span>
                    <span style="font-size:11px;font-weight:400;color:#64748b">
                        <i class="bi bi-info-circle"></i> <code>{{1}}</code> — ad &nbsp;|&nbsp; <code>{{2}}</code> — ödəniş tarixi
                    </span>
                </div>
                <div style="padding:14px;background:#fff">
                    <textarea id="topluMetn" class="fn-input" rows="3" maxlength="1000"
                              placeholder="Hörmətli {AD}, kredit borcunuzu ödəməyinizi xahiş edirik."
                              oninput="onizlemeyiGuncelle();document.getElementById('topluCharCount').textContent=this.value.length"
                              style="margin-bottom:4px"></textarea>
                    <div style="font-size:12px;color:#94a3b8;margin-bottom:12px"><span id="topluCharCount">0</span> / 1000</div>

                    <div style="display:flex;justify-content:flex-end">
                        <button type="button" class="fn-btn fn-btn--primary" onclick="topluGonder()" id="btnTopluGonder">
                            <i class="bi bi-send-fill"></i> SMS Göndər
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Tarixçə ── *@
    <div class="fn-card" style="padding:0">
        <div style="padding:14px 18px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;user-select:none"
             onclick="tarixceToggle()">
            <div style="font-size:14px;font-weight:700;color:#0f172a">
                SMS tarixçəsi
                @if (loglar.Any())
                {
                    <span style="font-size:12px;font-weight:400;color:#64748b;margin-left:6px">@loglar.Count qeyd</span>
                }
            </div>
            <button type="button" id="btnTarixce"
                    style="background:none;border:1px solid #e2e8f0;border-radius:6px;padding:4px 12px;font-size:12px;color:#475569;cursor:pointer;display:flex;align-items:center;gap:5px">
                <i class="bi bi-chevron-down" id="tarixceIcon"></i>
                <span id="tarixceBtnMetn">Göstər</span>
            </button>
        </div>
        <div id="tarixceBlok" style="display:none;border-top:1px solid #e2e8f0">
            @if (!loglar.Any())
            {
                <div style="padding:30px;text-align:center;color:#64748b;font-size:13px">Hələ SMS göndərilməyib.</div>
            }
            else
            {
                <table style="width:100%;border-collapse:collapse;font-size:13px">
                    <thead style="background:#f8fafc">
                        <tr>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Tarix</th>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Telefon</th>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Mətn</th>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Şablon</th>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Status</th>
                            <th style="text-align:left;padding:10px 14px;font-weight:600;color:#475569">Göndərən</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in loglar)
                        {
                            <tr style="border-top:1px solid #f1f5f9">
                                <td style="padding:10px 14px;color:#475569;white-space:nowrap">@l.YaradilmaTarixi.ToString("dd.MM.yy HH:mm")</td>
                                <td style="padding:10px 14px;color:#0f172a;font-family:monospace">@l.Telefon</td>
                                <td style="padding:10px 14px;color:#334155;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@l.Metn">@l.Metn</td>
                                <td style="padding:10px 14px;color:#64748b">@(l.Sablon?.Ad ?? "—")</td>
                                <td style="padding:10px 14px">
                                    <span style="display:inline-block;padding:2px 10px;border-radius:12px;font-size:12px;font-weight:600;color:#fff;background:@StatusRengi(l.Status)">
                                        @StatusText(l.Status)
                                    </span>
                                    @if (!string.IsNullOrEmpty(l.Xeta))
                                    {
                                        <div style="font-size:11px;color:#dc2626;margin-top:2px" title="@l.Xeta">@(l.Xeta.Length > 40 ? l.Xeta.Substring(0,40) + "…" : l.Xeta)</div>
                                    }
                                </td>
                                <td style="padding:10px 14px;color:#64748b">@(l.GonderenIsci?.TamAd ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

<script>
    var pidRawData = []; // tam Oracle nəticəsi

    function tamSiyahiExcel() {
        if (!pidRawData || !pidRawData.length) { alert('Əvvəlcə siyahını yükləyin.'); return; }
        var headers = Object.keys(pidRawData[0]);
        var csv = headers.join(',') + '\n' + pidRawData.map(function (r) {
            return headers.map(function (h) {
                return '"' + String(r[h] || '').replace(/"/g, '""') + '"';
            }).join(',');
        }).join('\n');
        var blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'pid_siyahisi.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    function pidTarixceToggle(header) {
        var body = document.getElementById('pidTarixceBody');
        var ikon = document.getElementById('pidTarixceIkon');
        var aciqdir = body.style.display !== 'none';
        body.style.display = aciqdir ? 'none' : '';
        ikon.textContent   = aciqdir ? '▼ göstər' : '▲ gizlət';
    }

    function pidMetnToggle(btn) {
        var tam = btn.closest('td').querySelector('.pid-metn-tam');
        var aciqdir = tam.style.display !== 'none';
        tam.style.display = aciqdir ? 'none' : '';
        btn.textContent   = aciqdir ? '▼ mətni gör' : '▲ yığ';
    }

    document.getElementById('tekSmsForm').addEventListener('submit', function (e) {
        var tel = document.getElementById('tekTelefon').value.trim();
        var metn = document.getElementById('smsMetn').value.trim();
        if (!tel || !metn) {
            e.preventDefault();
            if (!tel) { document.getElementById('tekTelefon').focus(); alert('Telefon nömrəsi daxil edin.'); }
            else { document.getElementById('smsMetn').focus(); alert('SMS mətnini daxil edin.'); }
        }
    });

    function sablonTetbiqEt(sel) {
        var opt = sel.options[sel.selectedIndex];
        var m = opt.getAttribute('data-metn');
        if (m) {
            document.getElementById('smsMetn').value = m;
            yenileCharCount();
            document.getElementById('topluMetn').value = m;
            document.getElementById('topluCharCount').textContent = m.length;
            onizlemeyiGuncelle();
        }
    }
    function yenileCharCount() {
        var m = document.getElementById('smsMetn');
        document.getElementById('charCount').textContent = m.value.length;
    }
    document.getElementById('smsMetn').addEventListener('input', yenileCharCount);

    // ── Toplu SMS ──────────────────────────────────────────

    // AZ mobil nömrə validasiyası
    // Faktiki nömrə əsasında yoxlayır: başında tək 0 varsa çıxarır, sonra 9 rəqəm + düzgün prefiks
    var GECERLI_PREFIKSLƏR = ['50','51','55','99','70','77','60'];
    function nomreUygundu(tel) {
        var r = (String(tel || '').match(/\d/g) || []).join('');
        if (r.charAt(0) === '0') r = r.substring(1);
        return r.length === 9 && GECERLI_PREFIKSLƏR.some(function(p) { return r.startsWith(p); });
    }

    function onizlemeyiGuncelle() {
        var metn = document.getElementById('topluMetn').value;
        var blok = document.getElementById('onizlemeBlok');
        if (!metn) { blok.style.display = 'none'; return; }
        var ilkRow = document.querySelector('#topluTbody tr:not([style*="display: none"])');
        var ilkAd = ilkRow ? (ilkRow.querySelectorAll('td')[1]?.textContent.trim() || '') : '';
        var ilkTarix = ilkRow ? (ilkRow.getAttribute('data-odenis-tarixi') || '') : '';
        document.getElementById('onizlemeMetn').textContent = metn
            .replace(/\{\{1\}\}/g, ilkAd || '{{1}}')
            .replace(/\{\{2\}\}/g, ilkTarix || '{{2}}')
            .replace(/\{AD\}/gi, ilkAd || '{AD}');
        document.getElementById('onizlemeAdLabel').textContent = ilkAd ? '(' + ilkAd + ' üçün)' : '';
        blok.style.display = 'block';
    }

    async function borcalanlarGetir() {
        var btn = document.getElementById('btnBorcalanlarGetir');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Yüklənir...';
        gizleXeta(); gizleUgur();
        try {
            var resp = await fetch('@Url.Action("BorcalanlarGetir", "PidSms", new { area = "User" })');
            var json = await resp.json();
            if (json.error) { gosterXeta(json.error); return; }
            aktivSiyahiGoster('VK Borcalanlar', 'blue');
            cedveldoldir(json.data, json.sorguAdi, json.rawData);
        } catch (e) {
            gosterXeta('Şəbəkə xətası: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-cloud-download"></i> VK Borcalanlar';
        }
    }

    async function zaminlerGetir() {
        var btn = document.getElementById('btnZaminlerGetir');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Yüklənir...';
        gizleXeta(); gizleUgur();
        try {
            var resp = await fetch('@Url.Action("ZaminlerGetir", "PidSms", new { area = "User" })');
            var json = await resp.json();
            if (json.error) { gosterXeta(json.error); return; }
            aktivSiyahiGoster('VK Borcalan Zaminləri', 'purple');
            cedveldoldir(json.data, json.sorguAdi, json.rawData);
        } catch (e) {
            gosterXeta('Şəbəkə xətası: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-people"></i> VK Borcalan Zaminləri';
        }
    }

    function uygunsuzNomrelerExcel() {
        var rows = [];
        document.querySelectorAll('#topluTbody tr').forEach(function (tr) {
            if (tr.getAttribute('data-uygunsuz') !== '1') return;
            var cells = tr.querySelectorAll('td');
            if (cells.length < 3) return;
            var ad = cells[1].textContent.trim();
            var telInput = cells[2].querySelector('.tel-input');
            var tel = telInput ? telInput.value.trim() : '';
            rows.push({ ad: ad, telefon: tel, faktikiNomre: tr.getAttribute('data-faktiki') || '' });
        });
        if (rows.length === 0) { alert('Uyğunsuz nömrə tapılmadı.'); return; }
        var csv = 'Ad,Nömrə,Faktiki Nömrə\n' + rows.map(function (r) {
            return '"' + r.ad.replace(/"/g, '""') + '","' + r.telefon.replace(/"/g, '""') + '","' + r.faktikiNomre.replace(/"/g, '""') + '"';
        }).join('\n');
        var blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'uygunsuz_nomreler.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    async function odenisGunuGetir() {
        var tarix = document.getElementById('odenisGunuTarix').value;
        if (!tarix) { alert('Tarix seçin.'); return; }
        var btn = document.getElementById('btnOdenisGunuGetir');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Yüklənir...';
        gizleXeta(); gizleUgur();
        try {
            var url = '@Url.Action("OdenisGunuGetir", "PidSms", new { area = "User" })' + '?tarix=' + encodeURIComponent(tarix);
            var resp = await fetch(url);
            var json = await resp.json();
            if (json.error) { gosterXeta(json.error); return; }
            aktivSiyahiGoster('Ödəniş günü — ' + tarix, 'green');
            cedveldoldir(json.data, json.sorguAdi, json.rawData);
        } catch (e) {
            gosterXeta('Şəbəkə xətası: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-calendar2-check"></i> Ödəniş günü olanlar';
        }
    }

    document.getElementById('excelInput').addEventListener('change', async function () {
        if (!this.files.length) return;
        var btn = document.getElementById('btnExcel');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Yüklənir...';
        gizleXeta(); gizleUgur();
        try {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            var fd = new FormData();
            fd.append('excel', this.files[0]);
            fd.append('__RequestVerificationToken', token);
            var resp = await fetch('@Url.Action("ExceldenYukle", "PidSms", new { area = "User" })', { method: 'POST', body: fd });
            var json = await resp.json();
            if (json.error) { gosterXeta(json.error); return; }
            aktivSiyahiGoster('Excel: ' + this.files[0].name, 'green');
            cedveldoldir(json.data, json.sorguAdi, json.rawData);
        } catch (e) {
            gosterXeta('Şəbəkə xətası: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-file-earmark-excel"></i> Excel Yüklə';
            this.value = '';
        }
    });

    function aktivSiyahiGoster(ad, stil) {
        var el = document.getElementById('aktivSiyahiBecj');
        el.textContent = '• ' + ad;
        el.style.display = 'inline-block';
        var palettes = {
            blue:   ['#dbeafe','#1d4ed8','#bfdbfe'],
            purple: ['#f3e8ff','#7e22ce','#e9d5ff'],
            green:  ['#dcfce7','#15803d','#bbf7d0']
        };
        var p = palettes[stil] || palettes.blue;
        el.style.background   = p[0];
        el.style.color        = p[1];
        el.style.borderColor  = p[2];
    }

    function cedveldoldir(data, sorguAdi, rawData) {
        pidRawData = rawData || [];
        var tbody = document.getElementById('topluTbody');
        tbody.innerHTML = '';
        if (!data || data.length === 0) {
            gosterXeta('Sorğu nəticəsi boşdur.');
            document.getElementById('topluSmsPanel').style.display = 'none';
            return;
        }
        data.forEach(function (item, i) {
            var tr = document.createElement('tr');
            // İlkin yoxlama faktiki nömrəyə əsaslanır (SQL kəsmə problemlərini də tutur)
            var uygun = nomreUygundu(item.faktikiNomre || item.telefon);
            tr.style.background = uygun ? (i % 2 === 0 ? '#fff' : '#f8fafc') : '#fef2f2';
            tr.setAttribute('data-ad', (item.ad || '').toLowerCase());
            tr.setAttribute('data-tel', (item.telefon || '').toLowerCase());
            tr.setAttribute('data-faktiki', item.faktikiNomre || '');
            tr.setAttribute('data-uygunsuz', uygun ? '0' : '1');
            tr.setAttribute('data-odenis-tarixi', item.odenisTarixi || '');
            var faktikiHtml = item.faktikiNomre
                ? '<div style="font-size:11px;color:#94a3b8;margin-top:2px;font-family:monospace" title="Oracle-dəki faktiki nömrə">' + escHtml(item.faktikiNomre) + '</div>'
                : '';
            tr.innerHTML =
                '<td style="padding:8px 12px;text-align:center;border-top:1px solid #f1f5f9"><input type="checkbox" class="alici-chk" checked /></td>' +
                '<td style="padding:8px 12px;color:#0f172a;border-top:1px solid #f1f5f9">' + escHtml(item.ad) + '</td>' +
                '<td style="padding:6px 8px;border-top:1px solid #f1f5f9"><input type="text" class="tel-input" value="' + escHtml(item.telefon) + '" style="font-family:monospace;font-size:13px;border:1px solid #e2e8f0;border-radius:4px;padding:3px 6px;width:100%;max-width:150px;background:#fff" />' + faktikiHtml + '</td>' +
                '<td style="padding:8px 12px;text-align:center;border-top:1px solid #f1f5f9"><button type="button" onclick="siliSatiri(this)" title="Sil" style="background:none;border:none;color:#dc2626;cursor:pointer;font-size:15px;padding:0 4px;line-height:1">&times;</button></td>';
            tbody.appendChild(tr);
            tr.querySelector('.tel-input').addEventListener('input', function() {
                var u = nomreUygundu(this.value);
                tr.style.background = u ? '#fff' : '#fef2f2';
                tr.setAttribute('data-uygunsuz', u ? '0' : '1');
            });
        });
        document.getElementById('topluSmsPanel').style.display = 'block';
        document.getElementById('hamisiSec').checked = true;
        document.getElementById('topluFilter').value = '';
        sayGuncelle();
        onizlemeyiGuncelle();
    }

    function siliSatiri(btn) {
        btn.closest('tr').remove();
        sayGuncelle();
        onizlemeyiGuncelle();
    }

    function topluFilterEt() {
        var q = document.getElementById('topluFilter').value.toLowerCase();
        document.querySelectorAll('#topluTbody tr').forEach(function (tr) {
            var match = (tr.getAttribute('data-ad') || '').includes(q) ||
                        (tr.getAttribute('data-tel') || '').includes(q);
            tr.style.display = match ? '' : 'none';
        });
        sayGuncelle();
    }

    function hamisiSec(cb) {
        document.querySelectorAll('#topluTbody tr:not([style*="display: none"]):not([style*="display:none"]) .alici-chk')
            .forEach(function (chk) { chk.checked = cb.checked; });
        sayGuncelle();
    }

    function sayGuncelle() {
        var rows = document.querySelectorAll('#topluTbody tr');
        var gorunen = 0, secili = 0;
        rows.forEach(function (tr) {
            if (tr.style.display === 'none') return;
            gorunen++;
            if (tr.querySelector('.alici-chk:checked')) secili++;
        });
        document.getElementById('topluSay').textContent = gorunen + ' nəticə, ' + secili + ' seçili';
    }

    document.getElementById('topluTbody').addEventListener('change', function (e) {
        if (e.target.classList.contains('alici-chk')) sayGuncelle();
    });

    async function topluGonder() {
        var metn = document.getElementById('topluMetn').value.trim();
        if (!metn) { alert('SMS mətni boş ola bilməz.'); return; }

        var alicilar = [];
        document.querySelectorAll('#topluTbody tr').forEach(function (tr) {
            if (tr.style.display === 'none') return;
            var chk = tr.querySelector('.alici-chk');
            if (!chk || !chk.checked) return;
            var cells = tr.querySelectorAll('td');
            var telInput = cells[2]?.querySelector('.tel-input');
            alicilar.push({
                ad: cells[1].textContent.trim(),
                telefon: telInput ? telInput.value.trim() : cells[2].textContent.trim(),
                odenisTarixi: tr.getAttribute('data-odenis-tarixi') || ''
            });
        });

        if (alicilar.length === 0) { alert('Heç bir alıcı seçilməyib.'); return; }
        if (!confirm(alicilar.length + ' müştəriyə SMS göndərilsin?')) return;

        var btn = document.getElementById('btnTopluGonder');
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Göndərilir...';
        gizleXeta(); gizleUgur();
        try {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            var fd = new FormData();
            fd.append('alicilarJson', JSON.stringify(alicilar));
            fd.append('smsMetni', metn);
            fd.append('__RequestVerificationToken', token);
            var resp = await fetch('@Url.Action("TopluGonder", "PidSms", new { area = "User" })', { method: 'POST', body: fd });
            var json = await resp.json();
            if (json.error) { gosterXeta(json.error); return; }
            gosterUgur('Göndərildi: ' + json.ugur + ' uğurlu, ' + json.xeta + ' xətalı.');
        } catch (e) {
            gosterXeta('Şəbəkə xətası: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill"></i> SMS Göndər';
        }
    }

    function gosterXeta(msg) { var el = document.getElementById('topluXeta'); el.textContent = msg; el.style.display = 'block'; }
    function gizleXeta()     { document.getElementById('topluXeta').style.display = 'none'; }
    function gosterUgur(msg) { var el = document.getElementById('topluUgur'); el.textContent = msg; el.style.display = 'block'; }
    function gizleUgur()     { document.getElementById('topluUgur').style.display = 'none'; }
    function escHtml(s)      { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    function tarixceToggle() {
        var blok = document.getElementById('tarixceBlok');
        var icon = document.getElementById('tarixceIcon');
        var metn = document.getElementById('tarixceBtnMetn');
        var aciq = blok.style.display !== 'none';
        blok.style.display = aciq ? 'none' : 'block';
        icon.className     = aciq ? 'bi bi-chevron-down' : 'bi bi-chevron-up';
        metn.textContent   = aciq ? 'Göstər' : 'Gizlət';
    }
</script>
