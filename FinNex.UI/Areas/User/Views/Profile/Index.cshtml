@model FinNex.Domain.Entities.HR.Isci
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Profil";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var aktivTeyinat = Model.IsciTeyinatlari?.FirstOrDefault(t => t.Aktivdir);
    var departament = aktivTeyinat?.Departament?.Ad ?? "—";
    var vezife = aktivTeyinat?.Vezife?.Ad ?? "—";

    var initials = "";
    if (!string.IsNullOrEmpty(Model.Ad)) initials += Model.Ad[0];
    if (!string.IsNullOrEmpty(Model.Soyad)) initials += Model.Soyad[0];

    // Status badge
    var statusText = Model.Status switch
    {
        IsciStatus.Aktiv => "Aktiv",
        IsciStatus.Mezuniyyetde => "Məzuniyyətdə",
        IsciStatus.IshtenCixib => "İşdən çıxıb",
        _ => "—"
    };
    var statusClass = Model.Status switch
    {
        IsciStatus.Aktiv => "up-badge-aktiv",
        IsciStatus.Mezuniyyetde => "up-badge-mezuniyyetde",
        _ => "up-badge-deaktiv"
    };

    // Staj calculation
    var stajStart = Model.IsheQebulTarixi;
    var stajEnd = Model.IsdenAyrilmaTarixi ?? DateTime.Today;
    var stajTotalMonths = ((stajEnd.Year - stajStart.Year) * 12) + stajEnd.Month - stajStart.Month;
    var stajYears = stajTotalMonths / 12;
    var stajMonths = stajTotalMonths % 12;

    // Məzuniyyət balansları — BÜTÜN illərin CƏMİ (keçmiş illərdən qalan
    // günlər cari ilin balansına əlavə olunur). Hər növ üçün mock obyekt
    // yaradılır ki, RenderLeaveItem helper-i dəyişməsin.
    var currentYear = DateTime.Now.Year;
    var balansAll = Model.MezuniyyetBalanslari?.ToList() ?? new List<MezuniyyetBalans>();

    MezuniyyetBalans? CemBalans(MezuniyyetNovu nov)
    {
        var liste = balansAll.Where(b => b.Nov == nov).ToList();
        if (!liste.Any()) return null;
        return new MezuniyyetBalans
        {
            Nov = nov,
            ToplamGun = liste.Sum(b => b.ToplamGun),
            IstifadeOlunanGun = liste.Sum(b => b.IstifadeOlunanGun)
        };
    }

    var illik = CemBalans(MezuniyyetNovu.Illik);
    var xestelik = CemBalans(MezuniyyetNovu.Xestelik);
    var ezamiyyet = CemBalans(MezuniyyetNovu.Ezamiyyet);
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-profile.css" asp-append-version="true" />
}

<div class="up-page">

    <!-- ═══ A. Profile Header ═══ -->
    <div class="up-header-card">
        <div class="up-avatar">@initials</div>
        <div class="up-header-info">
            <div class="up-header-name">@Model.TamAd</div>
            <div class="up-header-position">@departament &mdash; @vezife</div>
            <div class="up-header-meta">
                <span class="up-badge @statusClass">
                    <i class="bi bi-circle-fill" style="font-size:7px"></i>
                    @statusText
                </span>
                <span class="up-header-stat">
                    <i class="bi bi-calendar3"></i>
                    İşə qəbul: <strong>@Model.IsheQebulTarixi.ToString("dd.MM.yyyy")</strong>
                </span>
                <span class="up-header-stat">
                    <i class="bi bi-clock-history"></i>
                    Staj: <strong>@stajYears il @stajMonths ay</strong>
                </span>
            </div>
        </div>
    </div>

    <div class="up-grid">

        <!-- ═══ B. Sexsi Melumatlar ═══ -->
        <div class="up-card">
            <div class="up-card-title">
                <i class="bi bi-person-vcard"></i>
                Şəxsi Məlumatlar
            </div>

            <div class="up-row">
                <span class="up-row-label">FIN</span>
                <span class="up-row-value">@Model.FIN</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">Seriya / Nömrə</span>
                <span class="up-row-value">@Model.SeriyaNomre</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">Doğum tarixi</span>
                <span class="up-row-value">@Model.DogumTarixi.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">Cins</span>
                <span class="up-row-value">@(Model.Cins == Cins.Kisi ? "Kişi" : "Qadın")</span>
            </div>

            <!-- Editable: Telefon -->
            <div class="up-row">
                <span class="up-row-label">Telefon</span>
                <div class="up-editable-wrap">
                    <span class="up-editable-display @(string.IsNullOrEmpty(Model.Telefon) ? "up-empty" : "")"
                          data-display="telefon"
                          data-value="@(Model.Telefon ?? "")">
                        @(string.IsNullOrEmpty(Model.Telefon) ? "Daxil edilməyib" : Model.Telefon)
                    </span>
                    <input type="text" class="up-edit-input" data-input="telefon"
                           placeholder="Telefon nömrəsi" />
                    <button type="button" class="up-edit-btn" data-edit-btn="telefon"
                            title="Redaktə et">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                </div>
            </div>

            <!-- Editable: Email -->
            <div class="up-row">
                <span class="up-row-label">Email</span>
                <div class="up-editable-wrap">
                    <span class="up-editable-display @(string.IsNullOrEmpty(Model.Email) ? "up-empty" : "")"
                          data-display="email"
                          data-value="@(Model.Email ?? "")">
                        @(string.IsNullOrEmpty(Model.Email) ? "Daxil edilməyib" : Model.Email)
                    </span>
                    <input type="email" class="up-edit-input" data-input="email"
                           placeholder="E-poçt ünvanı" />
                    <button type="button" class="up-edit-btn" data-edit-btn="email"
                            title="Redaktə et">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                </div>
            </div>

            <!-- Editable: Unvan -->
            <div class="up-row">
                <span class="up-row-label">Ünvan</span>
                <div class="up-editable-wrap">
                    <span class="up-editable-display @(string.IsNullOrEmpty(Model.Unvan) ? "up-empty" : "")"
                          data-display="unvan"
                          data-value="@(Model.Unvan ?? "")">
                        @(string.IsNullOrEmpty(Model.Unvan) ? "Daxil edilməyib" : Model.Unvan)
                    </span>
                    <input type="text" class="up-edit-input" data-input="unvan"
                           placeholder="Yaşayış ünvanı" />
                    <button type="button" class="up-edit-btn" data-edit-btn="unvan"
                            title="Redaktə et">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                </div>
            </div>

            <div class="up-save-row">
                <button type="button" class="up-save-btn" id="upSaveBtn">
                    <i class="bi bi-check-lg"></i>
                    Yadda saxla
                </button>
            </div>
        </div>

        <!-- ═══ C. Is Melumatlari ═══ -->
        <div class="up-card">
            <div class="up-card-title">
                <i class="bi bi-briefcase"></i>
                İş Məlumatları
            </div>

            <div class="up-row">
                <span class="up-row-label">Departament</span>
                <span class="up-row-value">@departament</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">Vəzifə</span>
                <span class="up-row-value">@vezife</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">İşə qəbul tarixi</span>
                <span class="up-row-value">@Model.IsheQebulTarixi.ToString("dd.MM.yyyy")</span>
            </div>
            <div class="up-row">
                <span class="up-row-label">Status</span>
                <span class="up-row-value">
                    <span class="up-badge @statusClass">@statusText</span>
                </span>
            </div>
            <div class="up-row">
                <span class="up-row-label">İş stajı</span>
                <span class="up-row-value">@stajYears il @stajMonths ay</span>
            </div>
        </div>

        <!-- ═══ D. Maliyye Melumatlari ═══ -->
        <div class="up-card">
            <div class="up-card-title">
                <i class="bi bi-cash-stack"></i>
                Maliyyə Məlumatları
            </div>

            @if (Model.Maliye != null)
            {
                <div class="up-row">
                    <span class="up-row-label">Cari maaş</span>
                    <span class="up-row-value">@Model.Maliye.CariMaas.ToString("N2") AZN</span>
                </div>
                <div class="up-row">
                    <span class="up-row-label">IBAN / Bank hesab</span>
                    <span class="up-row-value">
                        @if (!string.IsNullOrEmpty(Model.Maliye.BankHesabNo))
                        {
                            @Model.Maliye.BankHesabNo
                        }
                        else
                        {
                            <span class="up-empty">Daxil edilməyib</span>
                        }
                    </span>
                </div>
                <div class="up-row">
                    <span class="up-row-label">Sosial sığorta nömrəsi</span>
                    <span class="up-row-value">
                        @if (!string.IsNullOrEmpty(Model.Maliye.SosialSigortaNo))
                        {
                            @Model.Maliye.SosialSigortaNo
                        }
                        else
                        {
                            <span class="up-empty">Daxil edilməyib</span>
                        }
                    </span>
                </div>
            }
            else
            {
                <div class="up-row">
                    <span class="up-row-label">Məlumat</span>
                    <span class="up-row-value up-empty">Maliyyə məlumatları mövcud deyil</span>
                </div>
            }
        </div>

        <!-- ═══ E. Mezuniyyet Balansi ═══ -->
        <div class="up-card">
            <div class="up-card-title">
                <i class="bi bi-calendar2-check"></i>
                Məzuniyyət Balansı — @currentYear
            </div>

            @{
                void RenderLeaveItem(string label, MezuniyyetBalans? balance, string fillClass)
                {
                    var toplam = balance?.ToplamGun ?? 0;
                    var istifade = balance?.IstifadeOlunanGun ?? 0;
                    var qaliq = toplam - istifade;
                    var pct = toplam > 0 ? (int)Math.Round((double)istifade / toplam * 100) : 0;

                    <div class="up-leave-item">
                        <div class="up-leave-header">
                            <span class="up-leave-label">@label</span>
                            <span class="up-leave-numbers">
                                <strong>@qaliq</strong> gün qalıb
                            </span>
                        </div>
                        <div class="up-progress-track">
                            <div class="up-progress-fill @fillClass" style="width: @(pct)%"></div>
                        </div>
                        <div class="up-leave-detail">
                            <span>Toplam: @toplam gün</span>
                            <span>İstifadə: @istifade gün</span>
                            <span>Qalıq: @qaliq gün</span>
                        </div>
                    </div>
                }

                void RenderUsedOnlyItem(string label, MezuniyyetBalans? balance, string fillClass)
                {
                    var istifade = balance?.IstifadeOlunanGun ?? 0;

                    <div class="up-leave-item">
                        <div class="up-leave-header">
                            <span class="up-leave-label">@label</span>
                            <span class="up-leave-numbers">
                                <strong>@istifade</strong> gün istifadə olunub
                            </span>
                        </div>
                    </div>
                }
            }

            @{ RenderLeaveItem("İllik məzuniyyət", illik, "up-fill-blue"); }
            @{ RenderUsedOnlyItem("Xəstəlik", xestelik, "up-fill-green"); }
            @{ RenderUsedOnlyItem("Ezamiyyət", ezamiyyet, "up-fill-gold"); }
        </div>

    </div>

    @* ── Mail Ayarları (yalnız Rəhbər / Admin üçün) ── *@
    @if (User.IsInRole("Rehber") || User.IsInRole("Admin"))
    {
        <div class="up-card" style="margin-top:24px" id="mailAyarlariCard">
            <div class="up-card-title">
                <i class="bi bi-envelope-at"></i>
                Mail Ayarları
                @if ((bool)ViewBag.MailSmtpKonfiqDir)
                {
                    <span class="up-badge-aktiv" style="margin-left:6px;font-size:.72rem;padding:2px 8px;border-radius:99px">
                        <i class="bi bi-check-circle-fill"></i> Konfiqurasiya edilib
                    </span>
                }
            </div>

            <div class="up-row">
                <span class="up-row-label">E-poçt ünvanı</span>
                <span class="up-row-value">
                    <input type="email" id="smtpEmail"
                           value="@ViewBag.MailSmtpEmail"
                           placeholder="rehber@mail.az"
                           class="up-edit-input up-visible"
                           style="width:260px" />
                </span>
            </div>

            <div class="up-row">
                <span class="up-row-label">
                    Şifrə
                    @if ((bool)ViewBag.MailSmtpKonfiqDir)
                    {
                        <span style="font-size:.72rem;color:#aab0bc;font-weight:400"> — dəyişmək üçün yaz</span>
                    }
                </span>
                <span class="up-row-value">
                    <input type="password" id="smtpParol"
                           placeholder="@((bool)ViewBag.MailSmtpKonfiqDir ? "••••••••" : "Şifrəni daxil edin")"
                           class="up-edit-input up-visible"
                           style="width:260px"
                           autocomplete="new-password" />
                </span>
            </div>

            <div class="up-row" style="border-bottom:none;padding-top:4px">
                <span class="up-row-label" style="font-size:.75rem;color:#aab0bc;font-weight:400">
                    <i class="bi bi-info-circle"></i>
                    Gmail: App Password istifadə edin. Titan, Outlook, Yahoo avtomatik tanınır.
                </span>
                <span class="up-row-value" style="display:flex;align-items:center;gap:8px">
                    <span id="mailAyarMsg" style="font-size:.82rem"></span>
                    @if ((bool)ViewBag.MailSmtpKonfiqDir)
                    {
                        <button type="button" id="mailSinaBtn" class="up-save-btn up-visible"
                                style="background:#fff;color:#2d6cdf;border:1.5px solid #2d6cdf;padding:7px 16px">
                            <i class="bi bi-send"></i> Sınaq Maili
                        </button>
                    }
                    <button type="button" id="mailSaxlaBtn" class="up-save-btn up-visible">
                        <i class="bi bi-floppy2-fill"></i> Yadda Saxla
                    </button>
                </span>
            </div>
        </div>
    }

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/User/user-profile.js" asp-append-version="true"></script>
    @if (User.IsInRole("Rehber") || User.IsInRole("Admin"))
    {
        <script>
        (function () {
            var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';

            async function postJson(url, data) {
                var body = Object.entries(data).map(([k,v]) => k+'='+encodeURIComponent(v)).join('&');
                var r = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body
                });
                return r.json();
            }

            function showMsg(msg, ok) {
                var el = document.getElementById('mailAyarMsg');
                el.textContent = msg;
                el.style.color = ok ? '#10b981' : '#ef4444';
            }

            var saxlaBtn = document.getElementById('mailSaxlaBtn');
            if (saxlaBtn) {
                saxlaBtn.addEventListener('click', async function () {
                    var email = document.getElementById('smtpEmail').value.trim();
                    var parol = document.getElementById('smtpParol').value;
                    if (!email) { showMsg('E-poçt ünvanı mütləqdir.', false); return; }
                    saxlaBtn.disabled = true;
                    var d = await postJson('/User/Profile/MailAyarlariYenile', { mailSmtpEmail: email, mailSmtpParol: parol });
                    showMsg(d.message, d.success);
                    saxlaBtn.disabled = false;
                    if (d.success && parol) document.getElementById('smtpParol').value = '';
                });
            }

            var sinaBtn = document.getElementById('mailSinaBtn');
            if (sinaBtn) {
                sinaBtn.addEventListener('click', async function () {
                    sinaBtn.disabled = true;
                    sinaBtn.innerHTML = '<i class="bi bi-send"></i> Göndərilir…';
                    var d = await postJson('/User/Profile/MailSina', {});
                    showMsg(d.message, d.success);
                    sinaBtn.disabled = false;
                    sinaBtn.innerHTML = '<i class="bi bi-send"></i> Sınaq Maili Göndər';
                });
            }
        })();
        </script>
    }
}
