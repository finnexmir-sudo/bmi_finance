@using FinNex.Application.DTOs.Pid
@model IList<MehkemeCedvelListDto>
@{
    ViewData["Title"] = "Məhkəmə İşləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var axtaris = ViewData["Axtaris"] as string;
}

<style>
    .mc-bar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
    .mc-inp { padding:8px 12px; border:1.5px solid #e2e8f0; border-radius:8px; font-size:13px; outline:none; }
    .mc-inp:focus { border-color:#6366f1; }
    .mc-grow { flex:1 1 240px; }
    .mc-import { margin-left:auto; display:flex; gap:8px; align-items:center; background:#f5f7ff; border:1.5px dashed #c7d2fe; border-radius:10px; padding:8px 12px; }
    .mc-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; border:none; }
    .mc-btn--p { background:#6366f1; color:#fff; }
    .mc-btn--g { background:#fff; color:#334155; border:1.5px solid #e2e8f0; }
    .mc-card { background:#fff; border:1.5px solid #e2e8f0; border-radius:12px; overflow:hidden; }
    .mc-tw { overflow-x:auto; }
    .mc-table { width:100%; border-collapse:collapse; font-size:13px; }
    .mc-table thead th { background:#f8fafc; padding:10px 14px; text-align:left; font-weight:700; color:#475569; border-bottom:2px solid #e2e8f0; white-space:nowrap; }
    .mc-table td { padding:10px 14px; border-bottom:1px solid #eef2f7; vertical-align:top; }
    .mc-table tbody tr:hover { background:#fafbff; }
    .mc-sira { display:inline-block; min-width:26px; text-align:center; background:#f1f5f9; color:#475569; border-radius:6px; padding:2px 7px; font-weight:800; font-size:12px; }
    .mc-girov { display:inline-block; background:#eef2ff; color:#4338ca; border-radius:5px; padding:2px 8px; font-size:12px; font-weight:600; }
    .mc-iclas span { display:inline-block; background:#eef2ff; color:#4338ca; border-radius:5px; padding:1px 7px; margin:1px; font-size:12px; }
    .mc-hakim { color:#64748b; font-size:12px; }
    .mc-foot { padding:10px 14px; font-size:12px; color:#64748b; border-top:1px solid #f1f5f9; }
    .mc-iconbtn { border:1.5px solid #fecaca; background:#fff; border-radius:7px; padding:5px 10px; cursor:pointer; font-size:12px; color:#b91c1c; }
    .mc-empty { text-align:center; padding:36px; color:#94a3b8; }
</style>

<div style="padding:4px 0">
    @if (TempData["Success"] != null) { <div class="alert alert-success py-2">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger py-2">@TempData["Error"]</div> }

    <div class="mc-bar">
        <form method="get" style="display:flex;gap:8px;flex:1 1 240px">
            <input type="text" name="axtaris" value="@axtaris" class="mc-inp mc-grow" placeholder="🔍 Müştəri adı və ya iş № axtar…" />
            <button type="submit" class="mc-btn mc-btn--g"><i class="bi bi-funnel"></i> Axtar</button>
        </form>
        <button type="button" class="mc-btn mc-btn--p" onclick="mcOpenAdd()"><i class="bi bi-plus-lg"></i> Yeni iş</button>
        <form asp-action="Import" method="post" enctype="multipart/form-data" class="mc-import">
            @Html.AntiForgeryToken()
            <i class="bi bi-file-earmark-excel" style="color:#15803d"></i>
            <input type="file" name="fayl" accept=".xls,.xlsx" required class="mc-inp" style="padding:5px" />
            <button type="submit" class="mc-btn mc-btn--p"><i class="bi bi-upload"></i> Excel import</button>
        </form>
    </div>

    <div class="mc-card">
        <div class="mc-tw">
            <table class="mc-table">
                <thead>
                    <tr>
                        <th>Sıra</th>
                        <th>Müştəri adı</th>
                        <th>Girovun növü</th>
                        <th>Məhkəməyə verilmə</th>
                        <th>Məhkəmə iş № / Hakim</th>
                        <th>Məhkəmə keçirilmə (tarix / saat)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td><span class="mc-sira">@(x.Sira?.ToString() ?? "—")</span></td>
                                <td style="font-weight:600;white-space:nowrap">@x.BorcluAd</td>
                                <td>@if (!string.IsNullOrWhiteSpace(x.GirovunNovu)) { <span class="mc-girov">@x.GirovunNovu</span> } else { <span>—</span> }</td>
                                <td style="white-space:nowrap">@(x.MehkemeyeVerilmeTarixi?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td style="max-width:260px">
                                    @if (!string.IsNullOrWhiteSpace(x.MehkemeIsNomresi)) { <div>@x.MehkemeIsNomresi</div> }
                                    @if (!string.IsNullOrWhiteSpace(x.Hakim)) { <div class="mc-hakim"><i class="bi bi-person-badge"></i> @x.Hakim</div> }
                                    @if (string.IsNullOrWhiteSpace(x.MehkemeIsNomresi) && string.IsNullOrWhiteSpace(x.Hakim)) { <span>—</span> }
                                </td>
                                <td class="mc-iclas">
                                    @if (x.Iclaslar.Any())
                                    {
                                        @foreach (var ic in x.Iclaslar)
                                        {
                                            <span>@(ic.Tarix?.ToString("dd.MM.yyyy") ?? "—")@(string.IsNullOrWhiteSpace(ic.Saat) ? "" : " · " + ic.Saat)</span>
                                        }
                                    }
                                    else { <span style="color:#cbd5e1">—</span> }
                                </td>
                                <td style="white-space:nowrap">
                                    <form asp-action="Sil" method="post" onsubmit="return confirm('Bu iş silinsin?');" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@x.Id" />
                                        <button type="submit" class="mc-iconbtn"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7"><div class="mc-empty"><i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:8px"></i>Hələ iş yoxdur. Yuxarıdan <b>Yeni iş</b> əlavə et və ya <b>Excel import</b> et.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mc-foot">@Model.Count iş</div>
    </div>
</div>

<!-- Yeni iş modal -->
<div class="modal fade" id="mcModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="Yarat" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Yeni məhkəmə işi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-2"><label class="form-label fw-semibold">Sıra</label><input name="Sira" type="number" class="form-control" /></div>
                        <div class="col-md-6"><label class="form-label fw-semibold">Müştəri adı *</label><input name="BorcluAd" class="form-control" required /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Girovun növü</label><input name="GirovunNovu" class="form-control" placeholder="Daşınmaz / Avtomobil…" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Məhkəməyə verilmə tarixi</label><input name="MehkemeyeVerilmeTarixi" type="date" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Məhkəmə iş / sənəd №</label><input name="MehkemeIsNomresi" class="form-control" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Hakim</label><input name="Hakim" class="form-control" /></div>
                    </div>
                    <hr />
                    <label class="form-label fw-semibold">Məhkəmə keçirilmə tarixləri (tarix + saat)</label>
                    <div id="mcIclaslar"></div>
                    <button type="button" class="btn btn-sm btn-light mt-2" onclick="mcAddIclas()"><i class="bi bi-plus"></i> Tarix əlavə et</button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Saxla</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var mcModal = new bootstrap.Modal(document.getElementById('mcModal'));
    function mcOpenAdd() {
        document.getElementById('mcIclaslar').innerHTML = '';
        mcAddIclas();
        mcModal.show();
    }
    function mcAddIclas() {
        var div = document.createElement('div');
        div.className = 'row g-2 mb-2 mc-iclas-row';
        div.innerHTML =
            '<div class="col-md-5"><input type="date" name="IclasTarix" class="form-control form-control-sm" /></div>' +
            '<div class="col-md-5"><input name="IclasSaat" class="form-control form-control-sm" placeholder="Saat (məs. 14.40)" /></div>' +
            '<div class="col-md-2"><button type="button" class="btn btn-sm btn-light" onclick="this.closest(\'.mc-iclas-row\').remove()"><i class="bi bi-x-lg"></i></button></div>';
        document.getElementById('mcIclaslar').appendChild(div);
    }
</script>
}
