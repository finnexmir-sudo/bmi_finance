@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model IList<IcraIsiListDto>
@{
    ViewData["Title"] = "İcra İşləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var st = (ViewBag.Status as string) ?? "aktiv";

    string D(DateTime? d) => d.HasValue ? d.Value.ToString("dd.MM.yyyy") : "—";
    string Txt(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") + " ₼" : "—";

    string StatusAd(MehkemeIsiStatus s) => s switch
    {
        MehkemeIsiStatus.Hazirlanir => "Hazırlanır",
        MehkemeIsiStatus.Mehkemede  => "Məhkəmədə",
        MehkemeIsiStatus.Icra       => "İcrada",
        MehkemeIsiStatus.Tamamlandi => "Tamamlandı",
        MehkemeIsiStatus.Baghlandi  => "Bağlandı",
        _                           => s.ToString()
    };
    string StatusClass(MehkemeIsiStatus s) => s switch
    {
        MehkemeIsiStatus.Hazirlanir => "mi-badge--hazir",
        MehkemeIsiStatus.Mehkemede  => "mi-badge--mehkeme",
        MehkemeIsiStatus.Icra       => "mi-badge--icra",
        MehkemeIsiStatus.Tamamlandi => "mi-badge--tamam",
        MehkemeIsiStatus.Baghlandi  => "mi-badge--bagli",
        _                           => "mi-badge--diger"
    };
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">İcra İşləri</h2>
            <p class="ms-sub">İcrada olan və bağlanmış işlər — icra fazası izləməsi</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <a asp-action="Isler" class="ms-btn ms-btn--ghost"><i class="bi bi-bank"></i> Məhkəmə İşləri</a>
            <a asp-action="Index" class="ms-btn ms-btn--ghost"><i class="bi bi-people"></i> Aktiv Müştərilər</a>
            <a asp-action="IcraIsleriExcel" asp-route-status="@st" class="ms-btn ms-btn--primary"><i class="bi bi-file-earmark-excel"></i> Excelə yüklə</a>
            <form asp-action="IcraImport" method="post" enctype="multipart/form-data"
                  style="display:flex;align-items:center;gap:6px;border-left:1px solid #e2e8f0;padding-left:8px"
                  title="PID 'İCRADA OLAN İŞLƏR' vərəqini idxal et (hesab+subkod açarı ilə).">
                @Html.AntiForgeryToken()
                <input type="file" name="fayl" accept=".xls,.xlsx" required style="font-size:12px;max-width:160px" />
                <button type="submit" name="onizleme" value="true" class="ms-btn ms-btn--ghost"
                        title="Yalnız sayır — DB-yə yazmır">
                    <i class="bi bi-search"></i> Önizləmə
                </button>
                <button type="submit" name="onizleme" value="false" class="ms-btn ms-btn--primary"
                        style="background:#15803d;border-color:#15803d"
                        onclick="return confirm('REAL İDXAL — məlumat bazaya yazılacaq. Davam edək?');"
                        title="Real idxal — DB-yə yazır">
                    <i class="bi bi-database-add"></i> Real idxal
                </button>
            </form>
            <form asp-action="ZaminDublikatTemizle" method="post"
                  style="display:flex;align-items:center;gap:6px;border-left:1px solid #e2e8f0;padding-left:8px"
                  title="Eyni işdə təkrarlanan zamin qeydlərini bir qeydə birləşdirir (soft-delete).">
                @Html.AntiForgeryToken()
                <button type="submit" name="onizleme" value="true" class="ms-btn ms-btn--ghost"
                        title="Yalnız sayır — DB-yə yazmır">
                    <i class="bi bi-people"></i> Zamin təkrarları
                </button>
                <button type="submit" name="onizleme" value="false" class="ms-btn ms-btn--ghost"
                        onclick="return confirm('Təkrar zamin qeydləri bir qeydə birləşdiriləcək (soft-delete). Davam edək?');"
                        title="Təkrarları birləşdir">
                    <i class="bi bi-magic"></i> Təmizlə
                </button>
            </form>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ms-alert ms-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="ms-alert ms-alert--error">@TempData["Error"]</div>
    }

    <div class="ms-filter">
        <input type="text" id="icSearch" class="ms-input ms-grow" placeholder="🔍 Borclu / zamin adı, FİN və ya kredit hesabı axtar…" />
        <div class="ic-chips">
            <a asp-action="IcraIsleri" asp-route-status="aktiv"     class="ic-chip @(st == "aktiv"     ? "active" : "")">İcrada olanlar</a>
            <a asp-action="IcraIsleri" asp-route-status="baglanmis" class="ic-chip @(st == "baglanmis" ? "active" : "")">Bağlanmış</a>
            <a asp-action="IcraIsleri" asp-route-status="hamisi"    class="ic-chip @(st == "hamisi"    ? "active" : "")">Hamısı</a>
        </div>
    </div>

    <div class="ms-card">
        <div class="ms-twrap">
            <table class="ms-table" id="icTable">
                <thead>
                    <tr>
                        <th>№</th>
                        <th class="ms-col-ad">Müştəri</th>
                        <th>Kredit hesabı</th>
                        <th>Status</th>
                        <th class="ms-num">Qalan borc</th>
                        <th>Son ödəniş</th>
                        <th>Qeydiyyatı</th>
                        <th>Əmək haqqı barədə</th>
                        <th>Adına sorğu</th>
                        <th>Əmlaka həbs</th>
                        <th>Stop</th>
                        <th>İcra məmuru</th>
                        <th>İcraçı son işlər / görüşmə</th>
                        <th>Doğum tarixi</th>
                        <th>Zamin</th>
                        <th>Qətnamə tarixi</th>
                        <th>İş yeri</th>
                        <th>Qeyd</th>
                    </tr>
                </thead>
                @if (Model.Any())
                {
                    var i = 0;
                    @foreach (var x in Model)
                    {
                        i++;
                        var url = Url.Action("Detal", new { id = x.Id });
                        var zaminSearch = string.Join(" ", x.Zaminler.Select(z => $"{z.Ad} {z.Fin}"));
                        <tbody class="ic-grp" data-search="@($"{x.BorcluAd} {x.QeydiyyatNomresi} {x.Subkod} {zaminSearch}")">
                            <tr class="ic-row" data-href="@url">
                                <td class="mx-sira">@i</td>
                                <td class="ms-col-ad">
                                    <a asp-action="Detal" asp-route-id="@x.Id" class="mx-name">@Txt(x.BorcluAd)</a>
                                    @if (x.Zaminler.Any())
                                    {
                                        <span class="ic-zbadge" title="@x.Zaminler.Count icra subyekti (zamin)"><i class="bi bi-people"></i> @x.Zaminler.Count zamin</span>
                                    }
                                </td>
                                <td>
                                    <span class="mi-nomre">@Txt(x.QeydiyyatNomresi)</span>
                                    @if (!string.IsNullOrWhiteSpace(x.Subkod))
                                    {
                                        <span class="ic-sub">· @x.Subkod</span>
                                    }
                                </td>
                                <td>
                                    <span class="mi-badge @StatusClass(x.Status)">@StatusAd(x.Status)</span>
                                </td>
                                <td class="ms-num">@M(x.QalanBorc)</td>
                                <td class="mi-date">@D(x.SonOdenisTarixi)</td>
                                <td class="ic-clip" title="@Txt(x.Qeydiyyati)">@Txt(x.Qeydiyyati)</td>
                                <td class="ic-clip" title="@Txt(x.EmekHaqqiMelumati)">@Txt(x.EmekHaqqiMelumati)</td>
                                <td class="ic-clip" title="@Txt(x.AdinaSorgu)">
                                    @Txt(x.AdinaSorgu)
                                    @if (x.DypSorguTarixi.HasValue)
                                    {
                                        <span class="ic-sub">(@x.DypSorguTarixi.Value.ToString("dd.MM.yyyy"))</span>
                                    }
                                </td>
                                <td class="ic-clip" title="@Txt(x.EmlakaHebs)">@Txt(x.EmlakaHebs)</td>
                                <td class="ic-clip" title="@Txt(x.Stop)">@Txt(x.Stop)</td>
                                <td class="ic-clip" title="@Txt(x.IcraMemuru)">@Txt(x.IcraMemuru)</td>
                                <td class="ic-clip ic-clip--wide" title="@Txt(x.IcraSonIsler)">@Txt(x.IcraSonIsler)</td>
                                <td class="mi-date">@D(x.DogumTarixi)</td>
                                <td class="ic-clip" title="@Txt(x.Zamin)">
                                    @if (!string.IsNullOrWhiteSpace(x.Zamin))
                                    {
                                        <span>@x.Zamin</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="mi-date">@D(x.QetnameTarixi)</td>
                                <td class="ic-clip" title="@Txt(x.IsYeri)">@Txt(x.IsYeri)</td>
                                <td class="ic-clip" title="@Txt(x.IcraQeyd)">@Txt(x.IcraQeyd)</td>
                            </tr>
                            @foreach (var z in x.Zaminler)
                            {
                                var zurl = url + "#z-" + z.Id;
                                <tr class="ic-zrow" data-href="@zurl" title="Zamin — öz icra məlumatına bax">
                                    <td></td>
                                    <td class="ms-col-ad ic-zname">
                                        <span class="ic-zarrow">↳</span>
                                        <span class="ic-zrole">ZAMİN</span>
                                        <span class="ic-zad">@Txt(z.Ad)</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(z.Fin))
                                        {
                                            <span class="ic-sub">FİN @z.Fin</span>
                                        }
                                        else { <span>—</span> }
                                    </td>
                                    <td><span class="ic-zbadge2">zamin</span></td>
                                    <td class="ms-num">—</td>
                                    <td class="mi-date">—</td>
                                    <td class="ic-clip" title="@Txt(z.Unvan)">@Txt(z.Unvan)</td>
                                    <td class="ic-clip" title="@Txt(z.EmekHaqqiTutulma)">@Txt(z.EmekHaqqiTutulma)</td>
                                    <td class="ic-clip" title="@Txt(z.AdinaSorgu)">
                                        @Txt(z.AdinaSorgu)
                                        @if (!string.IsNullOrWhiteSpace(z.DypSorgu))
                                        {
                                            <span class="ic-sub">(@z.DypSorgu)</span>
                                        }
                                    </td>
                                    <td class="ic-clip" title="@Txt(z.EmlakaHebs)">@Txt(z.EmlakaHebs)</td>
                                    <td class="ic-clip" title="@Txt(z.Stop)">@Txt(z.Stop)</td>
                                    <td class="ic-clip" title="@Txt(z.IcraMemuru)">@Txt(z.IcraMemuru)</td>
                                    <td class="ic-clip ic-clip--wide" title="@Txt(z.IcraSonIsler)">@Txt(z.IcraSonIsler)</td>
                                    <td class="mi-date">@Txt(z.DogumTarixi)</td>
                                    <td class="ic-clip" title="@Txt(z.Telefon)">@Txt(z.Telefon)</td>
                                    <td class="mi-date">—</td>
                                    <td class="ic-clip" title="@Txt(z.IsYeri)">@Txt(z.IsYeri)</td>
                                    <td class="ic-clip" title="@Txt(z.IcraQeyd)">@Txt(z.IcraQeyd)</td>
                                </tr>
                            }
                        </tbody>
                    }
                }
                else
                {
                    <tbody>
                        <tr class="ic-empty-row">
                            <td colspan="18">
                                <div class="ms-empty">
                                    <i class="bi bi-folder2-open"></i>
                                    <div>Bu filtrdə icra işi yoxdur.</div>
                                    <div style="margin-top:6px;font-size:13px">
                                        İşi <a asp-action="Isler">Məhkəmə İşləri</a>-ndə açıb, Detal-da statusu <b>İcrada</b> seçdikdə burada görünür.
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <div class="ms-foot" id="icCount">@Model.Count iş</div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        #icTable tbody td { padding: 9px 14px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #e5e7eb; white-space: nowrap; vertical-align: middle; }
        #icTable tbody td:last-child { border-right: none; }
        #icTable tbody.ic-grp { border-top: 2px solid #e5e7eb; }
        #icTable tbody.ic-grp:first-of-type { border-top: none; }
        #icTable tbody tr.ic-row { cursor: pointer; }
        #icTable tbody tr.ic-row td { background: #fff; }
        #icTable tbody tr.ic-row:hover td { background: #eff6ff; }
        /* Zamin alt sətirləri (borclunun altında) */
        #icTable tbody tr.ic-zrow { cursor: pointer; }
        #icTable tbody tr.ic-zrow td { background: #fbfaff; color: #475569; font-size: 12.5px; }
        #icTable tbody tr.ic-zrow:hover td { background: #f1ecff; }
        .ic-zname { font-weight: 600; white-space: nowrap; }
        .ic-zarrow { color: #c4b5fd; margin-right: 5px; font-weight: 700; }
        .ic-zrole { display: inline-block; background: #ede9fe; color: #6d28d9; border-radius: 5px; padding: 0 6px; font-size: 10px; font-weight: 800; margin-right: 6px; letter-spacing: .03em; }
        .ic-zad { color: #1e293b; }
        .ic-zbadge { display: inline-flex; align-items: center; gap: 3px; background: #ede9fe; color: #6d28d9; border-radius: 6px; padding: 1px 7px; font-weight: 700; font-size: 11px; margin-left: 6px; }
        .ic-zbadge2 { display: inline-block; background: #ede9fe; color: #6d28d9; border-radius: 5px; padding: 1px 7px; font-weight: 700; font-size: 11px; }
        .mx-sira { color: #94a3b8; font-weight: 700; text-align: center; }
        .mx-name { font-weight: 700; color: #0f172a; text-decoration: none; }
        .mx-name:hover { color: var(--fn-primary,#6366f1); text-decoration: underline; }
        .ic-sub { color: #94a3b8; font-size: 12px; margin-left: 3px; }
        .ic-statmetn { font-size: 11px; color: #64748b; margin-top: 2px; max-width: 150px; overflow: hidden; text-overflow: ellipsis; }
        .ic-clip { max-width: 180px; overflow: hidden; text-overflow: ellipsis; }
        .ic-clip--wide { max-width: 260px; }
        .ic-zamin { display: inline-flex; align-items: center; gap: 3px; background: #eef2ff; color: #4338ca; border-radius: 6px; padding: 1px 7px; font-weight: 700; font-size: 12px; margin-right: 4px; }

        /* Sol tərəf: № + Müştəri sütunları sabit qalsın (üfüqi scroll-da donur) */
        #icTable th:nth-child(1), #icTable td:nth-child(1) {
            position: sticky; left: 0; box-sizing: border-box; width: 48px; min-width: 48px; max-width: 48px;
        }
        #icTable th.ms-col-ad, #icTable td.ms-col-ad {
            position: sticky; left: 48px; box-shadow: 7px 0 10px -8px rgba(15,23,42,.22);
        }
        #icTable thead th:nth-child(1), #icTable thead th.ms-col-ad { z-index: 5; background: #eef2f6; }
        #icTable tbody td:nth-child(1), #icTable tbody td.ms-col-ad { z-index: 2; }
        #icTable tbody tr.ic-row td:nth-child(1), #icTable tbody tr.ic-row td.ms-col-ad { background: #fff; }
        #icTable tbody tr.ic-row:hover td:nth-child(1), #icTable tbody tr.ic-row:hover td.ms-col-ad { background: #eff6ff; }
        #icTable tbody tr.ic-zrow td:nth-child(1), #icTable tbody tr.ic-zrow td.ms-col-ad { background: #fbfaff; }
        #icTable tbody tr.ic-zrow:hover td:nth-child(1), #icTable tbody tr.ic-zrow:hover td.ms-col-ad { background: #f1ecff; }

        /* Status filtr çipləri */
        .ic-chips { display: flex; gap: 6px; }
        .ic-chip { padding: 7px 14px; border-radius: 9px; background: #f1f5f9; color: #475569; font-weight: 600; font-size: 13px; text-decoration: none; border: 1.5px solid transparent; white-space: nowrap; }
        .ic-chip:hover { background: #e2e8f0; }
        .ic-chip.active { background: #eef2ff; color: #4338ca; border-color: #c7d2fe; }
    </style>
}

@section Scripts {
<script>
    // Sətrə klik → öz məlumatına: borclu → iş Detalı, zamin → həmin zaminin kartı (#z-..)
    document.querySelectorAll('#icTable tr[data-href]').forEach(function (tr) {
        tr.addEventListener('click', function (e) {
            if (e.target.closest('a')) return;
            var href = tr.dataset.href;
            if (href) window.location.href = href;
        });
    });

    // Axtarış (borclu / zamin adı / FİN / kredit hesabı / subkod) — qrup səviyyəsində
    (function () {
        var s   = document.getElementById('icSearch');
        var cnt = document.getElementById('icCount');
        var grps = Array.prototype.slice.call(document.querySelectorAll('#icTable tbody.ic-grp'));
        function f() {
            var q = s.value.trim().toLowerCase();
            var vis = 0;
            grps.forEach(function (g) {
                var ok = !q || (g.dataset.search || '').toLowerCase().includes(q);
                g.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });
            cnt.textContent = vis + ' iş';
        }
        s.addEventListener('input', f);
    })();

    // Cədvəlin hündürlüyünü ekrana uyğunlaşdır — üfüqi scroll həmişə cədvəlin
    // altında (ekran daxilində) görünsün, səhifəni aşağı sürükləmək lazım olmasın.
    function icFitHeight() {
        var tw = document.querySelector('.ms-twrap');
        if (!tw) return;
        var top = tw.getBoundingClientRect().top;
        var foot = document.querySelector('.ms-foot');
        var footH = foot ? foot.offsetHeight : 0;
        tw.style.maxHeight = Math.max(240, window.innerHeight - top - footH - 14) + 'px';
    }
    icFitHeight();
    window.addEventListener('resize', icFitHeight);
</script>
}
