@using FinNex.Application.DTOs.Pid
@model CoxsayliZaminlikViewDto
@{
    ViewData["Title"] = "Çoxsaylı Zaminlik";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "—";
    string T(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;

    // Zaminə görə qruplaşdır (FİN varsa ona, yoxdursa ada görə)
    var qruplar = Model.Setirler
        .GroupBy(x => string.IsNullOrWhiteSpace(x.ZaminFin) ? "AD:" + x.ZaminAd : "FIN:" + x.ZaminFin)
        .OrderByDescending(g => g.First().ZaminDurduguKreditSayi)
        .ThenBy(g => g.First().ZaminAd)
        .ToList();
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">Çoxsaylı Zaminlik</h2>
            <p class="ms-sub">1-dən çox kreditə zamin duran şəxslər — @Model.ZaminSayi zamin, @Model.Setirler.Count kredit</p>
        </div>
        @if (Model.SorguTapildi && Model.Xeta == null && Model.Setirler.Count > 0)
        {
            <a asp-action="CoxsayliZaminlikExcel" class="ms-btn ms-btn--primary">
                <i class="bi bi-file-earmark-excel"></i> Excel
            </a>
        }
    </div>

    @if (!Model.SorguTapildi)
    {
        <div class="bd-alert bd-alert-warn">
            <i class="bi bi-exclamation-triangle"></i>
            <b>Sorğu tapılmadı.</b> Admin → Oracle Sorğular bölməsinə SQL-i əlavə edin, adını
            <b>"Çoxsaylı Zaminlik"</b> qoyub aktiv edin.
        </div>
    }
    else if (Model.Xeta != null)
    {
        <div class="bd-alert bd-alert-err"><i class="bi bi-x-octagon"></i> Oracle xətası: @Model.Xeta</div>
    }
    else if (Model.Setirler.Count == 0)
    {
        <div class="bd-alert bd-alert-info"><i class="bi bi-inbox"></i> 1-dən çox kreditə zamin duran şəxs tapılmadı.</div>
    }
    else
    {
        <div class="ms-toolbar" style="margin-bottom:12px">
            <div class="ms-search">
                <i class="bi bi-search"></i>
                <input type="text" id="czSearch" placeholder="Zamin FİN/ad, borcalan, hesab axtar..." autocomplete="off" />
            </div>
        </div>

        <div class="ms-twrap">
            <table class="ms-table" id="czTable">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Zamin / Borcalan</th>
                        <th>FİN</th>
                        <th>Region</th>
                        <th>Kredit hesabı</th>
                        <th>KS</th>
                        <th class="cz-num">Kreditin məbləği</th>
                        <th class="cz-num">Qalıq</th>
                        <th class="cz-num">VK qalıq</th>
                    </tr>
                </thead>
                @{ var i = 0; }
                @foreach (var g in qruplar)
                {
                    i++;
                    var z = g.First();
                    var krediler = g.OrderByDescending(x => x.Qaliq ?? 0m).ToList();
                    var searchHay = $"{z.ZaminFin} {z.ZaminAd} " + string.Join(" ", krediler.Select(k => $"{k.Borcalan} {k.KreditHesabi}"));
                    <tbody class="ic-grp" data-search="@searchHay">
                        <tr class="ic-row">
                            <td class="mx-sira">@i</td>
                            <td>
                                <span class="mx-name">@T(z.ZaminAd)</span>
                                <span class="cz-cnt" title="Zamin durduğu kredit sayı"><i class="bi bi-people"></i> @z.ZaminDurduguKreditSayi kredit</span>
                            </td>
                            <td class="cz-mono">@T(z.ZaminFin)</td>
                            <td colspan="3"></td>
                            <td class="cz-num"><b>@M(krediler.Sum(k => k.KreditinMeblegi))</b></td>
                            <td class="cz-num"><b>@M(krediler.Sum(k => k.Qaliq))</b></td>
                            <td class="cz-num"><b>@M(krediler.Sum(k => k.VkQaliq))</b></td>
                        </tr>
                        @foreach (var k in krediler)
                        {
                            <tr class="ic-zrow">
                                <td></td>
                                <td>
                                    <span class="ic-zarrow">↳</span>
                                    <span class="ic-zad">@T(k.Borcalan)</span>
                                </td>
                                <td></td>
                                <td class="ic-clip">@T(k.Region)</td>
                                <td class="cz-mono">@T(k.KreditHesabi)</td>
                                <td>@T(k.Ks)</td>
                                <td class="cz-num">@M(k.KreditinMeblegi)</td>
                                <td class="cz-num">@M(k.Qaliq)</td>
                                <td class="cz-num">@M(k.VkQaliq)</td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        #czTable { border-collapse: collapse; }
        #czTable thead th { white-space: nowrap; font-size: 11px; }
        #czTable tbody td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #f1f5f9; white-space: nowrap; vertical-align: middle; font-size: 12.5px; }
        #czTable tbody td:last-child { border-right: none; }
        #czTable tbody.ic-grp { border-top: 2px solid #e5e7eb; }
        #czTable tbody.ic-grp:first-of-type { border-top: none; }
        #czTable tbody tr.ic-row td { background: #fff; }
        #czTable tbody tr.ic-row:hover td { background: #eff6ff; }
        #czTable tbody tr.ic-zrow td { background: #fbfaff; color: #475569; }
        #czTable tbody tr.ic-zrow:hover td { background: #f1ecff; }

        .cz-num { text-align: right; }
        .cz-mono { font-family: ui-monospace,Menlo,Consolas,monospace; font-size: 11.5px; color: #475569; }
        .mx-sira { color: #94a3b8; font-weight: 700; text-align: center; }
        .mx-name { font-weight: 700; color: #0f172a; }
        .ic-clip { max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
        .ic-zarrow { color: #c4b5fd; margin-right: 5px; font-weight: 700; }
        .ic-zad { color: #1e293b; }
        .cz-cnt { display: inline-flex; align-items: center; gap: 3px; background: #fef3c7; color: #92400e; border-radius: 6px; padding: 1px 8px; font-weight: 700; font-size: 11px; margin-left: 8px; }

        .ms-twrap { max-height: calc(100vh - 300px); }
        .ms-twrap::-webkit-scrollbar { height: 13px; width: 13px; }
        .ms-twrap::-webkit-scrollbar-thumb { background: #b6c2d4; border-radius: 7px; border: 3px solid #f1f5f9; }
        .ms-twrap::-webkit-scrollbar-track { background: #f1f5f9; }

        .ms-search { position: relative; max-width: 420px; }
        .ms-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
        .ms-search input { width: 100%; padding: 9px 12px 9px 34px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 13px; outline: none; }
        .ms-search input:focus { border-color: #c7d2fe; }

        .bd-alert { display:flex; align-items:flex-start; gap:9px; padding:12px 16px; border-radius:12px; font-size:14px; margin-bottom:14px; line-height:1.5; }
        .bd-alert-warn { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; }
        .bd-alert-err  { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
        .bd-alert-info { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('czSearch');
            if (!inp) return;
            var grps = Array.prototype.slice.call(document.querySelectorAll('#czTable tbody.ic-grp'));
            inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                grps.forEach(function (g) {
                    var hay = (g.getAttribute('data-search') || '').toLowerCase();
                    g.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
        })();
    </script>
}
