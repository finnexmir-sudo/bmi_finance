@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model IList<YaxinlasanGorusDto>
@{
    ViewData["Title"] = "Yaxınlaşan görüşlər";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    var bugun = DateTime.Today;
    string Txt(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    string Dow(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday    => "Bazar ertəsi",
        DayOfWeek.Tuesday   => "Çərşənbə axşamı",
        DayOfWeek.Wednesday => "Çərşənbə",
        DayOfWeek.Thursday  => "Cümə axşamı",
        DayOfWeek.Friday    => "Cümə",
        DayOfWeek.Saturday  => "Şənbə",
        _                   => "Bazar"
    };
    string Rel(DateTime d)
    {
        var n = (d.Date - bugun).Days;
        return n == 0 ? "bu gün" : n == 1 ? "sabah" : $"{n} gün sonra";
    }
    var gruplar = Model.GroupBy(x => x.Tarix.Date).OrderBy(g => g.Key).ToList();
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">Yaxınlaşan görüşlər</h2>
            <p class="ms-sub">İzlənən işlər üzrə bu gün və sonrakı məhkəmə iclasları</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <a asp-action="Isler" class="ms-btn ms-btn--ghost"><i class="bi bi-bank"></i> Məhkəmə İşləri</a>
            <a asp-action="Index" class="ms-btn ms-btn--ghost"><i class="bi bi-people"></i> Aktiv Müştərilər</a>
        </div>
    </div>

    <div class="gr-bar">
        <div class="gr-chips">
            <button type="button" class="gr-chip active" data-range="all">Hamısı</button>
            <button type="button" class="gr-chip" data-range="today">Bu gün</button>
            <button type="button" class="gr-chip" data-range="7">7 gün</button>
            <button type="button" class="gr-chip" data-range="30">30 gün</button>
        </div>
        <div class="gr-range">
            <i class="bi bi-calendar-range"></i>
            <input type="date" id="grFrom" class="ms-input" title="Başlanğıc tarix" />
            <span>—</span>
            <input type="date" id="grTo" class="ms-input" title="Son tarix" />
        </div>
        <input type="text" id="grSearch" class="ms-input ms-grow" placeholder="🔍 Müştəri, iş № və ya hakim axtar…" />
        <span class="gr-count" id="grCount">@Model.Count görüş</span>
    </div>

    @if (gruplar.Any())
    {
        foreach (var g in gruplar)
        {
            var bugundur = g.Key == bugun;
            <div class="gr-day @(bugundur ? "gr-day--today" : "")" data-date="@g.Key.ToString("yyyy-MM-dd")">
                <div class="gr-day-head">
                    <i class="bi bi-calendar-event"></i>
                    <span class="gr-day-date">@g.Key.ToString("dd.MM.yyyy")</span>
                    <span class="gr-day-dow">@Dow(g.Key)</span>
                    <span class="gr-day-rel">@Rel(g.Key)</span>
                    <span class="gr-day-cnt">@g.Count() görüş</span>
                </div>
                <div class="gr-day-body">
                    @foreach (var x in g.OrderBy(i => i.Saat))
                    {
                        <a href="@Url.Action("Detal", new { id = x.MehkemeIsiId })" class="gr-item"
                           data-search="@($"{x.BorcluAd} {x.QeydiyyatNomresi} {x.IsNomresi} {x.Hakim}")">
                            <span class="gr-time"><i class="bi bi-clock"></i> @(string.IsNullOrWhiteSpace(x.Saat) ? "—" : x.Saat)</span>
                            <span class="gr-name">@x.BorcluAd</span>
                            <span class="gr-iz" title="@x.IsNomresi"><i class="bi bi-bank"></i> @Txt(x.IsNomresi)</span>
                            <span class="gr-hakim" title="@x.Hakim"><i class="bi bi-person-badge"></i> @Txt(x.Hakim)</span>
                            @if (!string.IsNullOrWhiteSpace(x.Qeyd))
                            {
                                <span class="gr-qeyd">@x.Qeyd</span>
                            }
                            <i class="bi bi-chevron-right gr-go"></i>
                        </a>
                    }
                </div>
            </div>
        }
        <div class="gr-empty-filter" id="grNoMatch" style="display:none">
            <i class="bi bi-search"></i> Seçilmiş tarix/axtarışa uyğun görüş yoxdur.
        </div>
    }
    else
    {
        <div class="ms-card"><div class="ms-empty"><i class="bi bi-calendar-x"></i><div>Yaxınlaşan görüş yoxdur.</div></div></div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        .gr-bar { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:14px; }
        .gr-chips { display:inline-flex; gap:6px; flex-wrap:wrap; }
        .gr-chip { padding:7px 14px; border:1.5px solid #e2e8f0; border-radius:20px; background:#fff; color:#475569; font-size:12.5px; font-weight:700; cursor:pointer; transition:all .12s; }
        .gr-chip:hover { background:#f8fafc; border-color:#cbd5e1; }
        .gr-chip.active { background:var(--fn-primary,#6366f1); color:#fff; border-color:transparent; }
        .gr-range { display:inline-flex; gap:6px; align-items:center; color:#94a3b8; }
        .gr-range .ms-input { padding:7px 10px; }
        .gr-count { font-size:12px; color:#64748b; font-weight:700; white-space:nowrap; }

        .gr-day { background:#fff; border:1.5px solid #e2e8f0; border-radius:12px; margin-bottom:14px; overflow:hidden; }
        .gr-day--today { border-color:#fca5a5; box-shadow:0 0 0 1px #fecaca; }
        .gr-day-head { display:flex; align-items:center; gap:10px; padding:11px 16px; background:#f8fafc; border-bottom:1px solid #eef2f7; }
        .gr-day--today .gr-day-head { background:#fef2f2; }
        .gr-day-head > i { color:var(--fn-primary,#6366f1); }
        .gr-day--today .gr-day-head > i { color:#dc2626; }
        .gr-day-date { font-weight:800; color:#0f172a; font-size:14px; }
        .gr-day-dow { color:#64748b; font-size:13px; }
        .gr-day-rel { font-size:11px; font-weight:800; background:#eef2ff; color:#4338ca; border-radius:20px; padding:2px 10px; }
        .gr-day--today .gr-day-rel { background:#fee2e2; color:#b91c1c; }
        .gr-day-cnt { margin-left:auto; font-size:12px; color:#94a3b8; font-weight:600; }
        .gr-day-body { display:flex; flex-direction:column; }
        .gr-item { display:flex; align-items:center; gap:14px; padding:11px 16px; border-bottom:1px solid #f1f5f9; text-decoration:none; color:#334155; transition:background .12s; flex-wrap:wrap; }
        .gr-item:last-child { border-bottom:none; }
        .gr-item:hover { background:#f5f7ff; }
        .gr-time { font-weight:800; color:#0f172a; min-width:78px; display:inline-flex; align-items:center; gap:5px; font-variant-numeric:tabular-nums; }
        .gr-time > i { color:#94a3b8; font-weight:400; }
        .gr-name { font-weight:700; color:#0f172a; min-width:200px; }
        .gr-iz, .gr-hakim { font-size:12.5px; color:#475569; display:inline-flex; align-items:center; gap:5px; max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .gr-iz > i, .gr-hakim > i { color:#94a3b8; }
        .gr-qeyd { font-size:12.5px; color:#64748b; font-style:italic; }
        .gr-go { margin-left:auto; color:#cbd5e1; }
        .gr-item:hover .gr-go { color:var(--fn-primary,#6366f1); }
        .gr-empty-filter { text-align:center; color:#94a3b8; padding:30px; font-size:14px; }
    </style>
}

@section Scripts {
<script>
    (function () {
        var search  = document.getElementById('grSearch');
        var cnt     = document.getElementById('grCount');
        var fromInp = document.getElementById('grFrom');
        var toInp   = document.getElementById('grTo');
        var noMatch = document.getElementById('grNoMatch');
        var chips   = Array.prototype.slice.call(document.querySelectorAll('.gr-chip'));
        var days    = Array.prototype.slice.call(document.querySelectorAll('.gr-day'));
        if (!days.length) return;

        var activeRange = 'all';
        function pad(n){ return n < 10 ? '0' + n : '' + n; }
        function ymd(d){ return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }

        function computeRange() {
            var cf = fromInp.value, ct = toInp.value;
            if (cf || ct) return { from: cf || '0000-01-01', to: ct || '9999-12-31' };
            var t = new Date(); t.setHours(0, 0, 0, 0);
            if (activeRange === 'today') return { from: ymd(t), to: ymd(t) };
            if (activeRange === '7')  { var d = new Date(t); d.setDate(d.getDate() + 7);  return { from: ymd(t), to: ymd(d) }; }
            if (activeRange === '30') { var e = new Date(t); e.setDate(e.getDate() + 30); return { from: ymd(t), to: ymd(e) }; }
            return { from: '0000-01-01', to: '9999-12-31' };
        }

        function apply() {
            var q = search.value.trim().toLowerCase();
            var r = computeRange();
            var vis = 0;
            days.forEach(function (day) {
                var dd = day.dataset.date || '';
                var inRange = dd >= r.from && dd <= r.to;
                var anyVisible = false;
                Array.prototype.slice.call(day.querySelectorAll('.gr-item')).forEach(function (it) {
                    var ok = inRange && (!q || (it.dataset.search || '').toLowerCase().includes(q));
                    it.style.display = ok ? '' : 'none';
                    if (ok) { anyVisible = true; vis++; }
                });
                day.style.display = anyVisible ? '' : 'none';
            });
            cnt.textContent = vis + ' görüş';
            if (noMatch) noMatch.style.display = vis === 0 ? '' : 'none';
        }

        chips.forEach(function (c) {
            c.addEventListener('click', function () {
                chips.forEach(function (x) { x.classList.remove('active'); });
                c.classList.add('active');
                activeRange = c.dataset.range;
                fromInp.value = ''; toInp.value = '';   // çip seçiləndə xüsusi aralığı təmizlə
                apply();
            });
        });
        [fromInp, toInp].forEach(function (inp) {
            inp.addEventListener('change', function () {
                chips.forEach(function (x) { x.classList.remove('active'); });  // xüsusi aralıq çipləri ləğv edir
                apply();
            });
        });
        search.addEventListener('input', apply);
    })();
</script>
}
