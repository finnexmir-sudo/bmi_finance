@using FinNex.Application.DTOs.Pid
@model KataloqViewDto
@{
    ViewData["Title"] = "Sorğular";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    // Xam Oracle dəyərini oxunaqlı mətnə çevir (böyük hesab nömrələri N2 ilə korlanmasın)
    string Hucre(object? v)
    {
        if (v == null) return "—";
        if (v is DateTime dt) return dt == dt.Date ? dt.ToString("dd.MM.yyyy") : dt.ToString("dd.MM.yyyy HH:mm");
        if (v is decimal dec) return dec == Math.Truncate(dec) ? dec.ToString("0") : dec.ToString("N2");
        if (v is double dbl)  return dbl == Math.Truncate(dbl) ? dbl.ToString("0") : dbl.ToString("N2");
        var s = v.ToString();
        return string.IsNullOrWhiteSpace(s) ? "—" : s;
    }
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">@(string.IsNullOrWhiteSpace(Model.SeciliAd) ? "Sorğular" : Model.SeciliAd)</h2>
            <p class="ms-sub">PİD — Oracle sorğusu (canlı)</p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            @if (Model.SeciliId.HasValue && Model.Netice != null)
            {
                <a asp-action="KataloqExcel" asp-route-sorguId="@Model.SeciliId" class="ms-btn ms-btn--primary">
                    <i class="bi bi-file-earmark-excel"></i> Excelə yüklə
                </a>
            }
            <a asp-action="Kataloq" asp-route-sorguId="@Model.SeciliId" class="ms-btn ms-btn--ghost"><i class="bi bi-arrow-clockwise"></i> Yenilə</a>
        </div>
    </div>

    @if (TempData["Error"] != null) { <div class="ms-alert ms-alert--error">@TempData["Error"]</div> }

    @if (!Model.Kataloglar.Any())
    {
        <div class="ms-alert ms-alert--warn">
            <i class="bi bi-exclamation-triangle"></i>
            Hələ sorğu yoxdur. <a asp-area="Admin" asp-controller="OracleSorgu" asp-action="Create">Admin → Oracle Sorğular</a>
            bölməsindən sorğu əlavə edib <b>"Sorğularda göstər"</b> işarələyin (məs. adı "Kataloq").
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Xeta))
    {
        <div class="ms-alert ms-alert--error"><i class="bi bi-x-octagon"></i> @Model.Xeta</div>
    }
    else if (Model.Netice != null)
    {
        <div class="kat-filter">
            <input type="text" id="katSearch" class="ms-input ms-grow" placeholder="🔍 Cədvəldə axtar (ad, hesab, rayon…)" />
            <div class="kat-chips" id="katChips">
                <button type="button" class="kat-chip active" data-f="hami">Hamısı</button>
                <button type="button" class="kat-chip" data-f="overdue" data-col="real_overdue_day" data-op="gt" data-val="90"><i class="bi bi-clock-history"></i> Gecikmə 90+</button>
                <button type="button" class="kat-chip" data-f="mehkeme" data-col="item_01" data-op="contains" data-val="məhk"><i class="bi bi-bank"></i> Məhkəmədə</button>
                <button type="button" class="kat-chip" data-f="zaminsiz" data-col="zamin_sayi" data-op="empty0"><i class="bi bi-person-x"></i> Zaminsiz</button>
            </div>
        </div>
        <div class="ms-card">
            <div class="ms-twrap">
                <table class="ms-table" id="katTable">
                    <thead>
                        <tr>
                            <th style="width:46px">№</th>
                            @foreach (var c in Model.Netice.Sutunlar)
                            {
                                <th>@c</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 0; }
                        @foreach (var row in Model.Netice.Setirler)
                        {
                            i++;
                            <tr>
                                <td class="kat-sira">@i</td>
                                @foreach (var cell in row)
                                {
                                    <td title="@Hucre(cell)">@Hucre(cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ms-foot">
                <span id="katCount">@Model.Netice.Setirler.Count</span> / @Model.Netice.Setirler.Count sətir · @Model.Netice.Sutunlar.Count sütun
                @if (Model.Kesildi)
                {
                    <span style="color:#b45309"> · ⚠ ilk @Model.Limit sətir göstərilir — tam siyahı üçün Excelə yüklə</span>
                }
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        #katTable tbody td { padding:7px 12px; border-bottom:1px solid #e5e7eb; border-right:1px solid #e5e7eb;
                             white-space:nowrap; max-width:280px; overflow:hidden; text-overflow:ellipsis; font-size:12.5px; }
        #katTable tbody td:last-child { border-right:none; }
        #katTable thead th { white-space:nowrap; }
        #katTable tbody tr:nth-child(even) td { background:#f8fafc; }
        #katTable tbody tr:hover td { background:#eff6ff; }
        .kat-sira { color:#94a3b8; font-weight:700; text-align:center; }
        .kat-filter { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:10px; }
        .kat-chips { display:flex; gap:6px; flex-wrap:wrap; }
        .kat-chip { display:inline-flex; align-items:center; gap:5px; padding:6px 12px; border-radius:999px;
                    border:1.5px solid #e2e8f0; background:#fff; color:#475569; font-size:13px; font-weight:600; cursor:pointer; }
        .kat-chip:hover { background:#f1f5f9; }
        .kat-chip.active { background:#6366f1; border-color:#6366f1; color:#fff; }
    </style>
}

@section Scripts {
<script>
    // Cədvəlin hündürlüyünü ekrana uyğunlaşdır — üfüqi scroll həmişə görünsün
    function katFit() {
        var tw = document.querySelector('.ms-twrap');
        if (!tw) return;
        var top = tw.getBoundingClientRect().top;
        var foot = document.querySelector('.ms-foot');
        var footH = foot ? foot.offsetHeight : 0;
        tw.style.maxHeight = Math.max(240, window.innerHeight - top - footH - 14) + 'px';
    }
    katFit();
    window.addEventListener('resize', katFit);

    // ── Sürətli filtrlər + axtarış ──
    (function () {
        var table = document.getElementById('katTable');
        if (!table) return;
        var rows   = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
        var ths    = Array.prototype.slice.call(table.querySelectorAll('thead th'));
        var chips  = Array.prototype.slice.call(document.querySelectorAll('#katChips .kat-chip'));
        var search = document.getElementById('katSearch');
        var countEl= document.getElementById('katCount');
        var active = 'hami';

        function norm(s){ return (s == null ? '' : s.toString()).trim().toLowerCase(); }
        function colIndex(name){
            name = norm(name);
            for (var k = 0; k < ths.length; k++) { if (norm(ths[k].textContent).indexOf(name) !== -1) return k; }
            return -1;
        }
        function num(s){ var n = parseFloat((s || '').toString().replace(/[^\d.\-]/g, '')); return isNaN(n) ? null : n; }

        // Sütunu olmayan çipi gizlət
        chips.forEach(function (c) {
            if (c.dataset.col && colIndex(c.dataset.col) === -1) c.style.display = 'none';
        });

        function chipOk(row, key){
            if (key === 'hami') return true;
            var c = chips.filter(function (x) { return x.dataset.f === key; })[0];
            if (!c) return true;
            var ci = colIndex(c.dataset.col);
            if (ci === -1) return true;
            var v = row.cells[ci] ? row.cells[ci].textContent.trim() : '';
            if (c.dataset.op === 'gt')       { var n = num(v); return n !== null && n > parseFloat(c.dataset.val); }
            if (c.dataset.op === 'contains') { return norm(v).indexOf(norm(c.dataset.val)) !== -1; }
            if (c.dataset.op === 'empty0')   { return v === '' || v === '0' || v === '—'; }
            return true;
        }
        function apply(){
            var q = norm(search.value), vis = 0;
            rows.forEach(function (r) {
                var ok = (!q || norm(r.textContent).indexOf(q) !== -1) && chipOk(r, active);
                r.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });
            if (countEl) countEl.textContent = vis;
        }
        chips.forEach(function (c) {
            c.addEventListener('click', function () {
                chips.forEach(function (x) { x.classList.remove('active'); });
                c.classList.add('active');
                active = c.dataset.f;
                apply();
            });
        });
        search.addEventListener('input', apply);
    })();
</script>
}
