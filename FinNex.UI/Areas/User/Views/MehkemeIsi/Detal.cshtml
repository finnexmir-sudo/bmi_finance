@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model MehkemeIsiDetailDto
@{
    ViewData["Title"] = "Məhkəmə İşi — " + Model.QeydiyyatNomresi;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="mi-page">
    <div class="mi-head">
        <div>
            <h2 class="mi-title">@Model.BorcluAd</h2>
            <p class="mi-sub">Qeydiyyat №: <strong>@Model.QeydiyyatNomresi</strong></p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <button class="mi-btn mi-btn--ghost" id="btnEdit"><i class="bi bi-pencil"></i> Redaktə</button>
            <a asp-action="Index" class="mi-btn mi-btn--ghost"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mi-alert mi-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mi-alert mi-alert--error">@TempData["Error"]</div>
    }

    <div class="mi-detal-grid">

        <!-- Sol: Məlumatlar kartı -->
        <div class="mi-info-card" id="viewCard">
            <div class="mi-info-title">İş məlumatları</div>
            <dl class="mi-dl">
                <dt>Növ</dt>
                <dd>@Html.Raw(NovBadge(Model.Nov))</dd>
                <dt>Status</dt>
                <dd>@Html.Raw(StatusBadge(Model.Status))</dd>
                <dt>Əsas borc</dt>
                <dd>@(Model.EsasBorc.HasValue ? Model.EsasBorc.Value.ToString("N2") + " ₼" : "—")</dd>
                <dt>Məhkəmə xərci</dt>
                <dd>@(Model.MehkemeXerci.HasValue ? Model.MehkemeXerci.Value.ToString("N2") + " ₼" : "—")</dd>
                <dt>Başlama tarixi</dt>
                <dd>@(Model.BaslamaTarixi.HasValue ? Model.BaslamaTarixi.Value.ToString("dd.MM.yyyy") : "—")</dd>
                <dt>Qeyd</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Qeyd) ? "—" : Model.Qeyd)</dd>
                <dt>Yaradılma</dt>
                <dd>@Model.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>

            <form asp-action="Sil" method="post" style="margin-top:16px"
                  onsubmit="return confirm('Bu məhkəmə işini silmək istədiyinizə əminsiniz?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="mi-btn mi-btn--danger mi-btn--sm">
                    <i class="bi bi-trash"></i> Sil
                </button>
            </form>
        </div>

        <!-- Sol: Redaktə formu (gizli) -->
        <div class="mi-info-card" id="editCard" style="display:none">
            <div class="mi-info-title">Redaktə</div>
            <form id="editForm">
                @Html.AntiForgeryToken()
                <div class="mi-form-grid">
                    <div class="mi-form-group">
                        <label class="mi-lbl">Növ</label>
                        <select name="Nov" id="eNov" class="mi-select">
                            <option value="1" @(Model.Nov == MehkemeIsiNov.Ipoteka ? "selected" : "")>İpoteka</option>
                            <option value="2" @(Model.Nov == MehkemeIsiNov.Istehlak ? "selected" : "")>İstehlak</option>
                            <option value="3" @(Model.Nov == MehkemeIsiNov.KartKredit ? "selected" : "")>Kart krediti</option>
                            <option value="4" @(Model.Nov == MehkemeIsiNov.Diger ? "selected" : "")>Digər</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Status</label>
                        <select name="Status" id="eStatus" class="mi-select">
                            <option value="1" @(Model.Status == MehkemeIsiStatus.Hazirlanir ? "selected" : "")>Hazırlanır</option>
                            <option value="2" @(Model.Status == MehkemeIsiStatus.Mehkemede ? "selected" : "")>Məhkəmədə</option>
                            <option value="3" @(Model.Status == MehkemeIsiStatus.Icra ? "selected" : "")>İcrada</option>
                            <option value="4" @(Model.Status == MehkemeIsiStatus.Tamamlandi ? "selected" : "")>Tamamlandı</option>
                            <option value="5" @(Model.Status == MehkemeIsiStatus.Baghlandi ? "selected" : "")>Bağlandı</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Məhkəmə xərci (₼)</label>
                        <input name="MehkemeXerci" class="mi-input" type="number" step="0.01" min="0"
                               value="@Model.MehkemeXerci" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Başlama tarixi</label>
                        <input name="BaslamaTarixi" class="mi-input" type="date"
                               value="@(Model.BaslamaTarixi.HasValue ? Model.BaslamaTarixi.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Qeyd</label>
                        <textarea name="Qeyd" class="mi-textarea" rows="2">@Model.Qeyd</textarea>
                    </div>
                </div>
                <div class="mi-form-actions">
                    <button type="button" id="btnSaveEdit" class="mi-btn mi-btn--primary mi-btn--sm">
                        <i class="bi bi-check-lg"></i> Saxla
                    </button>
                    <button type="button" id="btnCancelEdit" class="mi-btn mi-btn--ghost mi-btn--sm">Ləğv et</button>
                </div>
            </form>
        </div>

        <!-- Sağ: Mərhələlər -->
        <div class="mi-timeline-col">
            <div class="mi-info-card">
                <div class="mi-info-title">Yeni mərhələ</div>
                <form asp-action="MerheleElave" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                    <div class="mi-form-grid">
                        <div class="mi-form-group">
                            <label class="mi-lbl">Növ</label>
                            <select name="MerheleTipi" class="mi-select">
                                <option value="1">İddia verildi</option>
                                <option value="2">Məhkəmə iclası</option>
                                <option value="3">Qərar verildi</option>
                                <option value="4">İcra bağlandı</option>
                                <option value="5">Ödənildi</option>
                                <option value="6">Digər</option>
                            </select>
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Tarix</label>
                            <input name="Tarix" class="mi-input" type="date"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mi-form-group mi-form-group--full">
                            <label class="mi-lbl">Qeyd</label>
                            <textarea name="Qeyd" class="mi-textarea" rows="2" placeholder="Mərhələ qeydi…"></textarea>
                        </div>
                        <div class="mi-form-group mi-form-group--full">
                            <label class="mi-lbl">Sənəd (ixtiyari)</label>
                            <input type="file" name="fayl" class="mi-input" accept=".pdf,.doc,.docx,.jpg,.png" />
                        </div>
                    </div>
                    <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm">
                        <i class="bi bi-plus-lg"></i> Əlavə et
                    </button>
                </form>
            </div>

            <div class="mi-timeline">
                @if (Model.Merheleler.Any())
                {
                    @foreach (var m in Model.Merheleler)
                    {
                        <div class="mi-tl-item">
                            <div class="mi-tl-dot @TlDotClass(m.MerheleTipi)"></div>
                            <div class="mi-tl-body">
                                <div class="mi-tl-head">
                                    <span class="mi-tl-tipi">@MerheleTipiAd(m.MerheleTipi)</span>
                                    <span class="mi-tl-tarix">@m.Tarix.ToString("dd.MM.yyyy")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(m.Qeyd))
                                {
                                    <div class="mi-tl-qeyd">@m.Qeyd</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.SenedYolu))
                                {
                                    <a href="/dms/@m.SenedYolu" target="_blank" class="mi-tl-fayl">
                                        <i class="bi bi-file-earmark"></i> Sənəd
                                    </a>
                                }
                                <form asp-action="MerheleSil" method="post" class="mi-tl-del"
                                      onsubmit="return confirm('Bu mərhələni silmək istədiyinizə əminsiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="merheleId" value="@m.Id" />
                                    <input type="hidden" name="ishId" value="@Model.Id" />
                                    <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="mi-empty" style="padding:24px 0">
                        <i class="bi bi-clock-history"></i>
                        <div>Hələ mərhələ yoxdur</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    string NovBadge(MehkemeIsiNov nov) => nov switch
    {
        MehkemeIsiNov.Ipoteka    => "<span class=\"mi-badge mi-badge--ipoteka\">İpoteka</span>",
        MehkemeIsiNov.Istehlak   => "<span class=\"mi-badge mi-badge--istehlak\">İstehlak</span>",
        MehkemeIsiNov.KartKredit => "<span class=\"mi-badge mi-badge--kart\">Kart</span>",
        _                        => "<span class=\"mi-badge mi-badge--diger\">Digər</span>"
    };

    string StatusBadge(MehkemeIsiStatus s) => s switch
    {
        MehkemeIsiStatus.Hazirlanir => "<span class=\"mi-badge mi-badge--hazir\">Hazırlanır</span>",
        MehkemeIsiStatus.Mehkemede => "<span class=\"mi-badge mi-badge--mehkeme\">Məhkəmədə</span>",
        MehkemeIsiStatus.Icra       => "<span class=\"mi-badge mi-badge--icra\">İcrada</span>",
        MehkemeIsiStatus.Tamamlandi => "<span class=\"mi-badge mi-badge--tamam\">Tamamlandı</span>",
        MehkemeIsiStatus.Baghlandi  => "<span class=\"mi-badge mi-badge--bagli\">Bağlandı</span>",
        _                           => ""
    };

    string TlDotClass(MerheleTipi t) => t switch
    {
        MerheleTipi.IddiaVerildi  => "mi-tl-dot--blue",
        MerheleTipi.MehkemeIclasi => "mi-tl-dot--amber",
        MerheleTipi.QerarVerildi  => "mi-tl-dot--green",
        MerheleTipi.IcraBaglandi  => "mi-tl-dot--purple",
        MerheleTipi.Odendi        => "mi-tl-dot--teal",
        _                         => "mi-tl-dot--gray"
    };

    string MerheleTipiAd(MerheleTipi t) => t switch
    {
        MerheleTipi.IddiaVerildi  => "İddia verildi",
        MerheleTipi.MehkemeIclasi => "Məhkəmə iclası",
        MerheleTipi.QerarVerildi  => "Qərar verildi",
        MerheleTipi.IcraBaglandi  => "İcra bağlandı",
        MerheleTipi.Odendi        => "Ödənildi",
        _                         => "Digər"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
}

@section Scripts {
<script>
    var ishId = @Model.Id;

    document.getElementById('btnEdit').addEventListener('click', function () {
        document.getElementById('viewCard').style.display = 'none';
        document.getElementById('editCard').style.display = '';
    });
    document.getElementById('btnCancelEdit').addEventListener('click', function () {
        document.getElementById('editCard').style.display = 'none';
        document.getElementById('viewCard').style.display = '';
    });

    document.getElementById('btnSaveEdit').addEventListener('click', async function () {
        var form = document.getElementById('editForm');
        var data = new FormData(form);
        var params = new URLSearchParams();
        for (var [k, v] of data.entries()) params.append(k, v);

        try {
            var r = await fetch('/User/MehkemeIsi/Yenile/' + ishId, {
                method: 'POST',
                body: params
            });
            var json = await r.json();
            if (json.success) {
                location.reload();
            } else {
                alert(json.message || 'Xəta baş verdi.');
            }
        } catch {
            alert('Xəta baş verdi.');
        }
    });
</script>
}
