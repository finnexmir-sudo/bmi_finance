@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model MehkemeIsiDetailDto
@{
    ViewData["Title"] = "Məhkəmə İşi — " + Model.QeydiyyatNomresi;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

<div class="mi-page">
    <div class="mi-head">
        <div>
            <h2 class="mi-title">@Model.BorcluAd</h2>
            <p class="mi-sub">Qeydiyyat №: <strong>@Model.QeydiyyatNomresi</strong></p>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <button class="mi-btn mi-btn--ghost" id="btnEdit"><i class="bi bi-pencil"></i> Redaktə</button>
            <a asp-action="Index" class="mi-btn mi-btn--ghost"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mi-alert mi-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mi-alert mi-alert--error">@TempData["Error"]</div>
    }

    <!-- Yuxarı sıra: iş məlumatları + yeni mərhələ formu -->
    <div class="mi-detal-top">

        <!-- Sol: baxış kartı -->
        <div class="mi-info-card" id="viewCard">
            <div class="mi-info-title">İş məlumatları</div>
            <dl class="mi-dl">
                <dt>Növ</dt>
                <dd>@Html.Raw(NovBadge(Model.Nov))</dd>
                <dt>Status</dt>
                <dd>@Html.Raw(StatusBadge(Model.Status))</dd>
                <dt>Əsas borc</dt>
                <dd>@(Model.EsasBorc.HasValue ? Model.EsasBorc.Value.ToString("N2") + " ₼" : "—")</dd>
                <dt>Məhkəmə xərci</dt>
                <dd>@(Model.MehkemeXerci.HasValue ? Model.MehkemeXerci.Value.ToString("N2") + " ₼" : "—")</dd>
                <dt>Başlama tarixi</dt>
                <dd>@(Model.BaslamaTarixi.HasValue ? Model.BaslamaTarixi.Value.ToString("dd.MM.yyyy") : "—")</dd>
                <dt>Qeyd</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Qeyd) ? "—" : Model.Qeyd)</dd>
                <dt>Hesab / Subkod</dt>
                <dd>@(string.IsNullOrEmpty(Model.KreditHesabi) ? "—" : Model.KreditHesabi)@(string.IsNullOrEmpty(Model.Subkod) ? "" : " / " + Model.Subkod)</dd>
                <dt>Qalan borc</dt>
                <dd>@(Model.QalanBorc.HasValue ? Model.QalanBorc.Value.ToString("N2") + " ₼" : "—")</dd>
                <dt>Son ödəniş tarixi</dt>
                <dd>@(Model.SonOdenisTarixi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                <dt>Qeydiyyatı (rayon)</dt>
                <dd>@(string.IsNullOrEmpty(Model.Qeydiyyati) ? "—" : Model.Qeydiyyati)</dd>
                <dt>Əmək haqqı məlumatı</dt>
                <dd>@(string.IsNullOrEmpty(Model.EmekHaqqiMelumati) ? "—" : Model.EmekHaqqiMelumati)</dd>
                <dt>DYP sorğu tarixi</dt>
                <dd>@(Model.DypSorguTarixi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                <dt>Adına sorğu</dt>
                <dd>@(string.IsNullOrEmpty(Model.AdinaSorgu) ? "—" : Model.AdinaSorgu)</dd>
                <dt>Əmlaka həbs</dt>
                <dd>@(string.IsNullOrEmpty(Model.EmlakaHebs) ? "—" : Model.EmlakaHebs)</dd>
                <dt>Stop</dt>
                <dd>@(string.IsNullOrEmpty(Model.Stop) ? "—" : Model.Stop)</dd>
                <dt>İcra məmuru</dt>
                <dd>@(string.IsNullOrEmpty(Model.IcraMemuru) ? "—" : Model.IcraMemuru)</dd>
                <dt>İcraçı son işlər</dt>
                <dd>@(string.IsNullOrEmpty(Model.IcraSonIsler) ? "—" : Model.IcraSonIsler)</dd>
                <dt>Doğum tarixi</dt>
                <dd>@(Model.DogumTarixi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                <dt>Zamin</dt>
                <dd>@(string.IsNullOrEmpty(Model.Zamin) ? "—" : Model.Zamin)</dd>
                <dt>Qətnamə tarixi</dt>
                <dd>@(Model.QetnameTarixi?.ToString("dd.MM.yyyy") ?? "—")</dd>
                <dt>İş yeri</dt>
                <dd>@(string.IsNullOrEmpty(Model.IsYeri) ? "—" : Model.IsYeri)</dd>
                <dt>İcra qeydi</dt>
                <dd>@(string.IsNullOrEmpty(Model.IcraQeyd) ? "—" : Model.IcraQeyd)</dd>
                <dt>Yaradılma</dt>
                <dd>@Model.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>
            <form asp-action="Sil" method="post" style="margin-top:16px"
                  onsubmit="return confirm('Bu məhkəmə işini silmək istədiyinizə əminsiniz?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="mi-btn mi-btn--danger mi-btn--sm">
                    <i class="bi bi-trash"></i> Sil
                </button>
            </form>
        </div>

        <!-- Sol: redaktə formu (gizli) -->
        <div class="mi-info-card" id="editCard" style="display:none">
            <div class="mi-info-title">Redaktə</div>
            <form id="editForm">
                @Html.AntiForgeryToken()
                <div class="mi-form-grid">
                    <div class="mi-form-group">
                        <label class="mi-lbl">Növ</label>
                        <select asp-for="Nov" class="mi-select">
                            <option value="1">İpoteka</option>
                            <option value="2">İstehlak</option>
                            <option value="3">Kart krediti</option>
                            <option value="4">Digər</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Status</label>
                        <select asp-for="Status" class="mi-select">
                            <option value="1">Hazırlanır</option>
                            <option value="2">Məhkəmədə</option>
                            <option value="3">İcrada</option>
                            <option value="4">Tamamlandı</option>
                            <option value="5">Bağlandı</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Məhkəmə xərci (₼)</label>
                        <input name="MehkemeXerci" class="mi-input" type="number" step="0.01" min="0"
                               value="@Model.MehkemeXerci" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Başlama tarixi</label>
                        <input name="BaslamaTarixi" class="mi-input" type="date"
                               value="@(Model.BaslamaTarixi.HasValue ? Model.BaslamaTarixi.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Qeyd</label>
                        <textarea name="Qeyd" class="mi-textarea" rows="2">@Model.Qeyd</textarea>
                    </div>

                    <div class="mi-form-group"><label class="mi-lbl">Hesab №</label>
                        <input name="KreditHesabi" class="mi-input" value="@Model.KreditHesabi" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Subkod</label>
                        <input name="Subkod" class="mi-input" value="@Model.Subkod" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Qalan borc (₼)</label>
                        <input name="QalanBorc" class="mi-input" type="number" step="0.01" value="@Model.QalanBorc" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Son ödəniş tarixi</label>
                        <input name="SonOdenisTarixi" class="mi-input" type="date" value="@(Model.SonOdenisTarixi?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Qeydiyyatı (rayon)</label>
                        <input name="Qeydiyyati" class="mi-input" value="@Model.Qeydiyyati" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Əmək haqqı məlumatı</label>
                        <input name="EmekHaqqiMelumati" class="mi-input" value="@Model.EmekHaqqiMelumati" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">DYP sorğu tarixi</label>
                        <input name="DypSorguTarixi" class="mi-input" type="date" value="@(Model.DypSorguTarixi?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Adına sorğu</label>
                        <input name="AdinaSorgu" class="mi-input" value="@Model.AdinaSorgu" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Əmlaka həbs</label>
                        <input name="EmlakaHebs" class="mi-input" value="@Model.EmlakaHebs" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Stop</label>
                        <input name="Stop" class="mi-input" value="@Model.Stop" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">İcra məmuru</label>
                        <input name="IcraMemuru" class="mi-input" value="@Model.IcraMemuru" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Doğum tarixi</label>
                        <input name="DogumTarixi" class="mi-input" type="date" value="@(Model.DogumTarixi?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Zamin</label>
                        <input name="Zamin" class="mi-input" value="@Model.Zamin" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">Qətnamə tarixi</label>
                        <input name="QetnameTarixi" class="mi-input" type="date" value="@(Model.QetnameTarixi?.ToString("yyyy-MM-dd"))" /></div>
                    <div class="mi-form-group"><label class="mi-lbl">İş yeri</label>
                        <input name="IsYeri" class="mi-input" value="@Model.IsYeri" /></div>
                    <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcraçı son işlər</label>
                        <textarea name="IcraSonIsler" class="mi-textarea" rows="2">@Model.IcraSonIsler</textarea></div>
                    <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcra qeydi</label>
                        <textarea name="IcraQeyd" class="mi-textarea" rows="2">@Model.IcraQeyd</textarea></div>
                </div>
                <div class="mi-form-actions">
                    <button type="button" id="btnSaveEdit" class="mi-btn mi-btn--primary mi-btn--sm">
                        <i class="bi bi-check-lg"></i> Saxla
                    </button>
                    <button type="button" id="btnCancelEdit" class="mi-btn mi-btn--ghost mi-btn--sm">Ləğv et</button>
                </div>
            </form>
        </div>

        <!-- Sağ: yeni mərhələ formu -->
        <div class="mi-info-card mi-merhele-form">
            <div class="mi-info-title">Yeni mərhələ əlavə et</div>
            <form asp-action="MerheleElave" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                <div class="mi-form-grid mi-form-grid--3">
                    <div class="mi-form-group">
                        <label class="mi-lbl">Növ</label>
                        <select name="MerheleTipi" class="mi-select">
                            <option value="1">İddia verildi</option>
                            <option value="2">Məhkəmə iclası</option>
                            <option value="3">Qərar verildi</option>
                            <option value="4">İcra bağlandı</option>
                            <option value="5">Ödənildi</option>
                            <option value="6">Digər</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Tarix</label>
                        <input name="Tarix" class="mi-input" type="date"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Hakim</label>
                        <input name="Hakim" class="mi-input" maxlength="200" placeholder="Ad Soyad…" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">İcraçı memur</label>
                        <input name="IcraciMemur" class="mi-input" maxlength="200" placeholder="Ad Soyad…" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Sənəd (ixtiyari)</label>
                        <input type="file" name="fayl" class="mi-input" accept=".pdf,.doc,.docx,.jpg,.png" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Qeyd</label>
                        <textarea name="Qeyd" class="mi-textarea" rows="2" placeholder="Mərhələ qeydi…"></textarea>
                    </div>
                </div>
                <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm">
                    <i class="bi bi-plus-lg"></i> Əlavə et
                </button>
            </form>
        </div>
    </div>

    <!-- Mərhələlər cədvəli — tam en -->
    <div class="mi-info-card" style="margin-top:20px">
        <div class="mi-info-title" style="display:flex;justify-content:space-between;align-items:center">
            <span>Mərhələlər</span>
            <span class="mi-merhele-count">@Model.Merheleler.Count qeyd</span>
        </div>

        @if (Model.Merheleler.Any())
        {
            <div class="mi-merhele-table-wrap">
                <table class="mi-merhele-table">
                    <thead>
                        <tr>
                            <th>Növ</th>
                            <th>Tarix</th>
                            <th>Hakim</th>
                            <th>İcraçı memur</th>
                            <th>Qeyd</th>
                            <th>Sənəd</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Merheleler)
                        {
                            <tr>
                                <td>
                                    <span class="mi-badge @MerheleBadgeClass(m.MerheleTipi)">
                                        @MerheleTipiAd(m.MerheleTipi)
                                    </span>
                                </td>
                                <td class="mi-td-nowrap">@m.Tarix.ToString("dd.MM.yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(m.Hakim) ? "—" : m.Hakim)</td>
                                <td>@(string.IsNullOrWhiteSpace(m.IcraciMemur) ? "—" : m.IcraciMemur)</td>
                                <td class="mi-td-qeyd" title="@m.Qeyd">
                                    @if (!string.IsNullOrWhiteSpace(m.Qeyd))
                                    {
                                        @(m.Qeyd.Length > 60 ? m.Qeyd[..60] + "…" : m.Qeyd)
                                    }
                                    else { <span class="mi-muted">—</span> }
                                </td>
                                <td class="mi-td-nowrap">
                                    @if (!string.IsNullOrWhiteSpace(m.SenedYolu))
                                    {
                                        <a href="/dms/@m.SenedYolu" target="_blank"
                                           class="mi-btn-icon" title="Sənədi aç">
                                            <i class="bi bi-file-earmark-arrow-down"></i>
                                        </a>
                                    }
                                    else { <span class="mi-muted">—</span> }
                                </td>
                                <td>
                                    <form asp-action="MerheleSil" method="post"
                                          onsubmit="return confirm('Bu mərhələni silmək istədiyinizə əminsiniz?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="merheleId" value="@m.Id" />
                                        <input type="hidden" name="ishId" value="@Model.Id" />
                                        <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mi-empty" style="padding:24px 0">
                <i class="bi bi-clock-history"></i>
                <div>Hələ mərhələ yoxdur</div>
            </div>
        }
    </div>
</div>

@functions {
    string NovBadge(MehkemeIsiNov nov) => nov switch
    {
        MehkemeIsiNov.Ipoteka    => "<span class=\"mi-badge mi-badge--ipoteka\">İpoteka</span>",
        MehkemeIsiNov.Istehlak   => "<span class=\"mi-badge mi-badge--istehlak\">İstehlak</span>",
        MehkemeIsiNov.KartKredit => "<span class=\"mi-badge mi-badge--kart\">Kart</span>",
        _                        => "<span class=\"mi-badge mi-badge--diger\">Digər</span>"
    };

    string StatusBadge(MehkemeIsiStatus s) => s switch
    {
        MehkemeIsiStatus.Hazirlanir => "<span class=\"mi-badge mi-badge--hazir\">Hazırlanır</span>",
        MehkemeIsiStatus.Mehkemede  => "<span class=\"mi-badge mi-badge--mehkeme\">Məhkəmədə</span>",
        MehkemeIsiStatus.Icra       => "<span class=\"mi-badge mi-badge--icra\">İcrada</span>",
        MehkemeIsiStatus.Tamamlandi => "<span class=\"mi-badge mi-badge--tamam\">Tamamlandı</span>",
        MehkemeIsiStatus.Baghlandi  => "<span class=\"mi-badge mi-badge--bagli\">Bağlandı</span>",
        _                           => ""
    };

    string MerheleBadgeClass(MerheleTipi t) => t switch
    {
        MerheleTipi.IddiaVerildi  => "mi-badge--blue",
        MerheleTipi.MehkemeIclasi => "mi-badge--amber",
        MerheleTipi.QerarVerildi  => "mi-badge--tamam",
        MerheleTipi.IcraBaglandi  => "mi-badge--icra",
        MerheleTipi.Odendi        => "mi-badge--mehkeme",
        _                         => "mi-badge--diger"
    };

    string MerheleTipiAd(MerheleTipi t) => t switch
    {
        MerheleTipi.IddiaVerildi  => "İddia verildi",
        MerheleTipi.MehkemeIclasi => "Məhk. iclası",
        MerheleTipi.QerarVerildi  => "Qərar verildi",
        MerheleTipi.IcraBaglandi  => "İcra bağlandı",
        MerheleTipi.Odendi        => "Ödənildi",
        _                         => "Digər"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
}

@section Scripts {
<script>
    var ishId = @Model.Id;

    document.getElementById('btnEdit').addEventListener('click', function () {
        document.getElementById('viewCard').style.display = 'none';
        document.getElementById('editCard').style.display = '';
    });
    document.getElementById('btnCancelEdit').addEventListener('click', function () {
        document.getElementById('editCard').style.display = 'none';
        document.getElementById('viewCard').style.display = '';
    });

    document.getElementById('btnSaveEdit').addEventListener('click', async function () {
        var form = document.getElementById('editForm');
        var data = new FormData(form);
        var params = new URLSearchParams();
        for (var [k, v] of data.entries()) params.append(k, v);

        try {
            var r = await fetch('/User/MehkemeIsi/Yenile/' + ishId, {
                method: 'POST',
                body: params
            });
            var json = await r.json();
            if (json.success) {
                location.reload();
            } else {
                alert(json.message || 'Xəta baş verdi.');
            }
        } catch {
            alert('Xəta baş verdi.');
        }
    });
</script>
}
