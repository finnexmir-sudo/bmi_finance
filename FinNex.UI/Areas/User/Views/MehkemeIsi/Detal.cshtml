@using FinNex.Application.DTOs.Pid
@using FinNex.Domain.Entities.Pid
@model MehkemeIsiDetailDto
@{
    ViewData["Title"] = "Məhkəmə İşi — " + Model.QeydiyyatNomresi;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    (string stName, string stCls) = Model.Status switch
    {
        MehkemeIsiStatus.Hazirlanir => ("Hazırlanır", "dt-st-hazir"),
        MehkemeIsiStatus.Mehkemede  => ("Məhkəmədə", "dt-st-mehkeme"),
        MehkemeIsiStatus.Icra       => ("İcrada", "dt-st-icra"),
        MehkemeIsiStatus.Tamamlandi => ("Tamamlandı", "dt-st-tamam"),
        MehkemeIsiStatus.Baghlandi  => ("Bağlandı", "dt-st-bagli"),
        _                           => ("—", "dt-st-hazir")
    };
    // Status Oracle item_01-dən gəlir (varsa); yoxsa daxili enum
    string statusText = !string.IsNullOrWhiteSpace(Model.StatusMetn) ? Model.StatusMetn! : stName;
    string statusCls  = !string.IsNullOrWhiteSpace(Model.StatusMetn) ? StatusOracleCls(Model.StatusMetn) : stCls;

    string novText = Model.Nov switch
    {
        MehkemeIsiNov.Ipoteka    => "İpoteka",
        MehkemeIsiNov.Istehlak   => "İstehlak",
        MehkemeIsiNov.KartKredit => "Kart krediti",
        _                        => "Digər"
    };

    var docs = Model.Merheleler.Where(m => !string.IsNullOrWhiteSpace(m.SenedYolu)).ToList();
}

<div class="dt-page">

    <!-- ═══ Başlıq ═══ -->
    <div class="dt-hero">
        <div class="dt-hero-main">
            <div class="dt-hero-name">@Model.BorcluAd</div>
            <div class="dt-hero-meta">
                <span class="dt-chip"><b>№</b> @Model.QeydiyyatNomresi</span>
                @if (!string.IsNullOrWhiteSpace(Model.KreditHesabi))
                {
                    <span class="dt-chip"><b>Hesab:</b> @Model.KreditHesabi@(string.IsNullOrWhiteSpace(Model.Subkod) ? "" : " / " + Model.Subkod)</span>
                }
                <span class="dt-chip"><b>Təminat:</b> @(string.IsNullOrWhiteSpace(Model.TeminatMetn) ? novText : Model.TeminatMetn)</span>
                @if (Model.DogumTarixi.HasValue)
                {
                    <span class="dt-chip"><b>Doğum:</b> @D(Model.DogumTarixi)</span>
                }
            </div>
        </div>
        <div class="dt-hero-side">
            <span class="dt-status @statusCls">@statusText</span>
            <div class="dt-actions">
                <a asp-action="Index" class="mi-btn mi-btn--ghost mi-btn--sm"><i class="bi bi-arrow-left"></i> Geri</a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="mi-alert mi-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mi-alert mi-alert--error">@TempData["Error"]</div>
    }

    <!-- ═══ Oxuma görünüşü ═══ -->
    <div id="readView">

        <!-- Maliyyə -->
        <div class="dt-stats">
            <div class="dt-stat dt-stat--danger">
                <div class="dt-stat-lbl">Tam borc</div>
                <div class="dt-stat-val">@M(Model.QalanBorc)</div>
            </div>
            <div class="dt-stat">
                <div class="dt-stat-lbl">Əsas borc</div>
                <div class="dt-stat-val">@M(Model.EsasBorc)</div>
            </div>
            <div class="dt-stat">
                <div class="dt-stat-lbl">Faiz borcu</div>
                <div class="dt-stat-val">@M(Model.FaizBorcu)</div>
            </div>
            <div class="dt-stat">
                <div class="dt-stat-lbl">Məhkəmə xərci</div>
                <div class="dt-stat-val">@M(Model.MehkemeXerci)</div>
            </div>
            <div class="dt-stat">
                <div class="dt-stat-lbl">Son ödəniş tarixi</div>
                <div class="dt-stat-val">@D(Model.SonOdenisTarixi)</div>
            </div>
        </div>
        @if (Model.MaliyyeCanli)
        {
            <div class="dt-note"><i class="bi bi-broadcast"></i> Maliyyə Oracle canlısındandır — Məhkəmə xərci əl ilə daxil edilir.</div>
        }
        else
        {
            <div class="dt-note"><i class="bi bi-info-circle"></i> Bu kredit Oracle aktiv siyahısında yoxdur — maliyyə əl ilə doldurulur.</div>
        }

        <!-- ═══ Məhkəmə fazası ═══ -->
        <div class="dt-card">
            <div class="dt-card-h">
                <span><i class="bi bi-bank"></i> Məhkəmə fazası</span>
                <span style="display:flex;gap:8px;align-items:center">
                    <span class="dt-sub">@Model.Merheleler.Count mərhələ</span>
                    <button type="button" class="mi-btn mi-btn--ghost mi-btn--sm" id="btnMehEdit"><i class="bi bi-pencil"></i> Redaktə</button>
                </span>
            </div>

            <div class="dt-facts" id="mehFacts">
                <div>
                    <div class="dt-fact-lbl">Məhkəmə / İş №</div>
                    <div class="dt-fact-val">@V(Model.IsNomresi)</div>
                </div>
                <div>
                    <div class="dt-fact-lbl">Hakim</div>
                    <div class="dt-fact-val">@V(Model.Hakim)</div>
                </div>
                <div>
                    <div class="dt-fact-lbl">Növ</div>
                    <div class="dt-fact-val">@novText</div>
                </div>
                <div>
                    <div class="dt-fact-lbl">Məhkəməyə verilmə</div>
                    <div class="dt-fact-val">@D(Model.BaslamaTarixi)</div>
                </div>
                <div>
                    <div class="dt-fact-lbl">Qətnamə tarixi</div>
                    <div class="dt-fact-val">@D(Model.QetnameTarixi)</div>
                </div>
                <div>
                    <div class="dt-fact-lbl">İş statusu</div>
                    <div class="dt-fact-val"><span class="dt-status dt-status--sm @stCls">@stName</span></div>
                </div>
            </div>

            <!-- Məhkəmə fazası redaktə (gizli) -->
            <form id="mehEdit" asp-action="MehkemeFaza" method="post" style="display:none;margin-bottom:6px">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mi-form-grid mi-form-grid--3">
                    <div class="mi-form-group">
                        <label class="mi-lbl">Status (iş axını)</label>
                        <select name="Status" class="mi-select">
                            <option value="1" selected="@(Model.Status == MehkemeIsiStatus.Hazirlanir ? "selected" : null)">Hazırlanır</option>
                            <option value="2" selected="@(Model.Status == MehkemeIsiStatus.Mehkemede ? "selected" : null)">Məhkəmədə</option>
                            <option value="3" selected="@(Model.Status == MehkemeIsiStatus.Icra ? "selected" : null)">İcrada</option>
                            <option value="4" selected="@(Model.Status == MehkemeIsiStatus.Tamamlandi ? "selected" : null)">Tamamlandı</option>
                            <option value="5" selected="@(Model.Status == MehkemeIsiStatus.Baghlandi ? "selected" : null)">Bağlandı</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Növ</label>
                        <select name="Nov" class="mi-select">
                            <option value="1" selected="@(Model.Nov == MehkemeIsiNov.Ipoteka ? "selected" : null)">İpoteka</option>
                            <option value="2" selected="@(Model.Nov == MehkemeIsiNov.Istehlak ? "selected" : null)">İstehlak</option>
                            <option value="3" selected="@(Model.Nov == MehkemeIsiNov.KartKredit ? "selected" : null)">Kart krediti</option>
                            <option value="4" selected="@(Model.Nov == MehkemeIsiNov.Diger ? "selected" : null)">Digər</option>
                        </select>
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Hakim</label>
                        <input name="Hakim" class="mi-input" value="@Model.Hakim" placeholder="məs: Mahmudova Həqiqət" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Məhkəməyə verilmə tarixi</label>
                        <input name="BaslamaTarixi" class="mi-input" type="date" value="@(Model.BaslamaTarixi.HasValue ? Model.BaslamaTarixi.Value.ToString("yyyy-MM-dd") : "")" />
                    </div>
                    <div class="mi-form-group">
                        <label class="mi-lbl">Qətnamə tarixi</label>
                        <input name="QetnameTarixi" class="mi-input" type="date" value="@(Model.QetnameTarixi?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Məhkəmə / İş №</label>
                        <input name="IsNomresi" class="mi-input" value="@Model.IsNomresi" placeholder="məs: Sabunçu RM  e-2(008)-8842/2021" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Qətnamə (mətn)</label>
                        <input name="Qerardad" class="mi-input" value="@Model.Qerardad" placeholder="Məhkəmə qətnaməsi…" />
                    </div>
                    <div class="mi-form-group mi-form-group--full">
                        <label class="mi-lbl">Ümumi qeyd</label>
                        <textarea name="Qeyd" class="mi-textarea" rows="2">@Model.Qeyd</textarea>
                    </div>
                </div>
                <div class="mi-form-actions">
                    <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-check-lg"></i> Saxla</button>
                    <button type="button" class="mi-btn mi-btn--ghost mi-btn--sm" id="btnMehCancel">Ləğv et</button>
                </div>
            </form>

            @if (Model.Merheleler.Any())
            {
                <div class="dt-tl">
                    @foreach (var m in Model.Merheleler.OrderBy(x => x.Tarix))
                    {
                        <div class="dt-tl-item">
                            <span class="dt-tl-dot"></span>
                            <div class="dt-tl-top">
                                <span class="mi-badge @MerheleBadgeClass(m.MerheleTipi)">@MerheleTipiAd(m.MerheleTipi)</span>
                                <span class="dt-tl-date">@m.Tarix.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(m.Saat) ? "" : " · " + m.Saat)</span>
                                @if (!string.IsNullOrWhiteSpace(m.SenedYolu))
                                {
                                    <a href="/dms/@m.SenedYolu" target="@(FaylBaxilabilir(m.SenedYolu) ? "_blank" : null)" download="@(FaylBaxilabilir(m.SenedYolu) ? null : "")" class="dt-tl-doc"><i class="bi bi-paperclip"></i> Sənəd</a>
                                }
                                <form asp-action="MerheleSil" method="post" class="dt-tl-del"
                                      onsubmit="return confirm('Bu mərhələ silinsin?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="merheleId" value="@m.Id" />
                                    <input type="hidden" name="ishId" value="@Model.Id" />
                                    <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Sil"><i class="bi bi-x"></i></button>
                                </form>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(m.IsNomresi) || !string.IsNullOrWhiteSpace(m.Hakim) || !string.IsNullOrWhiteSpace(m.IcraciMemur))
                            {
                                <div class="dt-tl-meta">
                                    @if (!string.IsNullOrWhiteSpace(m.IsNomresi)) { <span><b>Məhkəmə / İş №:</b> @m.IsNomresi</span> }
                                    @if (!string.IsNullOrWhiteSpace(m.Hakim)) { <span><b>Hakim:</b> @m.Hakim</span> }
                                    @if (!string.IsNullOrWhiteSpace(m.IcraciMemur)) { <span><b>İcraçı:</b> @m.IcraciMemur</span> }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.Qeyd))
                            {
                                <div class="dt-tl-note">@m.Qeyd</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="dt-empty"><i class="bi bi-clock-history"></i> Hələ mərhələ yoxdur</div>
            }

            <details class="dt-add">
                <summary><i class="bi bi-plus-lg"></i> Yeni mərhələ əlavə et</summary>
                <form asp-action="MerheleElave" method="post" enctype="multipart/form-data" id="merheleForm" style="margin-top:12px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                    <div class="mi-form-grid mi-form-grid--3">
                        <div class="mi-form-group">
                            <label class="mi-lbl">Növ</label>
                            <select name="MerheleTipi" id="merheleNov" class="mi-select">
                                <option value="2">Məhkəmə iclası (görüş)</option>
                                <option value="7">Qətnamə gəldi</option>
                                <option value="8">Ekspertizaya göndərildi</option>
                                <option value="9">Geri qaytarıldı</option>
                                <option value="6">Digər</option>
                            </select>
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Tarix</label>
                            <input name="Tarix" class="mi-input" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="mi-form-group" id="merheleSaatGroup">
                            <label class="mi-lbl">Saat <span class="dt-sub">(24 saat — SS:DD)</span></label>
                            <input name="Saat" id="merheleSaat" class="mi-input" type="text" inputmode="numeric" autocomplete="off" placeholder="məs: 14:40" maxlength="5" />
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Sənəd (ixtiyari)</label>
                            <input type="file" name="fayl" class="mi-input" accept=".pdf,.doc,.docx,.jpg,.png" />
                        </div>
                        <div class="mi-form-group mi-form-group--full">
                            <label class="mi-lbl">Qeyd</label>
                            <textarea name="Qeyd" class="mi-textarea" rows="2" placeholder="Mərhələ qeydi…"></textarea>
                        </div>
                    </div>
                    <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-plus-lg"></i> Əlavə et</button>
                </form>
            </details>
        </div>

        <!-- ═══ İcra subyektləri (cədvəl) ═══ -->
        <div class="dt-card">
            <div class="dt-card-h">
                <span><i class="bi bi-people"></i> İcra subyektləri <span class="dt-sub">(borclu + zaminlər)</span></span>
                <span style="display:flex;gap:8px;align-items:center">
                    <button type="button" class="mi-btn mi-btn--ghost mi-btn--sm" id="dtToggleCols"><i class="bi bi-layout-three-columns"></i> Detallı sütunlar</button>
                </span>
            </div>

            <div class="dt-twrap">
                <table class="dt-table" id="dtSubjTable">
                    <thead>
                        <tr>
                            <th>Rol</th>
                            <th>Ad</th>
                            <th>Qeydiyyat</th>
                            <th>Əmək haqqı</th>
                            <th class="dt-ex">İş yeri</th>
                            <th class="dt-ex">DYP sorğu</th>
                            <th class="dt-ex">Adına sorğu</th>
                            <th>Əmlaka həbs</th>
                            <th>Stop</th>
                            <th>İcra məmuru</th>
                            <th class="dt-ex">Son işlər</th>
                            <th class="dt-row-act"></th>
                        </tr>
                    </thead>

                    <!-- Borclu -->
                    <tbody class="dt-grp">
                        <tr class="dt-row dt-row--borclu" onclick="dtToggle(event, this)">
                            <td><span class="dt-role dt-role--borclu">BORCLU</span></td>
                            <td class="dt-ad" title="@Model.BorcluAd">@Model.BorcluAd</td>
                            <td class="dt-c" title="@Model.Qeydiyyati">@V(Model.Qeydiyyati)</td>
                            <td class="dt-c" title="@Model.EmekHaqqiMelumati">@V(Model.EmekHaqqiMelumati)</td>
                            <td class="dt-c dt-ex" title="@Model.IsYeri">@V(Model.IsYeri)</td>
                            <td class="dt-c dt-ex">@D(Model.DypSorguTarixi)</td>
                            <td class="dt-c dt-ex" title="@Model.AdinaSorgu">@V(Model.AdinaSorgu)</td>
                            <td class="dt-c" title="@Model.EmlakaHebs">@V(Model.EmlakaHebs)</td>
                            <td class="dt-c" title="@Model.Stop">@V(Model.Stop)</td>
                            <td class="dt-c" title="@Model.IcraMemuru">@V(Model.IcraMemuru)</td>
                            <td class="dt-c dt-ex" title="@Model.IcraSonIsler">@V(Model.IcraSonIsler)</td>
                            <td class="dt-row-act"><i class="bi bi-chevron-down dt-chev"></i></td>
                        </tr>
                        <tr class="dt-detail">
                            <td colspan="12">
                                <div class="dt-detail-in">
                                    <div class="dt-detail-chips">
                                        @if (Model.DogumTarixi.HasValue) { <span class="dt-chip"><b>Doğum:</b> @D(Model.DogumTarixi)</span> }
                                        @if (!string.IsNullOrWhiteSpace(Model.KreditHesabi)) { <span class="dt-chip"><b>Hesab:</b> @Model.KreditHesabi@(string.IsNullOrWhiteSpace(Model.Subkod) ? "" : " / " + Model.Subkod)</span> }
                                    </div>
                                    <form asp-action="IcraFaza" method="post" style="margin-top:6px">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <div class="mi-form-grid mi-form-grid--3">
                                            <div class="mi-form-group"><label class="mi-lbl">Qalan borc (₼)</label><input name="QalanBorc" class="mi-input" type="number" step="0.01" min="0" value="@(Model.QalanBorc?.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Son ödəniş tarixi</label><input name="SonOdenisTarixi" class="mi-input" type="date" value="@(Model.SonOdenisTarixi?.ToString("yyyy-MM-dd"))" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Doğum tarixi</label><input name="DogumTarixi" class="mi-input" type="date" value="@(Model.DogumTarixi?.ToString("yyyy-MM-dd"))" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Qeydiyyatı (rayon)</label><input name="Qeydiyyati" class="mi-input" value="@Model.Qeydiyyati" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Əmək haqqı məlumatı</label><input name="EmekHaqqiMelumati" class="mi-input" value="@Model.EmekHaqqiMelumati" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">İş yeri</label><input name="IsYeri" class="mi-input" value="@Model.IsYeri" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">İcra məmuru</label><input name="IcraMemuru" class="mi-input" value="@Model.IcraMemuru" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">DYP sorğu tarixi</label><input name="DypSorguTarixi" class="mi-input" type="date" value="@(Model.DypSorguTarixi?.ToString("yyyy-MM-dd"))" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Adına sorğu</label><input name="AdinaSorgu" class="mi-input" value="@Model.AdinaSorgu" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Əmlaka həbs</label><input name="EmlakaHebs" class="mi-input" value="@Model.EmlakaHebs" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Stop</label><input name="Stop" class="mi-input" value="@Model.Stop" /></div>
                                            <div class="mi-form-group"><label class="mi-lbl">Zamin (mətn)</label><input name="Zamin" class="mi-input" value="@Model.Zamin" /></div>
                                            <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcraçı son işlər</label><input name="IcraSonIsler" class="mi-input" value="@Model.IcraSonIsler" /></div>
                                            <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcra qeydi</label><textarea name="IcraQeyd" class="mi-textarea" rows="2">@Model.IcraQeyd</textarea></div>
                                        </div>
                                        <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-check-lg"></i> Saxla</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    </tbody>

                    <!-- Zaminlər -->
                    @foreach (var z in Model.Zaminler)
                    {
                        <tbody class="dt-grp">
                            <tr class="dt-row dt-row--zamin" onclick="dtToggle(event, this)">
                                <td><span class="dt-role dt-role--zamin">ZAMİN</span></td>
                                <td class="dt-ad" title="@z.Ad">@z.Ad</td>
                                <td class="dt-c" title="@z.Unvan">@V(z.Unvan)</td>
                                <td class="dt-c" title="@z.EmekHaqqiTutulma">@V(z.EmekHaqqiTutulma)</td>
                                <td class="dt-c dt-ex" title="@z.IsYeri">@V(z.IsYeri)</td>
                                <td class="dt-c dt-ex" title="@z.DypSorgu">@V(z.DypSorgu)</td>
                                <td class="dt-c dt-ex" title="@z.AdinaSorgu">@V(z.AdinaSorgu)</td>
                                <td class="dt-c" title="@z.EmlakaHebs">@V(z.EmlakaHebs)</td>
                                <td class="dt-c" title="@z.Stop">@V(z.Stop)</td>
                                <td class="dt-c" title="@z.IcraMemuru">@V(z.IcraMemuru)</td>
                                <td class="dt-c dt-ex" title="@z.IcraSonIsler">@V(z.IcraSonIsler)</td>
                                <td class="dt-row-act"><i class="bi bi-chevron-down dt-chev"></i></td>
                            </tr>
                            <tr class="dt-detail">
                                <td colspan="12">
                                    <div class="dt-detail-in">
                                        <div class="dt-detail-top">
                                            <div class="dt-detail-chips">
                                                @if (!string.IsNullOrWhiteSpace(z.Fin)) { <span class="dt-chip"><b>FİN:</b> @z.Fin</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.DogumTarixi)) { <span class="dt-chip"><b>Doğum:</b> @Dg(z.DogumTarixi)</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.Telefon)) { <span class="dt-chip"><b>Tel:</b> @z.Telefon</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.Unvan)) { <span class="dt-chip"><b>Ünvan:</b> @z.Unvan</span> }
                                            </div>
                                            <form asp-action="ZaminSil" method="post" onsubmit="return confirm('Bu zamin silinsin?');" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="zaminId" value="@z.Id" />
                                                <input type="hidden" name="ishId" value="@Model.Id" />
                                                <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Zamini sil"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                        <form asp-action="ZaminYenile" method="post" style="margin-top:6px">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@z.Id" />
                                            <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                                            <div class="mi-form-grid mi-form-grid--3">
                                                <div class="mi-form-group"><label class="mi-lbl">Əmək haqqına tutulma</label><input name="EmekHaqqiTutulma" class="mi-input" value="@z.EmekHaqqiTutulma" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">İş yeri</label><input name="IsYeri" class="mi-input" value="@z.IsYeri" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">Əmlaka həbs</label><input name="EmlakaHebs" class="mi-input" value="@z.EmlakaHebs" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">Stop</label><input name="Stop" class="mi-input" value="@z.Stop" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">İcra məmuru</label><input name="IcraMemuru" class="mi-input" value="@z.IcraMemuru" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">DYP sorğu</label><input name="DypSorgu" class="mi-input" value="@z.DypSorgu" /></div>
                                                <div class="mi-form-group"><label class="mi-lbl">Adına sorğu</label><input name="AdinaSorgu" class="mi-input" value="@z.AdinaSorgu" /></div>
                                                <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcraçı son işlər</label><input name="IcraSonIsler" class="mi-input" value="@z.IcraSonIsler" /></div>
                                                <div class="mi-form-group mi-form-group--full"><label class="mi-lbl">İcra qeydi</label><textarea name="IcraQeyd" class="mi-textarea" rows="2">@z.IcraQeyd</textarea></div>
                                            </div>
                                            <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-check-lg"></i> Saxla</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    }
                </table>
            </div>

            @if (!Model.Zaminler.Any())
            {
                <div class="dt-subj-hint"><i class="bi bi-info-circle"></i> Zamin yoxdur — iş açılanda əsas sorğudan avtomatik yüklənir</div>
            }
        </div>

        <!-- ═══ Sənədlər ═══ -->
        <div class="dt-card">
            <div class="dt-card-h">
                <span><i class="bi bi-folder2-open"></i> Sənədlər</span>
                <span class="dt-sub">@(docs.Count + Model.Senedler.Count) fayl</span>
            </div>

            @* İşə birbaşa yüklənən sənədlər *@
            @foreach (var s in Model.Senedler)
            {
                <div class="dt-doc">
                    <i class="bi bi-file-earmark-text"></i>
                    <span class="mi-badge @SenedNovBadge(s.Novu)">@SenedNovAd(s.Novu)</span>
                    <span class="dt-doc-name">@s.Ad</span>
                    @if (s.Tarix.HasValue)
                    {
                        <span class="dt-doc-date">@s.Tarix.Value.ToString("dd.MM.yyyy")</span>
                    }
                    <a href="/dms/@s.FaylYolu" target="@(FaylBaxilabilir(s.FaylYolu) ? "_blank" : null)" download="@(FaylBaxilabilir(s.FaylYolu) ? null : "")" class="mi-btn mi-btn--ghost mi-btn--sm"><i class="bi bi-box-arrow-up-right"></i> Aç</a>
                    <form asp-action="SenedSil" method="post" onsubmit="return confirm('Bu sənəd silinsin?');" style="display:inline;margin-left:4px">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="senedId" value="@s.Id" />
                        <input type="hidden" name="ishId" value="@Model.Id" />
                        <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Sil"><i class="bi bi-x"></i></button>
                    </form>
                </div>
            }

            @* Mərhələyə bağlı sənədlər *@
            @foreach (var m in docs.OrderBy(x => x.Tarix))
            {
                <div class="dt-doc">
                    <i class="bi bi-file-earmark-text"></i>
                    <span class="mi-badge @MerheleBadgeClass(m.MerheleTipi)">@MerheleTipiAd(m.MerheleTipi)</span>
                    <span class="dt-doc-name dt-doc-name--muted">Mərhələ faylı</span>
                    <span class="dt-doc-date">@m.Tarix.ToString("dd.MM.yyyy")</span>
                    <a href="/dms/@m.SenedYolu" target="@(FaylBaxilabilir(m.SenedYolu) ? "_blank" : null)" download="@(FaylBaxilabilir(m.SenedYolu) ? null : "")" class="mi-btn mi-btn--ghost mi-btn--sm"><i class="bi bi-box-arrow-up-right"></i> Aç</a>
                </div>
            }

            @if (!docs.Any() && !Model.Senedler.Any())
            {
                <div class="dt-empty"><i class="bi bi-folder2"></i> Hələ sənəd yoxdur</div>
            }

            <details class="dt-add">
                <summary><i class="bi bi-plus-lg"></i> Sənəd yüklə</summary>
                <form asp-action="SenedYukle" method="post" enctype="multipart/form-data" style="margin-top:12px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                    <div class="mi-form-grid mi-form-grid--3">
                        <div class="mi-form-group">
                            <label class="mi-lbl">Növ</label>
                            <select name="Novu" class="mi-select">
                                <option value="1">İddia ərizəsi</option>
                                <option value="2">Qətnamə</option>
                                <option value="3">İcra vərəqəsi</option>
                                <option value="4" selected>Digər</option>
                            </select>
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Başlıq</label>
                            <input name="Ad" class="mi-input" maxlength="200" placeholder="Sənəd adı (boş olsa fayl adı)" />
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Fayl</label>
                            <input type="file" name="fayl" class="mi-input" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required />
                        </div>
                    </div>
                    <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-upload"></i> Yüklə</button>
                </form>
            </details>
        </div>

        <!-- ═══ Məhkəmə xərcləri (bir neçə ola bilər) — ən aşağıda ═══ -->
        <div class="dt-card">
            <div class="dt-card-h">
                <span><i class="bi bi-cash-stack"></i> Məhkəmə xərcləri <span class="dt-sub">(fərqli məhkəmələr)</span></span>
                <span class="dt-sub">Cəm: <b>@M(Model.MehkemeXerci)</b></span>
            </div>
            @if (Model.Xercler.Any())
            {
                <div class="dt-twrap">
                    <table class="dt-table">
                        <thead>
                            <tr><th class="ms-num">Məbləğ</th><th>Tarix</th><th>Məhkəmə / qeyd</th><th class="dt-row-act"></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var xc in Model.Xercler)
                            {
                                <tr>
                                    <td class="ms-num"><b>@M(xc.Mebleg)</b></td>
                                    <td>@D(xc.Tarix)</td>
                                    <td>@V(xc.Mehkeme)</td>
                                    <td class="dt-row-act">
                                        <form asp-action="XercSil" method="post" onsubmit="return confirm('Bu xərc silinsin?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="xerciId" value="@xc.Id" />
                                            <input type="hidden" name="ishId" value="@Model.Id" />
                                            <button type="submit" class="mi-btn-icon mi-btn-icon--danger" title="Sil"><i class="bi bi-x"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dt-empty"><i class="bi bi-cash"></i> Hələ xərc əlavə edilməyib</div>
            }

            <details class="dt-add">
                <summary><i class="bi bi-plus-lg"></i> Xərc əlavə et</summary>
                <form asp-action="XercElave" method="post" style="margin-top:12px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="MehkemeIsiId" value="@Model.Id" />
                    <div class="mi-form-grid mi-form-grid--3">
                        <div class="mi-form-group">
                            <label class="mi-lbl">Məbləğ (₼)</label>
                            <input name="Mebleg" class="mi-input" type="number" step="0.01" min="0" required />
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Tarix</label>
                            <input name="Tarix" class="mi-input" type="date" />
                        </div>
                        <div class="mi-form-group">
                            <label class="mi-lbl">Məhkəmə / qeyd</label>
                            <input name="Mehkeme" class="mi-input" maxlength="200" placeholder="məs. Apellyasiya məhkəməsi…" />
                        </div>
                    </div>
                    <button type="submit" class="mi-btn mi-btn--primary mi-btn--sm"><i class="bi bi-plus-lg"></i> Əlavə et</button>
                </form>
            </details>
        </div>

        <!-- Sil -->
        <form asp-action="Sil" method="post" class="dt-danger-row"
              onsubmit="return confirm('Bu məhkəmə işini silmək istədiyinizə əminsiniz?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="mi-btn mi-btn--danger mi-btn--sm"><i class="bi bi-trash"></i> İşi sil</button>
        </form>
    </div>

</div>

@functions {
    string D(DateTime? d) => d.HasValue ? d.Value.ToString("dd.MM.yyyy") : "—";
    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") + " ₼" : "—";
    string V(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    // Brauzerdə baxıla bilən faylmı (PDF/şəkil) — yoxsa birbaşa yüklənsin (docx, xlsx…)
    bool FaylBaxilabilir(string? yol)
    {
        var ext = System.IO.Path.GetExtension(yol ?? "").ToLowerInvariant();
        return ext is ".pdf" or ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp";
    }
    string Dg(string? s) => string.IsNullOrWhiteSpace(s) ? "" : s.Split(' ')[0];

    string StatusOracleCls(string? s)
    {
        var u = (s ?? "").ToUpperInvariant();
        if (u.Contains("İCRA") || u.Contains("ICRA")) return "dt-st-icra";
        if (u.Contains("MƏHK") || u.Contains("MEHK")) return "dt-st-mehkeme";
        if (u.Contains("ÖDƏN") || u.Contains("ODEN") || u.Contains("BAĞL") || u.Contains("BAGL") || u.Contains("TAMAM")) return "dt-st-tamam";
        return "dt-st-hazir";
    }

    string MerheleBadgeClass(MerheleTipi t) => t switch
    {
        MerheleTipi.MehkemeIclasi          => "mi-badge--amber",
        MerheleTipi.QetnameGeldi           => "mi-badge--tamam",
        MerheleTipi.EkspertizayaGonderildi => "mi-badge--blue",
        MerheleTipi.GeriQaytarildi         => "mi-badge--bagli",
        MerheleTipi.IddiaVerildi           => "mi-badge--blue",
        MerheleTipi.QerarVerildi           => "mi-badge--tamam",
        MerheleTipi.IcraBaglandi           => "mi-badge--icra",
        MerheleTipi.Odendi                 => "mi-badge--mehkeme",
        _                                  => "mi-badge--diger"
    };

    string MerheleTipiAd(MerheleTipi t) => t switch
    {
        MerheleTipi.MehkemeIclasi          => "Məhkəmə iclası",
        MerheleTipi.QetnameGeldi           => "Qətnamə gəldi",
        MerheleTipi.EkspertizayaGonderildi => "Ekspertizaya göndərildi",
        MerheleTipi.GeriQaytarildi         => "Geri qaytarıldı",
        MerheleTipi.IddiaVerildi           => "İddia verildi",
        MerheleTipi.QerarVerildi           => "Qərar verildi",
        MerheleTipi.IcraBaglandi           => "İcra bağlandı",
        MerheleTipi.Odendi                 => "Ödənildi",
        _                                  => "Digər"
    };

    string SenedNovAd(MehkemeSenedNovu n) => n switch
    {
        MehkemeSenedNovu.IddiaErizesi => "İddia ərizəsi",
        MehkemeSenedNovu.Qetname      => "Qətnamə",
        MehkemeSenedNovu.IcraVereqesi => "İcra vərəqəsi",
        _                             => "Digər"
    };

    string SenedNovBadge(MehkemeSenedNovu n) => n switch
    {
        MehkemeSenedNovu.IddiaErizesi => "mi-badge--blue",
        MehkemeSenedNovu.Qetname      => "mi-badge--tamam",
        MehkemeSenedNovu.IcraVereqesi => "mi-badge--icra",
        _                             => "mi-badge--diger"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
}

@section Scripts {
<script>
    var ishId = @Model.Id;

    // Mərhələ formu — saat 24 saat formatı (SS:DD): yazarkən ":" avtomatik + yoxlanış
    (function () {
        var f = document.getElementById('merheleForm');
        var saat = document.getElementById('merheleSaat');
        var nov = document.getElementById('merheleNov');
        var saatGroup = document.getElementById('merheleSaatGroup');

        // Saat yalnız "Məhkəmə iclası" (görüş) üçün görünür; digər növlərdə gizlənir
        function toggleSaat() {
            var iclasdir = nov && nov.value === '2';
            if (saatGroup) saatGroup.style.display = iclasdir ? '' : 'none';
            if (!iclasdir && saat) saat.value = '';
        }
        if (nov) { nov.addEventListener('change', toggleSaat); toggleSaat(); }

        if (saat) {
            // "1400" yazanda avtomatik "14:00" (2 rəqəmdən sonra ":" salır)
            saat.addEventListener('input', function () {
                var d = this.value.replace(/\D/g, '').slice(0, 4);
                this.value = d.length > 2 ? d.slice(0, 2) + ':' + d.slice(2) : d;
            });
        }
        if (f) {
            f.addEventListener('submit', function (e) {
                var v = (saat ? saat.value : '').trim();
                if (v && !/^([01]?\d|2[0-3]):[0-5]\d$/.test(v)) {
                    e.preventDefault();
                    alert('Saat düzgün deyil — 24 saat formatı (SS:DD), məs: 14:40.');
                    if (saat) saat.focus();
                }
            });
        }
    })();

    // Subyekt cədvəli — sətri aç/bağla (detal + inline redaktə)
    function dtToggle(e, row) {
        if (e.target.closest('a, button, form, input, textarea, select, label')) return;
        row.closest('tbody').classList.toggle('open');
    }
    // Detallı sütunları aç/bağla
    var dtTc = document.getElementById('dtToggleCols');
    if (dtTc) dtTc.addEventListener('click', function () {
        document.getElementById('dtSubjTable').classList.toggle('dt-show-ex');
        this.classList.toggle('mi-btn--primary');
    });

    // Məhkəmə fazası — faktlar ↔ redaktə forması (yerində)
    (function () {
        var btn = document.getElementById('btnMehEdit');
        var cancel = document.getElementById('btnMehCancel');
        var facts = document.getElementById('mehFacts');
        var form = document.getElementById('mehEdit');
        function show(edit) {
            if (facts) facts.style.display = edit ? 'none' : '';
            if (form) form.style.display = edit ? '' : 'none';
        }
        if (btn) btn.addEventListener('click', function () { show(true); });
        if (cancel) cancel.addEventListener('click', function () { show(false); });
    })();
</script>
}
