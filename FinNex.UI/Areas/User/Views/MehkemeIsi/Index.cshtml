@using FinNex.Application.DTOs.Pid
@model MehkemeSiyahiResultDto
@{
    ViewData["Title"] = "Aktiv Müştərilər";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") + " ₼" : "—";
    string Txt(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    string StatusClass(string? s)
    {
        var u = (s ?? "").ToUpperInvariant();
        if (u.Contains("İCRA") || u.Contains("ICRA")) return "ms-st-icra";
        if (u.Contains("MƏHK") || u.Contains("MEHK")) return "ms-st-mehkeme";
        if (u.Contains("NOTAR")) return "ms-st-notarius";
        if (u.Contains("ÖDƏN") || u.Contains("ODEN") || u.Contains("BAĞL") || u.Contains("BAGL")) return "ms-st-odendi";
        return "ms-st-diger";
    }

    var statuslar = Model.Satirlar
        .Select(x => x.Status)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">Aktiv Müştərilər</h2>
            <p class="ms-sub">PİD — problemli kreditlərin canlı siyahısı (Oracle)</p>
        </div>
        <div style="display:flex;gap:8px">
            <button type="button" class="ms-btn ms-btn--ghost" id="msToggleCols">
                <i class="bi bi-layout-three-columns"></i> Detallı sütunlar
            </button>
            <a asp-action="IndexExcel" class="ms-btn ms-btn--ghost"><i class="bi bi-file-earmark-excel"></i> Excelə yüklə</a>
            <a asp-action="Index" class="ms-btn ms-btn--primary"><i class="bi bi-arrow-clockwise"></i> Yenilə</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ms-alert ms-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="ms-alert ms-alert--error">@TempData["Error"]</div>
    }

    @if (!Model.Konfiqurasiyali)
    {
        <div class="ms-alert ms-alert--warn">
            <i class="bi bi-exclamation-triangle"></i>
            Məhkəmə siyahı Oracle sorğusu seçilməyib.
            <a asp-area="Admin" asp-controller="SistemAyar" asp-action="Index">Sistem Ayarları → PİD Məhkəmə İşləri</a>
            bölməsindən "Tam siyahı" sorğusunu seçin.
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Xeta))
    {
        <div class="ms-alert ms-alert--error"><i class="bi bi-x-octagon"></i> @Model.Xeta</div>
    }

    <div class="ms-filter">
        <input type="text" id="msSearch" class="ms-input ms-grow" placeholder="🔍 Borclu adı, hesab № və ya FİN axtar…" />
        <select id="msStatus" class="ms-input">
            <option value="">Bütün statuslar</option>
            @foreach (var s in statuslar)
            {
                <option value="@s">@s</option>
            }
        </select>
        <select id="msIsh" class="ms-input">
            <option value="">İş: hamısı</option>
            <option value="1">İzlənənlər</option>
            <option value="0">İş açılmayanlar</option>
        </select>
    </div>

    @Html.AntiForgeryToken()

    <div class="ms-card">
        <div class="ms-twrap">
            <table class="ms-table" id="msTable">
                <thead>
                    <tr>
                        <th class="ms-col-ish">İş</th>
                        <th class="ms-primary">Region</th>
                        <th class="ms-primary ms-col-ad">Borclu</th>
                        <th>Növ / Zamin</th>
                        <th>Qətnamə</th>
                        <th class="ms-primary">Hesab № / K.S.</th>
                        <th class="ms-primary ms-num">Tam Qalıq</th>
                        <th class="ms-extra ms-num">Qalıq</th>
                        <th class="ms-extra ms-num">V.K. Qalıq</th>
                        <th class="ms-extra ms-num">% məbləği</th>
                        <th class="ms-extra ms-num">V.K. % məbləği</th>
                        <th class="ms-extra ms-num">Faiz</th>
                        <th class="ms-extra ms-num">Ehtiyat</th>
                        <th class="ms-extra ms-num">Kreditin məbləği</th>
                        <th class="ms-extra">Verilmə</th>
                        <th class="ms-extra ms-num">Overdue gün</th>
                        <th class="ms-extra">Telefon</th>
                        <th class="ms-extra">Mobil</th>
                        <th class="ms-extra">Doğum tarixi</th>
                        <th class="ms-extra">Girovun növü</th>
                        <th class="ms-extra">Sektor</th>
                        <th class="ms-extra">Item 02</th>
                        <th class="ms-primary">Son əməliyyat</th>
                        <th class="ms-primary">Status</th>
                        <th class="ms-primary">Son fəaliyyət</th>
                    </tr>
                </thead>

                @if (Model.Satirlar.Any())
                {
                    @foreach (var x in Model.Satirlar)
                    {
                        var hasZamin = x.Zaminler.Any();
                        <tbody class="ms-grp"
                               data-hesab="@x.KreditHesabi"
                               data-ks="@x.Ks"
                               data-search="@($"{x.BorcluAd} {x.KreditHesabi} {string.Join(" ", x.Zaminler.Select(z => z.Ad + " " + z.Fin))}")"
                               data-status="@x.Status"
                               data-ish="@(x.IsAcilib ? "1" : "0")">
                            <tr class="ms-borclu">
                                <td class="ms-col-ish">
                                    @{ var zJson = System.Text.Json.JsonSerializer.Serialize(x.Zaminler); }
                                    @if (x.IsAcilib && x.MehkemeIsiId.HasValue)
                                    {
                                        <form asp-action="AcVeBax" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@x.MehkemeIsiId" />
                                            <input type="hidden" name="zaminler" value="@zJson" />
                                            <button type="submit" class="ms-btn-xs ms-btn-xs--open"><i class="bi bi-eye"></i> Aç</button>
                                        </form>
                                    }
                                    else
                                    {
                                        var rowJson = System.Text.Json.JsonSerializer.Serialize(new
                                        {
                                            BorcluAd = Txt(x.BorcluAd), Region = Txt(x.Region), Status = x.Status,
                                            Hesab = x.KreditHesabi, Ks = x.Ks,
                                            TamQaliq = M(x.TamQaliq), Qaliq = M(x.Qaliq), VkQaliq = M(x.VkQaliq),
                                            FaizMeblegi = M(x.FaizMeblegi), VkFaizMeblegi = M(x.VkFaizMeblegi),
                                            Faiz = Txt(x.Faiz), KreditinMeblegi = M(x.KreditinMeblegi),
                                            VerilmeTarixi = Txt(x.VerilmeTarixi), OverdueGun = Txt(x.OverdueGun),
                                            SonEmeliyyat = Txt(x.SonEmeliyyatTarixi), SonFealiyyet = Txt(x.SonFealiyyet),
                                            Telefon = Txt(x.Telefon), Mobil = Txt(x.Mobil), DogumTarixi = Txt(x.DogumTarixi),
                                            KreditinNovu = Txt(x.KreditinNovu), GirovunNovu = Txt(x.GirovunNovu),
                                            Sektor = Txt(x.Sektor), Qerardad = x.Qerardad,
                                            AcarHesab = x.KreditHesabi, AcarKs = x.Ks, AcarAd = x.BorcluAd,
                                            Zaminler = x.Zaminler
                                        });
                                        <button type="button" class="ms-btn-xs ms-btn-bax" data-row="@rowJson"
                                                title="Yalnız bax (iş açılmır)">
                                            <i class="bi bi-eye"></i> Bax
                                        </button>
                                    }
                                </td>
                                <td class="ms-accent">@Txt(x.Region)</td>
                                <td class="ms-col-ad">
                                    <div class="ms-bname">@Txt(x.BorcluAd)</div>
                                </td>
                                <td class="ms-tipzamin">
                                    @if (!string.IsNullOrWhiteSpace(x.KreditinNovu))
                                    {
                                        <span class="ms-nov">@x.KreditinNovu</span>
                                    }
                                    @if (hasZamin)
                                    {
                                        <span class="ms-zcount">@x.Zaminler.Count zamin</span>
                                    }
                                    else
                                    {
                                        <span class="ms-znil">zaminsiz</span>
                                    }
                                </td>
                                <td class="ms-qd">
                                    @if (!string.IsNullOrWhiteSpace(x.Qerardad))
                                    {
                                        <div class="ms-qd-text">@x.Qerardad</div>
                                    }
                                    else
                                    {
                                        <span class="ms-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="ms-hesab">@x.KreditHesabi</span>
                                    @if (!string.IsNullOrWhiteSpace(x.Ks))
                                    {
                                        <span class="ms-ks">K.S. @x.Ks</span>
                                    }
                                </td>
                                <td class="ms-num ms-tamqaliq">@M(x.TamQaliq)</td>
                                <td class="ms-extra ms-num">@M(x.Qaliq)</td>
                                <td class="ms-extra ms-num @(x.VkQaliq > 0 ? "ms-vk" : "")">@M(x.VkQaliq)</td>
                                <td class="ms-extra ms-num">@M(x.FaizMeblegi)</td>
                                <td class="ms-extra ms-num @(x.VkFaizMeblegi > 0 ? "ms-vk" : "")">@M(x.VkFaizMeblegi)</td>
                                <td class="ms-extra ms-num">@Txt(x.Faiz)</td>
                                <td class="ms-extra ms-num">@Txt(x.Ehtiyat)</td>
                                <td class="ms-extra ms-num">@M(x.KreditinMeblegi)</td>
                                <td class="ms-extra">@Txt(x.VerilmeTarixi)</td>
                                <td class="ms-extra ms-num">@Txt(x.OverdueGun)</td>
                                <td class="ms-extra">@Txt(x.Telefon)</td>
                                <td class="ms-extra">@Txt(x.Mobil)</td>
                                <td class="ms-extra">@Txt(x.DogumTarixi)</td>
                                <td class="ms-extra ms-clip" title="@Txt(x.GirovunNovu)">@Txt(x.GirovunNovu)</td>
                                <td class="ms-extra">@Txt(x.Sektor)</td>
                                <td class="ms-extra ms-clip" title="@Txt(x.Item02)">@Txt(x.Item02)</td>
                                <td>@Txt(x.SonEmeliyyatTarixi)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(x.Status))
                                    {
                                        <span class="ms-badge @StatusClass(x.Status)">@x.Status</span>
                                    }
                                    else
                                    {
                                        <span class="ms-muted">—</span>
                                    }
                                </td>
                                <td class="ms-item10" title="@x.SonFealiyyet">
                                    @if (!string.IsNullOrWhiteSpace(x.SonFealiyyet))
                                    {
                                        <div class="ms-clip">@x.SonFealiyyet</div>
                                    }
                                    else
                                    {
                                        <span class="ms-muted">—</span>
                                    }
                                </td>
                            </tr>

                        </tbody>
                    }
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="25">
                                <div class="ms-empty">
                                    <i class="bi bi-inbox"></i>
                                    <div>@(Model.Konfiqurasiyali ? "Siyahı boşdur" : "Sorğu seçildikdən sonra siyahı buraya gələcək")</div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <div class="ms-foot" id="msCount">@Model.Satirlar.Count kredit</div>
    </div>
</div>

@* ── Yalnız baxış modalı (iş açılmamış kreditlər üçün — DB-yə yazmır) ── *@
<div id="msBaxModal" class="ms-modal" aria-hidden="true">
    <div class="ms-modal-card">
        <div class="ms-modal-head">
            <h3 id="bxTitle">—</h3>
            <button type="button" class="ms-modal-x" data-close aria-label="Bağla">&times;</button>
        </div>
        <div class="ms-modal-body" id="bxBody"></div>
        <div class="ms-modal-foot">
            <span class="ms-muted" style="margin-right:auto;font-size:12px">
                <i class="bi bi-eye"></i> Bu yalnız baxışdır — iş açılmayıb.
            </span>
            <form asp-action="IsAch" method="post" style="margin:0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="acar.KreditHesabi" id="bxHesab" />
                <input type="hidden" name="acar.Ks" id="bxKs" />
                <input type="hidden" name="acar.BorcluAd" id="bxBorclu" />
                <input type="hidden" name="zaminler" id="bxZaminler" />
                <button type="submit" class="ms-btn-xs ms-btn-isac"><i class="bi bi-plus-lg"></i> İş aç</button>
            </form>
            <button type="button" class="ms-btn ms-btn--ghost" data-close>Bağla</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        .ms-btn-bax { background:#eef2ff; border:1px solid #c7d2fe; color:#3730a3; }
        .ms-btn-bax:hover { background:#e0e7ff; }

        .ms-modal { position:fixed; inset:0; background:rgba(15,23,42,.55); display:none;
                    align-items:flex-start; justify-content:center; z-index:1050; padding:40px 16px; overflow:auto; }
        .ms-modal.open { display:flex; }
        .ms-modal-card { background:#fff; border-radius:14px; width:min(780px,100%);
                         box-shadow:0 24px 64px rgba(0,0,0,.32); }
        .ms-modal-head { display:flex; align-items:center; justify-content:space-between;
                         padding:15px 20px; border-bottom:1px solid #e5e7eb; }
        .ms-modal-head h3 { margin:0; font-size:17px; color:#0f172a; }
        .ms-modal-x { border:none; background:none; font-size:26px; line-height:1; cursor:pointer; color:#64748b; }
        .ms-modal-x:hover { color:#0f172a; }
        .ms-modal-body { padding:16px 20px; max-height:62vh; overflow:auto; }
        .ms-modal-foot { display:flex; gap:10px; justify-content:flex-end; align-items:center;
                         padding:13px 20px; border-top:1px solid #e5e7eb; }

        .bx-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:2px 22px; }
        .bx-cell { display:flex; justify-content:space-between; gap:10px; padding:7px 0; border-bottom:1px dashed #eef2f7; }
        .bx-lbl { color:#64748b; font-size:12px; font-weight:600; }
        .bx-val { color:#0f172a; font-weight:600; font-size:13px; text-align:right; }
        .bx-note { margin-top:12px; background:#f8fafc; border:1px solid #eef2f7; border-radius:8px; padding:8px 12px; }
        .bx-note div { color:#0f172a; font-size:13px; margin-top:3px; white-space:pre-wrap; }
        .bx-zwrap { margin-top:14px; }
        .bx-zhead { font-weight:700; color:#3730a3; margin-bottom:8px; }
        .bx-zcard { background:#f8fafc; border:1px solid #e5e7eb; border-radius:10px; padding:10px 12px; margin-bottom:8px; }
        .bx-zname { font-weight:700; color:#0f172a; margin-bottom:5px; }
        .bx-zrow { display:flex; flex-wrap:wrap; gap:6px 16px; font-size:12px; color:#475569; }
        .bx-znil { color:#94a3b8; font-style:italic; }
        @@media (max-width:640px){ .bx-grid { grid-template-columns:1fr; } }

        /* "Detallı sütunlar" açıq olanda uzun mətnlər tam görünsün (kəsilməsin) */
        #msTable.ms-show-extra .ms-clip,
        #msTable.ms-show-extra .ms-item10 .ms-clip,
        #msTable.ms-show-extra .ms-item10 { max-width:340px; white-space:normal; overflow:visible; text-overflow:clip; word-break:break-word; }
    </style>
}

@section Scripts {
<script>
    // Detallı (boz) sütunları aç/bağla
    document.getElementById('msToggleCols').addEventListener('click', function () {
        document.getElementById('msTable').classList.toggle('ms-show-extra');
        this.classList.toggle('ms-btn--primary');
    });

    // Borclu sətrinə klik → zaminlər açılır/bağlanır
    function msRowClick(e, tb) {
        if (e.target.closest('.ms-qd, a, button, form, [contenteditable]')) return;
        if (!tb.querySelector('.ms-zamin')) return;   // zamin yoxdursa heç nə etmə
        tb.classList.toggle('open');
    }

    // Qətnamə yalnız Detal səhifəsində redaktə olunur (inline save silindi).

    // Filtr
    (function () {
        var s = document.getElementById('msSearch');
        var st = document.getElementById('msStatus');
        var ish = document.getElementById('msIsh');
        var cnt = document.getElementById('msCount');
        function f() {
            var q = s.value.toLowerCase();
            var sv = st.value;
            var iv = ish.value;
            var groups = document.querySelectorAll('#msTable tbody.ms-grp');
            var vis = 0;
            groups.forEach(function (g) {
                var ok = (!q || (g.dataset.search || '').toLowerCase().includes(q))
                      && (!sv || g.dataset.status === sv)
                      && (!iv || g.dataset.ish === iv);
                g.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });
            cnt.textContent = vis + ' kredit';
        }
        s.addEventListener('input', f);
        st.addEventListener('change', f);
        ish.addEventListener('change', f);
    })();

    // Cədvəlin hündürlüyünü ekrana dəqiq uyğunlaşdır — üfüqi scroll həmişə
    // cədvəlin altında görünsün (səhifəni tam aşağı sürükləmək lazım olmasın)
    function msFitHeight() {
        var tw = document.querySelector('.ms-twrap');
        if (!tw) return;
        var top = tw.getBoundingClientRect().top;
        var foot = document.querySelector('.ms-foot');
        var footH = foot ? foot.offsetHeight : 0;
        tw.style.maxHeight = Math.max(240, window.innerHeight - top - footH - 14) + 'px';
    }
    msFitHeight();
    window.addEventListener('resize', msFitHeight);

    // ── Yalnız baxış modalı (iş açılmamış kreditlər) ──────────
    (function () {
        var m = document.getElementById('msBaxModal');
        if (!m) return;

        function esc(s) {
            if (s === null || s === undefined || s === '') return '—';
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }
        function close() { m.classList.remove('open'); m.setAttribute('aria-hidden', 'true'); }

        function open(row) {
            document.getElementById('bxTitle').textContent = (row.BorcluAd && row.BorcluAd !== '—') ? row.BorcluAd : 'Kredit';
            document.getElementById('bxHesab').value   = row.AcarHesab || '';
            document.getElementById('bxKs').value      = row.AcarKs || '';
            document.getElementById('bxBorclu').value  = row.AcarAd || '';
            document.getElementById('bxZaminler').value = JSON.stringify(row.Zaminler || []);

            var pairs = [
                ['Region', row.Region], ['Status', row.Status],
                ['Hesab №', row.Hesab], ['K.S.', row.Ks],
                ['Tam Qalıq', row.TamQaliq], ['Qalıq', row.Qaliq], ['V.K. Qalıq', row.VkQaliq],
                ['Faiz məbləği', row.FaizMeblegi], ['V.K. faiz', row.VkFaizMeblegi], ['Faiz', row.Faiz],
                ['Kreditin məbləği', row.KreditinMeblegi], ['Verilmə', row.VerilmeTarixi],
                ['Overdue gün', row.OverdueGun], ['Son əməliyyat', row.SonEmeliyyat],
                ['Doğum tarixi', row.DogumTarixi], ['Telefon', row.Telefon], ['Mobil', row.Mobil],
                ['Kreditin növü', row.KreditinNovu], ['Girovun növü', row.GirovunNovu], ['Sektor', row.Sektor]
            ];
            var html = '<div class="bx-grid">' + pairs.map(function (p) {
                return '<div class="bx-cell"><span class="bx-lbl">' + p[0] + '</span><span class="bx-val">' + esc(p[1]) + '</span></div>';
            }).join('') + '</div>';

            if (row.SonFealiyyet && row.SonFealiyyet !== '—')
                html += '<div class="bx-note"><span class="bx-lbl">Son fəaliyyət</span><div>' + esc(row.SonFealiyyet) + '</div></div>';
            if (row.Qerardad)
                html += '<div class="bx-note"><span class="bx-lbl">Qətnamə</span><div>' + esc(row.Qerardad) + '</div></div>';

            var z = row.Zaminler || [];
            var zhtml;
            if (z.length) {
                zhtml = '<div class="bx-zhead">Zaminlər (' + z.length + ')</div>';
                z.forEach(function (zm) {
                    zhtml += '<div class="bx-zcard">'
                        + '<div class="bx-zname">' + esc(zm.Ad) + '</div>'
                        + '<div class="bx-zrow"><span>FİN: ' + esc(zm.Fin) + '</span><span>Doğum: ' + esc(zm.DogumTarixi) + '</span><span>Tel: ' + esc(zm.Telefon) + '</span></div>'
                        + '<div class="bx-zrow"><span>Ünvan: ' + esc(zm.Unvan) + '</span></div>'
                        + '<div class="bx-zrow"><span>Gəlir: ' + esc(zm.Gelir) + '</span><span>Borc yükü: ' + esc(zm.BorcYuku) + '</span></div>'
                        + '</div>';
                });
            } else {
                zhtml = '<div class="bx-znil">Zamin yoxdur</div>';
            }
            html += '<div class="bx-zwrap">' + zhtml + '</div>';

            document.getElementById('bxBody').innerHTML = html;
            m.classList.add('open');
            m.setAttribute('aria-hidden', 'false');
        }

        document.querySelectorAll('.ms-btn-bax').forEach(function (b) {
            b.addEventListener('click', function () {
                try { open(JSON.parse(b.dataset.row)); }
                catch (e) { console.error('Bax modal parse error', e); }
            });
        });
        m.querySelectorAll('[data-close]').forEach(function (c) { c.addEventListener('click', close); });
        m.addEventListener('click', function (e) { if (e.target === m) close(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
</script>
}
