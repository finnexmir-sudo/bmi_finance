@using FinNex.Application.DTOs.Pid
@model MehkemeSiyahiResultDto
@{
    ViewData["Title"] = "Məhkəmə İşləri";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") + " ₼" : "—";
    string Txt(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;

    string StatusClass(string? s)
    {
        var u = (s ?? "").ToUpperInvariant();
        if (u.Contains("İCRA") || u.Contains("ICRA")) return "ms-st-icra";
        if (u.Contains("MƏHK") || u.Contains("MEHK")) return "ms-st-mehkeme";
        if (u.Contains("NOTAR")) return "ms-st-notarius";
        if (u.Contains("ÖDƏN") || u.Contains("ODEN") || u.Contains("BAĞL") || u.Contains("BAGL")) return "ms-st-odendi";
        return "ms-st-diger";
    }

    var statuslar = Model.Satirlar
        .Select(x => x.Status)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">Məhkəmə İşləri</h2>
            <p class="ms-sub">PİD — problemli kreditlərin canlı siyahısı (Oracle) + proqram izləməsi</p>
        </div>
        <div style="display:flex;gap:8px">
            <button type="button" class="ms-btn ms-btn--ghost" id="msToggleCols">
                <i class="bi bi-layout-three-columns"></i> Detallı sütunlar
            </button>
            <a asp-action="Index" class="ms-btn ms-btn--primary"><i class="bi bi-arrow-clockwise"></i> Yenilə</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ms-alert ms-alert--success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="ms-alert ms-alert--error">@TempData["Error"]</div>
    }

    @if (!Model.Konfiqurasiyali)
    {
        <div class="ms-alert ms-alert--warn">
            <i class="bi bi-exclamation-triangle"></i>
            Məhkəmə siyahı Oracle sorğusu seçilməyib.
            <a asp-area="Admin" asp-controller="SistemAyar" asp-action="Index">Sistem Ayarları → PİD Məhkəmə İşləri</a>
            bölməsindən "Tam siyahı" sorğusunu seçin.
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.Xeta))
    {
        <div class="ms-alert ms-alert--error"><i class="bi bi-x-octagon"></i> @Model.Xeta</div>
    }

    <div class="ms-filter">
        <input type="text" id="msSearch" class="ms-input ms-grow" placeholder="🔍 Borclu adı, hesab № və ya FİN axtar…" />
        <select id="msStatus" class="ms-input">
            <option value="">Bütün statuslar</option>
            @foreach (var s in statuslar)
            {
                <option value="@s">@s</option>
            }
        </select>
        <select id="msIsh" class="ms-input">
            <option value="">İş: hamısı</option>
            <option value="1">İzlənənlər</option>
            <option value="0">İş açılmayanlar</option>
        </select>
    </div>

    @Html.AntiForgeryToken()

    <div class="ms-card">
        <div class="ms-twrap">
            <table class="ms-table" id="msTable">
                <thead>
                    <tr>
                        <th class="ms-ctoggle"></th>
                        <th class="ms-primary">Region</th>
                        <th class="ms-primary ms-col-ad">Borclu</th>
                        <th>Qərardad</th>
                        <th class="ms-primary">Hesab № / K.S.</th>
                        <th class="ms-primary ms-num">Qalıq</th>
                        <th class="ms-primary ms-num">V.K. Qalıq</th>
                        <th class="ms-primary ms-num">% məbləği</th>
                        <th class="ms-primary ms-num">V.K. % məbləği</th>
                        <th class="ms-extra ms-num">Faiz</th>
                        <th class="ms-extra ms-num">Kreditin məbləği</th>
                        <th class="ms-extra">Verilmə</th>
                        <th class="ms-extra ms-num">Overdue gün</th>
                        <th class="ms-extra">Telefon</th>
                        <th class="ms-primary">Son əməliyyat</th>
                        <th class="ms-primary">Status</th>
                        <th class="ms-primary">Son fəaliyyət</th>
                        <th class="ms-col-ish">İş</th>
                    </tr>
                </thead>

                @if (Model.Satirlar.Any())
                {
                    @foreach (var x in Model.Satirlar)
                    {
                        var hasZamin = x.Zaminler.Any();
                        <tbody class="ms-grp"
                               data-hesab="@x.KreditHesabi"
                               data-ks="@x.Ks"
                               data-search="@($"{x.BorcluAd} {x.KreditHesabi} {string.Join(" ", x.Zaminler.Select(z => z.Ad + " " + z.Fin))}")"
                               data-status="@x.Status"
                               data-ish="@(x.IsAcilib ? "1" : "0")">
                            <tr class="ms-borclu" onclick="msRowClick(event,this.parentElement)" style="@(hasZamin ? "cursor:pointer" : "cursor:default")">
                                <td class="ms-ctoggle">
                                    @if (hasZamin)
                                    {
                                        <span class="ms-caret"><i class="bi bi-chevron-right"></i></span>
                                    }
                                </td>
                                <td class="ms-accent">@Txt(x.Region)</td>
                                <td class="ms-col-ad">
                                    <div class="ms-bname">@Txt(x.BorcluAd)</div>
                                    <div class="ms-btip">
                                        @if (!string.IsNullOrWhiteSpace(x.KreditinNovu))
                                        {
                                            <span class="ms-nov">@x.KreditinNovu</span>
                                        }
                                        @if (hasZamin)
                                        {
                                            <span class="ms-zcount"><i class="bi bi-people-fill"></i> @x.Zaminler.Count zamin</span>
                                        }
                                        else
                                        {
                                            <span class="ms-znil">zaminsiz</span>
                                        }
                                    </div>
                                </td>
                                <td class="ms-qd" onclick="event.stopPropagation()">
                                    <span class="ms-apptag">PROQRAM</span>
                                    <div class="ms-qd-box" contenteditable="true"
                                         data-orig="@x.Qerardad"
                                         data-placeholder="Qərardad yaz…"
                                         onblur="msSaveQerardad(this)">@x.Qerardad</div>
                                </td>
                                <td>
                                    <span class="ms-hesab">@x.KreditHesabi</span>
                                    @if (!string.IsNullOrWhiteSpace(x.Ks))
                                    {
                                        <span class="ms-ks">K.S. @x.Ks</span>
                                    }
                                </td>
                                <td class="ms-num">@M(x.Qaliq)</td>
                                <td class="ms-num @(x.VkQaliq > 0 ? "ms-vk" : "")">@M(x.VkQaliq)</td>
                                <td class="ms-num">@M(x.FaizMeblegi)</td>
                                <td class="ms-num @(x.VkFaizMeblegi > 0 ? "ms-vk" : "")">@M(x.VkFaizMeblegi)</td>
                                <td class="ms-extra ms-num">@Txt(x.Faiz)</td>
                                <td class="ms-extra ms-num">@M(x.KreditinMeblegi)</td>
                                <td class="ms-extra">@Txt(x.VerilmeTarixi)</td>
                                <td class="ms-extra ms-num">@Txt(x.OverdueGun)</td>
                                <td class="ms-extra">@Txt(x.Telefon)</td>
                                <td>@Txt(x.SonEmeliyyatTarixi)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(x.Status))
                                    {
                                        <span class="ms-badge @StatusClass(x.Status)">@x.Status</span>
                                    }
                                    else
                                    {
                                        <span class="ms-muted">—</span>
                                    }
                                </td>
                                <td class="ms-item10" title="@x.SonFealiyyet">
                                    @if (!string.IsNullOrWhiteSpace(x.SonFealiyyet))
                                    {
                                        <div class="ms-clip">@x.SonFealiyyet</div>
                                    }
                                    else
                                    {
                                        <span class="ms-muted">—</span>
                                    }
                                </td>
                                <td class="ms-col-ish" onclick="event.stopPropagation()">
                                    @if (x.IsAcilib && x.MehkemeIsiId.HasValue)
                                    {
                                        <div class="ms-ish-on"><span class="ms-dot"></span>İzlənir <span class="ms-mrh">@x.MerheleSayi mərhələ</span></div>
                                        <a asp-action="Detal" asp-route-id="@x.MehkemeIsiId" class="ms-btn-xs ms-btn-xs--open">
                                            <i class="bi bi-eye"></i> Aç
                                        </a>
                                    }
                                    else
                                    {
                                        <form asp-action="IsAch" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="acar.KreditHesabi" value="@x.KreditHesabi" />
                                            <input type="hidden" name="acar.Ks" value="@x.Ks" />
                                            <input type="hidden" name="acar.BorcluAd" value="@x.BorcluAd" />
                                            <button type="submit" class="ms-btn-xs ms-btn-isac"><i class="bi bi-plus-lg"></i> İş aç</button>
                                        </form>
                                    }
                                </td>
                            </tr>

                            @if (hasZamin)
                            {
                                <tr class="ms-zamin"><td colspan="20" class="ms-zhead">ZAMİNLƏR (@x.Zaminler.Count)</td></tr>
                                @for (int zi = 0; zi < x.Zaminler.Count; zi++)
                                {
                                    var z = x.Zaminler[zi];
                                    <tr class="ms-zamin">
                                        <td class="ms-zindent"><span class="ms-ztree">└</span></td>
                                        <td colspan="20">
                                            <div class="ms-zline">
                                                <span class="ms-ztag">Zamin @(zi + 1)</span>
                                                <span class="ms-zname">@Txt(z.Ad)</span>
                                                @if (!string.IsNullOrWhiteSpace(z.Fin))      { <span class="ms-zchip"><b>FİN:</b> @z.Fin</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.DogumTarixi)) { <span class="ms-zchip"><b>Doğum:</b> @z.DogumTarixi</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.Telefon))  { <span class="ms-zchip"><b>Tel:</b> @z.Telefon</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.Unvan))    { <span class="ms-zchip"><b>Ünvan:</b> @z.Unvan</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.Gelir))    { <span class="ms-zchip"><b>Aylıq gəlir:</b> @z.Gelir</span> }
                                                @if (!string.IsNullOrWhiteSpace(z.BorcYuku)) { <span class="ms-zchip"><b>Borc yükü:</b> @z.BorcYuku</span> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    }
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="18">
                                <div class="ms-empty">
                                    <i class="bi bi-inbox"></i>
                                    <div>@(Model.Konfiqurasiyali ? "Siyahı boşdur" : "Sorğu seçildikdən sonra siyahı buraya gələcək")</div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
        <div class="ms-foot" id="msCount">@Model.Satirlar.Count kredit</div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
}

@section Scripts {
<script>
    // Detallı (boz) sütunları aç/bağla
    document.getElementById('msToggleCols').addEventListener('click', function () {
        document.getElementById('msTable').classList.toggle('ms-show-extra');
        this.classList.toggle('ms-btn--primary');
    });

    // Borclu sətrinə klik → zaminlər açılır/bağlanır
    function msRowClick(e, tb) {
        if (e.target.closest('.ms-qd, a, button, form, [contenteditable]')) return;
        if (!tb.querySelector('.ms-zamin')) return;   // zamin yoxdursa heç nə etmə
        tb.classList.toggle('open');
    }

    // Qərardad inline yadda saxla (dəyişibsə)
    var msToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
    async function msSaveQerardad(box) {
        var text = box.innerText.trim();
        if (text === (box.dataset.orig || '').trim()) return;
        var tb = box.closest('tbody');
        var fd = new FormData();
        fd.append('acar.KreditHesabi', tb.dataset.hesab || '');
        fd.append('acar.Ks', tb.dataset.ks || '');
        fd.append('qerardad', text);
        fd.append('__RequestVerificationToken', msToken);
        box.classList.add('ms-qd-saving');
        try {
            var r = await fetch('/User/MehkemeIsi/QerardadYaz', { method: 'POST', body: fd });
            var j = await r.json();
            box.classList.remove('ms-qd-saving');
            if (j.success) {
                box.dataset.orig = text;
                box.classList.add('ms-qd-saved');
                setTimeout(function () { box.classList.remove('ms-qd-saved'); }, 1200);
            } else {
                box.classList.add('ms-qd-err');
            }
        } catch {
            box.classList.remove('ms-qd-saving');
            box.classList.add('ms-qd-err');
        }
    }

    // Filtr
    (function () {
        var s = document.getElementById('msSearch');
        var st = document.getElementById('msStatus');
        var ish = document.getElementById('msIsh');
        var cnt = document.getElementById('msCount');
        function f() {
            var q = s.value.toLowerCase();
            var sv = st.value;
            var iv = ish.value;
            var groups = document.querySelectorAll('#msTable tbody.ms-grp');
            var vis = 0;
            groups.forEach(function (g) {
                var ok = (!q || (g.dataset.search || '').toLowerCase().includes(q))
                      && (!sv || g.dataset.status === sv)
                      && (!iv || g.dataset.ish === iv);
                g.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });
            cnt.textContent = vis + ' kredit';
        }
        s.addEventListener('input', f);
        st.addEventListener('change', f);
        ish.addEventListener('change', f);
    })();

    // Cədvəlin hündürlüyünü ekrana dəqiq uyğunlaşdır — üfüqi scroll həmişə
    // cədvəlin altında görünsün (səhifəni tam aşağı sürükləmək lazım olmasın)
    function msFitHeight() {
        var tw = document.querySelector('.ms-twrap');
        if (!tw) return;
        var top = tw.getBoundingClientRect().top;
        var foot = document.querySelector('.ms-foot');
        var footH = foot ? foot.offsetHeight : 0;
        tw.style.maxHeight = Math.max(240, window.innerHeight - top - footH - 14) + 'px';
    }
    msFitHeight();
    window.addEventListener('resize', msFitHeight);
</script>
}
