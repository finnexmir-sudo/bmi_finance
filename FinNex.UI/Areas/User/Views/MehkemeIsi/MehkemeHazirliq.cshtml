@using FinNex.Application.DTOs.Pid
@model MehkemeHazirliqViewDto
@{
    ViewData["Title"] = "Məhkəməyə hazırlıq";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";

    string M(decimal? v) => v.HasValue ? v.Value.ToString("N2") : "—";
    string D(DateTime? v) => v?.ToString("dd.MM.yyyy") ?? "—";
    string T(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;

    // Pul sütunları üzrə cəmlər (ümumi borc = Toplam VK cəmi)
    var cemVerKr    = Model.Setirler.Sum(s => s.VerKr        ?? 0m);
    var cemEsas     = Model.Setirler.Sum(s => s.Esas         ?? 0m);
    var cemVk       = Model.Setirler.Sum(s => s.Vk           ?? 0m);
    var cemFaiz     = Model.Setirler.Sum(s => s.Faiz         ?? 0m);
    var cemVkFaiz   = Model.Setirler.Sum(s => s.VkFaiz       ?? 0m);
    var cemToplamVk = Model.Setirler.Sum(s => s.ToplamVkBorc ?? 0m);
    var cemAyliq    = Model.Setirler.Sum(s => s.Ayliq        ?? 0m);
    var cemUcAyliq  = Model.Setirler.Sum(s => s.UcAyliqCemi  ?? 0m);
}

<div class="ms-page">
    <div class="ms-head">
        <div>
            <h2 class="ms-title">Məhkəməyə hazırlıq</h2>
            <p class="ms-sub">
                Məhkəmə/iddia üçün — borcalan + zaminlərin ətraflı məlumatı — <b>@Model.Setirler.Count</b> kredit
                @if (Model.Setirler.Any())
                {
                    <span>· Toplam VK: <b class="mh-sub-total">@M(cemToplamVk) ₼</b></span>
                }
            </p>
        </div>
    </div>

    @if (!Model.SorguTapildi)
    {
        <div class="bd-alert bd-alert-warn">
            <i class="bi bi-exclamation-triangle"></i>
            <b>Sorğu tapılmadı.</b> Admin → Oracle Sorğular bölməsinə SQL-i əlavə edin, adını
            <b>"Məhkəməyə hazırlıq"</b> qoyub aktiv edin.
        </div>
    }
    else if (Model.Xeta != null)
    {
        <div class="bd-alert bd-alert-err"><i class="bi bi-x-octagon"></i> Oracle xətası: @Model.Xeta</div>
    }
    else
    {
        <div class="ms-toolbar" style="margin-bottom:12px">
            <div class="ms-search">
                <i class="bi bi-search"></i>
                <input type="text" id="mhSearch" placeholder="Borcalan / zamin adı, hesab axtar..." autocomplete="off" />
            </div>
            <span class="mh-hint"><i class="bi bi-info-circle"></i> Zaminləri görmək üçün sətrə klik edin</span>
            <a asp-action="MehkemeHazirliqExcel" class="mh-excel-btn" style="margin-left:auto">
                <i class="bi bi-file-earmark-excel"></i> Excel-ə çıxart
            </a>
        </div>

        <div class="ms-twrap">
            <table class="ms-table" id="mhTable">
                <thead>
                    <tr>
                        <th>№</th>
                        <th>Borcalan</th>
                        <th>Hesab</th>
                        <th>Status</th>
                        <th>Son bildiriş tarixi</th>
                        <th>Kr verilmə tarixi</th>
                        <th class="bd-num">Ver.kredit</th>
                        <th class="bd-num">Əsas</th>
                        <th class="bd-num">VK</th>
                        <th class="bd-num">Faiz</th>
                        <th class="bd-num">VK faiz</th>
                        <th class="bd-num">Toplam VK</th>
                        <th class="bd-num">Aylıq</th>
                        <th class="bd-num">3× aylıq</th>
                        <th>Son ödəniş</th>
                    </tr>
                </thead>
                @{ var i = 0; }
                @foreach (var s in Model.Setirler)
                {
                    i++;
                    var zaminSearch = string.Join(" ", s.Zaminlar.Select(z => z.Ad + " " + z.Fin));
                    var acilaBilen = s.Zaminlar.Any();
                    <tbody class="mh-grp" data-search="@($"{s.Ad} {s.Hes} {s.Sk} {zaminSearch}")">
                        <tr class="mh-row @(acilaBilen ? "mh-clickable" : "")">
                            <td class="mx-sira">@i</td>
                            <td>
                                @if (acilaBilen) { <i class="bi bi-chevron-right mh-chev"></i> }
                                <span class="mx-name">@T(s.Ad)</span>
                                @if (acilaBilen)
                                {
                                    <span class="ic-zbadge" title="@s.Zaminlar.Count zamin"><i class="bi bi-people"></i> @s.Zaminlar.Count zamin</span>
                                }
                            </td>
                            <td class="bd-mono">@T(s.Hes)</td>
                            <td>@if (!string.IsNullOrWhiteSpace(s.Item01)) { <span class="bd-stat">@s.Item01</span> } else { <span>—</span> }</td>
                            <td>@T(s.Item02)</td>
                            <td>@D(s.VTar)</td>
                            <td class="bd-num">@M(s.VerKr)</td>
                            <td class="bd-num">@M(s.Esas)</td>
                            <td class="bd-num">@M(s.Vk)</td>
                            <td class="bd-num">@M(s.Faiz)</td>
                            <td class="bd-num">@M(s.VkFaiz)</td>
                            <td class="bd-num"><b>@M(s.ToplamVkBorc)</b></td>
                            <td class="bd-num">@M(s.Ayliq)</td>
                            <td class="bd-num">@M(s.UcAyliqCemi)</td>
                            <td>@D(s.SonOdTar)</td>
                        </tr>
                        @foreach (var z in s.Zaminlar)
                        {
                            <tr class="mh-zrow" style="display:none">
                                <td></td>
                                <td>
                                    <span class="ic-zarrow">↳</span>
                                    <span class="ic-zrole">ZAMİN</span>
                                    <span class="ic-zad">@T(z.Ad)</span>
                                </td>
                                <td colspan="13" class="mh-zcell">
                                    <div class="mh-zdetal">
                                        <span><b>FİN:</b> @T(z.Fin)</span>
                                        <span><b>Doğum:</b> @D(z.DogumTarixi)@(string.IsNullOrWhiteSpace(z.DogumYeri) ? "" : " · " + z.DogumYeri)@(string.IsNullOrWhiteSpace(z.Olke) ? "" : " · " + z.Olke)</span>
                                        <span><b>Ünvan:</b> @T(z.Unvan)</span>
                                        <span><b>Tel:</b> @T(z.Telefon)</span>
                                        <span><b>Aylıq gəlir:</b> @M(z.Gelir)</span>
                                        <span><b>Borc yükü:</b> @M(z.BorcYuku)</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
                <tfoot>
                    <tr class="mh-total">
                        <td></td>
                        <td>CƏMİ</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td class="bd-num">@M(cemVerKr)</td>
                        <td class="bd-num">@M(cemEsas)</td>
                        <td class="bd-num">@M(cemVk)</td>
                        <td class="bd-num">@M(cemFaiz)</td>
                        <td class="bd-num">@M(cemVkFaiz)</td>
                        <td class="bd-num mh-total-hl">@M(cemToplamVk)</td>
                        <td class="bd-num">@M(cemAyliq)</td>
                        <td class="bd-num">@M(cemUcAyliq)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @if (Model.Setirler.Count == 0)
        {
            <div class="bd-alert bd-alert-info" style="margin-top:12px"><i class="bi bi-inbox"></i> Məhkəməyə hazırlıq üçün kredit yoxdur.</div>
        }
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/user-mehkeme.css" asp-append-version="true" />
    <style>
        #mhTable { border-collapse: collapse; }
        #mhTable thead th { white-space: nowrap; font-size: 11px; }
        #mhTable tbody td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; border-right: 1px solid #f1f5f9; white-space: nowrap; vertical-align: middle; font-size: 12.5px; }
        #mhTable tbody td:last-child { border-right: none; }
        #mhTable tbody.mh-grp { border-top: 2px solid #e5e7eb; }
        #mhTable tbody.mh-grp:first-of-type { border-top: none; }
        #mhTable tbody tr.mh-row td { background: #fff; }
        #mhTable tbody tr.mh-clickable { cursor: pointer; }
        #mhTable tbody tr.mh-clickable:hover td { background: #eff6ff; }
        #mhTable tbody tr.mh-zrow td { background: #fbfaff; color: #475569; }

        .mh-chev { color: #94a3b8; font-size: 11px; margin-right: 5px; transition: transform .15s; }
        #mhTable tbody.mh-grp.open .mh-chev { transform: rotate(90deg); color: #4338ca; }

        .bd-num { text-align: right; }
        .bd-mono { font-family: ui-monospace,Menlo,Consolas,monospace; font-size: 11.5px; color: #475569; }
        .mx-sira { color: #94a3b8; font-weight: 700; text-align: center; }
        .mx-name { font-weight: 700; color: #0f172a; }
        .ic-zarrow { color: #c4b5fd; margin-right: 5px; font-weight: 700; }
        .ic-zrole { display: inline-block; background: #ede9fe; color: #6d28d9; border-radius: 5px; padding: 0 6px; font-size: 10px; font-weight: 800; margin-right: 6px; letter-spacing: .03em; }
        .ic-zad { color: #1e293b; font-weight: 600; }
        .ic-zbadge { display: inline-flex; align-items: center; gap: 3px; background: #ede9fe; color: #6d28d9; border-radius: 6px; padding: 1px 7px; font-weight: 700; font-size: 11px; margin-left: 6px; }
        .bd-stat { display: inline-block; background: #eef2ff; color: #4338ca; border-radius: 6px; padding: 2px 8px; font-weight: 700; font-size: 11px; white-space: nowrap; }

        /* Zamin detal — sətrə klikdə açılır */
        .mh-zcell { white-space: normal !important; }
        .mh-zdetal { display: flex; flex-wrap: wrap; gap: 6px 22px; max-width: 1000px; font-size: 12.5px; color: #334155; }
        .mh-zdetal b { color: #64748b; font-weight: 700; }

        /* Sol tərəf: № + Borcalan sabit (üfüqi scroll-da donur) */
        #mhTable th:nth-child(1), #mhTable td:nth-child(1) {
            position: sticky; left: 0; box-sizing: border-box; width: 48px; min-width: 48px; max-width: 48px;
        }
        #mhTable th:nth-child(2), #mhTable td:nth-child(2) {
            position: sticky; left: 48px; box-shadow: 7px 0 10px -8px rgba(15,23,42,.22);
        }
        #mhTable thead th:nth-child(1), #mhTable thead th:nth-child(2) { z-index: 5; background: #eef2f6; }
        #mhTable tbody td:nth-child(1), #mhTable tbody td:nth-child(2) { z-index: 2; }
        #mhTable tbody tr.mh-row td:nth-child(1), #mhTable tbody tr.mh-row td:nth-child(2) { background: #fff; }
        #mhTable tbody tr.mh-clickable:hover td:nth-child(1), #mhTable tbody tr.mh-clickable:hover td:nth-child(2) { background: #eff6ff; }
        #mhTable tbody tr.mh-zrow td:nth-child(1), #mhTable tbody tr.mh-zrow td:nth-child(2) { background: #fbfaff; }

        .ms-twrap { max-height: calc(100vh - 300px); }
        /* Aşağı üfüqi scroll — tutub çəkmək asan olsun deyə hündür + tünd thumb */
        .ms-twrap::-webkit-scrollbar { height: 18px; width: 14px; }
        .ms-twrap::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 8px; border: 3px solid #eef2f6; }
        .ms-twrap::-webkit-scrollbar-thumb:hover { background: #64748b; }
        .ms-twrap::-webkit-scrollbar-track { background: #eef2f6; }
        .ms-twrap { scrollbar-color: #94a3b8 #eef2f6; }

        /* CƏMİ sətri (tfoot) */
        #mhTable tfoot td { background: #eef2f6; font-weight: 700; border-top: 2px solid #cbd5e1; padding: 10px 12px; font-size: 12.5px; white-space: nowrap; }
        #mhTable tfoot td.bd-num { text-align: right; }
        #mhTable tfoot td:nth-child(1), #mhTable tfoot td:nth-child(2) { z-index: 2; background: #eef2f6; }
        .mh-total-hl { color: #b91c1c; font-weight: 800; font-size: 13px; }
        .mh-sub-total { color: #b91c1c; }

        /* Excel düyməsi */
        .mh-excel-btn { display: inline-flex; align-items: center; gap: 6px; background: #0f766e; color: #fff; border-radius: 9px; padding: 8px 14px; font-size: 13px; font-weight: 700; text-decoration: none; white-space: nowrap; }
        .mh-excel-btn:hover { background: #0d5c56; color: #fff; }

        .ms-toolbar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
        .ms-search { position: relative; max-width: 420px; flex: 1; min-width: 240px; }
        .ms-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; }
        .ms-search input { width: 100%; padding: 9px 12px 9px 34px; border: 1px solid #e2e8f0; border-radius: 10px; font-size: 13px; outline: none; }
        .ms-search input:focus { border-color: #c7d2fe; }
        .mh-hint { color: #94a3b8; font-size: 12.5px; }

        .bd-alert { display:flex; align-items:flex-start; gap:9px; padding:12px 16px; border-radius:12px; font-size:14px; margin-bottom:14px; line-height:1.5; }
        .bd-alert-warn { background:#fff7ed; border:1px solid #fed7aa; color:#9a3412; }
        .bd-alert-err  { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
        .bd-alert-info { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('mhSearch');
            var grps = Array.prototype.slice.call(document.querySelectorAll('#mhTable tbody.mh-grp'));
            if (inp) inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                grps.forEach(function (g) {
                    var hay = (g.getAttribute('data-search') || '').toLowerCase();
                    g.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
            // Sətrə klik → zaminləri aç/bağla
            document.querySelectorAll('#mhTable tr.mh-clickable').forEach(function (tr) {
                tr.addEventListener('click', function () {
                    var grp = tr.closest('tbody');
                    var open = grp.classList.toggle('open');
                    grp.querySelectorAll('tr.mh-zrow').forEach(function (z) { z.style.display = open ? '' : 'none'; });
                });
            });
        })();
    </script>
}
