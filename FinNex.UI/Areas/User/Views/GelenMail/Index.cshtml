@model List<FinNex.Application.DTOs.Communication.GelenMailListDto>
@using FinNex.Application.DTOs.Communication
@{
    ViewData["Title"] = "Gələn Maillər";
    var oxunmamisFilter  = ViewBag.OxunmamisFilter as bool?;
    var isciFilter       = ViewBag.IsciFilter as int?;
    var axtarisFilter    = ViewBag.Axtaris as string;
    var tarixdenFilter   = ViewBag.Tarixden as string;
    var tarixeFilter     = ViewBag.Tarixe as string;
    var tapshirildiFlt   = ViewBag.Tapshirildi as bool?;
    var qosmaliFlt       = ViewBag.Qosmali as bool?;
    var deadlineFlt      = ViewBag.DeadlineFilter as string;
    var izlemeFlt        = ViewBag.IzlemeFilter as bool?;
    var izlemeSayi       = (int)(ViewBag.IzlemeSayi ?? 0);
    var oxunmamisSay     = (int)(ViewBag.OxunmamisSay ?? 0);
    var currentPage      = (int)(ViewBag.Page ?? 1);

    bool herhansiFilter = !string.IsNullOrWhiteSpace(axtarisFilter)
        || oxunmamisFilter.HasValue
        || !string.IsNullOrWhiteSpace(tarixdenFilter)
        || !string.IsNullOrWhiteSpace(tarixeFilter)
        || tapshirildiFlt.HasValue
        || qosmaliFlt.HasValue
        || !string.IsNullOrWhiteSpace(deadlineFlt)
        || izlemeFlt.HasValue;

    var prevUrl = Url.Action("Index", new { page = currentPage - 1, oxunmamis = oxunmamisFilter, isciId = isciFilter, q = axtarisFilter, tarixden = tarixdenFilter, tarixe = tarixeFilter, tapshirildi = tapshirildiFlt, qosmali = qosmaliFlt, deadline = deadlineFlt, izleme = izlemeFlt });
    var nextUrl = Url.Action("Index", new { page = currentPage + 1, oxunmamis = oxunmamisFilter, isciId = isciFilter, q = axtarisFilter, tarixden = tarixdenFilter, tarixe = tarixeFilter, tapshirildi = tapshirildiFlt, qosmali = qosmaliFlt, deadline = deadlineFlt, izleme = izlemeFlt });
}

<link rel="stylesheet" href="~/css/User/gelen-mail.css" asp-append-version="true" />
<script src="~/js/User/gm-attachment-preview.js" asp-append-version="true"></script>
@* Qoşma önizləmə skripti BURADA (split-panel-in özündə, AJAX-la yüklənən sağ
   paneldə YOX) yüklənir — eyni səbəb: GedenMail/Index.cshtml-dəki qeydə bax. *@

@* Mail İzləmə (12.10.2026) — "İzlənən" seçimi yadda saxlanır (istifadəçi şikayəti:
   "yadda saxlamir bunu? herdefe secim etmeliyik?"). URL-də `izleme` parametri heç
   YOXDURSA (nə true, nə false — yəni bu, sırf aç bu səhifəni ziyarətdir, checkbox-un
   özündən gələn göndəriş deyil) localStorage-a baxılır: əvvəl işarələnibsə eyni
   seçimlə yenidən yönləndirilir. Checkbox dəyişəndə (işarələnsin/götürülsün — hər
   iki hal) dəyər DƏRHAL (form submit-dən ƏVVƏL) localStorage-a yazılır ki, "götür"
   seçimi də düzgün yadda qalsın — əks halda unchecked checkbox GET-də heç ötürülmür
   və sonrakı ziyarətdə localStorage köhnə "true" dəyərini yenidən tətbiq edərdi. *@
<script>
(function () {
    try {
        var params = new URLSearchParams(location.search);
        if (!params.has('izleme')) {
            var saved = localStorage.getItem('gmIzlemeFilter');
            if (saved === '1') {
                params.set('izleme', 'true');
                location.replace(location.pathname + '?' + params.toString());
            }
        }
    } catch (e) { /* localStorage əlçatmazdırsa sadəcə normal davam et */ }
})();
function gmIzlemeDeyisdi(checked) {
    try { localStorage.setItem('gmIzlemeFilter', checked ? '1' : '0'); } catch (e) {}
}
</script>

@functions {
    static string StripMd(string s) {
        if (string.IsNullOrEmpty(s)) return s;
        // Remove markdown headers (## Title → Title)
        s = System.Text.RegularExpressions.Regex.Replace(s, @"#{1,6}\s*", "");
        // Remove bold/italic markers
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*+", "");
        // Remove list bullets
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?m)^[-*+]\s+", "");
        // Collapse whitespace/newlines to single space
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\s+", " ");
        return s.Trim();
    }
}

<div class="gm-split-page">

    @* ── Başlıq ── *@
    <div class="gm-split-top">
    <div class="gm-header">
        @* Başlıq silindi (12.10.2026) — "Gələn Maillər" artıq yuxarıdakı
           breadcrumb-da yazılır, burda təkrarlanması lazımsız hündürlük yaradırdı.
           Oxunmamış sayı itirilmədi — "Yenilə" düyməsinin yanına köçürüldü. *@
        <div style="display:flex;gap:8px;margin-left:auto;align-items:center">
            @if (oxunmamisSay > 0)
            {
                <span class="gm-badge-unread" title="Oxunmamış mail">@oxunmamisSay</span>
            }
            <span id="syncMsg" style="font-size:.82rem;color:#10b981;display:none"></span>
            <button type="button" id="yenileBtn" class="gm-btn gm-btn-outline">
                <i class="bi bi-arrow-clockwise"></i> Yenilə
            </button>
            <a asp-action="TapshirilanMailler" class="gm-btn gm-btn-outline">
                <i class="bi bi-list-check"></i> Tapşırılanlar
            </a>
            <a asp-action="Index" asp-controller="GedenMail" class="gm-btn gm-btn-outline">
                <i class="bi bi-send"></i> Göndərilənlər
            </a>
            <a asp-action="Index" asp-controller="MailIzleme" class="gm-btn gm-btn-outline">
                <i class="bi bi-eye"></i> İzləmə @(izlemeSayi > 0 ? $"({izlemeSayi})" : "")
            </a>
        </div>
    </div>
    </div>@* /gm-split-top *@
    @Html.AntiForgeryToken()

    <div class="gm-split-body">
    <div class="gm-split-left">

    @* ── Filter paneli ── *@
    <form method="get" id="filterForm" class="gm-split-filterbar">

        @* Axtarış — tam genişlik *@
        <div class="gm-split-search-row">
            <div class="gm-search-wrap" style="flex:1;min-width:0">
                <i class="bi bi-search gm-search-icon"></i>
                <input type="text" name="q" value="@axtarisFilter"
                       class="gm-search-input"
                       placeholder="Mövzu, göndərən axtar…" autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(axtarisFilter))
                {
                    <a href="@Url.Action("Index")" class="gm-search-clear" title="Sıfırla">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
            <button type="submit" class="gm-btn gm-btn-primary gm-split-search-btn">
                <i class="bi bi-search"></i>
            </button>
            @if (herhansiFilter)
            {
                <a href="@Url.Action("Index")" class="gm-btn gm-btn-ghost gm-split-search-btn" title="Sıfırla">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>

        @* Filterlər — ayrı bölmə *@
        <div class="gm-split-filter-section">
            <div class="gm-split-filter-row">
                <select name="oxunmamis" class="gm-select gm-select--sm" onchange="this.form.submit()">
                    <option value="">Hamısı</option>
                    <option value="true" selected="@(oxunmamisFilter == true)">Oxunmamış</option>
                </select>
                <select name="tapshirildi" class="gm-select gm-select--sm">
                    <option value="">Tapşırma</option>
                    <option value="true"  selected="@(tapshirildiFlt == true)">Tapşırılıb</option>
                    <option value="false" selected="@(tapshirildiFlt == false)">Tapşırılmayıb</option>
                </select>
                <select name="deadline" class="gm-select gm-select--sm">
                    <option value="">Deadline</option>
                    <option value="var"     selected="@(deadlineFlt == "var")">Var</option>
                    <option value="kecib"   selected="@(deadlineFlt == "kecib")">Keçib</option>
                    <option value="buhefte" selected="@(deadlineFlt == "buhefte")">Bu həftə</option>
                </select>
                <label class="gm-checkbox-label" style="white-space:nowrap">
                    <input type="checkbox" name="qosmali" value="true"
                           @(qosmaliFlt == true ? "checked" : "")
                           onchange="this.form.submit()" />
                    <i class="bi bi-paperclip"></i>
                </label>
                <label class="gm-checkbox-label" style="white-space:nowrap" title="Yalnız izləmə siyahınızdakı ünvanlardan gələnlər">
                    <input type="checkbox" name="izleme" value="true"
                           @(izlemeFlt == true ? "checked" : "")
                           onchange="gmIzlemeDeyisdi(this.checked); this.form.submit()" />
                    <i class="bi bi-eye"></i> İzlənən
                </label>
            </div>
            <div class="gm-split-filter-row">
                <input type="date" name="tarixden" value="@tarixdenFilter"
                       class="gm-input-date" title="Tarixdən" />
                <span style="color:#94a3b8;font-size:.8rem">—</span>
                <input type="date" name="tarixe" value="@tarixeFilter"
                       class="gm-input-date" title="Tarixə" />
            </div>
        </div>

        @* Aktiv filter chips *@
        @if (herhansiFilter)
        {
            <div class="gm-active-chips">
                @if (!string.IsNullOrWhiteSpace(axtarisFilter))
                {
                    <span class="gm-achip">🔍 @axtarisFilter</span>
                }
                @if (!string.IsNullOrWhiteSpace(tarixdenFilter) || !string.IsNullOrWhiteSpace(tarixeFilter))
                {
                    <span class="gm-achip">📅 @(tarixdenFilter ?? "…") – @(tarixeFilter ?? "…")</span>
                }
                @if (tapshirildiFlt.HasValue)
                {
                    <span class="gm-achip">👤 @(tapshirildiFlt == true ? "Tapşırılıb" : "Tapşırılmayıb")</span>
                }
                @if (!string.IsNullOrWhiteSpace(deadlineFlt))
                {
                    var dlbl = deadlineFlt switch { "kecib" => "Deadline keçib", "buhefte" => "Bu həftə", _ => "Deadline var" };
                    <span class="gm-achip">⏰ @dlbl</span>
                }
                @if (qosmaliFlt == true)
                {
                    <span class="gm-achip">📎 Qoşmalı</span>
                }
                @if (oxunmamisFilter == true)
                {
                    <span class="gm-achip">✉️ Oxunmamış</span>
                }
                @if (izlemeFlt == true)
                {
                    <span class="gm-achip">👁️ Yalnız izlənənlər</span>
                }
                <span class="gm-achip-count">@Model.Count nəticə</span>
            </div>
        }

    </form>

    @if (!Model.Any())
    {
        <div class="gm-empty">
            <i class="bi bi-inbox"></i>
            @if (izlemeFlt == true && izlemeSayi == 0)
            {
                <p>İzləmə siyahınız boşdur — "Yalnız izlənən" filtri ona görə heç nə göstərmir.</p>
                <a asp-action="Index" asp-controller="MailIzleme" class="gm-btn gm-btn-primary" style="margin-top:8px">
                    <i class="bi bi-plus-lg"></i> İzləmə siyahısına ünvan əlavə et
                </a>
            }
            else if (izlemeFlt == true)
            {
                <p>İzləmə siyahınızdakı ünvanlardan hələ mail gəlməyib.</p>
            }
            else
            {
                <p>Heç bir mail tapılmadı.</p>
            }
        </div>
    }
    else
    {
        <div class="gm-list">
            @foreach (var mail in Model)
            {
                var detailUrl = Url.Action("Detail", "GelenMail", new { area = "User", id = mail.Id });
                var unreadCls = !mail.Oxunub ? "gm-item--unread" : "";
                var wrapCls  = !mail.Oxunub ? "gm-item-wrap--unread" : "";
                var avatarChar = mail.KimdenAd.Length > 0 ? mail.KimdenAd[0].ToString().ToUpper() : "?";
                var fromName = string.IsNullOrWhiteSpace(mail.KimdenAd) ? mail.KimdenEmail : mail.KimdenAd;
                <div id="mailItem-@mail.Id" class="gm-item-wrap @wrapCls">
                <a href="@detailUrl" class="gm-item @unreadCls" data-mailid="@mail.Id">
                    <div class="gm-item-indicator"></div>
                    <div class="gm-item-avatar"><span>@avatarChar</span></div>
                    <div class="gm-item-body">
                        <div class="gm-item-from">
                            <span class="gm-from-name">@fromName</span>
                            <span class="gm-from-email">@mail.KimdenEmail</span>
                        </div>
                        <div class="gm-item-subject">@mail.Movzu</div>
                        @if (!string.IsNullOrEmpty(mail.AIXulase))
                        {
                            var aiStripped = StripMd(mail.AIXulase);
                            var aiPreview = aiStripped.Length > 120 ? aiStripped.Substring(0, 120) + "…" : aiStripped;
                            <div class="gm-item-ai"><i class="bi bi-robot"></i> @aiPreview</div>
                        }
                    </div>
                    <div class="gm-item-meta">
                        <span class="gm-item-date">@mail.AlinmaTarixi.ToString("dd MMM HH:mm")</span>
                        @if (mail.DedlaynTarix.HasValue)
                        {
                            var ddiff = (mail.DedlaynTarix.Value.Date - DateTime.Today).TotalDays;
                            var dcls = ddiff < 0 ? "gm-tag--dedlayn-red" : ddiff <= 2 ? "gm-tag--dedlayn-red" : ddiff <= 7 ? "gm-tag--dedlayn-amber" : "gm-tag--dedlayn-green";
                            var dlabel = ddiff < 0 ? $"{-(int)ddiff}g keçib" : ddiff == 0 ? "Bu gün!" : $"{(int)ddiff}g qaldı";
                            <span class="gm-tag @dcls" title="@mail.DedlaynQeyd">
                                <i class="bi bi-alarm"></i> @dlabel
                            </span>
                        }
                        <div class="gm-item-tags">
                            @if (mail.QosmaCount > 0)
                            {
                                <span class="gm-tag gm-tag--attach"><i class="bi bi-paperclip"></i> @mail.QosmaCount</span>
                            }
                            @if (!string.IsNullOrEmpty(mail.TapalanIsciAdSoyad))
                            {
                                <span class="gm-tag gm-tag--assigned" title="@mail.TapalanIsciAdSoyad"><i class="bi bi-person-check"></i></span>
                            }
                            @if (mail.SenedId.HasValue)
                            {
                                <span class="gm-tag gm-tag--sened" title="Sənədə əlavə edilib"><i class="bi bi-file-earmark-check"></i></span>
                            }
                        </div>
                    </div>
                </a>
                <form asp-action="Sil" method="post" class="gm-item-sil-form"
                      onsubmit="return confirm('Silinsin?')">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@mail.Id" />
                    <button type="submit" class="gm-item-sil-btn" title="Sil">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
                </div>
            }
        </div>

        @if (Model.Count == 50)
        {
            <div class="gm-pagination">
                @if (currentPage > 1)
                {
                    <a href="@prevUrl" class="gm-btn gm-btn-outline">
                        <i class="bi bi-chevron-left"></i> Əvvəlki
                    </a>
                }
                <span class="gm-page-info">Səhifə @(currentPage)</span>
                <a href="@nextUrl" class="gm-btn gm-btn-outline">
                    Növbəti <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        }
    }
</div>@* /gm-split-left *@

<div class="gm-split-right" id="gmRightPanel">
    <div class="gm-split-placeholder">
        <i class="bi bi-envelope-open" style="font-size:2.5rem"></i>
        <span>Oxumaq üçün mail seçin</span>
    </div>
</div>

</div>@* /gm-split-body *@

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
(function() {
    var panel = document.getElementById('gmRightPanel');
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';

    function executeScripts(container) {
        container.querySelectorAll('script').forEach(function(old) {
            var s = document.createElement('script');
            s.textContent = old.textContent;
            old.parentNode.replaceChild(s, old);
        });
    }

    async function loadPanel(id) {
        panel.innerHTML = '<div class="gm-split-loading"><i class="bi bi-arrow-repeat spin"></i> Yüklənir...</div>';
        document.querySelectorAll('.gm-item-wrap').forEach(el => el.classList.remove('gm-item--active'));
        var wrap = document.getElementById('mailItem-' + id);
        if (wrap) wrap.classList.add('gm-item--active');

        try {
            var res = await fetch('/User/GelenMail/MailPanel/' + id, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            var html = await res.text();
            panel.innerHTML = html;
            executeScripts(panel);
            // Mark as read visually
            if (wrap) wrap.classList.remove('gm-item-wrap--unread');
            var link = wrap?.querySelector('.gm-item');
            if (link) link.classList.remove('gm-item--unread');
        } catch(e) {
            panel.innerHTML = '<div class="gm-split-placeholder"><i class="bi bi-exclamation-circle"></i><span>Yükləmə xətası</span></div>';
        }
    }

    // Desktop: tək klik → sağ panel, cüt klik → tam səhifə
    if (window.innerWidth >= 992) {
        var clickTimer = null;

        document.addEventListener('click', function(e) {
            var link = e.target.closest('.gm-item[data-mailid]');
            if (!link) return;
            e.preventDefault();
            // Əgər artıq timer varsa — bu ikinci klkdir, dblclick handler götürəcək
            if (clickTimer !== null) return;
            var savedHref = link.href;
            var savedId   = link.dataset.mailid;
            clickTimer = setTimeout(function() {
                clickTimer = null;
                loadPanel(savedId);
            }, 240);
        });

        document.addEventListener('dblclick', function(e) {
            var link = e.target.closest('.gm-item[data-mailid]');
            if (!link) return;
            e.preventDefault();
            if (clickTimer !== null) { clearTimeout(clickTimer); clickTimer = null; }
            window.location.href = link.href;
        });
    }
})();
</script>
<script>
(function () {
    var btn = document.getElementById('yenileBtn');
    var msg = document.getElementById('syncMsg');
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
    if (!btn) return;

    btn.addEventListener('click', async function () {
        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise spin"></i> Yüklənir…';
        msg.style.display = 'none';
        try {
            var r = await fetch('/User/GelenMail/ManualSync', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            var d = await r.json();
            msg.textContent = d.message;
            msg.style.color = d.success ? '#10b981' : '#ef4444';
            msg.style.display = '';
            if (d.success && d.count > 0) setTimeout(() => location.reload(), 800);
        } catch {
            msg.textContent = 'Bağlantı xətası.';
            msg.style.color = '#ef4444';
            msg.style.display = '';
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Yenilə';
    });
})();
</script>
<style>.spin { animation: spin .8s linear infinite; } @@keyframes spin { to { transform: rotate(360deg); } }</style>
}
