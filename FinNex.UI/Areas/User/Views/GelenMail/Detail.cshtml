@model FinNex.Application.DTOs.Communication.GelenMailDetailDto
@using FinNex.Application.DTOs.HR.Isci
@using System.IO
@{
    ViewData["Title"] = Model.Movzu;
    var isciler = ViewBag.Isciler as IEnumerable<IsciListDto> ?? Enumerable.Empty<IsciListDto>();
    var tapalanIds = Model.TapalanIsciler.Select(ti => ti.IsciId).ToHashSet();

    string DedlaynClass(DateTime? t) {
        if (!t.HasValue) return "";
        var d = (t.Value.Date - DateTime.Today).TotalDays;
        return d < 0 ? "gm-dedlayn--kecib" : d <= 2 ? "gm-dedlayn--bugun" : d <= 7 ? "gm-dedlayn--yaxin" : "gm-dedlayn--gozle";
    }
    string DedlaynLabel(string? nov) => nov switch {
        "Gorus" => "Görüş", "Hesabat" => "Hesabat",
        "Muqavile" => "Müqavilə", "SonTarix" => "Son tarix", _ => "Deadline"
    };
}

<link rel="stylesheet" href="~/css/User/gelen-mail.css" asp-append-version="true" />

<div class="gm-detail-page">

    <div class="gm-detail-nav">
        <a href="@Url.Action("Index", "GelenMail", new { area = "User" })" class="gm-btn gm-btn-ghost">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
        <form asp-action="Sil" method="post" style="margin-left:auto"
              onsubmit="return confirm('Bu maili silmək istəyirsiniz?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="gm-btn gm-btn-danger-outline">
                <i class="bi bi-trash"></i> Sil
            </button>
        </form>
        @if (TempData["Success"] != null)
        {
            <div class="gm-alert gm-alert--success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="gm-alert gm-alert--error">@TempData["Error"]</div>
        }
    </div>

    @if (Model.DedlaynTarix.HasValue)
    {
        <div class="gm-dedlayn-banner @DedlaynClass(Model.DedlaynTarix)">
            <i class="bi bi-alarm-fill"></i>
            <strong>@DedlaynLabel(Model.DedlaynNov):</strong>
            @Model.DedlaynTarix.Value.ToString("dd MMMM yyyy")
            @if (!string.IsNullOrWhiteSpace(Model.DedlaynQeyd))
            {
                <span class="gm-dedlayn-qeyd">— @Model.DedlaynQeyd</span>
            }
            @{
                var diff = (Model.DedlaynTarix.Value.Date - DateTime.Today).TotalDays;
                if (diff < 0)      { <span class="gm-dedlayn-chip gm-dedlayn-chip--red">@(-(int)diff) gün keçib</span> }
                else if (diff == 0){ <span class="gm-dedlayn-chip gm-dedlayn-chip--red">Bu gün!</span> }
                else if (diff <= 7){ <span class="gm-dedlayn-chip gm-dedlayn-chip--amber">@((int)diff) gün qaldı</span> }
                else               { <span class="gm-dedlayn-chip gm-dedlayn-chip--green">@((int)diff) gün qaldı</span> }
            }
        </div>
    }
    <div id="dedlaynBanner" style="display:none"></div>

    <div class="gm-detail-layout">

        <!-- Sol: mail mətni -->
        <div class="gm-detail-main">
            <div class="gm-mail-header">
                <h2 class="gm-mail-subject">@Model.Movzu</h2>
                <div class="gm-mail-from">
                    <div class="gm-mail-avatar">@(Model.KimdenAd.Length > 0 ? Model.KimdenAd[0].ToString().ToUpper() : "?")</div>
                    <div>
                        <div class="gm-mail-from-name">@(string.IsNullOrWhiteSpace(Model.KimdenAd) ? Model.KimdenEmail : Model.KimdenAd)</div>
                        <div class="gm-mail-from-email">@Model.KimdenEmail</div>
                    </div>
                    <div class="gm-mail-date">@Model.AlinmaTarixi.ToString("dd MMMM yyyy, HH:mm")</div>
                </div>
            </div>

            <div class="gm-mail-body">
                @if (!string.IsNullOrWhiteSpace(Model.MetinHtml))
                {
                    <div class="gm-mail-html">@Html.Raw(Model.MetinHtml)</div>
                }
                else
                {
                    <pre class="gm-mail-plain">@Model.MetinDuz</pre>
                }
            </div>

            @if (Model.Qosmalar.Any())
            {
                <div class="gm-attachments">
                    <h4 class="gm-attachments-title">
                        <i class="bi bi-paperclip"></i> Qoşmalar (@Model.Qosmalar.Count)
                    </h4>
                    <div class="gm-attachments-list">
                        @foreach (var q in Model.Qosmalar)
                        {
                            <div class="gm-attachment-card">
                                <div class="gm-attachment-icon">
                                    <i class="bi @(GetFileIcon(q.FaylAdi)) fs-2"></i>
                                </div>
                                <div class="gm-attachment-info">
                                    <span class="gm-attachment-name">@q.FaylAdi</span>
                                    <span class="gm-attachment-size">@FormatBytes(q.OlcuBayt)</span>
                                </div>
                                <div class="gm-attachment-actions">
                                    @if (!string.IsNullOrWhiteSpace(q.CixarilmisMetin))
                                    {
                                        <button class="gm-btn gm-btn-sm gm-btn-ghost" onclick="toggleText('@q.Id')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    }
                                    <form asp-action="SenedeCevir" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="mailId" value="@Model.Id" />
                                        <input type="hidden" name="qosmaId" value="@q.Id" />
                                        <button type="submit" class="gm-btn gm-btn-sm gm-btn-outline"
                                                onclick="return confirm('Sənəd Dövriyyəsinə əlavə etmək istəyirsiniz?')">
                                            <i class="bi bi-file-earmark-arrow-up"></i> Sənədə
                                        </button>
                                    </form>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(q.CixarilmisMetin))
                                {
                                    <div id="text-@q.Id" class="gm-attachment-text" style="display:none">
                                        <pre>@q.CixarilmisMetin.Substring(0, Math.Min(q.CixarilmisMetin.Length, 2000))@(q.CixarilmisMetin.Length > 2000 ? "\n[...]" : "")</pre>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sağ: sidebar -->
        <div class="gm-detail-sidebar">

            <!-- AI Card -->
            <div class="gm-card gm-ai-card">
                <div class="gm-card-header">
                    <i class="bi bi-robot"></i> AI Təhlili
                    @if (Model.AITahlilTarixi.HasValue)
                    {
                        <span class="gm-ai-date">@Model.AITahlilTarixi.Value.ToString("HH:mm")</span>
                    }
                </div>
                <div class="gm-card-body">
                    @if (!string.IsNullOrEmpty(Model.AIXulase))
                    {
                        <div class="gm-ai-text gm-markdown" id="aiMarkdown"></div>
                        <script>
                            window.__aiRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AIXulase));
                        </script>
                    }
                    else
                    {
                        <div class="gm-ai-loading" id="aiLoading">
                            <div class="gm-ai-spinner"></div>
                            <span>Təhlil edilir...</span>
                        </div>
                        <div class="gm-ai-text gm-markdown" id="aiMarkdown" style="display:none"></div>
                    }
                </div>
            </div>

            <!-- Tapşırılmış işçilər -->
            @if (Model.TapalanIsciler.Any())
            {
                <div class="gm-card">
                    <div class="gm-card-header"><i class="bi bi-people-fill"></i> Tapşırılıb</div>
                    <div class="gm-card-body" style="padding:8px 12px">
                        @foreach (var ti in Model.TapalanIsciler)
                        {
                            <div class="gm-tapilan-isci">
                                <div class="gm-tapilan-avatar">@(ti.AdSoyad.Length > 0 ? ti.AdSoyad[0].ToString() : "?")</div>
                                <div>
                                    <div class="gm-tapilan-ad">@ti.AdSoyad</div>
                                    <div class="gm-tapilan-tarix">@ti.TapalanTarix.ToString("dd.MM HH:mm")</div>
                                </div>
                                <i class="bi bi-check-circle-fill" style="color:#10b981;margin-left:auto;font-size:.85rem"></i>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Tapşırma formu -->
            <div class="gm-card">
                <div class="gm-card-header"><i class="bi bi-person-check"></i> İşçiyə Tapşır</div>
                <div class="gm-card-body">
                    <form asp-action="Tapa" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="mailId" value="@Model.Id" />

                        <p class="gm-form-hint">Bir neçə işçi seçmək olar</p>
                        <div class="gm-isci-list">
                            @foreach (var isci in isciler)
                            {
                                var chk = tapalanIds.Contains(isci.Id);
                                <label class="gm-isci-item @(chk ? "gm-isci-item--checked" : "")">
                                    <input type="checkbox" name="isciIds" value="@isci.Id" @(chk ? "checked" : "") />
                                    <div class="gm-isci-avatar">@(isci.TamAd.Length > 0 ? isci.TamAd[0].ToString() : "?")</div>
                                    <span class="gm-isci-ad">@isci.TamAd</span>
                                </label>
                            }
                        </div>

                        <textarea name="qeyd" class="gm-textarea" rows="2"
                                  placeholder="Qeyd (ixtiyari)..." style="margin-top:8px">@Model.TapalanQeyd</textarea>
                        <button type="submit" class="gm-btn gm-btn-primary w-100" style="margin-top:8px">
                            <i class="bi bi-send"></i> Tapşır
                        </button>
                    </form>
                </div>
            </div>

            @if (Model.SenedId.HasValue)
            {
                <div class="gm-card gm-status-card">
                    <i class="bi bi-file-earmark-check-fill text-success"></i>
                    Sənəd dövriyyəsinə əlavə edilib
                    <a href="@Url.Action("Detail", "Sened", new { area = "User", id = Model.SenedId })"
                       class="gm-btn gm-btn-sm gm-btn-outline">Sənədə Bax</a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string FormatBytes(long b) =>
        b < 1024 ? $"{b} B" : b < 1048576 ? $"{b/1024.0:F1} KB" : $"{b/1048576.0:F1} MB";

    string GetFileIcon(string f) {
        var e = Path.GetExtension(f ?? "").ToLowerInvariant();
        if (e == ".pdf") return "bi-file-earmark-pdf text-danger";
        if (e == ".docx" || e == ".doc") return "bi-file-earmark-word text-primary";
        if (e == ".xlsx" || e == ".xls") return "bi-file-earmark-excel text-success";
        return "bi-file-earmark text-secondary";
    }
}

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
var __mailId = @Model.Id;
var __token  = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)?.[1] || '';

function toggleText(id) {
    var el = document.getElementById('text-' + id);
    if (el) el.style.display = el.style.display === 'none' ? 'block' : 'none';
}

// AI render
function renderAI(text) {
    var el = document.getElementById('aiMarkdown');
    if (!el || !text) return;
    el.innerHTML = marked.parse(text);
    el.style.display = '';
    var loading = document.getElementById('aiLoading');
    if (loading) loading.style.display = 'none';
}

(function () {
    // Əgər DB-dən gəlirsə — dərhal render
    if (window.__aiRaw) {
        renderAI(window.__aiRaw);
        return;
    }
    // Yoxdursa — AJAX ilə çağır
    var form = new FormData();
    form.append('__RequestVerificationToken', document.querySelector('input[name=__RequestVerificationToken]')?.value || '');
    fetch('/User/GelenMail/RunAI?id=' + __mailId, { method: 'POST', body: form })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.xulase) renderAI(d.xulase);
            // Deadline banner-i göstər
            if (d.dedlaynTarix) {
                var b = document.getElementById('dedlaynBanner');
                if (b) {
                    b.innerHTML = '<div class="gm-dedlayn-banner gm-dedlayn--yaxin" style="margin-top:8px"><i class="bi bi-alarm-fill"></i> <strong>' +
                        (d.dedlaynNov || 'Deadline') + ':</strong> ' + d.dedlaynTarix +
                        (d.dedlaynQeyd ? ' — ' + d.dedlaynQeyd : '') + '</div>';
                    b.style.display = '';
                }
            }
        })
        .catch(function () {
            var loading = document.getElementById('aiLoading');
            if (loading) loading.innerHTML = '<span style="color:#9ca3af;font-size:.8rem">AI cavabı alınmadı</span>';
        });
})();

// Checkbox styling
document.querySelectorAll('.gm-isci-item input[type=checkbox]').forEach(function (cb) {
    cb.addEventListener('change', function () {
        this.closest('.gm-isci-item').classList.toggle('gm-isci-item--checked', this.checked);
    });
});
</script>
