@model FinNex.UI.Areas.User.ViewModels.Gorush.GorushYaratVM
@{
    ViewData["Title"] = "Tedbir Yarat";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/gorush.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="grsh-form-wrap">
        <div class="grsh-form-header">
            <a asp-action="Index" class="grsh-back">← Geri</a>
            <div class="grsh-form-title">Yeni Tedbir</div>
        </div>

        <form asp-action="Yarat" method="post" class="grsh-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="TeshkilatciIsciId" />

            <div class="grsh-field">
                <label class="grsh-label">Başlıq <span class="grsh-required">*</span></label>
                <input asp-for="Bashliq" class="grsh-input" placeholder="Tədbirın mövzusu..." />
                <span asp-validation-for="Bashliq" class="grsh-error"></span>
            </div>

            <div class="grsh-field">
                <label class="grsh-label">Gündəm</label>
                <textarea asp-for="Agenda" class="grsh-textarea" rows="3"
                          placeholder="Müzakirə olunacaq mövzular..."></textarea>
            </div>

            <div class="grsh-form-row">
                <div class="grsh-field">
                    <label class="grsh-label">Tarix <span class="grsh-required">*</span></label>
                    <input asp-for="Tarix" type="date" class="grsh-input"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="grsh-field">
                    <label class="grsh-label">Yer</label>
                    <input asp-for="Yer" class="grsh-input" placeholder="Ünvan, bina adı..." />
                </div>
            </div>

            <div class="grsh-form-row">
                <div class="grsh-field">
                    <label class="grsh-label">Başlama saatı <span class="grsh-required">*</span></label>
                    <input asp-for="BaslamaSaati" type="time" class="grsh-input" />
                </div>
                <div class="grsh-field">
                    <label class="grsh-label">Bitmə saatı <span style="font-weight:400;color:#9ca3af;font-size:.8em">(opsional)</span></label>
                    <input asp-for="BitisSaati" type="time" class="grsh-input" />
                </div>
            </div>

            <div class="grsh-field">
                <label class="grsh-label">İştirakçılar</label>
                <div class="grsh-ishtirakci-list">
                    @foreach (var item in Model.IsciList)
                    {
                        <label class="grsh-ishtirakci-item">
                            <input type="checkbox"
                                   name="SecilmisIshtirakcilar"
                                   value="@item.Value"
                                   class="grsh-checkbox" />
                            <span>@item.Text</span>
                        </label>
                    }
                </div>
            </div>

            <div class="grsh-form-footer">
                <a asp-action="Index" class="grsh-btn grsh-btn--ghost">Ləğv et</a>
                <button type="submit" class="grsh-btn grsh-btn--primary">
                    Tedbir yarat
                </button>
            </div>
        </form>
    </div>
</div>
