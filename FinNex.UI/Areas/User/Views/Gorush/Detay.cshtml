@model FinNex.Application.DTOs.Communication.GorushDetailDto
@using FinNex.Domain.Entities.Communication
@{
    ViewData["Title"] = Model.Bashliq;
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var isciId = (int)(ViewBag.IsciId ?? 0);
    var menTeshkilatci = Model.TeshkilatciIsciId == isciId;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/gorush.css" asp-append-version="true" />
}

<div class="fn-page">

    <div style="margin-bottom:16px">
        <a asp-action="Index" class="grsh-btn grsh-btn--ghost">← Geri</a>
    </div>

    <div class="tsk-detay-grid">

        @* ── Sol ── *@
        <div>
            @* Başlıq kartı *@
            <div class="tsk-detay-card">
                <div class="tsk-detay-head">
                    <div>
                        <span class="grsh-status @Model.HesablanmisStatusClass" style="margin-bottom:6px;display:inline-block">
                            @Model.HesablanmisStatusText
                        </span>
                        <div class="tsk-detay-title">@Model.Bashliq</div>
                    </div>
                </div>

                <div class="tsk-detay-meta">
                    <div class="tsk-meta-row">
                        <span class="tsk-meta-lbl">Təşkilatçı</span>
                        <span class="tsk-meta-val">@Model.TeshkilatciAd</span>
                    </div>
                    <div class="tsk-meta-row">
                        <span class="tsk-meta-lbl">Tarix</span>
                        <span class="tsk-meta-val">@Model.Tarix.ToString("dd MMMM yyyy, dddd")</span>
                    </div>
                    <div class="tsk-meta-row">
                        <span class="tsk-meta-lbl">Başlama</span>
                        <span class="tsk-meta-val">
                            @Model.BaslamaSaati.ToString(@"hh\:mm")@(Model.BitisSaati.HasValue ? " — " + Model.BitisSaati.Value.ToString(@"hh\:mm") : "")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Yer))
                    {
                        <div class="tsk-meta-row">
                            <span class="tsk-meta-lbl">Yer</span>
                            <span class="tsk-meta-val">📍 @Model.Yer</span>
                        </div>
                    }
                </div>
            </div>

            @* Gündəm *@
            @if (!string.IsNullOrEmpty(Model.Agenda))
            {
                <div class="tsk-detay-card">
                    <div class="tsk-sherh-title">Gündəm</div>
                    <div style="font-size:.85rem;color:#374151;line-height:1.7;white-space:pre-wrap">@Model.Agenda</div>
                </div>
            }

            @* Görüş qeydləri *@
            @if (!string.IsNullOrEmpty(Model.Qeydler))
            {
                <div class="tsk-detay-card">
                    <div class="tsk-sherh-title">Qeydlər</div>
                    <div style="font-size:.85rem;color:#374151;line-height:1.7;white-space:pre-wrap">@Model.Qeydler</div>
                </div>
            }

            @* Qeyd əlavə et (təşkilatçı, bitmiş tedbir üçün) *@
            @if (menTeshkilatci && Model.Status == GorushStatus.Bitdi
                        && string.IsNullOrEmpty(Model.Qeydler))
            {
                <div class="tsk-detay-card">
                    <div class="tsk-sherh-title">Qeyd əlavə et</div>
                    <form asp-action="QeydEleveEt" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="gorushId" value="@Model.Id" />
                        <textarea name="qeydler" class="grsh-textarea" rows="4"
                              placeholder="Tədbirden sonra qeydlər, növbəti addımlar..."></textarea>
                        <button type="submit" class="grsh-btn grsh-btn--primary"
                                style="margin-top:8px">Saxla</button>
                    </form>
                </div>
            }

            @* İştirakçılar *@
            <div class="tsk-detay-card">
                <div class="tsk-sherh-title">
                    İştirakçılar
                    <span class="tsk-sherh-count">@Model.IshtirakciSayi</span>
                </div>
                <div class="grsh-ishtirakci-cards">
                    @foreach (var i in Model.Ishtirakcılar)
                    {
                        <div class="grsh-ishtirakci-card">
                            <div class="grsh-ic-avatar">@i.IsciAd.Substring(0, 1)</div>
                            <div class="grsh-ic-info">
                                <div class="grsh-ic-name">@i.IsciAd</div>
                                <div class="grsh-ic-vezife">@i.IsciVezife</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Sağ — yalnız təşkilatçı əməliyyatları ── *@
        @if (menTeshkilatci)
        {
            <div>
                <div class="tsk-detay-card">
                    <div class="tsk-action-title">Əməliyyatlar</div>
                    <div style="display:flex;flex-direction:column;gap:8px">

                        @if (Model.Status == GorushStatus.Planlanib || Model.Status == GorushStatus.Bashladi)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="grsh-btn grsh-btn--ghost"
                               style="justify-content:center">
                                ✏️ Redaktə et
                            </a>

                            <form asp-action="StatusYenile" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="3" />
                                <button type="submit" class="grsh-btn grsh-btn--primary"
                                        style="width:100%;justify-content:center">
                                    ✓ Tedbiri bitir
                                </button>
                            </form>

                            <form asp-action="StatusYenile" method="post"
                                  onsubmit="return confirm('Tedbiri ləğv etmək istəyirsiniz?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="4" />
                                <button type="submit" class="grsh-btn tsk-btn--danger"
                                        style="width:100%;justify-content:center">
                                    ✕ Ləğv et
                                </button>
                            </form>
                        }

                        @if (Model.Status == GorushStatus.Bitdi)
                        {
                            <div style="text-align:center;color:#6b7280;font-size:.85rem;padding:8px">
                                ✓ Tedbir tamamlandı
                            </div>
                        }

                        @if (Model.Status == GorushStatus.LegvEdildi)
                        {
                            <div style="text-align:center;color:#ef4444;font-size:.85rem;padding:8px">
                                ✕ Ləğv edilib
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
