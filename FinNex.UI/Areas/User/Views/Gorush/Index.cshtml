@model FinNex.UI.Areas.User.ViewModels.Gorush.GorushIndexVM
@using FinNex.Domain.Entities.Communication
@{
    ViewData["Title"] = "Tədbirlər";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/gorush.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="grsh-header">
        <div>
            <div class="grsh-title">Tədbirlər</div>
            <div class="grsh-sub">Planlanmış xarici tədbirlər və toplantılar</div>
        </div>
        <a asp-action="Yarat" class="grsh-btn grsh-btn--primary">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M6.5 1v11M1 6.5h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            Tedbir yarat
        </a>
    </div>

    @* Yaxınlaşan tədbirlər *@
    @if (Model.YaxinlashanGorushler.Any())
    {
        <div class="grsh-upcoming">
            <div class="grsh-upcoming-title">
                🔔 Bu həftə (@Model.YaxinlashanGorushler.Count tedbir)
            </div>
            <div class="grsh-upcoming-list">
                @foreach (var g in Model.YaxinlashanGorushler)
                {
                    <a asp-action="Detay" asp-route-id="@g.Id" class="grsh-upcoming-card">
                        <div class="grsh-upcoming-date">
                            <div class="grsh-udate-day">@g.Tarix.ToString("dd")</div>
                            <div class="grsh-udate-mon">@g.Tarix.ToString("MMM")</div>
                        </div>
                        <div class="grsh-upcoming-info">
                            <div class="grsh-upcoming-name">@g.Bashliq</div>
                            <div class="grsh-upcoming-time">
                                @g.BaslamaSaati.ToString(@"hh\:mm")@(g.BitisSaati.HasValue ? " — " + g.BitisSaati.Value.ToString(@"hh\:mm") : "")
                                @if (!string.IsNullOrEmpty(g.Yer))
                                {
                                    <span> · @g.Yer</span>
                                }
                            </div>
                        </div>
                        <span class="grsh-status @g.HesablanmisStatusClass">@g.HesablanmisStatusText</span>
                    </a>
                }
            </div>
        </div>
    }

    @* Tabs *@
    <div class="grsh-tabs">
        <button class="grsh-tab @(Model.AktivTab == "menim" ? "active" : "")"
                data-tab="menim">
            Dəvət olunduğum
            <span class="grsh-tab-count">@Model.MenimGorushler.Count</span>
        </button>
        <button class="grsh-tab @(Model.AktivTab == "teshkil" ? "active" : "")"
                data-tab="teshkil">
            Təşkil etdiklərim
            <span class="grsh-tab-count">@Model.TeshkilEtdiklerim.Count</span>
        </button>
    </div>

    @* Axtarış və filter *@
    <div class="grsh-searchbar">
        <div class="grsh-search-wrap">
            <svg class="grsh-search-icon" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
            <input type="text" id="grshSearch" class="grsh-search-input" placeholder="Tedbir axtar..." autocomplete="off" />
        </div>
        <div class="grsh-chips">
            <button class="grsh-chip active" data-filter="all">Hamısı</button>
            <button class="grsh-chip" data-filter="grsh-status--plan">Planlanıb</button>
            <button class="grsh-chip" data-filter="grsh-status--active">Davam edir</button>
            <button class="grsh-chip" data-filter="grsh-status--done">Tamamlandı</button>
            <button class="grsh-chip" data-filter="grsh-status--cancel">Ləğv edildi</button>
        </div>
    </div>

    @* Dəvət olunduğum tədbirlər *@
    <div class="grsh-panel @(Model.AktivTab == "menim" ? "" : "grsh-hidden")"
         data-panel="menim">
        @if (!Model.MenimGorushler.Any())
        {
            <div class="grsh-empty">
                <div class="grsh-empty-icon">📅</div>
                <div class="grsh-empty-title">Dəvət olunduğunuz tedbir yoxdur</div>
            </div>
        }
        else
        {
            <div class="grsh-list">
                @foreach (var g in Model.MenimGorushler.OrderBy(x => x.Tarix))
                {
                    <a asp-action="Detay" asp-route-id="@g.Id" class="grsh-card"
                       data-status="@g.HesablanmisStatusClass"
                       data-search="@($"{g.Bashliq} {g.TeshkilatciAd} {g.Yer}".ToLower())">
                        <div class="grsh-card-date">
                            <div class="grsh-date-day">@g.Tarix.ToString("dd")</div>
                            <div class="grsh-date-mon">@g.Tarix.ToString("MMM")</div>
                        </div>
                        <div class="grsh-card-info">
                            <div class="grsh-card-title">@g.Bashliq</div>
                            <div class="grsh-card-meta">
                                <span>@g.TeshkilatciAd</span>
                                <span>@g.BaslamaSaati.ToString(@"hh\:mm")@(g.BitisSaati.HasValue ? " — " + g.BitisSaati.Value.ToString(@"hh\:mm") : "")</span>
                                @if (!string.IsNullOrEmpty(g.Yer))
                                {
                                    <span>📍 @g.Yer</span>
                                }
                                <span>👥 @g.IshtirakciSayi nəfər</span>
                            </div>
                        </div>
                        <span class="grsh-status @g.HesablanmisStatusClass">@g.HesablanmisStatusText</span>
                    </a>
                }
            </div>
            <div class="grsh-no-result" id="noResultMenim">Nəticə tapılmadı</div>
        }
    </div>

    @* Təşkil etdiklərim *@
    <div class="grsh-panel @(Model.AktivTab == "teshkil" ? "" : "grsh-hidden")"
         data-panel="teshkil">
        @if (!Model.TeshkilEtdiklerim.Any())
        {
            <div class="grsh-empty">
                <div class="grsh-empty-icon">📋</div>
                <div class="grsh-empty-title">Təşkil etdiyiniz tedbir yoxdur</div>
                <a asp-action="Yarat" class="grsh-btn grsh-btn--ghost" style="margin-top:12px">
                    Tedbir yarat
                </a>
            </div>
        }
        else
        {
            <div class="grsh-list">
                @foreach (var g in Model.TeshkilEtdiklerim.OrderBy(x => x.Tarix))
                {
                    <a asp-action="Detay" asp-route-id="@g.Id" class="grsh-card"
                       data-status="@g.HesablanmisStatusClass"
                       data-search="@($"{g.Bashliq} {g.Yer}".ToLower())">
                        <div class="grsh-card-date">
                            <div class="grsh-date-day">@g.Tarix.ToString("dd")</div>
                            <div class="grsh-date-mon">@g.Tarix.ToString("MMM")</div>
                        </div>
                        <div class="grsh-card-info">
                            <div class="grsh-card-title">@g.Bashliq</div>
                            <div class="grsh-card-meta">
                                <span>@g.BaslamaSaati.ToString(@"hh\:mm")@(g.BitisSaati.HasValue ? " — " + g.BitisSaati.Value.ToString(@"hh\:mm") : "")</span>
                                @if (!string.IsNullOrEmpty(g.Yer))
                                {
                                    <span>📍 @g.Yer</span>
                                }
                                <span>👥 @g.IshtirakciSayi nəfər</span>
                            </div>
                        </div>
                        <span class="grsh-status @g.HesablanmisStatusClass">@g.HesablanmisStatusText</span>
                    </a>
                }
            </div>
            <div class="grsh-no-result" id="noResultTeshkil">Nəticə tapılmadı</div>
        }
    </div>

</div>

@section Scripts {
    <script>
        let activeFilter = 'all';
        let searchTerm = '';

        function applyFilter() {
            const activePanel = document.querySelector('.grsh-panel:not(.grsh-hidden)');
            if (!activePanel) return;
            const cards = activePanel.querySelectorAll('.grsh-card');
            let visible = 0;
            cards.forEach(card => {
                const matchSearch = !searchTerm || card.dataset.search.includes(searchTerm);
                const matchFilter = activeFilter === 'all' || card.dataset.status === activeFilter;
                const show = matchSearch && matchFilter;
                card.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            const noResult = activePanel.querySelector('.grsh-no-result');
            if (noResult) noResult.style.display = visible === 0 ? 'block' : 'none';
        }

        document.getElementById('grshSearch').addEventListener('input', function () {
            searchTerm = this.value.trim().toLowerCase();
            applyFilter();
        });

        document.querySelectorAll('.grsh-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                document.querySelectorAll('.grsh-chip').forEach(c => c.classList.remove('active'));
                chip.classList.add('active');
                activeFilter = chip.dataset.filter;
                applyFilter();
            });
        });

        document.querySelectorAll('.grsh-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                const target = btn.dataset.tab;
                document.querySelectorAll('.grsh-tab').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                document.querySelectorAll('.grsh-panel').forEach(p => {
                    p.classList.toggle('grsh-hidden', p.dataset.panel !== target);
                });
                history.replaceState(null, '', `?tab=${target}`);
                applyFilter();
            });
        });
    </script>
}
