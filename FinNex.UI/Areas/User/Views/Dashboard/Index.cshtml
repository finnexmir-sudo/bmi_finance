@model FinNex.UI.Areas.User.Models.UserDashboardViewModel
@using FinNex.Application.DTOs.HR.Dashboard
@using FinNex.Domain.Entities.HR
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = Model.VezifeAdi;

    string DavClass(DavamiyyetStatus status, bool geleceK, bool hefteSonu) =>
        hefteSonu ? "fn-ad--weekend" :
        geleceK ? "fn-ad--future" :
        status switch
        {
            DavamiyyetStatus.Isde => "fn-ad--present",
            DavamiyyetStatus.Gecikme => "fn-ad--late",
            DavamiyyetStatus.Qayib => "fn-ad--absent",
            DavamiyyetStatus.Icazeli => "fn-ad--leave",
            _ => "fn-ad--future"
        };

    string MaasStatusClass(MaasStatus s) => s switch
    {
        MaasStatus.Odenildi => "fn-badge--done",
        MaasStatus.Tesdiqlendi => "fn-badge--review",
        MaasStatus.Layihe => "fn-badge--wait",
        MaasStatus.LegvEdildi => "fn-badge--rejected",
        _ => "fn-badge--wait"
    };

    string MaasStatusText(MaasStatus s) => s switch
    {
        MaasStatus.Odenildi => "Ödənildi",
        MaasStatus.Tesdiqlendi => "Təsdiqləndi",
        MaasStatus.Layihe => "Hazırlanır",
        MaasStatus.LegvEdildi => "Ləğv edildi",
        _ => "-"
    };

    string MuracietBadgeClass(MezuniyyetStatus s) => s switch
    {
        MezuniyyetStatus.Gozlemede => "fn-badge--wait",
        MezuniyyetStatus.SobeReisiTesdiqinde => "fn-badge--review",
        MezuniyyetStatus.RehberTesdiqinde => "fn-badge--review",
        MezuniyyetStatus.HrTesdiqinde => "fn-badge--review",
        MezuniyyetStatus.Tesdiqlenib => "fn-badge--done",
        MezuniyyetStatus.ImtinaEdildi => "fn-badge--rejected",
        _ => "fn-badge--wait"
    };

    string MuracietBadgeClass2(IcazeStatus s) => s switch
    {
        IcazeStatus.Gozlemede => "fn-badge--wait",
        IcazeStatus.SobeReisiTesdiqinde => "fn-badge--review",
        IcazeStatus.RehberTesdiqinde => "fn-badge--review",
        IcazeStatus.HrTesdiqinde => "fn-badge--review",
        IcazeStatus.Tesdiqlenib => "fn-badge--done",
        IcazeStatus.ImtinaEdildi => "fn-badge--rejected",
        _ => "fn-badge--wait"
    };

    string BildiriDot(BildiriNovu nov) => nov switch
    {
        BildiriNovu.Ugur => "#1e9b6b",
        BildiriNovu.Xeberdarliq => "#e8b84b",
        BildiriNovu.Tehlike => "#d85a30",
        BildiriNovu.Melumat => "#2d6cdf",
        _ => "#8a93a8"
    };
}

<div class="fn-dashboard">

    @* ── Greeting ── *@
    <div class="fn-greeting-bar">
        <div>
            <div class="fn-greeting-title">Xoş gəldin, @Model.TamAd</div>
            <div class="fn-greeting-sub">
                @Model.SobeAdi · @Model.VezifeAdi · @Model.IsStaji il staj
            </div>
        </div>
        <div class="fn-date-pill">@DateTime.Now.ToString("MMMM yyyy")</div>
    </div>

    @* ── 2 sütunlu grid ── *@
    <div class="fn-grid2">

        @* ── Davamiyyət təqvimi ── *@
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">
                    Davamiyyət — @DateTime.Now.ToString("MMMM yyyy")
                </div>
                <a asp-area="User" asp-controller="Davamiyyet" asp-action="Index"
                   class="fn-card-link">Tam bax →</a>
            </div>

            <div class="fn-att-grid">
                <div class="fn-ad fn-ad--hdr">B.e</div>
                <div class="fn-ad fn-ad--hdr">Ç.a</div>
                <div class="fn-ad fn-ad--hdr">Ç</div>
                <div class="fn-ad fn-ad--hdr">C.a</div>
                <div class="fn-ad fn-ad--hdr">C</div>
                <div class="fn-ad fn-ad--hdr">Ş</div>
                <div class="fn-ad fn-ad--hdr">B</div>

                @{
                    var buIl = DateTime.Now.Year;
                    var buAy = DateTime.Now.Month;
                    var ilkGun = new DateTime(buIl, buAy, 1);
                    var boshGun = (int)ilkGun.DayOfWeek == 0 ? 6 : (int)ilkGun.DayOfWeek - 1;
                    for (int b = 0; b < boshGun; b++)
                    {
                        <div class="fn-ad fn-ad--empty"></div>
                    }
                }

                @foreach (var g in Model.DavamiyyetTakvim)
                {
                    <div class="fn-ad @DavClass(g.Status, g.Gələcek, g.HefteSonu)"
                         title="@g.Tarix.ToString("dd MMMM") — @g.Status">
                        @g.Gun
                    </div>
                }
            </div>

            <div class="fn-att-stats">
                <div class="fn-as">
                    <div class="fn-as-val" style="color:#1e9b6b">@Model.IslenanGun</div>
                    <div class="fn-as-lbl">İşlədi</div>
                </div>
                <div class="fn-as">
                    <div class="fn-as-val" style="color:#c0392b">@Model.QaibGun</div>
                    <div class="fn-as-lbl">Qayıb</div>
                </div>
                <div class="fn-as">
                    <div class="fn-as-val" style="color:#b8860b">@Model.IcazeliGun</div>
                    <div class="fn-as-lbl">İcazəli</div>
                </div>
                <div class="fn-as">
                    <div class="fn-as-val" style="color:#aab0bf">@Model.GozlenilenGun</div>
                    <div class="fn-as-lbl">Gözlənilir</div>
                </div>
            </div>
        </div>

        @* ── Bildirişlər ── *@
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Bildirişlər</div>
                <a asp-area="User" asp-controller="Bildiri" asp-action="Index"
                   class="fn-card-link">Hamısı →</a>
            </div>

            @if (Model.Bildiriler.Any())
            {
                <div class="fn-nlist">
                    @foreach (var b in Model.Bildiriler)
                    {
                        <div class="fn-nitem">
                            <div class="fn-ndot" style="background:@BildiriDot(b.Nov)"></div>
                            <div>
                                <div class="fn-ntext">@b.Metn</div>
                                <div class="fn-ntime">@b.TarixAd</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="fn-empty">Bildiriş yoxdur</div>
            }
        </div>

        @* ── Son ödənişlər ── *@
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Son ödənişlər</div>
                <a asp-area="User" asp-controller="Odenis" asp-action="Index"
                   class="fn-card-link">Hamısı →</a>
            </div>

            @if (Model.SonOdenisler.Any())
            {
                <div class="fn-plist">
                    @foreach (var p in Model.SonOdenisler)
                    {
                        <div class="fn-pi">
                            <div class="fn-pi-left">
                                <div class="fn-pi-name">@p.AyAd</div>
                                <div class="fn-pi-date">@p.Il / @p.Ay</div>
                            </div>
                            <div class="fn-pi-right">
                                <div class="fn-pi-amount">@p.NetMebleg.ToString("N0") ₼</div>
                                <span class="fn-badge @MaasStatusClass(p.Status)">
                                    @MaasStatusText(p.Status)
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="fn-empty">Ödəniş məlumatı yoxdur</div>
            }
        </div>

        @* ── Məzuniyyət qalığı ── *@
        <div class="fn-card">
            <div class="fn-card-head">
                <div class="fn-card-title">Məzuniyyət qalığı</div>
                <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
                   class="fn-card-link">Müraciət →</a>
            </div>

            <div class="fn-lb-list">
                <div class="fn-lb">
                    <div class="fn-lb-top">
                        <span class="fn-lb-name">İllik məzuniyyət</span>
                        <span class="fn-lb-val">
                            @Model.IllikQaligGun / @Model.IllikToplamGun gün
                        </span>
                    </div>
                    <div class="fn-lb-track">
                        <div class="fn-lb-fill"
                             style="width:@(Model.IllikToplamGun > 0
                                                             ? (int)((double)Model.IllikQaligGun / Model.IllikToplamGun * 100)
                                                             : 0)%;background:#1e9b6b">
                        </div>
                    </div>
                </div>

                <div class="fn-lb">
                    <div class="fn-lb-top">
                        <span class="fn-lb-name">Xəstəlik məzuniyyəti</span>
                        <span class="fn-lb-val">
                            @Model.XestelikQaligGun / @Model.XestelikToplamGun gün
                        </span>
                    </div>
                    <div class="fn-lb-track">
                        <div class="fn-lb-fill"
                             style="width:@(Model.XestelikToplamGun > 0
                                                             ? (int)((double)Model.XestelikQaligGun / Model.XestelikToplamGun * 100)
                                                             : 0)%;background:#2d6cdf">
                        </div>
                    </div>
                </div>

                <div class="fn-lb">
                    <div class="fn-lb-top">
                        <span class="fn-lb-name">Ezamiyyət</span>
                        <span class="fn-lb-val">
                            @Model.EzamiyyetQaligGun / @Model.EzamiyyetToplamGun gün
                        </span>
                    </div>
                    <div class="fn-lb-track">
                        <div class="fn-lb-fill"
                             style="width:@(Model.EzamiyyetToplamGun > 0
                                                             ? (int)((double)Model.EzamiyyetQaligGun / Model.EzamiyyetToplamGun * 100)
                                                             : 0)%;background:#e8b84b">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Aktiv müraciətlər (tam en) ── *@
        <div class="fn-card fn-card--full">
            <div class="fn-card-head">
                <div class="fn-card-title">Aktiv müraciətlər</div>
                <a asp-area="User" asp-controller="Muraciet" asp-action="Index"
                   class="fn-card-link">Hamısı →</a>
            </div>

            @if (!Model.AktivMuracietler.Any() && !Model.AktivIcazeler.Any())
            {
                <div class="fn-empty">Aktiv müraciət yoxdur</div>
            }
            else
            {
                <div class="fn-rlist">
                    @* Məzuniyyət müraciətləri *@
                    @foreach (var r in Model.AktivMuracietler)
                    {
                        <div class="fn-ri">
                            <div class="fn-ri-ico fn-ri-ico--@r.Nov.ToString().ToLower()">
                                @if (r.Nov == MezuniyyetNovu.Illik)
                                {
                                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                        <rect x="1" y="1.5" width="11" height="10" rx="1.5" stroke="#2d6cdf" stroke-width="1.1" />
                                        <path d="M1 4.5h11M4.5 1.5v2M8.5 1.5v2" stroke="#2d6cdf" stroke-width="1" stroke-linecap="round" />
                                    </svg>
                                }
                                else if (r.Nov == MezuniyyetNovu.Xestelik)
                                {
                                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                        <circle cx="6.5" cy="6.5" r="5" stroke="#d85a30" stroke-width="1.1" />
                                        <path d="M6.5 4v3M6.5 8.5v.5" stroke="#d85a30" stroke-width="1.1" stroke-linecap="round" />
                                    </svg>
                                }
                                else
                                {
                                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                        <path d="M2 2h7l2 2v7H2V2z" stroke="#1e9b6b" stroke-width="1.1" />
                                        <path d="M4 6h5M4 8h3" stroke="#1e9b6b" stroke-width="1" stroke-linecap="round" />
                                    </svg>
                                }
                            </div>
                            <div class="fn-ri-info">
                                <div class="fn-ri-name">
                                    @r.NovAd —
                                    @r.BaslamaTarixi.ToString("dd.MM") –
                                    @r.BitmeTarixi.ToString("dd.MM.yyyy")
                                    (@r.IsGunlerininSayi iş günü)
                                </div>
                                <div class="fn-ri-date">
                                    @r.WorkflowMerhele
                                    @if (!string.IsNullOrEmpty(r.EvezEdenAdSoyad))
                                    {
                                        <span class="fn-ri-evez">· Əvəzedici: @r.EvezEdenAdSoyad</span>
                                    }
                                </div>
                            </div>
                            <span class="fn-badge @MuracietBadgeClass(r.Status)">
                                @r.WorkflowMerhele
                            </span>
                        </div>
                    }

                    @* İcazə müraciətləri *@
                    @foreach (var ic in Model.AktivIcazeler)
                    {
                        <div class="fn-ri">
                            <div class="fn-ri-ico" style="background:#f3effe">
                                <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                    <circle cx="6.5" cy="6.5" r="5" stroke="#7c5cbf" stroke-width="1.1" />
                                    <path d="M6.5 4v3.5l2 1.5" stroke="#7c5cbf" stroke-width="1.1" stroke-linecap="round" />
                                </svg>
                            </div>
                            <div class="fn-ri-info">
                                <div class="fn-ri-name">
                                    Saatlıq icazə —
                                    @ic.IcazeTarixi.ToString("dd.MM.yyyy")
                                    (@ic.BaslamaSaati.ToString(@"hh\:mm") – @ic.BitisSaati.ToString(@"hh\:mm") · @ic.IcazeSaati.ToString("F1") saat)
                                </div>
                                <div class="fn-ri-date">
                                    @ic.WorkflowMerhele
                                    @if (!string.IsNullOrEmpty(ic.EvezEdenAdSoyad))
                                    {
                                        <span class="fn-ri-evez">· Əvəzedici: @ic.EvezEdenAdSoyad</span>
                                    }
                                </div>
                            </div>
                            <span class="fn-badge @MuracietBadgeClass2(ic.Status)">
                                @ic.WorkflowMerhele
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>
    