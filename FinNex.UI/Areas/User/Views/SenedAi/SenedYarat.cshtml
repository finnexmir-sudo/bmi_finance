@{
    ViewData["Title"] = "Ağıllı OCR Sənəd Mərkəzi";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/sened-ai.css" asp-append-version="true" />
}

<div class="sa-page">
    <div class="sa-header">
        <div class="sa-header-icon blue"><i class="bi bi-file-earmark-text"></i></div>
        <div>
            <h4 class="sa-title">Ağıllı OCR Sənəd Mərkəzi</h4>
            <p class="sa-subtitle">Şəkil / PDF yüklə, parametrləri daxil et, sərbəst mövzu yaz ya da mövcud mətni rəsmi dildə tərcümə et.</p>
        </div>
    </div>

    <div class="row g-3">
        <!-- ── Sol panel: forma ──────────────────────────────────────── -->
        <div class="col-xl-6 col-lg-6">
            <div class="sa-card sa-form-card">

                <!-- BLOK 1: Parametrik forma -->
                <div class="sk-block-label">
                    <i class="bi bi-sliders2"></i> Parametrik Sənəd
                </div>

                <div class="sa-form-group">
                    <label class="sa-label">Sənəd növü</label>
                    <select id="senedNovu" class="sa-select">
                        <option value="Gecikmiş Kredit Xəbərdarlığı">Gecikmiş Kredit Xəbərdarlığı</option>
                        <option value="Son Xəbərdarlıq Məktubu">Son Xəbərdarlıq Məktubu</option>
                        <option value="Kredit Borcunun Ödənilməsi Haqqında Bildiriş">Kredit Borcu Bildirişi</option>
                        <option value="Girov Aktivinə Dair Bildiriş">Girov Aktivinə Dair Bildiriş</option>
                        <option value="Müqavilənin Ləğvi Barədə Xəbərdarlıq">Müqavilənin Ləğvi Xəbərdarlığı</option>
                        <option value="Faiz Borcunun Ödənişi Haqqında">Faiz Borcu Bildirişi</option>
                        <option value="Xüsusi">Xüsusi (öz növünü yazın)</option>
                    </select>
                    <input type="text" id="senedNovuCustom" class="sa-input mt-2"
                           placeholder="Xüsusi sənəd növünü yazın..." style="display:none">
                </div>

                <div class="sa-form-group">
                    <label class="sa-label">Müştəri / əlaqədar şəxs adı</label>
                    <input type="text" id="musteriAd" class="sa-input" placeholder="məs: Əli Həsənov">
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <div class="sa-form-group">
                            <label class="sa-label">Gecikmiş gün</label>
                            <input type="number" id="gecikmeGun" class="sa-input" value="30" min="1">
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="sa-form-group">
                            <label class="sa-label">Məbləğ (AZN)</label>
                            <input type="number" id="meble" class="sa-input" value="0" min="0" step="0.01">
                        </div>
                    </div>
                </div>

                <div class="sa-form-group">
                    <label class="sa-label">Əlavə məlumat <span class="sa-optional">(ixtiyari)</span></label>
                    <textarea id="elaveMelumat" class="sa-textarea" rows="2"
                              placeholder="Müqavilə nömrəsi, xüsusi şərtlər..."></textarea>
                </div>

                <!-- ── OR Separator ──────────────────────────────── -->
                <div class="or-separator"><span>və ya</span></div>

                <!-- BLOK 2: AI Rejimi (OCR + Sərbəst + Tərcümə) -->
                <div class="ai-free-mode-container">

                    <div class="sk-block-label sk-block-label--ai">
                        <i class="bi bi-cpu"></i> AI Rejimi
                    </div>

                    <!-- OCR Drop Zone -->
                    <div class="sa-form-group">
                        <label class="sa-label">
                            <i class="bi bi-file-earmark-image"></i> Şəkil / Sənəd OCR
                            <span class="sa-optional">(JPG, PNG, PDF)</span>
                        </label>

                        <div class="sa-ocr-zone" id="ocrZone"
                             onclick="document.getElementById('ocrFileInput').click()"
                             ondragover="ocrDragOver(event)"
                             ondragleave="ocrDragLeave(event)"
                             ondrop="ocrDrop(event)">
                            <input type="file" id="ocrFileInput" accept=".jpg,.jpeg,.png,.pdf"
                                   style="display:none" onchange="onOcrFileSelect(this)">
                            <i class="bi bi-cloud-arrow-up sa-ocr-icon"></i>
                            <div class="sa-ocr-text">Sürüşdür & Burax və ya Seç</div>
                            <div class="sa-ocr-hint">JPG · PNG · PDF — maks. 10 MB</div>
                        </div>

                        <div id="ocrProgress" class="sa-ocr-progress" style="display:none">
                            <div class="sa-ocr-spinner"></div>
                            <span id="ocrProgressText">AI sənədi skanerlayır...</span>
                            <div class="sa-ocr-pbar"><div id="ocrPbarFill" class="sa-ocr-pbar-fill"></div></div>
                        </div>

                        <div id="ocrResult" class="sa-ocr-result" style="display:none">
                            <i class="bi bi-check-circle-fill"></i>
                            <span id="ocrFileName" class="sa-ocr-filename"></span>
                            <button type="button" class="sa-ocr-clear" onclick="clearOcr()" title="Təmizlə">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Serbest Movzu -->
                    <div class="sa-form-group">
                        <label class="sa-label">
                            Sərbəst Mövzu
                            <span class="sa-optional">(parametrləri əvəz edir)</span>
                        </label>
                        <textarea id="senedMovzusu" class="sa-textarea sa-textarea-prompt" rows="3"
                                  placeholder="Məs: İşçinin intizamsızlığa görə töhmət alması üçün rəsmi əmr hazırlat..."
                                  oninput="updateBtn()"></textarea>
                    </div>

                    <!-- Tercume -->
                    <div class="sa-tercume-box">
                        <div class="sa-switch-row">
                            <div>
                                <div class="sa-switch-label">
                                    <i class="bi bi-translate"></i> Peşəkar Tərcümə Rejimi
                                </div>
                                <div class="sa-switch-hint">Bank-hüquq terminologiyası ilə rəsmi tərcümə</div>
                            </div>
                            <label class="sa-toggle">
                                <input type="checkbox" id="tercumeSwitch" onchange="onTercumeChange()">
                                <span class="sa-toggle-slider"></span>
                            </label>
                        </div>

                        <div id="tercumeOptions" class="sa-tercume-options" style="display:none">
                            <label class="sa-label">Hədəf dil</label>
                            <select id="hedafDil" class="sa-select" onchange="updateBtn()">
                                <option value="İngilis dili">🇬🇧 İngilis dili</option>
                                <option value="Rus dili">🇷🇺 Rus dili</option>
                                <option value="Azərbaycan dili">🇦🇿 Azərbaycan dili</option>
                                <option value="Fars dili">🇮🇷 Fars dili</option>
                            </select>
                        </div>
                    </div>
                </div>
                <!-- /ai-free-mode-container -->

                <button class="sa-btn sa-btn-primary w-100 sk-main-btn" id="yaratBtn" onclick="startYarat()">
                    <i id="yaratBtnIcon" class="bi bi-file-earmark-text"></i>
                    <span id="yaratBtnText">Sənədi Yarat</span>
                </button>
            </div>
        </div>

        <!-- ── Sağ panel: nəticə ─────────────────────────────────── -->
        <div class="col-xl-6 col-lg-6">
            <div class="sa-card sa-result-card" id="resultCard" style="display:none">
                <div class="sa-result-header sa-result-header--sticky">
                    <h6 class="sa-section-title mb-0">Yaradılan Sənəd</h6>
                    <div class="sa-result-actions">
                        <button class="sa-btn sa-btn-sm" onclick="copyContent()">
                            <i class="bi bi-clipboard"></i> Kopyala
                        </button>
                        <button class="sa-btn sa-btn-sm" onclick="printContent()">
                            <i class="bi bi-printer"></i> Çap et
                        </button>
                        <button class="sa-btn sa-btn-sm sa-btn-word" id="wordBtn" onclick="exportWord()">
                            <i class="bi bi-file-word"></i> Word (.docx)
                        </button>
                    </div>
                </div>

                <!-- Bank blank seçimi -->
                <div class="sa-bank-blank-row">
                    <label class="sa-bank-blank-label">
                        <input type="checkbox" id="bankBlankSwitch" class="sa-bank-blank-check">
                        <i class="bi bi-building"></i>
                        Rəsmi Bank Blankında Endir
                    </label>
                    <span class="sa-bank-blank-hint">Bank Melli İran — rəsmi sənəd blankı</span>
                </div>

                <pre id="generatedContent" class="sa-generated-text"></pre>
                <div id="generatedHtml" class="sa-generated-html" style="display:none"></div>
            </div>

            <div id="loadingCard" style="display:none" class="sa-card sa-loading">
                <div class="sa-spinner"></div>
                <p id="loadingText">AI sənədi hazırlayır...</p>
            </div>

            <div class="sa-card sa-placeholder-card" id="placeholderCard">
                <i class="bi bi-file-earmark-plus sa-placeholder-icon"></i>
                <p>Parametrləri daxil edib düyməni basın</p>
                <p class="sa-placeholder-hint">və ya şəkil / PDF yükləyin</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // RTL dillər
    var RTL_LANGS = ['Fars dili', 'Ərəb dili'];

    var currentIsHtml  = false;
    var currentContent = '';
    var currentTitle   = '';

    document.getElementById('senedNovu').addEventListener('change', function () {
        document.getElementById('senedNovuCustom').style.display = this.value === 'Xüsusi' ? '' : 'none';
        updateBtn();
    });

    // ── Düymə sinxronizasiyası ────────────────────────────────────────────────
    function updateBtn() {
        var tercume = document.getElementById('tercumeSwitch').checked;
        var serbest = document.getElementById('senedMovzusu').value.trim() !== '';
        var iconEl  = document.getElementById('yaratBtnIcon');
        var textEl  = document.getElementById('yaratBtnText');

        if (tercume) {
            iconEl.className = 'bi bi-translate';
            textEl.textContent = 'Tərcümə Et';
        } else if (serbest) {
            iconEl.className = 'bi bi-magic';
            textEl.textContent = 'AI ilə Sənəd Yarat';
        } else {
            iconEl.className = 'bi bi-file-earmark-text';
            textEl.textContent = 'Sənədi Yarat';
        }
    }

    function onTercumeChange() {
        var on = document.getElementById('tercumeSwitch').checked;
        document.getElementById('tercumeOptions').style.display = on ? '' : 'none';
        updateBtn();
    }

    // ── RTL ──────────────────────────────────────────────────────────────────
    function applyRtl(lang) {
        var isRtl = RTL_LANGS.indexOf(lang) !== -1;
        var dir   = isRtl ? 'rtl' : 'ltr';
        var align = isRtl ? 'right' : 'left';
        ['generatedContent', 'generatedHtml'].forEach(function (id) {
            var el = document.getElementById(id);
            el.style.direction = dir;
            el.style.textAlign = align;
        });
    }

    // ── OCR Drop Zone ─────────────────────────────────────────────────────────
    function ocrDragOver(e) {
        e.preventDefault();
        document.getElementById('ocrZone').classList.add('drag-over');
    }
    function ocrDragLeave(e) {
        document.getElementById('ocrZone').classList.remove('drag-over');
    }
    function ocrDrop(e) {
        e.preventDefault();
        document.getElementById('ocrZone').classList.remove('drag-over');
        var file = e.dataTransfer.files[0];
        if (file) processOcrFile(file);
    }
    function onOcrFileSelect(input) {
        if (input.files[0]) processOcrFile(input.files[0]);
    }

    async function processOcrFile(file) {
        var allowed = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
        if (!allowed.includes(file.type) && !file.name.match(/\.(jpg|jpeg|png|pdf)$/i)) {
            alert('Yalnız JPG, PNG və ya PDF fayllar qəbul edilir.');
            return;
        }
        if (file.size > 10 * 1024 * 1024) {
            alert('Fayl 10MB-dan böyük ola bilməz.');
            return;
        }

        document.getElementById('ocrZone').style.display     = 'none';
        document.getElementById('ocrResult').style.display   = 'none';
        document.getElementById('ocrProgress').style.display = '';

        // Fake progress animation
        var fill = document.getElementById('ocrPbarFill');
        var pct = 0;
        var timer = setInterval(function () {
            pct = Math.min(pct + Math.random() * 12, 85);
            fill.style.width = pct + '%';
        }, 300);

        var formData = new FormData();
        formData.append('fayl', file);
        var tercume  = document.getElementById('tercumeSwitch').checked;
        var hedafDil = document.getElementById('hedafDil').value;
        formData.append('tercumeEdilsinmi', tercume.toString());
        formData.append('hedafDil', hedafDil);

        try {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            var resp = await fetch('@Url.Action("OcrFayl", "SenedAi", new { area = "User" })', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });
            var data = await resp.json();

            clearInterval(timer);
            fill.style.width = '100%';
            await new Promise(r => setTimeout(r, 300));

            document.getElementById('ocrProgress').style.display = 'none';

            if (!data.ok) {
                alert('OCR xətası: ' + data.xeta);
                document.getElementById('ocrZone').style.display = '';
                return;
            }

            // Show success badge
            document.getElementById('ocrFileName').textContent = file.name;
            document.getElementById('ocrResult').style.display = '';

            // Fill textarea
            document.getElementById('senedMovzusu').value = data.isHtml
                ? document.createElement('div').appendChild(Object.assign(document.createElement('div'), { innerHTML: data.text })).innerText
                : data.text;
            updateBtn();

            // Show in preview panel
            showResult(data.text, data.isHtml, file.name.replace(/\.[^.]+$/, ''));
            applyRtl(hedafDil);

        } catch (e) {
            clearInterval(timer);
            document.getElementById('ocrProgress').style.display = 'none';
            document.getElementById('ocrZone').style.display = '';
            alert('Şəbəkə xətası baş verdi.');
        }
    }

    function clearOcr() {
        document.getElementById('ocrFileInput').value = '';
        document.getElementById('ocrResult').style.display   = 'none';
        document.getElementById('ocrZone').style.display     = '';
        document.getElementById('senedMovzusu').value = '';
        document.getElementById('ocrPbarFill').style.width = '0%';
        updateBtn();
        document.getElementById('resultCard').style.display     = 'none';
        document.getElementById('placeholderCard').style.display = '';
    }

    function showResult(content, isHtml, title) {
        currentContent = content;
        currentIsHtml  = isHtml;
        currentTitle   = (title || 'Sened').replace(/\s+/g, '_');

        var preEl  = document.getElementById('generatedContent');
        var htmlEl = document.getElementById('generatedHtml');

        if (isHtml) {
            preEl.style.display  = 'none';
            htmlEl.innerHTML     = content;
            htmlEl.style.display = '';
        } else {
            htmlEl.style.display = 'none';
            preEl.textContent    = content;
            preEl.style.display  = '';
        }
        document.getElementById('placeholderCard').style.display = 'none';
        document.getElementById('loadingCard').style.display     = 'none';
        document.getElementById('resultCard').style.display      = '';
    }

    // ── Əsas sorğu ───────────────────────────────────────────────────────────
    async function startYarat() {
        var senedNovuEl   = document.getElementById('senedNovu');
        var senedNovu     = senedNovuEl.value === 'Xüsusi'
                            ? document.getElementById('senedNovuCustom').value.trim()
                            : senedNovuEl.value;
        var musteriAd        = document.getElementById('musteriAd').value.trim();
        var gecikmeGun       = parseInt(document.getElementById('gecikmeGun').value)  || 0;
        var meble            = parseFloat(document.getElementById('meble').value)     || 0;
        var elaveMelumat     = document.getElementById('elaveMelumat').value.trim();
        var senedMovzusu     = document.getElementById('senedMovzusu').value.trim();
        var tercumeEdilsinmi = document.getElementById('tercumeSwitch').checked;
        var hedafDil         = document.getElementById('hedafDil').value;

        if (!senedNovu && !musteriAd && !senedMovzusu) {
            alert('Sənəd parametrləri (növ + müştəri) VƏ ya sərbəst mövzu daxil edin.');
            return;
        }

        document.getElementById('resultCard').style.display      = 'none';
        document.getElementById('placeholderCard').style.display = 'none';
        document.getElementById('loadingCard').style.display     = '';
        document.getElementById('loadingText').textContent       = tercumeEdilsinmi ? 'AI tərcümə edir...' : 'AI sənədi hazırlayır...';
        document.getElementById('yaratBtn').disabled = true;

        var params = new URLSearchParams({
            senedNovu, musteriAd,
            gecikmeGun: gecikmeGun.toString(),
            meble: meble.toString(),
            elaveMelumat, senedMovzusu,
            tercumeEdilsinmi: tercumeEdilsinmi.toString(),
            hedafDil
        });

        try {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            var resp = await fetch('@Url.Action("SenedYaratPost", "SenedAi", new { area = "User" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: params.toString()
            });
            var data = await resp.json();

            document.getElementById('loadingCard').style.display = 'none';
            document.getElementById('yaratBtn').disabled = false;

            if (!data.ok) {
                alert('Xəta: ' + data.xeta);
                document.getElementById('placeholderCard').style.display = '';
                return;
            }

            var title = tercumeEdilsinmi
                ? ('Tercume_' + hedafDil.replace(' dili', '') + '_' + new Date().toISOString().slice(0, 10))
                : (senedNovu || senedMovzusu.substring(0, 30)).replace(/\s+/g, '_');

            showResult(data.content, data.isHtml, title);
            applyRtl(hedafDil);

        } catch (e) {
            document.getElementById('loadingCard').style.display     = 'none';
            document.getElementById('placeholderCard').style.display = '';
            document.getElementById('yaratBtn').disabled = false;
            alert('Şəbəkə xətası baş verdi.');
        }
    }

    // ── Köməkçi əməliyyatlar ──────────────────────────────────────────────────
    function copyContent() {
        var text = currentIsHtml
            ? document.getElementById('generatedHtml').innerText
            : document.getElementById('generatedContent').textContent;
        navigator.clipboard.writeText(text).then(function () {
            var btn = event.currentTarget;
            btn.innerHTML = '<i class="bi bi-check"></i> Kopyalandı';
            setTimeout(function () { btn.innerHTML = '<i class="bi bi-clipboard"></i> Kopyala'; }, 2000);
        });
    }

    function printContent() {
        var isRtl  = RTL_LANGS.indexOf(document.getElementById('hedafDil').value) !== -1;
        var dirCss = isRtl ? 'direction:rtl;text-align:right;' : '';
        var html   = currentIsHtml
            ? '<div style="font-family:serif;font-size:14px;padding:40px;' + dirCss + '">' + currentContent + '</div>'
            : '<pre style="font-family:serif;font-size:14px;padding:40px;white-space:pre-wrap;' + dirCss + '">' + escHtml(currentContent) + '</pre>';
        var w = window.open('', '_blank');
        w.document.write(html);
        w.document.close();
        w.print();
    }

    async function exportWord() {
        var btn = document.getElementById('wordBtn');
        btn.disabled = true;
        var bankBlank = document.getElementById('bankBlankSwitch').checked;
        btn.innerHTML = bankBlank
            ? '<i class="bi bi-hourglass-split"></i> Blank hazırlanır...'
            : '<i class="bi bi-hourglass-split"></i> Hazırlanır...';
        try {
            var token  = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            var params = new URLSearchParams({
                content: currentContent,
                isHtml: currentIsHtml.toString(),
                docTitle: currentTitle,
                istifadeEdilsinmiBankBlank: bankBlank.toString()
            });
            var resp = await fetch('@Url.Action("ExportToWord", "SenedAi", new { area = "User" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: params.toString()
            });
            if (!resp.ok) { alert('Word ixracı uğursuz oldu.'); return; }
            var blob = await resp.blob();
            var url  = URL.createObjectURL(blob);
            var a    = document.createElement('a');
            a.href   = url;
            a.download = currentTitle + '.docx';
            a.click();
            URL.revokeObjectURL(url);
        } finally {
            btn.disabled  = false;
            btn.innerHTML = '<i class="bi bi-file-word"></i> Word (.docx)';
        }
    }

    function escHtml(s) {
        return (s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>
}
