@model FinNex.UI.Areas.User.ViewModels.Mezuniyyet.MezuniyyetDetailVM
@{
    ViewData["Title"] = "Müraciət Detayı";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole(RoleNames.Operator) ? RoleNames.Operator : "";

    // Geriyə qeyd: HR normal axını atlamaqla birbaşa qeyd etdiyi müraciət.
    // İşçiyə saxta workflow göstərməyək — xüsusi banner kifayət edir.
    var isGeriyeQeyd = !string.IsNullOrEmpty(Model.Qeyd)
                      && Model.Qeyd.StartsWith("[Geriyə qeyd");
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müraciət detayı</div>
            <div class="fn-page-sub">@Model.NovText · @Model.BaslamaTarixi.ToString("dd.MM.yyyy") – @Model.BitmeTarixi.ToString("dd.MM.yyyy")</div>
        </div>
        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
           class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-detail-layout">

        @* ── Sol: detay məlumatlar ── *@
        <div>

            @* Status kartı *@
            <div class="fn-card fn-detail-status-card">
                <div class="fn-dsc-left">
                    <div class="fn-dsc-nov">@Model.NovText</div>
                    <div class="fn-dsc-dates">
                        @Model.BaslamaTarixi.ToString("dd MMMM yyyy") —
                        @Model.BitmeTarixi.ToString("dd MMMM yyyy")
                    </div>
                    <div class="fn-dsc-days">@Model.IsGunlerininSayi iş günü</div>
                </div>
                <div class="fn-dsc-right">
                    <span class="fn-badge fn-badge--lg @Model.BadgeClass">@Model.StatusText</span>
                </div>
            </div>

            @* Geriyə qeyd — HR tərəfindən rəsmiləşdirilib, workflow göstərilmir *@
            @if (isGeriyeQeyd)
            {
                <div class="fn-card" style="border-left:4px solid #1e9b6b;padding:16px 18px;">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <div style="width:40px;height:40px;border-radius:50%;background:#d1fae5;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                <circle cx="12" cy="12" r="9" stroke="#065f46" stroke-width="1.5" />
                                <path d="M8 12l3 3 5-6" stroke="#065f46" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <div>
                            <div style="font-size:14px;font-weight:700;color:#065f46;">
                                HR tərəfindən rəsmiləşdirilib
                            </div>
                            <div style="font-size:12.5px;color:#3d4557;margin-top:3px;line-height:1.5;">
                                Bu məzuniyyət HR tərəfindən keçmiş tarixlər üçün qeyd edildi —
                                təsdiq axını keçmədi.
                                @if (Model.HrTesdiqTarixi.HasValue)
                                {
                                    <span>Qeyd tarixi: @Model.HrTesdiqTarixi.Value.ToString("dd.MM.yyyy HH:mm").</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            @* Workflow xətti — normal müraciətlər üçün *@
            else if (!Model.ImtinaEdildi)
            {
                <div class="fn-card fn-workflow-card">
                    <div class="fn-card-title" style="margin-bottom:16px">Müraciət gedişatı</div>
                    <div class="fn-workflow-track">

                        @* Addım 0: Müraciət *@
                        <div class="fn-wt-step @(Model.WorkflowAddim >= 0 ? "fn-wt-step--done" : "")
                                               @(Model.WorkflowAddim == 0 ? "fn-wt-step--active" : "")">
                            <div class="fn-wt-circle">
                                @if (Model.WorkflowAddim >= 1)
                                {
                                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                        <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                }
                                else { <span>1</span> }
                            </div>
                            <div class="fn-wt-info">
                                <div class="fn-wt-label">Müraciət göndərildi</div>
                                <div class="fn-wt-sub">Sistem tərəfindən qeydə alındı</div>
                            </div>
                        </div>

                        @if (Model.EvezediciSecildi)
                        {
                        <div class="fn-wt-connector @(Model.WorkflowAddim >= 1 ? "fn-wt-connector--done" : "")"></div>
                        <div class="fn-wt-step @(Model.EvezediciTesdiqlenib == true ? "fn-wt-step--done" : "")
                                               @(Model.WorkflowAddim == 0 && Model.EvezediciTesdiqlenib == null ? "fn-wt-step--active" : "")">
                            <div class="fn-wt-circle">
                                @if (Model.EvezediciTesdiqlenib == true) { <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg> }
                                else { <span>2</span> }
                            </div>
                            <div class="fn-wt-info">
                                <div class="fn-wt-label">Əvəzedici</div>
                                <div class="fn-wt-sub">
                                    @if (Model.EvezediciTesdiqlenib == true)
                                    { <span style="color:#1e9b6b">Qəbul edildi</span> }
                                    else if (Model.EvezediciTesdiqlenib == false)
                                    { <span style="color:#c0392b">Rədd edildi</span> }
                                    else
                                    { <span style="color:#c9900a">Gözlənilir...</span> }
                                </div>
                            </div>
                        </div>
                        }

                        @if ((!Model.MuracietSahibiRehberdirmi && !Model.MuracietSahibiSobeReisidirmi) && (Model.SobeReisiTesdiq != null || Model.WorkflowAddim <= 1))
                        {
                        <div class="fn-wt-connector @(Model.WorkflowAddim >= 1 ? "fn-wt-connector--done" : "")"></div>

                        @* Addım 1: Şöbə rəisi *@
                        <div class="fn-wt-step @(Model.WorkflowAddim >= 2 ? "fn-wt-step--done" : "")
                                               @(Model.WorkflowAddim == 1 ? "fn-wt-step--active" : "")">
                            <div class="fn-wt-circle">
                                @if (Model.WorkflowAddim >= 2) { <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg> }
                                else { <span>2</span> }
                            </div>
                            <div class="fn-wt-info">
                                <div class="fn-wt-label">Şöbə rəisi</div>
                                <div class="fn-wt-sub">
                                    @if (Model.SobeReisiTesdiq == true)
                                    { <span style="color:#1e9b6b">Təsdiqləndi · @Model.SobeReisiTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.SobeReisiTesdiq == false)
                                    { <span style="color:#c0392b">İmtina · @Model.SobeReisiTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.WorkflowAddim == 1)
                                    { <span style="color:#c9900a">Gözlənilir...</span> }
                                    else { <span>Gözlənilir</span> }
                                </div>
                            </div>
                        </div>
                        }

                        @if (!Model.MuracietSahibiRehberdirmi && (Model.RehberTesdiq != null || Model.WorkflowAddim <= 2))
                        {
                        <div class="fn-wt-connector @(Model.WorkflowAddim >= 2 ? "fn-wt-connector--done" : "")"></div>

                        @* Addım 2: Rəhbər *@
                        <div class="fn-wt-step @(Model.WorkflowAddim >= 3 ? "fn-wt-step--done" : "")
                                               @(Model.WorkflowAddim == 2 ? "fn-wt-step--active" : "")">
                            <div class="fn-wt-circle">
                                @if (Model.WorkflowAddim >= 3) { <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg> }
                                else { <span>3</span> }
                            </div>
                            <div class="fn-wt-info">
                                <div class="fn-wt-label">Rəhbər</div>
                                <div class="fn-wt-sub">
                                    @if (Model.RehberTesdiq == true)
                                    { <span style="color:#1e9b6b">Təsdiqləndi · @Model.RehberTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.RehberTesdiq == false)
                                    { <span style="color:#c0392b">İmtina · @Model.RehberTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.WorkflowAddim == 2)
                                    { <span style="color:#c9900a">Gözlənilir...</span> }
                                    else { <span>Gözlənilir</span> }
                                </div>
                            </div>
                        </div>
                        }

                        <div class="fn-wt-connector @(Model.WorkflowAddim >= 3 ? "fn-wt-connector--done" : "")"></div>

                        @* Addım 3: HR *@
                        <div class="fn-wt-step @(Model.WorkflowAddim >= 4 ? "fn-wt-step--done" : "")
                                               @(Model.WorkflowAddim == 3 ? "fn-wt-step--active" : "")">
                            <div class="fn-wt-circle">
                                @if (Model.WorkflowAddim >= 4) { <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg> }
                                else { <span>4</span> }
                            </div>
                            <div class="fn-wt-info">
                                <div class="fn-wt-label">HR</div>
                                <div class="fn-wt-sub">
                                    @if (Model.HrTesdiq == true)
                                    { <span style="color:#1e9b6b">Təsdiqləndi · @Model.HrTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.HrTesdiq == false)
                                    { <span style="color:#c0392b">İmtina · @Model.HrTesdiqTarixi?.ToString("dd.MM.yyyy")</span> }
                                    else if (Model.WorkflowAddim == 3)
                                    { <span style="color:#c9900a">Gözlənilir...</span> }
                                    else { <span>Gözlənilir</span> }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
            else
            {
                <div class="fn-card fn-rejected-card">
                    <div class="fn-rc-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="9" stroke="#c0392b" stroke-width="1.5" />
                            <path d="M8 8l8 8M16 8l-8 8" stroke="#c0392b" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="fn-rc-body">
                        <div class="fn-rc-title">Müraciət imtina edildi</div>
                        @if (!string.IsNullOrEmpty(Model.ImtinaSebebi))
                        {
                            <div class="fn-rc-reason">Səbəb: @Model.ImtinaSebebi</div>
                        }
                    </div>
                </div>
            }

        </div>

        @* ── Sağ: qısa məlumatlar ── *@
        <div>

            <div class="fn-card fn-info-list-card">
                <div class="fn-card-title" style="margin-bottom:14px">Müraciət məlumatları</div>

                <div class="fn-info-row">
                    <span class="fn-ir-lbl">İşçi</span>
                    <span class="fn-ir-val">@Model.IsciAdSoyad</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">Şöbə</span>
                    <span class="fn-ir-val">@Model.SobeAdi</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">Vəzifə</span>
                    <span class="fn-ir-val">@Model.VezifeAdi</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">Növ</span>
                    <span class="fn-ir-val">@Model.NovText</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">Başlama</span>
                    <span class="fn-ir-val">@Model.BaslamaTarixi.ToString("dd MMMM yyyy")</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">Bitmə</span>
                    <span class="fn-ir-val">@Model.BitmeTarixi.ToString("dd MMMM yyyy")</span>
                </div>
                <div class="fn-info-row">
                    <span class="fn-ir-lbl">İş günü</span>
                    <span class="fn-ir-val">@Model.IsGunlerininSayi gün</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.EvezEdenIsciAdSoyad))
                {
                    <div class="fn-info-row">
                        <span class="fn-ir-lbl">Əvəzedici</span>
                        <span class="fn-ir-val">@Model.EvezEdenIsciAdSoyad</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Qeyd))
                {
                    <div class="fn-info-row fn-info-row--full">
                        <span class="fn-ir-lbl">Qeyd</span>
                        <span class="fn-ir-val">@Model.Qeyd</span>
                    </div>
                }
            </div>

            @if (Model.LegvEdeBiler)
            {
                <div class="fn-card" style="margin-top:14px">
                    <div class="fn-card-title" style="margin-bottom:10px">Əməliyyatlar</div>
                    <form asp-area="User" asp-controller="Mezuniyyet" asp-action="Legv"
                          method="post"
                          onsubmit="return confirm('Bu müraciəti ləğv etmək istəyirsiniz?')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="fn-btn fn-btn--danger" style="width:100%">
                            Müraciəti ləğv et
                        </button>
                    </form>
                </div>
            }

        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/User/MezDetail.css" asp-append-version="true" />
}
