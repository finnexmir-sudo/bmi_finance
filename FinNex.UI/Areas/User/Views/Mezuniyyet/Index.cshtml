@model MezuniyyetIndexVM
@{
    ViewData["Title"] = "Məzuniyyətlərim";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole(RoleNames.Operator) ? RoleNames.Operator : "";

    // Workflow addım nömrəsinə çevir (string → int, entity enum yox)
    int WorkflowStep(string merhele) => merhele switch
    {
        "Gözləmədə"               => 0,
        "Şöbə rəisi təsdiqində"   => 1,
        "Rəhbər təsdiqində"       => 2,
        "HR təsdiqində"           => 3,
        "Təsdiqlənib"             => 4,
        "İmtina edildi"           => -1,
        _                         => 0
    };

    string BadgeClass(string merhele) => merhele switch
    {
        "Təsdiqlənib"   => "fn-badge--done",
        "İmtina edildi" => "fn-badge--rejected",
        "Gözləmədə"     => "fn-badge--wait",
        _               => "fn-badge--review"
    };

    string NovIconColor(string novText) => novText switch
    {
        "İllik məzuniyyət"      => "#2d6cdf",
        "Xəstəlik məzuniyyəti"  => "#d85a30",
        _                       => "#1e9b6b"
    };
}

<div class="fn-page">

    @* ── Başlıq ── *@
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Məzuniyyətlərim</div>
            <div class="fn-page-sub">Bütün məzuniyyət müraciətləriniz</div>
        </div>
        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
           class="fn-btn fn-btn--primary">
            + Yeni müraciət
        </a>
    </div>

    @* ── Qalıq balans kartları ── *@
    <div class="fn-balance-row">
        <div class="fn-balance-card" style="--accent:#1e9b6b">
            <div class="fn-bc-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <rect x="2" y="3" width="14" height="13" rx="2" stroke="#1e9b6b" stroke-width="1.3" />
                    <path d="M2 7h14M6 3v3M12 3v3" stroke="#1e9b6b" stroke-width="1.2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-bc-body">
                <div class="fn-bc-title">İllik məzuniyyət</div>
                <div class="fn-bc-nums">
                    <span class="fn-bc-big" style="color:#1e9b6b">@Model.IllikQaligGun</span>
                    <span class="fn-bc-slash">/</span>
                    <span class="fn-bc-total">@Model.IllikToplamGun gün qalıb</span>
                </div>
                <div class="fn-lb-track" style="margin-top:6px">
                    <div class="fn-lb-fill" style="width:@(Model.IllikToplamGun > 0 ? (int)((double)Model.IllikQaligGun / Model.IllikToplamGun * 100) : 0)%;background:#1e9b6b"></div>
                </div>
            </div>
        </div>

        <div class="fn-balance-card" style="--accent:#2d6cdf">
            <div class="fn-bc-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <circle cx="9" cy="9" r="6.5" stroke="#2d6cdf" stroke-width="1.3" />
                    <path d="M9 6v4M9 11.5v.5" stroke="#2d6cdf" stroke-width="1.3" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-bc-body">
                <div class="fn-bc-title">Xəstəlik</div>
                <div class="fn-bc-nums">
                    <span class="fn-bc-big" style="color:#2d6cdf">@(Model.XestelikToplamGun - Model.XestelikQaligGun)</span>
                    <span class="fn-bc-total">gün istifadə olunub</span>
                </div>
            </div>
        </div>

        <div class="fn-balance-card" style="--accent:#e8b84b">
            <div class="fn-bc-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M3 3h10l2 2v10H3V3z" stroke="#e8b84b" stroke-width="1.3" />
                    <path d="M6 8h6M6 11h4" stroke="#e8b84b" stroke-width="1.2" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-bc-body">
                <div class="fn-bc-title">Ezamiyyət</div>
                <div class="fn-bc-nums">
                    <span class="fn-bc-big" style="color:#e8b84b">@(Model.EzamiyyetToplamGun - Model.EzamiyyetQaligGun)</span>
                    <span class="fn-bc-total">gün istifadə olunub</span>
                </div>
            </div>
        </div>
    </div>

    @* ── Statistika ── *@
    @if (Model.Cemi > 0)
    {
        <div class="fn-stat-row">
            <div class="fn-stat">
                <div class="fn-stat-val">@Model.Cemi</div>
                <div class="fn-stat-lbl">Cəmi müraciət</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#1e9b6b">@Model.TesdiqCem</div>
                <div class="fn-stat-lbl">Təsdiqlənib</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#c9900a">@Model.GozlemeCem</div>
                <div class="fn-stat-lbl">Gözləmədə</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#c0392b">@Model.ImtinaCem</div>
                <div class="fn-stat-lbl">İmtina edildi</div>
            </div>
            <div class="fn-stat">
                <div class="fn-stat-val" style="color:#2d6cdf">@Model.TesdiqGun</div>
                <div class="fn-stat-lbl">Təsdiqlənən gün</div>
            </div>
        </div>
    }

    @* ── Filtr çubuğu ── *@
    <form asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
          method="get" class="fn-filter-bar">
        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Növ</label>
            <select name="nov" class="fn-select fn-select--sm" onchange="this.form.submit()">
                <option value="">Hamısı</option>
                <option value="İllik məzuniyyət" selected="@(Model.FilterNov == "İllik məzuniyyət")">İllik</option>
                <option value="Xəstəlik məzuniyyəti" selected="@(Model.FilterNov == "Xəstəlik məzuniyyəti")">Xəstəlik</option>
                <option value="Ezamiyyət" selected="@(Model.FilterNov == "Ezamiyyət")">Ezamiyyət</option>
            </select>
        </div>

        <div class="fn-filter-group">
            <label class="fn-filter-lbl">Status</label>
            <select name="status" class="fn-select fn-select--sm" onchange="this.form.submit()">
                <option value="">Hamısı</option>
                <option value="Gözləmədə" selected="@(Model.FilterStatus == "Gözləmədə")">Gözləmədə</option>
                <option value="Şöbə rəisi təsdiqində" selected="@(Model.FilterStatus == "Şöbə rəisi təsdiqində")">Şöbə rəisi</option>
                <option value="Rəhbər təsdiqində" selected="@(Model.FilterStatus == "Rəhbər təsdiqində")">Rəhbər</option>
                <option value="HR təsdiqində" selected="@(Model.FilterStatus == "HR təsdiqində")">HR</option>
                <option value="Təsdiqlənib" selected="@(Model.FilterStatus == "Təsdiqlənib")">Təsdiqlənib</option>
                <option value="İmtina edildi" selected="@(Model.FilterStatus == "İmtina edildi")">İmtina</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(Model.FilterNov) || !string.IsNullOrEmpty(Model.FilterStatus))
        {
            <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
               class="fn-btn fn-btn--outline fn-btn--sm">Sıfırla</a>
        }
    </form>

    @* ── Boş vəziyyət ── *@
    @if (!Model.FilteredList.Any())
    {
        <div class="fn-empty-state">
            <div class="fn-empty-icon">
                <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                    <rect x="7" y="8" width="30" height="28" rx="4" stroke="#dde1ea" stroke-width="2" />
                    <path d="M7 15h30M15 8v6M29 8v6M15 22h14M15 28h10" stroke="#dde1ea" stroke-width="1.8" stroke-linecap="round" />
                </svg>
            </div>
            <div class="fn-empty-title">
                @(Model.Cemi == 0 ? "Hələ məzuniyyət müraciətiniz yoxdur" : "Filtrə uyğun məzuniyyət tapılmadı")
            </div>
            <div class="fn-empty-sub">
                <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
                   style="color:#e8b84b">Yeni müraciət göndər →</a>
            </div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="fn-icaze-list">
                @foreach (var m in Model.FilteredList)
                {
                    
                        var step = WorkflowStep(m.WorkflowMerhele);
                        var color = NovIconColor(m.NovText);
                    
                    <div class="fn-icaze-item">

                        @* Sol: tarix bloku *@
                        <div class="fn-icaze-date-block">
                            <div class="fn-icaze-day">@m.BaslamaTarixi.ToString("dd")</div>
                            <div class="fn-icaze-month">@m.BaslamaTarixi.ToString("MMM")</div>
                        </div>

                        @* Mərkəz: məlumatlar *@
                        <div class="fn-icaze-info">
                            <div class="fn-icaze-title">
                                @m.NovText
                                <span class="fn-icaze-dur">
                                    (@m.BaslamaTarixi.ToString("dd.MM") –
                                    @m.BitmeTarixi.ToString("dd.MM.yyyy") ·
                                    @m.IsGunlerininSayi iş günü)
                                </span>
                                @if (!string.IsNullOrEmpty(m.EmrNomresi))
                                {
                                    <span style="margin-left:8px;padding:2px 8px;border-radius:10px;background:#eff6ff;color:#1e40af;font-size:11px;font-weight:700;font-family:monospace">@m.EmrNomresi</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(m.EvezEdenIsciAdSoyad))
                            {
                                <div class="fn-icaze-meta">
                                    <span class="fn-icaze-evez">Əvəzedici: @m.EvezEdenIsciAdSoyad</span>
                                </div>
                            }

                            @* Workflow addım göstəricisi *@
                            @if (step != -1)
                            {
                                <div class="fn-workflow-steps">
                                    <div class="fn-ws @(step >= 1 ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                        <div class="fn-ws-dot"></div>
                                        <div class="fn-ws-lbl">Müraciət</div>
                                    </div>
                                    @if (m.EvezediciSecildi)
                                    {
                                        <div class="fn-ws-line @(step >= 1 ? "fn-ws-line--done" : "")"></div>
                                        <div class="fn-ws @(m.EvezediciTesdiqlenib == true ? "fn-ws--done" : step == 0 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div>
                                            <div class="fn-ws-lbl">Əvəzedici</div>
                                        </div>
                                    }
                                    @if (!m.SobeReisiKecildi)
                                    {
                                        <div class="fn-ws-line @(step >= 2 ? "fn-ws-line--done" : "")"></div>
                                        <div class="fn-ws @(step >= 2 ? "fn-ws--done" : step == 1 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div>
                                            <div class="fn-ws-lbl">Şöbə rəisi</div>
                                        </div>
                                    }
                                    @if (!m.RehberKecildi)
                                    {
                                        <div class="fn-ws-line @(step >= 3 ? "fn-ws-line--done" : "")"></div>
                                        <div class="fn-ws @(step >= 3 ? "fn-ws--done" : step == 2 ? "fn-ws--active" : "")">
                                            <div class="fn-ws-dot"></div>
                                            <div class="fn-ws-lbl">Rəhbər</div>
                                        </div>
                                    }
                                    <div class="fn-ws-line @(step >= 4 ? "fn-ws-line--done" : "")"></div>
                                    <div class="fn-ws @(step >= 4 ? "fn-ws--done" : step == 3 ? "fn-ws--active" : "")">
                                        <div class="fn-ws-dot"></div>
                                        <div class="fn-ws-lbl">HR</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="fn-imtina-box">
                                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                                        <circle cx="6" cy="6" r="5" stroke="#c0392b" stroke-width="1.2" />
                                        <path d="M4 4l4 4M8 4l-4 4" stroke="#c0392b" stroke-width="1.2" stroke-linecap="round" />
                                    </svg>
                                    İmtina edildi
                                </div>
                            }
                        </div>

                        @* Sağ: status + əməliyyatlar *@
                        <div class="fn-icaze-actions">
                            <span class="fn-badge @BadgeClass(m.WorkflowMerhele)">
                                @m.WorkflowMerhele
                            </span>
                            <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Detail"
                               asp-route-id="@m.Id" class="fn-btn fn-btn--ghost-sm" style="margin-top:6px">
                                Detay
                            </a>
                            @if (m.WorkflowMerhele != "Təsdiqlənib" && m.WorkflowMerhele != "İmtina edildi")
                            {
                                <form asp-area="User" asp-controller="Mezuniyyet"
                                      asp-action="Legv" method="post" style="margin-top:4px"
                                      onsubmit="return confirm('Bu müraciəti ləğv etmək istəyirsiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="fn-btn fn-btn--danger-sm">Ləğv et</button>
                                </form>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    }

</div>
