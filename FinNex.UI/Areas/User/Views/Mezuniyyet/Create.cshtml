@model MezuniyyetCreateVM
@{
    ViewData["Title"] = "Yeni Məzuniyyət Müraciəti";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["UserRole"] = User.IsInRole(RoleNames.Operator) ? RoleNames.Operator : "";
}

<div class="fn-page fn-mez-create">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni məzuniyyət müraciəti</div>
            <div class="fn-page-sub">Məzuniyyət üçün müraciət göndərin</div>
        </div>
        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
           class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-create-layout">

        @* ── Forma ── *@
        <div class="fn-form-wrap fn-form-wrap--wide">
            <form asp-area="User" asp-controller="Mezuniyyet" asp-action="Create"
                  method="post" id="mezForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IsciId" />

                <div class="fn-card fn-card--form">

                    @* ── Məzuniyyət növü (İşçi yalnız İllik seçə bilər) ── *@
                    <input type="hidden" name="Nov" value="1" />
                    <div class="fn-info-box" style="background:#f0f7ff;border-color:#d0e2ff;margin-bottom:16px">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <rect x="1" y="1.5" width="12" height="11" rx="2" stroke="#2d6cdf" stroke-width="1.2" />
                            <path d="M1 5h12" stroke="#2d6cdf" stroke-width="1.2" />
                        </svg>
                        <strong>İllik məzuniyyət</strong> — Qalıq: <strong>@Model.IllikQaligGun</strong> / @Model.IllikToplamGun gün
                    </div>

                    @* ── Tarixlər ── *@
                    <div class="fn-form-row">
                        <div class="fn-form-group">
                            <label asp-for="BaslamaTarixi" class="fn-label">
                                Başlama tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BaslamaTarixi" type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="fn-input" id="baslamaTarixi" />
                            <span asp-validation-for="BaslamaTarixi" class="fn-val-msg"></span>
                        </div>
                        <div class="fn-form-group">
                            <label asp-for="BitmeTarixi" class="fn-label">
                                Bitmə tarixi <span class="fn-required">*</span>
                            </label>
                            <input asp-for="BitmeTarixi" type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="fn-input" id="bitmeTarixi" />
                            <span asp-validation-for="BitmeTarixi" class="fn-val-msg"></span>
                        </div>
                    </div>

                    @* ── Müddət göstəricisi ── *@
                    <div class="fn-duration-box" id="durationBox" style="display:none">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <rect x="1" y="1.5" width="12" height="11" rx="2" stroke="#1e9b6b" stroke-width="1.2" />
                            <path d="M1 5h12" stroke="#1e9b6b" stroke-width="1.2" />
                        </svg>
                        Seçilmiş müddət: <strong id="durationText"></strong>
                    </div>

                    @* ── Məzuniyyət ödənişi preview ── *@
                    <div id="mezPreviewBox" class="mez-preview" style="display:none;">
                        <div class="mez-preview-head">
                            <i class="bi bi-calculator"></i>
                            Məzuniyyət ödənişi (təxmini hesablama)
                        </div>
                        <div class="mez-preview-body">
                            <div class="mez-preview-row">
                                <div class="mez-preview-cell">
                                    <div class="mp-lbl">Təqvim günü</div>
                                    <div class="mp-val" id="mpTeqvimGun">—</div>
                                </div>
                                <div class="mez-preview-cell">
                                    <div class="mp-lbl">İş günü</div>
                                    <div class="mp-val" id="mpIsGun">—</div>
                                </div>
                                <div class="mez-preview-cell">
                                    <div class="mp-lbl">Cari maaş</div>
                                    <div class="mp-val" id="mpCariMaas">—</div>
                                </div>
                            </div>

                            <div class="mez-preview-formula">
                                <div class="mez-preview-fline">
                                    <span class="mp-flbl">MH</span>
                                    <span class="mp-fdsc">(tarixi orta — son 12 ay)</span>
                                    <span class="mp-fval" id="mpMH">—</span>
                                </div>
                                <div class="mez-preview-fline">
                                    <span class="mp-flbl">ƏH</span>
                                    <span class="mp-fdsc">(cari maaş × iş günü)</span>
                                    <span class="mp-fval" id="mpEH">—</span>
                                </div>
                                <div class="mez-preview-final">
                                    <span class="mp-flbl">ÖDƏNİŞ</span>
                                    <span class="mp-fdsc" id="mpQalibInfo">—</span>
                                    <span class="mp-fval mp-fval--gold" id="mpOdenis">—</span>
                                </div>
                            </div>

                            <div class="mez-preview-warn" id="mezPreviewWarn" style="display:none;">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span id="mezPreviewWarnText"></span>
                            </div>
                        </div>
                    </div>

                    <style>
                        .mez-preview {
                            margin-top: 16px;
                            padding: 14px 18px;
                            background: linear-gradient(135deg, #faf5ff, #f5f3ff);
                            border: 1.5px solid #d8b4fe;
                            border-radius: 12px;
                        }
                        .mez-preview-head {
                            font-size: 13px;
                            font-weight: 700;
                            color: #6b21a8;
                            margin-bottom: 12px;
                            display: flex;
                            align-items: center;
                            gap: 6px;
                        }
                        .mez-preview-row {
                            display: grid;
                            grid-template-columns: repeat(3, 1fr);
                            gap: 12px;
                            margin-bottom: 14px;
                        }
                        .mez-preview-cell {
                            background: #fff;
                            padding: 10px 14px;
                            border-radius: 9px;
                            border: 1px solid #e9d5ff;
                        }
                        .mp-lbl {
                            font-size: 10px;
                            font-weight: 700;
                            color: #7c3aed;
                            text-transform: uppercase;
                            letter-spacing: .4px;
                            margin-bottom: 4px;
                        }
                        .mp-val {
                            font-size: 16px;
                            font-weight: 800;
                            color: #1a2332;
                        }
                        .mez-preview-formula {
                            background: #fff;
                            padding: 12px 14px;
                            border-radius: 9px;
                            border: 1px solid #e9d5ff;
                        }
                        .mez-preview-fline {
                            display: grid;
                            grid-template-columns: 50px 1fr auto;
                            align-items: center;
                            padding: 6px 0;
                            font-size: 12px;
                            border-bottom: 1px dashed #f3e8ff;
                        }
                        .mez-preview-fline:last-of-type { border-bottom: none; }
                        .mez-preview-final {
                            display: grid;
                            grid-template-columns: 80px 1fr auto;
                            align-items: center;
                            padding: 10px 0 4px;
                            margin-top: 6px;
                            border-top: 2px solid #d8b4fe;
                        }
                        .mp-flbl {
                            font-weight: 800;
                            color: #6b21a8;
                            font-size: 11px;
                        }
                        .mez-preview-final .mp-flbl { font-size: 13px; color: #c9900a; }
                        .mp-fdsc {
                            font-size: 11px;
                            color: #8a93a8;
                            font-style: italic;
                        }
                        .mp-fval {
                            font-weight: 700;
                            color: #1a2332;
                            font-size: 13px;
                        }
                        .mp-fval--gold {
                            color: #c9900a;
                            font-size: 18px;
                            font-weight: 800;
                        }
                        .mez-preview-warn {
                            margin-top: 10px;
                            padding: 8px 12px;
                            background: #fef3c7;
                            border-radius: 8px;
                            color: #92400e;
                            font-size: 11.5px;
                            display: flex;
                            align-items: center;
                            gap: 6px;
                        }
                    </style>

                    @* ── Əvəzedici işçi ── *@
                    <div class="fn-form-group">
                        <label asp-for="EvezEdenIsciId" class="fn-label">
                            Əvəzedici işçi
                            <span class="fn-label-hint">(isteğe bağlı)</span>
                        </label>
                        <select asp-for="EvezEdenIsciId"
                                asp-items="Model.EvezEdenList"
                                class="fn-select">
                            <option value="">— Seçin —</option>
                        </select>
                        <span asp-validation-for="EvezEdenIsciId" class="fn-val-msg"></span>
                    </div>

                    @* ── Qeyd ── *@
                    <div class="fn-form-group">
                        <label asp-for="Qeyd" class="fn-label">
                            Qeyd
                            <span class="fn-label-hint">(istəyə bağlı, maks. 500 simvol)</span>
                        </label>
                        <textarea asp-for="Qeyd" rows="3"
                                  class="fn-textarea"
                                  placeholder="Məzuniyyətin səbəbini qısaca yazın..."></textarea>
                        <span asp-validation-for="Qeyd" class="fn-val-msg"></span>
                    </div>

                    @* ── Məlumat qutusu ── *@
                    <div class="fn-info-box">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                            <circle cx="7" cy="7" r="5.5" stroke="#c9900a" stroke-width="1.2" />
                            <path d="M7 4.5v3.5M7 9.5v.5" stroke="#c9900a" stroke-width="1.2" stroke-linecap="round" />
                        </svg>
                        Müraciətiniz <strong>3 mərhələdən</strong> keçəcək:
                        <strong>Şöbə rəisi → Rəhbər → HR</strong>.
                        Yalnız <strong>Gözləmədə</strong> və <strong>Şöbə rəisi</strong> mərhələsində ləğv edə bilərsiniz.
                    </div>

                    @* ── Düymələr ── *@
                    <div class="fn-form-actions">
                        <a asp-area="User" asp-controller="Mezuniyyet" asp-action="Index"
                           class="fn-btn fn-btn--outline">Ləğv et</a>
                        <button type="submit" class="fn-btn fn-btn--primary">
                            Müraciət göndər
                        </button>
                    </div>

                </div>
            </form>
        </div>

        @* ── Sağ panel: qalıq info ── *@
        <div class="fn-side-info">
            <div class="fn-card">
                <div class="fn-card-title" style="margin-bottom:12px">İllik məzuniyyət balansı</div>

                <div class="fn-side-balance-item">
                    <div class="fn-sbi-label">Qalıq</div>
                    <div class="fn-sbi-bar">
                        <div class="fn-lb-track">
                            <div class="fn-lb-fill" style="width:@(Model.IllikToplamGun > 0 ? (int)((double)Model.IllikQaligGun / Model.IllikToplamGun * 100) : 0)%;background:#1e9b6b"></div>
                        </div>
                        <span class="fn-sbi-val" style="color:#1e9b6b">@Model.IllikQaligGun / @Model.IllikToplamGun gün</span>
                    </div>
                </div>

                <div class="fn-side-balance-item">
                    <div class="fn-sbi-label">İstifadə olunub</div>
                    <div class="fn-sbi-bar">
                        <span class="fn-sbi-val" style="color:#5a647a">@Model.IllikIstifadeGun gün</span>
                    </div>
                </div>
            </div>

            <div class="fn-card" style="margin-top:16px">
                <div class="fn-card-title" style="margin-bottom:10px">Workflow mərhələləri</div>
                <div class="fn-workflow-info">
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">1</div>
                        <div class="fn-wi-text">
                            <strong>Şöbə rəisi</strong>
                            <span>İlk təsdiq mərhələsi</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">2</div>
                        <div class="fn-wi-text">
                            <strong>Rəhbər</strong>
                            <span>İkinci təsdiq mərhələsi</span>
                        </div>
                    </div>
                    <div class="fn-wi-step">
                        <div class="fn-wi-num">3</div>
                        <div class="fn-wi-text">
                            <strong>HR</strong>
                            <span>Son təsdiq mərhələsi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/User/user_create_mezuniyyet.js" asp-append-version="true"></script>
    <script>
        // Real-time məzuniyyət ödənişi preview
        (function () {
            const baslamaInp = document.getElementById('baslamaTarixi');
            const bitmeInp = document.getElementById('bitmeTarixi');
            const previewBox = document.getElementById('mezPreviewBox');
            const fmt = v => v > 0
                ? v.toLocaleString('az-AZ', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₼'
                : '—';

            let lastFetchKey = '';

            function refreshPreview() {
                const baslama = baslamaInp?.value;
                const bitme = bitmeInp?.value;
                if (!baslama || !bitme) {
                    previewBox.style.display = 'none';
                    return;
                }
                const key = baslama + '|' + bitme;
                if (key === lastFetchKey) return;
                lastFetchKey = key;

                fetch(`/User/Mezuniyyet/Preview?baslama=${baslama}&bitme=${bitme}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) { previewBox.style.display = 'none'; return; }
                        previewBox.style.display = 'block';

                        document.getElementById('mpTeqvimGun').textContent = data.teqvimGun + ' gün';
                        document.getElementById('mpIsGun').textContent = data.isGun + ' gün';
                        document.getElementById('mpCariMaas').textContent = fmt(data.cariMaas);

                        document.getElementById('mpMH').textContent = fmt(data.mh);
                        document.getElementById('mpEH').textContent = fmt(data.eh);
                        document.getElementById('mpOdenis').textContent = fmt(data.odenis);

                        const qalibInfo = data.qalib === 'MH'
                            ? '(MH > ƏH — tarixi orta yüksəkdir)'
                            : '(ƏH > MH — cari maaş yüksəkdir)';
                        document.getElementById('mpQalibInfo').textContent = qalibInfo;

                        // Xəbərdarlıq: az qeyd
                        const warn = document.getElementById('mezPreviewWarn');
                        const warnText = document.getElementById('mezPreviewWarnText');
                        if (data.qeydSayi < 12) {
                            warn.style.display = 'flex';
                            warnText.textContent =
                                `Yalnız ${data.qeydSayi}/12 ay qazanc tarixçəsi mövcuddur — MH dəqiq olmaya bilər. ` +
                                `HR-dən tarixi məlumatların əlavə edilməsini xahiş edin.`;
                        } else {
                            warn.style.display = 'none';
                        }
                    })
                    .catch(() => { previewBox.style.display = 'none'; });
            }

            baslamaInp?.addEventListener('change', refreshPreview);
            bitmeInp?.addEventListener('change', refreshPreview);

            // Səhifə yüklənəndə də yoxla
            setTimeout(refreshPreview, 200);
        })();
    </script>
}

