@using FinNex.Application.DTOs.HR.Ezamiyyet
@model EzamiyyetMuracietCreateDto
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Yeni Ezamiyyət Müraciəti";
    var mekanlar = ViewBag.Mekanlar as IList<EzamiyyetMekanListDto> ?? new List<EzamiyyetMekanListDto>();
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni Ezamiyyət Müraciəti</div>
            <div class="fn-page-sub">Ezamiyyət məlumatlarını doldurun, rəhbəriniz təsdiq edəcək</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--ghost">
            <i class="bi bi-arrow-left"></i> Geri
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="fn-alert fn-alert--danger">@TempData["Error"]</div>
    }

    <div class="fn-card" style="padding:24px;max-width:720px">
        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()

            <div class="fn-form-group">
                <label class="fn-label">Başlıq *</label>
                <input type="text" name="Baslig" class="fn-input" placeholder="məs. Bakı — Şəki iş görüşməsi" value="@Model?.Baslig" required />
            </div>

            <div class="fn-form-group" style="margin-top:14px">
                <label class="fn-label">Məkan *</label>
                <div style="display:flex;gap:8px">
                    <select name="MekanId" id="mekanSelect" class="fn-input" style="flex:1">
                        <option value="">— seçin —</option>
                        @foreach (var m in mekanlar)
                        {
                            <option value="@m.Id">@m.Ad</option>
                        }
                    </select>
                    <button type="button" class="fn-btn fn-btn--outline" onclick="yeniMekanGoster()"
                            title="Yeni məkan əlavə et">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div id="yeniMekanDiv" style="display:none;margin-top:8px">
                    <input type="text" name="YeniMekanAd" id="yeniMekanInp" class="fn-input"
                           placeholder="Yeni məkan adı..." value="@Model?.YeniMekanAd" />
                    <div style="font-size:11px;color:#64748b;margin-top:3px">
                        Siyahıda yoxdursa yeni məkan adı yazın — sistem avtomatik əlavə edəcək
                    </div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px">
                <div class="fn-form-group">
                    <label class="fn-label">Başlama tarixi *</label>
                    <input type="date" name="BaslamaTarixi" class="fn-input" required
                           value="@((Model?.BaslamaTarixi ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Başlama saatı <span style="color:#94a3b8;font-weight:400">(istəyə bağlı)</span></label>
                    <input type="text" name="BaslamaSaati" id="ezBaslamaSaati"
                           pattern="^([01]?\d|2[0-3]):[0-5]\d$"
                           placeholder="09:00" maxlength="5" inputmode="numeric"
                           class="fn-input" autocomplete="off" value="@Model?.BaslamaSaati" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px">
                <div class="fn-form-group">
                    <label class="fn-label">Bitmə tarixi *</label>
                    <input type="date" name="BitmeTarixi" class="fn-input" required
                           value="@((Model?.BitmeTarixi ?? DateTime.Today).ToString("yyyy-MM-dd"))" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Bitmə saatı <span style="color:#94a3b8;font-weight:400">(istəyə bağlı)</span></label>
                    <input type="text" name="BitisSaati" id="ezBitisSaati"
                           pattern="^([01]?\d|2[0-3]):[0-5]\d$"
                           placeholder="18:00" maxlength="5" inputmode="numeric"
                           class="fn-input" autocomplete="off" />
                </div>
            </div>

            @* ── Xidməti maşın (01.09.2026) ─────────────────────────────────
               «Bir forma, bir təsdiq»: burada seçilən maşın üçün AYRICA
               Avtopark müraciəti yazılmır — rəhbər ezamiyyəti təsdiqləyəndə
               maşın müraciəti avtomatik yaranır və birbaşa kassaya düşür.

               Seçimin YEGANƏ mənbəyi `MasinId`-dir. Checkbox yalnız bölməni
               açıb-bağlayır və POST-a getmir — iki yerdə saxlansaq biri
               dəyişəndə o biri köhnə qalardı. *@
            @{
                var masinlar = ViewBag.Masinlar as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                               ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                var masinSecili = Model?.MasinId.HasValue == true && Model.MasinId.Value > 0;
            }
            <div class="fn-form-group" style="margin-top:14px">
                <label class="fn-label" style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" id="ezMasinVar" @(masinSecili ? "checked" : "")
                           style="width:16px;height:16px;cursor:pointer" />
                    <span><i class="bi bi-car-front"></i> Xidməti maşınla gedirəm</span>
                </label>

                <div id="ezMasinBlok" style="margin-top:8px; @(masinSecili ? "" : "display:none")">
                    @if (masinlar.Count == 0)
                    {
                        <div class="fn-info-box">
                            Hazırda seçilə bilən aktiv maşın yoxdur — Avtoparka müraciət edin.
                        </div>
                    }
                    else
                    {
                        <select name="MasinId" id="ezMasinId" class="fn-input">
                            <option value="">— maşın seçin —</option>
                            @foreach (var m in masinlar)
                            {
                                <option value="@m.Value" selected="@(Model?.MasinId?.ToString() == m.Value)">@m.Text</option>
                            }
                        </select>
                        <div style="font-size:11px;color:#64748b;margin-top:3px">
                            Ayrıca Avtopark müraciəti yazmağa ehtiyac yoxdur — rəhbər ezamiyyəti
                            təsdiqləyəndə maşın müraciəti avtomatik yaranır və açar üçün kassaya düşür.
                        </div>
                    }
                </div>
            </div>

            <div class="fn-form-group" style="margin-top:14px">
                <label class="fn-label">Qeyd</label>
                <textarea name="Qeyd" class="fn-input" rows="3"
                          placeholder="Əlavə məlumat (istəyə bağlı)">@Model?.Qeyd</textarea>
            </div>

            <div class="fn-form-group" style="margin-top:14px">
                <label class="fn-label">Sənəd <span style="color:#94a3b8;font-weight:400">(istəyə bağlı)</span></label>
                <input type="file" name="Sened" class="fn-input"
                       accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                <div style="font-size:11px;color:#64748b;margin-top:3px">
                    PDF, Word, şəkil — max 10 MB
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px">
                <a asp-action="Index" class="fn-btn fn-btn--ghost">Ləğv et</a>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <i class="bi bi-send"></i> Göndər
                </button>
            </div>
        </form>
    </div>

</div>

<script>
    function yeniMekanGoster() {
        var div = document.getElementById('yeniMekanDiv');
        var sel = document.getElementById('mekanSelect');
        if (div.style.display !== 'none') {
            div.style.display = 'none';
            sel.disabled = false;
        } else {
            div.style.display = 'block';
            sel.value = '';
            sel.disabled = true;
            document.getElementById('yeniMekanInp').focus();
        }
    }

    // ── Saat mask (icazə ilə eyni): yalnız rəqəm yazılır, ":" avtomatik qoyulur ──
    function ezMaskSaat(e) {
        var raw = e.target.value.replace(/[^\d]/g, '');
        if (raw.length > 4) raw = raw.substring(0, 4);
        e.target.value = raw.length >= 3 ? raw.substring(0, 2) + ':' + raw.substring(2) : raw;
    }
    ['ezBaslamaSaati', 'ezBitisSaati'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener('input', ezMaskSaat);
    });

    // Öncədən "yeni məkan" doldurulubsa (məs. məhkəmə görüşündən), həmin bölməni avtomatik aç
    (function () {
        var inp = document.getElementById('yeniMekanInp');
        if (inp && inp.value.trim()) {
            document.getElementById('yeniMekanDiv').style.display = 'block';
            var sel = document.getElementById('mekanSelect');
            if (sel) { sel.value = ''; sel.disabled = true; }
        }
    })();

    // ── Xidməti maşın bölməsi (01.09.2026) ──────────────────────────────
    // Checkbox POST-a GETMİR — yalnız bölməni açır. İşarə götürüləndə seçim
    // də TƏMİZLƏNİR: yoxsa istifadəçi bölməni bağlayar, gizli <select> köhnə
    // maşını göndərər və ezamiyyət təsdiqlənəndə gözlənilməz maşın müraciəti
    // yaranardı (heç bir xəta vermədən).
    (function () {
        var cb = document.getElementById('ezMasinVar');
        var blok = document.getElementById('ezMasinBlok');
        if (!cb || !blok) return;

        cb.addEventListener('change', function () {
            blok.style.display = cb.checked ? '' : 'none';
            if (!cb.checked) {
                var sel = document.getElementById('ezMasinId');
                if (sel) sel.value = '';
            }
        });
    })();
</script>
