@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Toplu Mesaj";
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    var isciler = ViewBag.Isciler as List<SelectListItem> ?? new List<SelectListItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/inbox.css" asp-append-version="true" />
    <style>
        .tm-recipient-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; max-height: 300px; overflow-y: auto; padding: 8px; border: 1px solid #e4e8f0; border-radius: 8px; margin-top: 6px; }
        .tm-recipient-item { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: background .1s; font-size: 12px; }
        .tm-recipient-item:hover { background: #f0f2f5; }
        .tm-recipient-item input[type="checkbox"] { accent-color: #2d6cdf; }
        .tm-recipient-item label { cursor: pointer; flex: 1; }
        .tm-recipient-name { font-weight: 600; color: #1a2332; }
        .tm-recipient-dept { font-size: 10px; color: #8a93a8; }
        .tm-toolbar { display: flex; gap: 8px; align-items: center; margin-top: 8px; }
        .tm-toolbar button { background: #f0f2f5; border: none; padding: 4px 10px; border-radius: 5px; font-size: 11px; cursor: pointer; color: #5a647a; font-weight: 500; }
        .tm-toolbar button:hover { background: #e4e8f0; }
        .tm-count { font-size: 11px; color: #8a93a8; margin-left: auto; }
        .tm-search { width: 100%; padding: 8px 12px; border: 1px solid #e4e8f0; border-radius: 7px; font-size: 13px; margin-bottom: 8px; }
        .tm-search:focus { outline: none; border-color: #2d6cdf; }
    </style>
}

<div class="fn-page">
    <div class="msg-compose" style="width:100%">
        <div class="msg-card" style="background:#fff;border-radius:12px;border:1px solid #e8ebf0;padding:28px 32px">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px">
                <div style="font-size:18px;font-weight:700;color:#1e2a3b">Toplu Mesaj</div>
                <a asp-action="Index" class="fn-btn fn-btn--outline" style="font-size:13px">← Geri</a>
            </div>

        <form asp-action="TopluMesaj" method="post">
            @Html.AntiForgeryToken()

            <div style="margin-bottom:20px">
                <label style="font-size:13px;font-weight:600;color:#3c4555;margin-bottom:6px;display:block">Alıcılar <span style="color:#c83838">*</span></label>
                <input type="text" class="tm-search" id="tmSearch" placeholder="İşçi axtar..." />
                <div class="tm-toolbar">
                    <button type="button" id="tmSelectAll">Hamısını seç</button>
                    <button type="button" id="tmDeselectAll">Hamısını sil</button>
                    <span class="tm-count" id="tmCount">0 seçilib</span>
                </div>
                <div class="tm-recipient-grid" id="tmGrid">
                    @foreach (var isci in isciler)
                    {
                        <div class="tm-recipient-item" data-name="@isci.Text">
                            <input type="checkbox" name="alanIsciIds" value="@isci.Value" id="isci_@isci.Value" />
                            <label for="isci_@isci.Value">
                                <div class="tm-recipient-name">@isci.Text</div>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div style="margin-bottom:20px">
                <label style="font-size:13px;font-weight:600;color:#3c4555;margin-bottom:6px;display:block">Mövzu <span style="color:#8b95a5;font-weight:400">(isteğe bağlı)</span></label>
                <input name="movzu" style="width:100%;padding:10px 14px;border:1px solid #dce0e8;border-radius:8px;font-size:14px;outline:none" placeholder="Mesajın mövzusu..." maxlength="200" />
            </div>

            <div style="margin-bottom:20px">
                <label style="font-size:13px;font-weight:600;color:#3c4555;margin-bottom:6px;display:block">Mətn <span style="color:#c83838">*</span></label>
                <textarea name="metn" style="width:100%;padding:12px 14px;border:1px solid #dce0e8;border-radius:8px;font-size:14px;outline:none;resize:vertical;min-height:140px;font-family:inherit" required
                          placeholder="Mesajınızı yazın..." rows="8"></textarea>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid #f0f2f5">
                <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
                <button type="submit" class="fn-btn fn-btn--primary">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                        <path d="M1 6.5l10-5-5 10-.5-4.5L1 6.5z" stroke="currentColor"
                              stroke-width="1.2" stroke-linejoin="round" />
                    </svg>
                    Hamısına Göndər
                </button>
            </div>
        </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var search = document.getElementById('tmSearch');
            var grid = document.getElementById('tmGrid');
            var items = grid.querySelectorAll('.tm-recipient-item');
            var countEl = document.getElementById('tmCount');

            function updateCount() {
                var checked = grid.querySelectorAll('input[type="checkbox"]:checked').length;
                countEl.textContent = checked + ' seçilib';
            }

            // Search filter
            search.addEventListener('input', function () {
                var q = search.value.toLowerCase();
                items.forEach(function (item) {
                    var name = item.getAttribute('data-name').toLowerCase();
                    item.style.display = name.indexOf(q) >= 0 ? '' : 'none';
                });
            });

            // Select all / deselect all
            document.getElementById('tmSelectAll').addEventListener('click', function () {
                items.forEach(function (item) {
                    if (item.style.display !== 'none') {
                        item.querySelector('input').checked = true;
                    }
                });
                updateCount();
            });

            document.getElementById('tmDeselectAll').addEventListener('click', function () {
                items.forEach(function (item) {
                    item.querySelector('input').checked = false;
                });
                updateCount();
            });

            // Count on change
            grid.addEventListener('change', updateCount);
        })();
    </script>
}
