@model SenedDashboardVM

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-5col col-lg-4 col-md-6">
        <div class="sd-stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Ümumi Sənədlər</div>
                    <div class="stat-value">@Model.UmumiSenedler</div>
                </div>
                <div class="stat-icon bg-primary-soft text-primary">
                    <i class="bi bi-files"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5col col-lg-4 col-md-6">
        <div class="sd-stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Yeni</div>
                    <div class="stat-value">@Model.YeniSenedler</div>
                </div>
                <div class="stat-icon bg-info-soft text-info">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5col col-lg-4 col-md-6">
        <div class="sd-stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Yoxlanılır</div>
                    <div class="stat-value">@Model.YoxlanilirSenedler</div>
                </div>
                <div class="stat-icon bg-warning-soft text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5col col-lg-4 col-md-6">
        <div class="sd-stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Təsdiqlənmiş</div>
                    <div class="stat-value">@Model.TesdiqSenedler</div>
                </div>
                <div class="stat-icon bg-success-soft text-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-5col col-lg-4 col-md-6">
        <div class="sd-stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label">Arxiv</div>
                    <div class="stat-value">@Model.ArxivSenedler</div>
                </div>
                <div class="stat-icon bg-secondary-soft text-secondary">
                    <i class="bi bi-archive"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Yarat"
           class="sd-quick-action-card d-block text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <div class="qa-icon bg-primary-soft text-primary">
                    <i class="bi bi-plus-lg"></i>
                </div>
                <div>
                    <div class="qa-title">Yeni Sənəd Yarat</div>
                    <div class="qa-desc">Yeni sənəd əlavə edin</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
           class="sd-quick-action-card d-block text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <div class="qa-icon bg-info-soft text-info">
                    <i class="bi bi-search"></i>
                </div>
                <div>
                    <div class="qa-title">Sənəd Axtar</div>
                    <div class="qa-desc">Siyahıda axtarış edin</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Silinmisler"
           class="sd-quick-action-card d-block text-decoration-none">
            <div class="d-flex align-items-center gap-3">
                <div class="qa-icon bg-danger-soft text-danger">
                    <i class="bi bi-trash3"></i>
                </div>
                <div>
                    <div class="qa-title">Silinmişlər</div>
                    <div class="qa-desc">Silinmiş sənədlərə baxın</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Recent Documents -->
<div class="sd-table-card">
    <div class="card-header">
        <h5><i class="bi bi-clock-history me-2"></i>Son 10 Sənəd</h5>
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
           class="btn btn-sm btn-outline-primary">
            Hamısına bax <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <div class="table-responsive">
        <table class="table sd-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Başlıq</th>
                    <th>Şöbə</th>
                    <th>Sənəd Növü</th>
                    <th>Status</th>
                    <th>Fayl</th>
                    <th>Tarix</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SonSenedler.Any())
                {
                    @foreach (var s in Model.SonSenedler)
                    {
                        <tr>
                            <td class="fw-semibold text-muted">@s.Id</td>
                            <td class="fw-semibold">@s.Basliq</td>
                            <td>@s.Departament</td>
                            <td>@s.SenedNovu</td>
                            <td>
                                @{
                                    var badgeClass = s.Status switch
                                    {
                                        SenedStatusu.Yeni => "sd-badge-info",
                                        SenedStatusu.Yoxlanilir => "sd-badge-warning",
                                        SenedStatusu.Tesdiq => "sd-badge-success",
                                        SenedStatusu.Arxiv => "sd-badge-secondary",
                                        _ => "sd-badge-secondary"
                                    };
                                    var statusText = s.Status switch
                                    {
                                        SenedStatusu.Yeni => "Yeni",
                                        SenedStatusu.Yoxlanilir => "Yoxlanılır",
                                        SenedStatusu.Tesdiq => "Təsdiqlənmiş",
                                        SenedStatusu.Arxiv => "Arxiv",
                                        _ => "Naməlum"
                                    };
                                }
                                <span class="sd-badge @badgeClass">@statusText</span>
                            </td>
                            <td>
                                <span class="text-muted">
                                    <i class="bi bi-paperclip me-1"></i>@s.FaylSayi
                                </span>
                            </td>
                            <td class="text-muted">@s.YaradilmaTarixi.ToString("dd.MM.yyyy")</td>
                            <td>
                                <a asp-area="SenedDovriyyesi" asp-controller="Sened"
                                   asp-action="Detal" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-primary sd-btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2 opacity-25"></i>
                            Hələ heç bir sənəd yoxdur
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
