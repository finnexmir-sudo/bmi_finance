@using FinNex.Application.DTOs.Mektub
@model XaricMektubCreateDto
@{
    ViewData["Title"] = "Yeni xaric olan məktub";
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni xaric olan məktub</div>
            <div class="fn-page-sub">Qeydiyyat № və icraçı avtomatik təyin olunur</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="dm-alert dm-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="fn-card" style="max-width:720px">
        <form asp-action="Yarat" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="dm-grid">
                <div>
                    <label>Tarix</label>
                    <input type="date" name="Tarix" value="@(Model.Tarix?.ToString("yyyy-MM-dd"))" class="fn-input" />
                </div>
                <div class="dm-full">
                    <label>Göndərilən yer (təyinat) *</label>
                    <div class="fn-combo" data-combo>
                        <input type="text" name="GonYer" value="@Model.GonYer" class="fn-input" autocomplete="off"
                               placeholder="Siyahıdan seç və ya əl ilə yaz" data-combo-input />
                        <i class="bi bi-chevron-down fn-combo-caret"></i>
                        <div class="fn-combo-menu" data-combo-menu>
                            @foreach (var yer in (string[])(ViewBag.GonYerler ?? Array.Empty<string>()))
                            {
                                <div class="fn-combo-opt" data-val="@yer">@yer</div>
                            }
                        </div>
                    </div>
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px">Hazır siyahıdan seçə və ya yeni ünvan yaza bilərsən.</div>
                </div>
                <div class="dm-full">
                    <label>Qısa məzmun</label>
                    <input type="text" name="QisaMez" value="@Model.QisaMez" class="fn-input" placeholder="Məktubun mövzusu" />
                </div>
                <div class="dm-full">
                    <label>Məktubun mətni <span style="color:#94a3b8;font-weight:500">— istəyə bağlı</span></label>
                    <textarea name="MektubMetn" class="fn-input" rows="5" placeholder="Məktubun tam mətni (istəyə görə)">@Model.MektubMetn</textarea>
                </div>
                <div class="dm-full">
                    <label>Sənəd (qoşma) <span style="color:#94a3b8;font-weight:500">— istəyə bağlı</span></label>
                    <input type="file" name="fayl" class="fn-input" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.tif,.tiff" />
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px">PDF, şəkil və ya Word — maks. 30 MB.</div>
                </div>
            </div>

            <div class="dm-actions">
                <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-save"></i> Qeydə al</button>
                <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .dm-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px 18px; }
        .dm-grid .dm-full { grid-column:1/-1; }
        .dm-grid label { display:block; font-size:11px; color:#64748b; font-weight:600; margin-bottom:5px; }
        .dm-grid textarea.fn-input { resize:vertical; }
        .dm-actions { display:flex; gap:10px; margin-top:18px; }
        .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }

        /* Redaktə oluna bilən combobox (filtrlənən, scroll-lu) */
        .fn-combo { position:relative; }
        .fn-combo .fn-input { padding-right:32px; }
        .fn-combo-caret { position:absolute; right:12px; top:14px; color:#94a3b8; font-size:12px; pointer-events:none; }
        .fn-combo-menu { position:absolute; top:calc(100% + 4px); left:0; right:0; z-index:40; background:#fff;
            border:1px solid #e2e8f0; border-radius:10px; max-height:240px; overflow-y:auto;
            box-shadow:0 10px 28px rgba(15,23,42,.14); display:none; padding:4px; }
        .fn-combo-menu.open { display:block; }
        .fn-combo-opt { padding:8px 11px; font-size:13px; color:#1e293b; border-radius:7px; cursor:pointer; white-space:nowrap;
            overflow:hidden; text-overflow:ellipsis; }
        .fn-combo-opt:hover, .fn-combo-opt.active { background:#eff6ff; color:#2563eb; }
        .fn-combo-opt.hidden { display:none; }
        .fn-combo-empty { padding:8px 11px; font-size:12px; color:#94a3b8; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-combo]').forEach(function (box) {
                var input = box.querySelector('[data-combo-input]');
                var menu  = box.querySelector('[data-combo-menu]');
                if (!input || !menu) return;
                var opts = Array.prototype.slice.call(menu.querySelectorAll('.fn-combo-opt'));
                var active = -1;

                function filter() {
                    var q = input.value.trim().toLowerCase();
                    var shown = 0;
                    opts.forEach(function (o) {
                        var hit = o.getAttribute('data-val').toLowerCase().indexOf(q) !== -1;
                        o.classList.toggle('hidden', !hit);
                        o.classList.remove('active');
                        if (hit) shown++;
                    });
                    active = -1;
                    var empty = menu.querySelector('.fn-combo-empty');
                    if (empty) empty.remove();
                    if (shown === 0) {
                        var e = document.createElement('div');
                        e.className = 'fn-combo-empty';
                        e.textContent = 'Siyahıda yoxdur — yazdığın ünvan istifadə olunacaq.';
                        menu.appendChild(e);
                    }
                }
                function open()  { menu.classList.add('open'); }
                function close() { menu.classList.remove('open'); active = -1; }
                function visible() { return opts.filter(function (o) { return !o.classList.contains('hidden'); }); }

                input.addEventListener('focus', function () { filter(); open(); });
                input.addEventListener('input', function () { filter(); open(); });
                menu.addEventListener('mousedown', function (ev) {
                    var opt = ev.target.closest('.fn-combo-opt');
                    if (!opt) return;
                    ev.preventDefault();
                    input.value = opt.getAttribute('data-val');
                    close();
                });
                input.addEventListener('keydown', function (ev) {
                    var vis = visible();
                    if (ev.key === 'ArrowDown') { ev.preventDefault(); open(); active = Math.min(active + 1, vis.length - 1); }
                    else if (ev.key === 'ArrowUp') { ev.preventDefault(); active = Math.max(active - 1, 0); }
                    else if (ev.key === 'Enter') { if (menu.classList.contains('open') && active >= 0 && vis[active]) { ev.preventDefault(); input.value = vis[active].getAttribute('data-val'); close(); } return; }
                    else if (ev.key === 'Escape') { close(); return; }
                    else return;
                    vis.forEach(function (o) { o.classList.remove('active'); });
                    if (vis[active]) { vis[active].classList.add('active'); vis[active].scrollIntoView({ block: 'nearest' }); }
                });
                document.addEventListener('click', function (ev) { if (!box.contains(ev.target)) close(); });
            });
        })();
    </script>
}
