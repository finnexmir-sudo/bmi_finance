@using FinNex.Application.DTOs.Mektub
@model IList<XaricMektubListDto>
@{
    ViewData["Title"] = "Xaric olan məktublar";
    string D(DateTime? v) => v?.ToString("dd.MM.yyyy") ?? "—";
    string T(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;
    var userId = (int)(ViewBag.UserId ?? 0);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Xaric olan məktublar</div>
            <div class="fn-page-sub">Göndərilən rəsmi məktubların qeydiyyat jurnalı</div>
        </div>
        <a asp-action="Yarat" class="fn-btn fn-btn--primary"><i class="bi bi-plus-lg"></i> Yeni məktub</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="dm-alert dm-alert--ok"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="dm-alert dm-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="fn-card">
    @{
        var filtr = (FinNex.Application.DTOs.Mektub.MektubFiltrDto)ViewBag.Filtr;
        var menbe = (FinNex.Application.DTOs.Mektub.MektubFiltrMenbeDto)ViewBag.Menbe;
        string D2(DateTime? v) => v?.ToString("yyyy-MM-dd") ?? "";

        // Seçilmiş il jurnalda hələ yoxdursa (məs. cari ildə heç bir məktub yazılmayıb)
        // siyahıya əlavə olunur — əks halda açılan siyahı başqa ili seçilmiş göstərərdi.
        var iller = menbe.Iller.ToList();
        if (filtr.Il.HasValue && filtr.Il.Value > 0 && !iller.Contains(filtr.Il.Value))
            iller.Insert(0, filtr.Il.Value);
    }

    @* ── Filtr paneli ── Jurnal on minlərlə sətirdir, ona görə defolt CARİ İLDİR.
         "Bütün illər" (0) yalnız istifadəçi açıq seçəndə yüklənir. *@
    <form method="get" class="mk-filtr">
        <div class="mk-f">
            <label>İl</label>
            <select name="Il" onchange="this.form.submit()">
                @foreach (var y in iller)
                {
                    <option value="@y" selected="@(filtr.Il == y)">@y</option>
                }
                <option value="0" selected="@(filtr.Il == 0)">Bütün illər</option>
            </select>
        </div>

        <div class="mk-f">
            <label>İcraçı</label>
            <select name="IcraciNo" onchange="this.form.submit()">
                <option value="">— hamısı —</option>
                @foreach (var ic in menbe.Icracilar)
                {
                    <option value="@ic.No" selected="@(filtr.IcraciNo == ic.No)">@ic.Goster (@ic.Say)</option>
                }
            </select>
        </div>

        <div class="mk-f">
            <label>Tarixdən</label>
            <input type="date" name="TarixFrom" value="@D2(filtr.TarixFrom)" />
        </div>
        <div class="mk-f">
            <label>Tarixə</label>
            <input type="date" name="TarixTo" value="@D2(filtr.TarixTo)" />
        </div>

        <div class="mk-f mk-f--grow">
            <label>Axtarış</label>
            <input type="text" name="Axtaris" value="@filtr.Axtaris" placeholder="Təyinat, məzmun, qeydiyyat №..." />
        </div>

        <div class="mk-f mk-f--btn">
            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">Axtar</button>
            <a asp-action="Index" class="fn-btn fn-btn--outline fn-btn--sm">Sıfırla</a>
        </div>
    </form>

        <div class="dm-toolbar">
            <div class="dm-hint">@(filtr.ButunIller ? "Bütün illər" : $"{filtr.Il} ili") · Cəmi: <strong>@Model.Count.ToString("N0")</strong> məktub</div>
        </div>

        @if (!Model.Any())
        {
            <div class="dm-empty"><i class="bi bi-inbox"></i> Seçilmiş filtrə uyğun məktub tapılmadı.</div>
        }
        else
        {
            <div class="dm-twrap">
                <table class="dm-table" id="dmTable">
                    <thead>
                        <tr>
                            <th>Qeyd. №</th>
                            <th>Tarix</th>
                            <th>Göndərilən yer</th>
                            <th>Qısa məzmun</th>
                            <th>İcraçı</th>
                            <th>İl</th>
                            <th>Qoşma</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr class="dm-row">
                                <td class="dm-num">@T(m.QeyNom)</td>
                                <td class="dm-dt">@D(m.Tarix)</td>
                                <td class="dm-name">@T(m.GonYer)</td>
                                <td class="dm-txt">@T(m.QisaMez)</td>
                                @* İcraçı: bazada nömrə saxlanılır, adı Isci.IcraciNo-dan tapılır.
                                       Ad tapılmasa xam nömrə göstərilir — məlumat itməsin. *@
                                <td class="dm-ic" title="@(m.IcraciNo.HasValue ? $"İcraçı № {m.IcraciNo}" : null)">@T(m.IcraciGoster)</td>
                                <td class="dm-yr">@(m.Il?.ToString() ?? "—")</td>
                                <td class="dm-att">
                                    @if (!string.IsNullOrEmpty(m.FaylYolu))
                                    {
                                        <a href="/dms/@m.FaylYolu" target="_blank" title="Qoşmanı aç"><i class="bi bi-paperclip"></i></a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td class="dm-ops">
                                    @if (isAdmin || m.YaradanId == userId)
                                    {
                                        <a asp-action="Redakte" asp-route-id="@m.Id" class="dm-op" title="Redaktə et"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Sil" asp-route-id="@m.Id" method="post" class="dm-op-del"
                                              onsubmit="return confirm('Bu məktubu silmək istədiyinizə əminsiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dm-op dm-op--del" title="Sil"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        /* ── Jurnal cədvəli ───────────────────────────────────────────────
           Qeydiyyat jurnalıdır: sıx sətirlər + görünən şəbəkə xətləri lazımdır ki,
           göz sətir boyu sürüşəndə sütunu itirməsin. Əvvəl yalnız açıq üfüqi xətt
           var idi və uzun ünvanlar sətri 3 sətrə qaldırırdı — siyahı kimi görünürdü. */
        .dm-twrap { overflow-x:auto; border:1px solid #dbe2ea; border-radius:10px; }
        .dm-table { width:100%; border-collapse:separate; border-spacing:0; font-size:12.5px; }

        .dm-table thead th {
            position:sticky; top:0; z-index:2;
            background:#eef2f7; color:#334155;
            font-weight:700; font-size:11px; text-transform:uppercase; letter-spacing:.03em;
            text-align:left; padding:9px 10px; white-space:nowrap;
            border-bottom:2px solid #c7d2de; border-right:1px solid #dbe2ea;
        }
        .dm-table thead th:last-child { border-right:none; }

        .dm-table td {
            padding:6px 10px; color:#1e293b; vertical-align:top; line-height:1.35;
            border-bottom:1px solid #eef2f7; border-right:1px solid #f1f5f9;
        }
        .dm-table td:last-child { border-right:none; }
        .dm-table tbody tr:nth-child(even) td { background:#fbfcfe; }
        .dm-table tbody tr:hover td { background:#eff6ff; }
        .dm-table tbody tr:last-child td { border-bottom:none; }

        /* Sütun rolları — sətirlərin hündürlüyü bərabər qalsın */
        .dm-num  { width:88px;  font-weight:700; color:#0f172a; white-space:nowrap;
                   font-variant-numeric:tabular-nums; }
        .dm-dt   { width:92px;  white-space:nowrap; color:#475569;
                   font-variant-numeric:tabular-nums; }
        .dm-name { min-width:240px; max-width:420px; font-weight:600; color:#0f172a; }
        .dm-txt  { min-width:180px; max-width:360px; color:#334155; }
        .dm-mono { white-space:nowrap; font-variant-numeric:tabular-nums; color:#334155; }
        .dm-ic   { width:150px; color:#475569; }
        .dm-yr   { width:56px;  text-align:center; color:#64748b;
                   font-variant-numeric:tabular-nums; }
        .dm-att  { width:60px;  text-align:center; }

        .mk-filtr { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end;
            background:#f8fafc; border:1px solid #e8ecf2; border-radius:10px; padding:12px 14px; margin-bottom:14px; }
        .mk-f { display:flex; flex-direction:column; gap:4px; }
        .mk-f--grow { flex:1; min-width:200px; }
        .mk-f--btn { flex-direction:row; gap:8px; align-items:center; }
        .mk-f label { font-size:11px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:.02em; }
        .mk-f select, .mk-f input { padding:7px 10px; border:1px solid #e2e8f0; border-radius:8px;
            font-size:13px; background:#fff; outline:none; min-width:120px; }
        .mk-f select:focus, .mk-f input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
        .mk-f--grow input { width:100%; }

        .dm-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }

        .dm-hint { font-size:12px; color:#64748b; }
        .dm-empty { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .dm-alert--ok { background:#dcfce7; border:1px solid #bbf7d0; color:#166534; }
        .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
        .dm-ops { white-space:nowrap; text-align:right; }
        .dm-op-del { display:inline; margin:0; }
        .dm-op { display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; margin-left:4px;
            border:1px solid #e2e8f0; border-radius:7px; background:#fff; color:#475569; cursor:pointer; text-decoration:none; font-size:13px; }
        .dm-op:hover { background:#f1f5f9; color:#2563eb; border-color:#cbd5e1; }
        .dm-op--del:hover { background:#fef2f2; color:#dc2626; border-color:#fecaca; }
    </style>
}

