@using FinNex.Application.DTOs.Mektub
@model IList<XaricMektubListDto>
@{
    ViewData["Title"] = "Xaric olan məktublar";
    string D(DateTime? v) => v?.ToString("dd.MM.yyyy") ?? "—";
    string T(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;
}

<div class="fn-page fn-tint">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Xaric olan məktublar</div>
            <div class="fn-page-sub">Göndərilən rəsmi məktubların qeydiyyat jurnalı</div>
        </div>
        <a asp-action="Yarat" class="fn-btn fn-btn--primary"><i class="bi bi-plus-lg"></i> Yeni məktub</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="dm-alert dm-alert--ok"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="dm-alert dm-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="fn-card">
        <div class="dm-toolbar">
            <div class="dm-search">
                <i class="bi bi-search"></i>
                <input type="text" id="dmSearch" placeholder="Təyinat, məzmun, icraçı axtar..." autocomplete="off" />
            </div>
            <div class="dm-hint">Cəmi: @Model.Count məktub</div>
        </div>

        @if (!Model.Any())
        {
            <div class="dm-empty"><i class="bi bi-inbox"></i> Hələ xaric olan məktub yoxdur.</div>
        }
        else
        {
            <div class="dm-twrap">
                <table class="dm-table" id="dmTable">
                    <thead>
                        <tr>
                            <th>Qeyd. №</th>
                            <th>Tarix</th>
                            <th>Göndərilən yer</th>
                            <th>Qısa məzmun</th>
                            <th>İcraçı</th>
                            <th>İl</th>
                            <th>Qoşma</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr class="dm-row" data-search="@($"{m.GonYer} {m.QisaMez} {m.Icraci} {m.QeyNom}".ToLower())">
                                <td class="dm-num">@T(m.QeyNom)</td>
                                <td>@D(m.Tarix)</td>
                                <td class="dm-name">@T(m.GonYer)</td>
                                <td>@T(m.QisaMez)</td>
                                <td>@T(m.Icraci)</td>
                                <td>@(m.Il?.ToString() ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(m.FaylYolu))
                                    {
                                        <a href="/dms/@m.FaylYolu" target="_blank" title="Qoşmanı aç"><i class="bi bi-paperclip"></i></a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .dm-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .dm-search { position:relative; max-width:360px; flex:1; }
        .dm-search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .dm-search input { width:100%; padding:9px 12px 9px 34px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; outline:none; background:#fbfcff; }
        .dm-search input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
        .dm-hint { font-size:12px; color:#64748b; }
        .dm-twrap { overflow-x:auto; }
        .dm-table { width:100%; border-collapse:collapse; font-size:13px; white-space:nowrap; }
        .dm-table thead th { position:sticky; top:0; background:#f1f5f9; color:#475569; font-weight:600; font-size:12px;
            text-align:left; padding:10px 14px; border-bottom:1px solid #e2e8f0; }
        .dm-table td { padding:9px 14px; border-bottom:1px solid #f1f5f9; color:#1e293b; }
        .dm-table tbody tr:hover td { background:#f8fafc; }
        .dm-num { font-weight:700; color:#0f172a; text-align:center; }
        .dm-name { font-weight:600; color:#0f172a; white-space:normal; }
        .dm-empty { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .dm-alert--ok { background:#dcfce7; border:1px solid #bbf7d0; color:#166534; }
        .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('dmSearch');
            if (!inp) return;
            var rows = Array.prototype.slice.call(document.querySelectorAll('#dmTable .dm-row'));
            inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                rows.forEach(function (r) {
                    var hay = r.getAttribute('data-search') || '';
                    r.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
        })();
    </script>
}
