@model GedenHevaleEditDto
@{
    ViewData["Title"] = "Gedən həvaləni redaktə et";
    // Valyuta siyahısı BMI `kurval`-dan gəlir (kod + ad) — controller doldurur.
    // Əvvəl burada sabit massiv var idi ("AZN","USD"…); indi seçilən dəyər KODDUR
    // (kurval.SOKNAMEVALUT: "00","01"…), çünki kurval-da USD/EUR qısaltması yoxdur.
    // Oracle əlçatmaz olsa servis sabit ehtiyat siyahı qaytarır — siyahı boş qalmır.
    var valyutalar = ViewBag.Valyutalar as IList<FinNex.Application.DTOs.Kurval.BmiValyutaDto>
                     ?? new List<FinNex.Application.DTOs.Kurval.BmiValyutaDto>();
    var resTipleri = new[] { "Rezident", "Qeyri-rezident" };
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Gedən həvaləni redaktə et</div>
            <div class="fn-page-sub">Həvalə № @(Model.HevNom ?? "—") — dəyişməz</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="dm-alert dm-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="fn-card" style="max-width:820px">
        <form asp-action="Redakte" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />
            @* maxlength dəyərləri GedenHevale sütun ölçüləridir (AppDbContext
               HasMaxLength; BMI ilə eyni). Limitsiz uzun mətn SQL-də «String or
               binary data would be truncated» ilə bütün yazını sındırırdı —
               real hadisə 27.08.2026 (VM, CONTRAC_NOM 15). Server tərəfdə də
               eyni yoxlama var: GedenHevaleService.UzunluqXetasi. *@
            <div class="dm-grid">
                <div>
                    <label>Tarix</label>
                    <input type="date" name="Tarix" value="@(Model.Tarix?.ToString("yyyy-MM-dd"))" class="fn-input" />
                </div>
                <div>
                    <label>Rezident tipi</label>
                    <select name="TipRes" class="fn-input">
                        <option value="">—</option>
                        @foreach (var r in resTipleri)
                        {
                            <option value="@r" selected="@(Model.TipRes == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="dm-full">
                    <label>Soyad Ad Ata (S.A.A.) *</label>
                    <input type="text" name="Saa" value="@Model.Saa" maxlength="50" class="fn-input" />
                </div>
                <div>
                    <label>Hesab №</label>
                    <input type="text" name="HesNom" value="@Model.HesNom" maxlength="20" class="fn-input" />
                </div>
                <div class="dm-2col">
                    <div>
                        <label>Məbləğ</label>
                        <input type="number" step="0.01" name="Mebleg" value="@(Model.Mebleg?.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="fn-input" />
                    </div>
                    <div>
                        <label>Valyuta</label>
                        <select name="ValTip" class="fn-input">
                            @foreach (var v in valyutalar)
                            {
                                <option value="@v.Kod" selected="@(Model.ValTip == v.Kod)">@v.Goster</option>
                            }
                            @* Köhnə qeydlərdə valyuta mətn kimi saxlanılıb ("USD","EUR",
                               hətta kiril "УСД"). Belə dəyər siyahıda yoxdursa redaktədə
                               İTƏRDİ — ona görə mövcud dəyər olduğu kimi əlavə olunur. *@
                            @if (!string.IsNullOrWhiteSpace(Model.ValTip)
                                 && !valyutalar.Any(x => x.Kod == Model.ValTip))
                            {
                                <option value="@Model.ValTip" selected="selected">@Model.ValTip (köhnə)</option>
                            }
                        </select>
                    </div>
                </div>
                <div>
                    <label>Mənşə ölkə</label>
                    <input type="text" name="MenOlke" value="@Model.MenOlke" maxlength="40" class="fn-input" />
                </div>
                <div>
                    <label>Təyinat ölkə</label>
                    <input type="text" name="Olke" value="@Model.Olke" maxlength="40" class="fn-input" />
                </div>
                <div>
                    <label>Alan bank</label>
                    <input type="text" name="AlBank" value="@Model.AlBank" maxlength="40" class="fn-input" />
                </div>
                <div>
                    <label>Həvalə tipi</label>
                    <input type="text" name="HevTip" value="@Model.HevTip" maxlength="254" class="fn-input" />
                </div>
                <div>
                    <label>Göndərən tipi</label>
                    <input type="text" name="GonTip" value="@Model.GonTip" maxlength="20" class="fn-input" />
                </div>
                <div>
                    <label>Müqavilə №</label>
                    <input type="text" name="ContracNom" value="@Model.ContracNom" maxlength="50" class="fn-input" />
                </div>
                <div>
                    <label>Bəyannamə №</label>
                    <input type="text" name="DeclarNom" value="@Model.DeclarNom" maxlength="50" class="fn-input" />
                </div>
                <div class="dm-full">
                    <label>Sənəd (qoşma) <span style="color:#94a3b8;font-weight:500">— istəyə bağlı</span></label>
                    @if (!string.IsNullOrEmpty(Model.MovcudFaylYolu))
                    {
                        <div style="font-size:12px;margin-bottom:6px">
                            Mövcud qoşma: <a href="/dms/@Model.MovcudFaylYolu" target="_blank"><i class="bi bi-paperclip"></i> aç</a>
                        </div>
                    }
                    <input type="file" name="fayl" class="fn-input" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.tif,.tiff" />
                    <div style="font-size:11px;color:#94a3b8;margin-top:4px">Yeni fayl seçsən köhnəsini əvəz edər. Boş buraxsan mövcud qoşma qalır.</div>
                </div>
            </div>

            <div class="dm-actions">
                <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-save"></i> Yadda saxla</button>
                <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .dm-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px 18px; }
        .dm-grid .dm-full { grid-column:1/-1; }
        .dm-grid .dm-2col { display:grid; grid-template-columns:2fr 1fr; gap:10px; }
        .dm-grid label { display:block; font-size:11px; color:#64748b; font-weight:600; margin-bottom:5px; }
        .dm-actions { display:flex; gap:10px; margin-top:18px; }
        .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
        @@media (max-width:640px) { .dm-grid { grid-template-columns:1fr; } }
    </style>
}
