@{
    ViewData["Title"] = "Silmə Təsdiqi";
}

<div style="display:flex; align-items:center; justify-content:center; min-height:60vh;">
    <div style="background:#fff; border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.12); overflow:hidden; width:100%; max-width:340px;">

        <!-- Qırmızı header -->
        <div style="background:linear-gradient(135deg,#e53935,#b71c1c); padding:28px 0 20px; text-align:center;">
            <div style="width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;">
                <i class="bi bi-trash3-fill" style="font-size:1.6rem;color:#fff;"></i>
            </div>
            <p style="color:rgba(255,255,255,0.85);margin:10px 0 0;font-size:.82rem;letter-spacing:.3px;">SƏNƏD SİLİNMƏSİ</p>
        </div>

        <!-- Məzmun -->
        <div style="padding:24px 28px 8px; text-align:center;">
            <h6 style="font-weight:600;font-size:.95rem;margin-bottom:8px;">Sənədi silmək istəyirsiniz?</h6>
            <p style="color:#888;font-size:.78rem;line-height:1.5;margin:0;">
                Bu əməliyyat sənədi arxivə köçürəcək.<br>Geri qaytarmaq mümkün olmaya bilər.
            </p>
        </div>

        <!-- Düymələr -->
        <div style="padding:20px 28px 28px;">
            <form asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Sil" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@ViewBag.Id" />
                <div style="display:flex;gap:10px;">
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
                       style="flex:1;padding:10px;text-align:center;border-radius:10px;background:#f1f1f1;color:#333;font-size:.83rem;font-weight:500;text-decoration:none;">
                        Xeyr
                    </a>
                    <button type="submit"
                            style="flex:1;padding:10px;border-radius:10px;background:linear-gradient(135deg,#e53935,#b71c1c);color:#fff;border:none;font-size:.83rem;font-weight:500;cursor:pointer;">
                        <i class="bi bi-trash3 me-1"></i>Bəli, Sil
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>