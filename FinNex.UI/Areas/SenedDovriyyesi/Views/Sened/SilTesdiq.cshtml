@{
    ViewData["Title"] = "Silmə Təsdiqi";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sened-dovriyyesi-fn.css" asp-append-version="true" />
}

<div class="fn-page">
    <div class="sd-confirm-wrap">
        <div class="sd-confirm-card">

            <div class="sd-confirm-top">
                <div class="sd-confirm-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M3 6h18M8 6V4h8v2M5 6l1 14h12L19 6" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="sd-confirm-top-title">Sənəd Silinməsi</div>
            </div>

            <div class="sd-confirm-body">
                <div class="sd-confirm-question">Sənədi silmək istəyirsiniz?</div>
                <div class="sd-confirm-desc">
                    Bu əməliyyat sənədi arxivə köçürəcək.<br>
                    Geri qaytarmaq mümkün olmaya bilər.
                </div>
            </div>

            <form asp-area="SenedDovriyyesi" asp-controller="Sened"
                  asp-action="Sil" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@ViewBag.Id" />
                <div class="sd-confirm-footer">
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
                       class="fn-btn fn-btn--outline" style="flex:1;justify-content:center;">Xeyr</a>
                    <button type="submit" class="fn-btn str-btn-danger" style="flex:1;justify-content:center;">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M2 3h9M5 3V2h3v1M4 3l.5 8M9 3l-.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                        </svg>
                        Bəli, Sil
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
