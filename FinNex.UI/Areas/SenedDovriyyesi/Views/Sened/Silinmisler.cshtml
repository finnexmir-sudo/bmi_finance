@model SenedListVM
@{
    ViewData["Title"] = "Silinmiş Sənədlər";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sened-dovriyyesi-fn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/struktur.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Silinmiş Sənədlər</div>
            <div class="fn-page-sub">Cəmi <strong>@Model.TotalCount</strong> sənəd</div>
        </div>
        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
           class="fn-btn fn-btn--outline">
            ← Siyahıya qayıt
        </a>
    </div>

    <!-- Cədvəl -->
    <div class="sd-table-wrap">
        <table class="sd-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Başlıq</th>
                    <th>Şöbə</th>
                    <th>Növ</th>
                    <th>Status</th>
                    <th>Fayl</th>
                    <th>Tarix</th>
                    <th class="isci-th-right">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Senedler.Any())
                {
                    @foreach (var s in Model.Senedler)
                    {
                        <tr>
                            <td><span class="sd-table-id">#@s.Id</span></td>
                            <td>
                                <div class="sd-table-title">@s.Basliq</div>
                                @if (!string.IsNullOrEmpty(s.AcarSoz))
                                {
                                    <div class="sd-table-sub">
                                        @(s.AcarSoz.Length > 45 ? s.AcarSoz.Substring(0, 45) + "..." : s.AcarSoz)
                                    </div>
                                }
                            </td>
                            <td><span class="str-dept-tag">@s.Sobe</span></td>
                            <td><span style="font-size:12px;color:#5a647a;font-weight:500;">@s.SenedNovu</span></td>
                            <td>
                                @{
                                    var bc = s.Status switch
                                    {
                                        SenedStatusu.Yeni => "sd-badge--yeni",
                                        SenedStatusu.Yoxlanilir => "sd-badge--yoxlanilir",
                                        SenedStatusu.Tesdiq => "sd-badge--tesdiq",
                                        SenedStatusu.Arxiv => "sd-badge--arxiv",
                                        _ => "sd-badge--arxiv"
                                    };
                                    var bt = s.Status switch
                                    {
                                        SenedStatusu.Yeni => "Yeni",
                                        SenedStatusu.Yoxlanilir => "Yoxlanılır",
                                        SenedStatusu.Tesdiq => "Təsdiqlənmiş",
                                        SenedStatusu.Arxiv => "Arxiv",
                                        _ => "—"
                                    };
                                }
                                <span class="sd-badge @bc">@bt</span>
                            </td>
                            <td>
                                <span class="sd-file-badge">
                                    <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
                                        <path d="M2 1h5l2 2v7H2V1z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
                                    </svg>
                                    @s.FaylSayi
                                </span>
                            </td>
                            <td style="font-size:12px;color:#8a93a8;">@s.YaradilmaTarixi.ToString("dd.MM.yyyy")</td>
                            <td class="isci-td-actions">
                                <a asp-area="SenedDovriyyesi" asp-controller="Sened"
                                   asp-action="DetalSilinmis" asp-route-id="@s.Id"
                                   class="isci-action-btn" title="Bax">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                        <ellipse cx="7" cy="7" rx="5.5" ry="3.5" stroke="currentColor" stroke-width="1.2" />
                                        <circle cx="7" cy="7" r="1.5" fill="currentColor" />
                                    </svg>
                                </a>
                                <form asp-area="SenedDovriyyesi" asp-controller="Sened"
                                      asp-action="BerpaEt" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="isci-action-btn" title="Bərpa et"
                                            style="color:#16a34a;">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M2 7a5 5 0 0 1 5-5 5 5 0 0 1 3.5 1.5L12 1v4H8l1.5-1.5A3 3 0 0 0 7 4a3 3 0 0 0-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                                            <path d="M4 9a3 3 0 0 0 3 2 3 3 0 0 0 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="sd-table-empty">
                            Silinmiş sənəd yoxdur
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="sd-pagination">
                @if (Model.Page > 1)
                {
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Silinmisler"
                       asp-route-page="@(Model.Page - 1)" class="sd-page-btn">←</a>
                }
                @{
                    var sp = Math.Max(1, Model.Page - 2);
                    var ep = Math.Min(Model.TotalPages, Model.Page + 2);
                }
                @for (int i = sp; i <= ep; i++)
                {
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Silinmisler"
                       asp-route-page="@i"
                       class="sd-page-btn @(i == Model.Page ? "sd-page-btn--active" : "")">@i</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Silinmisler"
                       asp-route-page="@(Model.Page + 1)" class="sd-page-btn">→</a>
                }
            </div>
        }
    </div>
</div>
