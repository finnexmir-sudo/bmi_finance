@model SenedNovleriVM
@{
    ViewData["Title"] = "Sənəd Növləri";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sened-dovriyyesi-fn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/struktur.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Sənəd Növləri</div>
            <div class="fn-page-sub">Cəmi <strong>@Model.Novler.Count</strong> növ</div>
        </div>
        <button type="button" class="fn-btn fn-btn--primary" id="openNovBtn">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            Yeni Sənəd Növü
        </button>
    </div>

    <!-- Filter -->
    <div class="sd-filter-bar">
        <select id="sobeFilter" class="sd-select" data-action="nov-filter">
            <option value="">Bütün şöbələr</option>
            @foreach (var s in Model.Sobeler)
            {
                <option value="@s.Id">@s.Ad</option>
            }
        </select>
        <input type="text" id="searchInput" class="sd-search-input"
               placeholder="Kod və ya ad ilə axtar..."
               data-action="nov-search" />
    </div>

    <!-- Cədvəl -->
    <div class="sd-table-wrap">
        <table class="sd-table" id="novTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kod</th>
                    <th>Ad</th>
                    <th>Şöbə</th>
                    <th>Status</th>
                    <th>Tarix</th>
                    <th class="isci-th-right">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Novler.Any())
                {
                    @foreach (var n in Model.Novler)
                    {
                        <tr data-sobe="@n.SobeId" data-kod="@n.Kod.ToLower()" data-ad="@n.Ad.ToLower()">
                            <td><span class="sd-table-id">#@n.Id</span></td>
                            <td>
                                <span class="str-dept-tag">@n.Kod</span>
                            </td>
                            <td><div class="sd-table-title">@n.Ad</div></td>
                            <td><span style="font-size:12px;color:#5a647a;">@n.DepartmentAd</span></td>
                            <td>
                                @if (n.Aktiv)
                                {
                                    <span class="fn-badge fn-badge--done">Aktiv</span>
                                }
                                else
                                {
                                    <span class="fn-badge fn-badge--rejected">Deaktiv</span>
                                }
                            </td>
                            <td style="font-size:12px;color:#8a93a8;">@n.YaradilmaTarixi.ToString("dd.MM.yyyy")</td>
                            <td class="isci-td-actions">
                                <button type="button" class="isci-action-btn"
                                        title="Redaktə et"
                                        onclick="openEditNov(@n.Id, '@n.Ad.Replace("'", "\\'")') ">
                                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                        <path d="M9 2l2 2-6.5 6.5H2.5v-2L9 2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                                    </svg>
                                </button>
                                <form asp-area="SenedDovriyyesi" asp-controller="Sened"
                                      asp-action="SenedNovuAktivDeyis" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="isci-action-btn"
                                            title="@(n.Aktiv ? "Deaktiv et" : "Aktivləşdir")">
                                        @if (n.Aktiv)
                                        {
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                <circle cx="7" cy="7" r="5.5" stroke="#e8b84b" stroke-width="1.3" />
                                                <path d="M5 7h4" stroke="#e8b84b" stroke-width="1.3" stroke-linecap="round" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                                <circle cx="7" cy="7" r="5.5" stroke="#16a34a" stroke-width="1.3" />
                                                <path d="M5 7l2 2 3-3" stroke="#16a34a" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        }
                                    </button>
                                </form>
                                <form asp-area="SenedDovriyyesi" asp-controller="Sened"
                                      asp-action="SenedNovuSil" method="post"
                                      data-action="nov-delete-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="isci-action-btn str-action-btn--red"
                                            title="Sil">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                            <path d="M2 3.5h10M5 3.5V2.5h4v1M4.5 3.5l.5 8M9.5 3.5l-.5 8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                                        </svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr id="emptyRow">
                        <td colspan="7" class="sd-table-empty">Hələ sənəd növü əlavə edilməyib</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Yeni Növ Modal (Bootstrap) -->
<div class="modal fade" id="novModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Yeni Sənəd Növü</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="novError" class="alert alert-danger" hidden></p>
                <div style="margin-bottom:16px;">
                    <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Şöbə *</label>
                    <select id="novSobe" class="form-select">
                        <option value="">Şöbə seçin...</option>
                        @foreach (var s in Model.Sobeler)
                        {
                            <option value="@s.Id">@s.Ad</option>
                        }
                    </select>
                </div>
                <div>
                    <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Ad *</label>
                    <input type="text" id="novAd" class="form-control" placeholder="Məs: Müqavilə, Ərizə..." />
                    <small style="color:#8b95a5">Kod avtomatik yaranacaq</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Ləğv et</button>
                <button type="button" class="btn btn-primary" id="saveBtn">Saxla</button>
            </div>
        </div>
    </div>
</div>

<!-- Redaktə Modal (Bootstrap) -->
<div class="modal fade" id="editNovModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sənəd Növünü Redaktə Et</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="editError" class="alert alert-danger" hidden></p>
                <input type="hidden" id="editNovId" />
                <div>
                    <label style="font-size:13px;font-weight:600;display:block;margin-bottom:6px;">Ad *</label>
                    <input type="text" id="editNovAd" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Ləğv et</button>
                <button type="button" class="btn btn-primary" id="editSaveBtn">Yadda saxla</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    // Yeni növ modalı aç
    document.getElementById('openNovBtn')?.addEventListener('click', function() {
        document.getElementById('novAd').value = '';
        document.getElementById('novError').hidden = true;
        new bootstrap.Modal(document.getElementById('novModal')).show();
    });

    // Yeni növ yarat
    document.getElementById('saveBtn')?.addEventListener('click', function() {
        var sobe = document.getElementById('novSobe').value;
        var ad = document.getElementById('novAd').value.trim();
        var err = document.getElementById('novError');
        err.hidden = true;

        if (!sobe) { err.textContent = 'Şöbə seçin.'; err.hidden = false; return; }
        if (!ad) { err.textContent = 'Ad yazın.'; err.hidden = false; return; }

        fetch('/SenedDovriyyesi/Sened/YeniSenedNovu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ departmentId: parseInt(sobe), ad: ad })
        }).then(r => r.json()).then(d => {
            if (!d.success) { err.textContent = d.message; err.hidden = false; return; }
            location.reload();
        });
    });

    // Redaktə modal aç
    function openEditNov(id, ad) {
        document.getElementById('editNovId').value = id;
        document.getElementById('editNovAd').value = ad;
        document.getElementById('editError').hidden = true;
        new bootstrap.Modal(document.getElementById('editNovModal')).show();
    }

    // Redaktə yadda saxla
    document.getElementById('editSaveBtn')?.addEventListener('click', function() {
        var id = parseInt(document.getElementById('editNovId').value);
        var ad = document.getElementById('editNovAd').value.trim();
        var err = document.getElementById('editError');
        err.hidden = true;

        if (!ad) { err.textContent = 'Ad boş ola bilməz.'; err.hidden = false; return; }

        fetch('/SenedDovriyyesi/Sened/SenedNovuRedakte', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: id, ad: ad })
        }).then(r => r.json()).then(d => {
            if (!d.success) { err.textContent = d.message; err.hidden = false; return; }
            location.reload();
        });
    });

    // Filter JS
    var sobeFilter = document.getElementById('sobeFilter');
    var searchInput = document.getElementById('searchInput');
    var rows = document.querySelectorAll('#novTable tbody tr[data-sobe]');

    function filterRows() {
        var sobe = sobeFilter.value;
        var q = searchInput.value.toLowerCase();
        rows.forEach(function(r) {
            var matchSobe = !sobe || r.dataset.sobe === sobe;
            var matchSearch = !q || r.dataset.kod.indexOf(q) >= 0 || r.dataset.ad.indexOf(q) >= 0;
            r.style.display = matchSobe && matchSearch ? '' : 'none';
        });
    }
    sobeFilter?.addEventListener('change', filterRows);
    searchInput?.addEventListener('input', filterRows);
    </script>
}
