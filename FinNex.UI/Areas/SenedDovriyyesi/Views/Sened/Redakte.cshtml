@model FinNex.UI.Areas.SenedDovriyyesi.ViewModels.SenedUpdateVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Sənədi Redaktə Et";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sened-dovriyyesi-fn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hr/struktur.css" asp-append-version="true" />
}

<div class="fn-page">

    <a asp-area="SenedDovriyyesi" asp-controller="Sened"
       asp-action="Detal" asp-route-id="@Model.Id"
       class="sd-back">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M9 11L5 7l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Detala qayıt
    </a>

    @if (TempData["Error"] != null)
    {
        <div class="sd-alert-error" style="margin-bottom:14px;">@TempData["Error"]</div>
    }

    <form asp-action="Redakte" asp-controller="Sened" method="post" id="updateForm" novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="sd-detail-grid">

            <!-- Sol: Əsas form -->
            <div class="sd-form-card">
                <div class="sd-form-hdr">
                    <div class="sd-form-hdr-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M13 3l4 4-9 9H4v-4L13 3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div>
                        <div class="sd-form-hdr-title">Sənədi Redaktə Et</div>
                        <div class="sd-form-hdr-sub">@Model.Basliq</div>
                    </div>
                </div>

                <div class="sd-form-body">
                    <div asp-validation-summary="ModelOnly" class="sd-alert-error"></div>

                    <!-- 1. Struktur -->
                    <div>
                        <div class="sd-form-hdr-sub" style="font-size:10px;text-transform:uppercase;letter-spacing:.6px;font-weight:700;color:#e8b84b;margin-bottom:12px;">
                            1 · Struktur Məlumatları
                        </div>
                        <div class="sd-form-row">
                            <div>
                                <label class="sd-label">Şöbə <span class="sd-required">*</span></label>
                                <select asp-for="SobeId"
                                        asp-items="@(ViewBag.Sobeler as SelectList)"
                                        class="sd-select-full">
                                    <option value="">— Şöbə seçin —</option>
                                </select>
                                <span asp-validation-for="SobeId" class="sd-error"></span>
                            </div>
                            <div>
                                <label class="sd-label">Sənəd Növü <span class="sd-required">*</span></label>
                                <select asp-for="SenedNovuId"
                                        asp-items="@(ViewBag.SenedNovleri as SelectList)"
                                        class="sd-select-full">
                                    <option value="">— Növ seçin —</option>
                                </select>
                                <span asp-validation-for="SenedNovuId" class="sd-error"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Əsas məlumatlar -->
                    <div>
                        <div class="sd-form-hdr-sub" style="font-size:10px;text-transform:uppercase;letter-spacing:.6px;font-weight:700;color:#e8b84b;margin-bottom:12px;">
                            2 · Əsas Məlumatlar
                        </div>
                        <div style="display:flex;flex-direction:column;gap:12px;">
                            <div>
                                <label class="sd-label">Başlıq <span class="sd-required">*</span></label>
                                <input asp-for="Basliq" class="sd-input"
                                       placeholder="Sənədin tam başlığını daxil edin..." />
                                <span asp-validation-for="Basliq" class="sd-error"></span>
                            </div>
                            <div>
                                <label class="sd-label">
                                    Açar Söz
                                    <span style="font-size:10px;color:#aab0bf;font-weight:400;">(axtarış üçün)</span>
                                </label>
                                <input asp-for="AcarSoz" class="sd-input"
                                       placeholder="Vergüllə ayrılmış açar sözlər..." />
                                <span asp-validation-for="AcarSoz" class="sd-error"></span>
                                <span style="font-size:11px;color:#aab0bf;margin-top:4px;display:block;">
                                    Nümunə: müqavilə, qaydalar, maliyyə, 2024
                                </span>
                            </div>

                            <div>
                                <label class="sd-label">Kateqoriya</label>
                                <select asp-for="Kateqoriya" class="sd-select-full">
                                    <option value="@FinNex.Domain.Entities.SenedDovriyyesi.SenedKateqoriyasi.Umumi">Umumi — hər kəsə açıq</option>
                                    <option value="@FinNex.Domain.Entities.SenedDovriyyesi.SenedKateqoriyasi.Xususi">Xususi — yalnız şöbəyə açıq</option>
                                </select>
                                <small style="font-size:11px;color:#aab0bf;margin-top:4px;display:block;">Xususi seçilsə yalnız yaradan və şöbə işçilərinə görünür.</small>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Teqlər -->
                    @if (ViewBag.Tags != null)
                    {
                        <div>
                            <div class="sd-form-hdr-sub" style="font-size:10px;text-transform:uppercase;letter-spacing:.6px;font-weight:700;color:#e8b84b;margin-bottom:12px;">
                                3 · Teqlər
                                <span style="font-size:10px;color:#aab0bf;font-weight:400;">(istəyə bağlı)</span>
                            </div>
                            <div style="display:flex;flex-wrap:wrap;gap:8px;">
                                @foreach (var tag in ViewBag.Tags as List<dynamic> ?? new List<dynamic>())
                                {
                                    var isChecked = Model.TagIds != null && Model.TagIds.Contains((int)tag.Id);
                                    <label class="str-checkbox-label" style="cursor:pointer;">
                                        <input type="checkbox" name="TagIds" value="@tag.Id"
                                               class="str-checkbox" @(isChecked ? "checked" : "") />
                                        @tag.Ad
                                    </label>
                                }
                            </div>
                        </div>
                    }

                </div>

                <div class="sd-form-footer">
                    <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
                       class="fn-btn fn-btn--outline">Ləğv et</a>
                    <button type="submit" class="fn-btn fn-btn--primary" id="submitBtn">
                        <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                            <path d="M2 7l3.5 3.5 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Yadda Saxla
                    </button>
                </div>
            </div>

            <!-- Sağ: Məlumat paneli -->
            <div style="display:flex;flex-direction:column;gap:14px;">

                <!-- Cari fayl -->
                <div class="sd-detail-card">
                    <div class="sd-detail-card-hdr">
                        <div class="sd-detail-card-title">Cari Fayl</div>
                    </div>
                    <div class="sd-detail-body">
                        <div class="sd-file-row">
                            <div class="sd-file-row-icon">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                    <path d="M3 2h6l3 3v8H3V2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                                    <path d="M9 2v3h3" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div>
                                <div class="sd-file-row-name">@(ViewBag.CurrentFileName ?? "—")</div>
                                <div class="sd-file-row-size">@(ViewBag.CurrentFileSize ?? "—") · Dəyişdirilmir</div>
                            </div>
                        </div>
                        <div style="background:rgba(99,102,241,0.07);border:1px solid rgba(99,102,241,0.15);border-radius:8px;padding:10px 12px;font-size:12px;color:#4338ca;margin-top:10px;">
                            Redaktə zamanı fayl dəyişdirilmir. Yeni versiya yükləmək üçün
                            <a asp-area="SenedDovriyyesi" asp-controller="Sened"
                               asp-action="YeniVersiya" asp-route-id="@Model.Id"
                               style="color:#4338ca;font-weight:600;">buraya klik edin</a>.
                        </div>
                    </div>
                </div>

                <!-- Sistem məlumatı -->
                <div class="sd-detail-card">
                    <div class="sd-detail-card-hdr">
                        <div class="sd-detail-card-title">Sistem Məlumatı</div>
                    </div>
                    <div class="sd-detail-body">
                        <div class="sd-meta-row">
                            <div class="sd-meta-key">ID</div>
                            <div class="sd-meta-val"><span class="sd-table-id">#@Model.Id</span></div>
                        </div>
                        <div class="sd-meta-row">
                            <div class="sd-meta-key">Yaradılma</div>
                            <div class="sd-meta-val">@(ViewBag.YaradilmaTarixi ?? "—")</div>
                        </div>
                        <div class="sd-meta-row">
                            <div class="sd-meta-key">Son dəyişiklik</div>
                            <div class="sd-meta-val">@(ViewBag.SonDeyisiklik ?? "—")</div>
                        </div>
                    </div>
                </div>

                <!-- Sil -->
                <div class="sd-detail-card">
                    <div class="sd-detail-card-hdr">
                        <div class="sd-detail-card-title" style="color:#dc2626;">Təhlükəli Zona</div>
                    </div>
                    <div class="sd-detail-body">
                        <a asp-area="SenedDovriyyesi" asp-controller="Sened"
                           asp-action="SilTesdiq" asp-route-id="@Model.Id"
                           class="fn-btn str-btn-danger" style="width:100%;justify-content:center;">
                            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                                <path d="M2 3h9M5 3V2h3v1M4 3l.5 8M9 3l-.5 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                            </svg>
                            Sənədi Sil
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('updateForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.textContent = 'Saxlanılır...';
        });
    </script>
}
