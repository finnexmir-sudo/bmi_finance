@model SenedCreateVM

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sd-form-card">
            <div class="sd-form-header">
                <i class="bi bi-file-earmark-plus me-2"></i>Yeni Sənəd Yaradın
            </div>
            <div class="sd-form-body">
                <form asp-area="SenedDovriyyesi"
                      asp-controller="Sened"
                      asp-action="Yarat"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <!-- Şöbə -->
                        <div class="col-md-6">
                            <label class="form-label">Şöbə *</label>
                            <select asp-for="SobeId" class="form-select" id="sobeSelect">
                                <option value="">Şöbə seçin...</option>
                                @foreach (var s in Model.Sobeler)
                                {
                                    <option value="@s.Id">@s.Ad</option>
                                }
                            </select>
                        </div>

                        <!-- Sənəd Növü -->
                        <div class="col-md-6">
                            <label class="form-label d-flex justify-content-between">
                                <span>Sənəd Növü *</span>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="openNovModal()">
                                    + Yeni
                                </button>
                            </label>

                            <select asp-for="SenedNovuId"
                                    class="form-select"
                                    id="senedNovuSelect">
                                <option value="">Sənəd növü seçin...</option>
                            </select>
                        </div>

                        <!-- Başlıq -->
                        <div class="col-12">
                            <label class="form-label">Başlıq *</label>
                            <input asp-for="Basliq" class="form-control" />
                        </div>

                        <!-- Fayl -->
                        <div class="col-12">
                            <label class="form-label">Fayl *</label>
                            <input type="file" name="Fayl" class="form-control" />
                        </div>

                        <!-- Açar söz -->
                        <div class="col-12">
                            <label class="form-label">Açar söz *</label>
                            <input asp-for="AcarSoz" class="form-control" />
                        </div>

                        <div class="col-12 text-end mt-3">
                            <button type="submit" class="btn btn-primary">
                                Yarat
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL ================= -->

<div class="modal fade" id="novModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Yeni Sənəd Növü</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div id="novError"
                     class="alert alert-danger d-none"></div>

                <div class="mb-3">
                    <label class="form-label">Kod</label>
                    <input type="text"
                           id="novKod"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Ad</label>
                    <input type="text"
                           id="novAd"
                           class="form-control" />
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Ləğv et
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="saveNov()">
                    Saxla
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>

        // Şöbə dəyişəndə növləri yüklə
        document.getElementById('sobeSelect')
            .addEventListener('change', function () {

                var sobeId = this.value;
                var select = document.getElementById('senedNovuSelect');

                select.innerHTML = '<option>Yüklənir...</option>';

                if (!sobeId) {
                    select.innerHTML = '<option value="">Sənəd növü seçin...</option>';
                    return;
                }

                fetch('@Url.Action("SenedNovleriByShobe", "Sened", new { area = "SenedDovriyyesi" })?sobeId=' + sobeId)
                    .then(r => r.json())
                    .then(data => {

                        select.innerHTML = '<option value="">Sənəd növü seçin...</option>';

                        data.forEach(x => {
                            var opt = document.createElement("option");
                            opt.value = x.id;
                            opt.textContent = x.ad;
                            select.appendChild(opt);
                        });
                    });
            });


        function openNovModal() {

            var sobeId = document.getElementById("sobeSelect").value;

            if (!sobeId) {
                alert("Əvvəlcə şöbə seçin.");
                return;
            }

            document.getElementById("novKod").value = "";
            document.getElementById("novAd").value = "";
            document.getElementById("novError").classList.add("d-none");

            new bootstrap.Modal(document.getElementById('novModal')).show();
        }


        function saveNov() {

            var sobeId = document.getElementById("sobeSelect").value;
            var kod = document.getElementById("novKod").value;
            var ad = document.getElementById("novAd").value;

            fetch('@Url.Action("YeniSenedNovu", "Sened", new { area = "SenedDovriyyesi" })', {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken":
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    sobeId: sobeId,
                    kod: kod,
                    ad: ad
                })
            })
                .then(r => r.json())
                .then(data => {

                    if (!data.success) {
                        var err = document.getElementById("novError");
                        err.innerText = data.message;
                        err.classList.remove("d-none");
                        return;
                    }

                    var select = document.getElementById("senedNovuSelect");
                    var opt = document.createElement("option");
                    opt.value = data.id;
                    opt.textContent = data.ad;
                    opt.selected = true;
                    select.appendChild(opt);

                    bootstrap.Modal.getInstance(
                        document.getElementById('novModal')
                    ).hide();
                });
        }

    </script>
}
