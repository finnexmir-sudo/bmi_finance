@model SenedCreateVM

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sd-form-card">
            <div class="sd-form-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="sd-detail-icon" style="width:36px;height:36px;font-size:1rem;">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Yeni Sənəd Yaradın</div>
                        <div class="text-muted" style="font-size:0.75rem;font-weight:400;">
                            Bütün məcburi sahələri doldurun
                        </div>
                    </div>
                </div>
            </div>
            <div class="sd-form-body">

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="sd-validation-summary alert alert-danger"></div>

                <form asp-area="SenedDovriyyesi"
                      asp-controller="Sened"
                      asp-action="Yarat"
                      method="post"
                      enctype="multipart/form-data"
                      id="senedForm">

                    @Html.AntiForgeryToken()

                    <!-- Step 1: Şöbə & Sənəd Növü -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">1</span>
                            Kateqoriya Seçimi
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label sd-form-label">Şöbə *</label>
                                <select asp-for="SobeId" class="form-select" id="sobeSelect">
                                    <option value="">Şöbə seçin...</option>
                                    @foreach (var s in Model.Sobeler)
                                    {
                                        <option value="@s.Id">@s.Ad</option>
                                    }
                                </select>
                                <span asp-validation-for="SobeId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label sd-form-label d-flex justify-content-between align-items-center">
                                    <span>Sənəd Növü *</span>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary sd-btn-inline"
                                            onclick="openNovModal()">
                                        <i class="bi bi-plus-lg me-1"></i>Yeni Növ
                                    </button>
                                </label>
                                <select asp-for="SenedNovuId" class="form-select" id="senedNovuSelect">
                                    <option value="">Əvvəlcə şöbə seçin...</option>
                                </select>
                                <span asp-validation-for="SenedNovuId" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Sənəd Məlumatları -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">2</span>
                            Sənəd Məlumatları
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label sd-form-label">Başlıq *</label>
                                <input asp-for="Basliq" class="form-control"
                                       placeholder="Sənədin başlığını daxil edin..." />
                                <span asp-validation-for="Basliq" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label sd-form-label">Açar Söz *</label>
                                <input asp-for="AcarSoz" class="form-control"
                                       placeholder="Axtarış üçün açar sözlər (vergüllə ayırın)..." />
                                <span asp-validation-for="AcarSoz" class="text-danger small"></span>
                                <div class="form-text">Sənədi tapmaq üçün istifadə olunacaq açar sözlər</div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Fayl Yükləmə -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">3</span>
                            Fayl Yükləmə
                        </div>

                        <div class="sd-file-drop-zone" id="dropZone">
                            <input type="file" name="Fayl" class="sd-file-input" id="fileInput"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.txt,.zip,.rar" />
                            <div class="sd-file-drop-content" id="dropContent">
                                <i class="bi bi-cloud-arrow-up sd-file-drop-icon"></i>
                                <div class="sd-file-drop-text">Faylı buraya sürüşdürün və ya klikləyin</div>
                                <div class="sd-file-drop-hint">PDF, Word, Excel, Şəkil, ZIP, RAR (Maks. 25MB)</div>
                            </div>
                            <div class="sd-file-preview-box d-none" id="filePreviewBox">
                                <div class="sd-file-preview-info">
                                    <div class="sd-file-icon" id="fileIcon">
                                        <i class="bi bi-file-earmark"></i>
                                    </div>
                                    <div class="sd-file-details">
                                        <div class="sd-file-name" id="fileName"></div>
                                        <div class="sd-file-meta" id="fileMeta"></div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger sd-file-remove"
                                            onclick="removeFile()">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="sd-form-actions">
                        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Geri
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="bi bi-check-lg me-1"></i>Sənədi Yarat
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Yeni Sənəd Növü -->
<div class="modal fade" id="novModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content sd-modal">
            <div class="modal-header sd-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Sənəd Növü
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="novError" class="alert alert-danger d-none"></div>
                <div class="mb-3">
                    <label class="form-label sd-form-label">Kod *</label>
                    <input type="text" id="novKod" class="form-control"
                           placeholder="Məs: MUQAVILE" />
                    <div class="form-text">Avtomatik böyük hərfə çevriləcək</div>
                </div>
                <div class="mb-3">
                    <label class="form-label sd-form-label">Ad *</label>
                    <input type="text" id="novAd" class="form-control"
                           placeholder="Məs: Müqavilə" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Ləğv et
                </button>
                <button type="button" class="btn btn-primary" onclick="saveNov()" id="saveNovBtn">
                    <i class="bi bi-check-lg me-1"></i>Saxla
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ========================
        // Şöbə dəyişəndə növləri yüklə
        // ========================
        document.getElementById('sobeSelect').addEventListener('change', function () {
            var sobeId = this.value;
            var select = document.getElementById('senedNovuSelect');

            if (!sobeId) {
                select.innerHTML = '<option value="">Əvvəlcə şöbə seçin...</option>';
                return;
            }

            select.innerHTML = '<option value="">Yüklənir...</option>';

            fetch('@Url.Action("SenedNovleriByShobe", "Sened", new { area = "SenedDovriyyesi" })?sobeId=' + sobeId)
                .then(r => r.json())
                .then(data => {
                    select.innerHTML = '<option value="">Sənəd növü seçin...</option>';
                    data.forEach(x => {
                        var opt = document.createElement("option");
                        opt.value = x.id;
                        opt.textContent = x.ad;
                        select.appendChild(opt);
                    });

                    if (data.length === 0) {
                        select.innerHTML = '<option value="">Bu şöbədə növ yoxdur</option>';
                    }
                });
        });

        // ========================
        // Yeni Sənəd Növü Modal
        // ========================
        function openNovModal() {
            var sobeId = document.getElementById("sobeSelect").value;
            if (!sobeId) {
                alert("Əvvəlcə şöbə seçin.");
                return;
            }
            document.getElementById("novKod").value = "";
            document.getElementById("novAd").value = "";
            document.getElementById("novError").classList.add("d-none");
            new bootstrap.Modal(document.getElementById('novModal')).show();
        }

        function saveNov() {
            var sobeId = document.getElementById("sobeSelect").value;
            var kod = document.getElementById("novKod").value;
            var ad = document.getElementById("novAd").value;
            var errEl = document.getElementById("novError");
            errEl.classList.add("d-none");

            if (!kod.trim() || !ad.trim()) {
                errEl.innerText = "Kod və ad boş ola bilməz.";
                errEl.classList.remove("d-none");
                return;
            }

            var btn = document.getElementById("saveNovBtn");
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Saxlanılır...';

            fetch('@Url.Action("YeniSenedNovu", "Sened", new { area = "SenedDovriyyesi" })', {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken":
                        document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ sobeId: parseInt(sobeId), kod: kod, ad: ad })
            })
            .then(r => r.json())
            .then(data => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Saxla';

                if (!data.success) {
                    errEl.innerText = data.message;
                    errEl.classList.remove("d-none");
                    return;
                }

                var select = document.getElementById("senedNovuSelect");
                var opt = document.createElement("option");
                opt.value = data.id;
                opt.textContent = data.ad;
                opt.selected = true;
                select.appendChild(opt);

                bootstrap.Modal.getInstance(document.getElementById('novModal')).hide();
            })
            .catch(function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Saxla';
                errEl.innerText = "Xəta baş verdi.";
                errEl.classList.remove("d-none");
            });
        }

        // ========================
        // Fayl Yükləmə (Drag & Drop + Click)
        // ========================
        var dropZone = document.getElementById('dropZone');
        var fileInput = document.getElementById('fileInput');
        var maxSize = 25 * 1024 * 1024;

        dropZone.addEventListener('click', function (e) {
            if (e.target.closest('.sd-file-remove')) return;
            fileInput.click();
        });

        dropZone.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropZone.classList.add('sd-file-drop-active');
        });

        dropZone.addEventListener('dragleave', function () {
            dropZone.classList.remove('sd-file-drop-active');
        });

        dropZone.addEventListener('drop', function (e) {
            e.preventDefault();
            dropZone.classList.remove('sd-file-drop-active');
            if (e.dataTransfer.files.length > 0) {
                fileInput.files = e.dataTransfer.files;
                showFilePreview(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) {
                showFilePreview(this.files[0]);
            }
        });

        function showFilePreview(file) {
            if (file.size > maxSize) {
                alert('Fayl ölçüsü 25MB-dan böyük ola bilməz.');
                fileInput.value = '';
                return;
            }

            document.getElementById('dropContent').classList.add('d-none');
            document.getElementById('filePreviewBox').classList.remove('d-none');

            document.getElementById('fileName').textContent = file.name;

            var sizeStr = file.size > 1024 * 1024
                ? (file.size / (1024 * 1024)).toFixed(1) + ' MB'
                : (file.size / 1024).toFixed(1) + ' KB';
            document.getElementById('fileMeta').textContent = sizeStr + ' | ' + file.type;

            var iconEl = document.getElementById('fileIcon');
            var ext = file.name.split('.').pop().toLowerCase();
            var iconClass = 'bi-file-earmark';
            var iconColor = '#6c757d';

            if (ext === 'pdf') { iconClass = 'bi-file-earmark-pdf-fill'; iconColor = '#dc3545'; }
            else if (['doc', 'docx'].includes(ext)) { iconClass = 'bi-file-earmark-word-fill'; iconColor = '#0d6efd'; }
            else if (['xls', 'xlsx'].includes(ext)) { iconClass = 'bi-file-earmark-excel-fill'; iconColor = '#198754'; }
            else if (['jpg', 'jpeg', 'png', 'gif'].includes(ext)) { iconClass = 'bi-file-earmark-image-fill'; iconColor = '#e8a317'; }
            else if (['zip', 'rar'].includes(ext)) { iconClass = 'bi-file-earmark-zip-fill'; iconColor = '#6c757d'; }

            iconEl.innerHTML = '<i class="bi ' + iconClass + '"></i>';
            iconEl.style.color = iconColor;
        }

        function removeFile() {
            fileInput.value = '';
            document.getElementById('dropContent').classList.remove('d-none');
            document.getElementById('filePreviewBox').classList.add('d-none');
        }
    </script>
}
