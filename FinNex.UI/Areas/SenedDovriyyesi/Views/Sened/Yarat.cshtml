@model SenedCreateVM

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sd-form-card">
            <div class="sd-form-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="sd-detail-icon" style="width:36px;height:36px;font-size:1rem;">
                        <i class="bi bi-file-earmark-plus"></i>
                    </div>
                    <div>
                        <div class="fw-bold">Yeni Sənəd Yaradın</div>
                        <div class="text-muted" style="font-size:0.75rem;font-weight:400;">
                            Bütün məcburi sahələri doldurun
                        </div>
                    </div>
                </div>
            </div>
            <div class="sd-form-body">

                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="sd-validation-summary alert alert-danger"></div>

                <form asp-area="SenedDovriyyesi"
                      asp-controller="Sened"
                      asp-action="Yarat"
                      method="post"
                      enctype="multipart/form-data"
                      id="senedForm">

                    @Html.AntiForgeryToken()

                    <!-- Step 1: Şöbə & Sənəd Növü -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">1</span>
                            Kateqoriya Seçimi
                        </div>

                        <div class="row g-3">

                            <!-- Şöbə -->
                            <div class="col-md-6">
                                <label class="form-label sd-form-label">
                                    Şöbə *
                                </label>

                                <select asp-for="SobeId"
                                        class="form-select"
                                        id="sobeSelect">
                                    <option value="">Şöbə seçin...</option>
                                    @foreach (var s in Model.Sobeler)
                                    {
                                        <option value="@s.Id">@s.Ad</option>
                                    }
                                </select>

                                <span asp-validation-for="SobeId"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Sənəd Növü -->
                            <div class="col-md-6">
                                <label class="form-label sd-form-label">
                                    Sənəd Növü *
                                </label>

                                <div class="d-flex align-items-stretch gap-2">

                                    <select asp-for="SenedNovuId"
                                            class="form-select"
                                            id="senedNovuSelect">
                                        <option value="">Əvvəlcə şöbə seçin...</option>
                                    </select>

                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            id="openNovBtn">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>


                                </div>

                                <span asp-validation-for="SenedNovuId"
                                      class="text-danger small"></span>
                            </div>

                        </div>
                    </div>


                    <!-- Step 2: Sənəd Məlumatları -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">2</span>
                            Sənəd Məlumatları
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label sd-form-label">Başlıq *</label>
                                <input asp-for="Basliq" class="form-control"
                                       placeholder="Sənədin başlığını daxil edin..." />
                                <span asp-validation-for="Basliq" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label class="form-label sd-form-label">Açar Söz *</label>
                                <input asp-for="AcarSoz" class="form-control"
                                       placeholder="Axtarış üçün açar sözlər (vergüllə ayırın)..." />
                                <span asp-validation-for="AcarSoz" class="text-danger small"></span>
                                <div class="form-text">Sənədi tapmaq üçün istifadə olunacaq açar sözlər</div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Fayl Yükləmə -->
                    <div class="sd-form-section">
                        <div class="sd-form-section-title">
                            <span class="sd-step-number">3</span>
                            Fayl Yükləmə
                        </div>

                        <div class="sd-file-drop-zone" id="dropZone">
                            <input type="file" name="Fayl" class="sd-file-input" id="fileInput"
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.txt,.zip,.rar" />
                            <div class="sd-file-drop-content" id="dropContent">
                                <i class="bi bi-cloud-arrow-up sd-file-drop-icon"></i>
                                <div class="sd-file-drop-text">Faylı buraya sürüşdürün və ya klikləyin</div>
                                <div class="sd-file-drop-hint">PDF, Word, Excel, Şəkil, ZIP, RAR (Maks. 25MB)</div>
                            </div>
                            <div class="sd-file-preview-box d-none" id="filePreviewBox">
                                <div class="sd-file-preview-info">
                                    <div class="sd-file-icon" id="fileIcon">
                                        <i class="bi bi-file-earmark"></i>
                                    </div>
                                    <div class="sd-file-details">
                                        <div class="sd-file-name" id="fileName"></div>
                                        <div class="sd-file-meta" id="fileMeta"></div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-danger sd-file-remove"
                                            onclick="removeFile()">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="sd-form-actions">
                        <a asp-area="SenedDovriyyesi" asp-controller="Sened" asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Geri
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="bi bi-check-lg me-1"></i>Sənədi Yarat
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="novModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content sd-modal">
            <div class="modal-header sd-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Sənəd Növü
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="novError" class="alert alert-danger d-none"></div>

                <div class="mb-3">
                    <label class="form-label sd-form-label">Kod *</label>
                    <input type="text" id="novKod" class="form-control"
                           placeholder="Məs: MUQAVILE"
                           style="text-transform: uppercase;"
                           autocomplete="off" />
                    <div class="form-text">Məsələn: MUQ, EM_QAYDA (Boşluq istifadə etməyin)</div>
                </div>
                <div class="mb-3">
                    <label class="form-label sd-form-label">Ad *</label>
                    <input type="text" id="novAd" class="form-control"
                           placeholder="Məs: Müqavilə"
                           autocomplete="off" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Ləğv et
                </button>
                <button type="button"
                        class="btn btn-primary"
                        id="saveBtn">
                    <i class="bi bi-check-lg me-1"></i>Saxla
                </button>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sened-yarat.js" asp-append-version="true"></script>
}


