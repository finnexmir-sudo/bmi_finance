@using System.Text.Json
@model MuhasibatYerlesdirmeDto
@{
    ViewData["Title"] = "Mühasibat — Yerləşdirilmiş vəsaitlər";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    var kontJson = Html.Raw(JsonSerializer.Serialize(Model.Kontragentler.Select(x => new { l = x.Ad, v = x.Qaliq, c = x.Reng })));
}

<div class="mh-wrap">
    <div class="mh-hero mh-hero--yr">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-bank"></i> Mühasibat / Yerləşdirmələr</div>
            <h1 class="mh-title">Yerləşdirilmiş vəsaitlər</h1>
            <div class="mh-sub"><i class="bi bi-calendar3"></i> Hesabat tarixi: <b>@Model.Tarix.ToString("dd.MM.yyyy")</b></div>
            <a asp-action="YerlesdirmeExcel" asp-route-t="@Model.Tarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel-ə yüklə</a>
        </div>
        <form method="get" class="mh-datef">
            <label>Tarix</label>
            <input type="date" name="t" value="@Model.Tarix.ToString("yyyy-MM-dd")" />
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--p">
                <div class="mh-kpi-ic"><i class="bi bi-cash-stack"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.UmumiPortfel) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi portfel · @Model.Say açıq yerləşdirmə</div>
            </div>
            <div class="mh-kpi mh-kpi--f">
                <div class="mh-kpi-ic"><i class="bi bi-percent"></i></div>
                <div class="mh-kpi-v">@Model.OrtaFaiz%</div>
                <div class="mh-kpi-l">Orta faiz (portfel gəlirliliyi)</div>
            </div>
            <div class="mh-kpi mh-kpi--g">
                <div class="mh-kpi-ic"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.IllikGelir) <span>₼</span></div>
                <div class="mh-kpi-l">İllik gözlənilən faiz gəliri</div>
            </div>
            <div class="mh-kpi mh-kpi--b mh-click" data-mhsahe="yerlesdirme" data-mhmadde="banklararasi" data-mhbaslik="Banklararası yerləşdirmələr">
                <div class="mh-kpi-ic"><i class="bi bi-arrow-left-right"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.BanklararasiMebleg) <span>₼</span></div>
                <div class="mh-kpi-l">Banklararası (AMB xaric) · @Model.BanklararasiSay</div>
            </div>
        </div>

        <div class="mh-grid">
            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--c"></span> Kontragent üzrə (bank/qurum)</div>
                <div class="mh-card-b">
                    <div class="mh-chart"><canvas id="chKont"></canvas></div>
                    <div class="mh-list">
                        @foreach (var k in Model.Kontragentler)
                        {
                            <div class="mh-row mh-click" data-mhsahe="yerlesdirme" data-mhmadde="kontragent:@k.Ad" data-mhbaslik="Yerləşdirmə — @k.Ad">
                                <div class="mh-row-t"><span><i class="bi bi-circle-fill" style="color:@k.Reng;font-size:9px"></i> @k.Ad <em>· @k.Say</em></span><b>@Fmt(k.Qaliq) ₼</b></div>
                                <div class="mh-bar"><span style="width:@(k.Pay)%;background:@k.Reng"></span></div>
                                <div class="mh-row-p">Faiz: @k.Faiz% · @k.Pay%</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--t"></span> Struktur & Müddət</div>
                <div class="mh-ctx">
                    <div class="mh-gt">AMB & banklararası</div>
                    <div class="mh-ctx-row mh-click" data-mhsahe="yerlesdirme" data-mhmadde="amb" data-mhbaslik="AMB overnight yerləşdirmələr">
                        <span><i class="bi bi-bank2"></i> AMB (overnight) <em>· @Model.AmbSay</em></span>
                        <b>@Fmt(Model.AmbMebleg) ₼ <i class="bi bi-chevron-right mh-cr"></i></b>
                    </div>
                    <div class="mh-ctx-row mh-click" data-mhsahe="yerlesdirme" data-mhmadde="banklararasi" data-mhbaslik="Banklararası yerləşdirmələr">
                        <span><i class="bi bi-arrow-left-right"></i> Banklararası <em>· @Model.BanklararasiSay</em></span>
                        <b>@Fmt(Model.BanklararasiMebleg) ₼ <i class="bi bi-chevron-right mh-cr"></i></b>
                    </div>

                    <div class="mh-gt" style="margin-top:14px">Valyuta strukturu</div>
                    @foreach (var v in Model.ValyutaBolgusu)
                    {
                        <div class="mh-ctx-row mh-click" data-mhsahe="yerlesdirme" data-mhmadde="valyuta:@v.Ad" data-mhbaslik="Yerləşdirmə — @v.Ad">
                            <span>@v.Ad</span><b>@Fmt(v.Mebleg) ₼ <em>· @v.Faiz%</em> <i class="bi bi-chevron-right mh-cr"></i></b>
                        </div>
                    }

                    <div class="mh-gt" style="margin-top:14px">Qalıq müddət (maturity)</div>
                    @foreach (var mq in Model.MuddetBolgusu)
                    {
                        <div class="mh-ctx-row mh-click" data-mhsahe="yerlesdirme" data-mhmadde="muddet:@mq.Ad" data-mhbaslik="Yerləşdirmə — @mq.Ad">
                            <span>@mq.Ad</span><b>@Fmt(mq.Mebleg) ₼ <em>· @mq.Faiz%</em> <i class="bi bi-chevron-right mh-cr"></i></b>
                        </div>
                    }

                    <div class="mh-ctx-note">
                        <i class="bi bi-info-circle"></i>
                        Mənbə: <code>arh_licsch_rs</code> (yerləşdirilmiş vəsaitlər — kreditin güzgüsü). Qalıq = <code>summa</code> × valyuta kursu.
                        <b>AMB overnight</b> (hesab 11xxx) likvidlik idarəçiliyidir; <b>banklararası</b> (15xxx) kontragent-bank riski.
                        Müddət = <code>date_planclose</code> − hesabat tarixi.
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Qeyd</div>
            <ul>
                <li>Yerləşdirilmiş vəsaitlər — bankın <b>başqa banklara / AMB-yə</b> qoyduğu vəsaitlər (aktivin o biri tərəfi, kredit portfelinin güzgüsü). Açıq üzrə (<code>date_close</code> boş) sayılır.</li>
                <li><b>Orta faiz</b> AZN-qalıqla ölçülüdür (portfelin real gəlirliliyi). <b>İllik gəlir</b> = Σ(qalıq × faiz / 100) — cari portfelin illik gözlənilən faiz gəliri.</li>
                <li>İstənilən sətrə/karta klik → arxasındakı yerləşdirmə müqavilələri (faiz, müddət, plan-bağlanma tarixi ilə).</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const el = document.getElementById('chKont');
            const rows = @kontJson;
            if (!el || !rows.length) return;
            new Chart(el, {
                type: 'doughnut',
                data: { labels: rows.map(r => r.l), datasets: [{ data: rows.map(r => r.v), backgroundColor: rows.map(r => r.c), borderWidth: 0 }] },
                options: {
                    cutout: '62%', responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } },
                        tooltip: { callbacks: { label: c => c.label + ': ' + Number(c.raw).toLocaleString('az-AZ') + ' ₼' } }
                    }
                }
            });
        })();
    </script>
}

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0f2f5c 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-hero--yr { background: linear-gradient(120deg, #0f3d3e 0%, #0f766e 55%, #14b8a6 100%); box-shadow: 0 12px 30px rgba(15,118,110,.28); }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16); padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 28px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-xls { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; background: rgba(255,255,255,.16); color: #fff; text-decoration: none; padding: 7px 14px; border-radius: 10px; font-size: 12.5px; font-weight: 600; }
    .mh-xls:hover { background: rgba(255,255,255,.26); color: #fff; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12); padding: 12px 14px; border-radius: 14px; }
    .mh-datef label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; width: 100%; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden; box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--p { background: linear-gradient(135deg, #0f766e, #14b8a6); }
    .mh-kpi--f { background: linear-gradient(135deg, #0369a1, #0ea5e9); }
    .mh-kpi--g { background: linear-gradient(135deg, #047857, #10b981); }
    .mh-kpi--b { background: linear-gradient(135deg, #6d28d9, #8b5cf6); }
    .mh-kpi.mh-click { cursor: pointer; transition: transform .12s; }
    .mh-kpi.mh-click:hover { transform: translateY(-2px); }
    .mh-kpi-ic { position: absolute; right: 14px; top: 12px; font-size: 30px; opacity: .28; }
    .mh-kpi-v { font-size: 24px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }

    .mh-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 18px; margin-top: 18px; }
    .mh-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 16px rgba(2,6,23,.05); }
    .mh-card-h { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; padding: 15px 20px; border-bottom: 1px solid #eef2f7; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--c { background: #14b8a6; } .mh-dot--t { background: #0ea5e9; }
    .mh-card-b { display: grid; grid-template-columns: 230px 1fr; gap: 18px; padding: 18px 20px; align-items: center; }
    .mh-chart { height: 240px; position: relative; }
    .mh-list { display: flex; flex-direction: column; gap: 13px; }
    .mh-row.mh-click { cursor: pointer; }
    .mh-row-t { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
    .mh-row-t span { color: #475569; } .mh-row-t em { font-style: normal; color: #94a3b8; font-size: 11.5px; } .mh-row-t b { color: #0f172a; }
    .mh-bar { height: 7px; background: #eef2f7; border-radius: 6px; overflow: hidden; }
    .mh-bar span { display: block; height: 100%; border-radius: 6px; }
    .mh-row-p { font-size: 11px; color: #94a3b8; text-align: right; margin-top: 2px; }

    .mh-ctx { padding: 16px 20px; }
    .mh-ctx-row { display: flex; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid #f1f5f9; font-size: 13.5px; }
    .mh-ctx-row span { color: #475569; } .mh-ctx-row b { color: #0f172a; }
    .mh-ctx-row.mh-click { cursor: pointer; margin: 0 -20px; padding-left: 20px; padding-right: 20px; transition: .12s; }
    .mh-ctx-row.mh-click:hover { background: #f8fafc; }
    .mh-ctx-row em { font-style: normal; color: #94a3b8; font-size: 11.5px; }
    .mh-cr { font-size: 11px; color: #94a3b8; margin-left: 6px; }
    .mh-gt { font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .3px; margin-bottom: 4px; }
    .mh-ctx-note { margin-top: 12px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; padding: 12px 14px; font-size: 12.5px; color: #334155; line-height: 1.6; }

    .mh-note { margin-top: 18px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #0f766e; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }
    .mh-note code { background: #ccfbf1; padding: 1px 6px; border-radius: 5px; font-size: 12px; }

    @@media (max-width: 900px) {
        .mh-kpis { grid-template-columns: 1fr 1fr; }
        .mh-grid { grid-template-columns: 1fr; }
        .mh-card-b { grid-template-columns: 1fr; }
    }
</style>
