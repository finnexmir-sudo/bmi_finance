@using System.Text.Json
@model MuhasibatValyutaDto
@{
    ViewData["Title"] = "Mühasibat — Valyuta əməliyyatları";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    string Fmt4(decimal v) => v.ToString("#,##0.0000", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    var labels = Html.Raw(JsonSerializer.Serialize(Model.Setirler.Select(x => x.Valyuta)));
    var alisData = Html.Raw(JsonSerializer.Serialize(Model.Setirler.Select(x => x.AlisAzn)));
    var satisData = Html.Raw(JsonSerializer.Serialize(Model.Setirler.Select(x => x.SatisAzn)));
}

<div class="mh-wrap">
    <div class="mh-hero mh-hero--vl">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-currency-exchange"></i> Mühasibat / Valyuta</div>
            <h1 class="mh-title">Valyuta Əməliyyatları</h1>
            <div class="mh-sub"><i class="bi bi-calendar-range"></i> @Model.BasTarix.ToString("dd.MM.yyyy") — @Model.SonTarix.ToString("dd.MM.yyyy")</div>
            <a asp-action="ValyutaExcel" asp-route-bt="@Model.BasTarix.ToString("yyyy-MM-dd")" asp-route-st="@Model.SonTarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel-ə yüklə</a>
        </div>
        <form method="get" class="mh-datef mh-datef--2">
            <div><label>Başlanğıc</label><input type="date" name="bt" value="@Model.BasTarix.ToString("yyyy-MM-dd")" /></div>
            <div><label>Son</label><input type="date" name="st" value="@Model.SonTarix.ToString("yyyy-MM-dd")" /></div>
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--g">
                <div class="mh-kpi-ic"><i class="bi bi-box-arrow-in-down"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.AlisAzn) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi alış (AZN)</div>
            </div>
            <div class="mh-kpi mh-kpi--r">
                <div class="mh-kpi-ic"><i class="bi bi-box-arrow-up"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.SatisAzn) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi satış (AZN)</div>
            </div>
            <div class="mh-kpi @(Model.Xalis >= 0 ? "mh-kpi--b" : "mh-kpi--w")">
                <div class="mh-kpi-ic"><i class="bi bi-arrow-left-right"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.Xalis) <span>₼</span></div>
                <div class="mh-kpi-l">Xalis (satış − alış)</div>
            </div>
            <div class="mh-kpi mh-kpi--a">
                <div class="mh-kpi-ic"><i class="bi bi-list-ol"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.EmeliyyatSayi)</div>
                <div class="mh-kpi-l">Əməliyyat sayı</div>
            </div>
        </div>

        <div class="mh-card mh-card--wide">
            <div class="mh-card-h"><span class="mh-dot mh-dot--a"></span> Valyuta üzrə alış vs satış (AZN)</div>
            <div class="mh-card-b2"><div class="mh-chart mh-chart--w"><canvas id="chVal"></canvas></div></div>
        </div>

        <div class="mh-card mh-card--wide">
            <div class="mh-card-h"><span class="mh-dot mh-dot--v"></span> Detallı cədvəl</div>
            <div class="mh-tablewrap">
                <table class="mh-table">
                    <thead>
                        <tr>
                            <th>Valyuta</th>
                            <th class="r">Alış (həcm)</th>
                            <th class="r">Alış (AZN)</th>
                            <th class="r">Satış (həcm)</th>
                            <th class="r">Satış (AZN)</th>
                            <th class="r">Orta alış</th>
                            <th class="r">Orta satış</th>
                            <th class="r">Spred</th>
                            <th class="r">Açıq mövqe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Setirler)
                        {
                            <tr>
                                <td><b>@s.Valyuta</b></td>
                                <td class="r">@Fmt(s.AlisHecm)</td>
                                <td class="r mh-click" data-mhsahe="valyuta" data-mhmadde="val:@s.Valyuta:alis" data-mhbaslik="@s.Valyuta alış əməliyyatları">@Fmt(s.AlisAzn)</td>
                                <td class="r">@Fmt(s.SatisHecm)</td>
                                <td class="r mh-click" data-mhsahe="valyuta" data-mhmadde="val:@s.Valyuta:satis" data-mhbaslik="@s.Valyuta satış əməliyyatları">@Fmt(s.SatisAzn)</td>
                                <td class="r">@Fmt4(s.OrtaAlisKurs)</td>
                                <td class="r">@Fmt4(s.OrtaSatisKurs)</td>
                                <td class="r @(s.Spred >= 0 ? "pos" : "neg")">@Fmt4(s.Spred)</td>
                                <td class="r">@Fmt(s.AcigMovqe)</td>
                            </tr>
                        }
                        @if (!Model.Setirler.Any())
                        {
                            <tr><td colspan="9" class="empty">Bu aralıqda valyuta əməliyyatı yoxdur</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Qeyd</div>
            <ul>
                <li>Mənbə: <code>arh_dd</code> — alış (debet 10060 ← kredit 10050), satış (debet 10050 ← kredit 10060).</li>
                <li><b>Spred</b> = orta satış kursu − orta alış kursu (əməliyyat marjası). <b>Açıq mövqe</b> = alış həcmi − satış həcmi (valyuta üzrə).</li>
                <li>Standart tarix aralığı: son 30 gün. AZN alış/satış (spot) burada göstərilmir — yalnız xarici valyuta.</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const el = document.getElementById('chVal');
            const labels = @labels;
            if (!el || !labels.length) return;
            new Chart(el, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Alış', data: @alisData, backgroundColor: '#10b981', borderRadius: 5 },
                        { label: 'Satış', data: @satisData, backgroundColor: '#ef4444', borderRadius: 5 }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 } } },
                        tooltip: { callbacks: { label: c => c.dataset.label + ': ' + Number(c.raw).toLocaleString('az-AZ') + ' ₼' } }
                    },
                    scales: { y: { ticks: { callback: v => (v / 1000000).toFixed(1) + 'M' } } }
                }
            });
        })();
    </script>
}

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0f2f5c 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-hero--vl { background: linear-gradient(120deg, #7c2d12 0%, #c2410c 55%, #ea580c 100%); box-shadow: 0 12px 30px rgba(194,65,12,.28); }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16); padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 30px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12); padding: 12px 14px; border-radius: 14px; }
    .mh-datef--2 label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden; box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--g { background: linear-gradient(135deg, #047857, #10b981); }
    .mh-kpi--r { background: linear-gradient(135deg, #b91c1c, #ef4444); }
    .mh-kpi--b { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .mh-kpi--w { background: linear-gradient(135deg, #b45309, #f59e0b); }
    .mh-kpi--a { background: linear-gradient(135deg, #6d28d9, #a855f7); }
    .mh-kpi-ic { position: absolute; right: 14px; top: 12px; font-size: 30px; opacity: .28; }
    .mh-kpi-v { font-size: 24px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }

    .mh-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 16px rgba(2,6,23,.05); margin-top: 18px; }
    .mh-card-h { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; padding: 15px 20px; border-bottom: 1px solid #eef2f7; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--a { background: #ea580c; } .mh-dot--v { background: #16a34a; }
    .mh-card-b2 { padding: 18px 20px; }
    .mh-chart--w { height: 300px; position: relative; }

    .mh-tablewrap { overflow-x: auto; }
    .mh-table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 760px; }
    .mh-table th { text-align: left; padding: 11px 14px; color: #64748b; font-weight: 600; border-bottom: 2px solid #eef2f7; background: #f8fafc; font-size: 12px; }
    .mh-table td { padding: 11px 14px; border-bottom: 1px solid #f1f5f9; color: #334155; }
    .mh-table .r { text-align: right; }
    .mh-table td.pos { color: #047857; font-weight: 600; } .mh-table td.neg { color: #dc2626; font-weight: 600; }
    .mh-table .empty { text-align: center; color: #94a3b8; padding: 22px; }

    .mh-note { margin-top: 18px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #c2410c; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }
    .mh-note code { background: #ffedd5; padding: 1px 6px; border-radius: 5px; font-size: 12px; }
    .mh-note b { font-weight: 700; }

    @@media (max-width: 900px) { .mh-kpis { grid-template-columns: 1fr 1fr; } }
</style>
