@model MuhasibatIcmalDto
@{
    ViewData["Title"] = "Mühasibat — Günlük İcmal";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    // Dünənlə fərq: yuxarı/aşağı ox + rəng (müsbət yaşıl, mənfi qırmızı).
    Func<decimal, string> Delta = v =>
    {
        if (!Model.MuqayiseVar) return "";
        var cls = v >= 0 ? "up" : "dn";
        var ar = v >= 0 ? "▲" : "▼";
        var sign = v >= 0 ? "+" : "−";
        return $"<span class='mh-delta {cls}'>{ar} {sign}{Fmt(System.Math.Abs(v))} ₼</span>";
    };
}

<div class="mh-wrap">
    <div class="mh-hero mh-hero--ic">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-speedometer2"></i> Mühasibat / Günlük İcmal</div>
            <h1 class="mh-title">Günlük İcmal</h1>
            <div class="mh-sub"><i class="bi bi-calendar3"></i> Hesabat tarixi: <b>@Model.Tarix.ToString("dd.MM.yyyy")</b>@(Model.MuqayiseVar ? " · dünənlə müqayisə" : "")</div>
        </div>
        <form method="get" class="mh-datef">
            <label>Tarix</label>
            <input type="date" name="t" value="@Model.Tarix.ToString("yyyy-MM-dd")" />
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> İcmal yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <!-- Balans — 4 böyük KPI + dünən fərqi -->
        <a class="mh-sec-h" asp-action="Index"><i class="bi bi-clipboard-data"></i> Balans <i class="bi bi-chevron-right"></i></a>
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--b">
                <div class="mh-kpi-v">@Fmt(Model.UmumiAktiv) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi Aktiv</div>
                @Html.Raw(Delta(Model.AktivDeyisme))
            </div>
            <div class="mh-kpi mh-kpi--o">
                <div class="mh-kpi-v">@Fmt(Model.UmumiOhdelik) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi Öhdəlik</div>
                @Html.Raw(Delta(Model.OhdelikDeyisme))
            </div>
            <div class="mh-kpi mh-kpi--p">
                <div class="mh-kpi-v">@Fmt(Model.Kapital) <span>₼</span></div>
                <div class="mh-kpi-l">Kapital</div>
                @Html.Raw(Delta(Model.KapitalDeyisme))
            </div>
            <div class="mh-kpi mh-kpi--a">
                <div class="mh-kpi-v">@Fmt(Model.XalisMenfeet) <span>₼</span></div>
                <div class="mh-kpi-l">Xalis mənfəət (YTD)</div>
                @Html.Raw(Delta(Model.MenfeetDeyisme))
            </div>
        </div>

        <div class="mh-mini">
            <div><span>ROA (YTD)</span><b>@Model.Roa%</b></div>
            <div><span>ROE (YTD)</span><b>@Model.Roe%</b></div>
            <div><span>Kapital / Aktiv</span><b>@Model.KapitalAktiv%</b></div>
        </div>

        <!-- Bölmə kartları -->
        <div class="mh-grid3">
            <a class="mh-scard" asp-action="Depozit">
                <div class="mh-scard-h"><span class="mh-dot mh-dot--g"></span> Depozitlər <i class="bi bi-chevron-right"></i></div>
                <div class="mh-scard-v">@Fmt(Model.DepozitPortfel) <span>₼</span></div>
                <div class="mh-scard-l">Portfel · <b>@Fmt(Model.DepozitorSayi)</b> depozitor</div>
            </a>
            <a class="mh-scard" asp-action="Kredit">
                <div class="mh-scard-h"><span class="mh-dot mh-dot--v"></span> Kredit portfeli <i class="bi bi-chevron-right"></i></div>
                <div class="mh-scard-v">@Fmt(Model.KreditPortfel) <span>₼</span></div>
                <div class="mh-scard-l"><b>@Fmt(Model.KreditSayi)</b> müqavilə · NPL <b class="@(Model.NplFaiz >= 5 ? "mh-bad" : "mh-good")">@Model.NplFaiz%</b></div>
            </a>
            <a class="mh-scard" asp-action="Likvidlik">
                <div class="mh-scard-h"><span class="mh-dot mh-dot--c"></span> Likvidlik <i class="bi bi-chevron-right"></i></div>
                <div class="mh-scard-v">LCR @Model.Lcr<span>%</span></div>
                <div class="mh-scard-l">HQLA <b>@Fmt(Model.Hqla) ₼</b> · Ani <b>@Model.AniLikvidlik%</b></div>
            </a>
        </div>

        <!-- P&L -->
        <a class="mh-pnl" asp-action="Menfeet">
            <div class="mh-pnl-l">
                <div class="mh-pnl-t"><i class="bi bi-graph-up-arrow"></i> Mənfəət / Zərər (YTD) <i class="bi bi-chevron-right"></i></div>
                <div class="mh-pnl-sub">Ehtiyatdan əvvəl əməliyyat mənfəəti</div>
            </div>
            <div class="mh-pnl-nums">
                <div><span>Xalis faiz gəliri (NII)</span><b>@Fmt(Model.Nii) ₼</b></div>
                <div><span>NIM (illik)</span><b>@Model.Nim%</b></div>
                <div><span>Ehtiyatdan əvvəl mənfəət</span><b>@Fmt(Model.EhtiyatdanEvvelMenfeet) ₼</b></div>
            </div>
        </a>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Qeyd</div>
            <ul>
                <li>Bütün rəqəmlər müvafiq tab-larla <b>eynidir</b> (eyni sorğular paralel çağırılır). Karta klik → detal səhifəsi.</li>
                <li>Balansda oxlar <b>əvvəlki iş günü</b> ilə fərqi göstərir. P&L və gəlirlilik YTD (il əvvəlindən).</li>
            </ul>
        </div>
    }
</div>

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0b1e3a 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-hero--ic { background: linear-gradient(120deg, #0b1e3a 0%, #243b6b 55%, #33518f 100%); }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16); padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 30px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12); padding: 12px 14px; border-radius: 14px; }
    .mh-datef label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; width: 100%; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; }

    .mh-sec-h { display: inline-flex; align-items: center; gap: 8px; margin: 20px 0 4px; font-size: 15px; font-weight: 700; color: #0f172a; text-decoration: none; }
    .mh-sec-h:hover { color: #16478a; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 8px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden; box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--b { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .mh-kpi--o { background: linear-gradient(135deg, #b45309, #f59e0b); }
    .mh-kpi--p { background: linear-gradient(135deg, #6d28d9, #a855f7); }
    .mh-kpi--a { background: linear-gradient(135deg, #047857, #10b981); }
    .mh-kpi-v { font-size: 23px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }
    .mh-delta { display: inline-block; margin-top: 8px; font-size: 12px; font-weight: 700; padding: 2px 9px; border-radius: 20px; background: rgba(255,255,255,.18); }
    .mh-delta.up { color: #bbf7d0; } .mh-delta.dn { color: #fecaca; }

    .mh-mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 14px; }
    .mh-mini > div { background: #fff; border: 1px solid #e6ebf2; border-radius: 12px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 12px rgba(2,6,23,.04); }
    .mh-mini span { color: #64748b; font-size: 13px; } .mh-mini b { font-size: 18px; color: #0f172a; }

    .mh-grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px; }
    .mh-scard { display: block; background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; padding: 18px 20px; text-decoration: none; color: #1e293b; box-shadow: 0 4px 16px rgba(2,6,23,.05); transition: .15s; }
    .mh-scard:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(2,6,23,.1); color: #1e293b; }
    .mh-scard-h { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: #334155; }
    .mh-scard-h .bi-chevron-right { margin-left: auto; color: #94a3b8; font-size: 12px; }
    .mh-scard-v { font-size: 26px; font-weight: 800; letter-spacing: -.5px; margin: 10px 0 4px; color: #0f172a; }
    .mh-scard-v span { font-size: 14px; font-weight: 600; color: #64748b; }
    .mh-scard-l { font-size: 12.5px; color: #64748b; }
    .mh-scard-l b { color: #0f172a; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--g { background: #10b981; } .mh-dot--v { background: #7c3aed; } .mh-dot--c { background: #06b6d4; }
    .mh-good { color: #059669; } .mh-bad { color: #dc2626; }

    .mh-pnl { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap;
        margin-top: 18px; background: linear-gradient(135deg, #064e3b, #047857); border-radius: 16px; padding: 20px 26px;
        color: #fff; text-decoration: none; box-shadow: 0 8px 22px rgba(5,150,105,.22); transition: .15s; }
    .mh-pnl:hover { color: #fff; box-shadow: 0 12px 28px rgba(5,150,105,.3); }
    .mh-pnl-t { font-size: 16px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
    .mh-pnl-sub { font-size: 12.5px; opacity: .9; margin-top: 3px; }
    .mh-pnl-nums { display: flex; gap: 30px; flex-wrap: wrap; }
    .mh-pnl-nums > div { display: flex; flex-direction: column; }
    .mh-pnl-nums span { font-size: 12px; opacity: .88; } .mh-pnl-nums b { font-size: 19px; font-weight: 800; }

    .mh-note { margin-top: 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #334155; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }

    @@media (max-width: 900px) {
        .mh-kpis { grid-template-columns: 1fr 1fr; }
        .mh-mini, .mh-grid3 { grid-template-columns: 1fr; }
    }
</style>
