@using System.Text.Json
@model MuhasibatRezidentDto
@{
    ViewData["Title"] = "Mühasibat — Rezidentlik";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    var chartJson = Html.Raw(JsonSerializer.Serialize(new[] {
        new { l = "Rezident", v = Model.Rezident },
        new { l = "Qeyri-rezident", v = Model.QeyriRezident }
    }));
}

<div class="mh-wrap">
    <div class="mh-hero mh-hero--rz">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-globe2"></i> Mühasibat / Rezidentlik</div>
            <h1 class="mh-title">Rezident / Qeyri-rezident</h1>
            <div class="mh-sub"><i class="bi bi-calendar3"></i> Hesabat tarixi: <b>@Model.Tarix.ToString("dd.MM.yyyy")</b></div>
            <a asp-action="RezidentExcel" asp-route-t="@Model.Tarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel-ə yüklə</a>
        </div>
        <form method="get" class="mh-datef">
            <label>Tarix</label>
            <input type="date" name="t" value="@Model.Tarix.ToString("yyyy-MM-dd")" />
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--a">
                <div class="mh-kpi-ic"><i class="bi bi-house-check"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.Rezident) <span>₼</span></div>
                <div class="mh-kpi-l">Rezident · @Model.RezidentSay hesab</div>
            </div>
            <div class="mh-kpi mh-kpi--r">
                <div class="mh-kpi-ic"><i class="bi bi-airplane"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.QeyriRezident) <span>₼</span></div>
                <div class="mh-kpi-l">Qeyri-rezident · @Model.QeyriRezidentSay hesab</div>
            </div>
            <div class="mh-kpi mh-kpi--b">
                <div class="mh-kpi-ic"><i class="bi bi-bank"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.Umumi) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi (ABS qalıq)</div>
            </div>
            <div class="mh-kpi mh-kpi--w">
                <div class="mh-kpi-ic"><i class="bi bi-percent"></i></div>
                <div class="mh-kpi-v">@Model.QeyriRezidentPay<span>%</span></div>
                <div class="mh-kpi-l">Qeyri-rezident payı</div>
            </div>
        </div>

        <div class="mh-card">
            <div class="mh-card-h"><span class="mh-dot mh-dot--a"></span> Rezident / Qeyri-rezident bölgüsü</div>
            <div class="mh-card-b">
                <div class="mh-chart"><canvas id="chRez"></canvas></div>
                <div class="mh-list">
                    <div class="mh-row">
                        <div class="mh-row-t"><span>Rezident</span><b>@Fmt(Model.Rezident) ₼</b></div>
                        <div class="mh-bar"><span style="width:@(Model.Umumi != 0 ? Math.Round(Model.Rezident / Model.Umumi * 100, 1) : 0)%"></span></div>
                    </div>
                    <div class="mh-row">
                        <div class="mh-row-t"><span>Qeyri-rezident</span><b>@Fmt(Model.QeyriRezident) ₼</b></div>
                        <div class="mh-bar mh-bar--r"><span style="width:@(Model.QeyriRezidentPay)%"></span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Qeyd</div>
            <ul>
                <li>Mənbə: <code>odb.arh_saldo_ls</code> — bütün açıq hesabların <b>ABS qalığı</b> (aktiv + passiv).</li>
                <li>Qeyri-rezident: hesab <code>409*</code> (adın son mötərizəsində 5-ci simvol '5') və ya <code>45029*</code>; əks halda rezident (frm_reziden_ve_qeyri_rezident məntiqi).</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const el = document.getElementById('chRez');
            const rows = @chartJson;
            if (!el || !(rows[0].v || rows[1].v)) return;
            new Chart(el, {
                type: 'doughnut',
                data: { labels: rows.map(r => r.l), datasets: [{ data: rows.map(r => r.v), backgroundColor: ['#4f46e5', '#f97316'], borderWidth: 0 }] },
                options: {
                    cutout: '62%', responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 12 } } },
                        tooltip: { callbacks: { label: c => c.label + ': ' + Number(c.raw).toLocaleString('az-AZ') + ' ₼' } }
                    }
                }
            });
        })();
    </script>
}

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0f2f5c 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-hero--rz { background: linear-gradient(120deg, #1e1b4b 0%, #4338ca 55%, #4f46e5 100%); box-shadow: 0 12px 30px rgba(79,70,229,.28); }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16); padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 30px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12); padding: 12px 14px; border-radius: 14px; }
    .mh-datef label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; width: 100%; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden; box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--a { background: linear-gradient(135deg, #4338ca, #6366f1); }
    .mh-kpi--r { background: linear-gradient(135deg, #c2410c, #f97316); }
    .mh-kpi--b { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .mh-kpi--w { background: linear-gradient(135deg, #7c3aed, #a855f7); }
    .mh-kpi-ic { position: absolute; right: 14px; top: 12px; font-size: 30px; opacity: .28; }
    .mh-kpi-v { font-size: 24px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }

    .mh-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 16px rgba(2,6,23,.05); margin-top: 18px; }
    .mh-card-h { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; padding: 15px 20px; border-bottom: 1px solid #eef2f7; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--a { background: #4f46e5; }
    .mh-card-b { display: grid; grid-template-columns: 260px 1fr; gap: 18px; padding: 18px 20px; align-items: center; }
    .mh-chart { height: 220px; position: relative; }
    .mh-list { display: flex; flex-direction: column; gap: 14px; }
    .mh-row-t { display: flex; justify-content: space-between; font-size: 13.5px; margin-bottom: 5px; }
    .mh-row-t span { color: #475569; } .mh-row-t b { color: #0f172a; }
    .mh-bar { height: 8px; background: #eef2f7; border-radius: 6px; overflow: hidden; }
    .mh-bar span { display: block; height: 100%; background: linear-gradient(90deg, #4f46e5, #818cf8); border-radius: 6px; }
    .mh-bar--r span { background: linear-gradient(90deg, #f97316, #fb923c); }

    .mh-note { margin-top: 18px; background: #eef2ff; border: 1px solid #c7d2fe; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #4338ca; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }
    .mh-note code { background: #e0e7ff; padding: 1px 6px; border-radius: 5px; font-size: 12px; }
    .mh-note b { font-weight: 700; }

    @@media (max-width: 900px) {
        .mh-kpis { grid-template-columns: 1fr 1fr; }
        .mh-card-b { grid-template-columns: 1fr; }
    }
</style>
