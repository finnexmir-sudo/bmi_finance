@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsDash = ctrl == "Dashboard";
    bool IsHes  = ctrl == "Hesabat";
    // Aktivlik yalnız Dashboard controller-ində — Hesabat səhifələri dashboard qruplarını yandırmasın.
    bool In(params string[] a) => IsDash && a.Contains(act);
    string On(string a) => (IsDash && act == a) ? "on" : "";
}
<div class="mh-tabs">
    <!-- İcmal -->
    <div class="mh-tg @(In("Icmal", "Index") ? "act" : "")">
        <button type="button" class="mh-tab mh-tab--grp"><i class="bi bi-speedometer2"></i> İcmal <i class="bi bi-chevron-down mh-cv"></i></button>
        <div class="mh-tg-menu">
            <a asp-controller="Dashboard" asp-action="Icmal" class="@On("Icmal")"><i class="bi bi-speedometer2"></i> Günlük İcmal</a>
            <a asp-controller="Dashboard" asp-action="Index" class="@On("Index")"><i class="bi bi-clipboard-data"></i> Balans İcmalı</a>
        </div>
    </div>

    <!-- Kreditlər -->
    <div class="mh-tg @(In("Kredit", "Maturity", "Keyfiyyet") ? "act" : "")">
        <button type="button" class="mh-tab mh-tab--grp"><i class="bi bi-credit-card"></i> Kreditlər <i class="bi bi-chevron-down mh-cv"></i></button>
        <div class="mh-tg-menu">
            <a asp-controller="Dashboard" asp-action="Kredit" class="@On("Kredit")"><i class="bi bi-credit-card"></i> Kredit portfeli</a>
            <a asp-controller="Dashboard" asp-action="Keyfiyyet" class="@On("Keyfiyyet")"><i class="bi bi-shield-check"></i> Keyfiyyət & Ehtiyat</a>
            <a asp-controller="Dashboard" asp-action="Maturity" class="@On("Maturity")"><i class="bi bi-bar-chart-steps"></i> Pul Axını</a>
        </div>
    </div>

    <!-- Depozit & Müştəri -->
    <div class="mh-tg @(In("Depozit", "Rezident") ? "act" : "")">
        <button type="button" class="mh-tab mh-tab--grp"><i class="bi bi-safe2"></i> Depozit & Müştəri <i class="bi bi-chevron-down mh-cv"></i></button>
        <div class="mh-tg-menu">
            <a asp-controller="Dashboard" asp-action="Depozit" class="@On("Depozit")"><i class="bi bi-safe2"></i> Depozitlər</a>
            <a asp-controller="Dashboard" asp-action="Rezident" class="@On("Rezident")"><i class="bi bi-globe"></i> Rezidentlik</a>
        </div>
    </div>

    <!-- Gəlirlilik -->
    <a asp-controller="Dashboard" asp-action="Menfeet" class="mh-tab @On("Menfeet")"><i class="bi bi-graph-up-arrow"></i> Mənfəət/Zərər</a>

    <!-- Likvidlik & Bazar -->
    <div class="mh-tg @(In("Likvidlik", "Valyuta", "Yerlesdirme") ? "act" : "")">
        <button type="button" class="mh-tab mh-tab--grp"><i class="bi bi-droplet"></i> Likvidlik & Bazar <i class="bi bi-chevron-down mh-cv"></i></button>
        <div class="mh-tg-menu">
            <a asp-controller="Dashboard" asp-action="Likvidlik" class="@On("Likvidlik")"><i class="bi bi-droplet"></i> Likvidlik</a>
            <a asp-controller="Dashboard" asp-action="Yerlesdirme" class="@On("Yerlesdirme")"><i class="bi bi-bank"></i> Yerləşdirmələr</a>
            <a asp-controller="Dashboard" asp-action="Valyuta" class="@On("Valyuta")"><i class="bi bi-currency-exchange"></i> Valyuta</a>
        </div>
    </div>

    <!-- Hesabatlar (requlyativ) -->
    <div class="mh-tg @(IsHes ? "act" : "")">
        <button type="button" class="mh-tab mh-tab--grp"><i class="bi bi-file-earmark-bar-graph"></i> Hesabatlar <i class="bi bi-chevron-down mh-cv"></i></button>
        <div class="mh-tg-menu">
            <a asp-controller="Hesabat" asp-action="Ifrs9" class="@(IsHes && act == "Ifrs9" ? "on" : "")"><i class="bi bi-clipboard2-pulse"></i> IFRS 9 ECL</a>
            <a asp-controller="Hesabat" asp-action="Index" class="@(IsHes && act == "Index" ? "on" : "")"><i class="bi bi-collection"></i> Bütün hesabatlar</a>
        </div>
    </div>
</div>

<style>
    .mh-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 18px 0 4px; position: relative; z-index: 20; }
    .mh-tab { display: inline-flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 11px;
        background: #eef2f7; color: #475569; font-size: 13.5px; font-weight: 600; text-decoration: none;
        border: 1px solid transparent; transition: .15s; cursor: pointer; }
    .mh-tab:hover { background: #e2e8f0; color: #1e293b; }
    .mh-tab.on { background: linear-gradient(135deg, #16478a, #1e63b8); color: #fff; box-shadow: 0 6px 16px rgba(16,71,138,.28); }
    .mh-tab--grp { font-family: inherit; }
    .mh-cv { font-size: 10px; opacity: .7; transition: transform .15s; }

    /* Qrup dropdown */
    .mh-tg { position: relative; }
    /* Görünməz körpü — düymə ilə menyu arasındakı boşluğu örtür ki, siçan keçəndə menyu bağlanmasın */
    .mh-tg::after { content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 12px; }
    .mh-tg.act > .mh-tab--grp { background: linear-gradient(135deg, #16478a, #1e63b8); color: #fff; box-shadow: 0 6px 16px rgba(16,71,138,.28); }
    .mh-tg-menu { position: absolute; top: calc(100% + 8px); left: 0; min-width: 210px; background: #fff;
        border: 1px solid #e6ebf2; border-radius: 12px; box-shadow: 0 14px 34px rgba(2,6,23,.16); padding: 6px;
        display: none; flex-direction: column; gap: 2px; z-index: 30; }
    .mh-tg:hover .mh-tg-menu, .mh-tg.open .mh-tg-menu { display: flex; }
    .mh-tg:hover .mh-cv, .mh-tg.open .mh-cv { transform: rotate(180deg); }
    .mh-tg-menu a { display: flex; align-items: center; gap: 9px; padding: 9px 12px; border-radius: 9px;
        font-size: 13.5px; font-weight: 600; color: #475569; text-decoration: none; white-space: nowrap; }
    .mh-tg-menu a:hover { background: #eef2f7; color: #16478a; }
    .mh-tg-menu a.on { background: #eaf1fb; color: #16478a; }
    .mh-tg-menu a i { font-size: 15px; opacity: .8; }

    .mh-xls { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; background: rgba(255,255,255,.16);
        color: #fff; padding: 7px 14px; border-radius: 10px; font-size: 12.5px; font-weight: 600; text-decoration: none;
        border: 1px solid rgba(255,255,255,.28); width: fit-content; }
    .mh-xls:hover { background: rgba(255,255,255,.3); color: #fff; }
</style>

<script>
    (function () {
        // Klik ilə aç/bağla (mobil + toxunma üçün — desktop-da hover onsuz işləyir).
        document.querySelectorAll('.mh-tg > .mh-tab--grp').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                var tg = btn.parentElement;
                var acig = tg.classList.contains('open');
                document.querySelectorAll('.mh-tg.open').forEach(function (x) { x.classList.remove('open'); });
                if (!acig) tg.classList.add('open');
            });
        });
        document.addEventListener('click', function () {
            document.querySelectorAll('.mh-tg.open').forEach(function (x) { x.classList.remove('open'); });
        });
    })();
</script>

@await Html.PartialAsync("~/Areas/Muhasibat/Views/Dashboard/_MhDetal.cshtml")
