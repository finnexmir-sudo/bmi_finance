@using System.Text.Json
@model MuhasibatBalansDto
@{
    ViewData["Title"] = "Mühasibat — Balans İcmalı";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    string Fmt2(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    var ferqOk = Math.Abs(Model.BalansFerqi) < (Model.UmumiAktiv == 0 ? 1 : Model.UmumiAktiv * 0.005m);
    var aktivJson = Html.Raw(JsonSerializer.Serialize(Model.Aktivler.Select(x => new { l = x.Ad, v = x.Mebleg })));
    var ohdeJson = Html.Raw(JsonSerializer.Serialize(Model.Ohdelikler.Select(x => new { l = x.Ad, v = x.Mebleg })));
    var valyutaJson = Html.Raw(JsonSerializer.Serialize(Model.ValyutaBolgusu.Select(x => new { l = x.Ad, v = x.Mebleg })));
}

<div class="mh-wrap">
    <div class="mh-hero">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-bank2"></i> Mühasibat / Maliyyə</div>
            <h1 class="mh-title">Balans İcmalı</h1>
            <div class="mh-sub"><i class="bi bi-calendar3"></i> Hesabat tarixi: <b>@Model.Tarix.ToString("dd.MM.yyyy")</b></div>
        </div>
        <form method="get" class="mh-datef">
            <label>Tarix</label>
            <input type="date" name="t" value="@Model.Tarix.ToString("yyyy-MM-dd")" />
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> Balans yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-check @(ferqOk ? "ok" : "warn")">
            <i class="bi bi-@(ferqOk ? "check2-circle" : "exclamation-triangle")"></i>
            <span>Balans yoxlaması: <b>Aktiv = Öhdəlik + Kapital</b></span>
            <span class="mh-check-num">@Fmt(Model.UmumiAktiv) = @Fmt(Model.UmumiOhdelik) + @Fmt(Model.Kapital)@(Model.Tesnifsiz != 0 ? $" + {Fmt(Model.Tesnifsiz)} (təsnifsiz)" : "")</span>
            <span class="mh-check-ferq">Fərq: @Fmt2(Model.BalansFerqi) ₼</span>
        </div>

        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--a">
                <div class="mh-kpi-ic"><i class="bi bi-graph-up-arrow"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.UmumiAktiv) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi Aktivlər</div>
            </div>
            <div class="mh-kpi mh-kpi--o">
                <div class="mh-kpi-ic"><i class="bi bi-graph-down-arrow"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.UmumiOhdelik) <span>₼</span></div>
                <div class="mh-kpi-l">Ümumi Öhdəliklər</div>
            </div>
            <div class="mh-kpi mh-kpi--k">
                <div class="mh-kpi-ic"><i class="bi bi-shield-check"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.Kapital) <span>₼</span></div>
                <div class="mh-kpi-l">Kapital və ehtiyatlar</div>
            </div>
            <div class="mh-kpi mh-kpi--c">
                <div class="mh-kpi-ic"><i class="bi bi-percent"></i></div>
                <div class="mh-kpi-v">@(Model.UmumiAktiv != 0 ? Fmt2(Model.Kapital / Model.UmumiAktiv * 100) : "0")<span>%</span></div>
                <div class="mh-kpi-l">Kapital / Aktiv əmsalı</div>
            </div>
        </div>

        <div class="mh-profit">
            <div class="mh-prof-card mh-prof--m">
                <div class="mh-prof-t"><i class="bi bi-graph-up-arrow"></i> Xalis mənfəət (YTD)</div>
                <div class="mh-prof-v">@Fmt(Model.XalisMenfeet) <span>₼</span></div>
                <div class="mh-prof-s">Cari ilin mənfəəti/zərəri · hesab 50130</div>
            </div>
            <div class="mh-prof-card mh-prof--a">
                <div class="mh-prof-t"><i class="bi bi-pie-chart-fill"></i> ROA</div>
                <div class="mh-prof-v">@Model.Roa<span>%</span></div>
                <div class="mh-prof-s">Aktivlərin gəlirliliyi · illik ≈ <b>@Model.RoaIllik%</b></div>
            </div>
            <div class="mh-prof-card mh-prof--e">
                <div class="mh-prof-t"><i class="bi bi-bullseye"></i> ROE</div>
                <div class="mh-prof-v">@Model.Roe<span>%</span></div>
                <div class="mh-prof-s">Kapitalın gəlirliliyi · illik ≈ <b>@Model.RoeIllik%</b></div>
            </div>
        </div>

        <div class="mh-grid">
            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--a"></span> Aktivlərin strukturu</div>
                <div class="mh-card-b">
                    <div class="mh-chart"><canvas id="chAktiv"></canvas></div>
                    <div class="mh-list">
                        @foreach (var a in Model.Aktivler)
                        {
                            <div class="mh-row">
                                <div class="mh-row-t"><span>@a.Ad</span><b>@Fmt(a.Mebleg) ₼</b></div>
                                <div class="mh-bar"><span style="width:@(a.Faiz)%"></span></div>
                                <div class="mh-row-p">@a.Faiz%</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--o"></span> Öhdəliklərin strukturu</div>
                <div class="mh-card-b">
                    <div class="mh-chart"><canvas id="chOhde"></canvas></div>
                    <div class="mh-list">
                        @foreach (var o in Model.Ohdelikler)
                        {
                            <div class="mh-row">
                                <div class="mh-row-t"><span>@o.Ad</span><b>@Fmt(o.Mebleg) ₼</b></div>
                                <div class="mh-bar mh-bar--o"><span style="width:@(o.Faiz)%"></span></div>
                                <div class="mh-row-p">@o.Faiz%</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-card mh-card--wide">
            <div class="mh-card-h"><span class="mh-dot mh-dot--v"></span> Aktivlərin valyuta strukturu</div>
            <div class="mh-card-b mh-card-b--val">
                <div class="mh-chart mh-chart--sm"><canvas id="chVal"></canvas></div>
                <div class="mh-vallist">
                    @foreach (var v in Model.ValyutaBolgusu)
                    {
                        <div class="mh-valitem"><span class="mh-valk">@v.Ad</span><b>@Fmt(v.Mebleg) ₼</b><i>@v.Faiz%</i></div>
                    }
                </div>
            </div>
        </div>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Bu balans necə hesablanır</div>
            <ul>
                <li>Mənbə: Oracle <code>odb.arh_saldo_ls</code> — seçilmiş tarixə bütün açıq hesabların qalığı (<code>saldo_ish_nacval</code>, artıq AZN-də).</li>
                <li>Təsnifat hesab kodunun ilk rəqəmi üzrə: <b>1, 2 → Aktiv</b>; <b>3, 4 → Öhdəlik</b> (44/45 və 5x → Kapital). Hər hesab bir dəfə sayılır.</li>
                <li><b>Diqqət:</b> bu, dashboard səviyyəli icmaldır — tənzimləyici (AMB Daily Report) sətir-sətir detalı deyil. Rəqəmləri real Daily Report ilə tutuşdurub dəqiqləşdirmək lazımdır.</li>
                <li>Cari il mənfəəti burada YOXDUR — o, ayrıca gəlir/xərc (P&L) hesablarından hesablanmalıdır (növbəti addım).</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const palA = ['#2563eb','#3b82f6','#60a5fa','#0ea5e9','#06b6d4','#14b8a6','#22c55e','#84cc16'];
            const palO = ['#dc2626','#ef4444','#f97316','#f59e0b','#eab308','#a855f7'];
            const palV = ['#2563eb','#16a34a','#f59e0b','#ef4444','#a855f7','#64748b'];

            function donut(id, rows, pal) {
                const el = document.getElementById(id);
                if (!el || !rows || !rows.length) return;
                new Chart(el, {
                    type: 'doughnut',
                    data: {
                        labels: rows.map(r => r.l),
                        datasets: [{ data: rows.map(r => r.v), backgroundColor: pal, borderWidth: 0 }]
                    },
                    options: {
                        cutout: '62%', responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } },
                            tooltip: {
                                callbacks: {
                                    label: c => c.label + ': ' + Number(c.raw).toLocaleString('az-AZ') + ' ₼'
                                }
                            }
                        }
                    }
                });
            }

            donut('chAktiv', @aktivJson, palA);
            donut('chOhde', @ohdeJson, palO);
            donut('chVal', @valyutaJson, palV);
        })();
    </script>
}

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0f2f5c 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16);
        padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 30px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12);
        padding: 12px 14px; border-radius: 14px; }
    .mh-datef label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; width: 100%; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px;
        padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca;
        border-radius: 12px; padding: 14px 18px; }

    .mh-check { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 18px;
        border-radius: 14px; padding: 13px 20px; font-size: 13.5px; }
    .mh-check.ok { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
    .mh-check.warn { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }
    .mh-check i { font-size: 20px; }
    .mh-check-num { font-family: ui-monospace, monospace; opacity: .9; }
    .mh-check-ferq { margin-left: auto; font-weight: 700; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 20px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden;
        box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--a { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .mh-kpi--o { background: linear-gradient(135deg, #b91c1c, #ef4444); }
    .mh-kpi--k { background: linear-gradient(135deg, #047857, #10b981); }
    .mh-kpi--c { background: linear-gradient(135deg, #7c3aed, #a855f7); }
    .mh-kpi-ic { position: absolute; right: 14px; top: 12px; font-size: 30px; opacity: .28; }
    .mh-kpi-v { font-size: 25px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }

    .mh-profit { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px; }
    .mh-prof-card { border-radius: 16px; padding: 18px 20px; border: 1px solid #e6ebf2; background: #fff; box-shadow: 0 4px 16px rgba(2,6,23,.05); position: relative; overflow: hidden; }
    .mh-prof-card::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 5px; }
    .mh-prof--m::before { background: #0ea5e9; } .mh-prof--a::before { background: #7c3aed; } .mh-prof--e::before { background: #059669; }
    .mh-prof-t { font-size: 13px; font-weight: 700; color: #475569; display: flex; align-items: center; gap: 7px; }
    .mh-prof-v { font-size: 28px; font-weight: 800; color: #0f172a; margin: 6px 0 3px; letter-spacing: -.5px; }
    .mh-prof-v span { font-size: 15px; color: #7c3aed; }
    .mh-prof-s { font-size: 12px; color: #94a3b8; }
    .mh-prof-s b { color: #334155; font-weight: 700; }

    .mh-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 20px; }
    .mh-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; overflow: hidden;
        box-shadow: 0 4px 16px rgba(2,6,23,.05); }
    .mh-card--wide { margin-top: 18px; }
    .mh-card-h { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px;
        padding: 15px 20px; border-bottom: 1px solid #eef2f7; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--a { background: #2563eb; } .mh-dot--o { background: #ef4444; } .mh-dot--v { background: #16a34a; }
    .mh-card-b { display: grid; grid-template-columns: 260px 1fr; gap: 18px; padding: 18px 20px; align-items: center; }
    .mh-card-b--val { grid-template-columns: 220px 1fr; }
    .mh-chart { height: 240px; position: relative; }
    .mh-chart--sm { height: 200px; }
    .mh-list { display: flex; flex-direction: column; gap: 11px; }
    .mh-row-t { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
    .mh-row-t span { color: #475569; } .mh-row-t b { color: #0f172a; }
    .mh-bar { height: 7px; background: #eef2f7; border-radius: 6px; overflow: hidden; }
    .mh-bar span { display: block; height: 100%; background: linear-gradient(90deg, #2563eb, #60a5fa); border-radius: 6px; }
    .mh-bar--o span { background: linear-gradient(90deg, #dc2626, #f87171); }
    .mh-row-p { font-size: 11px; color: #94a3b8; text-align: right; margin-top: 2px; }

    .mh-vallist { display: flex; flex-direction: column; gap: 10px; }
    .mh-valitem { display: flex; align-items: center; gap: 12px; padding: 10px 14px; background: #f8fafc;
        border-radius: 10px; font-size: 13.5px; }
    .mh-valk { font-weight: 700; width: 54px; } .mh-valitem b { color: #0f172a; } .mh-valitem i { margin-left: auto; color: #64748b; font-style: normal; }

    .mh-note { margin-top: 20px; background: #f0f7ff; border: 1px solid #cfe4ff; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #1d4ed8; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }
    .mh-note code { background: #e2e8f0; padding: 1px 6px; border-radius: 5px; font-size: 12px; }

    @@media (max-width: 900px) {
        .mh-kpis { grid-template-columns: 1fr 1fr; }
        .mh-profit { grid-template-columns: 1fr; }
        .mh-grid { grid-template-columns: 1fr; }
        .mh-card-b, .mh-card-b--val { grid-template-columns: 1fr; }
    }
</style>
