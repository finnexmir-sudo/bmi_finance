@using System.Text.Json
@model MuhasibatMenfeetDto
@{
    ViewData["Title"] = "Mühasibat — Mənfəət / Zərər";
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    // Rəng palitraları — həm donut, həm siyahı nöqtələri eyni indeks üzrə istifadə edir.
    string[] palGelir = { "#059669", "#10b981", "#34d399", "#0d9488", "#14b8a6", "#047857", "#6ee7b7", "#5eead4" };
    string[] palXerc  = { "#b91c1c", "#ef4444", "#f97316", "#f59e0b", "#dc2626", "#ea580c", "#d97706", "#e11d48", "#fb923c", "#facc15", "#9f1239", "#c2410c", "#fda4af", "#fca5a5" };
    var gelirJson = Html.Raw(JsonSerializer.Serialize(Model.GelirBolgusu.Select(x => new { l = x.Ad, v = x.Mebleg })));
    var xercJson = Html.Raw(JsonSerializer.Serialize(Model.XercBolgusu.Select(x => new { l = x.Ad, v = x.Mebleg })));
    var palGjson = Html.Raw(JsonSerializer.Serialize(palGelir));
    var palXjson = Html.Raw(JsonSerializer.Serialize(palXerc));
    var gunSayi = (Model.SonTarix - Model.BasTarix).Days + 1;                 // NIM illik əmsalının məxrəci
    var qeyriFaizGelir = Model.UmumiGelir - Model.FaizGeliri;                 // komissiya + kurs/dilinq(net) + digər
    var xercCemi = Model.UmumiXerc + Model.XalisEhtiyat;                      // ehtiyat daxil — Gəlir − bu = 50130
}

<div class="mh-wrap">
    <div class="mh-hero mh-hero--pl">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-graph-up-arrow"></i> Mühasibat / Mənfəət-Zərər</div>
            <h1 class="mh-title">Mənfəət / Zərər (P&L)</h1>
            <div class="mh-sub"><i class="bi bi-calendar-range"></i> @Model.BasTarix.ToString("dd.MM.yyyy") — @Model.SonTarix.ToString("dd.MM.yyyy")</div>
            <a asp-action="MenfeetExcel" asp-route-bt="@Model.BasTarix.ToString("yyyy-MM-dd")" asp-route-st="@Model.SonTarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel-ə yüklə</a>
        </div>
        <form method="get" class="mh-datef mh-datef--2">
            <div><label>Başlanğıc</label><input type="date" name="bt" value="@Model.BasTarix.ToString("yyyy-MM-dd")" /></div>
            <div><label>Son</label><input type="date" name="st" value="@Model.SonTarix.ToString("yyyy-MM-dd")" /></div>
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="_MhTabs" />

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> P&L yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--a">
                <div class="mh-kpi-ic"><i class="bi bi-cash-coin"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.XalisFaizGeliri) <span>₼</span></div>
                <div class="mh-kpi-l">Xalis faiz gəliri (NII)</div>
                <div class="mh-kpi-f">Faiz gəliri @Fmt(Model.FaizGeliri) − faiz xərci @Fmt(Model.FaizXerci)</div>
            </div>
            <div class="mh-kpi mh-kpi--t">
                <div class="mh-kpi-ic"><i class="bi bi-percent"></i></div>
                <div class="mh-kpi-v">@Model.Nim%</div>
                <div class="mh-kpi-l">Xalis faiz marjası (NIM) · illik</div>
                <div class="mh-kpi-f">NII @Fmt(Model.XalisFaizGeliri) ÷ işləyən aktiv @Fmt(Model.IsleyenAktiv) × 365/@gunSayi gün</div>
            </div>
            <div class="mh-kpi mh-kpi--b">
                <div class="mh-kpi-ic"><i class="bi bi-box-arrow-in-down"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.UmumiGelir) <span>₼</span></div>
                <div class="mh-kpi-l">Əməliyyat gəliri</div>
                <div class="mh-kpi-f">Faiz @Fmt(Model.FaizGeliri) + qeyri-faiz @Fmt(qeyriFaizGelir) (sinif 6/7)</div>
            </div>
            <div class="mh-kpi mh-kpi--w">
                <div class="mh-kpi-ic"><i class="bi bi-clipboard-check"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.EhtiyatdanEvvelMenfeet) <span>₼</span></div>
                <div class="mh-kpi-l">Ehtiyatdan əvvəl mənfəət</div>
                <div class="mh-kpi-f">Gəlir @Fmt(Model.UmumiGelir) − əməliyyat xərci @Fmt(Model.UmumiXerc)</div>
            </div>
        </div>

        <div class="mh-lcr">
            <div class="mh-lcr-main">
                <div class="mh-lcr-t">Xalis mənfəət (GL — hesab 50130)</div>
                <div class="mh-lcr-v">@Fmt(Model.XalisMenfeet) <span>₼</span></div>
                <div class="mh-lcr-gx">
                    <div><span>Gəlir cəmi</span><b class="mh-ok">@Fmt(Model.UmumiGelir) ₼</b></div>
                    <div><span>Xərc cəmi (ehtiyat daxil)</span><b class="mh-warn">@Fmt(xercCemi) ₼</b></div>
                </div>
                <div class="mh-lcr-s">Fərq: @Fmt(Model.UmumiGelir) − @Fmt(xercCemi) = <b>@Fmt(Model.XalisMenfeet) ₼</b> · Xərc/Gəlir <b>@Model.XercGelirNisbeti%</b></div>
            </div>
            <div class="mh-lcr-comp mh-ladder">
                <div class="mh-lad-h">Necə yaranır — addım-addım</div>
                <div><span>Gəlir cəmi (sinif 6/7 — aşağıda "Gəlir strukturu")</span><b class="mh-ok">+ @Fmt(Model.UmumiGelir) ₼</b></div>
                <div><span>Əməliyyat xərci (ehtiyatsız — aşağıda "Əməliyyat xərci")</span><b class="mh-warn">− @Fmt(Model.UmumiXerc) ₼</b></div>
                <div class="mh-lad-eq"><span>= Ehtiyatdan əvvəl mənfəət</span><b>@Fmt(Model.EhtiyatdanEvvelMenfeet) ₼</b></div>
                @if (Model.XalisEhtiyat >= 0)
                {
                    <div><span>Ehtiyat ayırmaları (sinif 89, xalis)</span><b class="mh-warn">− @Fmt(Model.XalisEhtiyat) ₼</b></div>
                }
                else
                {
                    <div><span>Ehtiyat bərpası (sinif 89, xalis — ehtiyat azalıb, mənfəətə qayıdıb)</span><b class="mh-ok">+ @Fmt(-Model.XalisEhtiyat) ₼</b></div>
                }
                <div class="mh-lad-eq"><span>= Xalis mənfəət (GL — hesab 50130)</span><b>@Fmt(Model.XalisMenfeet) ₼</b></div>
            </div>
        </div>

        <div class="mh-grid">
            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--g"></span> Gəlir strukturu</div>
                <div class="mh-card-b">
                    <div class="mh-chart"><canvas id="chGelir"></canvas></div>
                    <div class="mh-list">
                        @for (int gi = 0; gi < Model.GelirBolgusu.Count; gi++)
                        {
                            var a = Model.GelirBolgusu[gi];
                            <div class="mh-row mh-click" data-mhsahe="menfeet" data-mhmadde="@a.Ad" data-mhbaslik="Gəlir — @a.Ad">
                                <div class="mh-row-t"><span><span class="mh-dot2" style="background:@(palGelir[gi % palGelir.Length])"></span>@a.Ad</span><b>@Fmt(a.Mebleg) ₼</b></div>
                                <div class="mh-bar mh-bar--g"><span style="width:@(a.Faiz)%"></span></div>
                                <div class="mh-row-p">@a.Faiz%</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mh-card">
                <div class="mh-card-h"><span class="mh-dot mh-dot--r"></span> Əməliyyat xərci (ehtiyatsız)</div>
                <div class="mh-card-b">
                    <div class="mh-chart"><canvas id="chXerc"></canvas></div>
                    <div class="mh-list">
                        @for (int xi = 0; xi < Model.XercBolgusu.Count; xi++)
                        {
                            var x = Model.XercBolgusu[xi];
                            <div class="mh-row mh-click" data-mhsahe="menfeet" data-mhmadde="@x.Ad" data-mhbaslik="Xərc — @x.Ad">
                                <div class="mh-row-t"><span><span class="mh-dot2" style="background:@(palXerc[xi % palXerc.Length])"></span>@x.Ad</span><b>@Fmt(x.Mebleg) ₼</b></div>
                                <div class="mh-bar mh-bar--r"><span style="width:@(x.Faiz)%"></span></div>
                                <div class="mh-row-p">@x.Faiz%</div>
                            </div>
                        }
                        @* Ehtiyat ayırmaları (sinif 89) — siyahının İÇİNDƏ, digərlərinin altında (sonda).
                           Yalnız display; subtotala və donut qrafikə DAXİL DEYİL. *@
                        @{
                            var ehtFaiz = Model.UmumiXerc != 0 ? Math.Round(Model.XalisEhtiyat / Model.UmumiXerc * 100, 1) : 0m;
                            var ehtBar  = Math.Min(100m, Math.Abs(ehtFaiz));
                        }
                        <div class="mh-row">
                            <div class="mh-row-t"><span><span class="mh-dot2" style="background:#94a3b8"></span>Ehtiyat ayırmaları</span><b>@Fmt(Model.XalisEhtiyat) ₼</b></div>
                            <div class="mh-bar mh-bar--r"><span style="width:@(ehtBar)%"></span></div>
                            <div class="mh-row-p">@ehtFaiz%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mh-note">
            <div class="mh-note-h"><i class="bi bi-info-circle"></i> Qeyd</div>
            <ul>
                <li>Mənbə: <code>arh_saldo_ls</code> dövriyyəsi. <b>Gəlir</b> = sinif 6/7 (kredit); <b>əməliyyat xərci</b> = faiz (84) + komissiya (87) + opex (sinif 9), EHTİYATSIZ (debet). Dövr: <b>başlanğıc–son</b> (default YTD).</li>
                <li><b>Rəqəm haradan gəlir?</b> Aşağıdakı gəlir/xərc sətirlərinə <b>klik</b> edin — hesab-səviyyə (GL) siyahı açılır; kateqoriya cəmi həmin hesabların toplamıdır.</li>
                <li><b>NII</b> = faiz gəliri − faiz xərci. <b>NIM</b> = NII / işləyən aktiv (müxbir+banklararası+kredit, son iş gününə) × (365/gün) — illik təxmini.</li>
                <li><b>Ehtiyat (sinif 89):</b> hər gün yenidən hesablandığı üçün "gross churn" böyük çıxır (<b>@Fmt(Model.EhtiyatGross) ₼</b>). Ona görə <b>xalis ehtiyat</b> = (ehtiyatdan əvvəl mənfəət − GL mənfəəti) kimi <b>törədilir</b> = <b>@Fmt(Model.XalisEhtiyat) ₼</b>.</li>
                <li><b>Xalis mənfəət = <code>50130</code></b> (GL). Konstruksiyaya görə: ehtiyatdan əvvəl mənfəət − xalis ehtiyat = 50130. <b>Kurs fərqi</b> (66 gəlir − 86 xərc, mövqe yenidən qiymətləndirmə) və <b>Dilinq fərqi</b> (68 gəlir − 88 xərc, dealing) <b>NET</b> olaraq <b>gəlir strukturunda</b> göstərilir (mənfi ola bilər) — əməliyyat xərcinə daxil edilmir; pre-provision mənfəət dəyişmir.</li>
            </ul>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            const palG = @palGjson;
            const palX = @palXjson;

            function donut(id, rows, pal) {
                const el = document.getElementById(id);
                if (!el || !rows || !rows.length) return;
                new Chart(el, {
                    type: 'doughnut',
                    data: { labels: rows.map(r => r.l), datasets: [{ data: rows.map(r => r.v), backgroundColor: pal, borderWidth: 0 }] },
                    options: {
                        cutout: '62%', responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { callbacks: { label: c => c.label + ': ' + Number(c.raw).toLocaleString('az-AZ') + ' ₼' } }
                        }
                    }
                });
            }
            donut('chGelir', @gelirJson, palG);
            donut('chXerc', @xercJson, palX);
        })();
    </script>
}

<style>
    .mh-wrap { max-width: 1280px; margin: 0 auto; padding: 8px 0 40px; color: #1e293b; }
    .mh-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px;
        background: linear-gradient(120deg, #0f2f5c 0%, #16478a 55%, #1e63b8 100%); color: #fff;
        border-radius: 18px; padding: 26px 30px; box-shadow: 0 12px 30px rgba(16,71,138,.28); flex-wrap: wrap; }
    .mh-hero--pl { background: linear-gradient(120deg, #064e3b 0%, #047857 55%, #059669 100%); box-shadow: 0 12px 30px rgba(5,150,105,.28); }
    .mh-badge { display: inline-flex; align-items: center; gap: 7px; background: rgba(255,255,255,.16); padding: 5px 13px; border-radius: 30px; font-size: 12.5px; font-weight: 600; margin-bottom: 10px; }
    .mh-title { font-size: 30px; font-weight: 800; margin: 0 0 6px; letter-spacing: -.5px; }
    .mh-sub { font-size: 13.5px; opacity: .92; }
    .mh-xls { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; background: rgba(255,255,255,.16); color: #fff; text-decoration: none; padding: 7px 14px; border-radius: 10px; font-size: 12.5px; font-weight: 600; }
    .mh-xls:hover { background: rgba(255,255,255,.26); color: #fff; }
    .mh-datef { display: flex; align-items: flex-end; gap: 8px; background: rgba(255,255,255,.12); padding: 12px 14px; border-radius: 14px; }
    .mh-datef--2 label { display: block; font-size: 11px; opacity: .85; margin-bottom: 3px; }
    .mh-datef input { border: none; border-radius: 9px; padding: 8px 10px; font-size: 13px; }
    .mh-datef button { border: none; background: #ffb703; color: #1a1a1a; font-weight: 700; border-radius: 9px; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .mh-alert { margin-top: 18px; background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: 12px; padding: 14px 18px; }

    .mh-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 16px; }
    .mh-kpi { position: relative; border-radius: 16px; padding: 20px; color: #fff; overflow: hidden; box-shadow: 0 8px 22px rgba(2,6,23,.12); }
    .mh-kpi--a { background: linear-gradient(135deg, #047857, #10b981); }
    .mh-kpi--t { background: linear-gradient(135deg, #0e7490, #06b6d4); }
    .mh-kpi--b { background: linear-gradient(135deg, #1d4ed8, #3b82f6); }
    .mh-kpi--w { background: linear-gradient(135deg, #b45309, #f59e0b); }
    .mh-kpi-ic { position: absolute; right: 14px; top: 12px; font-size: 30px; opacity: .28; }
    .mh-kpi-v { font-size: 24px; font-weight: 800; letter-spacing: -.5px; }
    .mh-kpi-v span { font-size: 14px; font-weight: 600; opacity: .85; }
    .mh-kpi-l { font-size: 12.5px; opacity: .92; margin-top: 3px; }
    .mh-kpi-f { font-size: 11px; opacity: .82; margin-top: 8px; padding-top: 7px; border-top: 1px solid rgba(255,255,255,.28); line-height: 1.45; }

    .mh-lcr { display: grid; grid-template-columns: 320px 1fr; gap: 18px; margin-top: 16px;
        background: linear-gradient(135deg, #064e3b, #047857); border-radius: 16px; padding: 22px 26px; color: #fff; box-shadow: 0 8px 22px rgba(5,150,105,.22); }
    .mh-lcr-t { font-size: 13px; opacity: .9; }
    .mh-lcr-v { font-size: 34px; font-weight: 800; letter-spacing: -1px; margin: 2px 0 6px; }
    .mh-lcr-v span { font-size: 16px; font-weight: 600; opacity: .85; }
    .mh-lcr-s { font-size: 12.5px; opacity: .92; }
    .mh-lcr-s b { font-weight: 800; }
    .mh-lcr-comp { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 22px; align-content: center; }
    .mh-lcr-comp > div { display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,.16); padding-bottom: 6px; font-size: 13px; }
    .mh-lcr-comp span { opacity: .88; } .mh-lcr-comp b { font-weight: 700; }
    .mh-ok { color: #bbf7d0; } .mh-warn { color: #fde68a; }
    .mh-lcr-gx { display: flex; gap: 22px; margin: 8px 0 6px; }
    .mh-lcr-gx > div { display: flex; flex-direction: column; }
    .mh-lcr-gx span { font-size: 11.5px; opacity: .85; }
    .mh-lcr-gx b { font-size: 16px; font-weight: 800; }
    .mh-ladder { grid-template-columns: 1fr; gap: 8px; }
    .mh-ladder > div b { white-space: nowrap; margin-left: 12px; }
    .mh-lad-h { font-weight: 800; font-size: 13.5px; border-bottom: none !important; padding-bottom: 0 !important; opacity: .95; }
    .mh-lad-eq { background: rgba(255,255,255,.12); border-radius: 8px; padding: 6px 10px; border-bottom: none !important; font-weight: 700; }

    .mh-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 18px; }
    .mh-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 16px rgba(2,6,23,.05); }
    .mh-card-h { display: flex; align-items: center; gap: 9px; font-weight: 700; font-size: 14.5px; padding: 15px 20px; border-bottom: 1px solid #eef2f7; }
    .mh-dot { width: 11px; height: 11px; border-radius: 4px; display: inline-block; }
    .mh-dot--g { background: #10b981; } .mh-dot--r { background: #ef4444; }
    .mh-card-b { display: grid; grid-template-columns: 170px 1fr; gap: 18px; padding: 18px 20px; align-items: start; }
    .mh-chart { height: 170px; position: relative; }
    .mh-list { display: flex; flex-direction: column; gap: 12px; }
    .mh-row-t { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; }
    .mh-row-t > span { color: #475569; display: inline-flex; align-items: center; } .mh-row-t b { color: #0f172a; }
    .mh-dot2 { width: 9px; height: 9px; border-radius: 3px; display: inline-block; margin-right: 7px; flex: 0 0 auto; }
    .mh-bar { height: 7px; background: #eef2f7; border-radius: 6px; overflow: hidden; }
    .mh-bar--g span { display: block; height: 100%; background: linear-gradient(90deg, #059669, #34d399); border-radius: 6px; }
    .mh-bar--r span { display: block; height: 100%; background: linear-gradient(90deg, #dc2626, #f87171); border-radius: 6px; }
    .mh-row-p { font-size: 11px; color: #94a3b8; text-align: right; margin-top: 2px; }

    .mh-note { margin-top: 18px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 14px; padding: 16px 22px; }
    .mh-note-h { font-weight: 700; color: #047857; margin-bottom: 8px; }
    .mh-note ul { margin: 0; padding-left: 18px; color: #334155; font-size: 13px; line-height: 1.7; }
    .mh-note code { background: #d1fae5; padding: 1px 6px; border-radius: 5px; font-size: 12px; }

    @@media (max-width: 900px) {
        .mh-kpis { grid-template-columns: 1fr 1fr; }
        .mh-lcr { grid-template-columns: 1fr; }
        .mh-lcr-comp { grid-template-columns: 1fr; }
        .mh-grid { grid-template-columns: 1fr; }
        .mh-card-b { grid-template-columns: 1fr; }
    }
</style>
