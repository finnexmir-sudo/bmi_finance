@using FinNex.Application.DTOs.Muhasibat
@model MuhasibatOs61Dto
@{
    ViewData["Title"] = "ÖS-6.1 — Müştəri Hesabları";
    var ayAdlari = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
        "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
    var cariIl = DateTime.Today.Year;
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N0") : "—";
}

<partial name="~/Areas/Muhasibat/Views/Dashboard/_MhStyles.cshtml" />

@* Dsmf1.cshtml-dəki eyni "paylaşılan faylda yoxdur" konvensiyası — yerli nüsxə. *@
<style>
    .mh-hero--os61 { background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%); padding: 16px 26px; }
    .mh-hero--os61 .mh-badge { margin-bottom: 6px; }
    .mh-hero--os61 .mh-title { font-size: 20px; margin: 0 0 3px; }
    .mh-hero--os61 .mh-sub { font-size: 12px; }
    .mh-hero--os61 .mh-xls { margin-top: 8px; }
    .mh-hero--os61 .mh-datef { padding: 7px 12px; gap: 8px; }
    .mh-hero--os61 .mh-datef select,
    .mh-hero--os61 .mh-datef button { height: 30px; font-size: 12px; }
    .os61-scroll { overflow: auto; max-height: 68vh; border-radius: 0 0 14px 14px; }
    .os61-scroll table.hj-table thead th { position: sticky; top: 0; z-index: 2; background: var(--hj-bg); }
    .os61-alt td:first-child { color: #94a3b8; }
    .os61-alt .os61-ad { padding-left: 14px; color: #64748b; font-style: italic; }
    .os61-manual { color: #b45309; font-size: 11px; }

    /* Dsmf1.cshtml-in ÖZ yerli "pr-*" sinifləri — paylaşılan fayl deyil, bura da
       təkrarlanıb (bax CLAUDE.md "paylaşılan faylda yoxdur" qeydi). */
    .pr-warn { display: flex; gap: 10px; padding: 13px 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; font-size: 12.5px; color: #713f12; line-height: 1.55; }
    .pr-warn i { color: #d97706; font-size: 17px; margin-top: 1px; }
    .pr-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; box-shadow: 0 4px 14px rgba(2,6,23,.05); overflow: hidden; }
    .pr-card-h { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; padding: 13px 18px; border-bottom: 1px solid #eef2f7; color: #1e293b; }
</style>

<div class="mh-wrap">
    <div class="mh-hero mh-hero--os61">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-person-lines-fill"></i> Mühasibat / Hesabatlar / ÖS-6.1</div>
            <h1 class="mh-title">ÖS-6.1 — Müştəri Hesabları</h1>
            <div class="mh-sub"><i class="bi bi-info-circle"></i> AMB "Ödəniş Statistikası" Əlavə 6.1 — @ayAdlari[Model.Ay] @Model.Il</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a asp-action="Os61Excel" asp-route-il="@Model.Il" asp-route-ay="@Model.Ay" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel (Köhnə şablon)</a>
                <a asp-action="Os61ExcelYeni" asp-route-il="@Model.Il" asp-route-ay="@Model.Ay" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel (Yeni şablon)</a>
                <a asp-action="Index" class="mh-xls"><i class="bi bi-arrow-left"></i> Hesabatlar siyahısına qayıt</a>
            </div>
        </div>
        <form method="get" class="mh-datef">
            <div class="mh-datef-f">
                <label>İl</label>
                <select name="il">
                    @for (int y = cariIl - 2; y <= cariIl + 1; y++)
                    {
                        <option value="@y" selected="@(y == Model.Il)">@y</option>
                    }
                </select>
            </div>
            <div class="mh-datef-f">
                <label>Ay</label>
                <select name="ay">
                    @for (int a = 1; a <= 12; a++)
                    {
                        <option value="@a" selected="@(a == Model.Ay)">@ayAdlari[a]</option>
                    }
                </select>
            </div>
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert" style="margin-top:14px;"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="pr-warn" style="margin-top:14px;">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                <b>Diqqət:</b> "ondan aktiv hesablar üzrə" (I/J) sütunları mənbə şablonda
                əksər sətirdə "Hesab sayı"nın (G/H) sadəcə TƏKRARIdır (mühasibin paralel,
                çarpaz-yoxlama mənbəyi) — yeni məlumat deyil. <span class="os61-manual">Sarı
                "Qeyd" sütunu</span> olan sətirlər mənbə şablonda ƏL İLƏ yazılan/sabit
                saxlanılan dəyərlərdir (Depozit vərəqi, və ya tək bir sabit ədəd) — Oracle-dan
                hesablanmır, "0/boş" ilə qarışdırılmasın.
            </div>
        </div>

        <div class="pr-card" style="margin-top:14px;">
            <div class="pr-card-h"><i class="bi bi-table"></i> @Model.Setirler.Count sətir</div>
            <div class="os61-scroll">
                <table class="hj-table" style="width:100%;">
                    <thead>
                        <tr>
                            <th rowspan="2">Bölmə №</th>
                            <th rowspan="2">Göstəricilərin adı</th>
                            <th rowspan="2">Kod</th>
                            <th colspan="3" style="text-align:center;">Hesabat ayı üzrə</th>
                            <th colspan="5" style="text-align:center;">Dövrün sonuna cəmi</th>
                            <th rowspan="2">Qeyd</th>
                        </tr>
                        <tr>
                            <th style="text-align:right;">Hesab sayı</th>
                            <th style="text-align:right;">ondan FX</th>
                            <th style="text-align:right;">Sahib sayı</th>
                            <th style="text-align:right;">Hesab sayı</th>
                            <th style="text-align:right;">ondan FX</th>
                            <th style="text-align:right;">ondan aktiv</th>
                            <th style="text-align:right;">aktiv/FX</th>
                            <th style="text-align:right;">Sahib sayı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Setirler)
                        {
                            <tr class="@(s.AltSetir ? "os61-alt" : "")">
                                <td>@s.BolmeNo</td>
                                <td class="@(s.AltSetir ? "os61-ad" : "")">@s.Ad</td>
                                <td>@s.Kod</td>
                                <td style="text-align:right;">@N(s.D_HesabSayiCemi)</td>
                                <td style="text-align:right;">@N(s.E_HesabSayiXariciValyuta)</td>
                                <td style="text-align:right;">@N(s.F_SahibSayi)</td>
                                <td style="text-align:right;">@N(s.G_HesabSayiCemi)</td>
                                <td style="text-align:right;">@N(s.H_HesabSayiXariciValyuta)</td>
                                <td style="text-align:right;">@N(s.I_AktivCemi)</td>
                                <td style="text-align:right;">@N(s.J_AktivXariciValyuta)</td>
                                <td style="text-align:right;">@N(s.K_SahibSayi)</td>
                                <td class="os61-manual">@s.ElIleQeyd</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<link rel="stylesheet" href="~/css/hr/hr-jeton.css" />
