@{
    ViewData["Title"] = "Mühasibat — Hesabatlar";
}

<partial name="~/Areas/Muhasibat/Views/Dashboard/_MhStyles.cshtml" />

<div class="mh-wrap">
    <div class="mh-hero mh-hero--hs">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-file-earmark-bar-graph"></i> Mühasibat</div>
            <h1 class="mh-title">Hesabatlar</h1>
            <div class="mh-sub"><i class="bi bi-clipboard-check"></i> Requlyativ və analitik hesabatlar</div>
        </div>
    </div>

    <partial name="~/Areas/Muhasibat/Views/Dashboard/_MhTabs.cshtml" />

    <div class="hs-grid">
        <a class="hs-card" asp-action="Ifrs9">
            <div class="hs-ic hs-ic--r"><i class="bi bi-clipboard2-pulse"></i></div>
            <div class="hs-body">
                <div class="hs-t">IFRS 9 — Gözlənilən Kredit İtkiləri (ECL)</div>
                <div class="hs-d">Roll-rate stage-keçid modeli. Cari portfelə tarixi risk faizini tətbiq edib ehtiyatı hesablayır (Stage 1/2/3).</div>
            </div>
            <i class="bi bi-arrow-right hs-go"></i>
        </a>

        <a class="hs-card" asp-action="Ifrs9">
            <div class="hs-ic hs-ic--b"><i class="bi bi-bank2"></i></div>
            <div class="hs-body">
                <div class="hs-t">AMB MHBS 9 — Rəsmi hesabat <span class="hs-badge hs-badge--ok">A1 hazır</span></div>
                <div class="hs-d">Mərkəzi Bankın MHBS 9 Cədvəl A1-i (kredit növü × Mərhələ 1/2/3, brüt + ECL) IFRS 9 nəticəsindən avtomatik. IFRS 9 səhifəsindən yüklə. A1.1/A1.2/A4 — növbəti mərhələ.</div>
            </div>
            <i class="bi bi-arrow-right hs-go"></i>
        </a>
    </div>
</div>

<style>
    .mh-hero--hs { background: linear-gradient(120deg, #16478a, #1e63b8); }
    .hs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; margin-top: 18px; }
    .hs-card { display: flex; align-items: center; gap: 14px; background: #fff; border: 1px solid #e6ebf2; border-radius: 14px;
        padding: 16px 18px; text-decoration: none; box-shadow: 0 4px 14px rgba(2,6,23,.05); transition: .15s; }
    .hs-card:hover { box-shadow: 0 10px 26px rgba(2,6,23,.1); transform: translateY(-1px); }
    .hs-card--soon { opacity: .72; cursor: default; }
    .hs-card--soon:hover { box-shadow: 0 4px 14px rgba(2,6,23,.05); transform: none; }
    .hs-ic { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex: none; }
    .hs-ic--r { background: rgba(185,28,28,.12); color: #b91c1c; }
    .hs-ic--b { background: rgba(22,71,138,.12); color: #16478a; }
    .hs-body { flex: 1; }
    .hs-t { font-weight: 700; font-size: 14.5px; color: #1e293b; }
    .hs-d { font-size: 12.5px; color: #64748b; margin-top: 3px; line-height: 1.5; }
    .hs-badge { display: inline-block; background: #fef3c7; color: #92400e; border-radius: 6px; padding: 1px 7px; font-size: 10.5px; font-weight: 700; vertical-align: middle; margin-left: 4px; }
    .hs-badge--ok { background: #dcfce7; color: #166534; }
    .hs-go { color: #94a3b8; font-size: 18px; }
</style>
