@model List<FinNex.Application.DTOs.Muhasibat.HesabatKartDto>
@{
    ViewData["Title"] = "Mühasibat — Maliyyə Hesabatları";

    // Pill sırası sabitdir (kateqoriyanın kataloqdakı sırası ilə qarışmasın) —
    // yalnız real kartı olan kateqoriyalar göstərilir.
    var kateqoriyaSirasi = new[] { "Maliyyə", "Kreditlər", "Risk", "Xərclər" };
    var kateqoriyalar = kateqoriyaSirasi.Where(k => Model.Any(x => x.Kateqoriya == k)).ToList();
    var secilmisler = Model.Where(x => x.Secilib).ToList();
}

<partial name="~/Areas/Muhasibat/Views/Dashboard/_MhStyles.cshtml" />

@Html.AntiForgeryToken()

<div class="mh-wrap">
    <div class="mh-hero mh-hero--hs">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-file-earmark-bar-graph"></i> Mühasibat</div>
            <h1 class="mh-title">Maliyyə Hesabatları</h1>
            <div class="mh-sub"><i class="bi bi-clipboard-check"></i> Requlyativ, analitik və idarəetmə hesabatları — bir yerdə</div>
        </div>
    </div>

    <partial name="~/Areas/Muhasibat/Views/Dashboard/_MhTabs.cshtml" />

    <div class="hs-toolbar">
        <div class="hs-search">
            <i class="bi bi-search"></i>
            <input type="text" id="hsSearch" placeholder="Hesabat axtar...">
        </div>
        <div class="hs-pills" id="hsPills">
            <button type="button" class="hs-pill on" data-kat="">Hamısı</button>
            @foreach (var k in kateqoriyalar)
            {
                <button type="button" class="hs-pill" data-kat="@k">@k</button>
            }
        </div>
    </div>

    @if (secilmisler.Any())
    {
        <div class="hs-section-title"><i class="bi bi-star-fill"></i> Seçilmişlər</div>
        <div class="hs-grid" id="hsFavGrid">
            @foreach (var k in secilmisler)
            {
                <div class="hs-card" data-kod="@k.Kod">
                    <a class="hs-card-link" asp-area="@k.Area" asp-controller="@k.Controller" asp-action="@k.Action">
                        <div class="hs-ic"><i class="bi @k.Ikon"></i></div>
                        <div class="hs-body">
                            <div class="hs-t">@k.Ad</div>
                            <div class="hs-d">@k.Tesvir</div>
                        </div>
                        <i class="bi bi-arrow-right hs-go"></i>
                    </a>
                    <button type="button" class="hs-star on" data-kod="@k.Kod" title="Seçilmişlərdən çıxar"><i class="bi bi-star-fill"></i></button>
                </div>
            }
        </div>
    }

    <div class="hs-section-title"><i class="bi bi-collection"></i> Bütün hesabatlar <span class="hs-count">@Model.Count hesabat</span></div>

    <div class="hs-list" id="hsList">
        @foreach (var k in Model)
        {
            <div class="hs-row" data-kat="@k.Kateqoriya" data-ad="@k.Ad.ToLowerInvariant()" data-desc="@k.Tesvir.ToLowerInvariant()" data-kod="@k.Kod">
                <button type="button" class="hs-star @(k.Secilib ? "on" : "")" data-kod="@k.Kod" title="@(k.Secilib ? "Seçilmişlərdən çıxar" : "Seçilmişlərə əlavə et")">
                    <i class="bi @(k.Secilib ? "bi-star-fill" : "bi-star")"></i>
                </button>
                <a class="hs-row-link" asp-area="@k.Area" asp-controller="@k.Controller" asp-action="@k.Action">
                    <div class="hs-row-ic"><i class="bi @k.Ikon"></i></div>
                    <div class="hs-row-main">
                        <div class="hs-row-t">@k.Ad</div>
                        <div class="hs-row-d">@k.Tesvir</div>
                    </div>
                    <span class="hs-row-kat hs-kat--@k.Kateqoriya.ToLowerInvariant()">@k.Kateqoriya</span>
                    <span class="hs-row-aç">Aç <i class="bi bi-arrow-right"></i></span>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .mh-hero--hs { background: linear-gradient(120deg, #16478a, #1e63b8); }

    .hs-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 18px; }
    .hs-search { position: relative; flex: 1; min-width: 220px; max-width: 360px; }
    .hs-search i { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 14px; }
    .hs-search input { width: 100%; box-sizing: border-box; padding: 9px 12px 9px 34px; border-radius: 10px;
        border: 1px solid #e2e8f0; font-size: 13.5px; background: #fff; }
    .hs-search input:focus { outline: none; border-color: #1e63b8; box-shadow: 0 0 0 3px rgba(30,99,184,.12); }

    .hs-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .hs-pill { border: 1px solid #e2e8f0; background: #fff; color: #475569; font-size: 12.5px; font-weight: 600;
        padding: 7px 15px; border-radius: 999px; cursor: pointer; transition: .15s; }
    .hs-pill:hover { border-color: #cbd5e1; }
    .hs-pill.on { background: #16478a; border-color: #16478a; color: #fff; }

    .hs-section-title { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700;
        color: #475569; margin: 22px 0 10px; }
    .hs-section-title i { color: #f59e0b; }
    .hs-count { font-weight: 500; color: #94a3b8; margin-left: 4px; }

    .hs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
    .hs-card { position: relative; background: #fff; border: 1px solid #e6ebf2; border-radius: 14px;
        box-shadow: 0 4px 14px rgba(2,6,23,.05); transition: .15s; }
    .hs-card:hover { box-shadow: 0 10px 26px rgba(2,6,23,.1); transform: translateY(-1px); }
    .hs-card-link { display: flex; align-items: center; gap: 14px; padding: 16px 44px 16px 18px; text-decoration: none; }
    .hs-ic { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 22px; flex: none; background: rgba(22,71,138,.1); color: #16478a; }
    .hs-body { flex: 1; min-width: 0; }
    .hs-t { font-weight: 700; font-size: 14.5px; color: #1e293b; }
    .hs-d { font-size: 12.5px; color: #64748b; margin-top: 3px; line-height: 1.5; }
    .hs-go { color: #94a3b8; font-size: 18px; flex: none; }

    .hs-star { position: absolute; top: 12px; right: 12px; border: none; background: transparent; color: #cbd5e1;
        font-size: 17px; cursor: pointer; padding: 4px; line-height: 1; border-radius: 8px; z-index: 5; }
    .hs-star:hover { color: #f59e0b; background: #fef3c7; }
    .hs-star.on { color: #f59e0b; }

    .hs-list { background: #fff; border-radius: 16px; border: 1px solid #e6ebf2; box-shadow: 0 2px 14px rgba(2,6,23,.05); overflow: hidden; }
    .hs-row { display: flex; align-items: center; border-bottom: 1px solid #eef1f6; }
    .hs-row:last-child { border-bottom: none; }
    .hs-row .hs-star { position: static; margin-left: 14px; flex: none; }
    .hs-row-link { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; padding: 14px 18px 14px 6px; text-decoration: none; }
    .hs-row-ic { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
        font-size: 17px; flex: none; background: rgba(22,71,138,.1); color: #16478a; }
    .hs-row-main { flex: 1; min-width: 0; }
    .hs-row-t { font-weight: 700; font-size: 13.5px; color: #1e293b; }
    .hs-row-d { font-size: 12px; color: #64748b; margin-top: 2px; }
    .hs-row-kat { flex: none; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
    .hs-kat--maliyyə { background: #e0ecff; color: #1d4ed8; }
    .hs-kat--kreditlər { background: #ede9fe; color: #6d28d9; }
    .hs-kat--risk { background: #fee2e2; color: #b91c1c; }
    .hs-kat--xərclər { background: #dcfce7; color: #15803d; }
    .hs-row-aç { flex: none; font-size: 12.5px; font-weight: 700; color: #16478a; white-space: nowrap; }
    .hs-row-aç i { font-size: 11px; margin-left: 2px; }

    @@media (max-width: 680px) {
        .hs-row-d, .hs-row-kat { display: none; }
        .hs-row-link { padding: 12px; }
    }
</style>

<script>
(function () {
    var searchEl = document.getElementById('hsSearch');
    var pillsEl = document.getElementById('hsPills');
    var listEl = document.getElementById('hsList');
    var token = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? '';
    var aktivKat = '';

    function suz() {
        var q = (searchEl.value || '').trim().toLowerCase();
        listEl.querySelectorAll('.hs-row').forEach(function (row) {
            var katOk = !aktivKat || row.dataset.kat === aktivKat;
            var qOk = !q || row.dataset.ad.indexOf(q) !== -1 || row.dataset.desc.indexOf(q) !== -1;
            row.style.display = (katOk && qOk) ? '' : 'none';
        });
    }

    searchEl.addEventListener('input', suz);

    pillsEl.addEventListener('click', function (e) {
        var btn = e.target.closest('.hs-pill');
        if (!btn) return;
        pillsEl.querySelectorAll('.hs-pill').forEach(function (b) { b.classList.remove('on'); });
        btn.classList.add('on');
        aktivKat = btn.dataset.kat || '';
        suz();
    });

    document.addEventListener('click', async function (e) {
        var star = e.target.closest('.hs-star');
        if (!star) return;
        var kod = star.dataset.kod;
        if (!kod || star.disabled) return;
        star.disabled = true;
        try {
            var r = await fetch('@Url.Action("SeciliDeyis")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'kod=' + encodeURIComponent(kod)
            });
            var d = await r.json();
            if (d.ok) location.reload();
            else star.disabled = false;
        } catch {
            star.disabled = false;
        }
    });
})();
</script>
