@model FinNex.Application.DTOs.Muhasibat.MuhasibatForma0250Dto
@{
    ViewData["Title"] = "Forma 0250 — Baş Kitab (CBAR)";
    string N(decimal? v) => v.HasValue ? v.Value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture) : "—";
    string N4(decimal? v) => v.HasValue ? v.Value.ToString("N4", System.Globalization.CultureInfo.InvariantCulture) : "—";
}

<partial name="~/Areas/Muhasibat/Views/Dashboard/_MhStyles.cshtml" />

@* Dsmf1.cshtml-dəki eyni "paylaşılan faylda yoxdur" problemi — eyni yerli nüsxə. *@
<style>
    .mh-hero--f0250 { background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%); padding: 16px 26px; }
    .mh-hero--f0250 .mh-badge { margin-bottom: 6px; }
    .mh-hero--f0250 .mh-title { font-size: 20px; margin: 0 0 3px; }
    .mh-hero--f0250 .mh-sub { font-size: 12px; }
    .mh-hero--f0250 .mh-xls { margin-top: 8px; }
    .mh-hero--f0250 .mh-datef { padding: 7px 12px; gap: 8px; }
    .mh-hero--f0250 .mh-datef input,
    .mh-hero--f0250 .mh-datef button { height: 30px; font-size: 12px; }
    .pr-warn { display: flex; gap: 10px; padding: 13px 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 12px; font-size: 12.5px; color: #713f12; line-height: 1.55; }
    .pr-warn i { color: #d97706; font-size: 17px; margin-top: 1px; }
    .pr-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; box-shadow: 0 4px 14px rgba(2,6,23,.05); overflow: hidden; }
    .pr-card-h { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; padding: 13px 18px; border-bottom: 1px solid #eef2f7; color: #1e293b; }
    .f0250-scroll { overflow: auto; max-height: 65vh; border-radius: 0 0 14px 14px; }
    .f0250-scroll table.hj-table thead th { position: sticky; top: 0; z-index: 2; background: var(--hj-bg); }
</style>

<div class="mh-wrap">
    <div class="mh-hero mh-hero--f0250">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-journal-text"></i> Mühasibat / Hesabatlar / Aylıq</div>
            <h1 class="mh-title">Forma 0250 — Baş Kitab (CBAR)</h1>
            <div class="mh-sub"><i class="bi bi-calendar-range"></i> @Model.Bas.ToString("dd.MM.yyyy") — @Model.Son.ToString("dd.MM.yyyy")</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a asp-action="Forma0250Excel" asp-route-bas="@Model.Bas.ToString("yyyy-MM-dd")" asp-route-son="@Model.Son.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> Excel-ə ixrac et</a>
                <a asp-action="Index" class="mh-xls"><i class="bi bi-arrow-left"></i> Hesabatlar siyahısına qayıt</a>
            </div>
        </div>
        <form method="get" class="mh-datef">
            <div class="mh-datef-f">
                <label>Başlanğıc</label>
                <input type="date" name="bas" value="@Model.Bas.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mh-datef-f">
                <label>Son</label>
                <input type="date" name="son" value="@Model.Son.ToString("yyyy-MM-dd")" />
            </div>
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <div class="pr-warn" style="margin-top:14px;">
        <i class="bi bi-exclamation-triangle"></i>
        <div>
            <b>Mənbə:</b> AMB-yə aylıq təqdim olunan Baş Kitab sorğusu — balanslı hesablar
            (<code>arh_saldo_ls</code>) + balansdankənar hesablar (<code>arh_dd</code>, 50130 istisna).
            KOD bir neçə hesabı birləşdirə bilər (məs. KOD <b>478</b> onlarla hesabı toplayır) —
            burada görünən sətir sayı BMI-nin hesab sayı ilə YOX, AMB-nin KOD×valyuta sayı ilə üst-üstə düşür.
            Qalıqlar/dövriyyələri sıfır olan KOD×valyuta cütü siyahıda göstərilmir.
        </div>
    </div>

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert" style="margin-top:14px;"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="pr-card" style="margin-top:14px;">
            <div class="pr-card-h"><i class="bi bi-table"></i> Nəticə — @Model.Setirler.Count sətir</div>
            @if (Model.Setirler.Count == 0)
            {
                <div style="padding:22px; text-align:center; color:#64748b; font-size:13.5px;">
                    <i class="bi bi-inbox" style="font-size:22px; display:block; margin-bottom:6px;"></i>
                    Bu dövrdə (@Model.Bas.ToString("dd.MM.yyyy") — @Model.Son.ToString("dd.MM.yyyy")) heç bir qalıq/dövriyyə tapılmadı.
                </div>
            }
            else
            {
                <div class="f0250-scroll">
                    <table class="hj-table" style="width:100%;">
                        <thead>
                            <tr>
                                <th style="text-align:right;">Məzənnə</th>
                                <th style="text-align:right;">Qapanış (valyuta)</th>
                                <th style="text-align:right;">Qapanış (AZN)</th>
                                <th style="text-align:right;">Kredit dövriyyəsi</th>
                                <th style="text-align:right;">Debet dövriyyəsi</th>
                                <th style="text-align:right;">Açılış (AZN)</th>
                                <th>Valyuta</th>
                                <th>KOD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in Model.Setirler)
                            {
                                <tr>
                                    <td style="text-align:right;">@N4(x.Rate)</td>
                                    <td style="text-align:right;">@N(x.ClosingBase)</td>
                                    <td style="text-align:right;">@N(x.ClosingLocal)</td>
                                    <td style="text-align:right;">@N(x.CreditTurnover)</td>
                                    <td style="text-align:right;">@N(x.DebitTurnover)</td>
                                    <td style="text-align:right;">@N(x.OpeningLocal)</td>
                                    <td>@x.CurrencyType</td>
                                    <td><b>@x.Kod</b></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<link rel="stylesheet" href="~/css/hr/hr-jeton.css" />
