@model MuhasibatIfrs9Dto
@{
    ViewData["Title"] = "IFRS 9 — Gözlənilən Kredit İtkiləri (ECL)";
    // Zolaq eni — CSS ucun INVARIANT format (az-AZ vergul 73,3% etibarsizdir, zolaq tam dolur); menfi/100+ sixilir.
    string Bw(decimal v) => Math.Min(100m, Math.Abs(v)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string Fmt(decimal v) => v.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    string Fmt2(decimal v) => v.ToString("#,##0.00", System.Globalization.CultureInfo.InvariantCulture).Replace(",", " ");
    string StR(decimal v) => v < 0 ? "—" : Fmt2(v) + "%";   // mərhələ risk %-i (-1 = kredit yoxdur)
    string Ff(decimal v) => v.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);  // floor faizi (parametrdən): 0.1 / 1 / 2
}

<partial name="~/Areas/Muhasibat/Views/Dashboard/_MhStyles.cshtml" />

<div class="mh-wrap">
    <div class="mh-hero mh-hero--if">
        <div class="mh-hero-l">
            <div class="mh-badge"><i class="bi bi-clipboard2-pulse"></i> Mühasibat / Hesabatlar</div>
            <h1 class="mh-title">IFRS 9 — Gözlənilən Kredit İtkiləri (ECL)</h1>
            <div class="mh-sub"><i class="bi bi-calendar3"></i> Hesabat tarixi: <b>@Model.Tarix.ToString("dd.MM.yyyy")</b></div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                <a asp-action="Ifrs9Excel" asp-route-t="@Model.Tarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-file-earmark-excel"></i> ECL detalı</a>
                <a asp-action="Ifrs9IsKagizlari" asp-route-t="@Model.Tarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-journal-check"></i> İş kağızları (audit)</a>
                <a asp-action="AmbA1Excel" asp-route-t="@Model.Tarix.ToString("yyyy-MM-dd")" class="mh-xls"><i class="bi bi-bank2"></i> AMB MHBS 9 · A1</a>
                <button type="button" class="mh-xls" onclick="document.getElementById('metodPanel').classList.toggle('acik')"><i class="bi bi-info-circle"></i> Metodologiya</button>
                <button type="button" class="mh-xls" onclick="var p=document.getElementById('metodPanel');p.classList.add('acik');setTimeout(function(){window.print();},60);"><i class="bi bi-printer"></i> Qaydanı çap et</button>
                @if (User.IsInRole(FinNex.Domain.RoleNames.Admin) || User.IsInRole(FinNex.Domain.RoleNames.Muhasib))
                {
                    <a asp-action="Ifrs9Parametr" class="mh-xls"><i class="bi bi-sliders"></i> Parametrlər</a>
                }
            </div>
        </div>
        <form method="get" class="mh-datef">
            <label>Tarix</label>
            <input type="date" name="t" value="@Model.Tarix.ToString("yyyy-MM-dd")" />
            <button type="submit"><i class="bi bi-arrow-repeat"></i> Göstər</button>
        </form>
    </div>

    <partial name="~/Areas/Muhasibat/Views/Dashboard/_MhTabs.cshtml" />

    <div id="metodPanel" class="metod-panel">
        <div class="metod-h"><i class="bi bi-diagram-3"></i> Metodologiya — bu ehtiyat rəqəmlərinə necə gəlirik</div>

        <div class="metod-metodbar">
            <div>
                <span class="metod-bar-l">Aktiv metod:</span>
                @if (Model.Metod == "MB")
                {
                    <span class="metod-mb-badge"><i class="bi bi-bank"></i> AMB Metodoloji Rəhbərliyi — 23.12.2025, Protokol № 45/2</span>
                }
                else
                {
                    <span class="metod-ex-badge"><i class="bi bi-file-earmark-spreadsheet"></i> Excel (təsdiqlənmiş) model</span>
                }
                <span class="metod-bar-d">· Hesabat tarixi @Model.Tarix.ToString("dd.MM.yyyy")</span>
            </div>
            <a asp-action="AmbQaydaSened" class="metod-yukle" target="_blank"><i class="bi bi-download"></i> AMB qaydasını yüklə (.docx)</a>
        </div>

        <div class="metod-intro">
            <b>Əsas fikir (bir cümlə ilə):</b> Biz "bu kredit indi problemlidir" demirik — <b>keçmiş 5 ilin real təcrübəsinə</b>
            əsasən "bu tip kreditlərin hansı hissəsini adətən itiririk?" sualına cavab veririk və həmin faizi
            <b>bugünkü portfelə</b> tətbiq edirik. Yəni: <b>ehtiyat = son 5 ilin real itki təcrübəsi × bugünkü qalıq.</b>
            IFRS 9 məhz bunu — <b>gözlənilən (gələcək) itkini</b> — tələb edir, təkcə bugünkü vəziyyəti yox.
        </div>

        <div class="metod-grid">
            <div class="metod-b">
                <div class="metod-t"><span class="metod-n">1</span> Mərhələ — kredit hansı səbətdədir?</div>
                Hər kredit <b>gecikmə gününə</b> görə 3 səbətdən birinə düşür:<br>
                • <b>Mərhələ 1</b> — 0–30 gün (sağlam)<br>
                • <b>Mərhələ 2</b> — 31–90 gün (nəzarətdə, gecikmə başlayıb)<br>
                • <b>Mərhələ 3</b> — 90+ gün (problemli / defolt)
            </div>
            <div class="metod-b">
                <div class="metod-t"><span class="metod-n">2</span> Tarixi risk faizi (modelin ürəyi)</div>
                Son <b>5 ilə</b> baxırıq: hər <b>sahə × mərhələ</b> üçün — ilin əvvəlində bu mərhələdə olan kreditlərin
                <b>neçə faizini real itirdik</b> (geri qaytara bilmədik)?<br>
                <b>risk% = tarixi itki məbləği (M) ÷ tarixi başlanğıc qalıq (F)</b>, 5 il üzrə orta.<br>
                <i>Hər sahə×mərhələnin faizi — İş kağızları, 2-ci vərəq.</i>
            </div>
            <div class="metod-b">
                <div class="metod-t"><span class="metod-n">3</span> Bərpa — problemli kreditdə girovdan qaytarılan pul</div>
                <b>Bərpa nədir?</b> Kredit problemli olanda (Mərhələ 3, 90+ gün) borcalan ödəməsə belə, biz hər şeyi
                itirmirik — <b>girovu (əmlak, avadanlıq) satıb pulun bir hissəsini geri alırıq</b>. Son 5 ilin real
                bərpa təcrübəsi:<br>
                • <b>Mənzil (girovda daşınmaz əmlak): @((Model.Q2*100).ToString("0.0"))%</b> qayıdır (Q2)<br>
                • <b>Digər kreditlər: @((Model.P2*100).ToString("0.0"))%</b> qayıdır (P2)<br>
                @if (Model.MenzilGuzest)
                {
                    <span class="metod-badge metod-badge--on"><i class="bi bi-house-check"></i> Mənzil güzəşti AÇIQ</span>
                    <text> — mənzil öz bərpasını (Q2) alır, digər kreditlər P2.</text>
                }
                else
                {
                    <span class="metod-badge metod-badge--off"><i class="bi bi-house-slash"></i> Mənzil güzəşti BAĞLI</span>
                    <text> — mənzil də adi kredit kimi P2 bərpasını alır.</text>
                }
            </div>
            <div class="metod-b metod-b--wide">
                <div class="metod-t"><span class="metod-n">3b</span> Mərhələ 3 (problemli) necə hesablanır — <b>aktiv metod</b></div>
                @if (Model.Metod == "MB")
                {
                    <div class="metod-formula metod-formula--mb">ECL<sub>M3</sub> = EAD<sub>fact</sub> × LGD<sub>ID</sub> &nbsp;&nbsp;·&nbsp;&nbsp; <b>LGD = 1 − bərpa</b></div>
                    <text>
                    <b>İstinad — AMB Rəhbərliyi (23.12.2025 № 45/2), «Ehtiyatlanma» bölməsi, «mərhələ 3 üzrə kollektiv əsasda ECL»:</b>
                    <i>«ECL = EAD<sub>fact</sub> × LGD<sub>ID</sub>»</i> və <i>«LGL = 1 − Total recovery%»</i>. Mərhələ 3-də kredit <b>artıq defolt olub</b> — yəni
                    defolt ehtimalı (PD) 100%-dir, bir daha vurulmur. İtki yalnız <b>LGD</b>-dir: geri ala bilmədiyimiz pay.
                    Bərpa nə qədər <b>çox</b>dursa, LGD (itki) bir o qədər <b>az</b>dır — girov düzgün qoruyur:<br>
                    • Mənzil LGD = 1 − @((Model.Q2*100).ToString("0.0"))% = <b>@(((1-Model.Q2)*100).ToString("0.0"))%</b><br>
                    • Digər LGD = 1 − @((Model.P2*100).ToString("0.0"))% = <b>@(((1-Model.P2)*100).ToString("0.0"))%</b><br>
                    Mənzil daha az itirir (@(((1-Model.Q2)*100).ToString("0.0"))% &lt; @(((1-Model.P2)*100).ToString("0.0"))%) — MB-nin
                    təminat cədvəlinə (Bakı daşınmaz əmlak ≈ 50%) uyğundur.
                    </text>
                }
                else
                {
                    <div class="metod-formula">risk%<sub>M3</sub> = (batıqda qalma faizi) × bərpa</div>
                    <text>
                    <b>Excel (təsdiqlənmiş) model:</b> Mərhələ 3 riski tarixi keçid matrisindən gəlir — batıqda qalan payı
                    bərpa əmsalına vurulur. <b>Qeyd:</b> bu düsturda bərpası <b>yüksək</b> olan kredit (mənzil) riyazi olaraq
                    <b>daha yüksək</b> risk faizi alır. AMB qaydası isə əksini — LGD = 1 − bərpa — istəyir. Requlyativ hesabat
                    üçün <b>AMB metodunu</b> seçmək tövsiyə olunur (Parametrlər səhifəsi).
                    </text>
                }
            </div>
            <div class="metod-b">
                <div class="metod-t"><span class="metod-n">4</span> EAD — bugünkü ekspozisiya</div>
                Əsas borc + <b>vaxtı keçmiş əsas borc</b> (<code>summa + summa_19</code>), AZN-ə çevrilmiş.
                Əsas qalığı 0 olsa da <b>açıq</b> kredit (vaxtı keçmiş borcu olan) daxildir.
            </div>
            <div class="metod-b">
                <div class="metod-t"><span class="metod-n">5</span> Nəticə — bugünə tətbiq</div>
                <b>ECL = bugünkü EAD × risk faizi(sahə, mərhələ)</b>.<br>
                Mərhələ 1 & 2 üçün risk faizi tarixi keçiddən (floor ilə), Mərhələ 3 üçün yuxarıdakı
                <b>aktiv metoda</b> görə hesablanır. Bütün portfel üzrə cəmlənir → cədvəldəki ehtiyat rəqəmi.
            </div>
        </div>

        <div class="metod-menzil">
            <div class="metod-t"><i class="bi bi-house-lock"></i> Minimum floor (aşağı hədd) və <b>mənzil güzəşti</b>
                @if (Model.MenzilGuzest)
                {
                    <span class="metod-badge metod-badge--on"><i class="bi bi-toggle-on"></i> güzəşt AÇIQ</span>
                }
                else
                {
                    <span class="metod-badge metod-badge--off"><i class="bi bi-toggle-off"></i> güzəşt BAĞLI</span>
                }
            </div>
            <p>"Heç bir kredit tam risksiz deyil" (IFRS 9 B5.5.54) — tarix az itki göstərsə belə, <b>minimum</b> ehtiyat ayırırıq.
               <i>Aşağıdakı faizlər <b>proqram parametrlərindən</b> gəlir (Parametrlər səhifəsində dəyişdirilə bilər) — bu panel həmişə cari dəyərləri göstərir:</i></p>
            <table class="metod-tbl">
                <thead><tr><th>Kredit növü</th><th>Minimum floor</th><th>Niyə məhz bu?</th></tr></thead>
                <tbody>
                    @if (Model.MenzilGuzest)
                    {
                        <tr class="metod-hl"><td><b>Mənzil</b> (daşınmaz əmlakla təminatlı · 1902/1904)</td><td><b>@Ff(Model.MenzilFloor)%</b><br><span style="font-size:11px;color:#059669;font-weight:600">bütün mərhələlərdə eyni</span></td><td>Girovda ev/mənzil var — müştəri ödəməsə əmlakı satıb pulu qaytarırıq, ona görə risk çox aşağı. <b>Bu, bizim güzəştimizdir.</b> Bu @Ff(Model.MenzilFloor)% <b>Mərhələ 1, 2, 3-ün hamısında eynidir</b> (girov hər mərhələdə qoruyur). Problemli (Mərhələ 3) mənzildə bərpa da <b>Q2 (@((Model.Q2*100).ToString("0.0"))%)</b> — daha yüksək.</td></tr>
                    }
                    else
                    {
                        <tr><td><b>Mənzil</b> (daşınmaz əmlakla təminatlı · 1902/1904)<br><span style="font-size:11px;color:#b91c1c;font-weight:600">güzəşt bağlı — adi kredit kimi</span></td><td><b>@Ff(Model.Stage1Floor)% / @Ff(Model.Stage2Floor)%</b><br><span style="font-size:11px;color:#b91c1c;font-weight:600">mərhələyə görə</span></td><td>Güzəşt <b>bağlıdır</b>: mənzil ayrıca aşağı floor <b>almır</b>, digər kreditlər kimi mərhələ floor-una (Mərhələ 1 → @Ff(Model.Stage1Floor)%, Mərhələ 2 → @Ff(Model.Stage2Floor)%) tabedir. Bərpası da <b>P2 (@((Model.P2*100).ToString("0.0"))%)</b> — Q2 üstünlüyü yoxdur.</td></tr>
                    }
                    <tr><td><b>Mərhələ 1</b> (sağlam, təminatsız)</td><td><b>@Ff(Model.Stage1Floor)%</b></td><td>Bu gün sağlamdır, amma təcrübə göstərir ki, bir hissəsi gələcəkdə gecikəcək.</td></tr>
                    <tr><td><b>Mərhələ 2</b> (nəzarətdə, təminatsız)</td><td><b>@Ff(Model.Stage2Floor)%</b></td><td>Gecikmə artıq başlayıb — risk daha yüksək, minimum ikiqat.</td></tr>
                    <tr><td><b>Mərhələ 3</b> (problemli)</td><td>bərpa əsaslı</td><td>Sabit floor yox — yuxarıdakı bərpa faizi (3-cü addım) tətbiq olunur.</td></tr>
                </tbody>
            </table>
            @if (Model.MenzilGuzest)
            {
                <p class="metod-note"><i class="bi bi-lightbulb"></i> <b>Güzəşt niyə?</b> Daşınmaz əmlakla təminatlı kreditdə (mənzil) girov güclüdür — itki ehtimalı təminatsız istehlak kreditindən <b>10–20 dəfə</b> aşağıdır (@Ff(Model.MenzilFloor)% ↔ @Ff(Model.Stage1Floor)–@Ff(Model.Stage2Floor)%). Mənzil <b>həm</b> aşağı floor (@Ff(Model.MenzilFloor)%) <b>həm də</b> yüksək bərpa (Q2 @((Model.Q2*100).ToString("0.0"))%) alır. Bu, IFRS 9 B5.5.55 (təminatın rolu) əsasındadır.</p>
            }
            else
            {
                <p class="metod-note"><i class="bi bi-info-circle"></i> <b>Güzəşt bağlıdır:</b> mənzil <b>tam adi kredit kimi</b> yanaşılır — nə aşağı floor (@Ff(Model.MenzilFloor)%), nə də yüksək bərpa (Q2) tətbiq olunur. Mənzil də mərhələ floor-una (@Ff(Model.Stage1Floor)%/@Ff(Model.Stage2Floor)%) və P2 bərpasına (@((Model.P2*100).ToString("0.0"))%) tabedir. Nəticədə ECL bir qədər artır.</p>
            }
        </div>

        <div class="metod-numune">
            <div class="metod-t"><i class="bi bi-calculator"></i> Sadə nümunə</div>
            <div class="metod-numune-g">
                <div><b>100 000 ₼ mənzil krediti</b>, Mərhələ 1 → floor <b>@Ff(Model.MenzilFloor)%</b> → ehtiyat <b>@(((Model.MenzilFloor/100m)*100000m).ToString("#,##0"))  ₼</b></div>
                <div><b>100 000 ₼ təminatsız istehlak</b>, Mərhələ 1 → floor <b>@Ff(Model.Stage1Floor)%</b> → ehtiyat <b>@(((Model.Stage1Floor/100m)*100000m).ToString("#,##0")) ₼</b></div>
                @if (Model.Metod == "MB")
                {
                    <div><b>100 000 ₼ təminatsız, Mərhələ 3 (problemli)</b> → LGD = 1 − @((Model.P2*100).ToString("0.0"))% = <b>@(((1-Model.P2)*100).ToString("0.0"))%</b> → ehtiyat ≈ <b>@(((1-Model.P2)*100000m).ToString("#,##0")) ₼</b></div>
                    <div><b>100 000 ₼ mənzil, Mərhələ 3</b> → LGD = 1 − @((Model.Q2*100).ToString("0.0"))% = <b>@(((1-Model.Q2)*100).ToString("0.0"))%</b> → ehtiyat ≈ <b>@(((1-Model.Q2)*100000m).ToString("#,##0")) ₼</b> <span style="color:#059669">(girov azaldır)</span></div>
                }
                else
                {
                    <div><b>Eyni məbləğ, Mərhələ 3 (problemli), təminatsız</b> → risk faizi tarixi keçiddən (batıqda qalma × bərpa) hesablanır — cədvəldəki St.3 sütununa bax</div>
                }
            </div>
            <p class="metod-note">Fərq tamamilə girovdadır: mənzildə əmlak var, təminatsızda yoxdur.</p>
        </div>

        <div class="metod-audit">
            <i class="bi bi-list-check"></i>
            <div><b>Bu ehtiyat necə çıxdı — addım-addım (sadə dillə):</b>
                ① kredit gecikmə gününə görə mərhələyə düşür → ② həmin sahə×mərhələnin <b>son 5 illik real itki faizi</b> götürülür →
                ③ minimum floor yoxlanır (mənzildə 0.1% güzəşt) → ④ problemlidirsə bərpa çıxılır → ⑤ bugünkü qalığa vurulur.
                Hər rəqəm <b>İş kağızları</b> Excel-ində ədəd-ədəd izlənir (tarixi keçid → risk faizi → cari portfel → nəticə).</div>
        </div>

        <div class="metod-qayda">
            <div class="metod-t"><i class="bi bi-bank"></i> AMB Metodoloji Rəhbərliyi — bu ehtiyatı hansı qaydaya əsasən yığmışıq</div>
            <div class="metod-qayda-src">Mənbə: <b>Azərbaycan Respublikası Mərkəzi Bankının İdarə Heyəti</b>, "23" dekabr 2025-ci il tarixli qərar, <b>Protokol № 45/2</b> — "Aktivlərin təsnifləşdirilməsi və ehtiyatların yaradılmasında MHBS 9-un tətbiqi üzrə Metodoloji Rəhbərlik".
                <a asp-action="AmbQaydaSened" class="metod-yukle metod-yukle--inline" target="_blank"><i class="bi bi-file-earmark-word"></i> Rəsmi sənədi yüklə (.docx)</a>
            </div>
            <ul class="metod-qayda-l">
                <li><b>Mərhələləmə (gecikmə günü):</b> Mərhələ 2 = 31–90 gün (<i>«Mərhələ 2 üzrə meyarlar»</i> cədvəli, sıra 12) · Mərhələ 3 = 90+ gün, defolt (<i>«Mərhələ 3 üzrə meyarlar»</i> cədvəli, sıra 13). ✅ bizdə eyni.</li>
                <li><b>Metod:</b> <i>«cPD hesablanması üçün... Markov zənciri... miqrasiya matrisləri»</i> (Ehtiyatlanma bölməsi) — bizim roll-rate/keçid matrisi modeli məhz buna istinad edir. ✅</li>
                <li><b>Mərhələ 1 & 2 ECL:</b> <i>«ECL = Σ PD × LGD × EAD × DF ≈ PD × LGD × EAD»</i> (kollektiv əsasda). Bizdə: tarixi keçid faizi + minimum floor (sadələşdirmə).</li>
                <li><b>Mərhələ 3 ECL:</b> <i>«ECL = EAD<sub>fact</sub> × LGD<sub>ID</sub>»</i> — defolt baş verib, PD=100%. LGD: <i>«LGL = 1 − Total recovery%»</i> → <b>1 − bərpa</b>.</li>
                <li><b>EAD:</b> <i>«ehtiyatın hesablanması tarixinə kredit tələbinin balans dəyəri — əsas və gecikdirilmiş borc, hesablanmış faizlər, cərimələr»</i>.</li>
                <li><b>Bərpa / LGD təminat cədvəli</b> (<i>«LGD = 1 − (təminatın məbləği × əmsal)/EAD»</i>): girovdan geri alına bilən pay —</li>
            </ul>
            <table class="metod-tbl metod-tbl--mb">
                <thead><tr><th>Təminat növü</th><th>Tanınma (haircut)</th><th>Tam təminatlıdırsa LGD</th></tr></thead>
                <tbody>
                    <tr class="@(Model.Metod=="MB"?"metod-hl":"")"><td>Yaşayış/kommersiya daşınmaz əmlak — <b>Bakı</b> (mənzil)</td><td>50%</td><td><b>50%</b></td></tr>
                    <tr><td>Daşınmaz əmlak — Bakıdan kənar</td><td>70%</td><td>70%</td></tr>
                    <tr><td>Nəqliyyat / avadanlıq / mal</td><td>90%</td><td>90%</td></tr>
                    <tr><td>Yüksək likvidli qiymətli kağızlar</td><td>10%</td><td>10%</td></tr>
                    <tr><td>Nağd təminat</td><td>0%</td><td>0%</td></tr>
                </tbody>
            </table>
            <p class="metod-note"><i class="bi bi-check2-circle"></i> Bizim empirik bərpamız (mənzil <b>@((Model.Q2*100).ToString("0.0"))%</b> ≈ MB Bakı daşınmaz əmlakı <b>50%</b>) requlyator cədvəlinə yaxındır — model tarixi real geri ödənişdən (<i>«defoltda qalan məbləğ üzrə geri ödənişlərin olması»</i>) hesablanır.</p>
            @if (Model.Metod == "MB")
            {
                <div class="metod-qayda-aktiv metod-qayda-aktiv--mb"><i class="bi bi-check-circle-fill"></i> Bu hesabat <b>AMB Metodoloji Rəhbərliyinə uyğun</b> (Mərhələ 3: EAD × (1 − bərpa)) hesablanmışdır.</div>
            }
            else
            {
                <div class="metod-qayda-aktiv metod-qayda-aktiv--ex"><i class="bi bi-exclamation-circle-fill"></i> Bu hesabat hazırda <b>Excel (təsdiqlənmiş) modeli</b> ilə hesablanır. AMB tam uyğunluğu üçün Parametrlər səhifəsində metodu <b>"AMB"</b> seçin.</div>
            }
        </div>

        <div class="metod-f"><i class="bi bi-book"></i> Əsas: IFRS 9 bənd <b>5.5.17</b> (gələcəyə yönümlü proqnoz), <b>B5.5.54</b> (sıfır risk yoxdur), <b>B5.5.55</b> (təminatın/girovun rolu) · AMB Rəhbərliyi 23.12.2025 № 45/2.</div>
    </div>

    @if (!Model.Ugurlu)
    {
        <div class="mh-alert"><i class="bi bi-x-octagon"></i> Yüklənmədi: @Model.Xeta</div>
    }
    else
    {
        <div class="mh-kpis">
            <div class="mh-kpi mh-kpi--p">
                <div class="mh-kpi-ic"><i class="bi bi-cash-stack"></i></div>
                <div class="mh-kpi-v">@Fmt(Model.UmumiPortfel) <span>₼</span></div>
                <div class="mh-kpi-l">Kredit portfeli (EAD) · @Model.Say açıq kredit</div>
            </div>
            <div class="mh-kpi mh-kpi--r">
                <div class="mh-kpi-ic"><i class="bi bi-shield-exclamation"></i></div>
                <div class="mh-kpi-v">@Fmt2(Model.UmumiEcl) <span>₼</span></div>
                <div class="mh-kpi-l">IFRS 9 ehtiyat (ECL) · @Fmt2(Model.EclFaiz)%</div>
            </div>
            <div class="mh-kpi mh-kpi--g">
                <div class="mh-kpi-ic"><i class="bi bi-bank"></i></div>
                <div class="mh-kpi-v">@Fmt2(Model.BankEhtiyat) <span>₼</span></div>
                <div class="mh-kpi-l">FINA / prudensial ehtiyat (müqayisə)</div>
            </div>
        </div>

        @if (Model.Metod == "MB")
        {
            <div class="if-ref if-ref--mb">
                <i class="bi bi-bank"></i>
                <div><b>AMB Metodoloji Rəhbərliyinə uyğun hesablanıb</b> — Azərbaycan Respublikası Mərkəzi Bankı, 23.12.2025, Protokol № 45/2.
                Mərhələ 3 (problemli): <b>ECL = EAD × LGD, LGD = 1 − bərpa</b> (defolt olub, PD=100%). Detallı istinadlar üçün <b>Metodologiya</b> düyməsinə bax.</div>
            </div>
        }
        else
        {
            <div class="if-ref if-ref--ex">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <div><b>Excel (təsdiqlənmiş) modeli</b> ilə hesablanıb. AMB Metodoloji Rəhbərliyinə (23.12.2025 № 45/2) tam uyğunluq üçün
                <b>Parametrlər → Hesablama metodu → AMB</b> seçin. Fərqi görmək üçün iki metodu eyni tarixdə müqayisə edin.</div>
            </div>
        }

        <div class="if-card">
            <div class="if-card-h"><i class="bi bi-layers"></i> Stage üzrə bölgü</div>
            <table class="if-tbl">
                <thead>
                    <tr>
                        <th>Stage</th><th class="r">Say</th><th class="r">Portfel (EAD)</th>
                        <th class="r">Risk %</th><th class="r">IFRS 9 ehtiyat (ECL)</th><th class="r">FINA ehtiyat</th><th>Pay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Stagelar)
                    {
                        <tr>
                            <td><span class="if-dot" style="background:@s.Reng"></span> <b>@s.Stage</b></td>
                            <td class="r">@s.Say</td>
                            <td class="r">@Fmt2(s.Ead)</td>
                            <td class="r">@Fmt2(s.RiskFaiz)%</td>
                            <td class="r"><b>@Fmt2(s.Ecl)</b></td>
                            <td class="r if-muted">@Fmt2(s.BankEhtiyat)</td>
                            <td>
                                <div class="if-bar"><span style="width:@Bw(s.Pay)%;background:@s.Reng"></span></div>
                                <em>@Fmt2(s.Pay)%</em>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>CƏMİ</td>
                        <td class="r">@Model.Say</td>
                        <td class="r">@Fmt2(Model.UmumiPortfel)</td>
                        <td class="r">@Fmt2(Model.EclFaiz)%</td>
                        <td class="r"><b>@Fmt2(Model.UmumiEcl)</b></td>
                        <td class="r if-muted">@Fmt2(Model.BankEhtiyat)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="if-card">
            <div class="if-card-h"><i class="bi bi-diagram-3"></i> Sahə üzrə ECL (ən böyük 15)</div>
            <table class="if-tbl">
                <thead>
                    <tr>
                        <th>Kod</th><th>Sahə</th><th class="r">Say</th><th class="r">EAD</th>
                        <th class="r">Orta risk</th>
                        <th class="r st1">St.1 risk</th><th class="r st2">St.2 risk</th><th class="r st3">St.3 risk</th>
                        <th class="r">ECL</th><th class="r">Pay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Saheler.Take(15))
                    {
                        <tr>
                            <td class="if-muted">@s.Kod</td>
                            <td>@s.Ad</td>
                            <td class="r">@s.Say</td>
                            <td class="r">@Fmt2(s.Ead)</td>
                            <td class="r"><b>@Fmt2(s.RiskFaiz)%</b></td>
                            <td class="r st1">@StR(s.Risk1)</td>
                            <td class="r st2">@StR(s.Risk2)</td>
                            <td class="r st3">@StR(s.Risk3)</td>
                            <td class="r"><b>@Fmt2(s.Ecl)</b></td>
                            <td class="r">@Fmt2(s.Pay)%</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="if-tbl-qeyd"><i class="bi bi-info-circle"></i> <b>Orta risk</b> = ECL ÷ EAD (bütün mərhələlər birlikdə, çəkili). <b>St.1/2/3</b> = həmin mərhələdəki kreditlərə tətbiq olunan risk %-i. <b>—</b> = o mərhələdə kredit yoxdur. Bunlar ayrıdır — bir yerdə ortalama alınmır.</div>
        </div>

        <div class="if-note">
            <i class="bi bi-info-circle"></i>
            <div>
                <b>Metodologiya:</b> roll-rate stage-keçid modeli (son 5 il tarixi keçid → sahə üzrə risk faizi).
                Staging gecikmə günündən: 0–30 = Stage 1, 31–90 = Stage 2, 90+ = Stage 3.
                EAD = əsas borc + vaxtı keçmiş əsas borc (summa + summa_19), AZN-ə çevrilmiş.
                Floor: mənzil 0.1% · Stage 1 1% · Stage 2 2%. FINA ehtiyatı prudensial (procstavrez) — müqayisə üçün.
            </div>
        </div>
    }
</div>

<style>
    .mh-hero--if { background: linear-gradient(120deg, #7c2d12, #b91c1c); box-shadow: 0 12px 30px rgba(185,28,28,.28); }
    .mh-kpis { grid-template-columns: repeat(3, 1fr); }
    @@media (max-width: 900px) { .mh-kpis { grid-template-columns: 1fr; } }
    .if-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; box-shadow: 0 4px 14px rgba(2,6,23,.05); margin-top: 16px; overflow: hidden; }
    .if-card-h { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; padding: 13px 18px; border-bottom: 1px solid #eef2f7; color: #1e293b; }
    .if-tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .if-tbl th { text-align: left; padding: 9px 14px; background: #f8fafc; color: #64748b; font-size: 11.5px; text-transform: uppercase; letter-spacing: .3px; }
    .if-tbl th.r, .if-tbl td.r { text-align: right; }
    .if-tbl td { padding: 10px 14px; border-top: 1px solid #eef2f7; }
    .if-tbl tfoot td { border-top: 2px solid #e2e8f0; font-weight: 700; background: #f8fafc; }
    .if-muted { color: #94a3b8; }
    .if-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; vertical-align: middle; margin-right: 4px; }
    .if-bar { display: inline-block; width: 90px; height: 7px; border-radius: 5px; background: #eef2f7; overflow: hidden; vertical-align: middle; margin-right: 6px; }
    .if-bar span { display: block; height: 100%; border-radius: 5px; }
    .if-tbl em { font-style: normal; font-size: 12px; color: #64748b; }
    .if-tbl th.st1, .if-tbl td.st1 { background: rgba(16,185,129,.06); }
    .if-tbl th.st2, .if-tbl td.st2 { background: rgba(245,158,11,.07); }
    .if-tbl th.st3, .if-tbl td.st3 { background: rgba(239,68,68,.06); }
    .if-tbl-qeyd { padding: 10px 16px; font-size: 11.5px; color: #64748b; border-top: 1px solid #eef2f7; background: #f8fafc; line-height: 1.5; }
    .if-tbl-qeyd i { color: #0ea5e9; }
    .if-ref { display: flex; gap: 11px; margin-top: 14px; padding: 12px 16px; border-radius: 12px; font-size: 12.5px; line-height: 1.55; }
    .if-ref i { font-size: 18px; margin-top: 1px; flex: none; }
    .if-ref--mb { background: #eef2ff; border: 1px solid #c7d2fe; color: #3730a3; }
    .if-ref--mb i { color: #4338ca; }
    .if-ref--ex { background: #fffbeb; border: 1px solid #fde68a; color: #854d0e; }
    .if-ref--ex i { color: #d97706; }
    .if-note { display: flex; gap: 10px; margin-top: 16px; padding: 13px 16px; background: #f8fafc; border: 1px solid #e6ebf2; border-radius: 12px; font-size: 12.5px; color: #64748b; line-height: 1.55; }
    .if-note i { color: #b91c1c; font-size: 16px; margin-top: 1px; }
    .metod-panel { display: none; margin-top: 14px; background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; box-shadow: 0 4px 14px rgba(2,6,23,.05); overflow: hidden; }
    .metod-panel.acik { display: block; }
    .metod-h { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; padding: 13px 18px; border-bottom: 1px solid #eef2f7; background: #fef2f2; color: #b91c1c; }
    .metod-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; padding: 16px 18px; }
    .metod-b { font-size: 12.5px; color: #475569; line-height: 1.55; }
    .metod-t { font-weight: 700; color: #1e293b; margin-bottom: 3px; font-size: 13px; }
    .metod-b code { background: #f1f5f9; padding: 1px 5px; border-radius: 4px; font-size: 11.5px; color: #b91c1c; }
    .metod-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 20px; vertical-align: middle; white-space: nowrap; }
    .metod-badge--on { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .metod-badge--off { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .metod-f { padding: 11px 18px; border-top: 1px solid #eef2f7; background: #f8fafc; font-size: 12px; color: #64748b; display: flex; align-items: center; gap: 7px; }
    .metod-f i { color: #b91c1c; }
    .metod-intro { margin: 16px 18px 4px; padding: 13px 16px; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 10px; font-size: 13px; color: #7c2d12; line-height: 1.6; }
    .metod-n { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; border-radius: 50%; background: #b91c1c; color: #fff; font-size: 11px; font-weight: 700; margin-right: 6px; }
    .metod-menzil, .metod-numune { margin: 6px 18px; padding: 14px 16px; border: 1px solid #e6ebf2; border-radius: 12px; background: #f8fafc; }
    .metod-menzil p, .metod-numune p { font-size: 12.5px; color: #475569; line-height: 1.55; margin: 6px 0; }
    .metod-tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; margin: 8px 0; }
    .metod-tbl th { text-align: left; padding: 7px 10px; background: #eef2f7; color: #475569; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; }
    .metod-tbl td { padding: 8px 10px; border-top: 1px solid #eef2f7; color: #334155; vertical-align: top; }
    .metod-tbl .metod-hl { background: #ecfdf5; }
    .metod-tbl .metod-hl td { border-top: 1px solid #a7f3d0; }
    .metod-note { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 9px 12px; font-size: 12px; color: #713f12; }
    .metod-note i { color: #d97706; }
    .metod-numune-g { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin: 8px 0; }
    .metod-numune-g > div { background: #fff; border: 1px solid #e6ebf2; border-radius: 9px; padding: 10px 12px; font-size: 12.5px; color: #334155; line-height: 1.5; }
    .metod-audit { display: flex; gap: 10px; margin: 6px 18px 14px; padding: 13px 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; font-size: 12.5px; color: #1e3a8a; line-height: 1.6; }
    .metod-audit i { color: #2563eb; font-size: 17px; margin-top: 1px; }
    /* Metod bar (aktiv metod göstəricisi) */
    .metod-metodbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 12px 18px 0; padding: 9px 14px; background: #f8fafc; border: 1px solid #e6ebf2; border-radius: 10px; font-size: 12.5px; flex-wrap: wrap; }
    .metod-bar-l { color: #64748b; font-weight: 600; margin-right: 4px; }
    .metod-bar-d { color: #94a3b8; margin-left: 6px; }
    .metod-yukle { display: inline-flex; align-items: center; gap: 5px; background: #4338ca; color: #fff; border-radius: 8px; padding: 5px 12px; font-size: 12px; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .metod-yukle:hover { background: #3730a3; color: #fff; }
    .metod-yukle--inline { margin-top: 7px; padding: 4px 10px; font-size: 11.5px; }
    .metod-mb-badge { display: inline-flex; align-items: center; gap: 5px; background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; border-radius: 20px; padding: 3px 11px; font-weight: 700; font-size: 12px; }
    .metod-ex-badge { display: inline-flex; align-items: center; gap: 5px; background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; border-radius: 20px; padding: 3px 11px; font-weight: 700; font-size: 12px; }
    .metod-b--wide { grid-column: 1 / -1; background: #fbfcfe; border: 1px dashed #d7dee8; border-radius: 10px; padding: 12px 14px; }
    .metod-formula { font-family: ui-monospace, "Cascadia Code", Consolas, monospace; font-size: 13px; background: #0f172a; color: #e2e8f0; border-radius: 8px; padding: 9px 13px; margin: 6px 0 9px; display: inline-block; }
    .metod-formula--mb { background: #312e81; }
    .metod-formula sub { font-size: 9px; }
    /* AMB qayda bloku */
    .metod-qayda { margin: 6px 18px 14px; padding: 15px 17px; border: 1.5px solid #c7d2fe; border-radius: 12px; background: #f5f7ff; }
    .metod-qayda .metod-t { color: #3730a3; }
    .metod-qayda-src { font-size: 12px; color: #475569; line-height: 1.55; margin: 6px 0 10px; padding-bottom: 9px; border-bottom: 1px solid #e0e7ff; }
    .metod-qayda-l { margin: 0 0 8px; padding-left: 18px; font-size: 12.5px; color: #334155; line-height: 1.7; }
    .metod-qayda-l li { margin-bottom: 3px; }
    .metod-tbl--mb th { background: #e0e7ff; color: #3730a3; }
    .metod-tbl--mb .metod-hl { background: #eef2ff; }
    .metod-tbl--mb .metod-hl td { border-top: 1px solid #c7d2fe; }
    .metod-qayda-aktiv { margin-top: 10px; padding: 10px 13px; border-radius: 9px; font-size: 12.5px; font-weight: 600; display: flex; align-items: center; gap: 8px; line-height: 1.5; }
    .metod-qayda-aktiv--mb { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .metod-qayda-aktiv--mb i { color: #059669; }
    .metod-qayda-aktiv--ex { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .metod-qayda-aktiv--ex i { color: #d97706; }
    /* Çap (print) — yalnız metodologiya paneli */
    @@media print {
        body * { visibility: hidden !important; }
        #metodPanel, #metodPanel * { visibility: visible !important; }
        #metodPanel { position: absolute; left: 0; top: 0; width: 100%; margin: 0; border: none; box-shadow: none; display: block !important; }
        .metod-formula { background: #fff !important; color: #0f172a !important; border: 1px solid #0f172a; }
        .metod-grid { grid-template-columns: 1fr 1fr; }
    }
</style>
