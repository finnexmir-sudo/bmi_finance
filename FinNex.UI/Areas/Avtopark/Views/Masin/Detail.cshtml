@model MasinDto
@{
    ViewData["Title"] = $"Maşın — {Model.DovletNomresi}";
    var muddetler = ViewBag.Muddetler as IList<MasinMuddetDto> ?? new List<MasinMuddetDto>();
    var aktivMuddetler = muddetler.Where(x => x.Aktivdir).ToList();
    var tarixce = muddetler.Where(x => !x.Aktivdir).OrderByDescending(x => x.SonTarix).ToList();

    var statusNisan = Model.Status == MasinStatus.Aktiv ? "fn-badge--approved"
                    : Model.Status == MasinStatus.Temirde ? "fn-badge--wait" : "fn-badge--done";

    string VeziyyetNisan(MasinMuddetDto d) =>
        d.Kecib ? "fn-badge--rejected" : d.Yaxinlasir ? "fn-badge--wait" : "fn-badge--approved";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.TamAd</div>
            <div class="fn-page-sub">
                <span class="fn-badge @statusNisan">@Model.StatusMetni</span>
                @if (Model.IndiColdedir)
                {
                    <span class="fn-badge fn-badge--review">
                        <i class="bi bi-box-arrow-right"></i> @Model.IndiKimde
                    </span>
                }
            </div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-controller="Muddet" asp-action="Create" asp-route-masinId="@Model.Id"
               class="fn-btn fn-btn--outline">
                <i class="bi bi-plus-lg"></i> Müddət əlavə et
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="fn-btn fn-btn--primary">Redaktə</a>
            <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
        </div>
    </div>

    <div class="av-split">

        <div class="fn-card">
            <div class="av-col-head"><i class="bi bi-card-text"></i> Kart</div>
            <dl class="av-dl">
                <dt>Dövlət nömrəsi</dt><dd><span class="av-plate">@Model.DovletNomresi</span></dd>
                <dt>Marka / model</dt><dd>@($"{Model.Marka} {Model.Model}".Trim())</dd>
                <dt>Buraxılış ili</dt><dd>@(Model.BuraxilisIli?.ToString() ?? "—")</dd>
                <dt>Rəng</dt><dd>@(Model.Reng ?? "—")</dd>
                <dt>Növü</dt><dd>@(Model.Novu ?? "—")</dd>
                <dt>Ban / şassi</dt><dd>@(Model.Ban ?? "—")</dd>
                <dt>VIN</dt><dd>@(Model.Vin ?? "—")</dd>
                <dt>Departament</dt><dd>@(Model.DepartamentAdi ?? "Ümumi istifadə")</dd>
                <dt>Təhkim sürücü</dt><dd>@(Model.TehkimSurucuAdi ?? "—")</dd>
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Qeyd))
            {
                <div class="av-extra av-sub">@Model.Qeyd</div>
            }
        </div>

        <div>
            <div class="fn-card">
                <div class="av-col-head"><i class="bi bi-calendar-check"></i> Cari müddətlər</div>

                @if (!aktivMuddetler.Any())
                {
                    <div class="av-sub" style="text-align:center;padding:20px 0">
                        Müddət qeydi yoxdur — sığorta və texniki baxış izlənmir.
                    </div>
                }
                else
                {
                    <div class="av-twrap">
                        <table class="av-table">
                            <thead>
                                <tr><th>Növ</th><th>Son tarix</th><th>Vəziyyət</th><th>Məbləğ</th><th>Sənəd</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var d in aktivMuddetler)
                            {
                                <tr>
                                    <td>@d.NovAdi</td>
                                    <td class="av-mono av-nowrap">@d.SonTarix.ToString("dd.MM.yyyy")</td>
                                    <td><span class="fn-badge @VeziyyetNisan(d)">@d.VeziyyetMetni</span></td>
                                    <td class="av-mono av-nowrap">@(d.Mebleg.HasValue ? d.Mebleg.Value.ToString("N2") + " ₼" : "—")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(d.SenedFaylYolu))
                                        {
                                            <a href="/dms/@d.SenedFaylYolu" target="_blank">
                                                <i class="bi bi-paperclip"></i> @d.SenedFaylAdi
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="av-sub">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (tarixce.Any())
            {
                <div class="fn-card" style="margin-top:16px">
                    <div class="av-col-head">
                        <i class="bi bi-clock-history"></i> Tarixçə
                        <span class="av-count">@tarixce.Count</span>
                    </div>
                    <div class="av-twrap">
                        <table class="av-table">
                            <tbody>
                            @foreach (var d in tarixce)
                            {
                                <tr class="av-past">
                                    <td>@d.NovAdi</td>
                                    <td class="av-mono av-nowrap">@d.SonTarix.ToString("dd.MM.yyyy")</td>
                                    <td class="av-mono av-nowrap">@(d.Mebleg.HasValue ? d.Mebleg.Value.ToString("N2") + " ₼" : "")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

    </div>
</div>
