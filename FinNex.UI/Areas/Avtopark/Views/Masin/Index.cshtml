@model IList<MasinDto>
@{
    ViewData["Title"] = "Maşınlar";
    var bugun = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">Maşınlar</h4>
        <div class="text-muted small">Xidməti maşınların kartı, cari vəziyyəti və ən yaxın bitən müddəti.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Muddet" asp-action="Yaxinlasanlar" class="btn btn-outline-warning">
            <i class="bi bi-alarm"></i> Yaxınlaşan müddətlər
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni maşın
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-car-front fs-1 d-block mb-2"></i>
            Hələ maşın əlavə edilməyib.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Maşın</th>
                        <th>Nömrə</th>
                        <th>Departament</th>
                        <th>Sürücü</th>
                        <th>Status</th>
                        <th>Cari vəziyyət</th>
                        <th>Ən yaxın müddət</th>
                        <th class="text-end">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model)
                {
                    var statusRengi = m.Status == MasinStatus.Aktiv ? "success"
                        : m.Status == MasinStatus.Temirde ? "warning" : "secondary";

                    var qalanGun = m.EnYaxinMuddetTarixi.HasValue
                        ? (int?)(m.EnYaxinMuddetTarixi.Value.Date - bugun).Days
                        : null;

                    <tr>
                        <td>
                            <div class="fw-semibold">@($"{m.Marka} {m.Model}".Trim())</div>
                            @if (m.BuraxilisIli.HasValue)
                            {
                                <div class="text-muted small">@m.BuraxilisIli · @m.Reng</div>
                            }
                        </td>
                        <td><span class="badge bg-dark">@m.DovletNomresi</span></td>
                        <td class="small">@(m.DepartamentAdi ?? "—")</td>
                        <td class="small">@(m.TehkimSurucuAdi ?? "—")</td>
                        <td><span class="badge bg-@statusRengi">@m.StatusMetni</span></td>
                        <td class="small">
                            @if (m.IndiColdedir)
                            {
                                <span class="text-primary"><i class="bi bi-box-arrow-right"></i> @m.IndiKimde</span>
                            }
                            else
                            {
                                <span class="text-muted">Yerindədir</span>
                            }
                        </td>
                        <td class="small">
                            @if (qalanGun.HasValue)
                            {
                                var reng = qalanGun < 0 ? "danger" : qalanGun <= 30 ? "warning" : "secondary";
                                <span class="badge bg-@reng">@m.EnYaxinMuddetAdi</span>
                                <div class="text-muted">@m.EnYaxinMuddetTarixi?.ToString("dd.MM.yyyy")</div>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detail" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Kart</a>
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Redaktə</a>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('@m.DovletNomresi silinsin?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
