@model IList<MasinMuracietListDto>
@{
    ViewData["Title"] = "Çöldə olan maşınlar";
    var indi = DateTime.Now;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Çöldə olan maşınlar</div>
            <div class="fn-page-sub">Açarı verilib, hələ qaytarılmayıb.</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <i class="bi bi-check2-all" style="font-size:26px;color:#c3cad8"></i>
            <div class="fn-empty-title">Bütün maşınlar yerindədir</div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="av-twrap">
                <table class="av-table">
                    <thead>
                        <tr>
                            <th>Maşın</th>
                            <th>Kimdədir</th>
                            <th>Çıxış</th>
                            <th>Nə qədərdir</th>
                            <th>Məqsəd</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in Model)
                    {
                        var muddet = m.CixisTarixi.HasValue ? indi - m.CixisTarixi.Value : TimeSpan.Zero;
                        var muddetMetni = m.CixisTarixi.HasValue
                            ? $"{(int)muddet.TotalHours} saat {muddet.Minutes} dəq"
                            : "—";

                        <tr>
                            <td>
                                <div class="av-strong">@m.MasinAdi</div>
                                <div class="av-sub"><span class="av-plate">@m.MasinNomresi</span></div>
                            </td>
                            <td>
                                <div>@m.IsciAdSoyad</div>
                                <div class="av-sub">@m.SobeAdi</div>
                            </td>
                            <td class="av-nowrap av-mono">@m.CixisTarixi?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="av-nowrap av-mono">@muddetMetni</td>
                            <td>@m.Meqsed</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
