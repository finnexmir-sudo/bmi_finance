@model IList<MasinMuddetNovuDto>
@{
    ViewData["Title"] = "Müddət növləri";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müddət növləri</div>
            <div class="fn-page-sub">
                Sığorta, texniki baxış, yağ dəyişmə… Yeni növ üçün kod dəyişikliyi lazım deyil.
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <div class="fn-card">
        <div class="av-col-head"><i class="bi bi-plus-lg"></i> Yeni növ</div>
        <form asp-action="NovYarat" method="post" class="av-filter">
            @Html.AntiForgeryToken()
            <div class="av-filter-field" style="flex:1;min-width:200px">
                <label class="fn-label">Növün adı <span class="fn-required">*</span></label>
                <input name="Ad" class="fn-input" required maxlength="80" />
            </div>
            <div class="av-filter-field">
                <label class="fn-label">Xəbərdarlıq (gün)</label>
                <input name="XeberdarliqGun" type="number" value="30" min="0" max="365"
                       class="fn-input" style="width:120px" />
            </div>
            <div class="av-filter-field">
                <label class="fn-label">Sıra</label>
                <input name="Sira" type="number" value="0" class="fn-input" style="width:80px" />
            </div>
            @* Checkbox-un yanında gizli `false` — işarəsiz hal da AÇIQ göndərilsin
               (CLAUDE.md — göndərilməyən bool səssizcə false sayılır). *@
            <input type="hidden" name="Aktivdir" value="false" />
            <label class="av-check">
                <input type="checkbox" name="Aktivdir" value="true" checked /> Aktivdir
            </label>
            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">Əlavə et</button>
        </form>
    </div>

    <div class="fn-card">
        <div class="av-twrap">
            <table class="av-table">
                <thead>
                    <tr>
                        <th style="width:32%">Ad</th>
                        <th>Xəbərdarlıq (gün)</th>
                        <th>Sıra</th>
                        <th>Aktivdir</th>
                        <th class="av-r"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td colspan="5" style="padding:0">
                            <form asp-action="NovYenile" method="post" class="av-filter" style="padding:10px 14px">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@n.Id" />
                                <div class="av-filter-field" style="flex:1;min-width:180px">
                                    <input name="Ad" value="@n.Ad" class="fn-input" maxlength="80" />
                                </div>
                                <div class="av-filter-field">
                                    <input name="XeberdarliqGun" type="number" value="@n.XeberdarliqGun"
                                           min="0" max="365" class="fn-input" style="width:110px" />
                                </div>
                                <div class="av-filter-field">
                                    <input name="Sira" type="number" value="@n.Sira" class="fn-input" style="width:80px" />
                                </div>
                                <input type="hidden" name="Aktivdir" value="false" />
                                <label class="av-check">
                                    <input type="checkbox" name="Aktivdir" value="true" checked="@n.Aktivdir" /> Aktivdir
                                </label>
                                <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm">Saxla</button>
                            </form>
                            <form asp-action="NovSil" method="post" style="padding:0 14px 10px;text-align:right"
                                  onsubmit="return confirm('@n.Ad silinsin?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="fn-btn fn-btn--danger-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
