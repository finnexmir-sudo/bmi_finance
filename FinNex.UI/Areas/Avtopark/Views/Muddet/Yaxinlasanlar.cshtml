@model IList<MasinMuddetDto>
@{
    ViewData["Title"] = "Yaxınlaşan müddətlər";
    var gun = ViewBag.Gun as int? ?? 30;
    var kecmis = Model.Where(x => x.Kecib).ToList();
    var yaxin = Model.Where(x => !x.Kecib).ToList();
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">Yaxınlaşan müddətlər</h4>
        <div class="text-muted small">Vaxtı keçmişlər də bu siyahıdadır — ən təcili onlardır.</div>
    </div>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2 align-items-center">
            <label class="small text-muted mb-0">Neçə gün irəli:</label>
            <input type="number" name="gun" value="@gun" min="1" max="365"
                   class="form-control form-control-sm" style="width:90px" />
            <button type="submit" class="btn btn-sm btn-primary">Göstər</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">Bütün müddətlər</a>
    </div>
</div>

@if (kecmis.Any())
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-octagon me-2"></i>
        <strong>@kecmis.Count</strong> müddətin vaxtı keçib.
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-check2-all fs-1 d-block mb-2"></i>
            Növbəti @gun gün ərzində bitən müddət yoxdur.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Maşın</th>
                        <th>Növ</th>
                        <th>Son tarix</th>
                        <th>Vəziyyət</th>
                        <th>Xəbərdarlıq</th>
                        <th class="text-end">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in kecmis.Concat(yaxin))
                {
                    <tr class="@(d.Kecib ? "table-danger" : d.Yaxinlasir ? "table-warning" : "")">
                        <td>
                            <div class="fw-semibold">@d.MasinAdi</div>
                            <div class="text-muted small">@d.MasinNomresi</div>
                        </td>
                        <td>@d.NovAdi</td>
                        <td>@d.SonTarix.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge bg-@d.VeziyyetRengi">@d.VeziyyetMetni</span></td>
                        <td class="small">
                            @if (d.XeberdarliqGonderilib)
                            {
                                <span class="text-success"><i class="bi bi-check-lg"></i> göndərilib</span>
                            }
                            else
                            {
                                <span class="text-muted">hələ yox</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Index" asp-route-masinId="@d.MasinId" class="btn btn-sm btn-outline-primary">
                                Uzat
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
