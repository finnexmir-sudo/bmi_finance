@model IList<MasinMuddetDto>
@{
    ViewData["Title"] = "Yaxınlaşan müddətlər";
    var gun = ViewBag.Gun as int? ?? 30;
    var kecmis = Model.Where(x => x.Kecib).ToList();
    var yaxin = Model.Where(x => !x.Kecib).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yaxınlaşan müddətlər</div>
            <div class="fn-page-sub">Vaxtı keçmişlər də bu siyahıdadır — ən təcili onlardır.</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">Bütün müddətlər</a>
    </div>

    <div class="fn-card">
        <form method="get" class="av-filter">
            <div class="av-filter-field">
                <label class="fn-label">Neçə gün irəli</label>
                <input type="number" name="gun" value="@gun" min="1" max="365"
                       class="fn-input" style="width:110px" />
            </div>
            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">
                <i class="bi bi-search"></i> Göstər
            </button>
        </form>
    </div>

    @if (kecmis.Any())
    {
        <div class="av-val-summary">
            <i class="bi bi-exclamation-octagon"></i>
            <strong>@kecmis.Count</strong> müddətin vaxtı keçib.
        </div>
    }

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <i class="bi bi-check2-all" style="font-size:26px;color:#c3cad8"></i>
            <div class="fn-empty-title">Növbəti @gun gün ərzində bitən müddət yoxdur</div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="av-twrap">
                <table class="av-table">
                    <thead>
                        <tr>
                            <th>Maşın</th>
                            <th>Növ</th>
                            <th>Son tarix</th>
                            <th>Vəziyyət</th>
                            <th>Xəbərdarlıq</th>
                            <th class="av-r"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in kecmis.Concat(yaxin))
                    {
                        var setirSinfi = d.Kecib ? "av-danger" : d.Yaxinlasir ? "av-warn" : "";
                        var nisan = d.Kecib ? "fn-badge--rejected"
                                  : d.Yaxinlasir ? "fn-badge--wait" : "fn-badge--approved";

                        <tr class="@setirSinfi">
                            <td>
                                <div class="av-strong">@d.MasinAdi</div>
                                <div class="av-sub"><span class="av-plate">@d.MasinNomresi</span></div>
                            </td>
                            <td>@d.NovAdi</td>
                            <td class="av-mono av-nowrap">@d.SonTarix.ToString("dd.MM.yyyy")</td>
                            <td><span class="fn-badge @nisan">@d.VeziyyetMetni</span></td>
                            <td>
                                @if (d.XeberdarliqGonderilib)
                                {
                                    <span class="av-sub"><i class="bi bi-check-lg"></i> göndərilib</span>
                                }
                                else
                                {
                                    <span class="av-sub">hələ yox</span>
                                }
                            </td>
                            <td class="av-r">
                                <a asp-action="Index" asp-route-masinId="@d.MasinId"
                                   class="fn-btn fn-btn--outline fn-btn--sm">Uzat</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
