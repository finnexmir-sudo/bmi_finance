@model MasinMuddetCreateDto
@{
    ViewData["Title"] = "Müddət qeydinin redaktəsi";
    var basliq = "Müddət qeydinin redaktəsi";
    var action = "Edit";

    var masinlar = ViewBag.Masinlar as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                   ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var novler = ViewBag.Novler as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                 ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var novGun = ViewBag.NovXeberdarliqGun as Dictionary<int, int> ?? new Dictionary<int, int>();
    var movcudFaylAdi = ViewBag.MovcudFaylAdi as string;
    var movcudFaylYolu = ViewBag.MovcudFaylYolu as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@basliq</div>
            <div class="fn-page-sub">İzləmə tarixə görədir — kilometr istifadə olunmur.</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="av-val-summary" role="alert"></div>
    }

    <div class="fn-form-wrap">
        @* enctype MƏCBURİDİR — olmasa fayl serverə ÜMUMİYYƏTLƏ göndərilmir və
           heç bir xəta çıxmır, sənəd sadəcə itir. *@
        <form asp-action="@action" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="fn-card fn-card--form">

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="MasinId" class="fn-label">
                            Maşın <span class="fn-required">*</span>
                        </label>
                        <select asp-for="MasinId" asp-items="masinlar" class="fn-input">
                            <option value="">— seçin —</option>
                        </select>
                        <span asp-validation-for="MasinId" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="NovId" class="fn-label">
                            Növ <span class="fn-required">*</span>
                        </label>
                        <select asp-for="NovId" asp-items="novler" class="fn-input" id="novSelect">
                            <option value="">— seçin —</option>
                        </select>
                        <span asp-validation-for="NovId" class="fn-val-msg"></span>
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="SonTarix" class="fn-label">
                            Son tarix <span class="fn-required">*</span>
                        </label>
                        <input asp-for="SonTarix" type="date" class="fn-input" />
                        <span asp-validation-for="SonTarix" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="XeberdarliqGun" class="fn-label">Neçə gün əvvəl xəbərdarlıq</label>
                        <input asp-for="XeberdarliqGun" type="number" class="fn-input" id="xebGun" />
                        <span asp-validation-for="XeberdarliqGun" class="fn-val-msg"></span>
                    </div>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="Mebleg" class="fn-label">
                            Məbləğ <span class="fn-label-hint">(istəyə bağlı)</span>
                        </label>
                        <input asp-for="Mebleg" type="number" step="0.01" class="fn-input" />
                    </div>
                    <div class="fn-form-group">
                        <label class="fn-label">
                            Sənəd <span class="fn-label-hint">(polis / qəbz)</span>
                        </label>
                        <input type="file" name="sened" class="fn-input"
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
                        @if (!string.IsNullOrWhiteSpace(movcudFaylYolu))
                        {
                            <span class="fn-label-hint">
                                Mövcud: <a href="/dms/@movcudFaylYolu" target="_blank">@movcudFaylAdi</a>
                                — yeni fayl seçməsəniz olduğu kimi qalır.
                            </span>
                        }
                    </div>
                </div>

                <div class="fn-form-group">
                    <label asp-for="Qeyd" class="fn-label">Qeyd</label>
                    <textarea asp-for="Qeyd" class="fn-textarea" rows="2"></textarea>
                </div>

                <div class="fn-info-box">
                    <i class="bi bi-info-circle"></i>
                    <div>
                        Eyni maşın + eyni növ üçün artıq qeyd varsa, köhnəsi avtomatik
                        <strong>tarixçəyə</strong> keçir — silinmir.
                    </div>
                </div>

                <div class="fn-form-actions">
                    <button type="submit" class="fn-btn fn-btn--primary">
                        <i class="bi bi-save"></i> Yadda saxla
                    </button>
                    <a asp-action="Index" class="fn-btn fn-btn--outline">Geri</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Növ seçiləndə xəbərdarlıq günü növün defaultu ilə dolur.
        // Xəritə JSON kimi ötürülür — Razor-dan birbaşa rəqəm interpolasiya
        // etsək az-AZ mədəniyyəti vergül yaza bilər (CLAUDE.md).
        (function () {
            var xerite = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(novGun));
            var sel = document.getElementById('novSelect');
            var gun = document.getElementById('xebGun');
            if (!sel || !gun) return;
            sel.addEventListener('change', function () {
                var v = xerite[this.value];
                if (v !== undefined && v !== null) gun.value = v;
            });
        })();
    </script>
}
