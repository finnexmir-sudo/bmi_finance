@model IList<MasinMuddetDto>
@{
    ViewData["Title"] = "Maşın müddətləri";
    var masinlar = ViewBag.Masinlar as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                   ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var seciliMasin = ViewBag.MasinId as int?;
    var tarixce = ViewBag.Tarixce as bool? ?? false;

    string VeziyyetNisan(MasinMuddetDto d) =>
        d.Kecib ? "fn-badge--rejected" : d.Yaxinlasir ? "fn-badge--wait" : "fn-badge--approved";
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Maşın müddətləri</div>
            <div class="fn-page-sub">
                Sığorta, texniki baxış, yağ dəyişmə — izləmə <strong>tarixə</strong> görədir.
            </div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a asp-action="Yaxinlasanlar" class="fn-btn fn-btn--outline">
                <i class="bi bi-alarm"></i> Yaxınlaşanlar
            </a>
            <a asp-action="Novler" class="fn-btn fn-btn--outline">Növlər</a>
            <a asp-action="Alicilar" class="fn-btn fn-btn--outline">
                <i class="bi bi-bell"></i> Xəbərdarlıq alıcıları
            </a>
            <a asp-action="Create" class="fn-btn fn-btn--primary"><i class="bi bi-plus-lg"></i> Yeni</a>
        </div>
    </div>

    <div class="fn-card">
        <form method="get" class="av-filter">
            <div class="av-filter-field">
                <label class="fn-label">Maşın</label>
                <select name="masinId" class="fn-input">
                    <option value="">— hamısı —</option>
                    @foreach (var m in masinlar)
                    {
                        <option value="@m.Value" selected="@(seciliMasin?.ToString() == m.Value)">@m.Text</option>
                    }
                </select>
            </div>
            <label class="av-check">
                <input type="checkbox" name="tarixce" value="true" checked="@tarixce" />
                Tarixçəni də göstər
            </label>
            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">
                <i class="bi bi-search"></i> Göstər
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <i class="bi bi-calendar-x" style="font-size:26px;color:#c3cad8"></i>
            <div class="fn-empty-title">Müddət qeydi yoxdur</div>
            <div class="fn-empty-sub">Hər maşın üçün sığorta və texniki baxış tarixini yazın.</div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="av-twrap">
                <table class="av-table">
                    <thead>
                        <tr>
                            <th>Maşın</th>
                            <th>Növ</th>
                            <th>Son tarix</th>
                            <th>Vəziyyət</th>
                            <th>Xəbərdarlıq</th>
                            <th>Məbləğ</th>
                            <th>Sənəd</th>
                            <th class="av-r"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in Model)
                    {
                        <tr class="@(d.Aktivdir ? "" : "av-past")">
                            <td>
                                <div>@d.MasinAdi</div>
                                <div class="av-sub"><span class="av-plate">@d.MasinNomresi</span></div>
                            </td>
                            <td>@d.NovAdi</td>
                            <td class="av-mono av-nowrap">@d.SonTarix.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (d.Aktivdir)
                                {
                                    <span class="fn-badge @VeziyyetNisan(d)">@d.VeziyyetMetni</span>
                                }
                                else
                                {
                                    <span class="fn-badge fn-badge--done">tarixçə</span>
                                }
                            </td>
                            <td class="av-nowrap">@d.XeberdarliqGun gün əvvəl</td>
                            <td class="av-mono av-nowrap">@(d.Mebleg.HasValue ? d.Mebleg.Value.ToString("N2") + " ₼" : "—")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(d.SenedFaylYolu))
                                {
                                    <a href="/dms/@d.SenedFaylYolu" target="_blank">
                                        <i class="bi bi-paperclip"></i> @d.SenedFaylAdi
                                    </a>
                                }
                                else
                                {
                                    <span class="av-sub">—</span>
                                }
                            </td>
                            <td class="av-r">
                                <div class="av-actions">
                                    @if (d.Aktivdir)
                                    {
                                        <button type="button" class="fn-btn fn-btn--outline fn-btn--sm"
                                                data-bs-toggle="collapse" data-bs-target="#uzat-@d.Id">Uzat</button>
                                        <a asp-action="Edit" asp-route-id="@d.Id" class="fn-btn fn-btn--outline fn-btn--sm">Redaktə</a>
                                    }
                                    <form asp-action="Delete" method="post"
                                          onsubmit="return confirm('Qeyd silinsin?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="fn-btn fn-btn--danger-sm">Sil</button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        @if (d.Aktivdir)
                        {
                            <tr class="collapse" id="uzat-@d.Id">
                                <td colspan="8" style="background:#fbfcff">
                                    <form asp-action="Uzat" method="post" class="av-filter">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <div class="av-filter-field">
                                            <label class="fn-label">Yeni son tarix</label>
                                            <input type="date" name="yeniSonTarix" class="fn-input"
                                                   value="@d.SonTarix.AddYears(1).ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div class="av-filter-field">
                                            <label class="fn-label">Məbləğ</label>
                                            <input type="number" step="0.01" name="mebleg" class="fn-input" />
                                        </div>
                                        <div class="av-filter-field" style="flex:1;min-width:200px">
                                            <label class="fn-label">Qeyd</label>
                                            <input type="text" name="qeyd" class="fn-input" />
                                        </div>
                                        <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">Uzat</button>
                                        <div style="flex-basis:100%" class="av-sub">
                                            Köhnə qeyd silinmir — tarixçəyə keçir və yeni sətir yaranır.
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
