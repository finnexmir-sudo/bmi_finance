@model IList<AvtoparkAliciDto>
@{
    ViewData["Title"] = "Xəbərdarlıq alıcıları";
    var isciler = ViewBag.Isciler as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                  ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var aktivSayi = Model.Count(x => x.Aktivdir);
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müddət xəbərdarlığı — alıcılar</div>
            <div class="fn-page-sub">
                Sığorta, texniki baxış və yağ dəyişmə xəbərdarlığı yalnız bu işçilərə gedir.
            </div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @if (aktivSayi == 0)
    {
        <div class="fn-info-box">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                <strong>Siyahı boşdur — xəbərdarlıq HEÇ KİMƏ getmir.</strong>
                Sistem rola görə avtomatik alıcı seçmir: gizli alıcı «kim xəbər aldı?»
                sualını cavabsız qoyardı. Ən azı bir işçi əlavə edin.
            </div>
        </div>
    }
    else
    {
        <div class="fn-info-box" style="background:#edf8f4;border-color:#a8ddc7;color:#1a7a50">
            <i class="bi bi-bell"></i>
            <div>
                Xəbərdarlıq <strong>@aktivSayi</strong> işçiyə göndərilir.
                Hər müddət üçün bir dəfə; vaxtı keçmişlərdə həftədə bir təkrarlanır.
            </div>
        </div>
    }

    <div class="fn-card">
        <form asp-action="AliciElaveEt" method="post" class="av-filter">
            @Html.AntiForgeryToken()
            <div class="av-filter-field" style="flex:1;max-width:360px">
                <label class="fn-label">İşçi</label>
                <select name="isciId" class="fn-input" required>
                    <option value="">— seçin —</option>
                    @foreach (var i in isciler)
                    {
                        <option value="@i.Value">@i.Text</option>
                    }
                </select>
            </div>
            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm">
                <i class="bi bi-plus-lg"></i> Əlavə et
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <i class="bi bi-bell-slash" style="font-size:26px;color:#c3cad8"></i>
            <div class="fn-empty-title">Alıcı əlavə edilməyib</div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="av-twrap">
                <table class="av-table">
                    <thead>
                        <tr>
                            <th>İşçi</th>
                            <th>Şöbə</th>
                            <th>Vəziyyət</th>
                            <th class="av-r"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model)
                    {
                        <tr class="@(a.Aktivdir ? "" : "av-past")">
                            <td class="av-strong">@a.IsciAdSoyad</td>
                            <td>@(a.SobeAdi ?? "—")</td>
                            <td>
                                @if (a.Aktivdir)
                                {
                                    <span class="fn-badge fn-badge--approved">Aktiv</span>
                                }
                                else
                                {
                                    <span class="fn-badge fn-badge--done">Deaktiv</span>
                                }
                            </td>
                            <td class="av-r">
                                <div class="av-actions">
                                    <form asp-action="AliciAktivlik" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <input type="hidden" name="aktivdir" value="@((!a.Aktivdir).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm">
                                            @(a.Aktivdir ? "Deaktiv et" : "Aktivləşdir")
                                        </button>
                                    </form>
                                    <form asp-action="AliciSil" method="post"
                                          onsubmit="return confirm('@a.IsciAdSoyad siyahıdan çıxarılsın?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="fn-btn fn-btn--danger-sm">Çıxar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
