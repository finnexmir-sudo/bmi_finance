@model IList<MasinMuracietListDto>
@{
    ViewData["Title"] = "Maşın müraciətlərim";

    // Addım şərtləri MARKUP İÇİNDƏ qurulmur — hazır dəyişənə yazılır
    // (CLAUDE.md — Razor qaydası + «Rol Prioriteti»).
    var acig = Model.Count(x => x.Status == MasinMuracietStatus.Cixib);
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-1">Maşın müraciətlərim</h4>
        <div class="text-muted small">
            Müraciəti siz yazırsınız, rəhbər təsdiqləyir, açarı kassa verir.
            Açar veriləndə və qaytarılanda sizə bildiriş gəlir.
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Yeni müraciət
    </a>
</div>

@if (acig > 0)
{
    <div class="alert alert-primary">
        <i class="bi bi-car-front me-2"></i>
        Sizdə <strong>@acig</strong> açıq çıxış var — maşın hələ qaytarılmayıb.
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-car-front fs-1 d-block mb-2"></i>
            Hələ maşın müraciətiniz yoxdur.
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Maşın</th>
                        <th>Planlaşdırılan vaxt</th>
                        <th>Məqsəd</th>
                        <th>Status</th>
                        <th>Faktiki</th>
                        <th class="text-end">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@m.MasinAdi</div>
                            <div class="text-muted small">@m.MasinNomresi</div>
                        </td>
                        <td>
                            @m.PlanBaslama.ToString("dd.MM.yyyy HH:mm")<br />
                            <span class="text-muted small">→ @m.PlanBitme.ToString("dd.MM.yyyy HH:mm")</span>
                        </td>
                        <td>
                            @m.Meqsed
                            @if (!string.IsNullOrWhiteSpace(m.Marsrut))
                            {
                                <div class="text-muted small"><i class="bi bi-signpost"></i> @m.Marsrut</div>
                            }
                        </td>
                        <td>
                            <span class="badge bg-@m.StatusRengi">@m.StatusMetni</span>
                            @if (m.Status == MasinMuracietStatus.ImtinaEdildi && !string.IsNullOrWhiteSpace(m.ImtinaSebebi))
                            {
                                <div class="text-danger small mt-1">@m.ImtinaSebebi</div>
                            }
                            @if (!m.RehberAddimiVar && m.Status == MasinMuracietStatus.Tesdiqlenib)
                            {
                                <div class="text-muted small mt-1">Rəhbər addımı atlandı</div>
                            }
                        </td>
                        <td class="small">
                            @if (m.CixisTarixi.HasValue)
                            {
                                <div><i class="bi bi-box-arrow-right text-primary"></i> @m.CixisTarixi.Value.ToString("dd.MM HH:mm")</div>
                            }
                            @if (m.QayidisTarixi.HasValue)
                            {
                                <div><i class="bi bi-box-arrow-in-left text-success"></i> @m.QayidisTarixi.Value.ToString("dd.MM HH:mm")</div>
                            }
                            @if (!m.CixisTarixi.HasValue && !m.QayidisTarixi.HasValue)
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (m.LegvEdileBiler)
                            {
                                <form asp-action="Legv" method="post" class="d-inline"
                                      onsubmit="return confirm('Müraciət ləğv edilsin?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Ləğv et</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
