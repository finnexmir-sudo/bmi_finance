@model IList<MasinMuracietListDto>
@{
    ViewData["Title"] = "Maşın müraciətlərim";

    // Şərtlər MARKUP İÇİNDƏ qurulmur — hazır dəyişənə yazılır
    // (CLAUDE.md — Razor qaydası + «Rol Prioriteti»).
    var acig = Model.Count(x => x.Status == MasinMuracietStatus.Cixib);

    // Status → layihənin nişan sinfi. Bootstrap `bg-*` işlədilmir.
    string Nisan(MasinMuracietStatus s) => s switch
    {
        MasinMuracietStatus.Gozlemede   => "fn-badge--wait",
        MasinMuracietStatus.Tesdiqlenib => "fn-badge--review",
        MasinMuracietStatus.Cixib       => "fn-badge--review",
        MasinMuracietStatus.Qayidib     => "fn-badge--approved",
        MasinMuracietStatus.ImtinaEdildi=> "fn-badge--rejected",
        _                                => "fn-badge--done"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Maşın müraciətlərim</div>
            <div class="fn-page-sub">
                Müraciəti siz yazırsınız, rəhbər təsdiqləyir, açarı kassa verir.
            </div>
        </div>
        <a asp-action="Create" class="fn-btn fn-btn--primary">
            <i class="bi bi-plus-lg"></i> Yeni müraciət
        </a>
    </div>

    @if (acig > 0)
    {
        <div class="fn-info-box">
            <i class="bi bi-car-front"></i>
            <div>Sizdə <strong>@acig</strong> açıq çıxış var — maşın hələ qaytarılmayıb.</div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="fn-empty-state">
            <i class="bi bi-car-front" style="font-size:26px;color:#c3cad8"></i>
            <div class="fn-empty-title">Hələ maşın müraciətiniz yoxdur</div>
            <div class="fn-empty-sub">«Yeni müraciət» düyməsi ilə başlayın.</div>
        </div>
    }
    else
    {
        <div class="fn-card">
            <div class="av-twrap">
                <table class="av-table">
                    <thead>
                        <tr>
                            <th>Maşın</th>
                            <th>Planlaşdırılan vaxt</th>
                            <th>Məqsəd</th>
                            <th>Status</th>
                            <th>Faktiki</th>
                            <th class="av-r"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>
                                <div class="av-strong">@m.MasinAdi</div>
                                <div class="av-sub"><span class="av-plate">@m.MasinNomresi</span></div>
                            </td>
                            <td class="av-nowrap av-mono">
                                @m.PlanBaslama.ToString("dd.MM.yyyy HH:mm")
                                <div class="av-sub">→ @m.PlanBitme.ToString("dd.MM.yyyy HH:mm")</div>
                            </td>
                            <td>
                                @m.Meqsed
                                @if (!string.IsNullOrWhiteSpace(m.Marsrut))
                                {
                                    <div class="av-sub"><i class="bi bi-signpost"></i> @m.Marsrut</div>
                                }
                            </td>
                            <td>
                                <span class="fn-badge @Nisan(m.Status)">@m.StatusMetni</span>
                                @if (m.Status == MasinMuracietStatus.ImtinaEdildi && !string.IsNullOrWhiteSpace(m.ImtinaSebebi))
                                {
                                    <div class="av-sub" style="color:#a32d2d">@m.ImtinaSebebi</div>
                                }
                                @if (!m.RehberAddimiVar && m.Status == MasinMuracietStatus.Tesdiqlenib)
                                {
                                    <div class="av-sub">Rəhbər addımı atlandı</div>
                                }
                            </td>
                            <td class="av-nowrap av-mono">
                                @if (m.CixisTarixi.HasValue)
                                {
                                    <div><i class="bi bi-box-arrow-right"></i> @m.CixisTarixi.Value.ToString("dd.MM HH:mm")</div>
                                }
                                @if (m.QayidisTarixi.HasValue)
                                {
                                    <div class="av-sub"><i class="bi bi-box-arrow-in-left"></i> @m.QayidisTarixi.Value.ToString("dd.MM HH:mm")</div>
                                }
                                @if (!m.CixisTarixi.HasValue && !m.QayidisTarixi.HasValue)
                                {
                                    <span class="av-sub">—</span>
                                }
                            </td>
                            <td class="av-r">
                                @if (m.LegvEdileBiler)
                                {
                                    <form asp-action="Legv" method="post"
                                          onsubmit="return confirm('Müraciət ləğv edilsin?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@m.Id" />
                                        <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm">Ləğv et</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
