@model MasinMuracietCreateDto
@{
    ViewData["Title"] = "Yeni maşın müraciəti";
    var masinlar = ViewBag.Masinlar as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                   ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni maşın müraciəti</div>
            <div class="fn-page-sub">Rəhbər təsdiqindən sonra açarı kassa verir.</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @* Şərtsiz render olunsa, xəta olmayan hallarda BOŞ qırmızı qutu görünərdi —
       layihədə `validation-summary-valid { display:none }` CSS qaydası yoxdur. *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="av-val-summary" role="alert"></div>
    }

    @if (!masinlar.Any())
    {
        <div class="fn-info-box">
            <i class="bi bi-exclamation-triangle"></i>
            <div>Aktiv maşın yoxdur — müraciət yazıla bilməz. Admin ilə əlaqə saxlayın.</div>
        </div>
    }

    <div class="fn-form-wrap">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">

                <div class="fn-form-group">
                    <label asp-for="MasinId" class="fn-label">
                        Maşın <span class="fn-required">*</span>
                    </label>
                    <select asp-for="MasinId" asp-items="masinlar" class="fn-input">
                        <option value="">— seçin —</option>
                    </select>
                    <span asp-validation-for="MasinId" class="fn-val-msg"></span>
                </div>

                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="PlanBaslama" class="fn-label">
                            Başlama <span class="fn-required">*</span>
                        </label>
                        <input asp-for="PlanBaslama" type="datetime-local" class="fn-input" />
                        <span asp-validation-for="PlanBaslama" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="PlanBitme" class="fn-label">
                            Bitmə <span class="fn-required">*</span>
                        </label>
                        <input asp-for="PlanBitme" type="datetime-local" class="fn-input" />
                        <span asp-validation-for="PlanBitme" class="fn-val-msg"></span>
                    </div>
                </div>

                <div class="fn-form-group">
                    <label asp-for="Meqsed" class="fn-label">
                        Məqsəd <span class="fn-required">*</span>
                    </label>
                    <input asp-for="Meqsed" class="fn-input"
                           placeholder="Məs. Mərkəzi Banka sənəd aparılması" />
                    <span asp-validation-for="Meqsed" class="fn-val-msg"></span>
                </div>

                <div class="fn-form-group">
                    <label asp-for="Marsrut" class="fn-label">
                        Marşrut <span class="fn-label-hint">(istəyə bağlı)</span>
                    </label>
                    <input asp-for="Marsrut" class="fn-input" placeholder="Məs. İdarə → MB → İdarə" />
                </div>

                <div class="fn-info-box">
                    <i class="bi bi-info-circle"></i>
                    <div>
                        Maşın həmin vaxt üçün başqasına ayrılıbsa, müraciət qəbul edilmir —
                        ekranda kimin götürdüyü və hansı saatlar olduğu yazılır.
                    </div>
                </div>

                <div class="fn-form-actions">
                    <button type="submit" class="fn-btn fn-btn--primary" @(masinlar.Any() ? "" : "disabled")>
                        <i class="bi bi-send"></i> Göndər
                    </button>
                    <a asp-action="Index" class="fn-btn fn-btn--outline">Geri</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
