@model MasinMuracietCreateDto
@{
    ViewData["Title"] = "Yeni maşın müraciəti";
    var masinlar = ViewBag.Masinlar as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                   ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni maşın müraciəti</div>
            <div class="fn-page-sub">Rəhbər təsdiqindən sonra açarı kassa verir.</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    @* Şərtsiz render olunsa, xəta olmayan hallarda BOŞ qırmızı qutu görünərdi —
       layihədə `validation-summary-valid { display:none }` CSS qaydası yoxdur. *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="av-val-summary" role="alert"></div>
    }

    @if (!masinlar.Any())
    {
        <div class="fn-info-box">
            <i class="bi bi-exclamation-triangle"></i>
            <div>Aktiv maşın yoxdur — müraciət yazıla bilməz. Admin ilə əlaqə saxlayın.</div>
        </div>
    }

    <div class="fn-form-wrap">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="fn-card fn-card--form">

                <div class="fn-form-group">
                    <label asp-for="MasinId" class="fn-label">
                        Maşın <span class="fn-required">*</span>
                    </label>
                    <select asp-for="MasinId" asp-items="masinlar" class="fn-input">
                        <option value="">— seçin —</option>
                    </select>
                    <span asp-validation-for="MasinId" class="fn-val-msg"></span>
                </div>

                @* Tarix + saat AYRI (21.08.2026). Tarix bugünlə hazır gəlir;
                   saat sahəsində istifadəçi yalnız rəqəm yazır, «:» avtomatik
                   qoyulur — İcazə modulundakı «Başlama saatı» ilə eyni davranış.
                   Planlaşdırılan BİTMƏ sahəsi YOXDUR: qayıdışı kassa qeyd edir. *@
                <div class="fn-form-row">
                    <div class="fn-form-group">
                        <label asp-for="Tarix" class="fn-label">
                            Tarix <span class="fn-required">*</span>
                        </label>
                        <input asp-for="Tarix" type="date" class="fn-input" />
                        <span asp-validation-for="Tarix" class="fn-val-msg"></span>
                    </div>
                    <div class="fn-form-group">
                        <label asp-for="Saat" class="fn-label">
                            Saat <span class="fn-required">*</span>
                        </label>
                        <input asp-for="Saat" type="text" id="saat"
                               pattern="^([01]?\d|2[0-3]):[0-5]\d$"
                               placeholder="10:00" maxlength="5"
                               inputmode="numeric" class="fn-input" />
                        <span class="fn-label-hint">Yalnız rəqəm yazın — «:» avtomatik qoyulur.</span>
                        <span asp-validation-for="Saat" class="fn-val-msg"></span>
                    </div>
                </div>

                <div class="fn-form-group">
                    <label asp-for="Meqsed" class="fn-label">
                        Məqsəd <span class="fn-required">*</span>
                    </label>
                    <input asp-for="Meqsed" class="fn-input"
                           placeholder="Məs. Mərkəzi Banka sənəd aparılması" />
                    <span asp-validation-for="Meqsed" class="fn-val-msg"></span>
                </div>

                <div class="fn-form-group">
                    <label asp-for="Marsrut" class="fn-label">
                        Marşrut <span class="fn-label-hint">(istəyə bağlı)</span>
                    </label>
                    <input asp-for="Marsrut" class="fn-input" placeholder="Məs. İdarə → MB → İdarə" />
                </div>

                <div class="fn-info-box">
                    <i class="bi bi-info-circle"></i>
                    <div>
                        Qayıdış vaxtı burada yazılmır — maşın qayıdanda
                        <strong>kassa</strong> «Gəldi» qeyd edir və vaxt avtomatik düşür.
                        Maşın həmin an çöldədirsə kassa ikinci açarı vermir.
                    </div>
                </div>

                <div class="fn-form-actions">
                    <button type="submit" class="fn-btn fn-btn--primary" @(masinlar.Any() ? "" : "disabled")>
                        <i class="bi bi-send"></i> Göndər
                    </button>
                    <a asp-action="Index" class="fn-btn fn-btn--outline">Geri</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Saat maskası — istifadəçi yalnız rəqəm yazır, «:» avtomatik qoyulur.
        // Eyni məntiq `user_create_icaze.js`-dədir; ora İcazə formasının
        // hesablamalarına bağlı olduğu üçün burada təkrarlanır (o faylı bura
        // qoşsaq, olmayan elementlərə görə xəta verərdi).
        (function () {
            var el = document.getElementById('saat');
            if (!el) return;

            el.addEventListener('input', function () {
                var raw = el.value.replace(/[^\d]/g, '');
                if (raw.length > 4) raw = raw.substring(0, 4);
                el.value = raw.length >= 3
                    ? raw.substring(0, 2) + ':' + raw.substring(2)
                    : raw;
            });
        })();
    </script>
}
