@model IList<MasinMuracietListDto>
@{
    ViewData["Title"] = "Açar jurnalı";

    var acar  = Model.Where(x => x.Status == MasinMuracietStatus.Tesdiqlenib).ToList();
    var colde = Model.Where(x => x.Status == MasinMuracietStatus.Cixib).ToList();
    var indi  = DateTime.Now;
}

@section Styles {
    <link rel="stylesheet" href="~/css/User/avtopark.css" asp-append-version="true" />
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Açar jurnalı</div>
            <div class="fn-page-sub">
                Düyməni açar əldən-ələ keçən an basın — vaxt avtomatik yazılır.
            </div>
        </div>
        <a asp-action="Jurnal" class="fn-btn fn-btn--outline">
            <i class="bi bi-journal-text"></i> Tarixçə
        </a>
    </div>

    <div class="av-split">

        <div class="fn-card">
            <div class="av-col-head">
                <i class="bi bi-key"></i> Açar gözləyənlər
                <span class="av-count">@acar.Count</span>
            </div>

            @if (!acar.Any())
            {
                <div class="av-sub" style="text-align:center;padding:24px 0">Açar gözləyən yoxdur.</div>
            }
            else
            {
                @foreach (var m in acar)
                {
                    <div class="av-item">
                        <div>
                            <div class="av-strong">@m.IsciAdSoyad</div>
                            <div>@m.MasinAdi <span class="av-plate">@m.MasinNomresi</span></div>
                            <div class="av-sub">
                                @m.PlanBaslama.ToString("dd.MM HH:mm") · @m.Meqsed
                            </div>
                        </div>
                        <form asp-action="Cixdi" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="fn-btn fn-btn--primary fn-btn--sm av-nowrap">
                                <i class="bi bi-box-arrow-right"></i> Çıxdı
                            </button>
                        </form>
                    </div>
                }
            }
        </div>

        <div class="fn-card">
            <div class="av-col-head">
                <i class="bi bi-car-front"></i> Çöldə olanlar
                <span class="av-count">@colde.Count</span>
            </div>

            @if (!colde.Any())
            {
                <div class="av-sub" style="text-align:center;padding:24px 0">Bütün maşınlar yerindədir.</div>
            }
            else
            {
                @foreach (var m in colde)
                {
                    var muddet = m.CixisTarixi.HasValue ? indi - m.CixisTarixi.Value : TimeSpan.Zero;

                    <div class="av-item">
                        <div>
                            <div class="av-strong">@m.IsciAdSoyad</div>
                            <div>@m.MasinAdi <span class="av-plate">@m.MasinNomresi</span></div>
                            <div class="av-sub">
                                Çıxış: @m.CixisTarixi?.ToString("dd.MM HH:mm")
                                @if (m.CixisTarixi.HasValue)
                                {
                                    <span>· @((int)muddet.TotalHours) saat @muddet.Minutes dəq</span>
                                }
                            </div>
                        </div>
                        <form asp-action="Geldi" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm av-nowrap">
                                <i class="bi bi-box-arrow-in-left"></i> Gəldi
                            </button>
                        </form>
                    </div>
                }
            }
        </div>

    </div>
</div>
