@model IEnumerable<FinNex.Application.DTOs.PR_Odenis_Tapsirigi.Musteri.MusteriDetailDto>

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Müştərilər</div>
            <div class="fn-page-sub">Sistemdə olan bütün müştərilərin siyahısı</div>
        </div>
        <a asp-action="Yarat" class="fn-btn fn-btn--primary">+ Yeni müştəri</a>
    </div>

    <div class="fn-card" style="padding:0;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="background:#f8f9fb;border-bottom:1px solid #e4e8f0;">
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Müştərinin adı</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">VOEN</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var m in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f2f7;">
                            <td style="padding:10px 14px;font-weight:500;color:#1a2332;">@m.Ad</td>
                            <td style="padding:10px 14px;color:#3d4557;">@m.Voen</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" style="padding:40px 14px;text-align:center;color:#8a93a8;font-size:13px;">
                            <i class="bi bi-people" style="font-size:28px;display:block;margin-bottom:6px;color:#dde1ea;"></i>
                            Hələ müştəri əlavə olunmayıb
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
