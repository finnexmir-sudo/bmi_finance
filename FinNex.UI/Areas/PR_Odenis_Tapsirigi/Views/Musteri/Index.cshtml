@model IEnumerable<FinNex.Application.DTOs.PR_Odenis_Tapsirigi.Musteri.MusteriDetailDto>


<div class="musteri-page">

    <!-- HEADER -->
    <div class="musteri-header">
        <div class="musteri-header-content">
            <div class="musteri-header-icon">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <h3>Musteriler</h3>
                <p>Sistemde olan butun musterilerin siyahisi</p>
            </div>
        </div>
    </div>

    <!-- ACTIONS BAR -->
    <div class="musteri-actions-bar">
        <a asp-action="Yarat" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Yeni Musteri
        </a>
        <a asp-controller="OdenisTapsirigi" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Geri
        </a>
    </div>

    <!-- TABLE -->
    <div class="musteri-table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Musterinin Adi</th>
                        <th>VOEN</th>
                        <th>Status</th>
                        <th class="text-center">Emeliyyatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@m.Ad</td>
                                <td>@m.Voen</td>
                                <td><span class="badge bg-success">Aktiv</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary action-btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger action-btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2 opacity-50"></i>
                                Hele musteri elave olunmayib
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/musteri.css" asp-append-version="true" />
}
