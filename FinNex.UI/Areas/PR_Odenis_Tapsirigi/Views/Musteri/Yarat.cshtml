@model FinNex.Application.DTOs.PR_Odenis_Tapsirigi.Musteri.MusteriCreateDto

@{
    var returnUrl = ViewBag.ReturnUrl as string;

    var ad    = Context.Request.Query["ad"].ToString();
    var voen  = Context.Request.Query["voen"].ToString();
    var hesab = Context.Request.Query["hesab"].ToString();

    string legvUrl;
    if (!string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl))
    {
        legvUrl = returnUrl
                + (returnUrl.Contains('?') ? "&" : "?")
                + "ad="    + Uri.EscapeDataString(ad ?? "")
                + "&voen=" + Uri.EscapeDataString(voen ?? "")
                + "&hesab=" + Uri.EscapeDataString(hesab ?? "");
    }
    else
    {
        legvUrl = Url.Action("Index", "Musteri");
    }
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni müştəri əlavə et</div>
            <div class="fn-page-sub">Müştəri məlumatlarını daxil edin</div>
        </div>
        <a href="@legvUrl" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <form asp-action="Yarat" method="post">
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-person-plus me-1"></i> Müştəri məlumatları
            </div>

            <div class="fn-form-group" style="margin-bottom:14px;">
                <label class="fn-label">Müştərinin adı</label>
                <input asp-for="Ad" class="fn-input" placeholder="Məsələn: BMI Sigorta MMC" />
                <span asp-validation-for="Ad" class="text-danger small"></span>
            </div>

            <div class="fn-form-row" style="margin-bottom:14px;">
                <div class="fn-form-group">
                    <label class="fn-label">VÖEN</label>
                    <input asp-for="Voen" class="fn-input" placeholder="Məsələn: 1400012345" />
                    <span asp-validation-for="Voen" class="text-danger small"></span>
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Hesab</label>
                    <input asp-for="Hesab" class="fn-input" placeholder="Məsələn: 4101000025" />
                    <span asp-validation-for="Hesab" class="text-danger small"></span>
                </div>
            </div>

            <div class="fn-form-group">
                <label class="fn-label">Valyuta</label>
                <select asp-for="ValyutaId"
                        asp-items="ViewBag.Valyutalar"
                        class="fn-select">
                    <option value="">Valyuta seçin</option>
                </select>
                <span asp-validation-for="ValyutaId" class="text-danger small"></span>
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:8px;">
            <a href="@legvUrl" class="fn-btn fn-btn--outline">
                <i class="bi bi-x-lg me-1"></i> Ləğv et
            </a>
            <button type="submit" class="fn-btn fn-btn--primary">
                <i class="bi bi-check-lg me-1"></i> Yadda saxla
            </button>
        </div>

    </form>
</div>
