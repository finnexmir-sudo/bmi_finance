@model FinNex.Domain.Entities.PR_Odenis_Tapsirigi.Bank

@{
    var returnUrl = ViewBag.ReturnUrl as string;
    var legvUrl = !string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Bank");
}

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni bank əlavə et</div>
            <div class="fn-page-sub">Bank məlumatlarını daxil edin</div>
        </div>
        <a href="@legvUrl" class="fn-btn fn-btn--outline">← Geri</a>
    </div>

    <form asp-action="Yarat" method="post">
        <input type="hidden" name="returnUrl" value="@returnUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none"></div>

        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-bank2 me-1"></i> Bank məlumatları
            </div>

            <div class="fn-form-group" style="margin-bottom:14px;">
                <label class="fn-label">Bankın adı</label>
                <input asp-for="Ad" class="fn-input" placeholder="Məsələn: Kapital Bank" />
                <span asp-validation-for="Ad" class="text-danger small"></span>
            </div>

            <div class="fn-form-row" style="margin-bottom:14px;">
                <div class="fn-form-group">
                    <label class="fn-label">Bank kodu</label>
                    <input asp-for="Kod" class="fn-input" placeholder="Məsələn: 210005" />
                    <span asp-validation-for="Kod" class="text-danger small"></span>
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">VÖEN</label>
                    <input asp-for="Voen" class="fn-input" placeholder="Məsələn: 1400076681" />
                    <span asp-validation-for="Voen" class="text-danger small"></span>
                </div>
            </div>

            <div class="fn-form-row">
                <div class="fn-form-group">
                    <label class="fn-label">SWIFT / BIC</label>
                    <input asp-for="SwiftBic" class="fn-input" placeholder="Məsələn: AIIBAZ2X" />
                    <span asp-validation-for="SwiftBic" class="text-danger small"></span>
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Müxbir hesab</label>
                    <input asp-for="MuxHesab" class="fn-input" placeholder="Məsələn: AZ00NABZ0000..." />
                    <span asp-validation-for="MuxHesab" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:8px;">
            <a href="@legvUrl" class="fn-btn fn-btn--outline">
                <i class="bi bi-x-lg me-1"></i> Ləğv et
            </a>
            <button type="submit" class="fn-btn fn-btn--primary">
                <i class="bi bi-check-lg me-1"></i> Yadda saxla
            </button>
        </div>

    </form>

</div>
