@model IEnumerable<FinNex.Domain.Entities.PR_Odenis_Tapsirigi.Bank>

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Banklar</div>
            <div class="fn-page-sub">Sistemdə olan bütün bankların siyahısı</div>
        </div>
        <a asp-action="Yarat" class="fn-btn fn-btn--primary">+ Yeni bank</a>
    </div>

    <div class="fn-card" style="padding:0;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="background:#f8f9fb;border-bottom:1px solid #e4e8f0;">
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Bankın adı</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Kod</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">VOEN</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">SWIFT / BIC</th>
                    <th style="padding:10px 14px;text-align:right;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var bank in Model)
                    {
                        <tr style="border-bottom:1px solid #f0f2f7;">
                            <td style="padding:10px 14px;font-weight:500;color:#1a2332;">@bank.Ad</td>
                            <td style="padding:10px 14px;">
                                <span style="padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;background:#f0f2f7;color:#3d4557;">@bank.Kod</span>
                            </td>
                            <td style="padding:10px 14px;color:#3d4557;">@bank.Voen</td>
                            <td style="padding:10px 14px;color:#8a93a8;font-family:monospace;font-size:12px;">@bank.SwiftBic</td>
                            <td style="padding:10px 14px;text-align:right;">
                                <div style="display:flex;gap:4px;justify-content:flex-end;">
                                    <a asp-action="Duzelis" asp-route-id="@bank.Id"
                                       style="padding:4px 8px;border:1px solid #e4e8f0;border-radius:6px;font-size:12px;color:#5a647a;text-decoration:none;">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Sil" asp-route-id="@bank.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('Bu bankı silmək istəyirsiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" style="padding:4px 8px;border:1px solid #f5c0c0;border-radius:6px;font-size:12px;color:#c0392b;background:none;cursor:pointer;">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="padding:40px 14px;text-align:center;color:#8a93a8;font-size:13px;">
                            <i class="bi bi-bank" style="font-size:28px;display:block;margin-bottom:6px;color:#dde1ea;"></i>
                            Hələ bank əlavə olunmayıb
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
