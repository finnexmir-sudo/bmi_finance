@model FinNex.UI.Areas.PR_Odenis_Tapsirigi.ViewModels.OdenisTapsirigiCreateVM


<div class="payment-page">

    <!-- HEADER -->
    <div class="payment-header">
        <div class="payment-title">
            <h2><i class="bi bi-file-earmark-text me-2"></i>"A" Formatli Odenis Tapshirigi Yeni</h2>
            <span>A-format · Daxili bank kocurmesi</span>
        </div>
        <div class="payment-meta">
            <a asp-action="Index" class="meta-chip meta-chip-link">
                <i class="bi bi-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>

    <form method="post" class="payment-form" id="paymentForm">
        @Html.AntiForgeryToken()
        <!-- Hidden ID-lər -->
        <input type="hidden" asp-for="Odenis.OduyenBankId"    id="OduyenBankIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanBankId"      id="AlanBankIdHidden" />
        <input type="hidden" asp-for="Odenis.OduyenMusteriId" id="OduyenMusteriIdHidden" />
        <input type="hidden" asp-for="Odenis.OduyenHesabId"   id="OduyenHesabIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanMusteriId"   id="AlanMusteriIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanHesabId"     id="AlanHesabIdHidden" />

        <!-- ═══ BANKLAR ═══════════════════════════════════════════ -->
        <section class="payment-section">
            <header class="section-header">
                <i class="bi bi-bank2"></i>
                <span>Bank Melumatlari</span>
            </header>
            <div class="section-body two-column">

                <!-- A1 – Ödüyən bank -->
                <div class="form-group-box">
                    <div class="group-label">
                        <span class="group-tag">A1</span>
                        <span class="group-name">Oduyen bank</span>
                    </div>

                    <div class="field-row">
                        <input type="text" class="form-control" id="OduyenBankKodSearch"
                                placeholder="Bank kodunu daxil edin...">
                        <button type="button" class="btn btn-search" id="btnOduyenBankAxtar">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                    </div>
                    <div id="OduyenBankXeta" class="field-error" style="display:none"></div>

                    <input class="form-control" id="OduyenBankAd" value="'Bank Melli Iran' Bakı filialı" placeholder="Bankin adi" readonly>
                    <div class="two-field">
                        <input class="form-control" id="OduyenBankKod" value="509761" placeholder="Kod" readonly>
                        <input class="form-control" id="OduyenBankVoen" value="1300036291" placeholder="VOEN" readonly>
                    </div>
                    <input class="form-control" id="OduyenBankMuxbirHesab" value="AZ74NABZ01350100000000037944" placeholder="Muxbir hesab" readonly>
                    <input class="form-control" id="OduyenBankSwift" value="MELIAZ22" placeholder="SWIFT / BIC" readonly>
                </div>

                <!-- B1 – Alan bank -->
                <div class="form-group-box">
                    <div class="group-label">
                        <span class="group-tag">B1</span>
                        <span class="group-name">Alan bank (Benefisiar)</span>
                    </div>

                    <div class="field-row">
                        <input type="text" class="form-control" id="AlanBankKodSearch"
                               placeholder="Bank kodunu daxil edin...">
                        <button type="button" class="btn btn-search" id="btnAlanBankAxtar">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                        

                    </div>
                    <div id="AlanBankXeta" class="field-error" style="display:none"></div>

                    <input class="form-control" id="AlanBankAd"   asp-for="YenidenYazDto!.AlanBankAd"         placeholder="Bankin adi"   >
                    <div class="two-field">
                        <input class="form-control" id="AlanBankKod" asp-for="YenidenYazDto!.AlanBankKod" placeholder="Kod">
                        <input class="form-control" id="AlanBankVoen" asp-for="YenidenYazDto!.AlanBankVoen" placeholder="VOEN">
                    </div>
                    <!-- Hesab - combo + manual -->
                    <!-- Hesab - autocomplete style -->
                    <div class="hesab-radio-wrapper" id="AlanBankHesabRadioWrapper" style="display:none">
                        <div class="hesab-radio-label">Müxbir hesab seçin</div>
                        <div id="AlanBankHesabRadioList"></div>
                    </div>

                    <!-- Hesab yoxdursa manual input -->
                    <input class="form-control hesab-radio-manual"
                           id="AlanBankMuxbirHesab"
                           asp-for="YenidenYazDto!.AlanHesabIban"
                           placeholder="Hesab (IBAN)"
                           autocomplete="off"
                           style="@(Model.YenidenYazDto != null ? "display:block" : "display:none")">

                    <input type="hidden" id="AlanHesabIdHidden" asp-for="YenidenYazDto!.AlanHesabId" />

                    <input class="form-control" id="AlanBankSwift" asp-for="YenidenYazDto!.AlanBankSwift" placeholder="SWIFT / BIC">
                </div>

            </div>
        </section>

        <!-- ═══ MÜŞTƏRİLƏR ═══════════════════════════════════════ -->
        <section class="payment-section">
            <header class="section-header">
                <i class="bi bi-people-fill"></i>
                <span>Mushteriler</span>
            </header>
            <div class="section-body two-column">

                <!-- A2 – Ödüyən müştəri -->
                <div class="form-group-box">
                    <div class="group-label">
                        <span class="group-tag">A2</span>
                        <span class="group-name">Oduyen musteri</span>
                    </div>

                    <div class="field-row">
                        <input type="text" class="form-control" id="OduyenMusteriVoenSearch"
                               placeholder="VOEN ile axtar...">
                        <button type="button" class="btn btn-search" id="btnOduyenMusteriAxtar">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                       
                    </div>
                    <div id="OduyenMusteriXeta" class="field-error" style="display:none"></div>

                    <input class="form-control" id="OduyenMusteriAd" value="'Bank Melli Iran' Bakı filialı" placeholder="Musterinin adi" readonly>
                    <input class="form-control" id="OduyenMusteriHesab" value="AZ02MELI45019000000000400000" placeholder="Hesab (IBAN)" readonly>
                    <input class="form-control" id="OduyenMusteriVoen" value="1300036291" placeholder="VOEN" readonly>
                </div>

                <!-- B2 – Alan müştəri -->
                <div class="form-group-box">
                    <div class="group-label">
                        <span class="group-tag">B2</span>
                        <span class="group-name">Alan musteri</span>
                    </div>

                    <div class="field-row">
                        <input type="text" class="form-control" id="AlanMusteriVoenSearch" placeholder="VOEN ile axtar...">

                        <button type="button" class="btn btn-search" id="btnAlanMusteriAxtar">
                            <i class="bi bi-search"></i> Axtar
                        </button>

                        <!-- Köhnə (səhv): button ilə asp-controller/asp-action -->
                        <!-- Yeni (düzgün): <a> ilə -->
                        
                    </div>




                    <div id="AlanMusteriXeta" class="field-error" style="display:none"></div>

                    <input class="form-control" id="AlanMusteriAd"
                           asp-for="YenidenYazDto!.AlanMusteriAd"
                           placeholder="Musterinin adi">

                    <!-- Hesab - radio seçim style (C variant) -->
                    <div class="hesab-radio-wrapper" id="AlanMusteriHesabRadioWrapper" style="display:none">
                        <div class="hesab-radio-label">Hesab seçin</div>
                        <div id="AlanMusteriHesabRadioList"></div>
                    </div>

                    <!-- Hesab yoxdursa manual input -->
                    <input class="form-control hesab-radio-manual"
                           id="AlanMusteriHesab"
                           asp-for="YenidenYazDto!.AlanMusteriHesabIban"
                           placeholder="Hesab (IBAN)">

                    <input type="hidden" id="AlanMusteriHesabId">

                    <input class="form-control" id="AlanMusteriVoen"
                           asp-for="YenidenYazDto!.AlanMusteriVoen"
                           placeholder="VOEN">




                </div>

            </div>
        </section>

        <!-- ═══ MƏBLƏĞ ════════════════════════════════════════════ -->
        <section class="payment-section">
            <header class="section-header">
                <i class="bi bi-currency-exchange"></i>
                <span>Mebleg</span>
            </header>
            <div class="section-body amount-row">
                <div>
                    <label class="field-label">C1. Valyuta</label>

                    <select class="form-control" asp-for="Odenis.Valyuta" id="Odenis_Valyuta"
                            onchange="document.getElementById('Odenis_ValyutaId').value = this.selectedIndex + 1">
                        <option>AZN</option>
                        <option>USD</option>
                        <option>EUR</option>
                    </select>
                    <input type="hidden" id="Odenis_ValyutaId" value="1" />
                </div>
                <div>
                    <label class="field-label">C2. Reqemle</label>
                    <input class="form-control" asp-for="Odenis.Mebleg"
                           id="Odenis_Mebleg" placeholder="0.00" step="0.01">
                </div>
                <div>
                    <label class="field-label">C2. Yazi ile (avtomatik)</label>
                    <input class="form-control" asp-for="Odenis.MeblegYazi"
                           id="Odenis_MeblegYazi" placeholder="Avtomatik doldurulacaq..." readonly>
                </div>
            </div>
        </section>

        <!-- ═══ TƏYİNAT ═══════════════════════════════════════════ -->
        <section class="payment-section">
            <header class="section-header">
                <i class="bi bi-chat-left-text-fill"></i>
                <span>Odenish Teyinati</span>
            </header>
            <div class="section-body">
                <label class="field-label">D1. Teyinat ve esasi</label>
                <textarea class="form-control" rows="3" asp-for="Odenis.Teyinat"
                          id="Odenis_Teyinat" placeholder="Odenishin teyinati"></textarea>

                <label class="field-label mt-3">D2. Elave informasiya</label>
                <input class="form-control" asp-for="Odenis.ElaveInformasiya"
                       id="Odenis_ElaveInformasiya" placeholder="Elave informasiya (istege bagi)">

                <div class="two-field mt-3">
                    <div>
                        <label class="field-label">D3. Budce tesnifatinin kodu</label>
                        <input class="form-control" asp-for="Odenis.BudceTesnifatininKodu"
                               id="Odenis_BudceTesnifatininKodu" placeholder="111254">
                    </div>
                    <div>
                        <label class="field-label">D4. Budce seviyyesinin kodu</label>
                        <input class="form-control" asp-for="Odenis.BudceSeviyyesininKodu"
                               id="Odenis_BudceSeviyyesininKodu" placeholder="1">
                    </div>
                </div>
            </div>
        </section>

        <!-- Xəta paneli -->
        <div id="formXetalar" class="alert alert-danger rounded-3" style="display:none">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Asagidaki xetalar duzeldilmelidir:</strong>
            </div>
            <ul id="formXetalarList" class="mb-0 ps-3"></ul>
        </div>

        <!-- ACTIONS -->
        <div class="form-actions">
            <button type="button" class="btn btn-primary px-5" id="btnGenerateWord">
                <i class="bi bi-file-earmark-word me-1"></i> ÖT hazırlanması
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-lg me-1"></i> Legv Et
            </a>
        </div>

    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/PR_Odenis_Tapsirigi/payment-create.css" />
}
@section Scripts {
    <script src="~/js/PR_Odenis_Tapsirigi/payment-bank.js" asp-append-version="true"></script>
    <script src="~/js/PR_Odenis_Tapsirigi/payment-word.js" asp-append-version="true"></script>

    @if (TempData["AlanMusteri_Ad"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var adInput    = document.querySelector('input[name="MusteriCreateDto.Ad"]');
                var voenInput  = document.querySelector('input[name="MusteriCreateDto.Voen"]');
                var hesabInput = document.querySelector('input[name="MusteriCreateDto.Hesab"]');

                if (adInput)    adInput.value    = '@TempData["AlanMusteri_Ad"]';
                if (voenInput)  voenInput.value  = '@TempData["AlanMusteri_Voen"]';
                if (hesabInput) hesabInput.value = '@TempData["AlanMusteri_Hesab"]';
            });
        </script>
    }

}
