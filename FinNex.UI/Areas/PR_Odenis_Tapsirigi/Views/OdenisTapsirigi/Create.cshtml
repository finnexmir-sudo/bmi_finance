@model FinNex.UI.Areas.PR_Odenis_Tapsirigi.ViewModels.OdenisTapsirigiCreateVM

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Yeni ödəniş tapşırığı</div>
            <div class="fn-page-sub">A-format · SWIFT bank köçürməsi</div>
        </div>
        <a asp-action="Siyahi" class="fn-btn fn-btn--outline">← Siyahı</a>
    </div>

    <form method="post" id="paymentForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Odenis.OduyenBankId" id="OduyenBankIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanBankId" id="AlanBankIdHidden" />
        <input type="hidden" asp-for="Odenis.OduyenMusteriId" id="OduyenMusteriIdHidden" />
        <input type="hidden" asp-for="Odenis.OduyenHesabId" id="OduyenHesabIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanMusteriId" id="AlanMusteriIdHidden" />
        <input type="hidden" asp-for="Odenis.AlanHesabId" id="AlanHesabIdHidden" />

        @* ═══ BANKLAR ═══ *@
        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-bank2 me-1"></i> Bank məlumatları
            </div>
            <div class="fn-form-row">

                @* A1 – Ödüyən bank *@
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                        <span style="background:#2d6cdf;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">A1</span>
                        <span class="fn-label" style="margin:0;">Ödüyən bank</span>
                    </div>
                    <div style="display:flex;gap:6px;">
                        <input type="text" class="fn-input" id="OduyenBankKodSearch" placeholder="Bank kodu..." style="flex:1;" />
                        <button type="button" class="fn-btn fn-btn--primary" id="btnOduyenBankAxtar" style="white-space:nowrap;">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                    </div>
                    <div id="OduyenBankXeta" class="fn-val-msg" style="display:none"></div>
                    <input class="fn-input" id="OduyenBankAd" value="'Bank Melli Iran' Bakı filialı" placeholder="Bankın adı" readonly />
                    <div class="fn-form-row">
                        <input class="fn-input" id="OduyenBankKod" value="509761" placeholder="Kod" readonly />
                        <input class="fn-input" id="OduyenBankVoen" value="1300036291" placeholder="VOEN" readonly />
                    </div>
                    <input class="fn-input" id="OduyenBankMuxbirHesab" value="AZ74NABZ01350100000000037944" placeholder="Müxbir hesab" readonly />
                    <input class="fn-input" id="OduyenBankSwift" value="MELIAZ22" placeholder="SWIFT / BIC" readonly />
                </div>

                @* B1 – Alan bank *@
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                        <span style="background:#1e9b6b;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">B1</span>
                        <span class="fn-label" style="margin:0;">Alan bank (Benefisiar)</span>
                    </div>
                    <div style="display:flex;gap:6px;">
                        <input type="text" class="fn-input" id="AlanBankKodSearch" placeholder="Bank kodu..." style="flex:1;" />
                        <button type="button" class="fn-btn fn-btn--primary" id="btnAlanBankAxtar" style="white-space:nowrap;">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                    </div>
                    <div id="AlanBankXeta" class="fn-val-msg" style="display:none"></div>
                    <input class="fn-input" id="AlanBankAd" placeholder="Bankın adı" />
                    <div class="fn-form-row">
                        <input class="fn-input" id="AlanBankKod" placeholder="Kod" />
                        <input class="fn-input" id="AlanBankVoen" placeholder="VOEN" />
                    </div>
                    <div class="hesab-radio-wrapper" id="AlanBankHesabRadioWrapper" style="display:none;background:#f8f9fb;border:1px solid #e4e8f0;border-radius:8px;padding:10px;">
                        <div style="font-size:11px;color:#8a93a8;margin-bottom:6px;">Müxbir hesab seçin</div>
                        <div id="AlanBankHesabRadioList"></div>
                    </div>
                    <input class="fn-input" id="AlanBankMuxbirHesab" placeholder="Hesab (IBAN)" autocomplete="off" style="display:none" />
                    <input class="fn-input" id="AlanBankSwift" placeholder="SWIFT / BIC" />
                </div>

            </div>
        </div>

        @* ═══ MÜŞTƏRİLƏR ═══ *@
        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-people-fill me-1"></i> Müştərilər
            </div>
            <div class="fn-form-row">

                @* A2 – Ödüyən müştəri *@
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                        <span style="background:#2d6cdf;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">A2</span>
                        <span class="fn-label" style="margin:0;">Ödüyən müştəri</span>
                    </div>
                    <div style="display:flex;gap:6px;">
                        <input type="text" class="fn-input" id="OduyenMusteriVoenSearch" placeholder="VOEN ilə axtar..." style="flex:1;" />
                        <button type="button" class="fn-btn fn-btn--primary" id="btnOduyenMusteriAxtar" style="white-space:nowrap;">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                    </div>
                    <div id="OduyenMusteriXeta" class="fn-val-msg" style="display:none"></div>
                    <input class="fn-input" id="OduyenMusteriAd" placeholder="Müştərinin adı" />
                    <div class="hesab-radio-wrapper" id="OduyenMusteriHesabRadioWrapper" style="display:none;background:#f8f9fb;border:1px solid #e4e8f0;border-radius:8px;padding:10px;">
                        <div style="font-size:11px;color:#8a93a8;margin-bottom:6px;">Hesab seçin</div>
                        <div id="OduyenMusteriHesabRadioList"></div>
                    </div>
                    <input class="fn-input" id="OduyenMusteriHesab" placeholder="Hesab (IBAN)" />
                    <input class="fn-input" id="OduyenMusteriVoen" placeholder="VOEN" />
                </div>

                @* B2 – Alan müştəri *@
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                        <span style="background:#1e9b6b;color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;">B2</span>
                        <span class="fn-label" style="margin:0;">Alan müştəri</span>
                    </div>
                    <div style="display:flex;gap:6px;">
                        <input type="text" class="fn-input" id="AlanMusteriVoenSearch" placeholder="VOEN ilə axtar..." style="flex:1;" />
                        <button type="button" class="fn-btn fn-btn--primary" id="btnAlanMusteriAxtar" style="white-space:nowrap;">
                            <i class="bi bi-search"></i> Axtar
                        </button>
                    </div>
                    <div id="AlanMusteriXeta" class="fn-val-msg" style="display:none"></div>
                    <input class="fn-input" id="AlanMusteriAd" asp-for="@Model.MusteriCreateDto!.Ad" placeholder="Müştərinin adı" />
                    <div class="hesab-radio-wrapper" id="AlanMusteriHesabRadioWrapper" style="display:none;background:#f8f9fb;border:1px solid #e4e8f0;border-radius:8px;padding:10px;">
                        <div style="font-size:11px;color:#8a93a8;margin-bottom:6px;">Hesab seçin</div>
                        <div id="AlanMusteriHesabRadioList"></div>
                    </div>
                    <input class="fn-input" id="AlanMusteriHesab" asp-for="@Model.MusteriCreateDto!.Hesab" placeholder="Hesab (IBAN)" />
                    <input class="fn-input" id="AlanMusteriVoen" asp-for="@Model.MusteriCreateDto!.Voen" placeholder="VOEN" />
                </div>

            </div>
        </div>

        @* ═══ MƏBLƏĞ ═══ *@
        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-currency-exchange me-1"></i> Məbləğ
            </div>
            <div style="display:grid;grid-template-columns:120px 1fr 1fr;gap:14px;">
                <div class="fn-form-group">
                    <label class="fn-label">Valyuta</label>
                    <select class="fn-select" asp-for="Odenis.Valyuta" id="Odenis_Valyuta"
                            onchange="document.getElementById('Odenis_ValyutaId').value = this.options[this.selectedIndex].dataset.id || (this.selectedIndex + 1)">
                        <option data-id="1">AZN</option>
                        <option data-id="2">USD</option>
                        <option data-id="3">EUR</option>
                    </select>
                    <input type="hidden" id="Odenis_ValyutaId" value="1" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Rəqəmlə</label>
                    <input class="fn-input" asp-for="Odenis.Mebleg" id="Odenis_Mebleg" placeholder="0.00" step="0.01" onfocus="this.select()" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">Yazı ilə <span class="fn-label-hint">(avtomatik)</span></label>
                    <input class="fn-input" asp-for="Odenis.MeblegYazi" id="Odenis_MeblegYazi" placeholder="Avtomatik doldurulacaq..." readonly />
                </div>
            </div>
        </div>

        @* ═══ TƏYİNAT ═══ *@
        <div class="fn-card" style="margin-bottom:16px;">
            <div class="fn-card-title" style="margin-bottom:14px;">
                <i class="bi bi-chat-left-text-fill me-1"></i> Ödəniş təyinatı
            </div>
            <div class="fn-form-group">
                <label class="fn-label">D1. Təyinat və əsası <span class="fn-required">*</span></label>
                <textarea class="fn-textarea" rows="3" asp-for="Odenis.Teyinat" id="Odenis_Teyinat" placeholder="Ödənişin təyinatı"></textarea>
            </div>
            <div class="fn-form-group">
                <label class="fn-label">D2. Əlavə informasiya <span class="fn-label-hint">(isteğe bağlı)</span></label>
                <input class="fn-input" asp-for="Odenis.ElaveInformasiya" id="Odenis_ElaveInformasiya" placeholder="Əlavə informasiya" />
            </div>
            <div class="fn-form-row">
                <div class="fn-form-group">
                    <label class="fn-label">D3. Büdcə təsnifatının kodu</label>
                    <input class="fn-input" asp-for="Odenis.BudceTesnifatininKodu" id="Odenis_BudceTesnifatininKodu" placeholder="111254" />
                </div>
                <div class="fn-form-group">
                    <label class="fn-label">D4. Büdcə səviyyəsinin kodu</label>
                    <input class="fn-input" asp-for="Odenis.BudceSeviyyesininKodu" id="Odenis_BudceSeviyyesininKodu" placeholder="1" />
                </div>
            </div>
        </div>

        @* ═══ XƏTA PANELİ ═══ *@
        <div id="formXetalar" style="display:none;background:#fee2e2;border:1px solid #fecaca;border-radius:8px;padding:12px 14px;margin-bottom:16px;">
            <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;font-size:12px;font-weight:600;color:#c0392b;">
                <i class="bi bi-exclamation-triangle-fill"></i> Aşağıdakı xətalar düzəldilməlidir:
            </div>
            <ul id="formXetalarList" style="margin:0;padding-left:16px;font-size:12px;color:#991b1b;"></ul>
        </div>

        @* ═══ DÜYMƏLƏR ═══ *@
        <div class="fn-form-actions">
            <a asp-action="Siyahi" class="fn-btn fn-btn--outline">Ləğv et</a>
            <button type="button" class="fn-btn fn-btn--primary" id="btnGenerateWord">
                <i class="bi bi-file-earmark-word me-1"></i> ÖT hazırla və yüklə
            </button>
        </div>

    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/PR_Odenis_Tapsirigi/payment-create.css" />
}
@section Scripts {
    <script src="~/js/PR_Odenis_Tapsirigi/payment-bank.js" asp-append-version="true"></script>
    <script src="~/js/PR_Odenis_Tapsirigi/payment-word.js" asp-append-version="true"></script>

    @if (TempData["AlanMusteri_Ad"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var adInput = document.querySelector('input[name="MusteriCreateDto.Ad"]');
                var voenInput = document.querySelector('input[name="MusteriCreateDto.Voen"]');
                var hesabInput = document.querySelector('input[name="MusteriCreateDto.Hesab"]');
                if (adInput) adInput.value = '@TempData["AlanMusteri_Ad"]';
                if (voenInput) voenInput.value = '@TempData["AlanMusteri_Voen"]';
                if (hesabInput) hesabInput.value = '@TempData["AlanMusteri_Hesab"]';
            });
        </script>
    }
}
