@model FinNex.UI.Areas.PR_Odenis_Tapsirigi.ViewModels.OdenisTapsirigiSiyahiVM

<div class="fn-page">

    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Ödəniş tapşırıqları</div>
            <div class="fn-page-sub">Bütün ödəniş tapşırıqlarının tarixçəsi · @Model.UmumiSay nəticə</div>
        </div>
        <a asp-action="Create" class="fn-btn fn-btn--primary">+ Yeni ödəniş</a>
    </div>

    @* ── Filtr ── *@
    <form method="get" asp-action="Siyahi" class="fn-card" style="margin-bottom:16px;">
        <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:10px;">
            <div class="fn-form-group">
                <label class="fn-label">Nömrə</label>
                <input type="text" name="nomre" value="@Model.Filter.Nomre" class="fn-input" placeholder="000001" />
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Ödəyən müştəri</label>
                <input type="text" name="oduyenMusteri" value="@Model.Filter.OduyenMusteri" class="fn-input" placeholder="Ad ilə axtar..." />
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Alan müştəri</label>
                <input type="text" name="alanMusteri" value="@Model.Filter.AlanMusteri" class="fn-input" placeholder="Ad ilə axtar..." />
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Valyuta</label>
                <select name="valyuta" class="fn-select">
                    <option value="">Hamısı</option>
                    <option value="AZN" selected="@(Model.Filter.Valyuta == "AZN")">AZN</option>
                    <option value="USD" selected="@(Model.Filter.Valyuta == "USD")">USD</option>
                    <option value="EUR" selected="@(Model.Filter.Valyuta == "EUR")">EUR</option>
                </select>
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Tarixdən</label>
                <input type="date" name="tarixden" value="@Model.Filter.Tarixden?.ToString("yyyy-MM-dd")" class="fn-input" />
            </div>
            <div class="fn-form-group">
                <label class="fn-label">Tarixə qədər</label>
                <input type="date" name="tarixe" value="@Model.Filter.TarixeQeder?.ToString("yyyy-MM-dd")" class="fn-input" />
            </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:10px;">
            <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-search me-1"></i> Axtar</button>
            <a asp-action="Siyahi" class="fn-btn fn-btn--outline">Təmizlə</a>
        </div>
    </form>

    @* ── Cədvəl ── *@
    <div class="fn-card" style="padding:0;overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;">
            <thead>
                <tr style="background:#f8f9fb;border-bottom:1px solid #e4e8f0;">
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Nömrə</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Tarix</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Ödəyən</th>
                    <th style="padding:10px 14px;text-align:left;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Alan</th>
                    <th style="padding:10px 14px;text-align:right;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Məbləğ</th>
                    <th style="padding:10px 14px;text-align:center;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;">Valyuta</th>
                    <th style="padding:10px 14px;text-align:right;font-size:11px;font-weight:600;color:#8a93a8;text-transform:uppercase;"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Melumtlar.Any())
                {
                    @foreach (var item in Model.Melumtlar)
                    {
                        <tr style="border-bottom:1px solid #f0f2f7;">
                            <td style="padding:10px 14px;font-weight:600;color:#2d6cdf;">@item.Nomre</td>
                            <td style="padding:10px 14px;color:#3d4557;">@item.Tarix.ToString("dd.MM.yyyy")</td>
                            <td style="padding:10px 14px;color:#1a2332;">@item.OduyenMusteri?.Ad</td>
                            <td style="padding:10px 14px;color:#1a2332;">@item.AlanMusteri?.Ad</td>
                            <td style="padding:10px 14px;text-align:right;font-weight:600;color:#1a2332;">@item.Mebleg.ToString("N2")</td>
                            <td style="padding:10px 14px;text-align:center;">
                                <span style="padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;background:#f0f2f7;color:#3d4557;">@item.Valyuta?.Ad</span>
                            </td>
                            <td style="padding:10px 14px;text-align:right;">
                                <a asp-action="Detail" asp-route-id="@item.Id"
                                   style="padding:4px 8px;border:1px solid #e4e8f0;border-radius:6px;font-size:12px;color:#5a647a;text-decoration:none;">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="padding:40px 14px;text-align:center;color:#8a93a8;font-size:13px;">
                            <i class="bi bi-inbox" style="font-size:28px;display:block;margin-bottom:6px;color:#dde1ea;"></i>
                            Nəticə tapılmadı
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Səhifələmə ── *@
    @if (Model.SehifeSayi > 1)
    {
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:12px;color:#8a93a8;">
            <span>@((Model.CariSehife - 1) * Model.SehifeOlcusu + 1)–@(Math.Min(Model.CariSehife * Model.SehifeOlcusu, Model.UmumiSay)) / @Model.UmumiSay</span>
            <div style="display:flex;gap:4px;">
                @{
                    int cur = Model.CariSehife;
                    int total = Model.SehifeSayi;
                    int baslangic = Math.Max(1, cur - 2);
                    int son = Math.Min(total, cur + 2);
                    if (son - baslangic < 4)
                    {
                        if (baslangic == 1) son = Math.Min(total, 5);
                        else baslangic = Math.Max(1, son - 4);
                    }
                }
                @if (cur > 1)
                {
                    <a asp-action="Siyahi" asp-route-sehife="@(cur - 1)" asp-route-nomre="@Model.Filter.Nomre" asp-route-oduyenMusteri="@Model.Filter.OduyenMusteri" asp-route-alanMusteri="@Model.Filter.AlanMusteri" asp-route-valyuta="@Model.Filter.Valyuta" asp-route-tarixden="@Model.Filter.Tarixden?.ToString("yyyy-MM-dd")" asp-route-tarixe="@Model.Filter.TarixeQeder?.ToString("yyyy-MM-dd")"
                       style="padding:4px 8px;border:1px solid #e4e8f0;border-radius:6px;text-decoration:none;color:#5a647a;font-size:12px;">‹</a>
                }
                @for (int i = baslangic; i <= son; i++)
                {
                    <a asp-action="Siyahi" asp-route-sehife="@i" asp-route-nomre="@Model.Filter.Nomre" asp-route-oduyenMusteri="@Model.Filter.OduyenMusteri" asp-route-alanMusteri="@Model.Filter.AlanMusteri" asp-route-valyuta="@Model.Filter.Valyuta" asp-route-tarixden="@Model.Filter.Tarixden?.ToString("yyyy-MM-dd")" asp-route-tarixe="@Model.Filter.TarixeQeder?.ToString("yyyy-MM-dd")"
                       style="padding:4px 8px;border:1px solid @(i == cur ? "#1a2332" : "#e4e8f0");border-radius:6px;text-decoration:none;font-size:12px;font-weight:@(i == cur ? "600" : "400");color:@(i == cur ? "#fff" : "#5a647a");background:@(i == cur ? "#1a2332" : "transparent");">@i</a>
                }
                @if (cur < total)
                {
                    <a asp-action="Siyahi" asp-route-sehife="@(cur + 1)" asp-route-nomre="@Model.Filter.Nomre" asp-route-oduyenMusteri="@Model.Filter.OduyenMusteri" asp-route-alanMusteri="@Model.Filter.AlanMusteri" asp-route-valyuta="@Model.Filter.Valyuta" asp-route-tarixden="@Model.Filter.Tarixden?.ToString("yyyy-MM-dd")" asp-route-tarixe="@Model.Filter.TarixeQeder?.ToString("yyyy-MM-dd")"
                       style="padding:4px 8px;border:1px solid #e4e8f0;border-radius:6px;text-decoration:none;color:#5a647a;font-size:12px;">›</a>
                }
            </div>
        </div>
    }
</div>
