@model FinNex.UI.Areas.PR_Odenis_Tapsirigi.ViewModels.OdenisTapsirigiDetailVM

<div class="detail-page">

	<!-- HEADER -->
	<div class="detail-header">
		<div class="detail-header-left">
			<div class="detail-nomre-badge">
				<i class="bi bi-file-earmark-text me-2"></i>
				Ödəniş Tapşırığı #@Model.Odenis.Nomre
			</div>
			<div class="detail-meta-chips">
				<span class="meta-chip">
					<i class="bi bi-calendar3 me-1"></i>
					@Model.Odenis.Tarix.ToString("dd MMMM yyyy, HH:mm")
				</span>
				<span class="meta-chip meta-chip-valyuta">
					@Model.Odenis.Valyuta?.Ad
				</span>
				@if (Model.BugunDuzeli)
				{
						<span class="meta-chip meta-chip-bugun">
							<i class="bi bi-circle-fill me-1" style="font-size:7px"></i>
							Bu gün yaradılıb
						</span>
				}
			</div>
		</div>
		<div class="detail-header-actions">
			@if (Model.BugunDuzeli)
			{
					<a asp-action="Update" asp-route-id="@Model.Odenis.Id"
		   class="btn btn-warning px-4">
			<i class="bi bi-pencil me-1"></i> Düzəliş Et
		</a>
			}
			else
			{
			<button class="btn btn-warning px-4" disabled
					title="Yalnız bu gün yaradılmış sənədlər dəyişdirilə bilər">
				<i class="bi bi-lock me-1"></i> Düzəliş Bağlıdır
			</button>
			}
			<!-- KÖHNƏ modal düyməsini SİL, bunu əlavə et -->
			<a asp-area="PR_Odenis_Tapsirigi" asp-action="YenidenYazForm" asp-route-id="@Model.Odenis.Id"
			   class="btn btn-primary px-4">
				<i class="bi bi-arrow-repeat me-1"></i> Yenidən Yaz
			</a>
			<a asp-action="Siyahi" class="btn btn-outline-secondary px-3">
				<i class="bi bi-arrow-left"></i>
			</a>
		</div>
	</div>

	<!-- MƏZMUN -->
	<div class="detail-body">

		<!-- ── BANKLAR ── -->
		<div class="detail-section-row">

			<!-- A1 Ödüyən Bank -->
			<div class="detail-card">
				<div class="detail-card-header">
					<span class="card-tag">A1</span>
					<span>Ödüyən Bank</span>
				</div>
				<div class="detail-card-body">
					<div class="detail-field">
						<span class="field-label">Adı</span>
						<span class="field-value">@Model.Odenis.OduyenBank?.Ad</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Kod</span>
						<span class="field-value">@Model.Odenis.OduyenBank?.Kod</span>
					</div>
					<div class="detail-field">
						<span class="field-label">VOEN</span>
						<span class="field-value">@Model.Odenis.OduyenBank?.Voen</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Müxbir hesab</span>
						<span class="field-value mono">@Model.Odenis.OduyenHesab?.Iban</span>
					</div>
					<div class="detail-field">
						<span class="field-label">SWIFT</span>
						<span class="field-value mono">@Model.Odenis.OduyenBank?.SwiftBic</span>
					</div>
				</div>
			</div>

			<!-- B1 Alan Bank -->
			<div class="detail-card">
				<div class="detail-card-header">
					<span class="card-tag card-tag-b">B1</span>
					<span>Alan Bank</span>
				</div>
				<div class="detail-card-body">
					<div class="detail-field">
						<span class="field-label">Adı</span>
						<span class="field-value">@Model.Odenis.AlanBank?.Ad</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Kod</span>
						<span class="field-value">@Model.Odenis.AlanBank?.Kod</span>
					</div>
					<div class="detail-field">
						<span class="field-label">VOEN</span>
						<span class="field-value">@Model.Odenis.AlanBank?.Voen</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Müxbir hesab</span>
						<span class="field-value mono">@Model.Odenis.AlanHesab?.Iban</span>
					</div>
					<div class="detail-field">
						<span class="field-label">SWIFT</span>
						<span class="field-value mono">@Model.Odenis.AlanBank?.SwiftBic</span>
					</div>
				</div>
			</div>

		</div>

		<!-- ── MÜŞTƏRİLƏR ── -->
		<div class="detail-section-row">

			<!-- A2 Ödüyən Müştəri -->
			<div class="detail-card">
				<div class="detail-card-header">
					<span class="card-tag">A2</span>
					<span>Ödüyən Müştəri</span>
				</div>
				<div class="detail-card-body">
					<div class="detail-field">
						<span class="field-label">Adı</span>
						<span class="field-value">@Model.Odenis.OduyenMusteri?.Ad</span>
					</div>
					<div class="detail-field">
						<span class="field-label">VOEN</span>
						<span class="field-value">@Model.Odenis.OduyenMusteri?.Voen</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Hesab (IBAN)</span>
						<span class="field-value mono">@Model.Odenis.OduyenHesab?.Iban</span>
					</div>
				</div>
			</div>

			<!-- B2 Alan Müştəri -->
			<div class="detail-card">
				<div class="detail-card-header">
					<span class="card-tag card-tag-b">B2</span>
					<span>Alan Müştəri</span>
				</div>
				<div class="detail-card-body">
					<div class="detail-field">
						<span class="field-label">Adı</span>
						<span class="field-value ">@Model.Odenis.AlanMusteri?.Ad</span>
					</div>
					<div class="detail-field">
						<span class="field-label">VOEN</span>
						<span class="field-value">@Model.Odenis.AlanMusteri?.Voen</span>
					</div>
					<div class="detail-field">
						<span class="field-label">Hesab (IBAN)</span>
						<span class="field-value mono">@Model.Odenis.AlanHesab?.Iban</span>
					</div>
				</div>
			</div>

		</div>

		<!-- ── MƏBLƏĞ ── -->
		<div class="detail-card detail-card-full">
			<div class="detail-card-header">
				<span class="card-tag card-tag-c">C</span>
				<span>Məbləğ</span>
			</div>
			<div class="detail-card-body detail-amount-row">
				<div class="detail-field">
					<span class="field-label">Valyuta</span>
					<span class="field-value">@Model.Odenis.Valyuta?.Ad</span>
				</div>
				<div class="detail-field">
					<span class="field-label">Məbləğ (rəqəmlə)</span>
					<span class="field-value editable-field"
						  data-field="mebleg"
						  id="view_mebleg">
						@Model.Odenis.Mebleg.ToString("N2")
					</span>
					<input class="form-control edit-input d-none"
						   id="edit_mebleg" type="number" step="0.01"
						   value="@Model.Odenis.Mebleg" />
				</div>
				<div class="detail-field" style="flex:2">
					<span class="field-label">Məbləğ (yazı ilə)</span>
					<span class="field-value editable-field"
						  data-field="meblegYazi"
						  id="view_meblegYazi">
						@Model.Odenis.MeblegYazi
					</span>
					<input class="form-control edit-input d-none"
						   id="edit_meblegYazi" type="text"
						   value="@Model.Odenis.MeblegYazi" />
				</div>
			</div>
		</div>

		<!-- ── TƏYİNAT ── -->
		<div class="detail-card detail-card-full">
			<div class="detail-card-header">
				<span class="card-tag card-tag-d">D</span>
				<span>Teyinat</span>
			</div>
			<div class="detail-card-body">
				<div class="detail-field">
					<span class="field-label">D1. Teyinat və əsası</span>
					<span class="field-value editable-field"
						  data-field="teyinat"
						  id="view_teyinat">
						@Model.Odenis.Teyinat
					</span>
					<textarea class="form-control edit-input d-none"
							  id="edit_teyinat" rows="3">@Model.Odenis.Teyinat</textarea>
				</div>
				<div class="detail-field mt-3">
					<span class="field-label">D2. Əlavə informasiya</span>
					<span class="field-value editable-field"
						  data-field="elaveInformasiya"
						  id="view_elaveInformasiya">
						@Model.Odenis.ElaveInformasiya
					</span>
					<input class="form-control edit-input d-none"
						   id="edit_elaveInformasiya" type="text"
						   value="@Model.Odenis.ElaveInformasiya" />
				</div>
				<div class="detail-two-field mt-3">
					<div class="detail-field">
						<span class="field-label">D3. Büdcə təsnifatının kodu</span>
						<span class="field-value editable-field"
							  data-field="budceTesnifatininKodu"
							  id="view_budceTesnifatininKodu">
							@Model.Odenis.BudceTesnifatininKodu
						</span>
						<input class="form-control edit-input d-none"
							   id="edit_budceTesnifatininKodu" type="text"
							   value="@Model.Odenis.BudceTesnifatininKodu" />
					</div>
					<div class="detail-field">
						<span class="field-label">D4. Büdcə səviyyəsinin kodu</span>
						<span class="field-value editable-field"
							  data-field="budceSeviyyesininKodu"
							  id="view_budceSeviyyesininKodu">
							@Model.Odenis.BudceSeviyyesininKodu
						</span>
						<input class="form-control edit-input d-none"
							   id="edit_budceSeviyyesininKodu" type="text"
							   value="@Model.Odenis.BudceSeviyyesininKodu" />
					</div>
				</div>
			</div>
		</div>

	</div><!-- /detail-body -->
	<!-- Bildiriş -->
	<div id="detailToast" class="detail-toast d-none"></div>

</div>


@section Styles {
		<link rel="stylesheet" href="~/css/PR_Odenis_Tapsirigi/payment-detail.css" asp-append-version="true" />
}
@section Scripts {
		<script>
			const ODENIS_ID  = @Model.Odenis.Id;
			const BUGUN_EDIT = @Model.BugunDuzeli.ToString().ToLower();
		</script>
		<script src="~/js/PR_Odenis_Tapsirigi/payment-detail.js" asp-append-version="true"></script>
}