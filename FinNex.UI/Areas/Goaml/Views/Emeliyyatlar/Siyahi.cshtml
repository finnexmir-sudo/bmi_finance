@using FinNex.Domain.Entities.Goaml
@model List<FinNex.Application.DTOs.Goaml.GoamlEmeliyyatListDto>
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "GOAML — Təsdiqlənmiş əməliyyatlar";
}

@section Styles {
    <style>
        .gml-table-wrap { overflow-x:auto; border:1px solid #e5e7eb; border-radius:10px; }
        .gml-table { width:100%; border-collapse:collapse; font-size:.82rem; }
        .gml-table th, .gml-table td { padding:10px 12px; border-bottom:1px solid #eef0f4; text-align:left; }
        .gml-table th { background:#f9fafb; font-weight:700; color:#4b5563; font-size:.74rem; text-transform:uppercase; letter-spacing:.02em; }
        .gml-table tbody tr:hover { background:#fafbff; }
        .gml-mebleg { font-weight:700; color:#111827; }
        .gml-pill { display:inline-block; padding:3px 10px; border-radius:20px; font-size:.74rem; font-weight:600; background:#eef2ff; color:#3730a3; }
        .gml-pill--report { background:#fef3c7; color:#92400e; }
        .gml-pill--qaralama { background:#f3f4f6; color:#374151; }
        .gml-pill--ixrac { background:#dcfce7; color:#166534; }
        .gml-empty { padding:40px; text-align:center; color:#9ca3af; font-size:.9rem; }
        .gml-btn-danger { color:#dc2626 !important; border-color:#fecaca !important; }
        .gml-btn-danger:hover { background:#fef2f2 !important; }
        .gml-btn-warn { color:#b45309 !important; border-color:#fde68a !important; }
        .gml-btn-warn:hover { background:#fffbeb !important; }

        /* Filtr zolağı — Index.cshtml-in axtarış forması ilə EYNİ dil (23.11.2026) */
        .gml-fbar { display:flex; flex-wrap:wrap; align-items:end; gap:12px; margin-bottom:16px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px; }
        .gml-ffld { display:flex; flex-direction:column; gap:5px; }
        .gml-ffld-grow { flex:1 1 220px; max-width:320px; }
        .gml-finp-date { width:140px; }
        .gml-flbl { display:block; font-size:.74rem; font-weight:600; color:#6b7280; }
        .gml-fgroup-lbl { font-size:.74rem; font-weight:700; color:#374151; margin-right:2px; align-self:center; }
        .gml-fcount { color:#64748b; font-size:.82rem; font-weight:600; margin-left:auto; }
    </style>
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">GOAML — Təsdiqlənmiş əməliyyatlar</div>
            <div class="fn-page-sub">Operatorun "Təsdiqlə" ilə bizim öz bazamıza yazdığı qeydlər (@Model.Count)</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--primary">
            <i class="bi bi-search"></i> Yeni namizəd axtar
        </a>
    </div>

    <div class="fn-card" style="padding:0">
        @if (!Model.Any())
        {
            <div class="gml-empty">Hələ heç bir əməliyyat təsdiqlənməyib.</div>
        }
        else
        {
            <div style="padding:16px 16px 0">
                <div class="gml-fbar">
                    <div class="gml-ffld gml-ffld-grow">
                        <label class="gml-flbl">Axtarış</label>
                        <input type="text" id="gmlFSearch" class="fn-input" placeholder="№, Debet, Kredit, Təsdiqləyən..." />
                    </div>
                    <div class="gml-ffld">
                        <label class="gml-flbl">Status</label>
                        <select id="gmlFStatus" class="fn-input">
                            <option value="">Hamısı</option>
                            <option value="qaralama">Qaralama</option>
                            <option value="ixrac">İxrac edilib</option>
                        </select>
                    </div>
                    <span class="gml-fgroup-lbl">Əməliyyat tarixi:</span>
                    <div class="gml-ffld">
                        <label class="gml-flbl">Dən</label>
                        <input type="date" id="gmlFEmelBas" class="fn-input gml-finp-date" />
                    </div>
                    <div class="gml-ffld">
                        <label class="gml-flbl">Dək</label>
                        <input type="date" id="gmlFEmelSon" class="fn-input gml-finp-date" />
                    </div>
                    <span class="gml-fgroup-lbl">Yaradılma tarixi:</span>
                    <div class="gml-ffld">
                        <label class="gml-flbl">Dən</label>
                        <input type="date" id="gmlFYarBas" class="fn-input gml-finp-date" />
                    </div>
                    <div class="gml-ffld">
                        <label class="gml-flbl">Dək</label>
                        <input type="date" id="gmlFYarSon" class="fn-input gml-finp-date" />
                    </div>
                    <button type="button" id="gmlFTemizle" class="fn-btn fn-btn--outline">
                        <i class="bi bi-x-circle"></i> Təmizlə
                    </button>
                    <span id="gmlFCount" class="gml-fcount"></span>
                </div>
            </div>
            <div class="gml-table-wrap">
                <table class="gml-table">
                    <thead>
                        <tr>
                            <th>Əməliyyat №</th>
                            <th>Əməl. tarixi</th>
                            <th>Debet</th>
                            <th>Kredit</th>
                            <th>Məbləğ (AZN)</th>
                            <th>Tip</th>
                            <th>Məlumatın növü</th>
                            <th>Təsdiqləyən</th>
                            <th>Yaradılma tarixi</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="gmlTbody">
                        @foreach (var e in Model)
                        {
                            var axtarisMetni = $"{e.CandidateRecNum} {e.Debet} {e.Kredit} {e.TesdiqleyenAdi}".ToLowerInvariant();
                            <tr data-search="@axtarisMetni"
                                data-status="@(e.Status == GoamlEmeliyyatStatusu.IxracEdilib ? "ixrac" : "qaralama")"
                                data-emel-tarix="@e.DateOper.ToString("yyyy-MM-dd")"
                                data-yar-tarix="@e.YaradilmaTarixi.ToString("yyyy-MM-dd")">
                                <td>@e.CandidateRecNum</td>
                                <td>@e.DateOper.ToString("dd.MM.yyyy")</td>
                                <td style="font-family:ui-monospace,Consolas,monospace">@(e.Debet ?? "—")</td>
                                <td style="font-family:ui-monospace,Consolas,monospace">@(e.Kredit ?? "—")</td>
                                <td class="gml-mebleg">@(e.SummaVNacval?.ToString("N2") ?? "—")</td>
                                <td>@(e.Tip.HasValue ? e.Tip.Value.Etiket() : "—")</td>
                                <td>
                                    @if (e.ReportCode.HasValue)
                                    {
                                        <span class="gml-pill gml-pill--report">@e.ReportCode.Value.Kod()</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@(e.TesdiqleyenAdi ?? "—")</td>
                                <td>@e.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="gml-status-cell">
                                    @if (e.Status == GoamlEmeliyyatStatusu.IxracEdilib)
                                    {
                                        <span class="gml-pill gml-pill--ixrac"><i class="bi bi-check2-circle"></i> İxrac edilib</span>
                                    }
                                    else
                                    {
                                        <span class="gml-pill gml-pill--qaralama">Qaralama</span>
                                    }
                                </td>
                                @* 23.11.2026, İKİNCİ DALĞA — "Qaralamaya qaytar" basanda səhifə YENİDƏN
                                   YÜKLƏNİB yuxarı sıçrayırdı (istifadəçi şikayəti). İndi HƏR İKİ forma
                                   (geri qaytar + sil) HƏMİŞƏ DOM-dadır, YALNIZ biri görünür — JS uğurlu
                                   AJAX cavabından sonra sadəcə görünüşü/status pilini dəyişir, "Sil"
                                   formunu REDAKTƏ ETMƏDƏN (öz antiforgery tokeni ilə) göstərir — yeni
                                   token generasiyası/HTML qurmaq lazım deyil. "Sil" özü hələ də adi
                                   postback-dir (istifadəçi bunu şikayət etmədi, qapsam genişlənmədi). *@
                                <td style="display:flex; gap:6px">
                                    <a asp-action="Detal" asp-route-id="@e.Id" class="fn-btn fn-btn--outline fn-btn--sm">
                                        <i class="bi bi-eye"></i> Bax
                                    </a>
                                    @* 23.11.2026, real hadisə: operator "Qaralamaya qaytar"dan sonra
                                       qeydə YENİDƏN TOXUNA bilmirdi (yalnız Bax/Sil var idi) — YALNIZ
                                       "Qaralama" statuslu qeydlərdə görünür (ixrac edilmiş qeyd ƏVVƏLCƏ
                                       "Qaralamaya qaytar" ilə geri çevrilməlidir, "Sil"in eyni şərti).
                                       25.11.2026 — HƏMİŞƏ DOM-dadır, YALNIZ gizlənir (əvvəl @@if ilə
                                       ÜMUMİYYƏTLƏ render olunmurdu) ki, "Qaralamaya qaytar" AJAX-ının
                                       uğur handler-i onu göstərə bilsin — səhifə yenidən yüklənmədən
                                       geri qaytarılan qeyddə operator dərhal "Redaktə et"ə bassın,
                                       başqa taba (Risk) gedib-gəlmədən. *@
                                    <a asp-action="RedakteEt" asp-route-id="@e.Id" class="fn-btn fn-btn--outline fn-btn--sm gml-redakte-link"
                                       style="@(e.Status == GoamlEmeliyyatStatusu.IxracEdilib ? "display:none" : "")">
                                        <i class="bi bi-pencil"></i> Redaktə et
                                    </a>
                                    <form method="post" asp-action="IxracGeriQaytar" asp-route-id="@e.Id"
                                          class="gml-geri-form"
                                          style="@(e.Status == GoamlEmeliyyatStatusu.IxracEdilib ? "" : "display:none")">
                                        <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm gml-btn-warn">
                                            <i class="bi bi-arrow-counterclockwise"></i> Qaralamaya qaytar
                                        </button>
                                    </form>
                                    <form method="post" asp-action="Sil" asp-route-id="@e.Id"
                                          class="gml-sil-form"
                                          style="@(e.Status == GoamlEmeliyyatStatusu.IxracEdilib ? "display:none" : "")"
                                          onsubmit="return confirm('Bu təsdiqlənmiş əməliyyatı silmək istədiyinizə əminsiniz?');">
                                        <button type="submit" class="fn-btn fn-btn--outline fn-btn--sm gml-btn-danger">
                                            <i class="bi bi-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        <tr id="gmlNoMatch" style="display:none">
                            <td colspan="11" class="gml-empty">Filtrə uyğun əməliyyat tapılmadı.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var tbody = document.getElementById('gmlTbody');
            if (!tbody) return; // boş siyahı — filtr zolağı render olunmayıb

            var rows = Array.prototype.filter.call(tbody.querySelectorAll('tr'), function (r) { return r.id !== 'gmlNoMatch'; });
            var noMatch = document.getElementById('gmlNoMatch');
            var count = document.getElementById('gmlFCount');

            var fSearch = document.getElementById('gmlFSearch');
            var fStatus = document.getElementById('gmlFStatus');
            var fEmelBas = document.getElementById('gmlFEmelBas');
            var fEmelSon = document.getElementById('gmlFEmelSon');
            var fYarBas = document.getElementById('gmlFYarBas');
            var fYarSon = document.getElementById('gmlFYarSon');

            function tetbiqEt() {
                var axtaris = fSearch.value.trim().toLowerCase();
                var status = fStatus.value;
                var emelBas = fEmelBas.value, emelSon = fEmelSon.value;
                var yarBas = fYarBas.value, yarSon = fYarSon.value;
                var gorunen = 0;

                rows.forEach(function (r) {
                    var ok = true;
                    if (axtaris && (r.dataset.search || '').indexOf(axtaris) === -1) ok = false;
                    if (ok && status && r.dataset.status !== status) ok = false;
                    if (ok && emelBas && r.dataset.emelTarix < emelBas) ok = false;
                    if (ok && emelSon && r.dataset.emelTarix > emelSon) ok = false;
                    if (ok && yarBas && r.dataset.yarTarix < yarBas) ok = false;
                    if (ok && yarSon && r.dataset.yarTarix > yarSon) ok = false;

                    r.style.display = ok ? '' : 'none';
                    if (ok) gorunen++;
                });

                noMatch.style.display = gorunen === 0 ? '' : 'none';
                count.textContent = gorunen === rows.length ? (rows.length + ' qeyd') : (gorunen + ' / ' + rows.length + ' qeyd');
            }

            [fSearch].forEach(function (el) { el.addEventListener('input', tetbiqEt); });
            [fStatus, fEmelBas, fEmelSon, fYarBas, fYarSon].forEach(function (el) { el.addEventListener('change', tetbiqEt); });

            document.getElementById('gmlFTemizle').addEventListener('click', function () {
                fSearch.value = ''; fStatus.value = '';
                fEmelBas.value = ''; fEmelSon.value = '';
                fYarBas.value = ''; fYarSon.value = '';
                tetbiqEt();
            });

            tetbiqEt();

            // 23.11.2026, İKİNCİ DALĞA — "Qaralamaya qaytar" AJAX-la, səhifə
            // yenidən yüklənmədən (yuxarı sıçramadan). "Sil" TOXUNULMADI —
            // adi postback olaraq qalır, bu sessiyada şikayət olunan YALNIZ
            // "Qaralamaya qaytar" idi.
            Array.prototype.forEach.call(document.querySelectorAll('.gml-geri-form'), function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (!confirm('Qeyd \'Qaralama\'ya qaytarılsın? Diqqət: fayl artıq göndərilibsə, təkrar ixrac TƏKRAR göndərişə səbəb ola bilər.')) return;

                    var btn = form.querySelector('button');
                    var tr = form.closest('tr');
                    var tokenInp = form.querySelector('[name="__RequestVerificationToken"]');
                    btn.disabled = true;

                    fetch(form.action, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': tokenInp ? tokenInp.value : '' }
                    })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (!data || !data.success) {
                                alert((data && data.message) || 'Xəta baş verdi.');
                                btn.disabled = false;
                                return;
                            }
                            tr.dataset.status = 'qaralama';
                            var statusCell = tr.querySelector('.gml-status-cell');
                            if (statusCell) statusCell.innerHTML = '<span class="gml-pill gml-pill--qaralama">Qaralama</span>';
                            form.style.display = 'none';
                            var silForm = tr.querySelector('.gml-sil-form');
                            if (silForm) silForm.style.display = '';
                            var redakteLink = tr.querySelector('.gml-redakte-link');
                            if (redakteLink) redakteLink.style.display = '';
                        })
                        .catch(function () {
                            alert('Şəbəkə xətası — yenidən cəhd edin.');
                            btn.disabled = false;
                        });
                });
            });
        })();
    </script>
}
