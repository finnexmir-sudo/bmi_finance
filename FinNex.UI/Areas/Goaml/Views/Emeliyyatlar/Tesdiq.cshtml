@using FinNex.Domain.Entities.Goaml
@using FinNex.Application.DTOs.Goaml
@model GoamlTesdiqDto
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "GOAML — Təsdiqlə";

    var tipSecimler = Enum.GetValues<GoamlTipi>().Select(t => new { Value = (int)t, Text = t.Etiket() }).ToList();
    var reportSecimler = Enum.GetValues<GoamlHesabatNovu>()
        .Select(r => new { Value = (int)r, Text = r.Kod() + " — " + r.Aciqlama() }).ToList();
    // Tip-in İSTİQAMƏTİ (OUT/IN) — "hansı hesab bizimdir" sualının JS-dəki
    // cavabı. TƏK mənbə `GoamlTipiExtensions.BizimTerefDebetdir()`-dir —
    // burada YENİDƏN YAZILMIR, sadəcə JSON-a render olunur (12.11.2026).
    var tipYonleri = Enum.GetValues<GoamlTipi>().ToDictionary(t => (int)t, t => t.BizimTerefDebetdir());
}

@section Styles {
    <style>
        .gml-grid-2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
        .gml-grid-3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; }
        .gml-flbl { display:block; font-size:.76rem; font-weight:600; color:#6b7280; margin-bottom:5px; }
        .gml-req { color:#dc2626; }
        .gml-section-title { font-size:1rem; font-weight:700; color:#111827; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
        .gml-block { border:1px solid #e5e7eb; border-radius:10px; margin-bottom:14px; background:#fff; overflow:hidden; }
        .gml-block > summary { list-style:none; cursor:pointer; padding:14px 18px; font-weight:700; color:#1f2937; font-size:.92rem;
            display:flex; align-items:center; justify-content:space-between; background:#f9fafb; }
        .gml-block > summary::-webkit-details-marker { display:none; }
        .gml-block > summary .gml-chevron { transition:transform .15s; color:#9ca3af; }
        .gml-block[open] > summary .gml-chevron { transform:rotate(180deg); }
        .gml-block-body { padding:18px; }
        .gml-critical { border:2px solid #fde68a; background:#fffbeb; border-radius:10px; padding:18px; margin-bottom:18px; }
        .gml-extra-note { font-size:.78rem; color:#92400e; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:10px 14px; margin-bottom:14px; }
        .gml-checks { display:flex; gap:22px; align-items:center; flex-wrap:wrap; }
        .gml-checks label { display:flex; align-items:center; gap:6px; font-size:.84rem; color:#374151; cursor:pointer; }

        .gml-info-strip { display:flex; flex-wrap:wrap; gap:18px 28px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:12px 18px; margin-bottom:18px; }
        .gml-info-item { display:flex; flex-direction:column; gap:2px; }
        .gml-info-lbl { font-size:.7rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.03em; }
        .gml-info-val { font-size:.85rem; font-weight:600; color:#1e293b; }

        /* Siniflər QƏSDƏN `fn-alert` DEYİL — `user-area.js` bütün `.fn-alert`
           elementlərini 4 saniyəyə silir (CLAUDE.md, "ViewModel Required" tələsi
           ilə eyni tələ) — bu banner isə "hər iki tərəfdə KYC var" xəbərdarlığını
           İKİ interaktiv düymə ilə göstərir, 4 saniyə sonra yoxa çıxsa operator
           onları klikləyə bilmir (12.11.2026, real hadisə — "ekrana çıxır,
           biranlıq, gedir"). `.fn-alert--warning`/`--info`-nin ÖZÜ də heç yerdə
           tərif olunmayıb (yalnız boş padding/radius qalırdı, rəngsiz) — bu
           səbəbdən banner həm görünməz kimi, həm də 4 saniyəlik idi. */
        .gml-banner { border-radius:10px; padding:14px 18px; margin-bottom:16px; font-size:.86rem; line-height:1.5; }
        .gml-banner--info { background:#eff6ff; border:1px solid #bfdbfe; color:#1e40af; }
        .gml-banner--warning { background:#fffbeb; border:1.5px solid #fcd34d; color:#92400e; }
    </style>
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">GOAML — Namizəd əməliyyatı Təsdiqlə</div>
            <div class="fn-page-sub">Oracle namizədindən doldurulub gəldi — qalan sahələri doldurub yadda saxlayın</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="fn-alert fn-alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
    }

    @{
        var gmlElaqaliSexsler = (ViewBag.ElaqaliSexsler as List<GoamlElaqaliSexsDto>) ?? new List<GoamlElaqaliSexsDto>();
        var gmlAvtoDolduruldu = ViewBag.AvtoDolduruldu == true;
        var gmlKycDebet = ViewBag.KycDebet as GoamlHesabSahibiKycDto;
        var gmlKycKredit = ViewBag.KycKredit as GoamlHesabSahibiKycDto;
        var gmlHerIkiTerefdeVar = ViewBag.HerIkiTerefdeKycVar == true;
        // ── 13.11.2026: aşağıdakı "Hesab imza hüququ olan şəxs" blokunun öz
        //    tərəf-seçim dropdown-u üçün etiket mətnləri — TekSexs varsa adı
        //    göstərir (operator kimin seçildiyini görsün), yoxdursa sadəcə
        //    hesab nömrəsi qalır. ──────────────────────────────────────────
        var gmlDebetAdi = gmlKycDebet?.TekSexs != null ? $"{gmlKycDebet.TekSexs.Adi} {gmlKycDebet.TekSexs.Soyadi}".Trim() : null;
        var gmlKreditAdi = gmlKycKredit?.TekSexs != null ? $"{gmlKycKredit.TekSexs.Adi} {gmlKycKredit.TekSexs.Soyadi}".Trim() : null;
    }
    @if (gmlAvtoDolduruldu)
    {
        <div class="gml-banner gml-banner--info">
            <i class="bi bi-info-circle-fill"></i>
            Hesab sahibinin məlumatı sistem tərəfindən avtomatik gətirildi (Oracle) — yoxlayın, lazım olsa düzəldin.
        </div>
    }
    @* ── Hər iki tərəfdə (Debet VƏ Kredit) KYC tapılanda ayrıca bir banner
         GÖSTƏRMİRİK (13.11.2026, İKİNCİ dəfə sadələşdirildi — istifadəçi
         hələ də çaşdırıcı tapdı: "tipi dəyişirəm həmin düymələr gedir, nə iş
         gördüklərini başa düşmədim, bunu elə Tip ilə idarə edə bilmərikmi").
         İndi seçim YALNIZ "Hesab imza hüququ olan şəxsin" blokunun DAXİLİNDƏ,
         Nümayəndə (CON) bloku ilə EYNİ üslubda bir dropdown-dur (aşağı bax,
         "gmlTerefSelectWrap") — Tip istiqamətlidirsə (OUT/IN) JS tərəfi
         hesab bilib avtomatik tətbiq edir VƏ dropdown-u gizlədir;
         istiqamətsizdirsə (H to H/F to F) operator ORADA, imza bloku
         açılanda seçir — ayrıca, hər namizəddə görünən bir banner yoxdur. ── *@

    <form method="post" asp-action="Tesdiq">
        <input type="hidden" asp-for="CandidateFilialNumber" />
        <input type="hidden" name="CandidateDateOper" value="@Model.CandidateDateOper.ToString("yyyy-MM-dd")" />
        <input type="hidden" asp-for="CandidateRecNum" />

        @* ── Namizədin Oracle-dan ARTIQ BİLİNƏN sahələri (09.11.2026, KRİTİK
             DÜZƏLİŞ) — bu yeddi sahə HƏR TƏSDİQLƏNMİŞ qeyddə Debet/Kredit/
             Məbləğ/Qeyd/hesab-sahibi adları olaraq PERMANENT YAZILIR, sadəcə
             ekranda göstərilmir deyə. Köhnə versiyada bunlar YALNIZ aşağıdakı
             `gml-info-strip`-də OXUNUR, heç bir <input>-ə bağlı DEYİLDİ —
             "formaya göndərilmir" şərhi yanlış idi: bu sahələr GÖNDƏRİLMƏLİ
             idi (GoamlEmeliyyat-ın özündə saxlanan sütunlardır), sadəcə
             göndərilmirdi. Nəticə: HƏR təsdiqlənmiş qeyd Debet/Kredit/Məbləğ
             "—" (NULL) yazırdı — real hadisə (09.11.2026), ekran-görüntüsü
             ilə tapıldı. İndi hidden input-larla göndərilir, info-strip
             dəyişmədən qalır (yenə sırf göstərmə üçündür). ── *@
        <input type="hidden" asp-for="Debet" />
        <input type="hidden" asp-for="Kredit" />
        <input type="hidden" asp-for="NameUr" />
        <input type="hidden" asp-for="ToAdi" />
        <input type="hidden" asp-for="Primechanie" />
        <input type="hidden" asp-for="KodValuti" />
        <input type="hidden" asp-for="DocumentSource" />
        <input type="hidden" name="SummaVNacval" value="@(Model.SummaVNacval?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" />
        <div class="gml-info-strip">
            <div class="gml-info-item"><span class="gml-info-lbl">Əməliyyat №</span><span class="gml-info-val">@Model.CandidateRecNum</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Tarix</span><span class="gml-info-val">@Model.CandidateDateOper.ToString("dd.MM.yyyy")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Debet</span><span class="gml-info-val">@(Model.Debet ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Debet sahibi</span><span class="gml-info-val">@(Model.NameUr ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Kredit</span><span class="gml-info-val">@(Model.Kredit ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Kredit sahibi</span><span class="gml-info-val">@(Model.ToAdi ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Məbləğ (AZN)</span><span class="gml-info-val">@(Model.SummaVNacval?.ToString("N2") ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Qeyd</span><span class="gml-info-val">@(Model.Primechanie ?? "—")</span></div>
        </div>

        @* ── Operatorun HƏQIQƏTƏN doldurduğu sahələr — 06.11.2026, işçinin özündən
             alınmış siyahı. Qalan ~100 sahə (Hüquqi şəxsin bloku, Alan fiziki şəxsin
             tam detalı, Banka aid olmayan... SWIFT/Hesab, Əlavə sahələr) BU FORMADAN
             ÇIXARILIB — amma GoamlEmeliyyat/GoamlTesdiqDto-dan SİLİNMƏYİB. Gələcəkdə
             AYSEL-in "Update New" kaskadının ekvivalenti quruləndə həmin sahələr
             bank reyestrlərindən AVTOMATİK doldurulacaq, operator onları əl ilə
             bir daha doldurmayacaq. ── *@
        <div class="gml-critical">
            <div class="gml-section-title"><i class="bi bi-exclamation-triangle-fill" style="color:#d97706"></i> Təsnifat (məcburi)</div>
            <div class="gml-grid-3">
                <div>
                    <label class="gml-flbl">Tip <span class="gml-req">*</span></label>
                    <select name="Tip" class="fn-select" required>
                        <option value="">— seçin —</option>
                        @foreach (var t in tipSecimler)
                        {
                            <option value="@t.Value" selected="@(Model.Tip.HasValue && (int)Model.Tip.Value == t.Value)">@t.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="gml-flbl">Məlumatın növü <span class="gml-req">*</span></label>
                    <select name="ReportCode" class="fn-select" required>
                        <option value="">— seçin —</option>
                        @foreach (var r in reportSecimler)
                        {
                            <option value="@r.Value" selected="@(Model.ReportCode.HasValue && (int)Model.ReportCode.Value == r.Value)">@r.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="gml-flbl">Əməliyyat tarixi</label>
                    <input type="date" name="DateOper" class="fn-input" value="@Model.DateOper?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        @* ── BLOK 1 — Nümayəndənin (Oracle: _CON) ── *@
        <details class="gml-block" open>
            <summary>
                Nümayəndənin (əməliyyatı aparan şəxs)
                <span style="display:flex; align-items:center; gap:10px">
                    <button type="button" class="fn-btn fn-btn--outline fn-btn--sm gml-btn-danger" onclick="event.preventDefault(); gmlBlokTemizle(this);">
                        <i class="bi bi-eraser"></i> Təmizlə
                    </button>
                    <i class="bi bi-chevron-down gml-chevron"></i>
                </span>
            </summary>
            <div class="gml-block-body">
                @* ── HƏMİŞƏ render olunur (əvvəl @if ilə şərtlənmişdi) — Tip
                     dəyişəndə/"tərəfi götür" düyməsi ilə JS bu dropdown-u
                     YENİDƏN qurub göstərə/gizlədə bilsin deyə (12.11.2026). ── *@
                <div id="gmlConSelectWrap" style="margin-bottom:16px; display:@(gmlElaqaliSexsler.Count > 0 ? "block" : "none")">
                    <label class="gml-flbl">Hüquqi şəxsin əlaqəli şəxslərindən seçin (sistem CON-u avtomatik tapa bilmir)</label>
                    <select class="fn-select gml-con-select" onchange="gmlConSec(this)">
                        <option value="">— əl ilə doldur —</option>
                        @foreach (var s in gmlElaqaliSexsler)
                        {
                            <option value="@s.IdAml">@($"{s.Adi} {s.Soyadi}".Trim()) @(string.IsNullOrWhiteSpace(s.Rollar) ? "" : $"({s.Rollar})")</option>
                        }
                    </select>
                </div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Adı</label><input asp-for="ConAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Atasının adı</label><input asp-for="ConAtasininAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Soyadı</label><input asp-for="ConSoyadi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Doğulduğu tarix</label>
                        <input type="date" name="ConDogulduguTarix" class="fn-input" value="@Model.ConDogulduguTarix?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Doğulduğu yer</label><input asp-for="ConDogulduguYer" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vətəndaşlığı</label><input asp-for="ConVetendasligi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Cinsi</label><input asp-for="ConCinsi" class="fn-input" placeholder="M / F" /></div>
                    <div><label class="gml-flbl">PİN</label><input asp-for="ConPin" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon növü</label><input asp-for="ConTelefonNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Rabitə növü</label><input asp-for="ConRabiteNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon nömrəsi</label><input asp-for="ConTelefonNomresi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvanın növü</label><input asp-for="ConUnvaninNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvan</label><input asp-for="ConUnvan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Şəhər</label><input asp-for="ConSeher" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="ConOlke" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin növü</label><input asp-for="ConSenedinNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin seriya/nömrəsi</label><input asp-for="ConSenedinSeriyaNomresi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Sənədin verilmə tarixi</label>
                        <input type="date" name="ConSenedinVerilmeTarixi" class="fn-input" value="@Model.ConSenedinVerilmeTarixi?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="gml-flbl">Sənədin etibarlılıq müddəti</label>
                        <input type="date" name="ConSenedinEtibarliliqMuddeti" class="fn-input" value="@Model.ConSenedinEtibarliliqMuddeti?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Verən orqan</label><input asp-for="ConVerenOrqan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Verildiyi ölkə</label><input asp-for="ConVerildiyiOlke" class="fn-input" /></div>
                </div>
                <div class="gml-section-title" style="font-size:.86rem;margin-top:18px;margin-bottom:10px">Nümayəndəni səlahiyyətləndirən sənəd</div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Sənəd növü</label><input asp-for="ReprIdType" class="fn-input" /></div>
                    <div><label class="gml-flbl">Seriya</label><input asp-for="ReprIdSerial" class="fn-input" /></div>
                    <div><label class="gml-flbl">Nömrə</label><input asp-for="ReprIdNumber" class="fn-input" /></div>
                </div>
            </div>
        </details>

        @* ── BLOK 2 — Hesab imza hüququ olan şəxsin (Oracle: _SIG) ── *@
        <details class="gml-block" open="@(gmlHerIkiTerefdeVar ? "open" : null)">
            <summary>
                Hesab imza hüququ olan şəxsin
                <span style="display:flex; align-items:center; gap:10px">
                    <button type="button" class="fn-btn fn-btn--outline fn-btn--sm gml-btn-danger" onclick="event.preventDefault(); gmlBlokTemizle(this);">
                        <i class="bi bi-eraser"></i> Təmizlə
                    </button>
                    <i class="bi bi-chevron-down gml-chevron"></i>
                </span>
            </summary>
            <div class="gml-block-body">
                @* ── Hər iki tərəfdə (Debet VƏ Kredit) KYC tapılanda (13.11.2026)
                     CON-dakı "əlaqəli şəxslərdən seç" ilə EYNİ üslubda, bura
                     YERLƏŞDİRİLMİŞ seçim — Tip istiqamətli (OUT/IN) seçiləndə
                     JS tərəfi avtomatik tətbiq edib bunu gizlədir, istiqamətsiz
                     (H to H/F to F) qalanda operator ÖZÜ seçir. HƏMİŞƏ DOM-dadır
                     ki, Tip dəyişəndə JS göstərib/gizlədə bilsin. ── *@
                <div id="gmlTerefSelectWrap" data-visible="@(gmlHerIkiTerefdeVar ? "1" : "0")" style="margin-bottom:16px; display:@(gmlHerIkiTerefdeVar ? "block" : "none")">
                    <label class="gml-flbl">Hər iki tərəfdə KYC var — hansı tərəf götürülsün?</label>
                    <select class="fn-select" onchange="if (this.value) gmlTerefTetbiqEt(this.value);">
                        <option value="">— əl ilə doldur —</option>
                        <option value="debet">Debet (@Model.Debet)@(gmlDebetAdi != null ? $" — {gmlDebetAdi}" : "")</option>
                        <option value="kredit">Kredit (@Model.Kredit)@(gmlKreditAdi != null ? $" — {gmlKreditAdi}" : "")</option>
                    </select>
                </div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Adı</label><input asp-for="SigAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Atasının adı</label><input asp-for="SigAtasininAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Soyadı</label><input asp-for="SigSoyadi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Doğulduğu tarix</label>
                        <input type="date" name="SigDogulduguTarix" class="fn-input" value="@Model.SigDogulduguTarix?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Doğulduğu yer</label><input asp-for="SigDogulduguYer" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vətəndaşlığı</label><input asp-for="SigVetendasligi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vəzifə</label><input asp-for="SigVezife" class="fn-input" /></div>
                    <div><label class="gml-flbl">İş yerinin adı</label><input asp-for="SigIsYeriAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon növü</label><input asp-for="SigTelefonNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Rabitə növü</label><input asp-for="SigRabiteNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon nömrəsi</label><input asp-for="SigTelefonNomresi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvanın növü</label><input asp-for="SigUnvaninNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvan</label><input asp-for="SigUnvan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Şəhər</label><input asp-for="SigSeher" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="SigOlke" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin növü</label><input asp-for="SigSenedinNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin seriya/nömrəsi</label><input asp-for="SigSenedinSeriyaNomresi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Sənədin verilmə tarixi</label>
                        <input type="date" name="SigSenedinVerilmeTarixi" class="fn-input" value="@Model.SigSenedinVerilmeTarixi?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="gml-flbl">Sənədin etibarlılıq müddəti</label>
                        <input type="date" name="SigSenedinEtibarliliqMuddeti" class="fn-input" value="@Model.SigSenedinEtibarliliqMuddeti?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Verən orqan</label><input asp-for="SigVerenOrqan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Verildiyi ölkə</label><input asp-for="SigVerildiyiOlke" class="fn-input" /></div>
                </div>
            </div>
        </details>

        @* ── BLOK 3 — Banka aid olmayan müştəri (fiziki/hüquqi/sahibkar) — Blok 4+5-in
             sadələşdirilmiş birləşməsi. Checkbox + VÖEN/Ölkə/ADI/Bankın adı — işçinin
             dediyinə görə YALNIZ bunlar işlənir; qalan (Alan fiziki şəxsin tam detalı,
             SWIFT/Hesab/Əlaqə növü) formadan çıxarılıb, entity-də qalır. ── *@
        <details class="gml-block">
            <summary>Banka aid olmayan müştəri <i class="bi bi-chevron-down gml-chevron"></i></summary>
            <div class="gml-block-body">
                <div class="gml-checks" style="margin-bottom:16px">
                    <label><input type="checkbox" name="ToFizik" value="true" checked="@(Model.ToFizik == true)" /> Fizik</label>
                    <label><input type="checkbox" name="ToPred" value="true" checked="@(Model.ToPred == true)" /> Sahibkar</label>
                    <label><input type="checkbox" name="ToYurik" value="true" checked="@(Model.ToYurik == true)" /> Hüquqi</label>
                </div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">VÖEN</label><input asp-for="IncorporationNumberTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="IncorporationCountryCodeTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Adı</label><input asp-for="NameUrTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Bankın adı</label><input asp-for="InstitutionNameTo" class="fn-input" /></div>
                </div>
            </div>
        </details>

        <div style="display:flex;gap:10px;margin-top:18px">
            <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-check-circle"></i> Təsdiqlə və Saxla</button>
            <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
        </div>
    </form>
</div>

<script>
    // ── "Təmizlə" — Nümayəndə (CON) və İmza hüququ (SIG) blokları, 09.11.2026 ──
    // İstifadəçi qərarı: operator dropdown-dan SƏHV şəxs seçib sonra fərqli
    // (ya da tamamilə əl ilə) şəxs yazmaq istəsə, ~20 xananı tək-tək silmək
    // əvəzinə bir kliklə bütün blok (və "əlaqəli şəxsdən seç" dropdown-u da
    // varsa) sıfırlanır. HƏR blok ÖZ `.gml-block-body`-sini təmizləyir —
    // digər bloka TOXUNMUR.
    function gmlBlokTemizle(btn) {
        var blok = btn.closest('.gml-block');
        if (!blok) return;
        var body = blok.querySelector('.gml-block-body');
        if (!body) return;
        body.querySelectorAll('input').forEach(function (el) { el.value = ''; });
        body.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });
    }
</script>

@{
    var gmlJsonOpts = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}
<script>
    // ── "Əlaqəli şəxslərdən seç" — Nümayəndə (CON) bloku, 09.11.2026.
    //    12.11.2026: `let` oldu (əvvəl `const`) — Tip dəyişəndə/"tərəfi götür"
    //    düyməsi ilə JS bu siyahını YENİDƏN qura bilsin deyə (Debet və Kredit-in
    //    öz, FƏRQLİ əlaqəli-şəxs siyahıları ola bilər). ───────────────────────
    let gmlElaqaliSexsler = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(gmlElaqaliSexsler, gmlJsonOpts));

    // ── Debet VƏ Kredit tərəflərinin xam KYC-si (12.11.2026) — hər ikisi də
    //    `null` ola bilər (heç birində tapılmayıb) və ya biri/hər ikisi dolu.
    //    Server-dəki "yalnız bir tərəfdə var" halında dto artıq doldurulub
    //    gəlir (bu dəyişənlər YALNIZ Tip dəyişəndə/əl ilə seçimdə işlənir). ──
    const gmlKycDebet = @Html.Raw(gmlKycDebet != null ? System.Text.Json.JsonSerializer.Serialize(gmlKycDebet, gmlJsonOpts) : "null");
    const gmlKycKredit = @Html.Raw(gmlKycKredit != null ? System.Text.Json.JsonSerializer.Serialize(gmlKycKredit, gmlJsonOpts) : "null");

    // ── Tip-in İSTİQAMƏTİ (OUT/IN) — TƏK mənbə `GoamlTipiExtensions.
    //    BizimTerefDebetdir()`-dir, server-də hesablanıb, burada YALNIZ
    //    render olunur (12.11.2026). true="debet", false="kredit",
    //    null/undefined = istiqamətsiz (HToH/FToF) — operator özü seçsin. ──
    const gmlTipBizimDebetdir = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tipYonleri));

    function gmlDoldur(ad, deyer) {
        const el = document.querySelector('[name="' + ad + '"]');
        if (el) el.value = deyer || '';
    }

    // ── CON seçim dropdown-unu YENİDƏN qurur (siyahı Debet/Kredit-ə görə
    //    dəyişə bilər) — boşdursa bloku gizlədir. ─────────────────────────
    function gmlConDropdownYenile(siyahi) {
        gmlElaqaliSexsler = siyahi || [];
        var wrap = document.getElementById('gmlConSelectWrap');
        var sel = document.querySelector('.gml-con-select');
        if (!wrap || !sel) return;
        sel.innerHTML = '<option value="">— əl ilə doldur —</option>';
        gmlElaqaliSexsler.forEach(function (s) {
            var opt = document.createElement('option');
            opt.value = s.idAml;
            var ad = ((s.adi || '') + ' ' + (s.soyadi || '')).trim();
            opt.textContent = s.rollar ? (ad + ' (' + s.rollar + ')') : ad;
            sel.appendChild(opt);
        });
        sel.selectedIndex = 0;
        wrap.style.display = gmlElaqaliSexsler.length > 0 ? 'block' : 'none';
    }

    function gmlConSec(sel) {
        const idAml = parseInt(sel.value, 10);
        if (!idAml) return;
        const s = gmlElaqaliSexsler.find(x => x.idAml === idAml);
        if (!s) return;
        gmlDoldur('ConAdi', s.adi);
        gmlDoldur('ConAtasininAdi', s.ataAdi);
        gmlDoldur('ConSoyadi', s.soyadi);
        gmlDoldur('ConDogulduguTarix', s.dogulduguTarix ? s.dogulduguTarix.substring(0, 10) : '');
        gmlDoldur('ConDogulduguYer', s.dogulduguYer);
        gmlDoldur('ConVetendasligi', s.vetendasligi);
        gmlDoldur('ConCinsi', s.cinsi);
        gmlDoldur('ConPin', s.pin);
        gmlDoldur('ConTelefonNomresi', s.telefonNomresi);
        gmlDoldur('ConUnvaninNovu', s.unvaninNovu);
        gmlDoldur('ConUnvan', s.unvan);
        gmlDoldur('ConSeher', s.seher);
        gmlDoldur('ConOlke', s.olke);
        gmlDoldur('ConSenedinNovu', s.senedinNovu);
        gmlDoldur('ConSenedinSeriyaNomresi', s.senedinSeriyaNomresi);
        gmlDoldur('ConSenedinVerilmeTarixi', s.senedinVerilmeTarixi ? s.senedinVerilmeTarixi.substring(0, 10) : '');
        gmlDoldur('ConSenedinEtibarliliqMuddeti', s.senedinEtibarliliqMuddeti ? s.senedinEtibarliliqMuddeti.substring(0, 10) : '');
        gmlDoldur('ConVerenOrqan', s.verenOrqan);
        gmlDoldur('ConVerildiyiOlke', s.verildiyiOlke);
    }

    // ── Verilmiş tərəfin (Debet və ya Kredit) TAM KYC-sini CON+SIG-ə tətbiq
    //    edir — `EmeliyyatlarController.KycTetbiqEt`-in (C#) JS güzgüsü,
    //    12.11.2026. Heç nə SİLMİR — yalnız doldurur (boş sahə varsa toxunmur
    //    demək deyil, mövcud dəyəri ÜSTƏLƏYİR, eyni "avtomatik doldur, lazım
    //    olsa düzəlt" qaydası). ────────────────────────────────────────────
    function gmlKycTetbiqEt(kyc) {
        if (!kyc) return;
        if (kyc.fiziki && kyc.tekSexs) {
            var c = kyc.tekSexs;
            gmlDoldur('ConAdi', c.adi);
            gmlDoldur('ConAtasininAdi', c.ataAdi);
            gmlDoldur('ConSoyadi', c.soyadi);
            gmlDoldur('ConDogulduguTarix', c.dogulduguTarix ? c.dogulduguTarix.substring(0, 10) : '');
            gmlDoldur('ConDogulduguYer', c.dogulduguYer);
            gmlDoldur('ConVetendasligi', c.vetendasligi);
            gmlDoldur('ConCinsi', c.cinsi);
            gmlDoldur('ConPin', c.pin);
            gmlDoldur('ConSenedinSeriyaNomresi', c.senedinSeriyaNomresi);
            gmlDoldur('ConSenedinVerilmeTarixi', c.senedinVerilmeTarixi ? c.senedinVerilmeTarixi.substring(0, 10) : '');
            gmlDoldur('ConSenedinEtibarliliqMuddeti', c.senedinEtibarliliqMuddeti ? c.senedinEtibarliliqMuddeti.substring(0, 10) : '');
            gmlDoldur('ConVerenOrqan', c.verenOrqan);
        }
        if (kyc.tekSexs) {
            var s = kyc.tekSexs;
            gmlDoldur('SigAdi', s.adi);
            gmlDoldur('SigAtasininAdi', s.ataAdi);
            gmlDoldur('SigSoyadi', s.soyadi);
            gmlDoldur('SigDogulduguTarix', s.dogulduguTarix ? s.dogulduguTarix.substring(0, 10) : '');
            gmlDoldur('SigDogulduguYer', s.dogulduguYer);
            gmlDoldur('SigVetendasligi', s.vetendasligi);
            gmlDoldur('SigUnvan', s.unvan);
            gmlDoldur('SigSenedinNovu', s.senedinNovu);
            gmlDoldur('SigSenedinSeriyaNomresi', s.senedinSeriyaNomresi);
            gmlDoldur('SigSenedinVerilmeTarixi', s.senedinVerilmeTarixi ? s.senedinVerilmeTarixi.substring(0, 10) : '');
            gmlDoldur('SigSenedinEtibarliliqMuddeti', s.senedinEtibarliliqMuddeti ? s.senedinEtibarliliqMuddeti.substring(0, 10) : '');
            gmlDoldur('SigVerenOrqan', s.verenOrqan);
            gmlDoldur('SigVezife', s.vezife);
            gmlDoldur('SigIsYeriAdi', s.isYeriAdi);
        }
        gmlConDropdownYenile(kyc.fiziki ? [] : kyc.elaqaliSexsler);
    }

    // ── "Debet/Kredit tərəfini götür" düymələri (banner-dəki, HToH/FToF üçün) ──
    function gmlTerefTetbiqEt(teref) {
        gmlKycTetbiqEt(teref === 'debet' ? gmlKycDebet : gmlKycKredit);
    }

    // ── Tip seçiləndə (12.11.2026) — İSTİQAMƏT (OUT/IN) məlumdursa uyğun
    //    tərəf AVTOMATİK tətbiq olunur. O tərəfdə heç nə tapılmayıbsa (null),
    //    HEÇ NƏ EDİLMİR — mövcud sahələr (boş və ya əvvəldən doldurulmuş)
    //    SİLİNMİR; operator lazım olsa "Təmizlə" düyməsini özü işlədir.
    //    İstiqamətsiz tiplərdə (HToH/FToF) avtomatik heç nə baş vermir —
    //    operator "Hesab imza hüququ olan şəxsin" blokundakı dropdown-dan
    //    seçir (13.11.2026, bax `gmlTerefSelectWrap`). ─────────────────────
    document.addEventListener('DOMContentLoaded', function () {
        var tipSel = document.querySelector('select[name="Tip"]');
        if (!tipSel) return;
        tipSel.addEventListener('change', function () {
            var bizimDebetdir = gmlTipBizimDebetdir[this.value];
            if (bizimDebetdir === true && gmlKycDebet) gmlKycTetbiqEt(gmlKycDebet);
            else if (bizimDebetdir === false && gmlKycKredit) gmlKycTetbiqEt(gmlKycKredit);

            // ── Tərəf-seçim dropdown-u İSTİQAMƏTLİ Tip seçiləndə yoxa çıxır
            //    (13.11.2026) — Tip artıq "hansı tərəf bizimdir" sualını özü
            //    cavablandırdığı üçün ayrıca seçim lazımsız qalır. İstiqamətsiz
            //    (HToH/FToF, yaxud Tip hələ seçilməyib) halda operator hələ
            //    özü seçməli olduğu üçün dropdown görünür qalır/geri qayıdır. ──
            var wrap = document.getElementById('gmlTerefSelectWrap');
            if (wrap && wrap.dataset.visible === '1') {
                var bilinir = bizimDebetdir === true || bizimDebetdir === false;
                wrap.style.display = bilinir ? 'none' : 'block';
            }
        });
    });
</script>
