@using FinNex.Domain.Entities.Goaml
@model FinNex.Application.DTOs.Goaml.GoamlTesdiqDto
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "GOAML — Təsdiqlə";

    var tipSecimler = Enum.GetValues<GoamlTipi>().Select(t => new { Value = (int)t, Text = t.Etiket() }).ToList();
    var reportSecimler = Enum.GetValues<GoamlHesabatNovu>()
        .Select(r => new { Value = (int)r, Text = r.Kod() + " — " + r.Aciqlama() }).ToList();
}

@section Styles {
    <style>
        .gml-grid-2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; }
        .gml-grid-3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:14px; }
        .gml-flbl { display:block; font-size:.76rem; font-weight:600; color:#6b7280; margin-bottom:5px; }
        .gml-req { color:#dc2626; }
        .gml-section-title { font-size:1rem; font-weight:700; color:#111827; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
        .gml-block { border:1px solid #e5e7eb; border-radius:10px; margin-bottom:14px; background:#fff; overflow:hidden; }
        .gml-block > summary { list-style:none; cursor:pointer; padding:14px 18px; font-weight:700; color:#1f2937; font-size:.92rem;
            display:flex; align-items:center; justify-content:space-between; background:#f9fafb; }
        .gml-block > summary::-webkit-details-marker { display:none; }
        .gml-block > summary .gml-chevron { transition:transform .15s; color:#9ca3af; }
        .gml-block[open] > summary .gml-chevron { transform:rotate(180deg); }
        .gml-block-body { padding:18px; }
        .gml-critical { border:2px solid #fde68a; background:#fffbeb; border-radius:10px; padding:18px; margin-bottom:18px; }
        .gml-extra-note { font-size:.78rem; color:#92400e; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:10px 14px; margin-bottom:14px; }
        .gml-checks { display:flex; gap:22px; align-items:center; flex-wrap:wrap; }
        .gml-checks label { display:flex; align-items:center; gap:6px; font-size:.84rem; color:#374151; cursor:pointer; }

        .gml-info-strip { display:flex; flex-wrap:wrap; gap:18px 28px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:12px 18px; margin-bottom:18px; }
        .gml-info-item { display:flex; flex-direction:column; gap:2px; }
        .gml-info-lbl { font-size:.7rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.03em; }
        .gml-info-val { font-size:.85rem; font-weight:600; color:#1e293b; }
    </style>
}

<div class="fn-page">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">GOAML — Namizəd əməliyyatı Təsdiqlə</div>
            <div class="fn-page-sub">Oracle namizədindən doldurulub gəldi — qalan sahələri doldurub yadda saxlayın</div>
        </div>
        <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="fn-alert fn-alert--error" style="margin-bottom:16px">@TempData["Error"]</div>
    }

    <form method="post" asp-action="Tesdiq">
        <input type="hidden" asp-for="CandidateFilialNumber" />
        <input type="hidden" name="CandidateDateOper" value="@Model.CandidateDateOper.ToString("yyyy-MM-dd")" />
        <input type="hidden" asp-for="CandidateRecNum" />

        @* ── Namizədin Oracle-dan ARTIQ BİLİNƏN sahələri — SIRF OXUNUŞ üçün,
             formaya göndərilmir (heç bir <input>/name yoxdur), yalnız operatora
             kontekst versin deyə. 06.11.2026-ya qədər bu dəyərlər (Debet/Kredit
             sahibinin adı daxil) `NameUr`/`ToAdi` DTO sahələrinə yazılırdı, amma
             həmin sahələr trimmed formadan çıxarılandan sonra heç bir <input>-ə
             bağlı qalmamışdı — nəticə: artıq bilinən məlumat EKRANDA HEÇ GÖRÜNMƏDƏN
             itirdi. İndi bura açıq göstərilir. ── *@
        <div class="gml-info-strip">
            <div class="gml-info-item"><span class="gml-info-lbl">Tarix</span><span class="gml-info-val">@Model.CandidateDateOper.ToString("dd.MM.yyyy")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Debet</span><span class="gml-info-val">@(Model.Debet ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Debet sahibi</span><span class="gml-info-val">@(Model.NameUr ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Kredit</span><span class="gml-info-val">@(Model.Kredit ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Kredit sahibi</span><span class="gml-info-val">@(Model.ToAdi ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Məbləğ (AZN)</span><span class="gml-info-val">@(Model.SummaVNacval?.ToString("N2") ?? "—")</span></div>
            <div class="gml-info-item"><span class="gml-info-lbl">Qeyd</span><span class="gml-info-val">@(Model.Primechanie ?? "—")</span></div>
        </div>

        @* ── Operatorun HƏQIQƏTƏN doldurduğu sahələr — 06.11.2026, işçinin özündən
             alınmış siyahı. Qalan ~100 sahə (Hüquqi şəxsin bloku, Alan fiziki şəxsin
             tam detalı, Banka aid olmayan... SWIFT/Hesab, Əlavə sahələr) BU FORMADAN
             ÇIXARILIB — amma GoamlEmeliyyat/GoamlTesdiqDto-dan SİLİNMƏYİB. Gələcəkdə
             AYSEL-in "Update New" kaskadının ekvivalenti quruləndə həmin sahələr
             bank reyestrlərindən AVTOMATİK doldurulacaq, operator onları əl ilə
             bir daha doldurmayacaq. ── *@
        <div class="gml-critical">
            <div class="gml-section-title"><i class="bi bi-exclamation-triangle-fill" style="color:#d97706"></i> Təsnifat (məcburi)</div>
            <div class="gml-grid-3">
                <div>
                    <label class="gml-flbl">Tip <span class="gml-req">*</span></label>
                    <select name="Tip" class="fn-select" required>
                        <option value="">— seçin —</option>
                        @foreach (var t in tipSecimler)
                        {
                            <option value="@t.Value" selected="@(Model.Tip.HasValue && (int)Model.Tip.Value == t.Value)">@t.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="gml-flbl">Məlumatın növü <span class="gml-req">*</span></label>
                    <select name="ReportCode" class="fn-select" required>
                        <option value="">— seçin —</option>
                        @foreach (var r in reportSecimler)
                        {
                            <option value="@r.Value" selected="@(Model.ReportCode.HasValue && (int)Model.ReportCode.Value == r.Value)">@r.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="gml-flbl">Əməliyyat tarixi</label>
                    <input type="date" name="DateOper" class="fn-input" value="@Model.DateOper?.ToString("yyyy-MM-dd")" />
                </div>
            </div>
        </div>

        @* ── BLOK 1 — Nümayəndənin (Oracle: _CON) ── *@
        <details class="gml-block" open>
            <summary>Nümayəndənin (əməliyyatı aparan şəxs) <i class="bi bi-chevron-down gml-chevron"></i></summary>
            <div class="gml-block-body">
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Adı</label><input asp-for="ConAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Atasının adı</label><input asp-for="ConAtasininAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Soyadı</label><input asp-for="ConSoyadi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Doğulduğu tarix</label>
                        <input type="date" name="ConDogulduguTarix" class="fn-input" value="@Model.ConDogulduguTarix?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Doğulduğu yer</label><input asp-for="ConDogulduguYer" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vətəndaşlığı</label><input asp-for="ConVetendasligi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Cinsi</label><input asp-for="ConCinsi" class="fn-input" placeholder="M / F" /></div>
                    <div><label class="gml-flbl">PİN</label><input asp-for="ConPin" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon növü</label><input asp-for="ConTelefonNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Rabitə növü</label><input asp-for="ConRabiteNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon nömrəsi</label><input asp-for="ConTelefonNomresi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvanın növü</label><input asp-for="ConUnvaninNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvan</label><input asp-for="ConUnvan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Şəhər</label><input asp-for="ConSeher" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="ConOlke" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin növü</label><input asp-for="ConSenedinNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin seriya/nömrəsi</label><input asp-for="ConSenedinSeriyaNomresi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Sənədin verilmə tarixi</label>
                        <input type="date" name="ConSenedinVerilmeTarixi" class="fn-input" value="@Model.ConSenedinVerilmeTarixi?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="gml-flbl">Sənədin etibarlılıq müddəti</label>
                        <input type="date" name="ConSenedinEtibarliliqMuddeti" class="fn-input" value="@Model.ConSenedinEtibarliliqMuddeti?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Verən orqan</label><input asp-for="ConVerenOrqan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Verildiyi ölkə</label><input asp-for="ConVerildiyiOlke" class="fn-input" /></div>
                </div>
                <div class="gml-section-title" style="font-size:.86rem;margin-top:18px;margin-bottom:10px">Nümayəndəni səlahiyyətləndirən sənəd</div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Sənəd növü</label><input asp-for="ReprIdType" class="fn-input" /></div>
                    <div><label class="gml-flbl">Seriya</label><input asp-for="ReprIdSerial" class="fn-input" /></div>
                    <div><label class="gml-flbl">Nömrə</label><input asp-for="ReprIdNumber" class="fn-input" /></div>
                </div>
            </div>
        </details>

        @* ── BLOK 2 — Hesab imza hüququ olan şəxsin (Oracle: _SIG) ── *@
        <details class="gml-block">
            <summary>Hesab imza hüququ olan şəxsin <i class="bi bi-chevron-down gml-chevron"></i></summary>
            <div class="gml-block-body">
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">Adı</label><input asp-for="SigAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Atasının adı</label><input asp-for="SigAtasininAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Soyadı</label><input asp-for="SigSoyadi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Doğulduğu tarix</label>
                        <input type="date" name="SigDogulduguTarix" class="fn-input" value="@Model.SigDogulduguTarix?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Doğulduğu yer</label><input asp-for="SigDogulduguYer" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vətəndaşlığı</label><input asp-for="SigVetendasligi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Vəzifə</label><input asp-for="SigVezife" class="fn-input" /></div>
                    <div><label class="gml-flbl">İş yerinin adı</label><input asp-for="SigIsYeriAdi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon növü</label><input asp-for="SigTelefonNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Rabitə növü</label><input asp-for="SigRabiteNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Telefon nömrəsi</label><input asp-for="SigTelefonNomresi" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvanın növü</label><input asp-for="SigUnvaninNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ünvan</label><input asp-for="SigUnvan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Şəhər</label><input asp-for="SigSeher" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="SigOlke" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin növü</label><input asp-for="SigSenedinNovu" class="fn-input" /></div>
                    <div><label class="gml-flbl">Sənədin seriya/nömrəsi</label><input asp-for="SigSenedinSeriyaNomresi" class="fn-input" /></div>
                    <div>
                        <label class="gml-flbl">Sənədin verilmə tarixi</label>
                        <input type="date" name="SigSenedinVerilmeTarixi" class="fn-input" value="@Model.SigSenedinVerilmeTarixi?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <label class="gml-flbl">Sənədin etibarlılıq müddəti</label>
                        <input type="date" name="SigSenedinEtibarliliqMuddeti" class="fn-input" value="@Model.SigSenedinEtibarliliqMuddeti?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div><label class="gml-flbl">Verən orqan</label><input asp-for="SigVerenOrqan" class="fn-input" /></div>
                    <div><label class="gml-flbl">Verildiyi ölkə</label><input asp-for="SigVerildiyiOlke" class="fn-input" /></div>
                </div>
            </div>
        </details>

        @* ── BLOK 3 — Banka aid olmayan müştəri (fiziki/hüquqi/sahibkar) — Blok 4+5-in
             sadələşdirilmiş birləşməsi. Checkbox + VÖEN/Ölkə/ADI/Bankın adı — işçinin
             dediyinə görə YALNIZ bunlar işlənir; qalan (Alan fiziki şəxsin tam detalı,
             SWIFT/Hesab/Əlaqə növü) formadan çıxarılıb, entity-də qalır. ── *@
        <details class="gml-block">
            <summary>Banka aid olmayan müştəri <i class="bi bi-chevron-down gml-chevron"></i></summary>
            <div class="gml-block-body">
                <div class="gml-checks" style="margin-bottom:16px">
                    <label><input type="checkbox" name="ToFizik" value="true" checked="@(Model.ToFizik == true)" /> Fizik</label>
                    <label><input type="checkbox" name="ToPred" value="true" checked="@(Model.ToPred == true)" /> Sahibkar</label>
                    <label><input type="checkbox" name="ToYurik" value="true" checked="@(Model.ToYurik == true)" /> Hüquqi</label>
                </div>
                <div class="gml-grid-3">
                    <div><label class="gml-flbl">VÖEN</label><input asp-for="IncorporationNumberTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Ölkə</label><input asp-for="IncorporationCountryCodeTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Adı</label><input asp-for="NameUrTo" class="fn-input" /></div>
                    <div><label class="gml-flbl">Bankın adı</label><input asp-for="InstitutionNameTo" class="fn-input" /></div>
                </div>
            </div>
        </details>

        <div style="display:flex;gap:10px;margin-top:18px">
            <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-check-circle"></i> Təsdiqlə və Saxla</button>
            <a asp-action="Index" class="fn-btn fn-btn--outline">Ləğv et</a>
        </div>
    </form>
</div>
