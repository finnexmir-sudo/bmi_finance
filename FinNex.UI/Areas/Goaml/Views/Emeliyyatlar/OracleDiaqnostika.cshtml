@model FinNex.Application.DTOs.Goaml.GoamlOracleDiaqnostikaDto
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "GOAML — Oracle Diaqnostikası";
}

@section Styles {
    <style>
        .gml-sub { font-size:.76rem; color:#94a3b8; }
        .gml-diag-row { display:flex; justify-content:space-between; gap:16px; padding:10px 0; border-bottom:1px solid #e2e8f0; font-size:.88rem; }
        .gml-diag-row:last-child { border-bottom:none; }
        .gml-diag-k { color:#64748b; font-weight:600; min-width:220px; }
        .gml-diag-v { font-family:ui-monospace,Consolas,monospace; font-weight:700; color:#0f172a; text-align:right; word-break:break-all; }
        .gml-diag-v.gml-diag-null { color:#dc2626; font-weight:600; }
        .gml-warn { margin-top:16px; padding:12px 16px; border-radius:10px; background:#fffbeb; border:1px solid #fde68a; color:#92400e; font-size:.82rem; line-height:1.55; }
        .gml-copy { margin-top:16px; padding:12px 16px; border-radius:10px; background:#f8fafc; border:1px solid #e2e8f0; font-size:.8rem; color:#334155; }
        .gml-copy code { display:block; background:#0f172a; color:#e2e8f0; padding:8px 10px; border-radius:6px; margin-top:6px; font-size:.78rem; white-space:pre-wrap; }
    </style>
}

<div class="fn-page">
    <div class="gml-sub">
        Müvəqqəti diaqnostika (13.11.2026) — "BLR" üçün <code>malumatin_novu</code> sorğusu
        tətbiqdən sükutla 0 sətir qaytarır, istifadəçinin öz PL/SQL Developer sessiyasında
        isə 8/4 verir. Aşağıdakı dəyərləri öz PL/SQL Developer-inizdəki eyni sorğularla
        (kod qutusunda) tutuşdurun — fərq çıxarsa, tətbiq FƏRQLİ bir Oracle nüsxəsinə/sxeminə
        bağlanır deməkdir.
    </div>

    <div class="fn-card" style="padding:20px; margin-top:16px">
        <div class="gml-diag-row">
            <div class="gml-diag-k">global_name (select global_name from global_name)</div>
            <div class="gml-diag-v @(Model.GlobalName == null ? "gml-diag-null" : "")">@(Model.GlobalName ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">db_name (sys_context userenv/db_name)</div>
            <div class="gml-diag-v @(Model.DbName == null ? "gml-diag-null" : "")">@(Model.DbName ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">host (sys_context userenv/host)</div>
            <div class="gml-diag-v @(Model.DbHost == null ? "gml-diag-null" : "")">@(Model.DbHost ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">instance_name</div>
            <div class="gml-diag-v @(Model.InstanceName == null ? "gml-diag-null" : "")">@(Model.InstanceName ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">user (select user from dual) — gözlənilən: FOXPRO</div>
            <div class="gml-diag-v @(Model.OracleUser == null ? "gml-diag-null" : "")">@(Model.OracleUser ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">odb.malumatin_novu — ÜMUMİ sətir sayı</div>
            <div class="gml-diag-v @(Model.MalumatinNovuUmumiSay == null ? "gml-diag-null" : "")">@(Model.MalumatinNovuUmumiSay?.ToString() ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">odb.malumatin_novu — isare='BLR' sətir sayı</div>
            <div class="gml-diag-v @(Model.MalumatinNovuBlrSay == null ? "gml-diag-null" : "")">@(Model.MalumatinNovuBlrSay?.ToString() ?? "XƏTA")</div>
        </div>
        <div class="gml-diag-row">
            <div class="gml-diag-k">isare='BLR' → reportType/reportReason</div>
            <div class="gml-diag-v @(Model.BlrReportTypeVeReason == null ? "gml-diag-null" : "")">@(Model.BlrReportTypeVeReason ?? "XƏTA")</div>
        </div>
    </div>

    @if (Model.Xetalar.Count > 0)
    {
        <div class="gml-warn">
            <strong><i class="bi bi-exclamation-triangle-fill"></i> Bəzi sorğular uğursuz oldu:</strong>
            <ul style="margin:6px 0 0 18px">
                @foreach (var x in Model.Xetalar)
                {
                    <li>@x</li>
                }
            </ul>
        </div>
    }

    <div class="gml-copy">
        Öz PL/SQL Developer-inizdə (şəxsi sessiyanızda) BU sorğuları işlədib yuxarıdakı
        dəyərlərlə tutuşdurun:
        <code>select global_name from global_name;
select sys_context('userenv','db_name') from dual;
select sys_context('userenv','host') from dual;
select sys_context('userenv','instance_name') from dual;
select user from dual;
select count(*) from odb.malumatin_novu;
select count(*) from odb.malumatin_novu where isare = 'BLR';</code>
    </div>

    <div style="margin-top:16px">
        <a asp-action="Export" class="fn-btn fn-btn--secondary"><i class="bi bi-arrow-left"></i> Export-a qayıt</a>
    </div>
</div>
