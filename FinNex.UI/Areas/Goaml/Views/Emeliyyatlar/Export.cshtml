@model FinNex.Application.DTOs.Goaml.GoamlJsonIxracFiltrDto
@using FinNex.Domain.Entities.Goaml
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "GOAML — Export to file (JSON)";
}

@section Styles {
    <style>
        .gml-sub { font-size:.76rem; color:#94a3b8; }
        .gml-fld { display:flex; flex-direction:column; gap:5px; }
        .gml-filter-lbl { display:block; font-size:.76rem; font-weight:600; color:#6b7280; margin-bottom:5px; }
        .gml-bar { display:flex; flex-wrap:wrap; align-items:end; gap:12px; }
        .gml-warn { margin-top:16px; padding:12px 16px; border-radius:10px; background:#fffbeb; border:1px solid #fde68a; color:#92400e; font-size:.82rem; line-height:1.55; }
        .gml-warn ul { margin:6px 0 0 18px; }
    </style>
}

<div class="fn-page">
    <div class="gml-sub">
        Seçilmiş aralıqda "Qaralama" (hələ ixrac olunmamış) TƏSDİQLƏNMİŞ qeydləri
        goAML-in rəsmi JSON sxeminə çevirib faylı endirir. İxrac olunan qeydlər
        "İxrac edilib" statusuna keçir — növbəti ixrac onları TƏKRAR GÖTÜRMƏYƏCƏK.
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="gml-warn" style="margin-top:14px">@TempData["Error"]</div>
    }

    <div class="fn-card" style="padding:20px; margin-top:16px">
        <form asp-action="Export" method="post">
            @Html.AntiForgeryToken()
            <div class="gml-bar">
                <div class="gml-fld">
                    <label class="gml-filter-lbl">Tarixdən</label>
                    <input type="date" asp-for="BasTarix" class="fn-input" style="width:150px" required />
                </div>
                <div class="gml-fld">
                    <label class="gml-filter-lbl">Tarixə qədər</label>
                    <input type="date" asp-for="SonTarix" class="fn-input" style="width:150px" required />
                </div>
                <div class="gml-fld">
                    <label class="gml-filter-lbl">Tip (istəyə bağlı)</label>
                    <select asp-for="Tip" class="fn-input" style="width:220px">
                        <option value="">— Hamısı —</option>
                        @foreach (GoamlTipi t in Enum.GetValues(typeof(GoamlTipi)))
                        {
                            <option value="@((int)t)">@t.Etiket()</option>
                        }
                    </select>
                </div>
                <div class="gml-fld">
                    <label class="gml-filter-lbl">Məlumatın növü (istəyə bağlı)</label>
                    <select asp-for="ReportCode" class="fn-input" style="width:220px">
                        <option value="">— Hamısı —</option>
                        @foreach (GoamlHesabatNovu r in Enum.GetValues(typeof(GoamlHesabatNovu)))
                        {
                            <option value="@((int)r)">@r.Kod() — @r.Aciqlama()</option>
                        }
                    </select>
                </div>
                <div class="gml-fld">
                    <button type="submit" class="fn-btn fn-btn--primary">İxrac et (JSON)</button>
                </div>
            </div>
        </form>
    </div>

    <div class="gml-warn">
        <strong>Diqqət — bu, MVP (ilk artım) ixracıdır, hamısı port edilməyib:</strong>
        <ul>
            <li>"<code>dubl_number</code>" sahələri (hüquqi şəxsin VÖEN üzrə ikinci qeydiyyat nömrəsi) boş qalır.</li>
            <li>QHT/PEP/BLR hesabat növlərinin header-ə əlavə etdiyi sahələr (tin, hrzCountry, customerRiskDegree və s.) YOXDUR — header yalnız sendDate/reportType/reportReason daşıyır.</li>
            <li>trn_payment_system-in dəqiq (UTF/XKS/SWF/AZP/AOS) təyini YOXDUR — yalnız document_source-əsaslı CBB/IAP/PST, defolt CBB.</li>
            <li>Bizim öz bankımızın hesabına aid bank-adı/VÖEN zənginləşdirilməsi (V_YURIK__NAME/ATTRIB/C_INN_BANK) YOXDUR.</li>
            <li><strong>Hazırlanan JSON-u real goAML portalına göndərmədən ƏVVƏL əl ilə yoxlayın.</strong></li>
        </ul>
    </div>
</div>
