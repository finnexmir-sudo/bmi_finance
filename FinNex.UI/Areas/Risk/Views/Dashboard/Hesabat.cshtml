@model RiskNeticeDto
@{
    ViewData["Title"] = Model.Ad;
    var hesabatlar = ViewBag.Hesabatlar as IList<RiskHesabatDto> ?? new List<RiskHesabatDto>();
    string Fmt(object? v)
    {
        if (v is null) return "";
        if (v is DateTime dt) return dt.ToString("dd.MM.yyyy");
        if (v is decimal dec) return dec.ToString("#,0.##");
        if (v is double dbl) return dbl.ToString("#,0.##");
        return v.ToString() ?? "";
    }
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.Ad</div>
            <div class="fn-page-sub">@(string.IsNullOrWhiteSpace(Model.Mahiyyet) ? "Risk hesabatı" : Model.Mahiyyet) — @Model.Say sətir</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a asp-action="Excel" asp-route-id="@Model.Id" class="fn-btn fn-btn--outline"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @if (hesabatlar.Count > 1)
    {
        <div class="rk-tabs">
            @foreach (var h in hesabatlar)
            {
                <a asp-action="Hesabat" asp-route-id="@h.Id" class="rk-tab @(h.Id == Model.Id ? "active" : "")">@h.Ad</a>
            }
        </div>
    }

    <div class="fn-card">
        <div class="rk-toolbar">
            <div class="rk-search">
                <i class="bi bi-search"></i>
                <input type="text" id="rkSearch" placeholder="Cədvəldə axtar..." autocomplete="off" />
            </div>
            <div class="rk-hint">Cəmi: @Model.Say sətir</div>
        </div>

        @if (Model.Netice.Sutunlar.Count == 0 || Model.Say == 0)
        {
            <div class="rk-empty2"><i class="bi bi-inbox"></i> Nəticə boşdur.</div>
        }
        else
        {
            <div class="rk-twrap">
                <table class="rk-table" id="rkTable">
                    <thead>
                        <tr>
                            <th class="rk-no">#</th>
                            @foreach (var s in Model.Netice.Sutunlar)
                            {
                                <th>@s</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var no = 0; }
                        @foreach (var row in Model.Netice.Setirler)
                        {
                            no++;
                            <tr class="rk-row" data-search="@(string.Join(" ", row.Select(Fmt)).ToLower())">
                                <td class="rk-no">@no</td>
                                @foreach (var cell in row)
                                {
                                    <td>@Fmt(cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .rk-tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
        .rk-tab { padding:7px 13px; border:1px solid #e2e8f0; border-radius:9px; background:#fff; color:#475569;
            font-size:12.5px; font-weight:600; text-decoration:none; }
        .rk-tab:hover { border-color:#fecaca; color:#dc2626; }
        .rk-tab.active { background:#fef2f2; border-color:#fecaca; color:#dc2626; }
        .rk-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .rk-search { position:relative; max-width:360px; flex:1; }
        .rk-search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .rk-search input { width:100%; padding:9px 12px 9px 34px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; outline:none; background:#fbfcff; }
        .rk-search input:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.12); }
        .rk-hint { font-size:12px; color:#64748b; }
        .rk-twrap { overflow-x:auto; }
        .rk-table { width:100%; border-collapse:collapse; font-size:13px; white-space:nowrap; }
        .rk-table thead th { position:sticky; top:0; background:#f1f5f9; color:#475569; font-weight:600; font-size:12px;
            text-align:left; padding:9px 12px; border-bottom:1px solid #e2e8f0; }
        .rk-table td { padding:8px 12px; border-bottom:1px solid #f1f5f9; color:#1e293b; }
        .rk-table tbody tr:hover td { background:#fef2f2; }
        .rk-no { color:#94a3b8; text-align:right; font-variant-numeric:tabular-nums; }
        .rk-empty2 { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('rkSearch');
            if (!inp) return;
            var rows = Array.prototype.slice.call(document.querySelectorAll('#rkTable .rk-row'));
            inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                rows.forEach(function (r) {
                    var hay = r.getAttribute('data-search') || '';
                    r.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
        })();
    </script>
}
