@model RiskNeticeDto
@{
    ViewData["Title"] = Model.Ad;
    var hesabatlar = ViewBag.Hesabatlar as IList<RiskHesabatDto> ?? new List<RiskHesabatDto>();
    var p = Model.Parametrler;
    var d = Model.Deyerler;
    // İl/kod kimi 1900–2100 aralığındakı tam ədədləri minlik ayırıcısız göstər
    // (2007 → "2007", "2.007" yox). Real məbləğlər (>2100) ayırıcı ilə qalır.
    bool IldirMi(decimal d) => d == Math.Truncate(d) && d >= 1900 && d <= 2100;
    string Fmt(object? v)
    {
        if (v is null) return "";
        if (v is DateTime dt) return dt.ToString("dd.MM.yyyy");
        if (v is decimal dec)
            return IldirMi(dec) ? ((long)dec).ToString(System.Globalization.CultureInfo.InvariantCulture)
                                : dec.ToString("#,0.##");
        if (v is double dbl)
            return IldirMi((decimal)dbl) ? ((long)dbl).ToString(System.Globalization.CultureInfo.InvariantCulture)
                                         : dbl.ToString("#,0.##");
        return v.ToString() ?? "";
    }
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@Model.Ad</div>
            <div class="fn-page-sub">@(string.IsNullOrWhiteSpace(Model.Mahiyyet) ? "Risk hesabatı" : Model.Mahiyyet)@(Model.IcraOlundu ? $" — {Model.Say} sətir" : "")</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            @if (Model.IcraOlundu)
            {
                <a asp-action="Excel" asp-route-id="@Model.Id" asp-route-bt="@d.BasTarix" asp-route-st="@d.SonTarix" asp-route-t="@d.Tarix" asp-route-h="@d.Hedd" asp-route-il="@d.Il" class="fn-btn fn-btn--outline"><i class="bi bi-file-earmark-excel"></i> Excel</a>
            }
            <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @if (hesabatlar.Count > 1)
    {
        <div class="rk-tabs">
            @foreach (var h in hesabatlar)
            {
                <a asp-action="Hesabat" asp-route-id="@h.Id" class="rk-tab @(h.Id == Model.Id ? "active" : "")">@h.Ad</a>
            }
        </div>
    }

    @* Necə işləyir — işçi üçün izah *@
    @if (!string.IsNullOrWhiteSpace(Model.Mahiyyet) || p.VarMi)
    {
        <div class="rk-note">
            <i class="bi bi-info-circle-fill"></i>
            <div class="rk-note-b">
                <div class="rk-note-h">Necə işləyir</div>
                @if (!string.IsNullOrWhiteSpace(Model.Mahiyyet))
                {
                    <div class="rk-note-t">@Model.Mahiyyet</div>
                }
                @if (p.VarMi)
                {
                    <ul class="rk-note-l">
                        @if (p.BasTarix) { <li><b>Başlanğıc tarix</b> — hesablama bu tarixdən başlayır.</li> }
                        @if (p.SonTarix) { <li><b>Son tarix</b> — bu tarixə <b>qədər</b> olanlar (məs. bu tarixə qədər ödəmə vaxtı çatan kreditlər).</li> }
                        @if (p.Tarix)    { <li><b>Tarix</b> — hesablama bu tarixə görə aparılır (adətən bugün).</li> }
                        @if (p.Hedd)     { <li><b>Hədd</b> — yalnız bu məbləğdən (manatla) <b>böyük</b> olanlar göstərilir.</li> }
                        @if (p.Il)       { <li><b>İl</b> — yalnız seçilmiş il üzrə.</li> }
                    </ul>
                    <div class="rk-note-f">Xanaları doldurub <b>İşlət</b> düyməsinə basın.</div>
                }
            </div>
        </div>
    }

    @if (p.VarMi)
    {
        <div class="fn-card rk-param">
            <form asp-action="Hesabat" method="get" class="rk-pform">
                <input type="hidden" name="id" value="@Model.Id" />
                @if (p.BasTarix)
                {
                    <div><label>Başlanğıc tarix</label><input type="date" name="bt" value="@d.BasTarix" required /></div>
                }
                @if (p.SonTarix)
                {
                    <div><label>Son tarix</label><input type="date" name="st" value="@d.SonTarix" required /></div>
                }
                @if (p.Tarix)
                {
                    <div><label>Tarix</label><input type="date" name="t" value="@d.Tarix" required /></div>
                }
                @if (p.Hedd)
                {
                    <div><label>Hədd (məbləğ)</label><input type="number" step="0.01" name="h" value="@d.Hedd" placeholder="məs. 20000" required /></div>
                }
                @if (p.Il)
                {
                    <div><label>İl</label><input type="number" name="il" value="@d.Il" placeholder="məs. 2026" required /></div>
                }
                <div class="rk-pbtn"><button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-play-fill"></i> İşlət</button></div>
            </form>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.Xeta))
    {
        <div class="rk-alert rk-alert--err"><i class="bi bi-x-octagon"></i> Sorğu xətası: @Model.Xeta</div>
    }

    @if (!Model.IcraOlundu && p.VarMi && string.IsNullOrEmpty(Model.Xeta))
    {
        <div class="fn-card"><div class="rk-empty2"><i class="bi bi-sliders"></i> Parametrləri doldurub <b>İşlət</b> düyməsinə klikləyin.</div></div>
    }
    else if (Model.IcraOlundu)
    {
        <div class="fn-card">
            <div class="rk-toolbar">
                <div class="rk-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="rkSearch" placeholder="Cədvəldə axtar..." autocomplete="off" />
                </div>
                <div class="rk-hint">Cəmi: @Model.Say sətir@(Model.DrillVar ? " · sətrə klik → detal" : "")</div>
            </div>

            @if (Model.Netice.Sutunlar.Count == 0 || Model.Say == 0)
            {
                <div class="rk-empty2"><i class="bi bi-inbox"></i> Nəticə boşdur.</div>
            }
            else
            {
                <div class="rk-twrap">
                    <table class="rk-table" id="rkTable">
                        <thead>
                            <tr>
                                <th class="rk-no">#</th>
                                @foreach (var s in Model.Netice.Sutunlar)
                                {
                                    <th>@s</th>
                                }
                                @if (Model.DrillVar)
                                {
                                    <th class="rk-drill"></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ var no = 0; }
                            @foreach (var row in Model.Netice.Setirler)
                            {
                                no++;
                                string? drillUrl = null;
                                if (Model.DrillVar && Model.DrillSutun >= 0 && Model.DrillSutun < row.Length)
                                {
                                    var dv = Fmt(row[Model.DrillSutun]);
                                    if (!string.IsNullOrWhiteSpace(dv))
                                    {
                                        var rv = new Microsoft.AspNetCore.Routing.RouteValueDictionary { { "id", Model.DrillId } };
                                        rv[Model.DrillParam!] = dv;
                                        drillUrl = Url.Action("Hesabat", rv);
                                    }
                                }
                                <tr class="rk-row @(drillUrl != null ? "rk-clic" : "")" data-href="@drillUrl" data-search="@(string.Join(" ", row.Select(Fmt)).ToLower())">
                                    <td class="rk-no">@no</td>
                                    @foreach (var cell in row)
                                    {
                                        <td>@Fmt(cell)</td>
                                    }
                                    @if (Model.DrillVar)
                                    {
                                        <td class="rk-drill">@(drillUrl != null ? Html.Raw("<i class=\"bi bi-box-arrow-up-right\"></i>") : null)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .rk-tabs { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
        .rk-tab { padding:7px 13px; border:1px solid #e2e8f0; border-radius:9px; background:#fff; color:#475569;
            font-size:12.5px; font-weight:600; text-decoration:none; }
        .rk-tab:hover { border-color:#fecaca; color:#dc2626; }
        .rk-tab.active { background:#fef2f2; border-color:#fecaca; color:#dc2626; }
        .rk-note { display:flex; gap:11px; background:#eff6ff; border:1px solid #dbeafe; border-radius:12px;
            padding:13px 16px; margin-bottom:14px; }
        .rk-note > i { color:#2563eb; font-size:17px; margin-top:1px; flex-shrink:0; }
        .rk-note-b { font-size:13px; color:#1e293b; line-height:1.55; }
        .rk-note-h { font-weight:700; color:#1d4ed8; margin-bottom:3px; }
        .rk-note-t { color:#334155; }
        .rk-note-l { margin:6px 0 0; padding-left:18px; }
        .rk-note-l li { margin-bottom:2px; }
        .rk-note-l b, .rk-note-t b, .rk-note-f b { color:#0f172a; }
        .rk-note-f { margin-top:6px; color:#475569; }
        .rk-param { margin-bottom:16px; }
        .rk-pform { display:flex; gap:14px; align-items:flex-end; flex-wrap:wrap; }
        .rk-pform label { display:block; font-size:11px; color:#64748b; font-weight:600; margin-bottom:5px; }
        .rk-pform input { padding:9px 12px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; outline:none; background:#fbfcff; }
        .rk-pform input:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.12); }
        .rk-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .rk-search { position:relative; max-width:360px; flex:1; }
        .rk-search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .rk-search input { width:100%; padding:9px 12px 9px 34px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; outline:none; background:#fbfcff; }
        .rk-search input:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.12); }
        .rk-hint { font-size:12px; color:#64748b; }
        .rk-twrap { overflow-x:auto; }
        .rk-table { width:100%; border-collapse:collapse; font-size:13px; white-space:nowrap; }
        .rk-table thead th { position:sticky; top:0; background:#f1f5f9; color:#475569; font-weight:600; font-size:12px;
            text-align:left; padding:9px 12px; border-bottom:1px solid #e2e8f0; }
        .rk-table td { padding:8px 12px; border-bottom:1px solid #f1f5f9; color:#1e293b; }
        .rk-table tbody tr:hover td { background:#fef2f2; }
        .rk-clic { cursor:pointer; }
        .rk-clic:hover td { background:#eff6ff !important; }
        .rk-drill { color:#94a3b8; text-align:center; width:30px; }
        .rk-clic:hover .rk-drill { color:#2563eb; }
        .rk-no { color:#94a3b8; text-align:right; font-variant-numeric:tabular-nums; }
        .rk-empty2 { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .rk-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .rk-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('rkSearch');
            if (!inp) return;
            var rows = Array.prototype.slice.call(document.querySelectorAll('#rkTable .rk-row'));
            inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                rows.forEach(function (r) {
                    var hay = r.getAttribute('data-search') || '';
                    r.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
        })();

        // Drill-down — sətrə klik → detal hesabat
        (function () {
            document.querySelectorAll('#rkTable tr.rk-clic').forEach(function (r) {
                r.addEventListener('click', function () {
                    var u = r.getAttribute('data-href');
                    if (u) location.href = u;
                });
            });
        })();
    </script>
}
