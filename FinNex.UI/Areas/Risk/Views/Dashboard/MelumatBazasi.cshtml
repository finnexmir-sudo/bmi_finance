@using System.Text.Json
@model AxtarisNeticeDto
@{
    ViewData["Title"] = "Məlumat Bazası — Axtarılanlar";
    var neticeVar = Model.Setirler.Count > 0;
}

@* SƏHİFƏ QABIĞI — `fn-page` (Hesabat.cshtml və Aml/Index.cshtml ilə eyni).
   ƏVVƏL `rk-dash`/`rk-hero` işlədilirdi: o siniflər YALNIZ
   Dashboard/Index.cshtml-in öz `@@section Styles` blokunda təyin olunub,
   ona görə bu səhifədə heç bir stil tutmurdu və səhifə "çılpaq" görünürdü. *@
<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Məlumat Bazası</div>
            <div class="fn-page-sub">
                Axtarılanlar siyahısını (Excel) bank müştəriləri ilə yoxla@(neticeVar ? $" — {Model.UmumiSay} sətir yoxlanıldı" : "")
            </div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            @if (neticeVar)
            {
                <form asp-action="MelumatBazasiExcel" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="neticeJson" value="@JsonSerializer.Serialize(Model)" />
                    <button type="submit" class="fn-btn fn-btn--outline"><i class="bi bi-file-earmark-excel"></i> Excel</button>
                </form>
            }
            <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @* Xəta xülasəsi — sinif QƏSDƏN `fn-alert` DEYİL:
       user-area.js bütün .fn-alert elementlərini 4 saniyəyə silir (CLAUDE.md). *@
    @if (TempData["Error"] != null)
    {
        <div class="mb-msg"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }
    @if (Model.Xeta != null)
    {
        <div class="mb-msg"><i class="bi bi-x-octagon"></i> Sorğu xətası: @Model.Xeta</div>
    }

    @* Necə işləyir — Hesabat.cshtml-dəki izah qutusu ilə eyni görünüş *@
    <div class="mb-note">
        <i class="bi bi-info-circle-fill"></i>
        <div class="mb-note-b">
            <div class="mb-note-h">Necə işləyir</div>
            <div class="mb-note-t">
                Excel siyahısındakı hər sətir bankın müştəri bazası ilə tutuşdurulur —
                <b>ad</b>, <b>VÖEN</b> və <b>FİN</b> üzrə tam uyğunluq axtarılır.
            </div>
            <ul class="mb-note-l">
                <li><b>Sütunlar</b> — <b>A</b> = Ad Soyad Ata adı, <b>B</b> = VÖEN, <b>C</b> = FİN. 1-ci sətir başlıqdır.</li>
                <li><b>Mənbələr</b> — müştəri qeydiyyatı, imza səlahiyyətli şəxslər, nümayəndələr.</li>
                <li><b>Heç nə yazılmır</b> — BMI bazasına yalnız sorğu göndərilir, qeyd dəyişmir.</li>
            </ul>
            <div class="mb-note-f">Faylı seçib <b>Yüklə və yoxla</b> düyməsinə basın.</div>
        </div>
    </div>

    @* Yükləmə forması *@
    <div class="fn-card mb-param">
        <form asp-action="MelumatBazasiYukle" method="post" enctype="multipart/form-data" class="mb-form">
            @Html.AntiForgeryToken()
            <div class="mb-field">
                <label>Excel faylı (.xlsx)</label>
                <input type="file" name="fayl" accept=".xlsx" required class="mb-file" />
            </div>
            <button type="submit" class="fn-btn fn-btn--primary"><i class="bi bi-upload"></i> Yüklə və yoxla</button>
        </form>
    </div>

    @if (neticeVar)
    {
        <div class="mb-stats">
            <div class="mb-stat">
                <div class="mb-stat-val">@Model.UmumiSay</div>
                <div class="mb-stat-lbl">Yoxlanılan sətir</div>
            </div>
            <div class="mb-stat @(Model.TapilanSay > 0 ? "mb-stat--hit" : "")">
                <div class="mb-stat-val">@Model.TapilanSay</div>
                <div class="mb-stat-lbl">Uyğunluq tapıldı</div>
            </div>
        </div>

        <div class="fn-card">
            <div class="mb-twrap">
                <table class="mb-table">
                    <thead>
                        <tr>
                            <th>№</th><th>Ad Soyad Ata adı</th><th>VÖEN</th><th>FİN</th>
                            <th>Status</th><th>Uyğunluq detalı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Setirler)
                        {
                            <tr class="@(s.Tapildi ? "mb-row--hit" : "")">
                                <td>@s.Axtarilan.Sira</td>
                                <td>@s.Axtarilan.AdSoyadAta</td>
                                <td>@s.Axtarilan.Voen</td>
                                <td>@s.Axtarilan.Fin</td>
                                <td>
                                    @if (s.Tapildi)
                                    {
                                        <span class="mb-badge mb-badge--hit"><i class="bi bi-exclamation-triangle-fill"></i> Tapıldı</span>
                                    }
                                    else
                                    {
                                        <span class="mb-badge mb-badge--miss">Tapılmadı</span>
                                    }
                                </td>
                                <td>
                                    @if (s.Tapildi)
                                    {
                                        <ul class="mb-hits">
                                            @foreach (var u in s.Uygunluqlar)
                                            {
                                                <li><b>@u.Menbe</b> — @u.AdSoyad (@u.Regnom) <span class="mb-tag">@u.UygunSahe</span></li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="mb-dash">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        /* Xəta xülasəsi (auto-hide olunan fn-alert ƏVƏZİNƏ) */
        .mb-msg { display:flex; align-items:center; gap:9px; background:#fef2f2; border:1px solid #fecaca;
            border-radius:10px; padding:11px 16px; font-size:13px; color:#b91c1c; margin-bottom:14px; }

        /* İzah qutusu — Hesabat.cshtml-dəki `rk-note` ilə eyni ölçülər */
        .mb-note { display:flex; gap:11px; background:#eff6ff; border:1px solid #dbeafe; border-radius:12px;
            padding:13px 16px; margin-bottom:14px; }
        .mb-note > i { color:#2563eb; font-size:17px; margin-top:1px; flex-shrink:0; }
        .mb-note-b { font-size:13px; color:#1e293b; line-height:1.55; }
        .mb-note-h { font-weight:700; color:#1d4ed8; margin-bottom:3px; }
        .mb-note-t { color:#334155; }
        .mb-note-l { margin:6px 0 0; padding-left:18px; }
        .mb-note-l li { margin-bottom:2px; }
        .mb-note-l b, .mb-note-t b, .mb-note-f b { color:#0f172a; }
        .mb-note-f { margin-top:6px; color:#475569; }

        /* Yükləmə forması — `rk-pform` ilə eyni ritm */
        .mb-param { margin-bottom:16px; }
        .mb-form { display:flex; gap:14px; align-items:flex-end; flex-wrap:wrap; }
        .mb-field { flex:1; min-width:260px; }
        .mb-field label { display:block; font-size:11px; color:#64748b; font-weight:600; margin-bottom:5px; }
        .mb-file { display:block; width:100%; padding:9px 12px; border:1.5px dashed #cbd5e1;
            border-radius:10px; font-size:13px; background:#fbfcff; outline:none; }
        .mb-file:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.12); }

        /* Nəticə xülasəsi */
        .mb-stats { display:flex; gap:11px; flex-wrap:wrap; margin-bottom:14px; }
        .mb-stat { background:#fff; border:1px solid #eef2f7; border-radius:12px; padding:11px 18px; min-width:150px; }
        .mb-stat-val { font-size:22px; font-weight:800; color:#0f172a; line-height:1; letter-spacing:-.5px; }
        .mb-stat-lbl { font-size:12px; color:#64748b; font-weight:600; margin-top:5px; }
        .mb-stat--hit { background:#fef2f2; border-color:#fecaca; }
        .mb-stat--hit .mb-stat-val { color:#b91c1c; }

        /* Cədvəl — `rk-table` ilə eyni */
        .mb-twrap { overflow-x:auto; }
        .mb-table { width:100%; border-collapse:collapse; font-size:13px; }
        .mb-table thead th { background:#f1f5f9; color:#475569; font-weight:600; font-size:12px; text-align:left;
            padding:9px 12px; border-bottom:1px solid #e2e8f0; white-space:nowrap; }
        .mb-table td { padding:9px 12px; border-bottom:1px solid #f1f5f9; color:#1e293b; vertical-align:top; }
        .mb-row--hit { background:#fef2f2; }
        .mb-badge { display:inline-flex; align-items:center; gap:5px; padding:3px 10px; border-radius:999px;
            font-size:11.5px; font-weight:700; white-space:nowrap; }
        .mb-badge--hit { background:#fee2e2; color:#b91c1c; }
        .mb-badge--miss { background:#f1f5f9; color:#94a3b8; }
        .mb-hits { margin:0; padding-left:16px; }
        .mb-hits li { margin-bottom:3px; }
        .mb-tag { display:inline-block; margin-left:5px; padding:1px 7px; border-radius:6px;
            background:#fef3c7; color:#92400e; font-size:10.5px; font-weight:700; }
        .mb-dash { color:#94a3b8; }
    </style>
}
