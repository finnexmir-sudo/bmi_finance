@using FinNex.Application.DTOs.Aml
@using FinNex.Application.DTOs.Risk
@model MelumatBazasiNeticeDto
@{
    ViewData["Title"] = "Məlumat Bazası";
    var vereqler = ViewBag.Vereqler as IReadOnlyList<MelumatBazasiVereqDto> ?? new List<MelumatBazasiVereqDto>();
    var siyahi   = ViewBag.Siyahi   as List<AxtarisSetriDto>;
    var siyahiVar = siyahi != null && siyahi.Count > 0;
    var dovrlu   = vereqler.Count(v => v.Dovrlu);
    var novVar   = siyahiVar && siyahi!.Any(s => !string.IsNullOrWhiteSpace(s.Novu));
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Məlumat Bazası</div>
            <div class="fn-page-sub">Exceldəki şəxslər BMI-nin @vereqler.Count mənbəyində axtarılır</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            @* İki səhifə BİR İŞİN addımlarıdır — keçid hər ikisində olmalıdır.
               22.09.2026: Excel səhifəsinin adı dəyişdi («Məlumat Bazası» →
               «Axtarılanlar») və istifadəçi onu tapa bilmədi. *@
            <a asp-action="Axtarilanlar" class="fn-btn fn-btn--outline">
                <i class="bi bi-search"></i> Axtarılanlar (tək siyahı)
            </a>
            <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-left"></i> Geri</a>
        </div>
    </div>

    @* Xəta xülasəsi — sinif QƏSDƏN `fn-alert` DEYİL:
       user-area.js bütün .fn-alert elementlərini 4 saniyəyə silir (CLAUDE.md). *@
    @if (TempData["Error"] != null)
    {
        <div class="mb-msg"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="mb-note">
        <i class="bi bi-info-circle-fill"></i>
        <div class="mb-note-b">
            <div class="mb-note-h">Necə işləyir</div>
            <div class="mb-note-t">
                <b>1.</b> Axtarılacaq şəxslərin Excel faylı yüklənir və cədvəldə göstərilir.
                <b>2.</b> Dövr seçilir və <b>Ümumi sorğu</b> basılır — BMI-də @vereqler.Count sorğu
                icra olunur və nəticə <b>@(vereqler.Count + 1) vərəqli Excel</b> kimi endirilir
                (@vereqler.Count mənbə + <code>Esas_Sehife</code> xülasəsi).
            </div>
            <ul class="mb-note-l">
                <li><b>@dovrlu mənbə</b> seçilmiş dövrə görə süzülür.</li>
                <li><b>@(vereqler.Count - dovrlu) mənbə dövrsüzdür</b> — təsisçilər, əlaqəli şəxslər,
                    kredit zaminləri, aktiv hesablar. Onlar həmişə <b>cari vəziyyəti</b> verir
                    (BMI-də də belədir, qəsdəndir).</li>
                <li><b>Heç nə yazılmır</b> — BMI bazasına yalnız SELECT göndərilir.</li>
            </ul>
        </div>
    </div>

    @* ── 1-ci ADDIM: fayl yükləmə ───────────────────────────────────────── *@
    <div class="mb-sec"><span class="mb-sec-bar"></span> 1. Axtarılacaq şəxslər</div>
    <div class="fn-card mb-param">
        <form asp-action="MelumatBazasiYukle" method="post" enctype="multipart/form-data" class="mb-form">
            @Html.AntiForgeryToken()
            <div class="mb-field">
                <label>Excel faylı (.xlsx)</label>
                <input type="file" name="fayl" accept=".xlsx" required class="mb-file" />
            </div>
            <button type="submit" class="fn-btn fn-btn--primary">
                <i class="bi bi-upload"></i> Yüklə və göstər
            </button>
            <span class="mb-hint">
                Sütunlar: <code>Adlar</code>, <code>FİN/VOEN</code> (bir sütunda — sistem özü ayırd
                edir, ayrı <code>VOEN</code> + <code>fin</code> sütunları da qəbul olunur),
                <code>novu</code> — sıra sərbəstdir, başlıq adına görə tanınır.
            </span>
        </form>
    </div>

    @if (siyahiVar)
    {
        <div class="mb-sec">
            <span class="mb-sec-bar"></span> Yüklənən siyahı — @siyahi!.Count sətir
        </div>
        <div class="fn-card">
            @if (ViewBag.Menbe != null)
            {
                <div class="mb-diag"><i class="bi bi-file-earmark-spreadsheet"></i> @ViewBag.Menbe</div>
            }
            <div class="mb-twrap mb-twrap--scroll">
                <table class="mb-table">
                    <thead>
                        <tr>
                            <th>#</th><th>Ad Soyad Ata adı</th><th>VÖEN/FİN</th>
                            @if (novVar)
                            {
                                <th>Növü</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in siyahi!)
                        {
                            <tr>
                                <td>@s.Sira</td>
                                <td>@s.AdSoyadAta</td>
                                @* Excel-də mənbə TƏK sütundur (VÖEN/FİN) — sistem daxildə formatına görə
                                   ayırd edir (SinifleFinVoen), amma ekranda İKİ sütun kimi göstərmək
                                   istifadəçini çaşdırırdı (25.09.2026). Hansı doluysa onu göstər. *@
                                <td>@(string.IsNullOrWhiteSpace(s.Voen) ? s.Fin : s.Voen)</td>
                                @if (novVar)
                                {
                                    <td>@s.Novu</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ── 2-ci ADDIM: dövr + rejim + sorğu ───────────────────────────── *@
        <div class="mb-sec"><span class="mb-sec-bar"></span> 2. Dövr və axtarış rejimi</div>
        <div class="fn-card mb-param">
            <form asp-action="MelumatBazasiPaket" method="post" id="mbForm">
                @Html.AntiForgeryToken()
                @* Siyahı gizli sahədə daşınır — fayl input-u yenidən doldurula bilmir,
                   TempData isə bu həcmi saxlamır (CLAUDE.md). *@
                <input type="hidden" name="setirlerJson" value="@ViewBag.SiyahiJson" />

                <div class="mb-form">
                    <div class="mb-field">
                        <label>Dövr əvvəl</label>
                        <input type="date" name="basTarix" required class="mb-date"
                               value="@Model.BasTarix.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-field">
                        <label>Dövr son</label>
                        <input type="date" name="sonTarix" required class="mb-date"
                               value="@Model.SonTarix.ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" class="fn-btn fn-btn--primary" id="mbBtn">
                        <i class="bi bi-search"></i> Ümumi sorğu
                    </button>
                    <span class="mb-hint" id="mbHint">Paket böyükdür — bir neçə dəqiqə çəkə bilər.</span>
                </div>

                <div class="mb-rejim">
                    @* `<select>` MƏCBURİDİR (radio YOX) — radio qrupunda heç biri işarələnməsə
                       POST-da sahə ÜMUMİYYƏTLƏ getmir, `<select>`-də isə həmişə seçili dəyər var,
                       səssiz itki riski yoxdur (CLAUDE.md). *@
                    <label class="mb-check" style="gap:8px;">
                        <span>Axtarış rejimi:</span>
                        <select name="rejim" class="mb-date" style="width:auto;">
                            <option value="HerIkisi" selected>Ad + FİN/VÖEN (hər ikisi)</option>
                            <option value="Ad">Yalnız Ad</option>
                            <option value="FinVoen">Yalnız FİN/VÖEN</option>
                        </select>
                    </label>
                    <div class="mb-rejim-t">
                        <b>FİN hər 11 vərəqdə işləyir.</b> Hesab nömrəsi olan mənbələrdə şəxs
                        <code>regnom</code> üzərindən tapılır — hesabın sahibi kimdirsə, onun
                        FİN/VÖEN-i ilə. <b>VÖEN isə 8 vərəqdədir:</b> <code>Exchange</code>
                        (kassa əməliyyatıdır, yalnız vəsiqə nömrəsi yazılır),
                        <code>Emit_benef</code> və <code>Kred_zamin</code> cədvəllərində VÖEN
                        sütunu ümumiyyətlə yoxdur.
                    </div>
                </div>
            </form>
        </div>
    }

    <div class="mb-sec"><span class="mb-sec-bar"></span> Paketin tərkibi</div>
    <div class="fn-card">
        <div class="mb-twrap">
            <table class="mb-table">
                <thead>
                    <tr><th>#</th><th>Vərəq</th><th>Məzmun</th><th>Dövr</th><th>Sorğu adı</th></tr>
                </thead>
                <tbody>
                    @{ var n = 0; }
                    @foreach (var v in vereqler)
                    {
                        n++;
                        <tr>
                            <td>@n</td>
                            <td><code>@v.Ad</code></td>
                            <td>@v.Baslik</td>
                            <td>
                                @if (v.Dovrlu)
                                {
                                    <span class="mb-badge mb-badge--on">dövrlü</span>
                                }
                                else
                                {
                                    <span class="mb-badge mb-badge--off">dövrsüz</span>
                                }
                            </td>
                            <td class="mb-dim"><code>@v.SorguAdi</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .mb-msg { display:flex; align-items:flex-start; gap:9px; background:#fef2f2; border:1px solid #fecaca;
            border-radius:10px; padding:11px 16px; font-size:13px; color:#b91c1c; margin-bottom:14px; line-height:1.6; }

        .mb-note { display:flex; gap:11px; background:#eff6ff; border:1px solid #dbeafe; border-radius:12px;
            padding:13px 16px; margin-bottom:14px; }
        .mb-note > i { color:#2563eb; font-size:17px; margin-top:1px; flex-shrink:0; }
        .mb-note-b { font-size:13px; color:#1e293b; line-height:1.55; }
        .mb-note-h { font-weight:700; color:#1d4ed8; margin-bottom:3px; }
        .mb-note-t { color:#334155; }
        .mb-note-l { margin:6px 0 0; padding-left:18px; }
        .mb-note-l li { margin-bottom:2px; }
        .mb-note-l b, .mb-note-t b { color:#0f172a; }

        .mb-param { margin-bottom:16px; }
        .mb-form { display:flex; gap:14px; align-items:flex-end; flex-wrap:wrap; }
        .mb-field label { display:block; font-size:11px; color:#64748b; font-weight:600; margin-bottom:5px; }
        .mb-date, .mb-file { padding:9px 12px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px;
            outline:none; background:#fbfcff; }
        .mb-date:focus, .mb-file:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.12); }
        .mb-hint { font-size:12px; color:#64748b; }
        .mb-hint code, .mb-rejim-t code { background:#f1f5f9; padding:1px 5px; border-radius:4px; }

        .mb-rejim { margin-top:14px; padding-top:12px; border-top:1px dashed #e2e8f0; }
        .mb-check { display:flex; align-items:center; gap:8px; font-size:13px; color:#0f172a; cursor:pointer; }
        .mb-rejim-t { font-size:12px; color:#64748b; margin-top:5px; padding-left:24px; line-height:1.55; }

        .mb-diag { font-size:12px; color:#475569; background:#f8fafc; border:1px solid #e2e8f0;
            border-radius:8px; padding:7px 11px; margin-bottom:10px; }

        .mb-sec { display:flex; align-items:center; gap:9px; font-size:13px; font-weight:800;
            color:#0f172a; margin:2px 0 10px; }
        .mb-sec-bar { width:4px; height:17px; border-radius:3px; background:linear-gradient(180deg,#dc2626,#ea580c); }

        .mb-twrap { overflow-x:auto; }
        .mb-twrap--scroll { max-height:340px; overflow-y:auto; }
        .mb-table { width:100%; border-collapse:collapse; font-size:13px; }
        .mb-table thead th { background:#f1f5f9; color:#475569; font-weight:600; font-size:12px; text-align:left;
            padding:9px 12px; border-bottom:1px solid #e2e8f0; white-space:nowrap; position:sticky; top:0; }
        .mb-table td { padding:9px 12px; border-bottom:1px solid #f1f5f9; color:#1e293b; }
        .mb-table code { background:#f1f5f9; padding:1px 6px; border-radius:5px; font-size:12px; }
        .mb-dim { color:#94a3b8; }
        .mb-badge { display:inline-block; padding:2px 9px; border-radius:999px; font-size:11px; font-weight:700; }
        .mb-badge--on  { background:#dcfce7; color:#166534; }
        .mb-badge--off { background:#f1f5f9; color:#64748b; }
    </style>
}

@section Scripts {
    <script>
        // Fayl endirmə ilə bitir — səhifə yenilənmir, ona görə düymə öz-özünə
        // bərpa OLUNMUR. Sabit taymerlə açmaq YANLIŞDIR: kiçik axtarışda (3-5 san)
        // düymə lazımsız yerə 2 dəqiqə "Hazırlanır" qalır, böyük siyahıda (~10 dəq,
        // bax CLAUDE.md "BÖYÜK SİYAHI") isə əksinə HƏLƏ server işləyərkən açılıb
        // ikinci klikə (paralel sorğu) icazə verir. Ona görə server faylı
        // göndərməzdən ƏVVƏL `mbHazir` cookie-si qoyur, JS onu poll edir — düymə
        // REAL bitmə anına bağlanır, nə qədər çəkməsindən asılı olmayaraq.
        (function () {
            var f = document.getElementById('mbForm');
            var b = document.getElementById('mbBtn');
            var h = document.getElementById('mbHint');
            if (!f || !b) return;

            function cookieVar(ad) {
                var m = document.cookie.match(new RegExp('(?:^|; )' + ad + '=([^;]*)'));
                return m ? m[1] : null;
            }
            function cookieSil(ad) {
                document.cookie = ad + '=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT';
            }
            function bitir() {
                b.disabled = false;
                b.innerHTML = '<i class="bi bi-search"></i> Ümumi sorğu';
                if (h) h.textContent = 'Paket böyükdür — bir neçə dəqiqə çəkə bilər.';
            }

            f.addEventListener('submit', function () {
                cookieSil('mbHazir');
                b.disabled = true;
                b.innerHTML = '<i class="bi bi-hourglass-split"></i> Hazırlanır gözləyin...';
                if (h) h.textContent = 'Fayl hazır olanda endirmə özü başlayacaq.';

                var basladi = Date.now();
                // Təhlükəsizlik həddi: 20 dəqiqə (çox böyük siyahı + yavaş Oracle
                // ehtimalına görə) — bundan sonra cookie tapılmasa da düymə açılır,
                // yoxsa xəta (redirect) halında düymə əbədi kilidli qalardı (cookie
                // yazılmır, çünki o yalnız uğurlu File() cavabından əvvəl qoyulur).
                var polling = setInterval(function () {
                    if (cookieVar('mbHazir') === '1') {
                        cookieSil('mbHazir');
                        clearInterval(polling);
                        bitir();
                        return;
                    }
                    if (Date.now() - basladi > 20 * 60 * 1000) {
                        clearInterval(polling);
                        bitir();
                    }
                }, 500);
            });
        })();
    </script>
}
