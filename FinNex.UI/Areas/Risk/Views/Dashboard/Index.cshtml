@using System.Text.Json
@model RiskPanelDto
@{
    ViewData["Title"] = "Risk Departamenti";
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Risk Departamenti</div>
            <div class="fn-page-sub">Risk / AML idarəetmə paneli — real vaxt</div>
        </div>
        <div style="display:flex;gap:8px">
            <a asp-action="Index" class="fn-btn fn-btn--outline"><i class="bi bi-arrow-clockwise"></i> Yenilə</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rk-alert rk-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    @if (Model.Bosdur)
    {
        <div class="fn-card">
            <div class="rk-empty">
                <i class="bi bi-clipboard-data"></i>
                <div>Hələ risk hesabatı yoxdur.</div>
                <div class="rk-empty-sub">Admin paneldə <b>Oracle Sorğular</b>-a sorğu əlavə edib <b>"Risk"</b> departamentinə təyin edin — burada avtomatik görünəcək.<br />
                    Mahiyyət sahəsinin əvvəlinə <code>[KPI]</code> yazsanız rəqəm kartı, <code>[PIE]</code>/<code>[BAR]</code>/<code>[LINE]</code> yazsanız qrafik olur.</div>
            </div>
        </div>
    }

    @* ---- KPI kartları ---- *@
    @if (Model.Kpiler.Any())
    {
        <div class="rk-kpis">
            @{ var ki = 0; }
            @foreach (var k in Model.Kpiler)
            {
                var cls = $"rk-kpi rk-kpi--{ki % 5}";
                ki++;
                <a asp-action="Hesabat" asp-route-id="@k.Id" class="@cls">
                    <div class="rk-kpi-ic"><i class="bi bi-@(k.Xeta != null ? "exclamation-triangle" : "graph-up-arrow")"></i></div>
                    <div class="rk-kpi-body">
                        <div class="rk-kpi-val">@(k.Xeta != null ? "—" : k.Deyer)</div>
                        <div class="rk-kpi-lbl">@k.Ad</div>
                        @if (!string.IsNullOrWhiteSpace(k.Alt))
                        {
                            <div class="rk-kpi-alt">@k.Alt</div>
                        }
                        @if (k.Xeta != null)
                        {
                            <div class="rk-kpi-err" title="@k.Xeta">sorğu xətası</div>
                        }
                    </div>
                </a>
            }
        </div>
    }

    @* ---- Qrafiklər ---- *@
    @if (Model.Qrafikler.Any())
    {
        <div class="rk-charts">
            @foreach (var c in Model.Qrafikler)
            {
                <div class="fn-card rk-chartcard">
                    <div class="rk-chart-head">
                        <div class="rk-chart-title">@c.Ad</div>
                        <a asp-action="Hesabat" asp-route-id="@c.Id" class="rk-chart-link" title="Cədvəl kimi aç"><i class="bi bi-table"></i></a>
                    </div>
                    @if (c.Xeta != null)
                    {
                        <div class="rk-alert rk-alert--err" style="margin:0"><i class="bi bi-x-octagon"></i> @c.Xeta</div>
                    }
                    else if (c.Bosdur)
                    {
                        <div class="rk-empty2"><i class="bi bi-inbox"></i> Nəticə boşdur.</div>
                    }
                    else
                    {
                        <div class="rk-canvas-wrap">
                            <canvas class="rk-chart"
                                    data-type="@c.Tip"
                                    data-labels="@JsonSerializer.Serialize(c.Etiketler)"
                                    data-values="@JsonSerializer.Serialize(c.Deyerler)"></canvas>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ---- Adi hesabat kartları (tag-siz) ---- *@
    @if (Model.Hesabatlar.Any())
    {
        @if (Model.Kpiler.Any() || Model.Qrafikler.Any())
        {
            <div class="rk-section-title"><i class="bi bi-list-ul"></i> Hesabatlar</div>
        }
        <div class="rk-grid">
            @foreach (var h in Model.Hesabatlar)
            {
                <a asp-action="Hesabat" asp-route-id="@h.Id" class="rk-card">
                    <div class="rk-ic"><i class="bi bi-shield-check"></i></div>
                    <div class="rk-body">
                        <div class="rk-title">@h.Ad</div>
                        @if (!string.IsNullOrWhiteSpace(h.Mahiyyet))
                        {
                            <div class="rk-sub">@h.Mahiyyet</div>
                        }
                    </div>
                    <i class="bi bi-chevron-right rk-arrow"></i>
                </a>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        /* KPI */
        .rk-kpis { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; margin-bottom:18px; }
        .rk-kpi { display:flex; align-items:center; gap:14px; padding:16px 18px; border-radius:16px; text-decoration:none;
            color:#fff; box-shadow:0 8px 22px rgba(15,23,42,.10); transition:.15s; }
        .rk-kpi:hover { transform:translateY(-2px); box-shadow:0 14px 30px rgba(15,23,42,.16); }
        .rk-kpi--0 { background:linear-gradient(135deg,#dc2626,#b91c1c); }
        .rk-kpi--1 { background:linear-gradient(135deg,#ea580c,#c2410c); }
        .rk-kpi--2 { background:linear-gradient(135deg,#0ea5e9,#0369a1); }
        .rk-kpi--3 { background:linear-gradient(135deg,#7c3aed,#5b21b6); }
        .rk-kpi--4 { background:linear-gradient(135deg,#059669,#047857); }
        .rk-kpi-ic { width:46px; height:46px; border-radius:12px; background:rgba(255,255,255,.18); display:flex;
            align-items:center; justify-content:center; font-size:22px; flex-shrink:0; }
        .rk-kpi-body { min-width:0; }
        .rk-kpi-val { font-size:26px; font-weight:800; line-height:1.05; letter-spacing:-.5px; }
        .rk-kpi-lbl { font-size:12.5px; font-weight:600; opacity:.95; margin-top:3px; }
        .rk-kpi-alt { font-size:11px; opacity:.8; margin-top:1px; }
        .rk-kpi-err { font-size:10.5px; background:rgba(0,0,0,.18); display:inline-block; padding:1px 7px; border-radius:6px; margin-top:4px; }

        /* Charts */
        .rk-charts { display:grid; grid-template-columns:repeat(auto-fill,minmax(360px,1fr)); gap:14px; margin-bottom:18px; }
        .rk-chartcard { padding:16px 18px; }
        .rk-chart-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
        .rk-chart-title { font-size:13.5px; font-weight:700; color:#0f172a; }
        .rk-chart-link { color:#cbd5e1; text-decoration:none; font-size:15px; }
        .rk-chart-link:hover { color:#dc2626; }
        .rk-canvas-wrap { position:relative; height:260px; }

        .rk-section-title { font-size:13px; font-weight:700; color:#475569; margin:6px 0 12px; display:flex; align-items:center; gap:7px; }

        /* Report cards (mövcud) */
        .rk-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:14px; }
        .rk-card { display:flex; align-items:center; gap:14px; padding:16px 18px; background:#fff; border:1px solid #eef2f7;
            border-radius:14px; text-decoration:none; transition:.15s; box-shadow:0 1px 2px rgba(15,23,42,.04); }
        .rk-card:hover { border-color:#fecaca; box-shadow:0 10px 26px rgba(220,38,38,.10); transform:translateY(-2px); }
        .rk-ic { width:44px; height:44px; border-radius:11px; background:#fef2f2; color:#dc2626; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
        .rk-body { flex:1; min-width:0; }
        .rk-title { font-size:14px; font-weight:700; color:#0f172a; }
        .rk-sub { font-size:12px; color:#64748b; margin-top:2px; }
        .rk-arrow { color:#cbd5e1; }
        .rk-empty { text-align:center; padding:40px 20px; color:#64748b; }
        .rk-empty i { font-size:34px; color:#cbd5e1; }
        .rk-empty > div { margin-top:8px; }
        .rk-empty-sub { font-size:12px; color:#94a3b8; max-width:560px; margin:6px auto 0; line-height:1.6; }
        .rk-empty-sub code { background:#f1f5f9; padding:1px 5px; border-radius:4px; color:#dc2626; }
        .rk-empty2 { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .rk-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .rk-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
    </style>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') return;
            Chart.defaults.font.family = "'Plus Jakarta Sans', system-ui, sans-serif";
            Chart.defaults.font.size = 12;
            Chart.defaults.color = '#64748b';

            var palette = ['#dc2626','#ea580c','#f59e0b','#0ea5e9','#7c3aed','#059669','#e11d48','#0891b2','#65a30d','#c026d3'];
            var fmt = function (n) {
                try { return Number(n).toLocaleString('az-AZ'); } catch (e) { return n; }
            };

            document.querySelectorAll('canvas.rk-chart').forEach(function (cv) {
                var type = cv.dataset.type || 'bar';
                var labels, values;
                try { labels = JSON.parse(cv.dataset.labels || '[]'); } catch (e) { labels = []; }
                try { values = JSON.parse(cv.dataset.values || '[]'); } catch (e) { values = []; }

                var isPie = (type === 'pie');
                var colors = isPie ? labels.map(function (_, i) { return palette[i % palette.length]; }) : palette[0];

                var dataset = {
                    label: '',
                    data: values,
                    backgroundColor: isPie ? colors : (type === 'line' ? 'rgba(220,38,38,.12)' : palette[0]),
                    borderColor: isPie ? '#fff' : palette[0],
                    borderWidth: isPie ? 2 : (type === 'line' ? 2 : 0),
                    borderRadius: type === 'bar' ? 6 : 0,
                    fill: type === 'line',
                    tension: .3,
                    pointRadius: type === 'line' ? 3 : 0,
                    pointBackgroundColor: palette[0]
                };

                new Chart(cv, {
                    type: type,
                    data: { labels: labels, datasets: [dataset] },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: isPie, position: 'right', labels: { boxWidth: 12, padding: 10 } },
                            tooltip: {
                                callbacks: {
                                    label: function (ctx) {
                                        var v = fmt(ctx.parsed.y != null ? ctx.parsed.y : ctx.parsed);
                                        return (isPie ? (ctx.label + ': ') : '') + v;
                                    }
                                }
                            }
                        },
                        scales: isPie ? {} : {
                            y: { beginAtZero: true, ticks: { callback: function (v) { return fmt(v); } }, grid: { color: '#f1f5f9' } },
                            x: { grid: { display: false }, ticks: { maxRotation: 45, minRotation: 0, autoSkip: true, maxTicksLimit: 16 } }
                        }
                    }
                });
            });
        })();
    </script>
}
