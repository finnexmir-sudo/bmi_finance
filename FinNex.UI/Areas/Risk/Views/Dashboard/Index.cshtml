@using System.Text.Json
@model RiskPanelDto
@{
    ViewData["Title"] = "Risk Departamenti";
    var bugun = DateTime.Now.ToString("dd MMMM yyyy, HH:mm");
}

<div class="rk-dash">
    <div class="rk-hero">
        <div class="rk-hero-l">
            <div class="rk-hero-badge"><i class="bi bi-shield-shaded"></i> Risk / AML</div>
            <h1 class="rk-hero-title">Risk İdarəetmə Paneli</h1>
            <div class="rk-hero-sub"><i class="bi bi-broadcast"></i> Real vaxt · @bugun</div>
        </div>
        <div class="rk-hero-r">
            <a asp-action="Index" class="rk-refresh"><i class="bi bi-arrow-clockwise"></i> Yenilə</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="rk-alert rk-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    @if (Model.Bosdur)
    {
        <div class="rk-panel">
            <div class="rk-empty">
                <i class="bi bi-clipboard-data"></i>
                <div>Hələ risk hesabatı yoxdur.</div>
                <div class="rk-empty-sub">Admin paneldə <b>Oracle Sorğular</b>-a sorğu əlavə edib <b>"Risk"</b> departamentinə təyin edin.<br />
                    Mahiyyətin əvvəlinə <code>[KPI]</code> → rəqəm kartı, <code>[PIE]</code>/<code>[BAR]</code>/<code>[LINE]</code> → qrafik.</div>
            </div>
        </div>
    }

    @* ---- KPI kartları ---- *@
    @if (Model.Kpiler.Any())
    {
        <div class="rk-kpis">
            @{ var ki = 0; }
            @foreach (var k in Model.Kpiler)
            {
                var cls = $"rk-kpi rk-kpi--{ki % 5}";
                ki++;
                <a asp-action="Hesabat" asp-route-id="@k.Id" class="@cls">
                    <div class="rk-kpi-top">
                        <div class="rk-kpi-ic"><i class="bi bi-@(k.Xeta != null ? "exclamation-triangle" : "people-fill")"></i></div>
                        <i class="bi bi-arrow-up-right rk-kpi-cta"></i>
                    </div>
                    <div class="rk-kpi-val" data-num="@(k.Reqem && k.Xeta == null ? k.Deyer : "")">@(k.Xeta != null ? "—" : k.Deyer)</div>
                    <div class="rk-kpi-lbl">@k.Ad</div>
                    @if (!string.IsNullOrWhiteSpace(k.Alt))
                    {
                        <div class="rk-kpi-alt">@k.Alt</div>
                    }
                    @if (k.Xeta != null)
                    {
                        <div class="rk-kpi-err" title="@k.Xeta"><i class="bi bi-exclamation-circle"></i> sorğu xətası</div>
                    }
                </a>
            }
        </div>
    }

    @* ---- Qrafiklər ---- *@
    @if (Model.Qrafikler.Any())
    {
        <div class="rk-sec"><span class="rk-sec-bar"></span> Qrafiklər</div>
        <div class="rk-charts">
            @{ var ci = 0; }
            @foreach (var c in Model.Qrafikler)
            {
                var icon = c.Tip == "pie" ? "pie-chart-fill" : c.Tip == "line" ? "graph-up" : "bar-chart-fill";
                var acc = ci % 6; ci++;
                <div class="rk-chartcard">
                    <div class="rk-chart-head">
                        <div class="rk-chart-titlewrap">
                            <span class="rk-chart-chip rk-acc-@acc"><i class="bi bi-@icon"></i></span>
                            <span class="rk-chart-title">@c.Ad</span>
                        </div>
                        <a asp-action="Hesabat" asp-route-id="@c.Id" class="rk-chart-link" title="Cədvəl kimi aç"><i class="bi bi-table"></i></a>
                    </div>
                    @if (c.Xeta != null)
                    {
                        <div class="rk-alert rk-alert--err" style="margin:0"><i class="bi bi-x-octagon"></i> @c.Xeta</div>
                    }
                    else if (c.Bosdur)
                    {
                        <div class="rk-empty2"><i class="bi bi-inbox"></i> Nəticə boşdur.</div>
                    }
                    else
                    {
                        <div class="rk-canvas-wrap @(c.Tip == "pie" ? "rk-canvas--pie" : "")">
                            <canvas class="rk-chart"
                                    data-type="@c.Tip"
                                    data-labels="@JsonSerializer.Serialize(c.Etiketler)"
                                    data-values="@JsonSerializer.Serialize(c.Deyerler)"></canvas>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ---- AML hesabatları — OracleSorgular-dan gəlməyən, öz ekranı olan hesabatlar ---- *@
    <div class="rk-sec"><span class="rk-sec-bar"></span> AML</div>
    <div class="rk-grid">
        <a asp-controller="Aml" asp-action="Index" class="rk-card">
            <div class="rk-ic"><i class="bi bi-file-earmark-text"></i></div>
            <div class="rk-body">
                <div class="rk-title">Hesab üzrə sorğu</div>
                <div class="rk-sub">Hesabın dövr üzrə çıxarışı — 47 sütunlu AML formatı, Excel ixracı</div>
            </div>
            <i class="bi bi-chevron-right rk-arrow"></i>
        </a>
    </div>

    @* ---- Adi hesabat kartları (tag-siz) ---- *@
    @if (Model.Hesabatlar.Any())
    {
        <div class="rk-sec"><span class="rk-sec-bar"></span> Hesabatlar</div>
        <div class="rk-grid">
            @foreach (var h in Model.Hesabatlar)
            {
                <a asp-action="Hesabat" asp-route-id="@h.Id" class="rk-card">
                    <div class="rk-ic"><i class="bi bi-shield-check"></i></div>
                    <div class="rk-body">
                        <div class="rk-title">@h.Ad</div>
                        @if (!string.IsNullOrWhiteSpace(h.Mahiyyet))
                        {
                            <div class="rk-sub">@h.Mahiyyet</div>
                        }
                    </div>
                    <i class="bi bi-chevron-right rk-arrow"></i>
                </a>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .rk-dash { --r1:#dc2626; --r2:#b91c1c; }
        @@keyframes rkUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }
        .rk-kpis > *, .rk-charts > *, .rk-grid > * { animation:rkUp .4s ease both; }

        /* Hero */
        .rk-hero { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap;
            padding:15px 20px; border-radius:15px; margin-bottom:13px; color:#fff; position:relative; overflow:hidden;
            background:radial-gradient(1200px 300px at 90% -40%, rgba(255,255,255,.18), transparent 60%), linear-gradient(120deg,#7f1d1d,#dc2626 55%,#ef4444); box-shadow:0 16px 40px rgba(185,28,28,.28); }
        .rk-hero::after { content:""; position:absolute; right:-40px; top:-40px; width:220px; height:220px; border-radius:50%;
            background:rgba(255,255,255,.08); }
        .rk-hero-badge { display:inline-flex; align-items:center; gap:6px; font-size:11.5px; font-weight:700; letter-spacing:.4px;
            text-transform:uppercase; background:rgba(255,255,255,.18); padding:5px 11px; border-radius:999px; }
        .rk-hero-title { font-size:19px; font-weight:800; margin:6px 0 2px; letter-spacing:-.4px; }
        .rk-hero-sub { font-size:12.5px; opacity:.92; display:flex; align-items:center; gap:7px; }
        .rk-refresh { display:inline-flex; align-items:center; gap:7px; background:rgba(255,255,255,.16); color:#fff;
            border:1px solid rgba(255,255,255,.28); padding:9px 15px; border-radius:12px; font-size:13px; font-weight:600; text-decoration:none; transition:.15s; }
        .rk-refresh:hover { background:rgba(255,255,255,.28); color:#fff; }

        /* KPI */
        .rk-kpis { display:grid; grid-template-columns:repeat(auto-fill,minmax(185px,1fr)); gap:11px; margin-bottom:14px; }
        .rk-kpi { display:block; padding:13px 15px; border-radius:13px; text-decoration:none; color:#fff; position:relative;
            overflow:hidden; box-shadow:0 10px 26px rgba(15,23,42,.12); transition:.18s; }
        .rk-kpi::after { content:""; position:absolute; right:-30px; bottom:-40px; width:130px; height:130px; border-radius:50%; background:rgba(255,255,255,.10); }
        .rk-kpi:hover { transform:translateY(-3px); box-shadow:0 18px 38px rgba(15,23,42,.20); color:#fff; }
        .rk-kpi--0 { background:linear-gradient(135deg,#dc2626,#991b1b); }
        .rk-kpi--1 { background:linear-gradient(135deg,#ea580c,#9a3412); }
        .rk-kpi--2 { background:linear-gradient(135deg,#0ea5e9,#075985); }
        .rk-kpi--3 { background:linear-gradient(135deg,#7c3aed,#5b21b6); }
        .rk-kpi--4 { background:linear-gradient(135deg,#059669,#065f46); }
        .rk-kpi-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:9px; }
        .rk-kpi-ic { width:36px; height:36px; border-radius:11px; background:rgba(255,255,255,.20); display:flex;
            align-items:center; justify-content:center; font-size:17px; backdrop-filter:blur(4px); }
        .rk-kpi-cta { font-size:15px; opacity:.7; }
        .rk-kpi-val { font-size:24px; font-weight:800; line-height:1; letter-spacing:-.6px; position:relative; z-index:1; }
        .rk-kpi-lbl { font-size:12px; font-weight:700; margin-top:5px; position:relative; z-index:1; }
        .rk-kpi-alt { font-size:11px; opacity:.82; margin-top:2px; position:relative; z-index:1; }
        .rk-kpi-err { font-size:10.5px; background:rgba(0,0,0,.22); display:inline-flex; gap:4px; align-items:center; padding:2px 8px; border-radius:7px; margin-top:8px; position:relative; z-index:1; }

        /* Section title */
        .rk-sec { display:flex; align-items:center; gap:9px; font-size:13px; font-weight:800; color:#0f172a; margin:2px 0 10px; }
        .rk-sec-bar { width:4px; height:17px; border-radius:3px; background:linear-gradient(180deg,#dc2626,#ea580c); }

        /* Charts */
        .rk-charts { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:12px; margin-bottom:16px; }
        .rk-chartcard { background:#fff; border:1px solid #eef2f7; border-radius:14px; padding:13px 16px;
            box-shadow:0 2px 10px rgba(15,23,42,.05); transition:.18s; }
        .rk-chartcard:hover { box-shadow:0 14px 32px rgba(15,23,42,.10); transform:translateY(-2px); }
        .rk-chart-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:9px; }
        .rk-chart-titlewrap { display:flex; align-items:center; gap:10px; min-width:0; }
        .rk-chart-chip { width:28px; height:28px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:13px; color:#fff; flex-shrink:0; }
        .rk-acc-0 { background:linear-gradient(135deg,#dc2626,#b91c1c); }
        .rk-acc-1 { background:linear-gradient(135deg,#ea580c,#c2410c); }
        .rk-acc-2 { background:linear-gradient(135deg,#0ea5e9,#0369a1); }
        .rk-acc-3 { background:linear-gradient(135deg,#7c3aed,#5b21b6); }
        .rk-acc-4 { background:linear-gradient(135deg,#059669,#047857); }
        .rk-acc-5 { background:linear-gradient(135deg,#d946ef,#a21caf); }
        .rk-chart-title { font-size:13px; font-weight:700; color:#0f172a; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .rk-chart-link { color:#cbd5e1; text-decoration:none; font-size:15px; flex-shrink:0; }
        .rk-chart-link:hover { color:#dc2626; }
        .rk-canvas-wrap { position:relative; height:195px; }
        .rk-canvas--pie { height:195px; }

        /* Report cards */
        .rk-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:11px; }
        .rk-card { display:flex; align-items:center; gap:12px; padding:12px 15px; background:#fff; border:1px solid #eef2f7;
            border-radius:12px; text-decoration:none; transition:.15s; box-shadow:0 1px 2px rgba(15,23,42,.04); }
        .rk-card:hover { border-color:#fecaca; box-shadow:0 10px 26px rgba(220,38,38,.10); transform:translateY(-2px); }
        .rk-ic { width:38px; height:38px; border-radius:10px; background:#fef2f2; color:#dc2626; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
        .rk-body { flex:1; min-width:0; }
        .rk-title { font-size:14px; font-weight:700; color:#0f172a; }
        .rk-sub { font-size:12px; color:#64748b; margin-top:2px; }
        .rk-arrow { color:#cbd5e1; }

        .rk-panel { background:#fff; border:1px solid #eef2f7; border-radius:18px; }
        .rk-empty { text-align:center; padding:44px 20px; color:#64748b; }
        .rk-empty i { font-size:36px; color:#cbd5e1; }
        .rk-empty > div { margin-top:8px; }
        .rk-empty-sub { font-size:12px; color:#94a3b8; max-width:560px; margin:6px auto 0; line-height:1.7; }
        .rk-empty-sub code, .rk-empty-sub b { background:#f1f5f9; padding:1px 6px; border-radius:5px; color:#dc2626; font-weight:600; }
        .rk-empty2 { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .rk-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:12px; font-size:13px; margin-bottom:16px; }
        .rk-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
    </style>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.js"></script>
    <script>
        (function () {
            var azFmt = function (n) { try { return Number(n).toLocaleString('az-AZ'); } catch (e) { return n; } };

            // KPI rəqəmlərinin canlanma (count-up) animasiyası
            document.querySelectorAll('.rk-kpi-val').forEach(function (el) {
                var raw = el.getAttribute('data-num');
                if (!raw) return;
                var target = parseFloat(raw.replace(/[^0-9.\-]/g, ''));
                if (isNaN(target)) return;
                var dur = 900, start = null, dec = (raw.indexOf('.') !== -1);
                function step(ts) {
                    if (!start) start = ts;
                    var p = Math.min((ts - start) / dur, 1);
                    var e = 1 - Math.pow(1 - p, 3); // easeOutCubic
                    var v = target * e;
                    el.textContent = dec ? azFmt(v.toFixed(2)) : azFmt(Math.round(v));
                    if (p < 1) requestAnimationFrame(step);
                    else el.textContent = azFmt(dec ? target.toFixed(2) : target);
                }
                el.textContent = '0';
                requestAnimationFrame(step);
            });

            if (typeof Chart === 'undefined') return;
            Chart.defaults.font.family = "'Plus Jakarta Sans', system-ui, sans-serif";
            Chart.defaults.font.size = 12;
            Chart.defaults.color = '#64748b';

            var palette = ['#dc2626','#ea580c','#f59e0b','#0ea5e9','#7c3aed','#059669','#e11d48','#0891b2','#84cc16','#d946ef','#14b8a6','#f43f5e'];

            document.querySelectorAll('canvas.rk-chart').forEach(function (cv) {
                var type = cv.dataset.type || 'bar';
                var labels, values;
                try { labels = JSON.parse(cv.dataset.labels || '[]'); } catch (e) { labels = []; }
                try { values = JSON.parse(cv.dataset.values || '[]'); } catch (e) { values = []; }
                var isPie = (type === 'pie');
                var ctx = cv.getContext('2d');

                // xətt/sütun üçün şaquli qradiyent
                function grad(hex, a1, a2) {
                    var g = ctx.createLinearGradient(0, 0, 0, 260);
                    g.addColorStop(0, hex + a1); g.addColorStop(1, hex + a2); return g;
                }

                var ds;
                if (isPie) {
                    ds = {
                        data: values,
                        backgroundColor: labels.map(function (_, i) { return palette[i % palette.length]; }),
                        borderColor: '#fff', borderWidth: 3, hoverOffset: 8
                    };
                } else if (type === 'line') {
                    ds = {
                        data: values, label: '',
                        backgroundColor: grad('#dc2626', '33', '02'),
                        borderColor: '#dc2626', borderWidth: 2.5, fill: true, tension: .38,
                        pointRadius: 3, pointHoverRadius: 5, pointBackgroundColor: '#dc2626', pointBorderColor: '#fff', pointBorderWidth: 1.5
                    };
                } else {
                    ds = {
                        data: values, label: '',
                        backgroundColor: grad('#dc2626', 'ff', 'aa'),
                        borderRadius: 7, borderSkipped: false, maxBarThickness: 46
                    };
                }

                new Chart(cv, {
                    type: type,
                    data: { labels: labels, datasets: [ds] },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        cutout: isPie ? '62%' : undefined,
                        animation: { duration: 700, easing: 'easeOutQuart' },
                        plugins: {
                            legend: { display: isPie, position: 'right', labels: { boxWidth: 11, boxHeight: 11, padding: 11, usePointStyle: true, font: { size: 11.5 } } },
                            tooltip: {
                                backgroundColor: '#0f172a', padding: 10, cornerRadius: 8, displayColors: !isPie ? false : true,
                                callbacks: {
                                    label: function (c2) {
                                        var v = azFmt(c2.parsed.y != null ? c2.parsed.y : c2.parsed);
                                        return (isPie ? (' ' + c2.label + ': ') : ' ') + v;
                                    }
                                }
                            }
                        },
                        scales: isPie ? {} : {
                            y: { beginAtZero: true, ticks: { callback: function (v) { return azFmt(v); }, font: { size: 11 } }, grid: { color: '#f1f5f9', drawBorder: false } },
                            x: { grid: { display: false, drawBorder: false }, ticks: { maxRotation: 42, autoSkip: true, maxTicksLimit: 16, font: { size: 11 } } }
                        }
                    }
                });
            });
        })();
    </script>
}
