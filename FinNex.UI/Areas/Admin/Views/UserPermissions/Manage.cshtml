@model ManagePermissionsVM

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="admin-table-card">
            <div class="card-header">
                <h5><i class="bi bi-shield-lock-fill me-2"></i>Document Permissions</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
            <div class="p-4">

                <!-- İstifadəçi məlumatı -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                         style="width:48px;height:48px;font-size:1.1rem;">
                        @Model.FullName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <div class="fw-semibold">@Model.FullName</div>
                        <div class="text-muted small">@@@Model.UserName</div>
                    </div>
                </div>

                <form asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserId" value="@Model.UserId" />

                    <div class="table-responsive">
                        <table class="table admin-table">
                            <thead>
                                <tr>
                                    <th>Department</th>
                                    <th class="text-center" style="width:120px;">
                                        <i class="bi bi-eye me-1"></i>View
                                    </th>
                                    <th class="text-center" style="width:120px;">
                                        <i class="bi bi-pencil-square me-1"></i>Full
                                    </th>
                                    <th class="text-center" style="width:120px;">
                                        <i class="bi bi-x-circle me-1"></i>None
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Rows.Count; i++)
                                {
                                    var row = Model.Rows[i];
                                    var groupName = $"Permissions[{row.DepartmentId}]";
                                    <tr>
                                        <td class="fw-semibold">@row.DepartmentName</td>

                                        <!-- View -->
                                        <td class="text-center">
                                            <div class="form-check d-flex justify-content-center">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="@groupName"
                                                       value="1"
                                                       @(row.CurrentPermission == 1 ? "checked" : "") />
                                            </div>
                                        </td>

                                        <!-- Full -->
                                        <td class="text-center">
                                            <div class="form-check d-flex justify-content-center">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="@groupName"
                                                       value="2"
                                                       @(row.CurrentPermission == 2 ? "checked" : "") />
                                            </div>
                                        </td>

                                        <!-- None -->
                                        <td class="text-center">
                                            <div class="form-check d-flex justify-content-center">
                                                <input class="form-check-input"
                                                       type="radio"
                                                       name="@groupName"
                                                       value="0"
                                                       @(row.CurrentPermission == null ? "checked" : "") />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>