@model LoginLogPageVM

<!-- Filter Bar -->
<div class="admin-filter-bar">
    <form method="get" asp-action="Index">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All</option>
                    <option value="success" selected="@(Model.StatusFilter == "success")">Successful</option>
                    <option value="fail" selected="@(Model.StatusFilter == "fail")">Failed</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm"
                       placeholder="Username, full name or IP..." value="@Model.SearchTerm" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-x-lg me-1"></i>Clear
                </a>
            </div>
        </div>
    </form>
</div>

@if (Model.Logs.Any())
{
    <div class="admin-table-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5><i class="bi bi-door-open me-2"></i>Login History</h5>
            <span class="text-muted small">Page @Model.CurrentPage of @Model.TotalPages</span>
        </div>
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Tarix / Saat</th>
                        <th>İstifadəçi</th>
                        <th>Ad Soyad</th>
                        <th>IP Ünvan</th>
                        <th>Brauzer</th>
                        <th>Status</th>
                        <th>Səbəb</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <small class="text-muted">@log.LoginTime.ToString("dd.MM.yyyy HH:mm:ss")</small>
                            </td>
                            <td class="fw-semibold">@log.UserName</td>
                            <td>@(log.FullName ?? "—")</td>
                            <td>
                                <code>@(log.IpAddress ?? "—")</code>
                            </td>
                            <td>
                                <small class="text-muted" title="@log.UserAgent">
                                    @BrowserShortName(log.UserAgent)
                                </small>
                            </td>
                            <td>
                                @if (log.IsSuccess)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                        <i class="bi bi-check-circle me-1"></i>Uğurlu
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger admin-badge">
                                        <i class="bi bi-x-circle me-1"></i>Uğursuz
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@(log.FailReason ?? "—")</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination admin-pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-status="@Model.StatusFilter"
                       asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-search="@Model.SearchTerm">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-status="@Model.StatusFilter"
                       asp-route-search="@Model.SearchTerm">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="admin-table-card">
        <div class="card-header">
            <h5><i class="bi bi-door-open me-2"></i>Login History</h5>
        </div>
        <div class="p-5 text-center">
            <i class="bi bi-door-closed d-block mb-3" style="font-size: 2.5rem; color: var(--admin-text-muted);"></i>
            <h6 class="text-muted">Giriş qeydiyyatı tapılmadı</h6>
            <p class="text-muted small mb-0">
                İstifadəçilər daxil olduqda burada login tarixçəsi görünəcək.
            </p>
        </div>
    </div>
}

@functions {
    string BrowserShortName(string? ua)
    {
        if (string.IsNullOrEmpty(ua)) return "—";
        if (ua.Contains("Edg")) return "Edge";
        if (ua.Contains("Chrome")) return "Chrome";
        if (ua.Contains("Firefox")) return "Firefox";
        if (ua.Contains("Safari")) return "Safari";
        if (ua.Contains("Opera") || ua.Contains("OPR")) return "Opera";
        return "Digər";
    }
}
