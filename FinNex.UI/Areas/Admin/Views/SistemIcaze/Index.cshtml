@model FinNex.UI.Areas.Admin.ViewModels.SistemIcazeIndexVM
@{
    ViewData["Title"] = "Sistem İcazələri";
}

<div class="si-wrap">
    <div class="si-head">
        <div>
            <h1>Sistem İcazələri</h1>
            <p>İcazə seç → hansı işçilərin görəcəyini təyin et. Yeni sahələr üçün yeni icazə əlavə edə bilərsən.</p>
        </div>
    </div>

    @if (TempData["Status"] != null)
    {
        <div class="si-alert si-ok"><i class="bi bi-check-circle"></i> @TempData["Status"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="si-alert si-err"><i class="bi bi-exclamation-triangle"></i> @TempData["Error"]</div>
    }

    <div class="si-grid">
        <div class="si-card">
            <div class="si-card-h">İcazələr</div>
            <table class="si-table">
                @* AÇIQLAMA AYRICA SÜTUN DEYİL — adın ALTINDA yazılır.
                   Səbəb: bu kart iki sütunlu düzülüşün sol yarısıdır (~660px).
                   Beş sütunu ora sığdırmağa çalışanda `Kod` (nowrap, uzun ola
                   bilir — `muhasibat_dashboard_bax`) açıqlama sütununu əzir və
                   mətn söz ortasından kəsilir (20.08.2026, real hadisə).
                   İndi eni yalnız üç dar sütun tutur, açıqlama isə sətrin
                   bütün enindən istifadə edir. *@
                <thead>
                    <tr>
                        <th>İcazə</th>
                        <th style="width:1%">Kod</th>
                        <th style="width:1%;text-align:center">İstifadəçi</th>
                        <th style="width:1%"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Icazeler.Any())
                    {
                        <tr><td colspan="4" class="si-empty">Hələ icazə yoxdur — sağdan əlavə et.</td></tr>
                    }
                    @foreach (var p in Model.Icazeler)
                    {
                        <tr>
                            <td>
                                <div class="si-ad">@p.Ad</div>
                                @if (!string.IsNullOrWhiteSpace(p.Aciqlama))
                                {
                                    <div class="si-aciqlama">@p.Aciqlama</div>
                                }
                            </td>
                            <td><code>@p.Kod</code></td>
                            <td style="text-align:center"><span class="si-badge">@p.UserSayi</span></td>
                            <td style="text-align:right">
                                <a class="si-btn" asp-action="Idare" asp-route-id="@p.Id"><i class="bi bi-people"></i> İdarə et</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="si-card">
            <div class="si-card-h">Yeni icazə</div>
            <form method="post" asp-action="Yarat" class="si-form">
                @Html.AntiForgeryToken()
                <label>Kod <span>(dəyişməz açar, məs. <code>risk_panel_bax</code>)</span></label>
                <input name="kod" maxlength="100" placeholder="modul_ehval_bax" required />
                <label>Ad <span>(göstərilən ad)</span></label>
                <input name="ad" maxlength="150" placeholder="Risk Paneli" required />
                <label>Açıqlama <span>(istəyə bağlı)</span></label>
                <textarea name="aciqlama" maxlength="500" rows="2" placeholder="Bu icazə nəyə giriş verir"></textarea>
                <button type="submit" class="si-btn si-primary"><i class="bi bi-plus-lg"></i> Əlavə et</button>
            </form>
            @* Bu qeyd QƏSDƏN uzundur: icazə yaratmaq TƏK BAŞINA heç nəyi
               qorumur və bunu unutmaq asandır — sonra «icazə verdim, işləmir»
               deyə vaxt itir. Üç addım da burada yazılıb ki, aylar sonra
               yenidən oxumaq kifayət etsin. *@
            <div class="si-note">
                <div class="si-note-bas">
                    <i class="bi bi-info-circle"></i> İcazə necə işləyir — 3 addım
                </div>

                <ol class="si-steps">
                    <li>
                        <b>İcazəni yarat</b> — yuxarıdakı forma.
                        <span class="si-dim">Kod dəyişməz açardır (məs. <code>modul_ehval_bax</code>);
                        sonradan dəyişdirsən kodla əlaqə qırılar.</span>
                    </li>
                    <li>
                        <b>İşçilərə ver</b> — soldakı siyahıdan <b>İdarə et</b>.
                    </li>
                    <li>
                        <b>Səhifəyə bağla</b> — bu addım <u>kodda</u> edilir.
                        Yeni icazə yaratmaq tək başına <b>heç bir səhifəni qorumur</b>:
                        sistem bilmir ki, o kod hansı səhifəyə aiddir.
                        Proqramçı həmin controller-in üstünə bir sətir yazır:
<pre class="si-code">[Authorize]
[Icaze("modul_ehval_bax")]   // ← buradakı KOD
public class EhvalController : Controller</pre>
                    </li>
                </ol>

                <div class="si-note-alt">
                    <b>Qayda:</b> <b>Admin həmişə girir</b> — ona icazə vermək lazım deyil.
                    İcazəsi olmayan <code>403</code> alır.<br />
                    <b>Diqqət:</b> koddakı mətn buradakı <b>Kod</b> sütunu ilə hərfən eyni
                    olmalıdır. Bir hərf fərq olsa icazə heç kimə işləməz və
                    <b>heç bir xəta çıxmaz</b> — hamı səssizcə 403 alar.<br />
                    Menyuda linkin görünməsi ayrıca şərtdir (<code>_UserLayout.cshtml</code>) —
                    o da eyni icazəyə baxmalıdır, yoxsa link görünər, səhifə açılmaz.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .si-wrap { max-width: 1100px; }
    .si-head h1 { font-size: 22px; font-weight: 800; margin: 0 0 4px; }
    .si-head p { color: #64748b; font-size: 13.5px; margin: 0 0 16px; }
    .si-alert { border-radius: 10px; padding: 11px 15px; font-size: 13.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }
    .si-ok { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .si-err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
    .si-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 18px; align-items: start; }
    .si-card { background: #fff; border: 1px solid #e6ebf2; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 14px rgba(2,6,23,.05); }
    .si-card-h { font-weight: 700; font-size: 14px; padding: 14px 18px; border-bottom: 1px solid #eef2f7; }
    .si-note-bas { font-weight: 700; margin-bottom: 8px; }
    .si-steps { margin: 0 0 10px; padding-left: 18px; }
    .si-steps li { margin-bottom: 7px; line-height: 1.5; }
    .si-dim { color: #64748b; }
    .si-code {
        margin: 6px 0 0; padding: 9px 11px; border-radius: 8px;
        background: #0f172a; color: #e2e8f0; font-size: 12px; line-height: 1.5;
        white-space: pre; overflow-x: auto;
    }
    .si-note-alt {
        margin-top: 10px; padding-top: 10px; border-top: 1px solid #cbd5e1;
        line-height: 1.55;
    }
    .si-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .si-table th { text-align: left; padding: 10px 14px; background: #f8fafc; color: #64748b; font-size: 11.5px; text-transform: uppercase; letter-spacing: .3px; }
    .si-table td { padding: 11px 14px; border-top: 1px solid #eef2f7; vertical-align: middle; }
    /* Kod, sayğac və düymə sütunları sıxılmasın — eni məzmunları qədərdir.
       Birinci sütun (ad + açıqlama) qalan bütün eni tutur. */
    .si-table td:nth-child(2),
    .si-table td:nth-child(3),
    .si-table td:nth-child(4) { white-space: nowrap; }
    .si-ad { font-weight: 700; }
    .si-aciqlama { margin-top: 2px; color: #64748b; font-size: 12px; line-height: 1.45; }
    .si-muted { color: #94a3b8; }
    .si-empty { text-align: center; color: #94a3b8; padding: 26px; }
    .si-badge { background: #eef2f7; color: #334155; border-radius: 20px; padding: 2px 10px; font-weight: 700; font-size: 12.5px; }
    code { background: #f1f5f9; padding: 1px 6px; border-radius: 5px; font-size: 12px; color: #0f766e; }
    .si-btn { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; background: #eef2f7; color: #334155; border: none; border-radius: 9px; padding: 7px 13px; font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer; }
    .si-btn:hover { background: #e2e8f0; }
    .si-primary { background: linear-gradient(135deg,#0f766e,#14b8a6); color: #fff; }
    .si-primary:hover { filter: brightness(1.05); }
    .si-form { padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
    .si-form label { font-size: 12.5px; font-weight: 600; color: #334155; margin-top: 6px; }
    .si-form label span { font-weight: 400; color: #94a3b8; }
    .si-form input, .si-form textarea { border: 1px solid #d7dee8; border-radius: 8px; padding: 8px 10px; font-size: 13px; font-family: inherit; }
    .si-form button { margin-top: 12px; justify-content: center; }
    .si-note { margin: 0 18px 16px; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 10px; padding: 11px 13px; font-size: 12px; color: #334155; line-height: 1.5; }
    @@media (max-width: 860px) { .si-grid { grid-template-columns: 1fr; } }
</style>
