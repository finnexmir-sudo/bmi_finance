@model FinNex.Application.DTOs.Paylasim.PaylasimYaratDto
@{
    ViewData["Title"] = "Paylaşımı Redaktə Et";
    var id = (int)ViewBag.Id;
}

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet">

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Paylaşımı Redaktə Et</h3>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
    }

    <form asp-action="Redakte" asp-route-id="@id" method="post" id="pySealForm">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body">
                        <label class="form-label small text-muted">Başlıq</label>
                        <input type="text" name="Basliq" class="form-control form-control-lg mb-4"
                               value="@Model.Basliq" maxlength="300" required>

                        <label class="form-label small text-muted">Məzmun</label>
                        <div id="pyEditor" style="min-height:320px"></div>
                        <input type="hidden" name="MetnHtml" id="pyMetnHtml">
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">Paylaşım ayarları</h6>

                        @await Html.PartialAsync("_KateqoriyaSecim", Model)
                        @await Html.PartialAsync("_HedefSecim")

                        <div class="d-grid gap-2 mt-3">
                            @if ((bool)ViewBag.Qaralamadir)
                            {
                                <button type="submit" name="QaralamaOlaraqSaxla" value="false" class="btn btn-primary">
                                    <i class="bi bi-send-fill me-1"></i>Paylaş
                                </button>
                                <button type="submit" name="QaralamaOlaraqSaxla" value="true" class="btn btn-outline-secondary">
                                    <i class="bi bi-file-earmark-text me-1"></i>Qaralama olaraq saxla
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-1"></i>Yadda saxla
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
(function () {
    const quill = new Quill('#pyEditor', {
        theme: 'snow',
        modules: {
            toolbar: {
                container: [
                    [{ header: [2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['blockquote', 'link', 'image'],
                    ['clean']
                ],
                handlers: { image: sekilSec }
            }
        }
    });

    // Mövcud məzmunu yüklə (Razor-dan gələn HTML — artıq sanitize olunub)
    quill.clipboard.dangerouslyPasteHTML(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MetnHtml)));

    function sekilSec() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/jpeg,image/png,image/gif,image/webp';
        input.onchange = async () => {
            const fayl = input.files[0];
            if (!fayl) return;

            const fd = new FormData();
            fd.append('fayl', fayl);

            const range = quill.getSelection(true);
            quill.insertText(range.index, 'Şəkil yüklənir...', { italic: true });

            try {
                const resp = await fetch('@Url.Action("SekilYukle")', { method: 'POST', body: fd });
                const data = await resp.json();
                quill.deleteText(range.index, 'Şəkil yüklənir...'.length);
                if (data.ok) {
                    quill.insertEmbed(range.index, 'image', data.url);
                    quill.setSelection(range.index + 1);
                } else {
                    alert(data.xeta || 'Şəkil yüklənmədi.');
                }
            } catch {
                quill.deleteText(range.index, 'Şəkil yüklənir...'.length);
                alert('Şəbəkə xətası — şəkil yüklənmədi.');
            }
        };
        input.click();
    }

    document.getElementById('pySealForm').addEventListener('submit', function (e) {
        const html = quill.root.innerHTML;
        document.getElementById('pyMetnHtml').value = html;
        if (html.trim() === '<p><br></p>') {
            e.preventDefault();
            alert('Məzmun boş ola bilməz.');
        }
    });
})();
</script>
}
