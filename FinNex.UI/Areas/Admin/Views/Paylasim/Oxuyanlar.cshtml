@using FinNex.Application.DTOs.Paylasim
@model List<PaylasimOxuyanDto>
@{
    ViewData["Title"] = "Kim oxudu?";
    var post = (PaylasimListDto)ViewBag.Post;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-eye-fill me-2 text-primary"></i>Kim oxudu?</h3>
            <small class="text-muted">@post.Basliq</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Siyahıya qayıt
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body d-flex align-items-center gap-3">
            <div class="fs-3 fw-bold text-primary">@Model.Count</div>
            <div class="text-muted">nəfər bu paylaşımı açıb oxuyub (@post.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")-dən bəri).</div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        @if (!Model.Any())
        {
            <div class="card-body text-center text-muted py-5">
                Hələ heç kim bu paylaşımı açıb oxumayıb.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="width:48px;"></th>
                            <th>Ad Soyad</th>
                            <th>Oxunma tarixi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td><i class="bi bi-person-circle text-muted fs-5"></i></td>
                                <td>@o.AdSoyad</td>
                                <td class="text-muted">@o.OxunmaTarixi.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
