@model List<FinNex.Application.DTOs.Paylasim.PaylasimListDto>
@{
    ViewData["Title"] = "Paylaşımlar";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-share-fill me-2 text-primary"></i>Paylaşımlar</h3>
            <small class="text-muted">İşçilərin oxuduğu bilik lenti — Elandan ayrı, sırf məlumat məqsədlidir</small>
        </div>
        <a asp-action="Yarat" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Yeni Paylaşım
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center text-muted py-5">
                Hələ heç bir paylaşım yoxdur.
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 @(p.Qaralamadir || p.Aktivdir ? "" : "opacity-50")">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">@p.Basliq</h6>
                                @if (p.Qaralamadir)
                                {
                                    <span class="badge bg-secondary bg-opacity-25 text-secondary">Qaralama</span>
                                }
                                else if (p.Aktivdir)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">Gizli</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.KateqoriyaAdi))
                            {
                                <div class="mb-1">
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@p.KateqoriyaAdi</span>
                                </div>
                            }
                            <div class="small text-muted mb-2">
                                @p.GonderenAdi — @p.YaradilmaTarixi.ToString("dd.MM.yyyy HH:mm")
                            </div>
                            <div class="mb-3">
                                @if (p.HedefSayi == 0)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info">
                                        <i class="bi bi-people-fill me-1"></i>Hamısına
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning">
                                        <i class="bi bi-person-check-fill me-1"></i>@p.HedefSayi işçi
                                    </span>
                                }
                            </div>
                            <div class="flex-grow-1"></div>
                            <div class="d-flex gap-2 mt-2">
                                <a asp-action="Redakte" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-pencil"></i> Redaktə
                                </a>
                                @if (p.Qaralamadir)
                                {
                                    <form asp-action="Payla" asp-route-id="@p.Id" method="post" class="flex-fill">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-primary w-100">
                                            <i class="bi bi-send-fill"></i> Paylaş
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="AktivlikDeyis" asp-route-id="@p.Id" method="post" class="flex-fill">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                                            @(p.Aktivdir ? "Gizlət" : "Göstər")
                                        </button>
                                    </form>
                                }
                                <form asp-action="Sil" asp-route-id="@p.Id" method="post"
                                      onsubmit="return confirm('Bu paylaşımı silmək istəyirsiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
