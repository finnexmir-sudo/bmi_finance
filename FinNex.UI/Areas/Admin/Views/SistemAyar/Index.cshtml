@model FinNex.Domain.Entities.SistemAyar

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="bi bi-gear-fill me-2"></i>Sistem Ayarları</h4>
    <p class="text-muted mb-0">Kredit modulu IMAP ayarlarını buradan konfiqurasiya edin.</p>
</div>

@if (TempData["Ugur"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Ugur"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm" style="max-width:600px">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-envelope-fill me-2 text-primary"></i>Kredit Mail (IMAP) Ayarları</h6>
    </div>
    <div class="card-body p-4">
        <form asp-action="Saxla" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PidTopluSmsOracleSorguId" value="@Model.PidTopluSmsOracleSorguId" />
            <input type="hidden" name="PidOdenisGunuSorguId"     value="@Model.PidOdenisGunuSorguId" />

            <div class="mb-3">
                <label class="form-label fw-semibold">IMAP Server</label>
                <input type="text" name="KreditImapServer" class="form-control"
                       value="@Model.KreditImapServer" placeholder="imap.titan.email" />
                <div class="form-text">Nümunə: imap.titan.email, imap.gmail.com</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Port</label>
                <input type="number" name="KreditImapPort" class="form-control"
                       value="@Model.KreditImapPort" placeholder="993" style="max-width:140px" />
                <div class="form-text">SSL üçün adətən 993</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">E-poçt ünvanı</label>
                <input type="email" name="KreditImapEmail" class="form-control"
                       value="@Model.KreditImapEmail" placeholder="kredit@bmibaku.az" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Şifrə</label>
                <input type="password" name="KreditImapPassword" class="form-control"
                       placeholder="Dəyişmək üçün yaz, boş buraxsan köhnə qalır" autocomplete="new-password" />
                @if (!string.IsNullOrEmpty(Model.KreditImapPassword))
                {
                    <div class="form-text text-success"><i class="bi bi-lock-fill"></i> Şifrə qeydə alınıb</div>
                }
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-floppy-fill me-1"></i>Yadda Saxla
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4" style="max-width:600px">
    <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-database me-2 text-primary"></i>PİD — Toplu SMS Ayarları</h6>
    </div>
    <div class="card-body p-4">
        <form asp-action="Saxla" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="KreditImapServer" value="@Model.KreditImapServer" />
            <input type="hidden" name="KreditImapPort" value="@Model.KreditImapPort" />
            <input type="hidden" name="KreditImapEmail" value="@Model.KreditImapEmail" />

            <div class="mb-3">
                <label class="form-label fw-semibold">Borcalanlar Oracle Sorğusu</label>
                <select name="PidTopluSmsOracleSorguId" class="form-select">
                    <option value="">— Seçilməyib —</option>
                    @foreach (var item in ViewBag.OracleSorqular as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
                <div class="form-text">
                    <i class="bi bi-info-circle me-1"></i>
                    "Borcalanları Gətir" düyməsi bu sorğudan istifadə edir.
                    Sorğu <a asp-area="Admin" asp-controller="OracleSorgu" asp-action="Index">Oracle Sorğular</a> səhifəsindən əlavə olunur.
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Ödəniş günü olanlar Oracle Sorğusu</label>
                <select name="PidOdenisGunuSorguId" class="form-select">
                    <option value="">— Seçilməyib —</option>
                    @foreach (var item in ViewBag.OdenisGunuSorqular as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? [])
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
                <div class="form-text">
                    <i class="bi bi-info-circle me-1"></i>
                    "Ödəniş günü olanlar" düyməsi bu sorğudan istifadə edir. Sorğu mətni <code>&amp;tarix</code> parametrini ehtiva etməlidir (Oracle format: <code>dd-mm-yyyy</code>).
                </div>
            </div>

            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-floppy-fill me-1"></i>Yadda Saxla
            </button>
        </form>
    </div>
</div>
