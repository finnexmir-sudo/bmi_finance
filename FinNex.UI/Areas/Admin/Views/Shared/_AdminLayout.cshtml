@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentUser = User.Identity?.Name ?? "Admin";
    var initials = currentUser.Length >= 2
        ? currentUser.Substring(0, 2).ToUpper()
        : currentUser.ToUpper();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Panel | BMI Finance</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#1a2332" />
    <meta name="application-name" content="BMI Finance" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-body">

    <!-- Sidebar Overlay (mobile) -->
    <div class="admin-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">

        <a class="admin-sidebar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <img src="~/images/Logobank.jpg" alt="BMI" class="brand-icon" />
            <div>
                <div class="brand-title">BMI Finance</div>
                <div class="brand-subtitle">Admin Panel</div>
            </div>
        </a>

        <nav class="admin-sidebar-nav">
            <div class="nav-section">Main</div>

            <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i>
                Dashboard
            </a>

            <div class="nav-section">Management</div>

            <a class="nav-link @(currentController == "UserManagement" ? "active" : "")"
               asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                Users
            </a>

            <a class="nav-link @(currentController == "RoleManagement" ? "active" : "")"
               asp-area="Admin" asp-controller="RoleManagement" asp-action="Index">
                <i class="bi bi-shield-lock-fill"></i>
                Roles
            </a>
            <a class="nav-link @(currentController == "Department" ? "active" : "")"
               asp-area="Admin"
               asp-controller="Department"
               asp-action="Index">
                <i class="bi bi-diagram-3-fill"></i>
                Departments
            </a>

            <a class="nav-link @(currentController == "StrukturRolu" ? "active" : "")"
               asp-area="Admin" asp-controller="StrukturRolu" asp-action="Index">
                <i class="bi bi-person-badge-fill"></i>
                Struktur Rolları
            </a>

            <a class="nav-link @(currentController == "UserPermissions" ? "active" : "")"
               asp-area="Admin" asp-controller="UserPermissions" asp-action="Index">
                <i class="bi bi-shield-lock-fill"></i>
                Permissions
            </a>

            <div class="nav-section">Kredit</div>

            <a class="nav-link @(currentController == "KreditBaxanIsci" ? "active" : "")"
               asp-area="Admin" asp-controller="KreditBaxanIsci" asp-action="Index">
                <i class="bi bi-cash-coin"></i>
                Baxan işçilər
            </a>

            <a class="nav-link @(currentController == "KomiteUzvu" ? "active" : "")"
               asp-area="Admin" asp-controller="KomiteUzvu" asp-action="Index">
                <i class="bi bi-people-fill"></i>
                Komitə üzvləri
            </a>

            <div class="nav-section">System</div>

            <a class="nav-link @(currentController == "LoginLogs" ? "active" : "")"
               asp-area="Admin" asp-controller="LoginLogs" asp-action="Index">
                <i class="bi bi-door-open"></i>
                Login Logs
            </a>

            <a class="nav-link @(currentController == "SystemLogs" ? "active" : "")"
               asp-area="Admin" asp-controller="SystemLogs" asp-action="Index">
                <i class="bi bi-journal-text"></i>
                System Logs
            </a>

            <a class="nav-link @(currentController == "FealiyyetJurnali" ? "active" : "")"
               asp-area="Admin" asp-controller="FealiyyetJurnali" asp-action="Index">
                <i class="bi bi-clock-history"></i>
                Fəaliyyət Jurnalı
            </a>
        </nav>

        <a class="admin-back-link" asp-area="User" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-arrow-left"></i>
            Əsas Səhifəyə Qayıt
        </a>

        <div class="admin-sidebar-footer">
            <div class="admin-user-info">
                <div class="admin-user-avatar">@initials</div>
                <div>
                    <div class="admin-user-name">@currentUser</div>
                    <div class="admin-user-role">Administrator</div>
                </div>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">

        <!-- Top Bar -->
        <div class="admin-topbar">
            <div>
                <button class="admin-sidebar-toggle" id="sidebarToggle" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="admin-topbar-title d-inline-block ms-2">@ViewData["Title"]</h1>
            </div>
            <div class="admin-topbar-actions">
                <span class="admin-topbar-breadcrumb">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                    / @ViewData["Title"]
                </span>
            </div>
        </div>

        <!-- Page Content -->
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-sidebar.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
