@model FinNex.Application.DTOs.Yardim.YardimUpsertDto
@{
    ViewData["Title"] = Model.Id > 0 ? "Təlimatı redaktə et" : "Yeni təlimat";
}
@* Admin sahəsi Bootstrap 5 işlədir (_AdminLayout: bootstrap.min.css + admin.css).
   `fn-*` class-ları yalnız modul CSS fayllarındadır və burada YÜKLƏNMİR —
   onları işlətsək forma stilsiz görünür (27.08.2026 real hadisə). *@
<div class="container-fluid" style="max-width:960px">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-question-circle me-2 text-primary"></i>@ViewData["Title"]
            </h3>
            <small class="text-muted">Mətn bazada saxlanılır — dəyişiklik dərhal işə düşür, deploy lazım deyil</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <form asp-action="Redakte" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Səhifə açarı *</label>
                        <input type="text" name="Acar" value="@Model.Acar" class="form-control"
                               placeholder="user/mezuniyyet/create" maxlength="200" />
                        <div class="form-text">
                            Format: <code>area/controller/action</code>, kiçik hərflə. Area yoxdursa <code>_</code>.
                            Açarı bilmirsinizsə həmin səhifədə <b>?</b> basın — «təlimat yaz» düyməsi açarı özü doldurur.
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Qısa ünvan (slug)</label>
                        <input type="text" name="Slug" value="@Model.Slug" class="form-control"
                               placeholder="boş buraxsanız başlıqdan yaranır" maxlength="200" />
                        <div class="form-text">Çatda paylaşmaq üçün: <code>/Yardim/Sehife/&lt;slug&gt;</code></div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Başlıq *</label>
                        <input type="text" name="Basliq" value="@Model.Basliq" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Modul</label>
                        <input type="text" name="Modul" value="@Model.Modul" class="form-control"
                               placeholder="Məzuniyyət, İcazə, Davamiyyət…" maxlength="100" />
                        <div class="form-text">İndeks səhifəsində qruplaşdırma üçün</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bir cümləlik xülasə</label>
                    <input type="text" name="Xulase" value="@Model.Xulase" class="form-control" maxlength="500"
                           placeholder="Siyahıda başlığın altında görünür" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Təlimat mətni (HTML)</label>
                    <textarea name="Metn" class="form-control font-monospace" rows="18"
                              style="font-size:12.5px">@Model.Metn</textarea>
                    <div class="form-text">
                        Sadə HTML: <code>&lt;h3&gt;</code>, <code>&lt;p&gt;</code>,
                        <code>&lt;ul&gt;&lt;li&gt;</code>, <code>&lt;b&gt;</code>, <code>&lt;table&gt;</code>.
                        Yan panelin eni ~420 px-dir — qısa abzaslar yazın.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-4 mb-4">
                    <div class="form-check">
                        @* Checkbox işarəsiz qalanda POST-da SAHƏ GƏLMİR → gizli «false»
                           qoyulur ki, işarənin götürülməsi də açıq göndərilsin
                           (CLAUDE.md — şərtli sahə + default parametr tələsi). *@
                        <input type="hidden" name="Hazirlanir" value="false" />
                        <input class="form-check-input" type="checkbox" id="chkHazirlanir"
                               name="Hazirlanir" value="true" @(Model.Hazirlanir ? "checked" : "") />
                        <label class="form-check-label" for="chkHazirlanir">
                            Hazırlanır <span class="text-muted">(mətn yerinə xəbərdarlıq göstərilsin)</span>
                        </label>
                    </div>
                    <div class="form-check">
                        <input type="hidden" name="YalnizAdmin" value="false" />
                        <input class="form-check-input" type="checkbox" id="chkYalnizAdmin"
                               name="YalnizAdmin" value="true" @(Model.YalnizAdmin ? "checked" : "") />
                        <label class="form-check-label" for="chkYalnizAdmin">Yalnız Admin görsün</label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Yadda saxla
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                </div>
            </form>
        </div>
    </div>
</div>
