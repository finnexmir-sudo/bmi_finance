@model IReadOnlyList<FinNex.Application.DTOs.Yardim.YardimListDto>
@{ ViewData["Title"] = "Səhifə təlimatları"; }
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-question-circle me-2 text-primary"></i>Səhifə təlimatları
            </h3>
            <small class="text-muted">«?» düyməsinin mətnləri — redaktə üçün deploy lazım deyil</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Ehate" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-check me-1"></i>Əhatə
            </a>
            <a asp-action="Redakte" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Yeni təlimat
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col">
                    <input type="text" name="q" value="@ViewBag.Axtaris" class="form-control"
                           placeholder="Başlıq, modul və ya açıqlama üzrə axtar…" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Axtar</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(ViewBag.Axtaris as string))
                {
                    <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Sıfırla</a></div>
                }
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlıq</th>
                        <th>Modul</th>
                        <th>Açar</th>
                        <th class="text-end">Baxış</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>
                            <a href="/Yardim/Sehife/@s.Slug" class="fw-semibold text-decoration-none">@s.Basliq</a>
                            @if (s.Hazirlanir)
                            {
                                <span class="badge text-bg-warning ms-2">hazırlanır</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(s.Xulase))
                            {
                                <div class="small text-muted">@s.Xulase</div>
                            }
                        </td>
                        <td class="text-muted">@s.Modul</td>
                        <td><code class="small">@s.Acar</code></td>
                        <td class="text-end text-muted">@s.BaxisSayi</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Redakte" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Sil" method="post" class="d-inline"
                                  onsubmit="return confirm('«@s.Basliq» təlimatı silinsin?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">
                        Hələ təlimat yoxdur. <a asp-action="Ehate">Əhatə</a> səhifəsindən başlaya bilərsiniz.
                    </td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
