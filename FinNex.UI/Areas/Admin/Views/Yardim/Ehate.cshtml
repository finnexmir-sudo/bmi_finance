@model IReadOnlyList<FinNex.Application.DTOs.Yardim.YardimEhateDto>
@{
    ViewData["Title"] = "Təlimat əhatəsi";
    var yazilan = ViewBag.Yazilan as int? ?? 0;
    var cemi    = ViewBag.Cemi as int? ?? 0;
    var faiz    = cemi > 0 ? (yazilan * 100.0 / cemi) : 0;
    var saheler = ViewBag.Saheler as List<string> ?? new List<string>();

    // Faiz mətnləri MARKUP-DAN ƏVVƏL hazırlanır — iki səbəbdən (CLAUDE.md):
    //  · atribut içində dırnaqlı `ToString("0.##")` Razor parserini sındırır;
    //  · CSS-ə gedən rəqəm İNVARİANT olmalıdır — az-AZ vergülü ilə `width:73,3%`
    //    CSS tərəfindən atılır və zolaq TAM DOLU görünür.
    var inv     = System.Globalization.CultureInfo.InvariantCulture;
    var faizGos = faiz.ToString("0.#", inv);
    var faizCss = faiz.ToString("0.##", inv);
}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-list-check me-2 text-primary"></i>Təlimat əhatəsi
            </h3>
            <small class="text-muted">
                Hansı səhifənin izahı var, hansının yox — siyahı marşrut cədvəlindən gəlir, əl ilə saxlanmır
            </small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <div class="fs-4 fw-bold">
                @yazilan / @cemi <span class="fs-6 fw-semibold text-muted">(@faizGos%)</span>
            </div>
            <div class="progress mt-2" style="height:8px">
                <div class="progress-bar bg-dark" style="width:@faizCss%"></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="Ehate" class="btn btn-sm @(ViewBag.Sahe == null ? "btn-dark" : "btn-outline-secondary")">Hamısı</a>
                @foreach (var s in saheler)
                {
                    <a asp-action="Ehate" asp-route-sahe="@s"
                       class="btn btn-sm @((ViewBag.Sahe as string) == s ? "btn-dark" : "btn-outline-secondary")">@s</a>
                }
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Səhifə açarı</th>
                        <th>Başlıq</th>
                        <th>Vəziyyət</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><code class="small">@e.Acar</code></td>
                        <td>@e.Basliq</td>
                        <td>
                            @if (!e.Yazilib)
                            {
                                <span class="badge text-bg-danger">yazılmayıb</span>
                            }
                            else if (e.Hazirlanir)
                            {
                                <span class="badge text-bg-warning">hazırlanır</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">var</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!e.Yazilib)
                            {
                                <a asp-action="Redakte" asp-route-acar="@e.Acar"
                                   class="btn btn-sm btn-outline-primary">Yaz</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
