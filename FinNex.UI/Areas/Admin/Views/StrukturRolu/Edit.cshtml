@model FinNex.UI.Areas.Admin.ViewModels.StrukturRoluFormVM
@using FinNex.Domain.Entities.HR

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Struktur Rolunu Redaktə et";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-pencil-square text-warning me-2"></i>
                Struktur Rolunu Redaktə et
            </h3>
            <small class="text-muted">Mövcud rol qeydini dəyişin</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Geri
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="IsciId" class="form-label fw-semibold"></label>
                        <select asp-for="IsciId" asp-items="Model.Isciler" class="form-select">
                            <option value="">— İşçi seçin —</option>
                        </select>
                        <span asp-validation-for="IsciId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RolTipi" class="form-label fw-semibold"></label>
                        <select asp-for="RolTipi" class="form-select">
                            @foreach (var r in Enum.GetValues<StrukturRolTipi>())
                            {
                                var ad = r switch {
                                    StrukturRolTipi.SobeReisi => "Şöbə Rəisi",
                                    StrukturRolTipi.Rehber => "Rəhbər",
                                    StrukturRolTipi.Hr => "HR",
                                    _ => r.ToString()
                                };
                                <option value="@((int)r)" selected="@(Model.RolTipi == r)">@ad</option>
                            }
                        </select>
                        <span asp-validation-for="RolTipi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DepartamentId" class="form-label fw-semibold">
                            Departament <span class="text-muted small">(Şöbə Rəisi üçün məcburi)</span>
                        </label>
                        <select asp-for="DepartamentId" asp-items="Model.Departamentler" class="form-select">
                            <option value="">— Departament seçin —</option>
                        </select>
                        <span asp-validation-for="DepartamentId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BaslamaTarixi" class="form-label fw-semibold"></label>
                        <input asp-for="BaslamaTarixi" type="date" class="form-control"
                               value="@Model.BaslamaTarixi.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="BaslamaTarixi" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BitmeTarixi" class="form-label fw-semibold"></label>
                        <input asp-for="BitmeTarixi" type="date" class="form-control"
                               value="@(Model.BitmeTarixi?.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="BitmeTarixi" class="text-danger small"></span>
                        <small class="text-muted">Boş buraxılarsa müddətsiz qəbul edilir</small>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="Aktivdir" class="form-check-input" role="switch" />
                            <label asp-for="Aktivdir" class="form-check-label fw-semibold"></label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Ləğv et</a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check2-circle me-1"></i> Yenilə
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
