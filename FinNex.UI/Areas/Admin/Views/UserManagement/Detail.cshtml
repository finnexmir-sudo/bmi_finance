@model UserDetailVM

<div class="row g-4">
    <!-- User Info Card -->
    <div class="col-lg-8">
        <div class="admin-table-card">
            <div class="card-header">
                <h5><i class="bi bi-person-fill me-2"></i>User Information</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">USERNAME</label>
                        <div class="fw-semibold">@Model.UserName</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">FULL NAME</label>
                        <div class="fw-semibold">@Model.FullName</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">EMAIL</label>
                        <div>@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">REGISTERED</label>
                        <div>@Model.RegisteredAt.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">ROLES</label>
                        <div>
                            @foreach (var role in Model.Roles)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary admin-badge me-1">
                                    @role
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label text-muted small fw-semibold">STATUS</label>
                        <div>
                            @if (Model.IsLockedOut)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning admin-badge">
                                    Locked Out
                                </span>
                            }
                            else if (Model.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger admin-badge">
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Card -->
    <div class="col-lg-4">
        <div class="admin-table-card">
            <div class="card-header">
                <h5><i class="bi bi-shield-fill me-2"></i>Security</h5>
            </div>
            <div class="p-4">
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">ACCESS FAILED COUNT</label>
                    <div class="fw-semibold">@Model.AccessFailedCount</div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small fw-semibold">LOCKOUT END</label>
                    <div>
                        @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTimeOffset.UtcNow)
                        {
                            <span class="text-danger">@Model.LockoutEnd.Value.LocalDateTime.ToString("dd MMM yyyy, HH:mm")</span>
                        }
                        else
                        {
                            <span class="text-muted">None</span>
                        }
                    </div>
                </div>

                <hr />

                <div class="d-grid gap-2">
                    <a asp-action="ChangeRole" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-shield me-1"></i>Change Role
                    </a>

                    @if (Model.IsLockedOut)
                    {
                        <form asp-action="UnlockUser" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-warning w-100"
                                    onclick="return confirm('Unlock this user?')">
                                <i class="bi bi-unlock me-1"></i>Unlock User
                            </button>
                        </form>
                    }

                    <form asp-action="ToggleActive" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100"
                                    onclick="return confirm('Deactivate this user?')">
                                <i class="bi bi-person-x me-1"></i>Deactivate
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success w-100"
                                    onclick="return confirm('Activate this user?')">
                                <i class="bi bi-person-check me-1"></i>Activate
                            </button>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
