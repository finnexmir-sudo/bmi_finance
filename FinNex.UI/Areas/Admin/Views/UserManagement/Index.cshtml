@model List<UserListVM>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-table-card">
    <div class="card-header">
        <h5><i class="bi bi-people-fill me-2"></i>All Users (@Model.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Roles</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="text-muted">@user.Id</td>
                        <td class="fw-semibold">@user.UserName</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary admin-badge me-1">
                                    @role
                                </span>
                            }
                        </td>
                        <td>@user.RegisteredAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (user.IsLockedOut)
                            {
                                <span class="badge bg-warning bg-opacity-10 text-warning admin-badge">
                                    Locked
                                </span>
                            }
                            else if (user.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger admin-badge">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <a asp-action="Detail" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="ChangeRole" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary" title="Change Role">
                                    <i class="bi bi-shield"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-warning" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                <a asp-action="AssignDepartment"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-info"
                                   title="Assign Department">
                                    <i class="bi bi-diagram-3"></i>
                                </a>

                                <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                title="Deactivate"
                                                onclick="return confirm('Deactivate this user?')">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                title="Activate"
                                                onclick="return confirm('Activate this user?')">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
