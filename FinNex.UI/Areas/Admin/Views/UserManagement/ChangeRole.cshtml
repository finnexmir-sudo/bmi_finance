@model ChangeUserRoleVM

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-table-card">
            <div class="card-header">
                <h5><i class="bi bi-shield-fill me-2"></i>Change User Role</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
            <div class="p-4">
                <div class="mb-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="admin-user-avatar bg-primary text-white d-flex align-items-center justify-content-center rounded-circle"
                             style="width:48px;height:48px;font-weight:700;">
                            @Model.FullName.Substring(0, 1).ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold">@Model.FullName</div>
                            <div class="text-muted small">@@@Model.UserName</div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <span class="text-muted small fw-semibold">CURRENT ROLES: </span>
                        @foreach (var role in Model.CurrentRoles)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary admin-badge me-1">
                                @role
                            </span>
                        }
                    </div>
                </div>

                <form asp-action="ChangeRole" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />
                    <input type="hidden" asp-for="FullName" />

                    <div class="mb-4">
                        <label asp-for="SelectedRoles" class="form-label fw-semibold">New Roles</label>
                        <div class="mb-4">
                            <div class="border rounded p-3">
                                @foreach (var role in Model.AvailableRoles)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedRoles"
                                               value="@role"
                                               id="role_@role"
                                               @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                                        <label class="form-check-label" for="role_@role">
                                            @role
                                        </label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="SelectedRoles" class="text-danger small"></span>
                        </div>
                        <span asp-validation-for="SelectedRoles" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"
                                onclick="return confirm('Are you sure you want to change this user\'s role?')">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
