@model List<DepartamentVM>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Departments";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-diagram-3-fill me-2 text-primary"></i>
                Departments
            </h3>
            <small class="text-muted">
                Manage organizational departments
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>
            Add Department
        </a>
    </div>

    <!-- STAT CARD -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">Total Departments</h6>
                    <h2 class="fw-bold mb-0">@Model.Count</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-building text-muted" style="font-size:50px;"></i>
                    <h5 class="mt-3 text-muted">No departments found</h5>
                    <p class="text-muted small">
                        Click "Add Department" to create your first department.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead class="table-light">
                            <tr>
                                <th style="width:60px;">#</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th style="width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                            }

                            @foreach (var dep in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-muted">@index</td>

                                    <td>
                                        <span class="fw-semibold">@dep.Ad</span>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrEmpty(dep.Aciqlama))
                                        {
                                            <span class="text-muted small">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            @dep.Aciqlama
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@dep.Id"
                                           class="btn btn-sm btn-outline-warning me-2">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@dep.Id"
                                           class="btn btn-sm btn-outline-danger me-2">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                        <a asp-action="Users"
                                           asp-route-id="@dep.Id"
                                           class="btn btn-sm btn-outline-info me-2">
                                            <i class="bi bi-eye"></i>
                                        </a>


                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

</div>
