@model DepartamentVM
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Create Department";
}

<div class="admin-table-card">

    <div class="card-header">
        <h5>
            <i class="bi bi-diagram-3-fill me-2"></i>
            Create New Department
        </h5>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>

    <div class="p-4">

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()


            <div class="row g-4">

                <!-- Department Name -->
                <div class="col-md-6">
                    <label asp-for="Ad" class="form-label fw-semibold">
                        Department Name
                    </label>
                    <input asp-for="Ad" class="form-control"
                           placeholder="Enter department name..." />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="col-md-6">
                    <label asp-for="Aciqlama" class="form-label fw-semibold">
                        Description
                    </label>
                    <input asp-for="Aciqlama" class="form-control"
                           placeholder="Optional description..." />
                    <span asp-validation-for="Aciqlama" class="text-danger small"></span>
                </div>

                <!-- Info Card -->
                <div class="col-12">
                    <div class="alert alert-light border small">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        After creating the department, you will be able to assign users to it.
                    </div>
                </div>

            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-2 mt-4">

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>
                    Save Department
                </button>

            </div>

        </form>

    </div>
</div>
