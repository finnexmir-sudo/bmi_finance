@model List<UserListVM>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Roles
    </a>
</div>

<div class="admin-table-card">
    <div class="card-header">
        <h5>
            <i class="bi bi-people-fill me-2"></i>
            Users in "@ViewData["RoleName"]" Role (@Model.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-muted">@user.Id</td>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger admin-badge">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="UserManagement"
                                   asp-action="Detail"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="UserManagement"
                                   asp-action="ChangeRole"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary" title="Change Role">
                                    <i class="bi bi-shield"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No users assigned to this role.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
