@model List<UserListVM>
@{
    var availableUsers = ViewData["AvailableUsers"] as List<UserListVM> ?? new List<UserListVM>();
    var roleId = (int)ViewData["RoleId"]!;
    var roleName = ViewData["RoleName"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Roles
    </a>
    @if (availableUsers.Any())
    {
        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            <i class="bi bi-person-plus me-1"></i>Add User to Role
        </button>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-table-card">
    <div class="card-header">
        <h5>
            <i class="bi bi-people-fill me-2"></i>
            Users in "@roleName" Role (@Model.Count)
        </h5>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="text-muted">@user.Id</td>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger admin-badge">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="UserManagement"
                                   asp-action="Detail"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="UserManagement"
                                   asp-action="ChangeRole"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary" title="Change Role">
                                    <i class="bi bi-shield"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Remove from Role"
                                        data-bs-toggle="modal"
                                        data-bs-target="#removeUserModal"
                                        data-user-id="@user.Id"
                                        data-user-name="@user.UserName">
                                    <i class="bi bi-person-dash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No users assigned to this role.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Remove User from Role Modal -->
<div class="modal fade" id="removeUserModal" tabindex="-1" aria-labelledby="removeUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="RemoveUserFromRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" value="@roleId" />
                <input type="hidden" name="userId" id="removeUserId" />
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="removeUserModalLabel">
                        <i class="bi bi-person-dash me-2"></i>Remove User from Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to remove <strong id="removeUserNameText"></strong> from the "<strong>@roleName</strong>" role?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-person-dash me-1"></i>Remove
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add User to Role Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-labelledby="addUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddUserToRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="roleId" value="@roleId" />
                <div class="modal-header">
                    <h5 class="modal-title" id="addUserModalLabel">
                        <i class="bi bi-person-plus me-2"></i>Add User to "@roleName" Role
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="userId" class="form-label">Select User</label>
                        <select class="form-select" name="userId" id="userId" required>
                            <option value="">-- Select a user --</option>
                            @foreach (var user in availableUsers)
                            {
                                <option value="@user.Id">@user.UserName (@user.FullName)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-person-plus me-1"></i>Add User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('removeUserModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            document.getElementById('removeUserId').value = button.getAttribute('data-user-id');
            document.getElementById('removeUserNameText').textContent = button.getAttribute('data-user-name');
        });
    </script>
}
