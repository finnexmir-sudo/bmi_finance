@model List<RoleListVM>

<div class="row g-3 mb-4">
    @foreach (var role in Model)
    {
        <div class="col-sm-6 col-xl-4">
            <div class="admin-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <div class="stat-value fs-4">@role.Name</div>
                            <div class="stat-label">@role.UserCount user(s) assigned</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Detail" asp-route-id="@role.Id"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye me-1"></i>View Users
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<div class="admin-table-card">
    <div class="card-header">
        <h5><i class="bi bi-shield-lock-fill me-2"></i>All Roles</h5>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Role Name</th>
                    <th>Users</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="text-muted">@role.Id</td>
                        <td class="fw-semibold">@role.Name</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary admin-badge">
                                @role.UserCount user(s)
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detail" asp-route-id="@role.Id"
                               class="btn btn-sm btn-outline-primary" title="View Users">
                                <i class="bi bi-eye me-1"></i>View Users
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
