@model List<KomiteUzvuListVM>
@using FinNex.Domain.Entities.Kredit
@{
    bool yalnizAktiv = ViewBag.YalnizAktiv ?? true;
}

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="admin-table-card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Kredit Komitəsi üzvləri (@Model.Count)</h5>
        <div class="d-flex gap-2">
            <div class="btn-group btn-group-sm">
                <a asp-action="Index" asp-route-yalnizAktiv="true"
                   class="btn @(yalnizAktiv ? "btn-primary" : "btn-outline-primary")">Aktivlər</a>
                <a asp-action="Index" asp-route-yalnizAktiv="false"
                   class="btn @(!yalnizAktiv ? "btn-primary" : "btn-outline-primary")">Hamısı</a>
            </div>
            <a asp-action="Secim" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Üzv əlavə et
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>FIN</th>
                    <th>Şöbə / Vəzifə</th>
                    <th>Rol</th>
                    <th>Təyinat tarixi</th>
                    <th>Status</th>
                    <th class="text-end">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Hələ ki komitə üzvü təyin edilməyib.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@row.TamAd</td>
                            <td>@row.FIN</td>
                            <td>
                                <div>@(row.SobeAdi ?? "—")</div>
                                <div class="text-muted small">@(row.VezifeAdi ?? "")</div>
                            </td>
                            <td>
                                @{
                                    var rolClass = row.Rol switch
                                    {
                                        KomiteUzvuRolu.Sedr => "bg-primary bg-opacity-10 text-primary",
                                        KomiteUzvuRolu.SedrMuavini => "bg-info bg-opacity-10 text-info",
                                        KomiteUzvuRolu.Katib => "bg-warning bg-opacity-10 text-warning",
                                        _ => "bg-secondary bg-opacity-10 text-secondary"
                                    };
                                }
                                <span class="badge admin-badge @rolClass">@row.RolAd</span>
                            </td>
                            <td>
                                @row.AktivdirFrom.ToString("dd.MM.yyyy")
                                @if (row.AktivdirTo != null)
                                {
                                    <span class="text-muted small">→ @row.AktivdirTo.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </td>
                            <td>
                                @if (row.AktivdirIndi)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success admin-badge">Aktiv</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary admin-badge">Ləğv edilib</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (row.AktivdirIndi)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal" data-bs-target="#rolModal_@row.Id">
                                        <i class="bi bi-pencil me-1"></i>Rol
                                    </button>
                                    <form asp-action="LegvEt" asp-route-id="@row.Id" method="post"
                                          onsubmit="return confirm('Üzvlüyü ləğv etmək istədiyinizə əminsiniz?');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i>Ləğv et
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var row in Model.Where(r => r.AktivdirIndi))
{
    <div class="modal fade" id="rolModal_@row.Id" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="RolDeyis" method="post" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Rol dəyiş — @row.TamAd</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="KomiteUzvuId" value="@row.Id" />
                    <div class="mb-3">
                        <label class="form-label">Yeni rol</label>
                        <select name="YeniRol" class="form-select">
                            <option value="0" selected="@(row.Rol == KomiteUzvuRolu.Uzv)">Üzv</option>
                            <option value="1" selected="@(row.Rol == KomiteUzvuRolu.Sedr)">Sədr</option>
                            <option value="2" selected="@(row.Rol == KomiteUzvuRolu.SedrMuavini)">Sədr müavini</option>
                            <option value="3" selected="@(row.Rol == KomiteUzvuRolu.Katib)">Katib</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bağla</button>
                    <button type="submit" class="btn btn-primary">Saxla</button>
                </div>
            </form>
        </div>
    </div>
}
