@model IEnumerable<FinNex.Application.DTOs.Marif.MarifIsciSecimDto>
@{
    ViewData["Title"] = "İşçi seç";
    var setId = (int)ViewBag.SetId;
    var setBasliq = (string)ViewBag.SetBasliq;
    var axtaris = ViewBag.Axtaris as string;
    var artiqGonderilen = (HashSet<int>)ViewBag.ArtiqGonderilen;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>İşçi seç</h3>
            <small class="text-muted">"@setBasliq" — göndəriləcək işçiləri seçin</small>
        </div>
        <a asp-action="Detail" asp-route-id="@setId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <form method="get" asp-action="IsciSec" asp-route-id="@setId" class="d-flex gap-2">
                <input type="text" name="axtaris" value="@axtaris" placeholder="Ad və ya soyad..." class="form-control" style="max-width:320px">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>

    <form asp-action="Gonder" method="post" id="mfGonderForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="setId" value="@setId">

        <div class="admin-table-card mb-3">
            <div class="table-responsive">
                <table class="table admin-table mb-0">
                    <thead>
                        <tr>
                            <th style="width:40px">
                                <input type="checkbox" id="mfHamisi" class="form-check-input">
                            </th>
                            <th>Ad Soyad</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Uyğun işçi tapılmadı.</td></tr>
                        }
                        else
                        {
                            @foreach (var isci in Model)
                            {
                                bool gonderilib = artiqGonderilen.Contains((int)isci.Id);
                                <tr>
                                    <td>
                                        @if (!gonderilib)
                                        {
                                            <input type="checkbox" class="form-check-input mf-isci-chk" name="isciIdler" value="@isci.Id">
                                        }
                                    </td>
                                    <td>@isci.Ad @isci.Soyad</td>
                                    <td class="text-end">
                                        @if (gonderilib)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success admin-badge">
                                                <i class="bi bi-check-circle me-1"></i>Göndərilib
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-send me-1"></i>Seçilənlərə göndər
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.getElementById('mfHamisi').addEventListener('change', function () {
        document.querySelectorAll('.mf-isci-chk').forEach(c => c.checked = this.checked);
    });
</script>
}
