@{
    ViewData["Title"] = "Əməliyyat Departamenti";
    var il = (int)(ViewBag.Il ?? DateTime.Now.Year);
    var gedenSay = (int)(ViewBag.GedenSay ?? 0);
    var gelenSay = (int)(ViewBag.GelenSay ?? 0);
    var gedenMebleg = (decimal)(ViewBag.GedenMebleg ?? 0m);
    var gelenMebleg = (decimal)(ViewBag.GelenMebleg ?? 0m);
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">Əməliyyat Departamenti</div>
            <div class="fn-page-sub">Pul köçürmələri — @il ili</div>
        </div>
    </div>

    <div class="em-cards">
        <a asp-controller="GedenHevale" asp-action="Index" class="em-card">
            <div class="em-card-ic em-card-ic--out"><i class="bi bi-arrow-up-right-circle"></i></div>
            <div class="em-card-body">
                <div class="em-card-title">Gedən həvalə</div>
                <div class="em-card-num">@gedenSay <span>əməliyyat</span></div>
                <div class="em-card-sum">@gedenMebleg.ToString("#,0.00")</div>
            </div>
        </a>
        <a asp-controller="GelenHevale" asp-action="Index" class="em-card">
            <div class="em-card-ic em-card-ic--in"><i class="bi bi-arrow-down-left-circle"></i></div>
            <div class="em-card-body">
                <div class="em-card-title">Gələn həvalə</div>
                <div class="em-card-num">@gelenSay <span>əməliyyat</span></div>
                <div class="em-card-sum">@gelenMebleg.ToString("#,0.00")</div>
            </div>
        </a>
    </div>
</div>

@section Styles {
    <style>
        .em-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; }
        .em-card { display:flex; gap:16px; align-items:center; padding:20px; background:#fff; border:1px solid #e2e8f0;
            border-radius:14px; text-decoration:none; transition:.15s; }
        .em-card:hover { border-color:#c7d2fe; box-shadow:0 10px 28px rgba(15,23,42,.10); transform:translateY(-2px); }
        .em-card-ic { width:52px; height:52px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:26px; }
        .em-card-ic--out { background:#fef3f2; color:#e11d48; }
        .em-card-ic--in { background:#ecfdf5; color:#059669; }
        .em-card-title { font-size:13px; color:#64748b; font-weight:600; }
        .em-card-num { font-size:22px; font-weight:800; color:#0f172a; margin-top:2px; }
        .em-card-num span { font-size:12px; font-weight:500; color:#94a3b8; }
        .em-card-sum { font-size:13px; color:#475569; font-weight:600; margin-top:2px; }
    </style>
}
