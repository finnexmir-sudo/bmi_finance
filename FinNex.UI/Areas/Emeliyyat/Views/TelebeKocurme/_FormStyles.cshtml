<style>
    .tk-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
    .tk-box { background:#fbfcff; border:1px solid #e8edf5; border-radius:12px; padding:14px 16px; }
    .tk-box-title { font-size:12px; font-weight:700; color:#334155; margin-bottom:10px; text-transform:uppercase; letter-spacing:.02em; }
    .tk-box label { display:block; font-size:11px; color:#64748b; font-weight:600; margin:8px 0 4px; }
    .tk-box label:first-of-type { margin-top:0; }
    .tk-box .dm-mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; }
    .tk-komissiya { margin-top:14px; padding:10px 12px; background:#eff6ff; border:1px solid #dbeafe; border-radius:9px;
