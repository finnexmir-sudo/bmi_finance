<style>
    .pk-form { display:flex; flex-direction:column; gap:16px; }
    .pk-row { display:grid; gap:16px; }
    .pk-row--2 { grid-template-columns:1fr 1fr; }
    .pk-row--3 { grid-template-columns:1fr 1fr 1fr; }

    .pk-card { background:#fff; border:1px solid #eef2f7; border-radius:14px; padding:16px 18px;
        box-shadow:0 1px 2px rgba(15,23,42,.04); }
    .pk-card--send { border-top:3px solid #3b82f6; }
    .pk-card--recv { border-top:3px solid #10b981; }

    .pk-head { display:flex; align-items:center; gap:9px; font-size:13px; font-weight:800; color:#0f172a;
        letter-spacing:.01em; margin-bottom:14px; }
    .pk-head--sm { font-size:11px; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.04em; margin-bottom:12px; }
    .pk-ic { width:28px; height:28px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;
        font-size:14px; background:#eff6ff; color:#3b82f6; }
    .pk-card--recv .pk-ic { background:#ecfdf5; color:#10b981; }
    .pk-ic--amt { background:#fef3c7; color:#d97706; }

    .pk-fields { display:flex; flex-direction:column; gap:12px; }
    .pk-f2 { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .pk-fields label, .pk-amt-grid label { display:block; font-size:11px; color:#94a3b8; font-weight:600; margin-bottom:5px; }

    .pk-in { width:100%; padding:9px 12px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; color:#0f172a;
        background:#fbfcff; outline:none; transition:.15s; }
    .pk-in:focus { border-color:#3b82f6; background:#fff; box-shadow:0 0 0 3px rgba(59,130,246,.12); }
    .pk-in--big { font-size:17px; font-weight:700; padding:10px 14px; }
    .pk-mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; }
    .pk-in[readonly] { background:#f1f5f9; color:#334155; font-weight:600; cursor:default; }
    .pk-hevno label { color:#2563eb; }

    .pk-row--main { align-items:start; }
    .pk-stack { display:flex; flex-direction:column; gap:12px; }
    .pk-sec { padding-bottom:16px; margin-bottom:16px; border-bottom:1px solid #f1f5f9; }
    .pk-sec:last-child { padding-bottom:0; margin-bottom:0; border-bottom:none; }
    .pk-sec .pk-hint { margin-top:8px; }

    /* Seqment (pill) seçicilər */
    .pk-seg { background:#f1f5f9; border-radius:11px; padding:4px; gap:4px; }
    .pk-seg--wrap { display:flex; flex-wrap:wrap; }
    .pk-seg--col { display:flex; flex-direction:column; }
    .pk-seg-i { flex:1; min-width:64px; position:relative; cursor:pointer; margin:0; }
    .pk-seg-i input { position:absolute; opacity:0; width:0; height:0; }
    .pk-seg-i span { display:block; text-align:center; padding:9px 10px; border-radius:8px; font-size:13px; font-weight:600;
        color:#475569; transition:.15s; white-space:nowrap; }
    .pk-seg-i input:checked + span { background:#fff; color:#2563eb; box-shadow:0 1px 3px rgba(15,23,42,.12); }
    .pk-seg--col .pk-seg-i span { text-align:left; }
    .pk-seg-i:hover span { color:#0f172a; }
    .pk-seg-i input:checked + span:hover { color:#2563eb; }

    .pk-hint { font-size:11px; color:#94a3b8; margin-top:10px; }
    .pk-dim { opacity:.5; }
    .pk-dim .pk-seg-i { pointer-events:none; }
    .pk-rate-f.pk-dim .pk-in { background:#f8fafc; }

    .dm-twrap { overflow-x:auto; }
    .pv-table { width:100%; border-collapse:collapse; font-size:13px; }
    .pv-table thead th { background:#f1f5f9; color:#475569; font-weight:600; font-size:12px; text-align:left; padding:9px 12px; border-bottom:1px solid #e2e8f0; }
    .pv-table td { padding:8px 12px; border-bottom:1px solid #f1f5f9; color:#1e293b; vertical-align:top; }
    .pv-r { text-align:right; }
    .pv-mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; white-space:nowrap; }
    .pv-tey { font-size:12px; color:#475569; min-width:260px; }
    .pv-empty { text-align:center; color:#94a3b8; padding:18px; font-size:12px; }

    .dm-actions { display:flex; gap:10px; margin-top:20px; }
    .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
    .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }

    @@media (max-width:820px) {
        .pk-row--2, .pk-row--3, .pk-row--amt, .pk-f2 { grid-template-columns:1fr; }
    }

/* ══ 20 000 USD aylıq limiti (07.09.2026) ═══════════════════════════════ */
.pk-fin-hint { font-weight: 400; color: #94a3b8; font-size: 11px; }

.pk-limit { border-left: 4px solid #cbd5e1; transition: border-color .15s, background .15s; }
.pk-limit--ok   { border-left-color: #16a34a; }
.pk-limit--asib { border-left-color: #dc2626; background: #fff7f7; }
.pk-limit--xeta { border-left-color: #d97706; background: #fffbeb; }

.pk-limit-body   { padding: 4px 2px 2px; }
.pk-limit-status { font-size: 13.5px; color: #475569; line-height: 1.6; }
.pk-limit--asib .pk-limit-status { color: #b91c1c; }
.pk-limit--xeta .pk-limit-status { color: #92400e; }

/* Vurğulanan hissə — rəqəmlər və qərar sözü (serverdə `**…**` ilə işarələnir,
   JS `<b>`-yə çevirir).
   FON/PİLL QOYULMADI: vurğu bəzən tam cümlədir («Əsas sənəd seçilməlidir.») —
   fonlu pill dar ekranda sətri qırır və mətn ləkə kimi görünür. */
.pk-limit-status b {
    font-weight: 800; font-size: 14.5px; color: #0f172a;
    font-variant-numeric: tabular-nums;   /* rəqəm dəyişəndə eni sıçramasın */
}
.pk-limit--ok   .pk-limit-status b { color: #15803d; }
.pk-limit--asib .pk-limit-status b { color: #b91c1c; }
.pk-limit--xeta .pk-limit-status b { color: #92400e; }

.pk-limit-sened { margin-top: 14px; padding-top: 14px; border-top: 1px dashed #e2e8f0; }
.pk-req { color: #dc2626; }

.pk-sened-row { display: flex; gap: 8px; align-items: center; }
.pk-sened-row .pk-in { flex: 1; }
.pk-sened-add {
    flex: 0 0 auto; padding: 8px 12px; border: 1px solid #cbd5e1; background: #fff;
    border-radius: 9px; font-size: 12.5px; cursor: pointer; white-space: nowrap; color: #334155;
}
.pk-sened-add:hover { background: #f1f5f9; border-color: #94a3b8; }
.pk-sened-add:disabled { opacity: .5; cursor: default; }

/* ── 1-ci addım kartı (FİN + limit) ────────────────────────────────────────
   FİN xanası ilə serverin cavabı YANAŞI durur: operator yazan kimi
   nəticəni elə orada görür, aşağı sürüşdürmür. Dar ekranda alt-alta düşür. */
.pk-ic--fin { background:#eef2ff; color:#4f46e5; }

/* «1-ci addım» nişanı — başlığın sağ ucuna itələnir. */
.pk-step {
    margin-left:auto; font-size:10px; font-weight:700; letter-spacing:.04em;
    text-transform:uppercase; color:#64748b; background:#f1f5f9;
    border:1px solid #e2e8f0; border-radius:999px; padding:3px 9px;
}

.pk-fin-row { display:grid; grid-template-columns:220px 1fr; gap:14px; align-items:center; }
.pk-fin-in  { font-size:15px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }

@@media (max-width: 900px) {
    .pk-fin-row { grid-template-columns:1fr; gap:8px; }
}

/* ── ARDICILLIQ KİLİDİ (08.09.2026) ────────────────────────────────────────
   FİN yazılana qədər formanın qalan hissəsi solğun və toxunulmazdır.
   Sinfi JS `<form>`-a qoyur (`pk-kilidli`); toxunulmazlığın ƏSAS mexanizmi
   `inert` atributudur, buradakı `pointer-events` onu dəstəkləməyən brauzer
   üçün ehtiyatdır.

   ⚠️ `filter` İŞLƏDİLMƏDİ — böyük konteynerdə mətni bulanıqlaşdırır və
   `position:fixed` övladlar üçün yeni containing block yaradır.
   ⚠️ `.dm-actions` bütövlükdə kilidlənmir — «Ləğv et» linki HƏMİŞƏ işləməlidir;
   yalnız göndər düyməsi sönür (JS onu `disabled` da edir — o, data sahəsi
   deyil, POST-da itən bir şey yoxdur). */
form.pk-kilidli .pk-form > .pk-row:not(.pk-row--fin),
form.pk-kilidli > .pk-card {
    opacity: .42;
    pointer-events: none;
    user-select: none;
}
.pk-form > .pk-row, form > .pk-card { transition: opacity .18s ease; }

form.pk-kilidli .fn-btn--primary { opacity: .45; pointer-events: none; }

/* Kilid qeydi — görünməsi TAM CSS-dədir, JS toxunmur. */
.pk-kilid-not { display: none; }
form.pk-kilidli .pk-kilid-not {
    display: flex; align-items: center; gap: 7px;
    margin-top: 12px; padding-top: 11px; border-top: 1px dashed #e2e8f0;
    font-size: 12.5px; color: #64748b;
}
form.pk-kilidli .pk-kilid-not i { color: #94a3b8; }
</style>
