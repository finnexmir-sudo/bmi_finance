@model IList<KocurmeListDto>
@{
    var baslik = (string)(ViewBag.Baslik ?? "Köçürmələr");
    ViewData["Title"] = baslik;
    string D(DateTime? v) => v?.ToString("dd.MM.yyyy") ?? "—";
    string T(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s!;
    string M(decimal? v) => v.HasValue ? v.Value.ToString("#,0.00") : "—";
    var userId = (int)(ViewBag.UserId ?? 0);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<div class="fn-page fn-tint">
    <div class="fn-page-head">
        <div>
            <div class="fn-page-title">@baslik</div>
            <div class="fn-page-sub">Köçürmə əməliyyatlarının jurnalı</div>
        </div>
        <a asp-action="Yarat" class="fn-btn fn-btn--primary"><i class="bi bi-plus-lg"></i> Yeni köçürmə</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="dm-alert dm-alert--ok"><i class="bi bi-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="dm-alert dm-alert--err"><i class="bi bi-x-octagon"></i> @TempData["Error"]</div>
    }

    <div class="fn-card">
        <div class="dm-toolbar">
            <div class="dm-search">
                <i class="bi bi-search"></i>
                <input type="text" id="dmSearch" placeholder="Göndərən, alan, №, bank axtar..." autocomplete="off" />
            </div>
            <div class="dm-hint">Cəmi: @Model.Count əməliyyat</div>
        </div>

        @* ══ FİN ÜZRƏ AYLIQ CƏM — 20 000 USD limiti ════════════════════════
           Yalnız «Pul» köçürməsində göstərilir: tələbə köçürməsi GƏLƏN puldur,
           limitə düşmür (istifadəçi qərarı 07.09.2026). *@
        @if ((string)(ViewBag.Novu ?? "") == "Pul")
        {
            <div class="km-finbar">
                <div class="km-finbar-t"><i class="bi bi-shield-check"></i> FİN üzrə aylıq yoxlama</div>
                <div class="km-finbar-f">
                    <input type="text" id="kmFin" class="km-fin-in" maxlength="10"
                           placeholder="FİN" autocomplete="off" />
                    <input type="month" id="kmAy" class="km-fin-in km-fin-in--ay"
                           value="@DateTime.Today.ToString("yyyy-MM")" />
                    <button type="button" id="kmSorgu" class="fn-btn fn-btn--outline fn-btn--sm">Sorğu</button>
                </div>
                <div class="km-finbar-n" id="kmNetice">FİN yazın və «Sorğu» düyməsini basın.</div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="dm-empty"><i class="bi bi-inbox"></i> Hələ köçürmə yoxdur.</div>
        }
        else
        {
            <div class="dm-twrap">
                <table class="dm-table" id="dmTable">
                    <thead>
                        <tr>
                            <th>Həvalə №</th>
                            <th>Tarix</th>
                            <th>Göndərən</th>
                            <th>Alan</th>
                            <th class="dm-r">Məbləğ</th>
                            <th>Valyuta</th>
                            <th>Bank</th>
                            <th>FİN</th>
                            <th class="dm-r">USD ekv.</th>
                            <th>Limit əsası</th>
                            <th>İcraçı</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr class="dm-row" data-search="@($"{m.HevaleNo} {m.GonderenTamAd} {m.AlanTamAd} {m.BankAd} {m.IcraciAd} {m.GonderenFin}".ToLower())">
                                <td class="dm-num">@T(m.HevaleNo)</td>
                                <td>@D(m.Tarix)</td>
                                <td class="dm-name">@T(m.GonderenTamAd)</td>
                                <td class="dm-name">@T(m.AlanTamAd)</td>
                                <td class="dm-r dm-mono">@M(m.Mebleg)</td>
                                <td>@T(m.KocurulenValyuta)</td>
                                <td>@T(m.BankAd)</td>
                                <td class="dm-mono">@T(m.GonderenFin)</td>
                                <td class="dm-r dm-mono">@M(m.UsdEkvivalent)</td>
                                @* «Sistem düz işləyib — işçi filan sənədə görə keçirə bilib»
                                   sualı ekrandan cavablansın deyə sənəd növü SİYAHIDA görünür. *@
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(m.SenedNovuAd))
                                    {
                                        <span class="km-sened" title="@m.LimitQeydi">@m.SenedNovuAd</span>
                                    }
                                    else
                                    {
                                        <span class="dm-dim">—</span>
                                    }
                                </td>
                                <td>@(m.IcraciAd ?? (m.Icra?.ToString() ?? "—"))</td>
                                <td class="dm-ops">
                                    <a asp-action="Tekrarla" asp-route-id="@m.Id" class="dm-op dm-op--repeat" title="Təkrar göndər (yeni №)"><i class="bi bi-arrow-repeat"></i></a>
                                    <a asp-action="Detal" asp-route-id="@m.Id" class="dm-op dm-op--detail" title="Mühasibat yazılışı"><i class="bi bi-list-columns"></i></a>
                                    @if (isAdmin || m.YaradanId == userId)
                                    {
                                        <a asp-action="Redakte" asp-route-id="@m.Id" class="dm-op dm-op--edit" title="Redaktə et"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="Sil" asp-route-id="@m.Id" method="post" class="dm-op-del"
                                              onsubmit="return confirm('Bu köçürməni silmək istədiyinizə əminsiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dm-op dm-op--del" title="Sil"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Styles {
    <style>
        .dm-toolbar { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; flex-wrap:wrap; }
        .dm-search { position:relative; max-width:360px; flex:1; }
        .dm-search i { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; }
        .dm-search input { width:100%; padding:9px 12px 9px 34px; border:1px solid #e2e8f0; border-radius:10px; font-size:13px; outline:none; background:#fbfcff; }
        .dm-search input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.12); }

        /* ── FİN üzrə aylıq yoxlama zolağı (20 000 USD limiti) ── */
        .km-finbar { border:1px solid #e2e8f0; background:#f8fafc; border-radius:12px; padding:12px 14px; margin-bottom:14px; }
        .km-finbar-t { font-size:12.5px; font-weight:700; color:#334155; margin-bottom:9px; }
        .km-finbar-f { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
        .km-fin-in { padding:8px 11px; border:1px solid #e2e8f0; border-radius:9px; font-size:13px; outline:none; background:#fff; width:170px; }
        .km-fin-in--ay { width:150px; }
        .km-fin-in:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
        .km-finbar-n { margin-top:9px; font-size:12.5px; color:#64748b; }
        .km-finbar-n--ok { color:#15803d; font-weight:600; }
        .km-finbar-n--asib { color:#b91c1c; font-weight:700; }
        .km-sened { display:inline-block; padding:2px 8px; border-radius:6px; background:#fef3c7; color:#92400e; font-size:11.5px; font-weight:600; }
        .dm-dim { color:#cbd5e1; }
        .dm-hint { font-size:12px; color:#64748b; }
        .dm-twrap { overflow-x:auto; }
        .dm-table { width:100%; border-collapse:collapse; font-size:13px; white-space:nowrap; }
        .dm-table thead th { position:sticky; top:0; background:#f1f5f9; color:#475569; font-weight:600; font-size:12px;
            text-align:left; padding:10px 14px; border-bottom:1px solid #e2e8f0; }
        .dm-table td { padding:9px 14px; border-bottom:1px solid #f1f5f9; color:#1e293b; }
        .dm-table tbody tr:hover td { background:#f8fafc; }
        .dm-r { text-align:right; }
        .dm-num { font-weight:700; color:#0f172a; }
        .dm-name { font-weight:600; color:#0f172a; white-space:normal; }
        .dm-mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12px; color:#0f172a; }
        .dm-empty { text-align:center; color:#94a3b8; padding:36px; font-size:14px; }
        .dm-alert { display:flex; align-items:center; gap:9px; padding:11px 16px; border-radius:10px; font-size:13px; margin-bottom:14px; }
        .dm-alert--ok { background:#dcfce7; border:1px solid #bbf7d0; color:#166534; }
        .dm-alert--err { background:#fef2f2; border:1px solid #fecaca; color:#b91c1c; }
        .dm-ops { white-space:nowrap; text-align:right; }
        .dm-op-del { display:inline; margin:0; }
        .dm-op { display:inline-flex; align-items:center; justify-content:center; width:29px; height:29px; margin-left:5px;
            border:1px solid #e2e8f0; border-radius:8px; background:#fff; color:#64748b; cursor:pointer; text-decoration:none; font-size:14px; transition:.15s; }
        .dm-op:hover { transform:translateY(-1px); }
        .dm-op--repeat { color:#0d9488; border-color:#ccfbf1; background:#f0fdfa; }
        .dm-op--repeat:hover { background:#ccfbf1; border-color:#5eead4; }
        .dm-op--detail { color:#4f46e5; border-color:#e0e7ff; background:#eef2ff; }
        .dm-op--detail:hover { background:#e0e7ff; border-color:#a5b4fc; }
        .dm-op--edit { color:#d97706; border-color:#fef3c7; background:#fffbeb; }
        .dm-op--edit:hover { background:#fef3c7; border-color:#fcd34d; }
        .dm-op--del { color:#dc2626; border-color:#fee2e2; background:#fef2f2; }
        .dm-op--del:hover { background:#fee2e2; border-color:#fca5a5; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            var inp = document.getElementById('dmSearch');
            if (!inp) return;
            var rows = Array.prototype.slice.call(document.querySelectorAll('#dmTable .dm-row'));
            inp.addEventListener('input', function () {
                var q = inp.value.trim().toLowerCase();
                rows.forEach(function (r) {
                    var hay = r.getAttribute('data-search') || '';
                    r.style.display = (q === '' || hay.indexOf(q) !== -1) ? '' : 'none';
                });
            });
        })();

        // ══ FİN üzrə aylıq cəm ═══════════════════════════════════════════
        // Rəqəmi SERVER verir (`FinAyliqCem` → `FinAyliqCemAsync`) — forma ilə
        // EYNİ mənbə. Burada heç nə hesablanmır, yalnız göstərilir.
        (function () {
            var fin  = document.getElementById('kmFin');
            var ay   = document.getElementById('kmAy');
            var dym  = document.getElementById('kmSorgu');
            var net  = document.getElementById('kmNetice');
            if (!fin || !dym || !net) return;

            function sorgu() {
                var f = (fin.value || '').trim();
                if (!f) { net.textContent = 'FİN yazın və «Sorğu» düyməsini basın.'; net.className = 'km-finbar-n'; return; }

                var d = (ay && ay.value) ? ay.value.split('-') : [];
                var b = new URLSearchParams();
                b.set('fin', f);
                if (d.length === 2) { b.set('il', d[0]); b.set('ay', d[1]); }

                net.textContent = 'Yoxlanılır…';
                net.className = 'km-finbar-n';

                // Mütləq ünvan — nisbi yazılış səhifə yolu dəyişəndə səssizcə sınır.
                fetch('@Url.Action("FinAyliqCem", new { il = (int?)null })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: b.toString()
                })
                .then(function (r) { return r.json(); })
                .then(function (x) {
                    net.textContent = x.mesaj || '';
                    net.className = 'km-finbar-n ' + (x.asilib ? 'km-finbar-n--asib' : 'km-finbar-n--ok');
                })
                .catch(function () {
                    // Səssiz qalmır — istifadəçi nəticənin gəlmədiyini bilməlidir.
                    net.textContent = 'Sorğu alınmadı — bağlantını yoxlayın.';
                    net.className = 'km-finbar-n km-finbar-n--asib';
                });
            }

            dym.addEventListener('click', sorgu);
            fin.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); sorgu(); } });
        })();
    </script>
}
