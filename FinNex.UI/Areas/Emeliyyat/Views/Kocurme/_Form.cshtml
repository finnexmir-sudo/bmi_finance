@model KocurmeFormDto
@{
    string I(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";

    // Məzənnə xanası üçün — artıq sıfırları atır (`0,0295000000` → `0.0295`).
    // Baza sütunu decimal(18,10) olduğuna görə EF dəyəri 10 onluqla qaytarır;
    // `I()` ilə yazsaq xanada uzun quyruq görünərdi.
    // ⚠️ InvariantCulture MƏCBURİDİR — `<input type="number">` yalnız NÖQTƏ qəbul
    // edir, az-AZ vergülü ilə xana BOŞ açılır və yadda saxlayanda kurs itər.
    string K(decimal? v) => v?.ToString("0.##########", System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var medaxil = new[] { "USD", "Avro", "AZN" };
    var kocurulen = new[] { "USD", "Avro", "Rial" };
    var secimler = new[] { "Hesab açmadan", "Hesab və mədaxil", "Hesabdan" };
}

<div class="pk-form">

    @* ══ 1-ci ADDIM: FİN VƏ AYLIQ LİMİT ═══════════════════════════════════
       Forma ƏN ÜSTDƏN başlayır (istifadəçi qərarı 07.09.2026): operator FİN-i
       birinci yazır və limit vəziyyətini DƏRHAL görür. Əks halda bütün formanı
       doldurub yalnız «Yadda saxla»da limitin aşıldığını bilərdi — əməkdən
       boş yerə gedərdi.

       ⚠️ Panel HƏMİŞƏ render olunur, yalnız məzmunu dəyişir. Sənəd sahələrini
       `@@if` ilə gizlətsək, göndərilməyən sahə POST-da null gəlib mövcud dəyəri
       SƏSSİZCƏ silərdi (CLAUDE.md — icazə nahar bayrağı hadisəsi). *@
    <div class="pk-row">
        <div class="pk-card pk-limit" id="pkLimitCard">
            <div class="pk-head">
                <span class="pk-ic pk-ic--fin"><i class="bi bi-person-vcard"></i></span>
                Göndərənin FİN kodu
                <span class="pk-step">1-ci addım</span>
            </div>

            <div class="pk-limit-body">
                <div class="pk-fin-row">
                    <input type="text" name="GonderenFin" id="pkFin" value="@Model.GonderenFin"
                           class="pk-in pk-mono pk-fin-in" maxlength="10" autocomplete="off"
                           placeholder="məs. 5AB2CD1" autofocus />
                    <div class="pk-limit-status" id="pkLimitStatus">
                        FİN yazın — bu şəxsin cari ay üzrə köçürmələri dərhal yoxlanılacaq.
                    </div>
                </div>

                <div class="pk-limit-sened" id="pkSenedBlok" hidden>
                    <div class="pk-f2">
                        <div>
                            <label>Əsas sənədin növü <span class="pk-req">*</span></label>
                            <div class="pk-sened-row">
                                <select name="SenedNovuId" id="pkSenedNovu" class="pk-in">
                                    <option value="">— seçin —</option>
                                    @foreach (var sn in (ViewBag.SenedNovleri as IList<KocurmeSenedNovuDto>) ?? new List<KocurmeSenedNovuDto>())
                                    {
                                        <option value="@sn.Id" selected="@(Model.SenedNovuId == sn.Id)">@sn.Ad</option>
                                    }
                                </select>
                                @* Siyahıda olmayanı işçi ELƏ BURADA əlavə edir (istifadəçi
                                   qərarı) — sonra hamı siyahıdan seçir. *@
                                <button type="button" class="pk-sened-add" id="pkSenedAdd"
                                        title="Siyahıda yoxdursa yeni növ əlavə et">+ Yeni növ</button>
                            </div>
                        </div>
                        <div>
                            <label>İzah (istəyə bağlı)</label>
                            <input type="text" name="LimitQeydi" id="pkLimitQeyd"
                                   value="@Model.LimitQeydi" class="pk-in" maxlength="500"
                                   placeholder="məs. müqavilə № və tarixi" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tərəflər -->
    <div class="pk-row pk-row--2">
        <div class="pk-card pk-card--send">
            <div class="pk-head"><span class="pk-ic"><i class="bi bi-box-arrow-up-right"></i></span> Göndərən</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Adı</label><input type="text" name="GonderenAd" value="@Model.GonderenAd" class="pk-in" /></div>
                    <div><label>Soyadı</label><input type="text" name="GonderenSoyad" value="@Model.GonderenSoyad" class="pk-in" /></div>
                </div>
                <div><label>Ata adı</label><input type="text" name="GonderenAtaAd" value="@Model.GonderenAtaAd" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Passport</label><input type="text" name="GonderenPassport" value="@Model.GonderenPassport" class="pk-in" /></div>
                    <div><label>Telefon</label><input type="text" name="GonderenTelefon" value="@Model.GonderenTelefon" class="pk-in" /></div>
                </div>
            </div>
        </div>

        <div class="pk-card pk-card--recv">
            <div class="pk-head"><span class="pk-ic"><i class="bi bi-box-arrow-in-down-right"></i></span> Alan</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Adı</label><input type="text" name="AlanAd" value="@Model.AlanAd" class="pk-in" /></div>
                    <div><label>Soyadı</label><input type="text" name="AlanSoyad" value="@Model.AlanSoyad" class="pk-in" /></div>
                </div>
                <div><label>Ata adı</label><input type="text" name="AlanAtaAd" value="@Model.AlanAtaAd" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Passport</label><input type="text" name="AlanPassport" value="@Model.AlanPassport" class="pk-in" /></div>
                    <div><label>Telefon</label><input type="text" name="AlanTelefon" value="@Model.AlanTelefon" class="pk-in" /></div>
                </div>
            </div>
        </div>
    </div>

    <!-- SOL: valyuta və seçim | SAĞ: Məbləğ və məzənnə -->
    <div class="pk-row pk-row--2 pk-row--main">
        <!-- SOL -->
        <div class="pk-card">
            <div class="pk-sec" id="pkMedaxilCard">
                <div class="pk-head pk-head--sm">Mədaxil olunan valyuta</div>
                <div class="pk-seg pk-seg--wrap">
                    @foreach (var v in medaxil)
                    {
                        <label class="pk-seg-i"><input type="radio" name="MedaxilValyuta" value="@v" checked="@(Model.MedaxilValyuta == v || (Model.MedaxilValyuta == null && v == "USD"))" /><span>@v</span></label>
                    }
                </div>
                <div class="pk-hint">Yalnız Rial/Rubl köçürmədə funksiyalıdır.</div>
            </div>
            <div class="pk-sec">
                <div class="pk-head pk-head--sm">Köçürülən valyuta</div>
                <div class="pk-seg pk-seg--wrap">
                    @foreach (var v in kocurulen)
                    {
                        <label class="pk-seg-i"><input type="radio" name="KocurulenValyuta" value="@v" checked="@(Model.KocurulenValyuta == v || (Model.KocurulenValyuta == null && v == "USD"))" /><span>@v</span></label>
                    }
                </div>
            </div>
            <div class="pk-sec">
                <div class="pk-head pk-head--sm">Seçim</div>
                <div class="pk-seg pk-seg--col">
                    @foreach (var s in secimler)
                    {
                        <label class="pk-seg-i"><input type="radio" name="Secim" value="@s" checked="@(Model.Secim == s || (Model.Secim == null && s == "Hesab açmadan"))" /><span>@s</span></label>
                    }
                </div>
            </div>
        </div>

        <!-- SAĞ -->
        <div class="pk-card">
            <div class="pk-head"><span class="pk-ic pk-ic--amt"><i class="bi bi-cash-coin"></i></span> Məbləğ və məzənnə</div>
            <div class="pk-stack">
                <div class="pk-hevno">
                    <label>Həvalə №</label>
                    <input type="text" name="HevaleNo" value="@Model.HevaleNo" class="pk-in pk-mono" readonly title="Avtomatik təyin olunur" />
                </div>
                <div><label>Məbləğ</label><input type="number" step="0.01" name="Mebleg" value="@I(Model.Mebleg)" class="pk-in pk-in--big" placeholder="0.00" /></div>
                <div><label>Tarix</label><input type="date" name="Tarix" value="@(Model.Tarix?.ToString("yyyy-MM-dd"))" class="pk-in" /></div>
                @* ⚠️ step="any" MƏCBURİDİR — məzənnədə onluq yerlərin sayı sabit deyil.
                   Rialın MB kursu 0,000002950-dir; `step="0.0001"` olanda brauzer
                   «Please enter a valid value. The two nearest valid values are 0
                   and 0.0001» deyib formanı ümumiyyətlə göndərmir (01.09.2026, real
                   hadisə). Məbləğ (`step="0.01"`) qəsdən belə qalır — o, puldur. *@
                <div class="pk-rate-f"><label>Rial (MB kursu)</label><input type="number" step="any" name="RialCbar" value="@K(Model.RialCbar)" class="pk-in pk-rate" /></div>
                <div class="pk-rate-f"><label>Valyuta (MB kursu)</label><input type="number" step="any" name="ValyutaCbar" value="@K(Model.ValyutaCbar)" class="pk-in pk-rate" /></div>
                <div class="pk-rate-f"><label>İran Rial (kurs)</label><input type="number" step="any" name="IranRial" value="@K(Model.IranRial)" class="pk-in pk-rate" /></div>
            </div>
        </div>
    </div>

    <!-- Bank + qeydlər -->
    <div class="pk-row pk-row--2">
        <div class="pk-card">
            <div class="pk-head pk-head--sm"><i class="bi bi-bank"></i> Bank məlumatları</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Bankın adı</label><input type="text" name="BankAd" value="@Model.BankAd" class="pk-in" /></div>
                    <div><label>Filial</label><input type="text" name="Filial" value="@Model.Filial" class="pk-in" /></div>
                </div>
                <div><label>Alan hesab</label><input type="text" name="AlanHesab" value="@Model.AlanHesab" class="pk-in pk-mono" /></div>
            </div>
        </div>
        <div class="pk-card">
            <div class="pk-head pk-head--sm"><i class="bi bi-journal-text"></i> Əlavə məlumat</div>
            <div class="pk-fields">
                <div><label>Əlavə</label><input type="text" name="Elave" value="@Model.Elave" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Məqsəd</label><input type="text" name="Meqsed" value="@Model.Meqsed" class="pk-in" /></div>
                    <div><label>Qeyd</label><input type="text" name="Qeyd" value="@Model.Qeyd" class="pk-in" /></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    (function () {
        var kocRadios = document.querySelectorAll('input[name="KocurulenValyuta"]');
        var medRadios = document.querySelectorAll('input[name="MedaxilValyuta"]');
        var medCard = document.getElementById('pkMedaxilCard');
        var rateFields = document.querySelectorAll('.pk-rate-f');
        if (!kocRadios.length) return;

        function secilenKoc() {
            var r = document.querySelector('input[name="KocurulenValyuta"]:checked');
            return r ? r.value : '';
        }
        function tetbiq() {
            var koc = secilenKoc();
            var rialRubl = (koc === 'Rial' || koc === 'Rubl');

            // Mədaxil: USD/Avro köçürmədə mənbə valyuta = köçürülən (avtomatik), sönük
            if (!rialRubl) {
                medRadios.forEach(function (m) { m.disabled = true; m.checked = (m.value === koc); });
                if (medCard) medCard.classList.add('pk-dim');
            } else {
                medRadios.forEach(function (m) { m.disabled = false; });
                if (medCard) medCard.classList.remove('pk-dim');
                // AZN köçürülən üçün deyil — mədaxildə default varsa saxla
                if (!document.querySelector('input[name="MedaxilValyuta"]:checked')) {
                    var usd = document.querySelector('input[name="MedaxilValyuta"][value="USD"]');
                    if (usd) usd.checked = true;
                }
            }

            // Məzənnə sahələri yalnız Rial/Rubl üçün aktiv
            rateFields.forEach(function (f) {
                var inp = f.querySelector('.pk-rate');
                f.classList.toggle('pk-dim', !rialRubl);
                if (inp) inp.disabled = !rialRubl;
            });
        }
        kocRadios.forEach(function (r) { r.addEventListener('change', tetbiq); });
        tetbiq();
    })();

    // ══ 20 000 USD AYLIQ LİMİTİ — canlı yoxlama ═══════════════════════════
    //
    // ⚠️ BU JS RƏQƏM UYDURMUR. Cəmi və USD ekvivalentini SERVER hesablayır
    //    (`LimitYoxla` → `KocurmeService.LimitYoxlaAsync`) — yadda saxlama
    //    yolu ilə EYNİ metod. İki ayrı hesablayıcı saxlasaq, ekranda görünən
    //    ilə tətbiq olunan gec-tez fərqlənərdi (CLAUDE.md — «bir elementə iki
    //    yazıcı»). Burada yalnız GÖSTƏRİLİR.
    (function () {
        var fin    = document.getElementById('pkFin');
        var status = document.getElementById('pkLimitStatus');
        var blok   = document.getElementById('pkSenedBlok');
        var kart   = document.getElementById('pkLimitCard');
        var novu   = document.getElementById('pkSenedNovu');
        var elave  = document.getElementById('pkSenedAdd');
        if (!fin || !status || !blok) return;

        var meblegEl = document.querySelector('input[name="Mebleg"]');
        var tarixEl  = document.querySelector('input[name="Tarix"]');

        // ⚠️ NİSBİ ÜNVAN YAZMA. `'LimitYoxla'` yalnız `/…/Yarat` səhifəsində
        //    düz işləyir; `/…/Redakte/5`-də `/…/Redakte/LimitYoxla`-ya gedər
        //    və yoxlama SƏSSİZCƏ dayanardı (CLAUDE.md — boş/səhv endpoint).
        //    `id = null` ambient route dəyərini atır; qeydin Id-si onsuz da
        //    form sahəsindən (`input[name="Id"]`) göndərilir.
        var endpoint = '@Url.Action("LimitYoxla", new { id = (int?)null })';

        var sonAcar = null;      // köhnəlmiş cavab qoruyucusu
        var taymer  = null;

        function medaxil() {
            var r = document.querySelector('input[name="MedaxilValyuta"]:checked');
            return r ? r.value : '';
        }

        function yoxla() {
            var f = (fin.value || '').trim();
            if (!f) {
                status.textContent = 'FİN daxil edin — bu şəxsin cari ay üzrə köçürmələri yoxlanılacaq.';
                kart.classList.remove('pk-limit--asib', 'pk-limit--ok', 'pk-limit--xeta');
                blok.hidden = true;
                return;
            }

            var acar = [f, meblegEl ? meblegEl.value : '', medaxil(), tarixEl ? tarixEl.value : ''].join('|');
            sonAcar = acar;

            var body = new URLSearchParams();
            body.set('fin', f);
            body.set('mebleg', meblegEl ? meblegEl.value : '');
            body.set('medaxilValyuta', medaxil());
            body.set('tarix', tarixEl ? tarixEl.value : '');
            var idEl = document.querySelector('input[name="Id"]');
            if (idEl && idEl.value) body.set('id', idEl.value);

            fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body.toString()
            })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                // Ard-arda dəyişikliklərdə cavablar SIRA İLƏ GƏLMİR — gec gələn
                // köhnə cavab yenisini üstələməsin.
                if (acar !== sonAcar) return;

                status.textContent = d.mesaj || '';
                kart.classList.remove('pk-limit--asib', 'pk-limit--ok', 'pk-limit--xeta');

                if (d.kursAlinmadi) {
                    kart.classList.add('pk-limit--xeta');
                    blok.hidden = true;
                    return;
                }

                blok.hidden = !d.senedTelebOlunur;
                kart.classList.add(d.senedTelebOlunur ? 'pk-limit--asib' : 'pk-limit--ok');
            })
            .catch(function () {
                if (acar !== sonAcar) return;
                // Səssiz qalmır — operator yoxlamanın işləmədiyini bilməlidir.
                status.textContent = 'Limit yoxlaması alınmadı. Yadda saxlayanda server yenidən yoxlayacaq.';
                kart.classList.remove('pk-limit--asib', 'pk-limit--ok');
                kart.classList.add('pk-limit--xeta');
            });
        }

        function gecikdir() { clearTimeout(taymer); taymer = setTimeout(yoxla, 400); }

        fin.addEventListener('input', gecikdir);
        if (meblegEl) meblegEl.addEventListener('input', gecikdir);
        if (tarixEl)  tarixEl.addEventListener('change', yoxla);
        document.querySelectorAll('input[name="MedaxilValyuta"]')
                .forEach(function (r) { r.addEventListener('change', yoxla); });

        // Yeni sənəd növü — elə bu səhifədən (istifadəçi qərarı 07.09.2026)
        if (elave && novu) {
            elave.addEventListener('click', function () {
                var ad = (prompt('Yeni sənəd növünün adı:') || '').trim();
                if (!ad) return;

                var tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                var b = new URLSearchParams();
                b.set('ad', ad);
                if (tokenEl) b.set('__RequestVerificationToken', tokenEl.value);

                elave.disabled = true;
                // Nisbi ünvan YOX — redaktə səhifəsində səhv yola düşərdi.
                fetch('@Url.Action("SenedNovuYarat", new { id = (int?)null })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: b.toString()
                })
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    elave.disabled = false;
                    if (!d.ugur) { alert(d.mesaj || 'Əlavə edilmədi.'); return; }

                    // Mövcud idisə də Id qayıdır — dublikat option yaratmırıq.
                    var varmi = Array.prototype.some.call(novu.options, function (o) {
                        return o.value === String(d.id);
                    });
                    if (!varmi) {
                        var o = document.createElement('option');
                        o.value = String(d.id); o.textContent = d.ad;
                        novu.appendChild(o);
                    }
                    novu.value = String(d.id);
                })
                .catch(function () {
                    elave.disabled = false;
                    alert('Sənəd növü əlavə edilmədi — bağlantını yoxlayın.');
                });
            });
        }

        // Səhifə açılanda mövcud dəyərlə bir dəfə yoxla (redaktə/təkrar halı).
        if ((fin.value || '').trim()) yoxla();
    })();
</script>
