@model KocurmeFormDto
@{
    string I(decimal? v) => v?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "";
    var medaxil = new[] { "USD", "Avro", "AZN" };
    var kocurulen = new[] { "USD", "Avro", "Rial" };
    var secimler = new[] { "Hesab açmadan", "Hesab və mədaxil", "Hesabdan" };
}

<div class="pk-form">

    <!-- Tərəflər -->
    <div class="pk-row pk-row--2">
        <div class="pk-card pk-card--send">
            <div class="pk-head"><span class="pk-ic"><i class="bi bi-box-arrow-up-right"></i></span> Göndərən</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Adı</label><input type="text" name="GonderenAd" value="@Model.GonderenAd" class="pk-in" /></div>
                    <div><label>Soyadı</label><input type="text" name="GonderenSoyad" value="@Model.GonderenSoyad" class="pk-in" /></div>
                </div>
                <div><label>Ata adı</label><input type="text" name="GonderenAtaAd" value="@Model.GonderenAtaAd" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Passport</label><input type="text" name="GonderenPassport" value="@Model.GonderenPassport" class="pk-in" /></div>
                    <div><label>Telefon</label><input type="text" name="GonderenTelefon" value="@Model.GonderenTelefon" class="pk-in" /></div>
                </div>
            </div>
        </div>

        <div class="pk-card pk-card--recv">
            <div class="pk-head"><span class="pk-ic"><i class="bi bi-box-arrow-in-down-right"></i></span> Alan</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Adı</label><input type="text" name="AlanAd" value="@Model.AlanAd" class="pk-in" /></div>
                    <div><label>Soyadı</label><input type="text" name="AlanSoyad" value="@Model.AlanSoyad" class="pk-in" /></div>
                </div>
                <div><label>Ata adı</label><input type="text" name="AlanAtaAd" value="@Model.AlanAtaAd" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Passport</label><input type="text" name="AlanPassport" value="@Model.AlanPassport" class="pk-in" /></div>
                    <div><label>Telefon</label><input type="text" name="AlanTelefon" value="@Model.AlanTelefon" class="pk-in" /></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Məbləğ (ayrıca) + Tarix və məzənnə (alt-alta) -->
    <div class="pk-row pk-row--amt">
        <div class="pk-card pk-card--amt">
            <div class="pk-head"><span class="pk-ic pk-ic--amt"><i class="bi bi-cash-coin"></i></span> Məbləğ</div>
            <input type="number" step="0.01" name="Mebleg" value="@I(Model.Mebleg)" class="pk-in pk-in--big" placeholder="0.00" />
        </div>
        <div class="pk-card">
            <div class="pk-head pk-head--sm"><i class="bi bi-calendar3"></i> Tarix və məzənnə</div>
            <div class="pk-stack">
                <div><label>Tarix</label><input type="date" name="Tarix" value="@(Model.Tarix?.ToString("yyyy-MM-dd"))" class="pk-in" /></div>
                <div class="pk-rate-f"><label>Rial (MB kursu)</label><input type="number" step="0.0001" name="RialCbar" value="@I(Model.RialCbar)" class="pk-in pk-rate" /></div>
                <div class="pk-rate-f"><label>Valyuta (MB kursu)</label><input type="number" step="0.0001" name="ValyutaCbar" value="@I(Model.ValyutaCbar)" class="pk-in pk-rate" /></div>
                <div class="pk-rate-f"><label>İran Rial (kurs)</label><input type="number" step="0.0001" name="IranRial" value="@I(Model.IranRial)" class="pk-in pk-rate" /></div>
            </div>
        </div>
    </div>

    <!-- Seçimlər (seqment düymələr) -->
    <div class="pk-row pk-row--3">
        <div class="pk-card" id="pkMedaxilCard">
            <div class="pk-head pk-head--sm">Mədaxil olunan valyuta</div>
            <div class="pk-seg pk-seg--wrap">
                @foreach (var v in medaxil)
                {
                    <label class="pk-seg-i"><input type="radio" name="MedaxilValyuta" value="@v" checked="@(Model.MedaxilValyuta == v || (Model.MedaxilValyuta == null && v == "USD"))" /><span>@v</span></label>
                }
            </div>
            <div class="pk-hint" id="pkMedaxilHint">Yalnız Rial/Rubl köçürmədə funksiyalıdır.</div>
        </div>
        <div class="pk-card">
            <div class="pk-head pk-head--sm">Köçürülən valyuta</div>
            <div class="pk-seg pk-seg--wrap">
                @foreach (var v in kocurulen)
                {
                    <label class="pk-seg-i"><input type="radio" name="KocurulenValyuta" value="@v" checked="@(Model.KocurulenValyuta == v || (Model.KocurulenValyuta == null && v == "USD"))" /><span>@v</span></label>
                }
            </div>
        </div>
        <div class="pk-card">
            <div class="pk-head pk-head--sm">Seçim</div>
            <div class="pk-seg pk-seg--col">
                @foreach (var s in secimler)
                {
                    <label class="pk-seg-i"><input type="radio" name="Secim" value="@s" checked="@(Model.Secim == s || (Model.Secim == null && s == "Hesab açmadan"))" /><span>@s</span></label>
                }
            </div>
        </div>
    </div>

    <!-- Bank + qeydlər -->
    <div class="pk-row pk-row--2">
        <div class="pk-card">
            <div class="pk-head pk-head--sm"><i class="bi bi-bank"></i> Bank məlumatları</div>
            <div class="pk-fields">
                <div class="pk-f2">
                    <div><label>Bankın adı</label><input type="text" name="BankAd" value="@Model.BankAd" class="pk-in" /></div>
                    <div><label>Filial</label><input type="text" name="Filial" value="@Model.Filial" class="pk-in" /></div>
                </div>
                <div><label>Alan hesab</label><input type="text" name="AlanHesab" value="@Model.AlanHesab" class="pk-in pk-mono" /></div>
            </div>
        </div>
        <div class="pk-card">
            <div class="pk-head pk-head--sm"><i class="bi bi-journal-text"></i> Əlavə məlumat</div>
            <div class="pk-fields">
                <div><label>Əlavə</label><input type="text" name="Elave" value="@Model.Elave" class="pk-in" /></div>
                <div class="pk-f2">
                    <div><label>Məqsəd</label><input type="text" name="Meqsed" value="@Model.Meqsed" class="pk-in" /></div>
                    <div><label>Qeyd</label><input type="text" name="Qeyd" value="@Model.Qeyd" class="pk-in" /></div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    (function () {
        var kocRadios = document.querySelectorAll('input[name="KocurulenValyuta"]');
        var medRadios = document.querySelectorAll('input[name="MedaxilValyuta"]');
        var medCard = document.getElementById('pkMedaxilCard');
        var rateFields = document.querySelectorAll('.pk-rate-f');
        if (!kocRadios.length) return;

        function secilenKoc() {
            var r = document.querySelector('input[name="KocurulenValyuta"]:checked');
            return r ? r.value : '';
        }
        function tetbiq() {
            var koc = secilenKoc();
            var rialRubl = (koc === 'Rial' || koc === 'Rubl');

            // Mədaxil: USD/Avro köçürmədə mənbə valyuta = köçürülən (avtomatik), sönük
            if (!rialRubl) {
                medRadios.forEach(function (m) { m.disabled = true; m.checked = (m.value === koc); });
                if (medCard) medCard.classList.add('pk-dim');
            } else {
                medRadios.forEach(function (m) { m.disabled = false; });
                if (medCard) medCard.classList.remove('pk-dim');
                // AZN köçürülən üçün deyil — mədaxildə default varsa saxla
                if (!document.querySelector('input[name="MedaxilValyuta"]:checked')) {
                    var usd = document.querySelector('input[name="MedaxilValyuta"][value="USD"]');
                    if (usd) usd.checked = true;
                }
            }

            // Məzənnə sahələri yalnız Rial/Rubl üçün aktiv
            rateFields.forEach(function (f) {
                var inp = f.querySelector('.pk-rate');
                f.classList.toggle('pk-dim', !rialRubl);
                if (inp) inp.disabled = !rialRubl;
            });
        }
        kocRadios.forEach(function (r) { r.addEventListener('change', tetbiq); });
        tetbiq();
    })();
</script>
