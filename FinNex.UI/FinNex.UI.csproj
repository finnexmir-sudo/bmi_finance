    <PackageReference Include="NPOI" Version="2.7.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataAccess\FinNex.DataAccess.csproj" />
    <ProjectReference Include="..\FinNex.Application\FinNex.Application.csproj" />
    <ProjectReference Include="..\FinNex.Domain\FinNex.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\Templates\Tabel_isci.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Remove="App_Data\Muhasibat\Avans hesablama.xls" />
    <Content Include="App_Data\Muhasibat\Avans hesablama.xls">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Remove="App_Data\Muhasibat\Emek_haqqi_hesablama.xls" />
