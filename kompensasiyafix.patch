+++ b/FinNex.UI/Areas/HR/Views/Kompensasiya/Detal.cshtml
@@ -105,11 +105,11 @@
                 <div style="font-size:13px;color:#475569;margin-bottom:6px">
                     @if (Model.SonuncuMezuniyyetBitmeTarixi.HasValue)
                     {
-                        <text>Sonuncu məzuniyyət bitiş: <b>@Model.SonuncuMezuniyyetBitmeTarixi.Value.ToString("dd.MM.yyyy")</b></text>
+                        <span>Sonuncu məzuniyyət bitiş: <b>@Model.SonuncuMezuniyyetBitmeTarixi.Value.ToString("dd.MM.yyyy")</b></span>
                     }
                     else
                     {
-                        <text style="color:#b45309">⚠ Sonuncu məzuniyyət qeydi yoxdur — işə qəbul tarixindən hesablanır</text>
+                        <span style="color:#b45309">⚠ Sonuncu məzuniyyət qeydi yoxdur — işə qəbul tarixindən hesablanır</span>
                     }
                 </div>
                 <div style="font-size:13px;color:#475569;margin-bottom:6px">
