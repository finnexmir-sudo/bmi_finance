diff --git a/FinNex.UI/Areas/HR/Controllers/KompensasiyaController.cs b/FinNex.UI/Areas/HR/Controllers/KompensasiyaController.cs
index 51a43d1b..35f7f336 100644
--- a/FinNex.UI/Areas/HR/Controllers/KompensasiyaController.cs
+++ b/FinNex.UI/Areas/HR/Controllers/KompensasiyaController.cs
@@ -130,11 +130,11 @@ namespace FinNex.UI.Areas.HR.Controllers
                 ? iscilerR.Data : new List<FinNex.Application.DTOs.HR.Isci.IsciListDto>();
 
             vm.Isciler = isciler
-                .OrderBy(x => x.Sira).ThenBy(x => x.Ad).ThenBy(x => x.Soyad)
+                .OrderBy(x => x.Sira).ThenBy(x => x.TamAd)
                 .Select(x => new SelectListItem
                 {
                     Value = x.Id.ToString(),
-                    Text = $"{x.Ad} {x.Soyad}"
+                    Text = x.TamAd
                           + (x.IsdenAyrilmaTarixi.HasValue
                               ? $" — işdən çıxıb {x.IsdenAyrilmaTarixi:dd.MM.yyyy}"
                               : "")
diff --git a/FinNex.UI/Areas/HR/Views/Kompensasiya/Detal.cshtml b/FinNex.UI/Areas/HR/Views/Kompensasiya/Detal.cshtml
index 02d89842..e07c5371 100644
