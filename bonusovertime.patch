+
+    .ae-lock  { display:inline-block; font-size:11px; font-weight:600; padding:3px 9px;
+                border-radius:20px; background:#fdecec; color:#c0392b; }
+    .ae-ok    { display:inline-block; font-size:11px; font-weight:600; padding:3px 9px;
+                border-radius:20px; background:#eaf6ef; color:#1c7a3e; }
+    .ae-dim   { color:#c2c8d2; }
+
+    .ae-bar   { position:sticky; bottom:0; margin-top:16px; background:#fff;
+                border:1px solid #e6e9f0; border-radius:12px; padding:12px 16px;
+                display:flex; align-items:center; justify-content:space-between;
+                box-shadow:0 -2px 10px rgba(20,30,50,.06); }
+    .ae-bar-info { font-size:12.5px; color:#7a8699; }
+</style>
+
+<div class="ae-wrap">
+
+    <div class="ae-head">
+        <div>
+            <h1 class="ae-title">Aylıq Əlavə — Bonus / Overtime</h1>
+            <div class="ae-sub">İşçilərə seçilmiş ay üçün bonus və overtime təyin edin. Maaş hesablananadək dəyişdirilə bilər.</div>
+        </div>
+        <form method="get" class="ae-period">
+            <select name="ay">
+                @for (int a = 1; a <= 12; a++)
+                {
+                    <option value="@a" selected="@(a == ay)">@ayAdlar[a]</option>
+                }
+            </select>
+            <select name="il">
+                @foreach (var y in iller)
+                {
+                    <option value="@y" selected="@(y == il)">@y</option>
+                }
+            </select>
+            <button type="submit" class="ae-btn ae-btn--ghost">Göstər</button>
+        </form>
+    </div>
+
+    @if (TempData["Success"] != null)
+    {
+        <div class="ae-msg">@TempData["Success"]</div>
+    }
+
+    <div class="ae-stats">
+        <div class="ae-stat"><b>@ayAdlar[ay] @il</b><span>Seçilmiş dövr</span></div>
+        <div class="ae-stat"><b>@Model.Count</b><span>Aktiv işçi</span></div>
+        <div class="ae-stat"><b>@doluSayi</b><span>Əlavəsi olan</span></div>
+        <div class="ae-stat"><b>@kilidliSayi</b><span>Maaşı hesablanıb (kilidli)</span></div>
+    </div>
+
+    <form method="post" asp-action="Saxla">
+        <input type="hidden" name="il" value="@il" />
+        <input type="hidden" name="ay" value="@ay" />
+
+        <div class="ae-card">
+            <input type="text" class="ae-search" id="aeSearch"
+                   placeholder="İşçi axtar..." autocomplete="off" />
+
+            <table class="ae-tbl">
+                <thead>
+                    <tr>
+                        <th class="ae-no">#</th>
+                        <th>İşçi</th>
+                        <th class="num">Bonus (₼)</th>
+                        <th class="num">Overtime (₼)</th>
+                        <th>Vəziyyət</th>
+                    </tr>
+                </thead>
+                <tbody id="aeBody">
+                @{ int sira = 0; }
+                @for (int i = 0; i < Model.Count; i++)
+                {
+                    var s = Model[i];
+                    sira++;
+                    <tr class="ae-rowx @(s.Kilidli ? "ae-row--locked" : "")" data-name="@s.AdSoyad.ToLower()">
+                        <td class="ae-no">@sira</td>
+                        <td class="ae-name">
+                            @s.AdSoyad
+                            <input type="hidden" name="setirler[@i].IsciId" value="@s.IsciId" />
+                        </td>
+
+                        @if (s.Kilidli)
+                        {
+                            <td class="ae-cellnum ae-money">@(s.Bonus > 0 ? s.Bonus.ToString("N2") : "—")</td>
+                            <td class="ae-cellnum ae-money">@(s.Overtime > 0 ? s.Overtime.ToString("N2") : "—")</td>
+                            <td><span class="ae-lock">İcra olunub</span></td>
+                        }
+                        else
+                        {
+                            <td class="ae-cellnum">
+                                <input type="number" step="0.01" min="0" class="ae-inp"
+                                       name="setirler[@i].Bonus"
+                                       value="@(s.Bonus > 0 ? s.Bonus.ToString("0.##") : "")"
+                                       placeholder="0" />
+                            </td>
+                            <td class="ae-cellnum">
+                                <input type="number" step="0.01" min="0" class="ae-inp"
+                                       name="setirler[@i].Overtime"
+                                       value="@(s.Overtime > 0 ? s.Overtime.ToString("0.##") : "")"
+                                       placeholder="0" />
+                            </td>
+                            <td><span class="ae-ok">Redaktə oluna bilər</span></td>
+                        }
+                    </tr>
+                }
+                </tbody>
+            </table>
+        </div>
+
+        <div class="ae-bar">
+            <div class="ae-bar-info">
+                @aktivSayi işçi redaktə oluna bilər · @kilidliSayi kilidli (maaşı hesablanıb)
+            </div>
+            <button type="submit" class="ae-btn ae-btn--primary" @(aktivSayi == 0 ? "disabled" : "")>
+                Yadda saxla
+            </button>
+        </div>
+    </form>
+
+    @if (!Model.Any())
+    {
+        <p class="ae-dim" style="text-align:center;margin-top:20px;">Aktiv işçi tapılmadı.</p>
+    }
+</div>
+
+<script>
+    (function () {
+        var box = document.getElementById('aeSearch');
+        var rows = document.querySelectorAll('#aeBody .ae-rowx');
+        if (!box) return;
+        box.addEventListener('input', function () {
+            var q = this.value.trim().toLowerCase();
+            rows.forEach(function (r) {
+                r.style.display = r.getAttribute('data-name').indexOf(q) > -1 ? '' : 'none';
+            });
+        });
+    })();
+</script>
