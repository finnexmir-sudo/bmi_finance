+        // ─── DROPDOWN: QALIĞI OLAN İŞÇİLƏR ──────────────────────
+        public async Task<IList<KompensasiyaIsciSecimDto>> GetIscilerWithQaligAsync()
+        {
+            // İllik məzuniyyət balansından hər işçi üçün qalıq cəmini çıxar
+            var qaligler = await _uow.Repository<MezuniyyetBalans>()
+                .Query()
+                .Where(x => x.Nov == MezuniyyetNovu.Illik && !x.Silinib)
+                .GroupBy(x => x.IsciId)
+                .Select(g => new
+                {
+                    IsciId = g.Key,
+                    QaligGun = g.Sum(x => x.ToplamGun - x.IstifadeOlunanGun)
+                })
+                .Where(x => x.QaligGun > 0)
+                .ToListAsync();
+
+            if (!qaligler.Any()) return new List<KompensasiyaIsciSecimDto>();
+
+            var isciIds = qaligler.Select(x => x.IsciId).ToList();
+            var isciler = await _uow.Repository<Isci>()
+                .Query()
+                .Where(x => isciIds.Contains(x.Id) && !x.Silinib)
+                .Include(x => x.IsciTeyinatlari.Where(t => t.Aktivdir))
+                    .ThenInclude(t => t.Departament)
+                .ToListAsync();
+
+            var dict = qaligler.ToDictionary(x => x.IsciId, x => x.QaligGun);
+
+            return isciler.Select(i => new KompensasiyaIsciSecimDto
+                {
+                    IsciId = i.Id,
+                    TamAd = i.TamAd,
+                    Sira = i.Sira,
+                    IsdenAyrilmaTarixi = i.IsdenAyrilmaTarixi,
+                    CemiQaligGun = dict[i.Id],
+                    SobeAdi = i.IsciTeyinatlari.FirstOrDefault(t => t.Aktivdir)?.Departament?.Ad
+                })
+                .OrderBy(x => x.IsdenAyrilmaTarixi.HasValue ? 0 : 1)  // işdən çıxanlar əvvəl
+                .ThenBy(x => x.Sira).ThenBy(x => x.TamAd)
+                .ToList();
+        }
+
