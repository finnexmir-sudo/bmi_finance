+    string StatusClass(KompensasiyaStatus s) => s switch
+    {
+        KompensasiyaStatus.MaasaDaxilEdildi => "fn-badge--done",
+        KompensasiyaStatus.Tesdiqlenib => "fn-badge--review",
+        KompensasiyaStatus.Layihe => "fn-badge--wait",
+        KompensasiyaStatus.LegvEdildi => "fn-badge--rejected",
+        _ => ""
+    };
+
+    var ayAdlari = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
+        "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
+}
+
+<div class="fn-page">
+    <div class="fn-page-head">
+        <div>
+            <div class="fn-page-title">Məzuniyyət Kompensasiyası</div>
+            <div class="fn-page-sub">İstifadə edilməmiş əmək məzuniyyəti günlərinə görə kompensasiya hesablamaları</div>
+        </div>
+        <a asp-action="Yarat" class="fn-btn fn-btn--primary">
+            <i class="bi bi-plus-lg"></i> Yeni Kompensasiya
+        </a>
+    </div>
+
+    @if (TempData["Success"] != null)
+    {
+        <div class="fn-alert fn-alert--success">@TempData["Success"]</div>
+    }
+    @if (TempData["Error"] != null)
+    {
+        <div style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:12px">@TempData["Error"]</div>
