+@model FinNex.Application.DTOs.HR.Kompensasiya.KompensasiyaDetalDto
+@using FinNex.Domain.Entities.HR
+@{
+    Layout = "~/Areas/HR/Views/Shared/_HRLayout.cshtml";
+    ViewData["Title"] = "Kompensasiya Detal";
+    var ayAdlari = new[] { "", "Yanvar", "Fevral", "Mart", "Aprel", "May", "İyun",
+        "İyul", "Avqust", "Sentyabr", "Oktyabr", "Noyabr", "Dekabr" };
+
+    string StatusText(KompensasiyaStatus s) => s switch
+    {
+        KompensasiyaStatus.Layihe => "Layihə",
+        KompensasiyaStatus.Tesdiqlenib => "Təsdiqlənib",
+        KompensasiyaStatus.MaasaDaxilEdildi => "Maaşa daxil edilib",
+        KompensasiyaStatus.LegvEdildi => "Ləğv edilib",
+        _ => "-"
